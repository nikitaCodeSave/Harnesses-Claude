diff -ruN a/tests/test_reservations.py b/tests/test_reservations.py
--- a/tests/test_reservations.py
+++ b/tests/test_reservations.py
@@ -0,0 +1,53 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory.errors import IdempotencyConflict, InsufficientStock, ReservationExpired
+from inventory.models import ReservationStatus
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    return service
+
+
+def test_reserve_reduces_available(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, idempotency_key="k1")
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_reserve_more_than_available_fails(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"MUG": 11}, idempotency_key="k1")
+
+
+def test_same_key_returns_same_reservation(stocked):
+    first = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="k1")
+    again = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="k1")
+    assert again.reservation_id == first.reservation_id
+
+
+def test_same_key_different_items_conflicts(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, idempotency_key="k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 5}, idempotency_key="k1")
+
+
+def test_reservation_expires(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="k1")
+    clock.advance(timedelta(minutes=15))
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_confirm_expired_fails(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="k1")
+    clock.advance(timedelta(minutes=16))
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+
+
+def test_confirm_creates_order(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert (order.quantity_of("MUG"), stocked.available("MUG", "WH1")) == (4, 6)

+    # -- reservations ----------------------------------------------------
+    def reserve(self, warehouse: str, items: Mapping[str, int], idempotency_key: str) -> Reservation:
+        existing_id = self._reservations_by_key.get(idempotency_key)
+        if existing_id is not None:
+            existing = self.get_reservation(existing_id)
+            if existing.warehouse != warehouse or existing.items != dict(items):
+                raise IdempotencyConflict(idempotency_key)
+            return existing
+        wanted = self._validate_items(warehouse, items)
+        for sku, quantity in wanted.items():
+            free = self.available(sku, warehouse)
+            if quantity > free:
+                raise InsufficientStock(sku, warehouse, quantity, free)
+        now = self._clock.now()
+        reservation = Reservation(
+            reservation_id=f"RES-{len(self._reservations) + 1:04d}",
+            warehouse=warehouse,
+            items=wanted,
+            status=ReservationStatus.ACTIVE,
+            expires_at=now + self._reservation_ttl,
+            created_at=now,
+            idempotency_key=idempotency_key,
+        )
+        self._reservations[reservation.reservation_id] = reservation
+        self._reservations_by_key[idempotency_key] = reservation.reservation_id
+        return reservation
+
+    def get_reservation(self, reservation_id: str) -> Reservation:
+        try:
+            reservation = self._reservations[reservation_id]
+        except KeyError:
+            raise ReservationNotFound(reservation_id) from None
+        if reservation.status is ReservationStatus.ACTIVE and not self._is_active(reservation):
+            reservation.status = ReservationStatus.EXPIRED
+        return reservation
+
+    def confirm_reservation(self, reservation_id: str) -> Order:
+        reservation = self._require_active(reservation_id, "confirm")
+        reservation.status = ReservationStatus.CONFIRMED
+        try:
+            order = self.place_order(reservation.warehouse, reservation.items)
+        except Exception:
+            reservation.status = ReservationStatus.ACTIVE
+            raise
+        reservation.order_id = order.order_id
+        return order
+
+    def release_reservation(self, reservation_id: str) -> Reservation:
+        reservation = self._require_active(reservation_id, "release")
+        reservation.status = ReservationStatus.RELEASED
+        return reservation
+
+    def _require_active(self, reservation_id: str, action: str) -> Reservation:
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.EXPIRED:
+            raise ReservationExpired(reservation_id)
+        if reservation.status is not ReservationStatus.ACTIVE:
+            raise InvalidReservationState(reservation_id, reservation.status, action)
+        return reservation
+
+    def _is_active(self, reservation: Reservation) -> bool:
+        return (
+            reservation.status is ReservationStatus.ACTIVE
+            and self._clock.now() < reservation.expires_at
+        )
+

+    # -- reservations ----------------------------------------------------
+    def reserve(self, warehouse: str, items: Mapping[str, int], idempotency_key: str) -> Reservation:
+        """Hold stock for a cart until it is confirmed, released or expires.
+
+        Each line holds what is available, up to the requested quantity; lines
+        with nothing available are left out. Fails only if nothing can be held.
+        Repeating a call with the same key and request returns the original.
+        """
+        existing = self._repo.find_reservation_by_key(idempotency_key)
+        if existing is not None:
+            if existing.warehouse != warehouse or existing.requested != dict(items):
+                raise IdempotencyConflict(idempotency_key)
+            return self._refresh(existing)
+        wanted = self._validate_items(warehouse, items)
+        held: dict[str, int] = {}
+        for sku, quantity in wanted.items():
+            take = min(quantity, self.available(sku, warehouse))
+            if take > 0:
+                held[sku] = take
+        if not held:
+            sku, quantity = next(iter(wanted.items()))
+            raise InsufficientStock(sku, warehouse, quantity, 0)
+        now = self._clock.now()
+        reservation = Reservation(
+            reservation_id=self._repo.next_reservation_id(),
+            warehouse=warehouse,
+            items=held,
+            status=ReservationStatus.ACTIVE,
+            expires_at=now + self._reservation_ttl,
+            created_at=now,
+            idempotency_key=idempotency_key,
+            requested=wanted,
+        )
+        self._repo.save_reservation(reservation)
+        return reservation
+
+    def get_reservation(self, reservation_id: str) -> Reservation:
+        return self._refresh(self._repo.get_reservation(reservation_id))
+
+    def confirm_reservation(self, reservation_id: str) -> Order:
+        """Turn the hold into a placed order. Safe to retry: returns the same order."""
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            assert reservation.order_id is not None
+            return self._repo.get_order(reservation.order_id)
+        if reservation.status is ReservationStatus.EXPIRED:
+            raise ReservationExpired(reservation_id, reservation.expires_at)
+        if reservation.status is not ReservationStatus.ACTIVE:
+            raise InvalidReservationState(reservation_id, reservation.status, "confirm")
+        reservation.status = ReservationStatus.CONFIRMED
+        order = self._new_order(reservation.warehouse, reservation.items)
+        reservation.order_id = order.order_id
+        self._repo.save_reservation(reservation)
+        return order
+
+    def release_reservation(self, reservation_id: str) -> Reservation:
+        """Give the held units back. A no-op for released or expired reservations."""
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            raise InvalidReservationState(reservation_id, reservation.status, "release")
+        if reservation.status is ReservationStatus.ACTIVE:
+            reservation.status = ReservationStatus.RELEASED
+            self._repo.save_reservation(reservation)
+        return reservation
+
+    def _refresh(self, reservation: Reservation) -> Reservation:
+        """Expiry is lazy: an ACTIVE hold past its deadline becomes EXPIRED when looked at."""
+        if (
+            reservation.status is ReservationStatus.ACTIVE
+            and self._clock.now() >= reservation.expires_at
+        ):
+            reservation.status = ReservationStatus.EXPIRED
+            self._repo.save_reservation(reservation)
+        return reservation
+
+    def _active_reservations(self, warehouse: str) -> list[Reservation]:
+        return [
+            r
+            for r in map(self._refresh, self._repo.reservations(warehouse=warehouse))
+            if r.status is ReservationStatus.ACTIVE
+        ]
+
     # -- helpers ---------------------------------------------------------
+    def _new_order(self, warehouse: str, quantities: Mapping[str, int]) -> Order:
+        order = Order(
+            order_id=self._repo.next_order_id(),
+            warehouse=warehouse,
+            lines=tuple(OrderLine(sku, qty) for sku, qty in quantities.items()),
+            status=OrderStatus.PLACED,
+            placed_at=self._clock.now(),
+        )
+        self._repo.save_order(order)
+        return order
+
     def _check_location(self, sku: str, warehouse: str) -> None:
         self._repo.get_warehouse(warehouse)
         self._repo.get_product(sku)
diff -ruN a/tests/test_reservations.py b/tests/test_reservations.py
--- a/tests/test_reservations.py
+++ b/tests/test_reservations.py
@@ -0,0 +1,67 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import OrderStatus, ReservationStatus
+from inventory.errors import IdempotencyConflict, InsufficientStock, ReservationExpired
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    return service
+
+
+def test_reserve_holds_stock(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, idempotency_key="cart-1")
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_reserve_holds_only_what_is_available(stocked):
+    r = stocked.reserve("WH1", {"MUG": 15, "TEE": 1}, idempotency_key="cart-1")
+    assert r.items == {"MUG": 10}
+
+
+def test_reserve_fails_when_nothing_can_be_held(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"TEE": 1}, idempotency_key="cart-1")
+
+
+def test_hold_expires_after_twenty_minutes(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="cart-1")
+    clock.advance(timedelta(minutes=20))
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_expired_hold_cannot_be_confirmed(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="cart-1")
+    clock.advance(timedelta(minutes=20))
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+
+
+def test_confirm_places_order_from_hold(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="cart-1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert (order.status, order.quantity_of("MUG"), stocked.available("MUG", "WH1")) == (
+        OrderStatus.PLACED, 4, 6,
+    )
+
+
+def test_confirm_is_retry_safe(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="cart-1")
+    stocked.confirm_reservation(r.reservation_id)
+    stocked.confirm_reservation(r.reservation_id)
+    assert len(repo.orders()) == 1
+
+
+def test_release_is_retry_safe(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4}, idempotency_key="cart-1")
+    stocked.release_reservation(r.reservation_id)
+    assert stocked.release_reservation(r.reservation_id).status is ReservationStatus.RELEASED
+
+
+def test_key_reuse_with_other_items_conflicts(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, idempotency_key="cart-1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 5}, idempotency_key="cart-1")

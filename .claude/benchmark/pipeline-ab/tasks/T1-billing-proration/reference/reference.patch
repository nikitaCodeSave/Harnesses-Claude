+    def _upgrade_lines(self, subscription: Subscription, current: Plan, new: Plan) -> list[LineItem]:
+        """Credit the unused part of the current plan, charge the same days on the new one.
+
+        Each line is prorated exactly and rounded on its own.
+        """
+        today = self._clock.today()
+        remaining = (subscription.period_end - today).days
+        length = (subscription.period_end - subscription.period_start).days
+        interval = subscription.interval
+        span = f"{today.isoformat()} to {subscription.period_end.isoformat()}"
+        credit = to_money(current.price_for(interval) * remaining / length)
+        charge = to_money(new.price_for(interval) * remaining / length)
+        return [
+            LineItem(f"Unused time on {current.name} ({interval.value}) {span}", -credit),
+            LineItem(f"Remaining time on {new.name} ({interval.value}) {span}", charge),
+        ]
+
     @staticmethod
     def _period_line(plan: Plan, subscription: Subscription) -> LineItem:
         interval = subscription.interval

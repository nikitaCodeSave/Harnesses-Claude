+    def change_plan(
+        self,
+        subscription_id: str,
+        new_plan_code: str,
+        new_interval: Interval | None = None,
+    ) -> Invoice | None:
+        """Move a subscription to another plan and/or billing interval.
+
+        Upgrades happen now and are prorated by calendar days over the current
+        period. Downgrades and interval switches wait for the end of the
+        period. During a free trial everything applies at once, unbilled.
+        The latest request replaces anything scheduled before it.
+
+        Returns the invoice issued now, or None when nothing is billed now.
+        """
+        subscription = self._store.get_subscription(subscription_id)
+        if subscription.is_canceled:
+            raise SubscriptionNotActive(subscription_id)
+        new_plan = self._store.get_plan(new_plan_code)
+        interval = new_interval or subscription.interval
+        plan_changes = new_plan.code != subscription.plan_code
+        interval_changes = interval is not subscription.interval
+
+        if not plan_changes and not interval_changes:
+            if not subscription.has_scheduled_change:
+                raise InvalidPlanChange(f"{subscription_id} is already on {new_plan.code} ({interval.value})")
+            self._store.save_subscription(
+                replace(subscription, scheduled_plan_code=None, scheduled_interval=None)
+            )
+            return None
+        if plan_changes and not new_plan.active:
+            raise PlanNotAvailable(new_plan.code)
+
+        if subscription.status is SubscriptionStatus.TRIALING:
+            self._store.save_subscription(
+                replace(
+                    subscription,
+                    plan_code=new_plan.code,
+                    interval=interval,
+                    scheduled_plan_code=None,
+                    scheduled_interval=None,
+                )
+            )
+            return None
+
+        current_plan = self._store.get_plan(subscription.plan_code)
+        upgrade = plan_changes and new_plan.monthly_price > current_plan.monthly_price
+        invoice = None
+        updated = subscription
+        if upgrade:
+            invoice = self._issue_invoice(
+                subscription,
+                self._upgrade_lines(subscription, current_plan, new_plan),
+                self._clock.today(),
+            )
+            updated = replace(updated, plan_code=new_plan.code)
+        updated = replace(
+            updated,
+            scheduled_plan_code=new_plan.code if plan_changes and not upgrade else None,
+            scheduled_interval=interval if interval_changes else None,
+        )
+        self._store.save_subscription(updated)
+        return invoice
+

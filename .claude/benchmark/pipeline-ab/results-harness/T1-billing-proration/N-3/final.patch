@@ -0,0 +1,327 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import InvalidPlanChange, PlanNotAvailable, PlanNotFound, SubscriptionNotActive
+from billing.plans import Interval, Plan
+from billing.subscriptions import ScheduledChange
+
+
+@pytest.fixture(autouse=True)
+def more_plans(store):
+    store.add_plan(Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")))
+    store.add_plan(Plan("plus", "Plus", Decimal("10.05"), Decimal("100.50")))
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("280.00")))
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+# upgrades: prorated now
+
+
+def test_upgrade_bills_prorated_difference_now(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")  # Jan 15 - Feb 15, 31 days
+    clock.move_to(date(2026, 1, 25))  # 21 days left
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    assert (invoice.issued_on, invoice.total) == (date(2026, 1, 25), Decimal("13.55"))
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "pro"
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+
+
+def test_renewal_after_upgrade_bills_new_plan_in_full(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_each_line_is_rounded_before_summing(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 12))  # 3 of 31 days left; the net rounded alone would be 1.94
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-0.97"), Decimal("2.90")]
+    assert invoice.total == Decimal("1.93")
+
+
+def test_proration_rounds_half_up(service, clock):
+    clock.move_to(date(2026, 4, 1))
+    sub = service.subscribe("cus_1", "basic")  # Apr 1 - May 1, 30 days
+    clock.move_to(date(2026, 4, 28))  # 3 days left: 10.05 * 3 / 30 = 1.005
+    invoice = service.change_plan(sub.id, "plus")
+    assert amounts(invoice) == [Decimal("-1.00"), Decimal("1.01")]
+
+
+def test_upgrade_on_first_day_credits_whole_period(service):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_annual_upgrade_uses_annual_prices_and_keeps_interval(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)  # 365 days
+    clock.move_to(date(2026, 7, 15))  # 184 days left
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-50.41"), Decimal("151.23")]
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+
+def test_upgrade_with_interval_switch_prorates_now_and_switches_at_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert invoice.total == Decimal("13.55")  # monthly prices
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("300.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.ANNUAL, date(2027, 2, 15))
+    assert renewed.scheduled_change is None
+
+
+def test_upgrade_while_downgrade_scheduled_prorates_from_current_plan(service, store, clock):
+    clock.move_to(date(2026, 3, 1))
+    sub = service.subscribe("cus_1", "pro")  # Mar 1 - Apr 1
+    clock.move_to(date(2026, 3, 5))
+    assert service.change_plan(sub.id, "basic") is None
+    clock.move_to(date(2026, 3, 11))
+    invoice = service.change_plan(sub.id, "premium")
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")
+    assert store.get_subscription(sub.id).scheduled_change is None
+    clock.move_to(date(2026, 4, 1))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("75.00")
+
+
+def test_upgrade_discards_scheduled_interval_switch(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).scheduled_change is None
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+
+
+# downgrades and interval switches: deferred to period end
+
+
+def test_downgrade_is_deferred_to_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "basic") is None
+    assert len(store.invoices_for(sub.id)) == 1
+    pending = store.get_subscription(sub.id)
+    assert pending.plan_code == "pro"
+    assert pending.scheduled_change == ScheduledChange("basic", Interval.MONTHLY)
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("10.00")
+    assert (renewed.plan_code, renewed.scheduled_change) == ("basic", None)
+
+
+def test_downgrade_with_switch_to_annual_is_deferred(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("100.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.ANNUAL, date(2027, 2, 15))
+
+
+def test_monthly_to_annual_is_deferred(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("300.00")
+    assert store.get_subscription(sub.id).period_end == date(2027, 2, 15)
+
+
+def test_annual_to_monthly_waits_for_end_of_annual_period(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 3, 1))
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    clock.move_to(date(2027, 1, 14))
+    assert service.renew_due() == []
+    clock.move_to(date(2027, 1, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("30.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.MONTHLY, date(2027, 2, 15))
+
+
+def test_new_request_replaces_scheduled_change(service, store):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("pro", Interval.ANNUAL)
+
+
+def test_requesting_current_plan_cancels_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    assert service.change_plan(sub.id, "pro") is None
+    assert store.get_subscription(sub.id).scheduled_change is None
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_scheduled_change_applies_to_first_missed_renewal_onwards(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 4, 1))
+    renewals = service.renew_due()
+    assert [inv.total for inv in renewals] == [Decimal("10.00"), Decimal("10.00")]
+
+
+def test_upgrade_with_switch_replaces_scheduled_downgrade(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    invoice = service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-30.00"), Decimal("75.00")]
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("premium", Interval.ANNUAL)
+
+
+def test_scheduled_target_retired_before_period_end_still_applies(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    store.retire_plan("basic")
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_customer_on_retired_plan_can_cancel_scheduled_change(service, store):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    store.retire_plan("pro")
+    assert service.change_plan(sub.id, "pro") is None
+    assert store.get_subscription(sub.id).scheduled_change is None
+
+
+def test_upgrade_whose_lines_cancel_out_applies_without_invoice(service, store, clock):
+    store.add_plan(Plan("studio", "Studio", Decimal("31.00"), Decimal("300.00")))
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))
+    assert service.change_plan(sub.id, "studio") is None
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.get_subscription(sub.id).plan_code == "studio"
+
+
+# lateral changes
+
+
+def test_lateral_change_is_deferred_to_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "team", Interval.MONTHLY) is None
+    assert len(store.invoices_for(sub.id)) == 1
+    pending = store.get_subscription(sub.id)
+    assert pending.plan_code == "pro"
+    assert pending.scheduled_change == ScheduledChange("team", Interval.MONTHLY)
+    clock.move_to(date(2027, 1, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert renewal.lines[0].description.startswith("Team (monthly)")
+
+
+# trials
+
+
+def test_any_change_during_trial_applies_now_and_bills_nothing(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    assert store.invoices_for(sub.id) == []
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval, changed.period_end) == (
+        "basic",
+        Interval.ANNUAL,
+        date(2026, 1, 29),
+    )
+    assert changed.scheduled_change is None
+    clock.move_to(date(2026, 1, 29))
+    [first] = service.renew_due()
+    assert first.total == Decimal("100.00")
+    assert store.get_subscription(sub.id).period_end == date(2027, 1, 29)
+
+
+def test_upgrade_during_trial_bills_nothing(service, store):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    assert service.change_plan(sub.id, "pro") is None
+    assert store.invoices_for(sub.id) == []
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+
+# rejections
+
+
+def assert_rejected(service, store, sub_id, error, *args):
+    before = store.get_subscription(sub_id)
+    invoices_before = store.invoices_for(sub_id)
+    with pytest.raises(error):
+        service.change_plan(sub_id, *args)
+    assert store.get_subscription(sub_id) == before
+    assert store.invoices_for(sub_id) == invoices_before
+
+
+def test_same_plan_and_interval_with_nothing_scheduled_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "pro")
+    assert_rejected(service, store, sub.id, InvalidPlanChange, "pro")
+    assert_rejected(service, store, sub.id, InvalidPlanChange, "pro", Interval.MONTHLY)
+
+
+def test_change_on_canceled_subscription_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    assert_rejected(service, store, sub.id, SubscriptionNotActive, "pro")
+
+
+def test_change_to_unknown_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    assert_rejected(service, store, sub.id, PlanNotFound, "gold")
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("basic", Interval.MONTHLY)
+
+
+def test_change_to_retired_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("pro")
+    assert_rejected(service, store, sub.id, PlanNotAvailable, "pro")
+
+
+def test_interval_switch_on_retired_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    assert_rejected(service, store, sub.id, PlanNotAvailable, "basic", Interval.ANNUAL)
+
+
+def test_customer_on_retired_plan_can_upgrade_off_it(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "pro").total == Decimal("13.55")
+
+
+def test_change_with_renewal_overdue_is_rejected(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 15))
+    assert_rejected(service, store, sub.id, InvalidPlanChange, "pro")

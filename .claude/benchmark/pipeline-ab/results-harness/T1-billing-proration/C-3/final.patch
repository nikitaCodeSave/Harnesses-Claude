+"""BillingService.change_plan — see specs/plan-changes.md."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import Subscription, SubscriptionStatus
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+@pytest.fixture
+def pro_in_march(service, clock):
+    """A Pro monthly subscription in its Mar 1 - Apr 1 period, clock on Mar 11."""
+    clock.move_to(MAR_1)
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(MAR_11)
+    return sub
+
+
+# upgrades
+
+
+def test_upgrade_example_from_spec(service, store, pro_in_march):
+    invoice = service.change_plan(pro_in_march.id, "premium")
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")  # sum of rounded lines, not round(45*21/31) = 30.48
+    assert invoice.issued_on == MAR_11
+    assert store.invoices_for(pro_in_march.id)[-1] == invoice
+
+
+def test_upgrade_takes_effect_now_and_keeps_period(service, store, pro_in_march):
+    service.change_plan(pro_in_march.id, "premium")
+    sub = store.get_subscription(pro_in_march.id)
+    assert (sub.plan_code, sub.interval) == ("premium", Interval.MONTHLY)
+    assert (sub.period_start, sub.period_end) == (MAR_1, APR_1)
+    assert sub.scheduled_plan_code is None and sub.scheduled_interval is None
+
+
+def test_upgraded_plan_is_billed_at_next_renewal(service, store, clock, pro_in_march):
+    service.change_plan(pro_in_march.id, "premium")
+    clock.move_to(APR_1)
+    [invoice] = service.renew_due()
+    assert invoice.total == Decimal("75.00")
+
+
+def test_upgrade_on_first_day_prorates_the_whole_period(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_annual_upgrade_is_prorated_at_annual_prices(service, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)  # Jan 15 2026 - Jan 15 2027, 365 days
+    clock.move_to(date(2026, 2, 15))  # 334 days remain
+    invoice = service.change_plan(sub.id, "pro")
+    # 100 * 334 / 365 = 91.5068..., 300 * 334 / 365 = 274.5205...
+    assert amounts(invoice) == [Decimal("-91.51"), Decimal("274.52")]
+    assert invoice.total == Decimal("183.01")
+
+
+def test_upgrade_with_interval_switch_is_split(service, store, clock, pro_in_march):
+    invoice = service.change_plan(pro_in_march.id, "premium", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    sub = store.get_subscription(pro_in_march.id)
+    assert (sub.plan_code, sub.interval) == ("premium", Interval.MONTHLY)
+    assert (sub.scheduled_plan_code, sub.scheduled_interval) == ("premium", Interval.ANNUAL)
+
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(pro_in_march.id)
+    assert renewal.total == Decimal("750.00")
+    assert (renewed.interval, renewed.period_start, renewed.period_end) == (
+        Interval.ANNUAL,
+        APR_1,
+        date(2027, 4, 1),
+    )
+
+
+def test_upgrade_clears_scheduled_downgrade_and_prorates_from_current_plan(service, store, clock, pro_in_march):
+    assert service.change_plan(pro_in_march.id, "basic") is None
+    invoice = service.change_plan(pro_in_march.id, "premium")
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]  # credit is Pro, not Basic
+    sub = store.get_subscription(pro_in_march.id)
+    assert sub.scheduled_plan_code is None and sub.scheduled_interval is None
+
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("75.00")
+
+
+def test_upgrade_clears_earlier_scheduled_interval_switch(service, store, clock, pro_in_march):

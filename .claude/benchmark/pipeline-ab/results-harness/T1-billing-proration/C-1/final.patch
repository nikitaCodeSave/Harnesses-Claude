+"""Mid-cycle plan changes. Numbers refer to the criteria in specs/plan-changes.md."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+import billing
+from billing.errors import (
+    BillingError,
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+
+def subscribe_on(service, clock, day, plan_code, interval=Interval.MONTHLY, **kwargs):
+    clock.move_to(day)
+    return service.subscribe("cus_1", plan_code, interval, **kwargs)
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def renew_on(service, clock, day):
+    clock.move_to(day)
+    return service.renew_due()
+
+
+# 1, 2 — upgrade now
+
+
+def test_upgrade_is_prorated_by_remaining_calendar_days(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert invoice is not None
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_upgrade_keeps_period_and_renews_on_new_plan(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+    service.change_plan(sub.id, "premium")
+
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "premium"
+    assert (changed.period_start, changed.period_end, changed.interval) == (
+        date(2026, 3, 1),
+        date(2026, 4, 1),
+        Interval.MONTHLY,
+    )
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    assert renewal.total == Decimal("75.00")
+
+
+# 3 — annual proration uses real year length
+
+
+def test_annual_upgrade_uses_366_days_in_leap_year(service, clock):
+    sub = subscribe_on(service, clock, date(2028, 1, 1), "pro", Interval.ANNUAL)
+    clock.move_to(date(2028, 7, 1))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-150.82"), Decimal("377.05")]
+
+
+def test_annual_upgrade_uses_365_days_in_common_year(service, clock):
+    sub = subscribe_on(service, clock, date(2026, 1, 15), "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 1))  # 198 of 365 days remain
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-162.74"), Decimal("406.85")]
+
+
+# 4 — first day of period
+
+
+def test_upgrade_on_first_day_credits_and_charges_full_prices(service, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "basic")
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+# 5, 6 — downgrades are scheduled
+
+
+def test_downgrade_bills_nothing_and_applies_at_renewal(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "premium")
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.get_subscription(sub.id).plan_code == "premium"
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("10.00")
+    assert renewed.plan_code == "basic"
+    assert (renewed.pending_plan_code, renewed.pending_interval) == (None, None)
+
+
+def test_same_monthly_price_behaves_like_downgrade(service, store, clock):
+    store.add_plan(Plan("pro_plus", "Pro Plus", Decimal("30.00"), Decimal("280.00")))
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "pro_plus") is None
+
+    assert store.get_subscription(sub.id).plan_code == "pro"
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    assert store.get_subscription(sub.id).plan_code == "pro_plus"
+    assert renewal.total == Decimal("30.00")
+
+
+def test_renewal_catch_up_applies_scheduled_change_once(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "premium")
+    service.change_plan(sub.id, "basic")
+
+    renewals = renew_on(service, clock, date(2026, 5, 1))
+
+    assert [inv.total for inv in renewals] == [Decimal("10.00"), Decimal("10.00")]
+
+
+# 7, 8 — interval switches are scheduled
+
+
+def test_switch_to_annual_waits_for_period_end(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+
+    unchanged = store.get_subscription(sub.id)
+    assert (unchanged.interval, unchanged.period_end) == (Interval.MONTHLY, date(2026, 4, 1))
+    assert len(store.invoices_for(sub.id)) == 1
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("300.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.ANNUAL, date(2027, 4, 1))
+
+
+def test_switch_to_monthly_waits_for_period_end(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 9, 1))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+    [renewal] = renew_on(service, clock, date(2027, 3, 1))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("30.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.MONTHLY, date(2027, 4, 1))
+
+
+def test_downgrade_with_switch_to_annual_applies_both_at_renewal(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("100.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+
+
+# 9 — upgrade combined with interval switch
+
+
+def test_upgrade_with_interval_switch_is_split(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval, changed.period_end) == (
+        "premium",
+        Interval.MONTHLY,
+        date(2026, 4, 1),
+    )
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("750.00")
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.ANNUAL)
+
+
+# 10 — inconsistent annual price sheet
+
+
+def test_annual_upgrade_to_cheaper_annual_price_is_rejected(service, store, clock):
+    store.add_plan(Plan("odd", "Odd", Decimal("12.00"), Decimal("90.00")))
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "basic", Interval.ANNUAL)
+    before = store.get_subscription(sub.id)
+
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "odd")
+
+    assert store.get_subscription(sub.id) == before
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+# 11 — trials
+
+
+def test_change_during_trial_applies_now_without_billing(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "basic", trial_days=14)
+    clock.move_to(date(2026, 3, 5))
+
+    assert service.change_plan(sub.id, "premium", Interval.ANNUAL) is None
+
+    changed = store.get_subscription(sub.id)
+    assert store.invoices_for(sub.id) == []
+    assert (changed.status, changed.plan_code, changed.interval, changed.period_end) == (
+        SubscriptionStatus.TRIALING,
+        "premium",
+        Interval.ANNUAL,
+        date(2026, 3, 15),
+    )
+    [first] = renew_on(service, clock, date(2026, 3, 15))
+    assert first.total == Decimal("750.00")
+
+
+def test_downgrade_during_trial_applies_now(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "premium", trial_days=14)
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert store.get_subscription(sub.id).plan_code == "basic"
+    [first] = renew_on(service, clock, date(2026, 3, 15))
+    assert first.total == Decimal("10.00")
+
+
+# 12, 13 — replacing and cancelling a scheduled change
+
+
+def test_later_request_replaces_scheduled_change(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "premium")
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert renewal.total == Decimal("300.00")
+
+
+def test_requesting_current_plan_cancels_scheduled_change(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "premium")
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "premium") is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    assert store.get_subscription(sub.id).plan_code == "premium"
+    assert renewal.total == Decimal("75.00")
+
+
+def test_requesting_current_plan_with_nothing_scheduled_is_rejected(service, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "pro", Interval.MONTHLY)
+
+
+# 14 — upgrade while something is scheduled
+
+
+def test_upgrade_discards_scheduled_downgrade_and_prorates_from_current(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.pending_plan_code, changed.pending_interval) == (None, None)
+    [renewal] = renew_on(service, clock, date(2026, 4, 1))
+    assert renewal.total == Decimal("75.00")
+
+
+def test_upgrade_with_switch_replaces_scheduled_change_with_the_switch(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 3, 11))
+
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.pending_plan_code, changed.pending_interval) == ("premium", Interval.ANNUAL)
+
+
+# 15 — errors leave state unchanged
+
+
+def test_unknown_subscription(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_9999", "pro")
+
+
+def test_unknown_plan(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")
+    assert store.get_subscription(sub.id) == sub
+
+
+def test_retired_target_plan(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    store.retire_plan("premium")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "premium")
+    assert store.get_subscription(sub.id) == sub
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_interval_switch_on_retired_current_plan(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert store.get_subscription(sub.id) == sub
+
+
+def test_canceled_subscription(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "premium")
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_change_while_renewal_is_due_is_rejected(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 4, 1))
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "premium")
+    assert store.get_subscription(sub.id) == sub
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_change_after_trial_end_before_renewal_is_rejected(service, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro", trial_days=14)
+    clock.move_to(date(2026, 3, 15))
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic")
+
+
+# 16, 17 — retired plans
+
+
+def test_customer_on_retired_plan_can_upgrade(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    store.retire_plan("pro")
+    clock.move_to(date(2026, 3, 11))
+    invoice = service.change_plan(sub.id, "premium")
+    assert invoice.total == Decimal("30.49")

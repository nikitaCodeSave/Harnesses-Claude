diff --git a/src/billing/money.py b/src/billing/money.py
index f560010..e8edaf4 100644
--- a/src/billing/money.py
+++ b/src/billing/money.py
@@ -20,6 +20,22 @@ def to_money(value: Decimal | int | str) -> Decimal:
     return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)
 
 
+def prorate(amount: Decimal, part: int, whole: int) -> Decimal:
+    """``amount × part / whole`` computed exactly, then rounded to cents (half up).
+
+    ``amount`` must be a non-negative whole-cent Decimal. Integer arithmetic
+    avoids a second rounding step inside Decimal division.
+    """
+    if amount < 0 or not is_whole_cents(amount):
+        raise ValueError(f"cannot prorate {amount}: need a non-negative whole-cent amount")
+    if whole <= 0 or not 0 <= part <= whole:
+        raise ValueError(f"cannot prorate over {part}/{whole}")
+    cents, remainder = divmod(int(amount * 100) * part, whole)
+    if 2 * remainder >= whole:
+        cents += 1
+    return Decimal(cents).scaleb(-2)
+
+
 def is_whole_cents(value: Decimal) -> bool:
     """True when ``value`` carries no precision below one cent."""
     return value == value.quantize(CENT, rounding=ROUND_HALF_UP)

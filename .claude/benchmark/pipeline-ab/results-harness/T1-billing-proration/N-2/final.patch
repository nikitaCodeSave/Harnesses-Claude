+@pytest.mark.parametrize(
+    ("setup", "plan_code", "interval", "error"),
+    [
+        (_canceled, "premium", None, SubscriptionNotActive),
+        (None, "gold", None, PlanNotFound),
+        (_retire_premium, "premium", None, PlanNotAvailable),
+        (_retire_premium, "premium", Interval.ANNUAL, PlanNotAvailable),
+        (None, "pro", None, InvalidPlanChange),
+        (None, "pro", Interval.MONTHLY, InvalidPlanChange),
+    ],
+)
+def test_rejected_request_changes_nothing(service, store, clock, setup, plan_code, interval, error):
+    sub = subscribe_on(service, clock, date(2026, 3, 1))
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)  # something scheduled to preserve
+    if setup:
+        setup(service, store, sub)
+    clock.move_to(date(2026, 3, 11))
+    if plan_code == "pro":  # same plan and interval needs nothing scheduled to be an error
+        service.change_plan(sub.id, "pro")
+    before_sub, before_invoices = store.get_subscription(sub.id), store.invoices_for(sub.id)
+    with pytest.raises(error):
+        service.change_plan(sub.id, plan_code, interval)
+    assert store.get_subscription(sub.id) == before_sub
+    assert store.invoices_for(sub.id) == before_invoices

@@ -0,0 +1,309 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+
+def subscribe_on(service, clock, day, plan_code="pro", interval=Interval.MONTHLY, **kwargs):
+    clock.move_to(day)
+    return service.subscribe("cus_1", plan_code, interval, **kwargs)
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def renew_on(service, clock, day):
+    clock.move_to(day)
+    [invoice] = service.renew_due()
+    return invoice
+
+
+# upgrades
+
+
+def test_upgrade_is_prorated_per_line_and_recorded(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1))
+    clock.move_to(date(2026, 3, 11))
+    invoice = service.change_plan(sub.id, "premium")
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert (invoice.total, invoice.issued_on) == (Decimal("30.49"), date(2026, 3, 11))
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "premium"
+    assert (changed.period_start, changed.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+
+
+def test_renewal_after_upgrade_bills_new_plan_in_full(service, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1))
+    clock.move_to(date(2026, 3, 11))
+    service.change_plan(sub.id, "premium")
+    assert renew_on(service, clock, date(2026, 4, 1)).total == Decimal("75.00")
+
+
+@pytest.mark.parametrize(
+    ("year", "lines"),
+    [
+        (2028, [Decimal("-150.82"), Decimal("377.05")]),  # 184 / 366
+        (2027, [Decimal("-151.23"), Decimal("378.08")]),  # 184 / 365
+    ],

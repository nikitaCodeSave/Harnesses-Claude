+"""Mid-cycle plan changes (specs/plan-changes.md)."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing import InvalidPlanChange as ExportedInvalidPlanChange
+from billing.errors import (
+    BillingError,
+    InvalidPlanChange,
+    InvoiceError,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+
+
+@pytest.fixture(autouse=True)
+def more_plans(store):
+    store.add_plan(Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")))
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("280.00")))
+
+
+def subscribe_on(service, clock, day, plan_code, interval=Interval.MONTHLY, **kwargs):
+    clock.move_to(day)
+    return service.subscribe("cus_1", plan_code, interval, **kwargs)
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def renew_on(service, clock, day):
+    clock.move_to(day)
+    [invoice] = service.renew_due()
+    return invoice
+
+
+# upgrades
+
+
+def test_upgrade_is_prorated_and_invoiced_now(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "premium"
+    assert (changed.period_start, changed.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+
+
+def test_renewal_after_upgrade_bills_new_plan_in_full(service, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))

+def assert_rejected(service, store, sub, error, *args):
+    invoices = store.invoices_for(sub.id)
+    before = store.get_subscription(sub.id)
+    with pytest.raises(error):
+        service.change_plan(sub.id, *args)
+    assert store.get_subscription(sub.id) == before
+    assert store.invoices_for(sub.id) == invoices

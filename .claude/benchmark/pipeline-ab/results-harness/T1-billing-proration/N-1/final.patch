diff --git a/src/billing/money.py b/src/billing/money.py
index f560010..321ad7c 100644
--- a/src/billing/money.py
+++ b/src/billing/money.py
@@ -20,6 +20,18 @@ def to_money(value: Decimal | int | str) -> Decimal:
     return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)
 
 
+def prorate(amount: Decimal, part: int, whole: int) -> Decimal:
+    """``amount * part / whole`` rounded to cents (half up), with no intermediate rounding.
+
+    Worked in integer cents so the quotient is exact before the one rounding.
+    """
+    scaled = int(to_money(amount) * 100) * part
+    cents, remainder = divmod(abs(scaled), whole)
+    if 2 * remainder >= whole:
+        cents += 1
+    return to_money(Decimal(cents if scaled >= 0 else -cents) / 100)
+
+
 def is_whole_cents(value: Decimal) -> bool:
     """True when ``value`` carries no precision below one cent."""
     return value == value.quantize(CENT, rounding=ROUND_HALF_UP)

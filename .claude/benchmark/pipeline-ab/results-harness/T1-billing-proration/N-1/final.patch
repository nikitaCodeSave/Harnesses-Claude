+"""Mid-cycle plan changes: see specs/plan-change.md and docs/adr/0001-plan-change-timing.md."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def renew(service, clock, day):
+    clock.move_to(day)
+    [invoice] = service.renew_due()
+    return invoice
+
+
+# upgrades
+
+
+def test_upgrade_is_prorated_now_with_credit_and_charge(service, store, clock):
+    clock.move_to(date(2026, 3, 1))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert invoice is not None
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")  # lines rounded on their own, not the net (30.48)
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "premium"
+    assert (changed.period_start, changed.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+    assert changed.scheduled_change is None
+
+
+def test_renewal_after_upgrade_bills_new_plan_in_full(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+
+    invoice = renew(service, clock, date(2026, 2, 15))
+
+    assert invoice.total == Decimal("30.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_upgrade_on_annual_is_prorated_at_annual_prices(service, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))  # 184 of 365 days left
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [Decimal("-50.41"), Decimal("151.23")]
+
+
+def test_upgrade_on_first_day_of_period_uses_full_prices(service):
+    sub = service.subscribe("cus_1", "basic")
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_upgrade_with_interval_switch_is_split(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))  # 21 of 31 days left
+
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    assert changed.period_end == date(2026, 2, 15)
+
+    renewal = renew(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("300.00")
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert renewed.period_end == date(2027, 2, 15)
+    assert renewed.scheduled_change is None
+
+
+# downgrades and interval switches
+
+
+def test_downgrade_waits_for_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic") is None
+    assert len(store.invoices_for(sub.id)) == 1
+    pending = store.get_subscription(sub.id)
+    assert pending.plan_code == "pro"
+    assert (pending.period_start, pending.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+
+    renewal = renew(service, clock, date(2026, 2, 15))
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_monthly_to_annual_waits_for_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+
+    renewal = renew(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("300.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.ANNUAL, date(2027, 2, 15))
+
+
+def test_annual_to_monthly_waits_for_period_end_without_refund(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 6, 1))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert [inv.total for inv in store.invoices_for(sub.id)] == [Decimal("300.00")]
+
+    renewal = renew(service, clock, date(2027, 1, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("30.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.MONTHLY, date(2027, 2, 15))
+
+
+# the scheduled change
+
+
+def test_new_request_replaces_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+    renewal = renew(service, clock, date(2026, 2, 15))
+
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert renewal.total == Decimal("300.00")
+
+
+def test_upgrade_while_downgrade_pending_prorates_from_current_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert store.get_subscription(sub.id).scheduled_change is None
+    assert renew(service, clock, date(2026, 2, 15)).total == Decimal("75.00")
+
+
+def test_upgrade_with_interval_switch_replaces_pending_downgrade(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)
+
+    renewal = renew(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.ANNUAL)
+    assert renewal.total == Decimal("750.00")
+
+
+def test_upgrade_discards_pending_interval_switch(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+    service.change_plan(sub.id, "pro")
+
+    renewal = renew(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert renewal.total == Decimal("30.00")
+
+
+def test_catch_up_applies_scheduled_change_from_first_missed_renewal(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 4, 15))
+
+    invoices = service.renew_due()
+
+    assert [inv.total for inv in invoices] == [Decimal("10.00")] * 3
+    assert store.get_subscription(sub.id).scheduled_change is None
+
+
+def test_requesting_current_plan_cancels_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "pro") is None
+
+    assert store.get_subscription(sub.id).scheduled_change is None
+    assert renew(service, clock, date(2026, 2, 15)).total == Decimal("30.00")
+
+
+# trials
+
+
+@pytest.mark.parametrize(
+    ("plan_code", "interval", "first_bill"),
+    [
+        ("premium", Interval.MONTHLY, Decimal("75.00")),
+        ("basic", Interval.MONTHLY, Decimal("10.00")),
+        ("pro", Interval.ANNUAL, Decimal("300.00")),
+    ],
+)
+def test_change_during_trial_applies_now_without_billing(service, store, clock, plan_code, interval, first_bill):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, plan_code, interval) is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == (plan_code, interval)
+    assert (changed.status, changed.period_end) == (SubscriptionStatus.TRIALING, date(2026, 1, 29))
+    assert store.invoices_for(sub.id) == []
+    assert renew(service, clock, date(2026, 1, 29)).total == first_bill
+
+
+# rejections
+
+
+def assert_rejected(service, store, sub_id, error, *args):
+    before = store.get_subscription(sub_id)
+    invoices_before = store.invoices_for(sub_id)
+    with pytest.raises(error):
+        service.change_plan(sub_id, *args)
+    assert store.get_subscription(sub_id) == before
+    assert store.invoices_for(sub_id) == invoices_before
+
+
+def test_unknown_subscription_is_rejected(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_9999", "pro")
+
+
+def test_canceled_subscription_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    assert_rejected(service, store, sub.id, SubscriptionNotActive, "pro")
+
+
+def test_unknown_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    assert_rejected(service, store, sub.id, PlanNotFound, "gold")
+
+
+@pytest.mark.parametrize("target", ["premium", "basic"])
+def test_retired_target_plan_is_rejected(service, store, target):
+    sub = service.subscribe("cus_1", "pro")
+    store.retire_plan(target)
+    assert_rejected(service, store, sub.id, PlanNotAvailable, target)
+
+
+def test_current_plan_with_nothing_scheduled_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    assert_rejected(service, store, sub.id, InvalidPlanChange, "pro")
+    assert_rejected(service, store, sub.id, InvalidPlanChange, "pro", Interval.ANNUAL)
+
+
+def test_interval_must_be_an_interval(service, store):
+    sub = service.subscribe("cus_1", "pro")
+    assert_rejected(service, store, sub.id, TypeError, "pro", "annual")
+
+
+def test_customer_on_retired_plan_can_move_off_it(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert invoice.total == Decimal("20.00")
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+
+# implementer's decisions (ADR 0001, 7-10)
+
+
+def test_same_monthly_price_other_plan_waits_for_period_end(service, store, clock):
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("280.00")))
+    sub = service.subscribe("cus_1", "pro")
+
+    assert service.change_plan(sub.id, "team") is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    renew(service, clock, date(2026, 2, 15))
+    assert store.get_subscription(sub.id).plan_code == "team"
+
+
+def test_interval_switch_on_retired_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    assert_rejected(service, store, sub.id, PlanNotAvailable, "basic", Interval.ANNUAL)
+
+
+def test_cancelling_scheduled_change_on_retired_plan_is_allowed(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    store.retire_plan("basic")
+
+    assert service.change_plan(sub.id, "basic") is None
+    assert store.get_subscription(sub.id).scheduled_change is None
+
+
+def test_request_with_renewal_overdue_is_rejected(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 15))
+    assert_rejected(service, store, sub.id, InvalidPlanChange, "pro")
+
+
+def test_scheduled_change_to_plan_retired_later_still_applies(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    store.retire_plan("basic")
+
+    assert renew(service, clock, date(2026, 2, 15)).total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_canceled_subscription_with_scheduled_change_is_not_renewed(service, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    service.cancel(sub.id)
+    clock.move_to(date(2026, 3, 1))
+    assert service.renew_due() == []

+"""CSV import of contacts.
+
+Reads files in the export format (see export.py) and merges them into a
+repository. The rules are in specs/csv-import.md and ADR 0001; in short:
+
+- the whole file is read and checked before anything is written, so an
+  ImportFileError always leaves the repository untouched;
+- a row with an error is skipped entirely; an invalid phone is only a warning;
+- existing contacts are merged: the name is replaced, the phone only when the
+  cell has a value, and tags are added, never removed.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_IMPORT_ROWS = 1000
+
+_BOM = "\ufeff"
+_FIELDS = ("name", "email", "phone", "tags")
+_NAME_PARTS = ("first_name", "last_name")
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row. ``row`` is the line number in the file (every
+    line counts, blank ones too); ``column`` is ``name``, ``email``, ``phone``,
+    ``tags`` or None when the issue is not about a single field."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did. Emails are normalised and in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True, slots=True)
+class _ValidRow:
+    name: str
+    email: str
+    phone: str | None  # None: keep the stored phone
+    tags: frozenset[str]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import a CSV file (raw bytes or decoded text) into ``repo``.
+
+    Raises ImportFileError, without touching ``repo``, when the file as a whole
+    can't be imported; problems with single rows end up in the report.
+    """
+    records = _read_records(_decode(data))
+    if not records:
+        raise ImportFileError("the file is empty")
+    (header_line, header), *rows = records
+    report = ImportReport()
+    columns = _read_header(header_line, header, report)
+
+    seen: dict[str, int] = {}
+    valid = [
+        parsed
+        for line, cells in rows
+        if (parsed := _read_row(line, cells, len(header), columns, seen, report))
+    ]
+
+    for row in valid:
+        existing = repo.find(row.email)
+        if existing is None:
+            repo.add(Contact(name=row.name, email=row.email, phone=row.phone, tags=row.tags))
+            report.created.append(row.email)
+        else:
+            repo.update(
+                replace(
+                    existing,
+                    name=row.name,
+                    phone=row.phone or existing.phone,
+                    tags=existing.tags | row.tags,
+                )
+            )
+            report.updated.append(row.email)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise ImportFileError(
+                f"the file is not UTF-8 text (invalid byte at offset {exc.start}); "
+                'please re-save it as "CSV UTF-8"'
+            ) from None
+    elif isinstance(data, str):
+        text = data
+    else:
+        raise TypeError(f"import data must be str or bytes, not {type(data).__name__}")
+    return text.removeprefix(_BOM)
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """Non-blank records with the line they start on: the header and the contact
+    rows. Stops reading as soon as the row limit is exceeded."""
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    records: list[tuple[int, list[str]]] = []
+    while True:
+        line = reader.line_num + 1
+        try:
+            cells = next(reader)
+        except StopIteration:
+            return records
+        except csv.Error as exc:
+            raise ImportFileError(f"line {line} is not valid CSV: {exc}") from None
+        if not any(cell.strip() for cell in cells):
+            continue
+        records.append((line, cells))
+        if len(records) > MAX_IMPORT_ROWS + 1:
+            raise ImportFileError(
+                f"the file has more than {MAX_IMPORT_ROWS} contacts; "
+                "please split it into smaller files"
+            )
+
+
+def _read_header(line: int, header: list[str], report: ImportReport) -> dict[str, int]:
+    """Map recognised column names to their position; warn about ignored ones."""
+    columns: dict[str, int] = {}
+    for index, raw in enumerate(header):
+        name = raw.strip().lower()
+        if name in _FIELDS or name in _NAME_PARTS:
+            if name in columns:
+                raise ImportFileError(f"column {name!r} appears more than once in the header")
+            columns[name] = index
+    if "email" not in columns:
+        raise ImportFileError("the header has no 'email' column")
+    if "name" in columns:
+        for part in _NAME_PARTS:
+            columns.pop(part, None)
+    elif not all(part in columns for part in _NAME_PARTS):
+        raise ImportFileError(
+            "the header has no 'name' column (or 'first_name' and 'last_name' columns)"
+        )
+
+    used = set(columns.values())
+    for index, raw in enumerate(header):
+        if index not in used and raw.strip():
+            report.warnings.append(RowIssue(line, None, f"column {raw.strip()!r} is ignored"))
+    return columns
+
+
+def _read_row(
+    line: int,
+    cells: list[str],
+    width: int,
+    columns: dict[str, int],
+    seen: dict[str, int],
+    report: ImportReport,
+) -> _ValidRow | None:
+    """Validate one contact row. Returns None, after reporting its errors, if the
+    row must be skipped. ``seen`` maps emails to the row that first used them."""
+    if len(cells) > width:
+        report.errors.append(
+            RowIssue(
+                line,
+                None,
+                f"row has {len(cells)} cells but the header has {width} columns "
+                "(a comma in a value that is not quoted?)",
+            )
+        )
+        return None
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    errors: list[RowIssue] = []
+
+    def check(column: str, normalise, raw):
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(line, column, exc.message))
+            return None
+
+    raw_name = cell("name") if "name" in columns else f"{cell('first_name')} {cell('last_name')}"
+    name = check("name", validate_name, raw_name)
+    email = check("email", normalize_email, cell("email"))
+    if email is not None:
+        if email in seen:
+            errors.append(
+                RowIssue(line, "email", f"{email} already appears on row {seen[email]}")
+            )
+        else:
+            seen[email] = line
+    pieces = [piece for piece in cell("tags").split(TAG_SEPARATOR) if piece.strip()]
+    tags = check("tags", normalize_tags, pieces)
+
+    if errors:
+        report.errors.extend(errors)
+        return None
+
+    phone = None
+    raw_phone = cell("phone")
+    if raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(line, "phone", f"{exc.message}; the phone was not imported")
+            )
+    return _ValidRow(name=name, email=email, phone=phone, tags=tags)

+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def ann(**overrides):
+    fields = {"name": "Ann Lee", "email": "ann@example.com"}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def issues(found):
+    return [(issue.row, issue.column) for issue in found]
+
+
+# --- reading the file -------------------------------------------------------
+
+
+def test_export_round_trips_into_an_empty_repository():
+    contacts = [
+        ann(phone="+15551234567", tags=["vip", "lead"]),
+        Contact.create(name="Bob, Jr.", email="bob@example.com"),
+    ]
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, export_csv(contacts))
+    assert report == ImportReport(
+        created=["ann@example.com", "bob@example.com"], updated=[], errors=[], warnings=[]
+    )
+    assert repo.all() == contacts
+
+
+def test_bytes_and_text_with_or_without_bom_import_the_same():
+    text = HEADER + "Ann Lee,ann@example.com,,\n"
+    for data in (text, "\ufeff" + text, text.encode(), b"\xef\xbb\xbf" + text.encode()):
+        repo = InMemoryContactRepository()
+        report = import_contacts(repo, data)
+        assert report.created == ["ann@example.com"], data
+        assert report.warnings == [], data
+
+
+def test_utf8_names_survive_bytes_input():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, (HEADER + "Zoë Ångström,zoe@example.com,,\n").encode())
+    assert repo.get("zoe@example.com").name == "Zoë Ångström"
+
+
+def test_crlf_line_endings_are_accepted():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, b"name,email\r\nAnn Lee,ann@example.com\r\n")
+    assert report.created == ["ann@example.com"]
+
+
+def test_non_utf8_bytes_reject_the_file():
+    repo = InMemoryContactRepository()
+    data = (HEADER + "Zoë,zoe@example.com,,\n").encode("cp1252")
+    with pytest.raises(ImportFileError, match="CSV UTF-8"):
+        import_contacts(repo, data)
+    assert len(repo) == 0
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)
+
+
+@pytest.mark.parametrize("data", ["", b"", "\n\n", " , ,\n\n", "\ufeff", b"\xef\xbb\xbf\n"])
+def test_empty_file_is_rejected(data):
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), data)
+
+
+def test_header_only_file_gives_an_empty_report():
+    assert import_contacts(InMemoryContactRepository(), HEADER) == ImportReport(
+        created=[], updated=[], errors=[], warnings=[]
+    )
+
+
+@pytest.mark.parametrize(
+    "header", ["name,phone,tags", "email,phone,tags", "first_name,email", "last_name,email"]
+)
+def test_missing_required_column_rejects_the_file(header):
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, header + "\nAnn,ann@example.com\n")
+    assert len(repo) == 0
+
+
+def test_header_matching_ignores_case_spaces_and_order():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, " Tags , EMAIL,Name \nvip,ann@example.com,Ann Lee\n")
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == ann(tags=["vip"])
+
+
+def test_unknown_columns_are_ignored_with_a_warning_not_an_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "name,company,email\nAnn Lee,ACME,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert issues(report.warnings) == [(1, None)]
+    assert "company" in report.warnings[0].message
+
+
+def test_repeated_recognised_column_rejects_the_file():
+    with pytest.raises(ImportFileError, match="email"):
+        import_contacts(InMemoryContactRepository(), "name,email,Email\nAnn,a@example.com,b@example.com\n")
+
+
+def test_unclosed_quote_rejects_the_file():
+    repo = InMemoryContactRepository()
+    data = HEADER + "Ann Lee,ann@example.com,,\n\"Bob,bob@example.com,,\nCid,cid@example.com,,\n"
+    with pytest.raises(ImportFileError, match="line 3"):
+        import_contacts(repo, data)
+    assert len(repo) == 0
+
+
+# --- first_name / last_name -------------------------------------------------
+
+
+def test_first_and_last_name_are_joined_with_one_space():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "first_name,last_name,email\n Ann , Lee ,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_first_and_last_name_without_spaces_get_one_between_them():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, "first_name,last_name,email\nAnn,Lee,ann@example.com\n")
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_blank_first_and_last_name_is_a_name_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "First_Name,Last_Name,email\n,,ann@example.com\n")
+    assert issues(report.errors) == [(2, "name")]
+    assert len(repo) == 0
+
+
+# --- row numbers, blank rows, limit -----------------------------------------
+
+
+def test_row_numbers_count_every_line_including_blank_ones():
+    data = HEADER + "\nAnn Lee,not-an-email,,\n,,,\n   ,  ,,\nBob,,,\n"
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert issues(report.errors) == [(3, "email"), (6, "email")]
+
+
+def test_multi_line_cell_is_reported_at_the_line_its_row_starts():
+    data = HEADER + '"Ann\nLee",bad,,\n"Bob\n\nStone",,,\nCid,cid,,\n'
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert issues(report.errors) == [(2, "email"), (4, "email"), (7, "email")]
+
+
+def test_cell_beyond_the_csv_field_limit_rejects_the_file():
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError, match="line 2"):
+        import_contacts(repo, HEADER + "x" * 140_000 + ",ann@example.com,,\n")
+    assert len(repo) == 0
+
+
+def test_blank_rows_are_skipped_silently():
+    data = HEADER + "\n,,,\n , , , \nAnn Lee,ann@example.com,,\n\n"
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert report == ImportReport(created=["ann@example.com"], updated=[], errors=[], warnings=[])
+
+
+def contact_rows(count):
+    return "".join(f"P{i},p{i}@example.com,,\n" for i in range(count))
+
+
+def test_a_thousand_contact_rows_are_imported():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + contact_rows(1000) + ",,,\n\n" * 50)
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_more_than_a_thousand_contact_rows_rejects_the_file():
+    repo = InMemoryContactRepository([ann()])
+    with pytest.raises(ImportFileError, match="1000"):
+        import_contacts(repo, HEADER + "Ann Smith,ann@example.com,,\n" + contact_rows(1000))
+    assert repo.all() == [ann()]
+
+
+def test_invalid_rows_count_towards_the_limit():
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), HEADER + contact_rows(1000) + "x,bad,,\n")
+
+
+# --- row errors -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "row, column",
+    [
+        (",ann@example.com,,", "name"),
+        ("   ,ann@example.com,,", "name"),
+        (f"{'x' * 101},ann@example.com,,", "name"),
+        ("Ann Lee,,,", "email"),
+        ("Ann Lee,ann@example,,", "email"),
+        ("Ann Lee,ann@example.com,,vip;c++", "tags"),
+    ],
+)
+def test_invalid_field_is_a_row_error_and_the_row_is_skipped(row, column):
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + row + "\n")
+    assert issues(report.errors) == [(2, column)]
+    assert report.created == report.updated == report.warnings == []
+    assert len(repo) == 0
+
+
+def test_every_problem_in_a_row_is_reported():
+    report = import_contacts(InMemoryContactRepository(), HEADER + ",nope,,c++\n")
+    assert issues(report.errors) == [(2, "name"), (2, "email"), (2, "tags")]
+
+
+def test_rejected_row_does_not_touch_the_existing_contact():
+    existing = ann(phone="+15551234567", tags=["vip"])
+    repo = InMemoryContactRepository([existing])
+    report = import_contacts(repo, HEADER + "Ann Smith,ann@example.com,+4930123456,lead;c++\n")
+    assert issues(report.errors) == [(2, "tags")]
+    assert report.updated == []
+    assert repo.get("ann@example.com") == existing
+
+
+def test_name_is_required_when_updating_too():
+    repo = InMemoryContactRepository([ann()])
+    report = import_contacts(repo, HEADER + ",ANN@example.com,+4930123456,lead\n")
+    assert issues(report.errors) == [(2, "name")]
+    assert repo.get("ann@example.com") == ann()
+
+
+def test_repeated_email_in_the_file_first_row_wins():
+    repo = InMemoryContactRepository()
+    data = HEADER + "Ann Lee,ann@example.com,,\nBob,bob@example.com,,\nAnn Smith, ANN@Example.com ,,vip\n"
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert issues(report.errors) == [(4, "email")]
+    assert "row 2" in report.errors[0].message
+    assert repo.get("ann@example.com") == ann()
+
+
+def test_repeated_email_after_a_rejected_row_is_still_an_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + ",ann@example.com,,\nAnn Lee,ann@example.com,,\n")
+    assert issues(report.errors) == [(2, "name"), (3, "email")]
+    assert len(repo) == 0
+
+
+def test_row_with_more_cells_than_the_header_is_an_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "name,email\nLee, Ann,ann@example.com\nAnn Lee,ann@example.com\n")
+    assert issues(report.errors) == [(2, None)]
+    assert report.created == ["ann@example.com"]
+
+
+def test_shifted_row_is_an_error_even_when_the_extra_cell_is_empty():
+    existing = ann(phone="+15551234567")
+    repo = InMemoryContactRepository([existing])
+    report = import_contacts(repo, "email,name,phone,tags\nann@example.com,Lee, Ann,,\n")
+    assert issues(report.errors) == [(2, None)]
+    assert repo.get("ann@example.com") == existing
+
+
+def test_short_rows_are_padded_with_empty_cells():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "Bob,bob@example.com\n")
+    assert report.created == ["bob@example.com"]
+    assert report.errors == []
+
+
+def test_rows_as_wide_as_a_header_with_unnamed_columns_are_fine():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "name,email,phone,tags,,\nAnn Lee,ann@example.com,,,,\n")
+    assert report == ImportReport(created=["ann@example.com"], updated=[], errors=[], warnings=[])
+
+
+# --- merging into existing contacts -----------------------------------------
+
+
+def test_existing_contact_is_merged_not_duplicated():
+    repo = InMemoryContactRepository([ann(phone="+15551234567", tags=["vip"])])
+    report = import_contacts(repo, HEADER + "Ann Smith,ANN@example.com,+49 30 123456,lead\n")
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert len(repo) == 1
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="+4930123456",
+        tags=frozenset({"vip", "lead"}),
+    )
+
+
+@pytest.mark.parametrize(
+    "data", [HEADER + "Ann Smith,ann@example.com,  ,\n", "name,email\nAnn Smith,ann@example.com\n"]
+)
+def test_empty_or_missing_phone_keeps_the_existing_phone(data):
+    repo = InMemoryContactRepository([ann(phone="+15551234567", tags=["vip"])])
+    report = import_contacts(repo, data)
+    assert report.updated == ["ann@example.com"]
+    assert report.warnings == []
+    assert repo.get("ann@example.com") == ann(
+        name="Ann Smith", phone="+15551234567", tags=["vip"]
+    )
+
+
+def test_unchanged_contact_is_listed_as_updated():
+    repo = InMemoryContactRepository([ann()])
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,,\n")
+    assert report == ImportReport(created=[], updated=["ann@example.com"], errors=[], warnings=[])
+
+
+def test_tags_cell_ignores_empty_pieces():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, HEADER + "Ann Lee,ann@example.com,, VIP ;;Key Account;\n")
+    assert repo.get("ann@example.com").tags == {"vip", "key-account"}
+
+
+# --- invalid phone is a warning ---------------------------------------------
+
+
+def test_invalid_phone_on_new_contact_is_a_warning_and_contact_has_no_phone():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,CALL ME,vip\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert issues(report.warnings) == [(2, "phone")]
+    assert repo.get("ann@example.com") == ann(tags=["vip"])
+
+
+def test_invalid_phone_on_existing_contact_keeps_its_phone():
+    repo = InMemoryContactRepository([ann(phone="+15551234567")])
+    report = import_contacts(repo, HEADER + "Ann Smith,ann@example.com,12345,lead\n")
+    assert report.updated == ["ann@example.com"]
+    assert issues(report.warnings) == [(2, "phone")]
+    assert repo.get("ann@example.com") == ann(
+        name="Ann Smith", phone="+15551234567", tags=["lead"]
+    )
+
+
+def test_rejected_row_reports_no_phone_warning():
+    report = import_contacts(InMemoryContactRepository(), HEADER + ",ann@example.com,123,\n")
+    assert issues(report.errors) == [(2, "name")]
+    assert report.warnings == []
+
+
+def test_row_issue_shape():
+    report = import_contacts(InMemoryContactRepository(), HEADER + "Ann Lee,bad,,\n")
+    assert isinstance(report.errors[0], RowIssue)
+    assert report.errors[0].message

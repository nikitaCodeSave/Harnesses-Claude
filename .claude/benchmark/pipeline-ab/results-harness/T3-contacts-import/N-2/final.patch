+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+BOM = chr(0xFEFF)
+HEADER = "name,email,phone,tags\n"
+
+
+def ann(**overrides):
+    fields = {"name": "Ann Lee", "email": "ann@example.com"}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def repo_with(*contacts):
+    return InMemoryContactRepository(contacts)
+
+
+# --- creating and reporting -------------------------------------------------
+
+
+def test_new_rows_are_created_and_reported():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        HEADER
+        + " Ann  Lee ,Ann@Example.com,+1 555 123 4567,VIP\n"
+        + "Bob Stone,bob@example.com,,\n",
+    )
+    assert report == ImportReport(
+        created=["ann@example.com", "bob@example.com"], updated=[], errors=[], warnings=[]
+    )
+    assert repo.all() == [
+        Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip"]),
+        Contact.create("Bob Stone", "bob@example.com"),
+    ]
+
+
+def test_export_output_round_trips():
+    contacts = [
+        Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip", "lead"]),
+        Contact.create("Bob, Jr.", "bob@example.com"),
+    ]
+    repo = InMemoryContactRepository()
+    import_contacts(repo, export_csv(contacts))
+    assert repo.all() == contacts
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)
+
+
+def test_names_are_exported_from_package():
+    import contactbook
+
+    for name in ("import_contacts", "ImportReport", "RowIssue", "ImportFileError"):
+        assert hasattr(contactbook, name)
+
+
+# --- decoding ---------------------------------------------------------------
+
+
+def test_utf8_bytes_with_bom_import_like_plain_text():
+    text = HEADER + "Zoë Ångström,zoe@example.com,,\n"
+    repo_plain, repo_bom = InMemoryContactRepository(), InMemoryContactRepository()
+    import_contacts(repo_plain, text.encode("utf-8"))
+    report = import_contacts(repo_bom, (BOM + text).encode("utf-8"))
+    assert report.created == ["zoe@example.com"]
+    assert repo_bom.all() == repo_plain.all()
+    assert repo_bom.get("zoe@example.com").name == "Zoë Ångström"
+
+
+def test_text_starting_with_bom_character_works():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, BOM + HEADER + "Ann Lee,ann@example.com,,\n")
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == []
+
+
+def test_non_utf8_bytes_are_rejected_with_resave_hint():
+    repo = repo_with(ann())
+    data = (HEADER + "Zoë,zoe@example.com,,\n").encode("cp1252")
+    with pytest.raises(ImportFileError, match="CSV UTF-8"):
+        import_contacts(repo, data)
+    assert repo.all() == [ann()]
+
+
+def test_other_input_types_are_a_programming_error():
+    with pytest.raises(TypeError):
+        import_contacts(InMemoryContactRepository(), 42)
+
+
+# --- header -----------------------------------------------------------------
+
+
+@pytest.mark.parametrize("data", ["", "   \n\n", b"", BOM, BOM.encode("utf-8")])
+def test_empty_file_is_rejected(data):
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), data)
+
+
+def test_header_only_gives_empty_report():
+    assert import_contacts(InMemoryContactRepository(), HEADER) == ImportReport([], [], [], [])
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["name,phone,tags", "email,phone", "email,first_name", "email,last_name"],
+)
+def test_missing_required_column_is_rejected(header):
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), header + "\nAnn,ann@example.com\n")
+
+
+def test_header_matching_ignores_case_spaces_and_order():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, " TAGS , Email ,Name,PHONE\nvip,ann@example.com,Ann Lee,5551234567\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        "Ann Lee", "ann@example.com", "5551234567", ["vip"]
+    )
+
+
+def test_duplicated_recognised_column_is_rejected():
+    with pytest.raises(ImportFileError):
+        import_contacts(
+            InMemoryContactRepository(), "name,email,Email\nAnn,ann@example.com,x@y.com\n"
+        )
+
+
+def test_first_and_last_name_are_joined():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "first_name,last_name,email\n Ann , Lee ,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_first_name_alone_is_enough_when_last_name_cell_is_empty():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, "first_name,last_name,email\nCher,,cher@example.com\n")
+    assert repo.get("cher@example.com").name == "Cher"
+
+
+def test_blank_first_and_last_name_is_a_name_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "first_name,last_name,email\n , ,ann@example.com\n")
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name")]
+    assert len(repo) == 0
+
+
+def test_name_column_wins_over_first_and_last_name():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, "first_name,last_name,name,email\nA,B,Ann Lee,ann@example.com\n")
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_each_unknown_column_warns_at_the_header_row_and_empty_header_cells_are_silent():
+    report = import_contacts(
+        InMemoryContactRepository(), "\n\nname,email,Notes,Source,,\nAnn,ann@example.com,,,,\n"
+    )
+    assert [(w.row, w.column) for w in report.warnings] == [(3, None), (3, None)]
+    assert "Notes" in report.warnings[0].message
+    assert "Source" in report.warnings[1].message
+    assert report.created == ["ann@example.com"]
+
+
+def test_unknown_column_is_ignored_with_a_warning():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "name,email,Notes\nAnn Lee,ann@example.com,met at fair\n")
+    assert report.created == ["ann@example.com"]
+    assert len(report.warnings) == 1
+    warning = report.warnings[0]
+    assert (warning.row, warning.column) == (1, None)
+    assert "Notes" in warning.message
+
+
+# --- merging into existing contacts -----------------------------------------
+
+
+def test_existing_contact_is_merged():
+    repo = repo_with(ann(phone="+15551234567", tags=["vip"]))
+    report = import_contacts(repo, HEADER + "Ann Smith,ANN@example.com,+44 20 7946 0000,lead\n")
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert repo.get("ann@example.com") == Contact.create(
+        "Ann Smith", "ann@example.com", "+442079460000", ["vip", "lead"]
+    )
+
+
+def test_empty_phone_cell_keeps_existing_phone():
+    repo = repo_with(ann(phone="+15551234567"))
+    import_contacts(repo, HEADER + "Ann Smith,ann@example.com,  ,\n")
+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+def test_missing_phone_column_keeps_existing_phone_and_tags():
+    repo = repo_with(ann(phone="+15551234567", tags=["vip"]))
+    import_contacts(repo, "name,email\nAnn Smith,ann@example.com\n")
+    assert repo.get("ann@example.com") == Contact.create(
+        "Ann Smith", "ann@example.com", "+15551234567", ["vip"]
+    )
+
+
+def test_unchanged_contact_is_in_neither_list():
+    repo = repo_with(ann(phone="+15551234567", tags=["vip"]))
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,+1 555 123 4567,VIP\n")
+    assert report == ImportReport([], [], [], [])
+
+
+# --- row errors -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("row", "column"),
+    [
+        ("Ann Lee,not-an-email,,", "email"),
+        ("Ann Lee,,,", "email"),
+        ("   ,ann@example.com,,", "name"),
+        ("Ann Lee,ann@example.com,,vip;c++", "tags"),
+    ],
+)
+def test_bad_row_is_an_error_and_not_applied(row, column):
+    existing = ann(name="Ann Old", phone="+15551234567", tags=["vip"])
+    repo = repo_with(existing)
+    report = import_contacts(repo, HEADER + row + "\nBob Stone,bob@example.com,,\n")
+    assert [(e.row, e.column) for e in report.errors] == [(2, column)]
+    assert report.created == ["bob@example.com"]
+    assert report.updated == []
+    assert repo.get("ann@example.com") == existing
+
+
+def test_bad_tag_on_existing_contact_does_not_apply_name_or_phone():
+    existing = ann(phone="+15551234567")
+    repo = repo_with(existing)
+    report = import_contacts(repo, HEADER + "Ann Smith,ann@example.com,+4930123456,ok;c++\n")
+    assert len(report.errors) == 1
+    assert repo.get("ann@example.com") == existing
+
+
+def test_all_problems_of_a_row_are_reported():
+    report = import_contacts(InMemoryContactRepository(), HEADER + " ,nope,,c++\n")
+    assert sorted(e.column for e in report.errors) == ["email", "name", "tags"]
+    assert {e.row for e in report.errors} == {2}
+
+
+def test_tags_are_split_normalised_and_deduplicated():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, HEADER + 'Ann Lee,ann@example.com,,"VIP; ;Key Account;vip;"\n')
+    assert repo.get("ann@example.com").tags == {"vip", "key-account"}
+
+
+# --- phone warnings ---------------------------------------------------------
+
+
+def test_invalid_phone_on_new_contact_is_a_warning():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,CALL ME,vip\n")
+    assert report.errors == []
+    assert [(w.row, w.column) for w in report.warnings] == [(2, "phone")]
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com", None, ["vip"])
+
+
+def test_invalid_phone_on_existing_contact_keeps_old_phone_and_applies_rest():
+    repo = repo_with(ann(phone="+15551234567"))
+    report = import_contacts(repo, HEADER + "Ann Smith,ann@example.com,123,lead\n")
+    assert [(w.row, w.column) for w in report.warnings] == [(2, "phone")]
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        "Ann Smith", "ann@example.com", "+15551234567", ["lead"]
+    )
+
+
+# --- duplicates within the file ---------------------------------------------
+
+
+def test_later_row_with_same_email_is_an_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "Ann Lee,ann@example.com,,\nAnn Two, ANN@Example.com ,,\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [(3, "email")]
+    assert "row 2" in report.errors[0].message
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_duplicate_row_gets_a_single_error():
+    report = import_contacts(
+        InMemoryContactRepository(), HEADER + "Ann,ann@example.com,,\n ,ann@example.com,x,c++\n"
+    )
+    assert [(e.row, e.column) for e in report.errors] == [(3, "email")]
+    assert report.warnings == []
+
+
+def test_misaligned_row_does_not_claim_its_email():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "Ann Lee,ann@example.com,,vip,extra\nAnn Two,ann@example.com,,\n"
+    )
+    assert [(e.row, e.column) for e in report.errors] == [(2, None)]
+    assert repo.get("ann@example.com").name == "Ann Two"
+
+
+def test_phone_warning_is_reported_on_a_rejected_row_too():
+    report = import_contacts(InMemoryContactRepository(), HEADER + " ,ann@example.com,xx,\n")
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name")]
+    assert [(w.row, w.column) for w in report.warnings] == [(2, "phone")]
+
+
+def test_first_row_claims_email_even_when_it_is_rejected():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + " ,ann@example.com,,\nAnn Two,ann@example.com,,\n"
+    )
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name"), (3, "email")]
+    assert len(repo) == 0
+
+
+# --- row numbers and blank rows ---------------------------------------------
+
+
+def test_row_numbers_count_blank_lines_and_blank_rows_are_silent():
+    report = import_contacts(
+        InMemoryContactRepository(),
+        HEADER + "\n , , ,\n,,,\nAnn Lee,bad,,\r\n\r\nBob,also-bad,,\n",
+    )
+    assert report.warnings == []
+    assert [e.row for e in report.errors] == [5, 7]
+
+
+def test_multiline_cell_row_is_numbered_by_its_first_line():
+    report = import_contacts(
+        InMemoryContactRepository(),
+        HEADER + '"Ann\nLee",ann@example.com,,\nBob,bad,,\n',
+    )
+    assert report.created == ["ann@example.com"]
+    assert [e.row for e in report.errors] == [4]
+
+
+# --- cell counts ------------------------------------------------------------
+
+
+def test_extra_non_empty_cell_is_an_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "Lee, Ann,ann@example.com,,vip\n")
+    assert [(e.row, e.column) for e in report.errors] == [(2, None)]
+    assert len(repo) == 0
+
+
+def test_extra_empty_cells_are_ignored_and_short_rows_padded():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "Ann Lee,ann@example.com,,,, \nBob Stone,bob@example.com\n"
+    )
+    assert report.errors == []
+    assert report.created == ["ann@example.com", "bob@example.com"]
+
+
+# --- whole-file errors leave the repo untouched ------------------------------
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "",
+        "name,phone\nBob,\n",
+        "name,email,EMAIL\nBob,bob@example.com,bob@example.com\n",
+        HEADER + "Bob,bob@example.com,,\n" + "Carl," + "x" * 200_000 + ",,\n",
+    ],
+)
+def test_whole_file_errors_leave_repo_untouched(data):
+    repo = repo_with(ann())
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, data)
+    assert repo.all() == [ann()]
+
+
+def test_unterminated_quote_is_rejected_naming_its_row():
+    repo = repo_with(ann())
+    with pytest.raises(ImportFileError, match="row 3"):
+        import_contacts(repo, HEADER + 'Bob,bob@example.com,,\n"Carl,carl@example.com,,\n')
+    assert repo.all() == [ann()]
+
+
+def test_text_after_closing_quote_is_rejected():
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError, match="row 3"):
+        import_contacts(repo, HEADER + 'Bob,bob@example.com,,\n"Carl"x,carl@example.com,,\n')
+    assert len(repo) == 0
+
+
+def test_oversized_cell_is_reported_as_such():
+    with pytest.raises(ImportFileError, match="row 2: a cell is longer than"):
+        import_contacts(InMemoryContactRepository(), HEADER + "x" * 200_000 + ",a@b.com,,\n")
+
+
+def _rows(count):
+    return "".join(f"P{i},p{i}@example.com,,\n" for i in range(count))
+
+
+def test_thousand_contact_rows_are_accepted_and_blank_rows_do_not_count():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "\n,,,\n" + _rows(1000) + "\n")
+    assert len(report.created) == 1000
+
+
+def test_invalid_rows_count_towards_the_limit():
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, HEADER + _rows(1000) + "bad,row,,\n")
+    assert len(repo) == 0
+
+
+def test_more_than_thousand_rows_is_rejected_and_nothing_written():
+    repo = repo_with(ann())
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, HEADER + _rows(1001))
+    assert repo.all() == [ann()]
+
+
+def test_row_issue_shape():
+    issue = RowIssue(row=2, column="email", message="is required")
+    assert (issue.row, issue.column, issue.message) == (2, "email", "is required")

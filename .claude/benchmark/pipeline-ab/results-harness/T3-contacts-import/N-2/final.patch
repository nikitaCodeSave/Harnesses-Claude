@@ -0,0 +1,230 @@
+"""CSV import of contacts.
+
+Rules are in specs/csv-import.md and docs/adr/0001-csv-import-merge-semantics.md.
+The whole file is read and checked before anything is written, so an
+ImportFileError leaves the repository untouched.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_CONTACT_ROWS = 1000
+
+_BOM = chr(0xFEFF)
+_KNOWN_COLUMNS = frozenset({"name", "email", "phone", "tags", "first_name", "last_name"})
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row; ``row`` is the spreadsheet row number (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did: emails created/updated, and row errors/warnings."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True, slots=True)
+class _Row:
+    """A contact row that passed validation; ``phone`` None means "leave as is"."""
+
+    email: str
+    name: str
+    phone: str | None
+    tags: frozenset[str]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import CSV content into ``repo`` and report what happened.
+
+    Raises ImportFileError, without touching ``repo``, if the file as a whole
+    can't be imported; row problems are reported instead of raised.
+    """
+    records = _read_records(_decode(data))
+    if not records:
+        raise ImportFileError("the file is empty")
+    (header_row, header), body = records[0], records[1:]
+
+    report = ImportReport()
+    columns = _map_header(header_row, header, report)
+    claimed: dict[str, int] = {}
+    rows: list[_Row] = []
+    for number, cells in body:
+        parsed = _parse_row(number, cells, columns, len(header), claimed, report)
+        if parsed is not None:
+            rows.append(parsed)
+
+    for row in rows:
+        existing = repo.find(row.email)
+        if existing is None:
+            repo.add(Contact(name=row.name, email=row.email, phone=row.phone, tags=row.tags))
+            report.created.append(row.email)
+            continue
+        merged = replace(
+            existing,
+            name=row.name,
+            phone=row.phone or existing.phone,
+            tags=existing.tags | row.tags,
+        )
+        if merged != existing:
+            repo.update(merged)
+            report.updated.append(row.email)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and try again'
+            ) from None
+    elif isinstance(data, str):
+        text = data
+    else:
+        raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+    return text.removeprefix(_BOM)
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """Non-blank records with the row number of the line each one starts on.
+
+    Stops with ImportFileError as soon as there are more than MAX_CONTACT_ROWS
+    contact rows after the header.
+    """
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    records: list[tuple[int, list[str]]] = []
+    last_line = 0
+    while True:
+        start = last_line + 1
+        try:
+            cells = next(reader)
+        except StopIteration:
+            return records
+        except csv.Error as exc:
+            if "field limit" in str(exc):
+                raise ImportFileError(
+                    f"row {start}: a cell is longer than {csv.field_size_limit()} characters"
+                ) from None
+            raise ImportFileError(f"row {start}: malformed CSV ({exc})") from None
+        last_line = reader.line_num
+        if all(not cell.strip() for cell in cells):
+            continue
+        records.append((start, cells))
+        if len(records) - 1 > MAX_CONTACT_ROWS:
+            raise ImportFileError(
+                f"the file has more than {MAX_CONTACT_ROWS} contacts; split it into smaller files"
+            )
+
+
+def _map_header(number: int, header: list[str], report: ImportReport) -> dict[str, int]:
+    """Map canonical column names to their index; warn about unknown columns."""
+    columns: dict[str, int] = {}
+    for index, cell in enumerate(header):
+        name = cell.strip().lower()
+        if not name:
+            continue
+        if name not in _KNOWN_COLUMNS:
+            report.warnings.append(
+                RowIssue(number, None, f"unknown column {cell.strip()!r} ignored")
+            )
+        elif name in columns:
+            raise ImportFileError(f"column {name!r} appears more than once in the header")
+        else:
+            columns[name] = index
+
+    if "email" not in columns:
+        raise ImportFileError("missing required column 'email'")
+    if "name" not in columns and not {"first_name", "last_name"} <= columns.keys():
+        raise ImportFileError(
+            "missing required column 'name' (or both 'first_name' and 'last_name')"
+        )
+    return columns
+
+
+def _parse_row(
+    number: int,
+    cells: list[str],
+    columns: dict[str, int],
+    width: int,
+    claimed: dict[str, int],
+    report: ImportReport,
+) -> _Row | None:
+    """Validate one contact row, recording its issues; None if it must not be applied."""
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    def error(column: str | None, message: str) -> None:
+        report.errors.append(RowIssue(number, column, message))
+
+    if any(extra.strip() for extra in cells[width:]):
+        error(
+            None,
+            f"has {len(cells)} cells but the header has {width}; "
+            "check for an unquoted comma",
+        )
+        return None
+
+    ok = True
+    email = ""
+    try:
+        email = normalize_email(cell("email"))
+    except ValidationError as exc:
+        error("email", exc.message)
+        ok = False
+    else:
+        if email in claimed:
+            error("email", f"same email as row {claimed[email]}; row skipped")
+            return None
+        claimed[email] = number
+
+    raw_name = cell("name") if "name" in columns else f"{cell('first_name')} {cell('last_name')}"
+    name = ""
+    try:
+        name = validate_name(raw_name)
+    except ValidationError as exc:
+        error("name", exc.message)
+        ok = False
+
+    tags: set[str] = set()
+    try:
+        for piece in cell("tags").split(TAG_SEPARATOR):
+            if piece.strip():
+                tags.add(normalize_tag(piece))
+    except ValidationError as exc:
+        error("tags", exc.message)
+        ok = False
+
+    phone = None
+    if cell("phone").strip():
+        try:
+            phone = normalize_phone(cell("phone"))
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(number, "phone", f"{exc.message}; phone left unchanged")
+            )
+
+    if not ok:
+        return None
+    return _Row(email=email, name=name, phone=phone, tags=frozenset(tags))

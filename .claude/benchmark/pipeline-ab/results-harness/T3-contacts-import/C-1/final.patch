+"""CSV import of contacts.
+
+Reads the columns written by ``export_csv`` and merges each good row into a
+repository; see specs/csv-import.md and docs/adr/0001-csv-import-merges.md.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_CONTACT_ROWS = 1000
+KNOWN_COLUMNS = ("name", "email", "phone", "tags", "first_name", "last_name")
+
+_BOM = "\N{BYTE ORDER MARK}"
+_HEADER_ROW = 1
+
+
+@dataclass
+class RowIssue:
+    """One problem found while importing. ``row`` is the file line the row starts on."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did. Emails are normalised; all lists are in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import CSV file content into ``repo`` and report per row what happened.
+
+    Rows with an invalid name, email or tag are skipped and reported in
+    ``errors``; good rows are applied. An existing contact is merged: the name is
+    replaced, the phone only by a valid non-blank value, and tags are added.
+    Raises ImportFileError, without changing ``repo``, when the file as a whole
+    can't be imported.
+    """
+    rows = _read_rows(_decode(data))
+    header_cells = rows[0][1]
+    columns, name_columns, header_warnings = _parse_header(header_cells)
+
+    body = [(row, cells) for row, cells in rows[1:] if not _is_blank(cells)]
+    if len(body) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"file has {len(body)} contact rows; at most {MAX_CONTACT_ROWS} can be imported at once"
+        )
+
+    report = ImportReport(warnings=header_warnings)
+    first_row_by_email: dict[str, int] = {}
+    for row, cells in body:
+        if len(cells) > len(header_cells):
+            report.errors.append(
+                RowIssue(row, None, f"has {len(cells)} cells but the header has {len(header_cells)}")
+            )
+            continue
+        cells = cells + [""] * (len(header_cells) - len(cells))
+        _import_row(repo, report, first_row_by_email, row, columns, name_columns, cells)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'file is not UTF-8 text; re-save it as "CSV UTF-8" and import it again'
+            ) from None
+    else:
+        text = data.removeprefix(_BOM)
+    if not text.strip():
+        raise ImportFileError("file is empty")
+    return text
+
+
+def _read_rows(text: str) -> list[tuple[int, list[str]]]:
+    """Parse the whole file into (row number, cells) pairs, header first."""
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    rows = []
+    try:
+        while True:
+            row = reader.line_num + 1
+            try:
+                cells = next(reader)
+            except StopIteration:
+                break
+            rows.append((row, cells))
+    except csv.Error as exc:
+        raise ImportFileError(f"line {reader.line_num}: not valid CSV ({exc})") from None
+    return rows
+
+
+def _parse_header(
+    cells: list[str],
+) -> tuple[dict[str, int], tuple[str, ...], list[RowIssue]]:
+    """Map known column names to cell positions and pick the name column(s)."""
+    columns: dict[str, int] = {}
+    ignored: list[int] = []
+    for index, raw in enumerate(cells):
+        column = raw.strip().lower()
+        if column in KNOWN_COLUMNS:
+            if column in columns:
+                raise ImportFileError(f"column {column!r} appears more than once in the header")
+            columns[column] = index
+        elif column:
+            ignored.append(index)
+
+    if "name" in columns:
+        name_columns: tuple[str, ...] = ("name",)
+        ignored.extend(
+            columns.pop(column) for column in ("first_name", "last_name") if column in columns
+        )
+    elif "first_name" in columns and "last_name" in columns:
+        name_columns = ("first_name", "last_name")
+    else:
+        raise ImportFileError(
+            "header has no 'name' column (or 'first_name' and 'last_name' columns)"
+        )
+    if "email" not in columns:
+        raise ImportFileError("header has no 'email' column")
+
+    warnings = [
+        RowIssue(_HEADER_ROW, None, f"column {cells[index].strip()!r} is not imported")
+        for index in sorted(ignored)
+    ]
+    return columns, name_columns, warnings
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    report: ImportReport,
+    first_row_by_email: dict[str, int],
+    row: int,
+    columns: dict[str, int],
+    name_columns: tuple[str, ...],
+    cells: list[str],
+) -> None:
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return "" if index is None else cells[index]
+
+    errors: list[RowIssue] = []
+
+    def check(validate, raw):
+        try:
+            return validate(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(row, exc.field, exc.message))
+            return None
+
+    name = check(validate_name, " ".join(cell(column) for column in name_columns))
+    email = check(normalize_email, cell("email"))
+    tags = check(
+        normalize_tags, [tag for tag in cell("tags").split(TAG_SEPARATOR) if tag.strip()]
+    )
+    if email is not None:
+        if email in first_row_by_email:
+            errors.append(
+                RowIssue(row, "email", f"{email} is already in row {first_row_by_email[email]}")
+            )
+        else:
+            first_row_by_email[email] = row
+    if errors:
+        report.errors.extend(errors)
+        return
+
+    phone = None
+    if cell("phone").strip():
+        try:
+            phone = normalize_phone(cell("phone"))
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(row, "phone", f"{exc.message}; phone not imported")
+            )
+
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+        return
+    merged = replace(
+        existing,
+        name=name,
+        phone=phone if phone is not None else existing.phone,
+        tags=existing.tags | tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(email)

+"""CSV import of contacts.
+
+Reads files with the columns of the CSV export and merges them into a
+repository; see specs/csv-import.md and docs/adr/0001 for the rules.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_CONTACT_ROWS = 1000
+
+_BOM = "\ufeff"
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row; ``row`` is the file line the row starts on (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _Columns:
+    width: int
+    email: int
+    name: int | None
+    first_name: int | None
+    last_name: int | None
+    phone: int | None
+    tags: int | None
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or merge every contact row of a CSV file into ``repo``.
+
+    Rows with errors are skipped, the others applied. Raises ImportFileError,
+    leaving ``repo`` unchanged, when the file as a whole can't be imported.
+    """
+    header, rows = _read_rows(_decode(data))
+    columns = _columns(header)
+    report = ImportReport()
+    first_row_for: dict[str, int] = {}
+    for row_number, cells in rows:
+        contact = _parse_row(row_number, cells, columns, first_row_for, report)
+        if contact is not None:
+            _save(repo, contact, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            data = data.decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and import it again'
+            ) from None
+    return data.removeprefix(_BOM)
+
+
+def _read_rows(text: str) -> tuple[list[str], list[tuple[int, list[str]]]]:
+    """Return the header and the non-blank rows with the line each starts on."""
+    if not text.strip():
+        raise ImportFileError("the file is empty")
+    # strict: an unterminated quote must fail instead of swallowing the rest of the file
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    rows: list[tuple[int, list[str]]] = []
+    try:
+        header = next(reader)
+        while True:
+            start_line = reader.line_num + 1
+            try:
+                cells = next(reader)
+            except StopIteration:
+                break
+            if not any(cell.strip() for cell in cells):
+                continue
+            if len(rows) == MAX_CONTACT_ROWS:
+                raise ImportFileError(
+                    f"the file has more than {MAX_CONTACT_ROWS} contacts; split it up"
+                )
+            rows.append((start_line, cells))
+    except csv.Error as exc:
+        raise ImportFileError(
+            f"the file is not valid CSV (line {reader.line_num}): {exc}"
+        ) from None
+    if not any(title.strip() for title in header):
+        raise ImportFileError("the first line must be the header with the column names")
+    return header, rows
+
+
+def _columns(header: list[str]) -> _Columns:
+    index: dict[str, int] = {}
+    for position, title in enumerate(header):
+        index.setdefault(title.strip().lower(), position)
+
+    missing = []
+    if "email" not in index:
+        missing.append("email")
+    has_name_pair = "first_name" in index and "last_name" in index
+    if "name" not in index and not has_name_pair:
+        missing.append("name (or first_name and last_name)")
+    if missing:
+        raise ImportFileError(f"missing required column: {', '.join(missing)}")
+
+    return _Columns(
+        width=len(header),
+        email=index["email"],
+        name=index.get("name"),
+        first_name=index.get("first_name"),
+        last_name=index.get("last_name"),
+        phone=index.get("phone"),
+        tags=index.get("tags"),
+    )
+
+
+def _parse_row(
+    row_number: int,
+    cells: list[str],
+    columns: _Columns,
+    first_row_for: dict[str, int],
+    report: ImportReport,
+) -> Contact | None:
+    """Validate a row into a Contact with only the phone it should set, or None on error."""
+    def cell(position: int | None) -> str:
+        return cells[position] if position is not None and position < len(cells) else ""
+
+    errors: list[RowIssue] = []
+    if len(cells) > columns.width:
+        errors.append(
+            RowIssue(row_number, None, f"has {len(cells)} cells but the header has {columns.width}")
+        )
+
+    def field_value(column: str, validate, raw):
+        try:
+            return validate(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(row_number, column, exc.message))
+            return None
+
+    email = field_value("email", normalize_email, cell(columns.email))
+    if email is not None:
+        first = first_row_for.setdefault(email, row_number)
+        if first != row_number:
+            errors.append(
+                RowIssue(row_number, None, f"{email} already appears in row {first}")
+            )
+
+    if columns.name is not None:
+        raw_name = cell(columns.name)
+    else:
+        raw_name = f"{cell(columns.first_name)} {cell(columns.last_name)}"
+    name = field_value("name", validate_name, raw_name)
+
+    raw_tags = [part for part in cell(columns.tags).split(TAG_SEPARATOR) if part.strip()]
+    tags = field_value("tags", normalize_tags, raw_tags)
+
+    if errors:
+        report.errors.extend(errors)
+        return None
+
+    phone = None
+    raw_phone = cell(columns.phone)
+    if raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(row_number, "phone", f"{exc.message}; the phone was not imported")
+            )
+    return Contact(name=name, email=email, phone=phone, tags=tags)
+
+
+def _save(repo: InMemoryContactRepository, row: Contact, report: ImportReport) -> None:
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(row)
+        report.created.append(row.email)
+        return
+    repo.update(
+        Contact(
+            name=row.name,
+            email=existing.email,
+            phone=row.phone if row.phone is not None else existing.phone,
+            tags=existing.tags | row.tags,
+        )
+    )
+    report.updated.append(row.email)

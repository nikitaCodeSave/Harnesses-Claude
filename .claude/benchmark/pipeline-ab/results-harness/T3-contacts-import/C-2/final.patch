+def _rows(count, blank_every=0):
+    lines = [HEADER]
+    for i in range(count):
+        if blank_every and i % blank_every == 0:
+            lines.append("\n")
+        lines.append(f"Person {i},p{i}@example.com,,\n")
+    return "".join(lines)
+

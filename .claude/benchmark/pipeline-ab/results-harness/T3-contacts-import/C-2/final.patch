+++ b/tests/test_importer.py
@@ -0,0 +1,417 @@
+import pytest
+
+import contactbook
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def ann(**overrides):
+    fields = {"name": "Ann Lee", "email": "ann@example.com"}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def issues(report_list):
+    return [(issue.row, issue.column) for issue in report_list]
+
+
+# --- interface ---------------------------------------------------------------
+
+
+def test_import_file_error_is_a_contact_error_and_exported():
+    assert issubclass(ImportFileError, ContactError)
+    assert contactbook.ImportFileError is ImportFileError
+
+
+def test_report_and_issue_are_dataclasses_with_the_agreed_fields():
+    issue = RowIssue(row=2, column=None, message="x")
+    report = ImportReport(created=["a@b.co"], updated=[], errors=[issue], warnings=[])
+    assert (issue.row, issue.column, issue.message) == (2, None, "x")
+    assert report.errors == [issue]
+
+
+# --- decoding ----------------------------------------------------------------
+
+
+def test_bytes_are_decoded_as_utf8():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, (HEADER + "Zoë Müller,zoe@example.com,,\n").encode("utf-8"))
+    assert repo.get("zoe@example.com").name == "Zoë Müller"
+
+
+def test_bom_in_bytes_is_ignored():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, (HEADER + "Ann,ann@example.com,,\n").encode("utf-8-sig"))
+    assert report.created == ["ann@example.com"]
+
+
+def test_bom_at_start_of_text_is_ignored():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "\ufeffemail,name\nann@example.com,Ann\n")
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann"
+
+
+def test_invalid_utf8_is_a_file_error_mentioning_csv_utf8():
+    repo = InMemoryContactRepository([ann()])
+    data = (HEADER + "Zoë,zoe@example.com,,\n").encode("cp1252")
+    with pytest.raises(ImportFileError, match="CSV UTF-8"):
+        import_contacts(repo, data)

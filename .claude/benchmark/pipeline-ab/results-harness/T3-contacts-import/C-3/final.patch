@@ -0,0 +1,360 @@
+import pytest
+
+import contactbook
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def ann(**overrides):
+    fields = {"name": "Ann Lee", "email": "ann@example.com"}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def run(text, contacts=()):
+    repo = InMemoryContactRepository(contacts)
+    return repo, import_contacts(repo, text)
+
+
+# --- decoding and file-level checks -------------------------------------------
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)
+    assert contactbook.ImportFileError is ImportFileError
+
+
+def test_utf8_bytes_are_decoded():
+    repo, report = run((HEADER + "Zoë Brontë,zoe@example.com,,\n").encode("utf-8"))
+    assert report.created == ["zoe@example.com"]
+    assert repo.get("zoe@example.com").name == "Zoë Brontë"
+
+
+def test_bom_in_bytes_is_accepted():
+    repo, report = run(b"\xef\xbb\xbf" + (HEADER + "Ann,ann@example.com,,\n").encode())
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == []
+
+
+def test_bom_in_text_is_accepted():
+    repo, report = run(chr(0xFEFF) + HEADER + "Ann,ann@example.com,,\n")
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == []
+
+

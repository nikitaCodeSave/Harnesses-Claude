+"""CSV import of contacts, the counterpart of export.py.
+
+See specs/csv-import.md and docs/adr/0001-csv-import-merge-rules.md for the rules.
+"""
+
+from __future__ import annotations
+
+import codecs
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_CONTACT_ROWS = 1000
+NAME_PARTS = ("first_name", "last_name")
+BOM = codecs.BOM_UTF8.decode("utf-8")  # Excel's "CSV UTF-8" starts with one
+
+
+@dataclass
+class RowIssue:
+    """A problem found while importing; ``row`` is the 1-based line, header = 1."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts from CSV file content and report per row.
+
+    Rows with any invalid value are skipped and listed in ``errors``; the other
+    rows are applied. Raises ImportFileError, before changing anything, when the
+    file as a whole can't be imported.
+    """
+    records = _read_records(_decode(data))
+    if all(_is_blank(cells) for _, cells in records):
+        raise ImportFileError("the file is empty")
+    _, header = records[0]
+    report = ImportReport()
+    columns = _parse_header(header, report)
+
+    rows = [(number, cells) for number, cells in records[1:] if not _is_blank(cells)]
+    if len(rows) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(rows)} contact rows; at most {MAX_CONTACT_ROWS} "
+            "can be imported at once"
+        )
+
+    first_row_by_email: dict[str, int] = {}
+    for number, cells in rows:
+        contact = _parse_row(number, cells, len(header), columns, first_row_by_email, report)
+        if contact is not None:
+            _apply(repo, contact, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise ImportFileError(
+                f"the file is not UTF-8 text (bad byte at position {exc.start}); "
+                'save it again as "CSV UTF-8" and retry'
+            ) from None
+    elif isinstance(data, str):
+        text = data
+    else:
+        raise TypeError(f"expected str or bytes, got {type(data).__name__}")
+    return text.removeprefix(BOM)
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """Parse CSV into (line where the record starts, cells); blank lines give []."""
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    records = []
+    next_line = 1
+    try:
+        for cells in reader:
+            records.append((next_line, cells))
+            next_line = reader.line_num + 1
+    except csv.Error as exc:
+        message = f"line {reader.line_num}: not valid CSV: {exc}"
+        raise ImportFileError(message + _delimiter_hint(text.splitlines()[:1])) from None
+    return records
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _delimiter_hint(header: list[str]) -> str:
+    if any(sep in cell for cell in header for sep in ";\t"):
+        return "; columns must be delimited by commas"
+    return ""
+
+
+def _parse_header(header: list[str], report: ImportReport) -> dict[str, int]:
+    """Map recognised column names to their index; warn about the others."""
+    recognised = set(EXPORT_COLUMNS)
+    keys = [cell.strip().lower() for cell in header]
+    if "name" not in keys:
+        recognised.update(NAME_PARTS)
+
+    columns: dict[str, int] = {}
+    for index, key in enumerate(keys):
+        if key not in recognised:
+            label = repr(header[index].strip()) if key else f"#{index + 1} (no name)"
+            report.warnings.append(RowIssue(1, None, f"ignored column {label}"))
+        elif key in columns:
+            raise ImportFileError(f"column {key!r} appears more than once in the header")
+        else:
+            columns[key] = index
+
+    missing = []
+    if "name" not in columns and not all(part in columns for part in NAME_PARTS):
+        missing.append("name (or first_name and last_name)")
+    if "email" not in columns:
+        missing.append("email")
+    if missing:
+        message = "the header row is missing: " + ", ".join(missing)
+        raise ImportFileError(message + _delimiter_hint(header))
+    return columns
+
+
+def _parse_row(
+    number: int,
+    cells: list[str],
+    width: int,
+    columns: dict[str, int],
+    first_row_by_email: dict[str, int],
+    report: ImportReport,
+) -> Contact | None:
+    """Validate one row; return its contact or None after reporting its errors."""
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    issues: list[RowIssue] = []
+    if not _is_blank(cells[width:]):
+        issues.append(RowIssue(number, None, f"has {len(cells)} cells, the header has {width}"))
+    def check(column, normalise, raw):
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            issues.append(RowIssue(number, column, exc.message))
+            return None
+
+    raw_name = cell("name") if "name" in columns else f"{cell('first_name')} {cell('last_name')}"
+    name = check("name", validate_name, raw_name)
+    email = check("email", normalize_email, cell("email"))
+    if email is not None:
+        first = first_row_by_email.setdefault(email, number)
+        if first != number:
+            issues.append(RowIssue(number, "email", f"{email} already appears in row {first}"))
+    raw_phone = cell("phone")
+    phone = check("phone", normalize_phone, raw_phone) if raw_phone.strip() else None
+    tags = check(
+        "tags",
+        normalize_tags,
+        [tag for tag in cell("tags").split(TAG_SEPARATOR) if tag.strip()],
+    )
+
+    if issues:
+        report.errors.extend(issues)
+        return None
+    return Contact(name=name, email=email, phone=phone, tags=tags)
+
+
+def _apply(repo: InMemoryContactRepository, row: Contact, report: ImportReport) -> None:
+    """Create the contact, or merge it into the stored one (ADR 0001)."""
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(row)
+        report.created.append(row.email)
+        return
+    merged = replace(
+        existing,
+        name=row.name,
+        phone=row.phone or existing.phone,
+        tags=existing.tags | row.tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(row.email)

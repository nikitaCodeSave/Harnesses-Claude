+import pytest
+
+from contactbook import ContactError
+from contactbook.errors import ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def repo_with(*contacts):
+    return InMemoryContactRepository(contacts)
+
+
+def ann(**changes):
+    fields = dict(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"])
+    fields.update(changes)
+    return Contact.create(**fields)
+
+
+# --- file level -------------------------------------------------------------
+
+
+def test_export_output_imports_back_unchanged():
+    contacts = [ann(tags=["vip", "lead"]), Contact.create(name="Bob Stone", email="bob@example.com")]
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, export_csv(contacts))
+
+    assert report == ImportReport(
+        created=["ann@example.com", "bob@example.com"], updated=[], errors=[], warnings=[]
+    )
+    assert repo.all() == contacts
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        (HEADER + "Zoë Ångström,zoe@example.com,,\n").encode("utf-8"),
+        b"\xef\xbb\xbf" + (HEADER + "Zoë Ångström,zoe@example.com,,\n").encode("utf-8"),
+        chr(0xFEFF) + HEADER + "Zoë Ångström,zoe@example.com,,\n",
+        HEADER + "Zoë Ångström,zoe@example.com,,\n",
+    ],
+    ids=["bytes", "bytes-bom", "text-bom", "text"],
+)
+def test_utf8_with_or_without_bom(data):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["zoe@example.com"]
+    assert report.warnings == []
+    assert repo.get("zoe@example.com").name == "Zoë Ångström"
+
+
+def test_non_utf8_bytes_are_rejected_with_resave_hint():
+    repo = InMemoryContactRepository()
+    data = (HEADER + "Zoë Lee,zoe@example.com,,\n").encode("cp1252")
+
+    with pytest.raises(ImportFileError, match="CSV UTF-8"):
+        import_contacts(repo, data)
+    assert len(repo) == 0
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)
+
+
+@pytest.mark.parametrize("data", ["", b"", "\n\n", "  \n,,\n"])
+def test_empty_file_is_rejected(data):
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), data)
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["name,phone,tags", "email,phone", "first_name,email", "last_name,email", "nmae,email"],
+)
+def test_missing_required_columns_are_rejected(header):
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), header + "\nAnn,ann@example.com\n")
+
+
+def test_duplicate_known_column_is_rejected():
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), "name,email,email\nAnn,a@example.com,b@example.com\n")
+
+
+def test_header_only_file_gives_empty_report():
+    assert import_contacts(InMemoryContactRepository(), HEADER) == ImportReport([], [], [], [])
+
+
+def test_header_is_case_insensitive_trimmed_and_in_any_order():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, " Tags , EMAIL,Name \nvip,ann@example.com,Ann Lee\n")
+
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(name="Ann Lee", email="ann@example.com", tags=["vip"])
+
+
+def test_first_and_last_name_columns_are_joined_with_one_space():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, "first_name,last_name,email\n Ann , Lee ,ann@example.com\n")
+
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_name_problem_in_first_last_name_file_reports_column_name():
+    report = import_contacts(InMemoryContactRepository(), "first_name,last_name,email\n,,ann@example.com\n")
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name")]
+
+
+def test_name_column_wins_over_first_and_last_name():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, "name,first_name,last_name,email\nAnn Lee,X,Y,ann@example.com\n")
+
+    assert repo.get("ann@example.com").name == "Ann Lee"
+    assert report.created == ["ann@example.com"]
+
+
+def test_repeated_unused_name_part_columns_are_only_warnings():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, "name,email,first_name,first_name\nAnn Lee,ann@example.com,X,Y\n")
+
+    assert report.created == ["ann@example.com"]
+    assert [(w.row, w.column) for w in report.warnings] == [(1, None), (1, None)]
+
+
+def test_blank_header_cells_are_ignored_silently():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, "name,,email, \nAnn Lee,,ann@example.com,\n")
+
+    assert report == ImportReport(["ann@example.com"], [], [], [])
+
+
+def test_values_under_blank_header_cells_give_a_warning():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, "name,,email\nAnn Lee,+15551234567,ann@example.com\n")
+
+    assert report.created == ["ann@example.com"]
+    assert [(w.row, w.column) for w in report.warnings] == [(2, None)]
+    assert repo.get("ann@example.com").phone is None
+
+
+def test_blank_first_row_is_a_file_error_saying_row_1_must_be_the_header():
+    with pytest.raises(ImportFileError, match="row 1"):
+        import_contacts(InMemoryContactRepository(), "\nname,email\nAnn Lee,ann@example.com\n")
+
+
+def test_warnings_are_reported_on_rows_with_errors_too():
+    report = import_contacts(InMemoryContactRepository(), "name,email,phone\n,bad,abc,extra\n")
+
+    assert sorted(e.column for e in report.errors) == ["email", "name"]
+    assert sorted((w.row, str(w.column)) for w in report.warnings) == [(2, "None"), (2, "phone")]
+
+
+def test_unknown_column_gives_warning_on_row_1_and_import_proceeds():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, "name,email,company\nAnn Lee,ann@example.com,ACME\n")
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert len(report.warnings) == 1
+    assert report.warnings[0].row == 1
+    assert report.warnings[0].column is None
+    assert "company" in report.warnings[0].message
+
+
+def rows(count):
+    return "".join(f"Person {i},p{i}@example.com,,\n" for i in range(count))
+
+
+def test_1000_contact_rows_plus_blank_rows_are_accepted():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "\n,,,\n" + rows(1000) + "\n   \n")
+
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_more_than_1000_contact_rows_rejects_whole_file():
+    repo = repo_with(ann())
+
+    with pytest.raises(ImportFileError, match="1000"):
+        import_contacts(repo, HEADER + rows(1001))
+    assert repo.all() == [ann()]
+
+
+def test_malformed_csv_is_a_file_error():
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, HEADER + 'Ann Lee,ann@example.com,,"vip\n')
+    assert len(repo) == 0
+
+
+def test_malformed_csv_error_names_the_line():
+    data = HEADER + "Ann Lee,ann@example.com,,\n" + '"Bob" Jr,bob@example.com,,\n'
+
+    with pytest.raises(ImportFileError, match="line 3"):
+        import_contacts(InMemoryContactRepository(), data)
+
+
+def test_quote_inside_unquoted_cell_is_kept_literally():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + 'Ann "Boss" Lee,ann@example.com,,\n')
+
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == 'Ann "Boss" Lee'
+
+
+def test_non_text_input_is_a_type_error():
+    with pytest.raises(TypeError):
+        import_contacts(InMemoryContactRepository(), 42)
+
+
+# --- rows -------------------------------------------------------------------
+
+
+def test_row_numbers_match_excel_counting_blank_and_multiline_rows():
+    data = (
+        HEADER
+        + "Ann Lee,ann@example.com,,\n"  # row 2
+        + "\n"  # row 3
+        + '"Bob\nStone",bob@example.com,,\n'  # row 4 (spans two lines)
+        + "Carl,not-an-email,,\n"  # row 5
+    )
+
+    report = import_contacts(InMemoryContactRepository(), data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == [RowIssue(5, "email", report.errors[0].message)]
+
+
+def test_crlf_line_endings():
+    data = "name,email,phone,tags\r\nAnn Lee,ann@example.com,,\r\n\r\nBob,bad,,\r\n"
+
+    report = import_contacts(InMemoryContactRepository(), data)
+
+    assert report.created == ["ann@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [(4, "email")]
+
+
+@pytest.mark.parametrize("blank", ["", ",,,", "  ,  , ,", "   "])
+def test_blank_rows_are_skipped_silently(blank):
+    report = import_contacts(InMemoryContactRepository(), HEADER + blank + "\nAnn Lee,ann@example.com,,\n")
+
+    assert report == ImportReport(["ann@example.com"], [], [], [])
+
+
+@pytest.mark.parametrize("email", ["", "   ", "not-an-email"])
+def test_missing_or_invalid_email_is_a_row_error(email):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + f"Ann Lee,{email},,\n")
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "email")]
+    assert report.created == []
+    assert len(repo) == 0
+
+
+def test_created_and_updated_list_normalised_emails():
+    repo = repo_with(Contact.create(name="Bob", email="bob@example.com"))
+
+    report = import_contacts(repo, HEADER + "Ann Lee, Ann@Example.COM ,,\nBobby,BOB@example.com,,\n")
+
+    assert report.created == ["ann@example.com"]
+    assert report.updated == ["bob@example.com"]
+    assert repo.get("ann@example.com").email == "ann@example.com"
+
+
+def test_missing_name_is_an_error_also_on_update():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, HEADER + ",ann@example.com,,new\n,bob@example.com,,\n")
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name"), (3, "name")]
+    assert repo.all() == [ann()]
+
+
+def test_invalid_tag_rejects_the_whole_row_and_leaves_existing_contact_untouched():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, HEADER + "Ann Renamed,ann@example.com,+4930123456,good;bad!tag\n")
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "tags")]
+    assert report.updated == []
+    assert repo.all() == [ann()]
+
+
+def test_all_errors_of_a_row_are_reported():
+    report = import_contacts(InMemoryContactRepository(), HEADER + ",bad,,bad!tag\n")
+
+    assert sorted(e.column for e in report.errors) == ["email", "name", "tags"]
+    assert {e.row for e in report.errors} == {2}
+
+
+def test_tags_are_split_normalised_and_deduplicated():
+    repo = InMemoryContactRepository()
+
+    import_contacts(repo, HEADER + "Ann Lee,ann@example.com,,; Key Account ;;VIP;vip;\n")
+
+    assert repo.get("ann@example.com").tags == {"key-account", "vip"}
+
+
+def test_invalid_phone_on_new_contact_is_a_warning_and_contact_is_created_without_phone():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,call me,vip\n")
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert [(w.row, w.column) for w in report.warnings] == [(2, "phone")]
+    assert repo.get("ann@example.com") == Contact.create(name="Ann Lee", email="ann@example.com", tags=["vip"])
+
+
+def test_invalid_phone_on_update_keeps_existing_phone_and_applies_the_rest():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, HEADER + "Ann Renamed,ann@example.com,12,lead\n")
+
+    assert report.updated == ["ann@example.com"]
+    assert [(w.row, w.column) for w in report.warnings] == [(2, "phone")]
+    assert repo.get("ann@example.com") == ann(name="Ann Renamed", tags=["vip", "lead"])
+
+
+def test_update_replaces_name_and_phone_and_merges_tags():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, HEADER + "Ann Smith,ann@example.com,+49 30 123456,lead\n")
+
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == ann(name="Ann Smith", phone="+4930123456", tags=["vip", "lead"])
+
+
+def test_blank_phone_and_tags_cells_never_clear_existing_values():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, HEADER + "Ann Smith,ann@example.com,  ,\n")
+
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == ann(name="Ann Smith")
+
+
+def test_missing_phone_and_tags_columns_never_clear_existing_values():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, "name,email\nAnn Smith,ann@example.com\n")
+
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == ann(name="Ann Smith")
+
+
+def test_unchanged_existing_contact_is_not_listed_as_updated():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, HEADER + "  Ann  Lee ,ANN@example.com,,VIP\n")
+
+    assert report == ImportReport([], [], [], [])
+
+
+def test_duplicate_email_in_file_first_row_wins():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(
+        repo, HEADER + "Ann Lee,ann@example.com,,\nAnn Other,ANN@example.com,,\n"
+    )
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [RowIssue(3, "email", "duplicate of row 2")]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_duplicate_of_an_updated_contact_is_also_an_error():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, HEADER + "Ann A,ann@example.com,,\nAnn B,ann@example.com,,\n")
+
+    assert report.updated == ["ann@example.com"]
+    assert report.errors == [RowIssue(3, "email", "duplicate of row 2")]
+    assert repo.get("ann@example.com").name == "Ann A"
+
+
+def test_rejected_row_does_not_claim_its_email():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + ",ann@example.com,,\nAnn Lee,ann@example.com,,\n")
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name")]
+    assert report.created == ["ann@example.com"]
+
+
+def test_extra_cells_give_a_warning_and_short_rows_count_as_blank():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,,vip,surplus\nBob,bob@example.com\n")
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert [(w.row, w.column) for w in report.warnings] == [(2, None)]
+    assert repo.get("bob@example.com") == Contact.create(name="Bob", email="bob@example.com")
+
+
+def test_import_is_partial():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,,\nBad,bad,,\nBob,bob@example.com,,\n")
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert len(report.errors) == 1
+    assert len(repo) == 2
+
+
+def test_public_names_are_exported_from_package():
+    import contactbook
+
+    assert contactbook.import_contacts is import_contacts
+    assert contactbook.ImportReport is ImportReport
+    assert contactbook.RowIssue is RowIssue
+    assert contactbook.ImportFileError is ImportFileError

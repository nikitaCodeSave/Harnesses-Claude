+"""CSV import of contacts.
+
+Reads files with the export's columns (or ``first_name`` + ``last_name`` instead
+of ``name``), creates new contacts and updates existing ones. An import only adds
+information: it never clears a phone or removes a tag. Rows with errors are
+skipped and reported; the rest are applied. Rules: specs/csv-import.md and
+docs/adr/0001-csv-import-semantics.md.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_IMPORT_ROWS = 1000
+NAME_PART_COLUMNS = ("first_name", "last_name")
+
+_COLUMNS_WITH_NAME = frozenset(EXPORT_COLUMNS)
+_COLUMNS_WITH_NAME_PARTS = (_COLUMNS_WITH_NAME - {"name"}) | frozenset(NAME_PART_COLUMNS)
+_BOM = "\N{ZERO WIDTH NO-BREAK SPACE}"
+_HEADER_ROW = 1
+
+
+@dataclass(frozen=True, slots=True)
+class RowIssue:
+    """A problem in an import file.
+
+    ``row`` is the row number as a spreadsheet shows it (header = 1, blank lines
+    count); ``column`` is ``name``, ``email``, ``phone``, ``tags`` or None.
+    """
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    """What an import did. Errors mark rows that were skipped; warnings mark
+    rows (or the header) that were applied with something left out."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import CSV ``data`` into ``repo`` and report what happened per row.
+
+    ``data`` is the file content: bytes as read from disk (UTF-8, BOM allowed)
+    or decoded text. Raises ImportFileError, leaving ``repo`` untouched, when
+    the file as a whole can't be imported.
+    """
+    records = _read_records(_decode(data))
+    if all(_is_blank(record) for record in records):
+        raise ImportFileError("the file is empty")
+
+    header, *body = records
+    if _is_blank(header):
+        raise ImportFileError("row 1 is empty; the first row must be the header with column names")
+    report = ImportReport()
+    columns = _parse_header(header, report)
+    named = frozenset(index for index, raw in enumerate(header) if raw.strip())
+    rows = [
+        (number, cells)
+        for number, cells in enumerate(body, start=_HEADER_ROW + 1)
+        if not _is_blank(cells)
+    ]
+    if len(rows) > MAX_IMPORT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(rows)} contact rows; at most {MAX_IMPORT_ROWS} "
+            "can be imported at once, so split it into smaller files"
+        )
+
+    applied: dict[str, int] = {}  # normalised email -> row that set it
+    for number, cells in rows:
+        _import_row(
+            repo, report, applied, columns=columns, named=named, row=number, cells=cells
+        )
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and import it again'
+            ) from None
+    if isinstance(data, str):
+        return data.removeprefix(_BOM)
+    raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+
+
+def _read_records(text: str) -> list[list[str]]:
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    try:
+        return list(reader)
+    except csv.Error as exc:
+        raise ImportFileError(
+            f"the file is not valid CSV near line {reader.line_num} ({exc}); "
+            "check the quotes on that line"
+        ) from None
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return not any(cell.strip() for cell in cells)
+
+
+def _parse_header(header: list[str], report: ImportReport) -> dict[str, int]:
+    """Map the columns the import uses to their index; warn about the rest.
+
+    With a ``name`` column, ``first_name`` / ``last_name`` are unused and count
+    as unknown.
+    """
+    positions: dict[str, list[int]] = {}
+    for index, raw in enumerate(header):
+        if raw.strip():
+            positions.setdefault(raw.strip().lower(), []).append(index)
+
+    if "email" not in positions:
+        raise ImportFileError("the header has no 'email' column")
+    if "name" in positions:
+        used = _COLUMNS_WITH_NAME
+    elif all(part in positions for part in NAME_PART_COLUMNS):
+        used = _COLUMNS_WITH_NAME_PARTS
+    else:
+        raise ImportFileError(
+            "the header needs a 'name' column, or both 'first_name' and 'last_name'"
+        )
+
+    columns: dict[str, int] = {}
+    unknown: list[int] = []
+    for name, indexes in positions.items():
+        if name not in used:
+            unknown.extend(indexes)
+        elif len(indexes) > 1:
+            raise ImportFileError(f"the column {name!r} appears more than once in the header")
+        else:
+            columns[name] = indexes[0]
+
+    for index in sorted(unknown):
+        report.warnings.append(
+            RowIssue(_HEADER_ROW, None, f"unknown column {header[index].strip()!r} ignored")
+        )
+    return columns
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    report: ImportReport,
+    applied: dict[str, int],
+    *,
+    columns: dict[str, int],
+    named: frozenset[int],
+    row: int,
+    cells: list[str],
+) -> None:
+    """Apply one contact row, or report why it was skipped.
+
+    ``columns`` maps used column names to cell indexes; ``named`` holds the
+    indexes of all header cells that have a name.
+    """
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    errors: list[RowIssue] = []
+    email = name = tags = phone = None
+    try:
+        email = normalize_email(cell("email"))
+    except ValidationError as exc:
+        errors.append(_issue(row, exc))
+    if email in applied:
+        errors.append(RowIssue(row, "email", f"duplicate of row {applied[email]}"))
+    try:
+        if "name" in columns:
+            name = validate_name(cell("name"))
+        else:
+            name = validate_name(f"{cell('first_name')} {cell('last_name')}")
+    except ValidationError as exc:
+        errors.append(_issue(row, exc))
+    try:
+        tags = normalize_tags(
+            piece for piece in cell("tags").split(TAG_SEPARATOR) if piece.strip()
+        )
+    except ValidationError as exc:
+        errors.append(_issue(row, exc))
+    raw_phone = cell("phone")
+    if raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(row, "phone", f"{exc.message}; phone left unchanged")
+            )
+    if any(value.strip() for index, value in enumerate(cells) if index not in named):
+        report.warnings.append(
+            RowIssue(row, None, "values in columns without a header were ignored")
+        )
+
+    if errors:
+        report.errors.extend(errors)
+        return
+    assert email is not None and name is not None and tags is not None
+
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+    else:
+        merged = replace(
+            existing,
+            name=name,
+            phone=phone if phone is not None else existing.phone,
+            tags=existing.tags | tags,
+        )
+        if merged != existing:
+            repo.update(merged)
+            report.updated.append(email)
+    applied[email] = row
+
+
+def _issue(row: int, exc: ValidationError) -> RowIssue:
+    return RowIssue(row, exc.field, exc.message)

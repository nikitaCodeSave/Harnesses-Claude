+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """Stock held for a cart before payment (see docs/adr/0001, 0003).
+
+    ``items`` holds the units actually held per SKU, which may be fewer than
+    requested. An ACTIVE reservation lapses at ``expires_at``.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+
+    def is_live(self, now: datetime) -> bool:
+        return self.status is ReservationStatus.ACTIVE and now < self.expires_at
+
+
+@dataclass(frozen=True)
+class ReservationRequest:
+    """What a ``reserve`` call asked for, remembered under its idempotency key."""
+
+    warehouse: str
+    items: dict[str, int]
+    reservation_id: str
+
+

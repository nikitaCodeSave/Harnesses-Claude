+    def reserve(self, warehouse: str, items: Mapping[str, int], idempotency_key: str) -> Reservation:
+        """Hold stock for a cart. Partial: each line holds what is available, up to
+        what was asked; lines that get nothing are left out (docs/adr/0003).
+
+        Replaying ``idempotency_key`` with the same request returns the original
+        reservation; with a different one it raises ``IdempotencyConflict``
+        (docs/adr/0002). A failed call leaves no trace.
+        """
+        if not isinstance(idempotency_key, str) or not idempotency_key.strip():
+            raise InvalidOrder("a reservation needs a non-empty idempotency key")
+        wanted = self._validate_items(warehouse, items)
+
+        previous = self._repo.find_request(idempotency_key)
+        if previous is not None:
+            if (previous.warehouse, previous.items) != (warehouse, wanted):
+                raise IdempotencyConflict(idempotency_key)
+            return self.get_reservation(previous.reservation_id)
+
+        free = {sku: self.available(sku, warehouse) for sku in wanted}
+        holding = {sku: min(qty, free[sku]) for sku, qty in wanted.items() if free[sku] > 0}
+        if not holding:

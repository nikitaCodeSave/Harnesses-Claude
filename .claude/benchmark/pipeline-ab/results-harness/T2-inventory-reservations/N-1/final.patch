+++ b/tests/test_reservations.py
@@ -0,0 +1,239 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 4)
+    return service
+
+
+# -- reserve -------------------------------------------------------------
+def test_reserve_creates_active_hold_expiring_after_20_minutes(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert res.reservation_id == "RES-0001"
+    assert (res.warehouse, res.items, res.status) == ("WH1", {"MUG": 3}, ReservationStatus.ACTIVE)
+    assert (res.expires_at, res.order_id) == (clock.now() + TTL, None)
+
+
+def test_hold_reduces_available_but_not_on_hand_or_ledger(stocked, ledger):
+    entries = len(ledger)
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k1")
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (10, 7)
+    assert stocked.held("MUG", "WH1") == 3
+    assert stocked.available("TEE", "WH1") == 4
+    assert len(ledger) == entries
+
+
+def test_partial_hold_caps_lines_and_omits_empty_ones(stocked):
+    stocked.place_order("WH1", {"TEE": 5})
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 2}, "k1")
+    assert res.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_nothing_holdable_raises_and_creates_nothing(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    # neither the id nor the key was consumed
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.reservation_id == "RES-0001"
+
+
+@pytest.mark.parametrize(
+    ("warehouse", "items", "error"),
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_invalid_request_holds_nothing(stocked, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.available("MUG", "WH1") == 10
+    # no key or id was consumed by the rejected call
+    assert stocked.reserve("WH1", {"CAP": 1, "MUG": 1}, "k1").reservation_id == "RES-0001"
+
+
+def test_empty_idempotency_key_is_rejected(stocked):
+    with pytest.raises(InvalidOrder):
+        stocked.reserve("WH1", {"MUG": 1}, "")
+
+
+def test_place_order_cannot_take_held_stock(stocked):
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2})
+
+
+def test_holds_are_per_warehouse(stocked):
+    stocked.reserve("WH2", {"MUG": 4}, "k1")
+    assert (stocked.available("MUG", "WH1"), stocked.available("MUG", "WH2")) == (10, 0)
+
+
+# -- expiry --------------------------------------------------------------
+def test_hold_expires_at_expires_at_without_a_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    clock.advance(microseconds=1)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_ttl_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    res = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + timedelta(minutes=5)
+
+
+# -- idempotency ---------------------------------------------------------
+def test_same_key_same_request_returns_same_reservation(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k1")
+    clock.advance(minutes=5)
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 3}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.expires_at == first.expires_at
+    assert stocked.held("MUG", "WH1") == 3
+
+
+def test_replay_compares_requested_not_held_items(stocked):
+    first = stocked.reserve("WH1", {"MUG": 50}, "k1")
+    assert first.items == {"MUG": 10}
+    assert stocked.reserve("WH1", {"MUG": 50}, "k1").reservation_id == first.reservation_id
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_replay_returns_finished_reservation_without_new_hold(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert (again.reservation_id, again.status) == (res.reservation_id, ReservationStatus.EXPIRED)
+    assert stocked.available("MUG", "WH1") == 10
+
+    released = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    stocked.release_reservation(released.reservation_id)
+    assert stocked.reserve("WH1", {"MUG": 1}, "k2").status is ReservationStatus.RELEASED
+
+
+@pytest.mark.parametrize(
+    ("warehouse", "items"),
+    [("WH1", {"MUG": 2}), ("WH1", {"MUG": 3, "TEE": 1}), ("WH2", {"MUG": 3})],
+)
+def test_same_key_different_request_conflicts(stocked, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+
+
+def test_conflict_even_after_reservation_is_finished(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4}, "k1")
+
+
+# -- confirm -------------------------------------------------------------
+def test_confirm_places_order_for_held_units(stocked, ledger, repo):
+    stocked.place_order("WH1", {"TEE": 3})
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 4}, "k1")
+    before = (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1"))
+    entries = len(ledger)
+
+    order = stocked.confirm_reservation(res.reservation_id)
+
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 2, "TEE": 2}
+    assert (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1")) == before
+    assert stocked.held("MUG", "WH1") == 0
+    assert len(ledger) == entries
+    res = stocked.get_reservation(res.reservation_id)
+    assert (res.status, res.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert repo.get_order(order.order_id) is order
+
+
+def test_confirm_is_retry_safe_even_after_expiry(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    assert stocked.confirm_reservation(res.reservation_id).order_id == order.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.CONFIRMED
+
+
+def test_confirm_expired_hold_raises(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_confirm_released_hold_raises(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+
+
+# -- release -------------------------------------------------------------
+def test_release_frees_units_and_is_retry_safe(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.release_reservation(res.reservation_id).status is ReservationStatus.RELEASED
+
+
+def test_release_expired_hold_is_a_noop(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL)
+    assert stocked.release_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_release_confirmed_hold_raises(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+
+
+@pytest.mark.parametrize("action", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_is_reported(stocked, action):
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, action)("RES-9999")
+
+
+# -- interaction with physical movements --------------------------------
+def test_write_off_below_held_floors_available_and_keeps_hold(stocked):
+    res = stocked.reserve("WH1", {"TEE": 4}, "k1")
+    stocked.adjust("TEE", "WH1", -3, "damaged")
+    assert stocked.available("TEE", "WH1") == 0
+    res = stocked.get_reservation(res.reservation_id)
+    assert (res.status, res.items) == (ReservationStatus.ACTIVE, {"TEE": 4})

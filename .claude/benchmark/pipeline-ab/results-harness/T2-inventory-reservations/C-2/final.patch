+        """Hold stock for a cart. Each line holds what is available, up to the request.
+
+        Lines with nothing available are left out; if no line gets anything,
+        raises ``InsufficientStock`` and holds nothing. Retrying with the same
+        key and request returns the original reservation in its current state.
+        """
+        wanted = self._validate_items(warehouse, items)
+        known = self._repo.reservation_for_key(idempotency_key)
+        if known is not None:
+            known_warehouse, known_items, reservation_id = known
+            if known_warehouse != warehouse or known_items != wanted:
+                raise IdempotencyConflict(idempotency_key)
+            return self.get_reservation(reservation_id)
+
+        holding: dict[str, int] = {}
+        for sku, quantity in wanted.items():
+            take = min(quantity, self.available(sku, warehouse))
+            if take > 0:
+                holding[sku] = take
+        if not holding:
+            sku, quantity = next(iter(wanted.items()))
+            raise InsufficientStock(sku, warehouse, quantity, 0)
+
+        reservation = Reservation(
+            reservation_id=self._repo.next_reservation_id(),
+            warehouse=warehouse,
+            items=holding,
+            status=ReservationStatus.ACTIVE,
+            expires_at=self._clock.now() + self._reservation_ttl,
+        )
+        self._repo.save_reservation(reservation)
+        self._repo.remember_reservation_key(
+            idempotency_key, warehouse, wanted, reservation.reservation_id
+        )
+        return reservation
+
+    def get_reservation(self, reservation_id: str) -> Reservation:
+        return self._refresh(self._repo.get_reservation(reservation_id))
+
+    def confirm_reservation(self, reservation_id: str) -> Order:
+        """Turn an active hold into a PLACED order; the hold becomes its allocation.
+
+        Repeating the call on a confirmed reservation returns the same order.
+        """
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            return self._repo.get_order(reservation.order_id)
+        if reservation.status is ReservationStatus.EXPIRED:
+            raise ReservationExpired(reservation_id)
+        if reservation.status is not ReservationStatus.ACTIVE:
+            raise InvalidReservationState(reservation_id, reservation.status, "confirm")
+        order = self._new_order(reservation.warehouse, reservation.items)
+        reservation.status = ReservationStatus.CONFIRMED
+        reservation.order_id = order.order_id
+        self._repo.save_reservation(reservation)
+        return order
+
+    def release_reservation(self, reservation_id: str) -> Reservation:
+        """Give held stock back. A no-op on released or expired reservations."""
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            raise InvalidReservationState(reservation_id, reservation.status, "release")
+        if reservation.status is ReservationStatus.ACTIVE:
+            reservation.status = ReservationStatus.RELEASED
+            self._repo.save_reservation(reservation)
+        return reservation
+
     # -- helpers ---------------------------------------------------------
+    def _new_order(self, warehouse: str, items: Mapping[str, int]) -> Order:
+        order = Order(
+            order_id=self._repo.next_order_id(),
+            warehouse=warehouse,
+            lines=tuple(OrderLine(sku, qty) for sku, qty in items.items()),
+            status=OrderStatus.PLACED,
+            placed_at=self._clock.now(),
+        )
+        self._repo.save_order(order)
+        return order
+
+    def _refresh(self, reservation: Reservation) -> Reservation:
+        """Mark an active reservation EXPIRED once the clock reaches ``expires_at``."""
+        if (
+            reservation.status is ReservationStatus.ACTIVE
+            and self._clock.now() >= reservation.expires_at
+        ):
+            reservation.status = ReservationStatus.EXPIRED
+            self._repo.save_reservation(reservation)
+        return reservation
+
+    def _active_reservations(self, warehouse: str) -> list[Reservation]:
+        return [
+            r
+            for r in self._repo.reservations(warehouse=warehouse, status=ReservationStatus.ACTIVE)
+            if self._refresh(r).status is ReservationStatus.ACTIVE
+        ]
+
     def _check_location(self, sku: str, warehouse: str) -> None:
         self._repo.get_warehouse(warehouse)
         self._repo.get_product(sku)

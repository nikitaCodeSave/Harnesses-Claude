@@ -0,0 +1,310 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import (
+    InMemoryRepository,
+    InventoryService,
+    Ledger,
+    OrderStatus,
+    Product,
+    ReservationStatus,
+    Warehouse,
+)
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+def test_new_errors_are_inventory_errors():
+    for cls in (ReservationNotFound, ReservationExpired, InvalidReservationState, IdempotencyConflict):
+        assert issubclass(cls, InventoryError)
+
+
+# -- reserving -------------------------------------------------------------
+def test_reserve_creates_active_hold_expiring_after_default_ttl(stocked, clock):  # R1
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.items == {"MUG": 3}
+    assert res.warehouse == "WH1"
+    assert res.expires_at == clock.now() + TTL
+    assert res.order_id is None
+
+
+def test_ttl_is_configurable(repo, ledger, clock):  # R1
+    service = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    res = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_hold_reduces_available_but_not_on_hand_or_allocated(stocked):  # R5
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert (
+        stocked.on_hand("MUG", "WH1"),
+        stocked.allocated("MUG", "WH1"),
+        stocked.held("MUG", "WH1"),
+        stocked.available("MUG", "WH1"),
+    ) == (10, 0, 4, 6)
+
+
+def test_holds_add_up_with_orders(stocked):  # R5
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert (stocked.held("MUG", "WH1"), stocked.available("MUG", "WH1")) == (4, 4)
+
+
+def test_partial_fill_holds_what_is_available(stocked):  # R2
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 8}, "k1")
+    assert res.items == {"MUG": 3, "TEE": 5}
+    assert stocked.available("TEE", "WH1") == 0
+
+
+def test_line_with_nothing_available_is_left_out(stocked):  # R2
+    res = stocked.reserve("WH1", {"MUG": 2, "CAP": 4}, "k1")
+    assert res.items == {"MUG": 2}
+    assert "CAP" not in res.items
+
+
+def test_partial_fill_competes_with_other_holds(stocked):  # R2
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    res = stocked.reserve("WH1", {"TEE": 3}, "k2")
+    assert res.items == {"TEE": 1}
+
+
+def test_nothing_available_anywhere_raises_and_creates_nothing(stocked):  # R3
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    # the key was not taken: a different request under it now works
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.reservation_id == "RES-0001"
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": 1.5}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_rejected_request_holds_nothing_and_keeps_key_free(stocked, warehouse, items, error):  # R4
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.held("MUG", "WH1") == 0
+    stocked.reserve("WH1", {"TEE": 1}, "k1")  # key still free
+
+
+def test_place_order_competes_with_holds(stocked):  # R6
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2})
+    stocked.place_order("WH1", {"TEE": 1})
+
+
+def test_reservation_ids_are_sequential(stocked):  # R7
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert (first.reservation_id, second.reservation_id) == ("RES-0001", "RES-0002")
+
+
+# -- expiry ------------------------------------------------------------------
+def test_hold_lapses_at_expires_at_without_a_sweep(stocked, clock):  # E1
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    clock.advance(microseconds=1)
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_lapsed_hold_frees_stock_with_no_other_call(stocked, clock):  # E1
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.held("MUG", "WH1") == 0
+
+
+def test_retry_with_invalid_quantity_is_rejected_not_matched(stocked):  # R4
+    stocked.reserve("WH1", {"MUG": 2}, "k1")
+    with pytest.raises(InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": 2.0}, "k1")
+
+
+def test_expired_hold_frees_stock_for_orders(stocked, clock):  # E1
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    clock.advance(TTL)
+    order = stocked.place_order("WH1", {"TEE": 5})
+    assert order.status is OrderStatus.PLACED
+
+
+def test_confirm_lapsed_hold_raises_and_creates_no_order(stocked, clock, repo):  # E2
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_release_lapsed_hold_is_noop(stocked, clock):  # E3
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.advance(TTL)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- confirming --------------------------------------------------------------
+def test_confirm_creates_placed_order_for_held_items(stocked, clock):  # C1
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 9}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 3, "TEE": 5}
+    assert order.placed_at == clock.now()
+    after = stocked.get_reservation(res.reservation_id)
+    assert (after.status, after.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+
+
+def test_confirm_moves_hold_into_allocation(stocked):  # C2
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    before = stocked.available("MUG", "WH1")
+    stocked.confirm_reservation(res.reservation_id)
+    assert (
+        stocked.on_hand("MUG", "WH1"),
+        stocked.allocated("MUG", "WH1"),
+        stocked.held("MUG", "WH1"),
+        stocked.available("MUG", "WH1"),
+    ) == (10, 4, 0, before)
+
+
+def test_confirmed_order_ships_normally(stocked):  # C2
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    stocked.ship_order(order.order_id)
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (6, 6)
+
+
+def test_repeat_confirm_returns_same_order_even_after_ttl(stocked, clock, repo):  # C3
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    again = stocked.confirm_reservation(res.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.CONFIRMED
+    assert stocked.allocated("MUG", "WH1") == 2
+
+
+def test_confirm_released_raises(stocked):  # C4
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+
+
+def test_unknown_reservation_is_reported(stocked):  # C5
+    for call in (stocked.get_reservation, stocked.confirm_reservation, stocked.release_reservation):
+        with pytest.raises(ReservationNotFound):
+            call("RES-9999")
+
+
+# -- releasing ---------------------------------------------------------------
+def test_release_frees_stock(stocked):  # L1
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_repeat_release_returns_it_unchanged(stocked):  # L2
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    again = stocked.release_reservation(res.reservation_id)
+    assert again.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_release_confirmed_raises_and_keeps_order(stocked, repo):  # L3
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+    assert stocked.allocated("MUG", "WH1") == 4
+
+
+# -- idempotency -------------------------------------------------------------
+def test_retry_returns_original_and_creates_nothing(stocked, clock):  # I1
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    original_expiry = clock.now() + TTL
+    clock.advance(minutes=10)
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "k1")
+    assert again.reservation_id == res.reservation_id
+    assert again.expires_at == original_expiry
+    assert stocked.held("MUG", "WH1") == 2
+
+
+def test_retry_compares_requested_not_held_items(stocked):  # I1
+    res = stocked.reserve("WH1", {"TEE": 8}, "k1")
+    assert res.items == {"TEE": 5}
+    again = stocked.reserve("WH1", {"TEE": 8}, "k1")
+    assert again.reservation_id == res.reservation_id
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"TEE": 5}, "k1")
+
+
+@pytest.mark.parametrize("finish", ["confirm", "release", "expire"])
+def test_retry_after_finish_returns_it_in_current_state(stocked, clock, finish):  # I1, I2
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    expected = {
+        "confirm": ReservationStatus.CONFIRMED,
+        "release": ReservationStatus.RELEASED,
+        "expire": ReservationStatus.EXPIRED,
+    }[finish]
+    if finish == "confirm":
+        stocked.confirm_reservation(res.reservation_id)
+    elif finish == "release":
+        stocked.release_reservation(res.reservation_id)
+    else:
+        clock.advance(TTL)
+    again = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert (again.reservation_id, again.status) == (res.reservation_id, expected)
+    assert stocked.held("MUG", "WH1") == 0
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 3}, "k1")
+
+
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [("WH2", {"MUG": 2}), ("WH1", {"MUG": 3}), ("WH1", {"MUG": 2, "TEE": 1})],
+)
+def test_key_reuse_with_different_request_conflicts(stocked, warehouse, items):  # I2, I3
+    stocked.reserve("WH1", {"MUG": 2}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.held("MUG", "WH1") == 2

+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A time-limited hold on stock for a cart, before payment.
+
+    An ACTIVE hold reduces availability but never moves physical stock. It
+    lapses to EXPIRED at ``expires_at`` unless confirmed into an order first.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+
+    def is_lapsed(self, now: datetime) -> bool:
+        return self.status is ReservationStatus.ACTIVE and now >= self.expires_at
+
+

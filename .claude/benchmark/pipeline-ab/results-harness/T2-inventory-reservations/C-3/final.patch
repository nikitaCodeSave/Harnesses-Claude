+
+class ReservationNotFound(InventoryError):
+    def __init__(self, reservation_id: str) -> None:
+        super().__init__(f"reservation {reservation_id!r} not found")
+        self.reservation_id = reservation_id
+
+
+class ReservationExpired(InventoryError):
+    def __init__(self, reservation_id: str, expires_at: object) -> None:
+        super().__init__(f"reservation {reservation_id!r} expired at {expires_at}")
+        self.reservation_id = reservation_id
+        self.expires_at = expires_at
+
+
+class InvalidReservationState(InventoryError):
+    def __init__(self, reservation_id: str, status: object, action: str) -> None:
+        super().__init__(f"cannot {action} reservation {reservation_id!r} in status {status}")
+        self.reservation_id = reservation_id
+        self.status = status
+        self.action = action
+
+
+class IdempotencyConflict(InventoryError):
+    """An idempotency key was reused for a different reserve request."""
+
+    def __init__(self, key: str) -> None:
+        super().__init__(f"idempotency key {key!r} was already used for a different request")
+        self.key = key

+++ b/tests/test_reservations.py
@@ -0,0 +1,300 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import (
+    FixedClock,
+    InMemoryRepository,
+    InventoryService,
+    Ledger,
+    OrderStatus,
+    ReservationStatus,
+)
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 7)
+    return service
+
+
+# -- reserving -----------------------------------------------------------
+def test_reserve_creates_active_hold_expiring_after_20_minutes(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.items == {"MUG": 3, "TEE": 2}
+    assert res.warehouse == "WH1"
+    assert res.order_id is None
+    assert res.expires_at == clock.now() + TTL
+
+
+def test_hold_ttl_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, hold_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    res = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_reserve_reduces_available_but_not_on_hand_or_ledger(stocked, ledger):
+    entries_before = len(ledger)
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert len(ledger) == entries_before
+
+
+def test_hold_in_one_warehouse_does_not_affect_another(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert stocked.available("MUG", "WH2") == 7
+
+
+def test_reserve_holds_partially_and_omits_empty_lines(stocked):
+    stocked.place_order("WH1", {"TEE": 5})
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 1}, "k1")
+    assert res.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_reserve_with_nothing_available_fails_and_creates_nothing(stocked, repo):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    assert repo.reservations() == []
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_rejected_request_holds_nothing(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_place_order_cannot_take_held_stock(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3})
+    stocked.place_order("WH1", {"MUG": 2})
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_writeoff_below_held_floors_available_and_keeps_hold(stocked):
+    res = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")
+    stocked.receive("MUG", "WH1", 1)
+    assert stocked.available("MUG", "WH1") == 0
+    assert stocked.get_reservation(res.reservation_id).items == {"MUG": 8}
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+
+
+# -- expiry ----------------------------------------------------------------
+def test_hold_is_active_just_before_expiry(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_hold_lapses_at_expires_at_without_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+# -- confirming ------------------------------------------------------------
+def test_confirm_turns_hold_into_placed_order(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.placed_at == clock.now()
+    assert order.warehouse == "WH1"
+    assert (order.quantity_of("MUG"), order.quantity_of("TEE")) == (3, 1)
+    assert repo.get_order(order.order_id) is order
+    confirmed = stocked.get_reservation(res.reservation_id)
+    assert (confirmed.status, confirmed.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+
+
+def test_confirm_does_not_change_available_or_on_hand(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (10, 7)
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+def test_confirmed_order_ships_like_any_order(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    stocked.ship_order(order.order_id)
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (7, 7)
+
+
+def test_confirm_twice_returns_same_order_even_after_ttl(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    again = stocked.confirm_reservation(res.reservation_id)
+    assert again is first
+    assert len(repo.orders()) == 1
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.CONFIRMED
+
+
+def test_confirm_lapsed_hold_raises_expired(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+
+
+def test_confirm_released_hold_is_invalid(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+
+
+def test_confirm_does_not_recheck_stock(stocked):
+    res = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -9, note="flood")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.quantity_of("MUG") == 8
+
+
+# -- releasing -------------------------------------------------------------
+def test_release_frees_units(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_release_twice_returns_it_unchanged(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    again = stocked.release_reservation(res.reservation_id)
+    assert again.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_release_confirmed_is_invalid(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_release_lapsed_hold_is_noop_reporting_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.EXPIRED
+
+
+def test_released_hold_stays_released_after_ttl(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    clock.advance(TTL)
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.RELEASED
+
+
+# -- idempotency -----------------------------------------------------------
+def test_same_key_same_request_returns_original_without_new_hold(stocked, repo):
+    first = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    again = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert len(repo.reservations()) == 1
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_replay_of_partial_hold_matches_on_requested_items(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    again = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.items == {"MUG": 10}
+
+
+@pytest.mark.parametrize("action", ["confirm", "release", "lapse"])
+def test_replay_returns_original_in_its_current_status(stocked, clock, action):
+    first = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    expected = {
+        "confirm": ReservationStatus.CONFIRMED,
+        "release": ReservationStatus.RELEASED,
+        "lapse": ReservationStatus.EXPIRED,
+    }[action]
+    if action == "confirm":
+        stocked.confirm_reservation(first.reservation_id)
+    elif action == "release":
+        stocked.release_reservation(first.reservation_id)
+    clock.advance(TTL)
+    again = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert (again.reservation_id, again.status) == (first.reservation_id, expected)
+    assert stocked.available("MUG", "WH1") == (6 if action == "confirm" else 10)
+
+
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [("WH1", {"MUG": 5}), ("WH1", {"MUG": 4, "TEE": 1}), ("WH2", {"MUG": 4})],
+)
+def test_same_key_different_request_conflicts(stocked, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+
+
+def test_replay_with_invalid_quantity_is_still_rejected(stocked):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": True}, "k1")
+
+
+def test_failed_reserve_does_not_burn_the_key(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    stocked.receive("CAP", "WH1", 1)
+    res = stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert res.items == {"CAP": 1}
+
+
+# -- lookup ----------------------------------------------------------------
+@pytest.mark.parametrize("call", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_is_reported(stocked, call):
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, call)("RES-9999")
+
+
+def test_new_errors_are_inventory_errors():
+    for error in (ReservationNotFound, ReservationExpired, InvalidReservationState, IdempotencyConflict):
+        assert issubclass(error, InventoryError)
+
+
+def test_three_argument_constructor_still_works(clock):
+    repo = InMemoryRepository()
+    service = InventoryService(repo, Ledger(), FixedClock(clock.now()))
+    assert service is not None

+++ b/tests/test_reservations.py
@@ -0,0 +1,266 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+# -- reserve -------------------------------------------------------------
+def test_reserve_holds_stock_without_moving_it(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert (
+        stocked.on_hand("MUG", "WH1"),
+        stocked.allocated("MUG", "WH1"),
+        stocked.reserved("MUG", "WH1"),
+        stocked.available("MUG", "WH1"),
+    ) == (10, 0, 4, 6)
+
+
+def test_new_reservation_is_active_for_twenty_minutes(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.items == {"MUG": 2, "TEE": 1}
+    assert res.warehouse == "WH1"
+    assert res.order_id is None
+    assert res.expires_at == clock.now() + TTL
+    assert stocked.get_reservation(res.reservation_id) is res
+
+
+def test_reservation_ttl_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    res = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_reservation_ids_are_distinct(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert first.reservation_id != second.reservation_id
+
+
+def test_partial_hold_caps_lines_and_omits_empty_ones(stocked):
+    stocked.place_order("WH1", {"TEE": 5})
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 2, "CAP": 1}, "k1")
+    assert res.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_nothing_available_raises_and_leaves_no_trace(stocked, clock):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    # the key was not consumed
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.items == {"MUG": 1}
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": True}, InvalidQuantity),
+        ("WH1", {}, InventoryError),
+    ],
+)
+def test_invalid_request_holds_nothing(stocked, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.reserved("MUG", "WH1") == 0
+    assert stocked.reserve("WH1", {"MUG": 1}, "k1").items == {"MUG": 1}
+
+
+def test_empty_idempotency_key_is_rejected(stocked):
+    with pytest.raises(InventoryError):
+        stocked.reserve("WH1", {"MUG": 1}, "")
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+def test_place_order_cannot_take_held_units(stocked):
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2})
+
+
+# -- expiry ----------------------------------------------------------------
+def test_hold_is_live_until_just_before_expiry(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_hold_lapses_at_expires_at_without_a_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.reserved("MUG", "WH1") == 0
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_lapsed_units_can_be_ordered(stocked, clock):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    clock.advance(TTL)
+    order = stocked.place_order("WH1", {"TEE": 5})
+    assert order.status is OrderStatus.PLACED
+
+
+# -- confirm ---------------------------------------------------------------
+def test_confirm_turns_hold_into_order(stocked, clock, repo):
+    stocked.place_order("WH1", {"TEE": 4})
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 3}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 3, "TEE": 1}
+    assert order.placed_at == clock.now()
+    res = stocked.get_reservation(res.reservation_id)
+    assert (res.status, res.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert repo.get_order(order.order_id) is order
+    assert (
+        stocked.allocated("MUG", "WH1"),
+        stocked.reserved("MUG", "WH1"),
+        stocked.available("MUG", "WH1"),
+    ) == (3, 0, 7)
+
+
+def test_confirm_is_idempotent_even_after_expiry(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(TTL * 2)
+    again = stocked.confirm_reservation(res.reservation_id)
+    assert again is order
+    assert len(repo.orders()) == 1
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.CONFIRMED
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_confirm_expired_hold_fails(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_confirm_released_hold_fails(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+
+
+# -- release ---------------------------------------------------------------
+def test_release_frees_units_and_is_repeatable(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+    again = stocked.release_reservation(res.reservation_id)
+    assert again.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_release_expired_hold_is_a_no_op(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.EXPIRED
+    assert released.items == {"MUG": 3}
+
+
+def test_release_confirmed_hold_fails(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+@pytest.mark.parametrize("action", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_is_reported(stocked, action):
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, action)("RES-9999")
+
+
+# -- idempotency -----------------------------------------------------------
+def test_retry_returns_same_reservation_without_holding_more(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    clock.advance(minutes=10)
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "k1")
+    assert again is res
+    assert again.expires_at == res.expires_at
+    assert stocked.reserved("MUG", "WH1") == 2
+
+
+def test_retry_of_partial_hold_matches_on_requested_items(stocked):
+    res = stocked.reserve("WH1", {"MUG": 50}, "k1")
+    stocked.receive("MUG", "WH1", 100)
+    again = stocked.reserve("WH1", {"MUG": 50}, "k1")
+    assert again is res
+    assert again.items == {"MUG": 10}
+
+
+def test_retry_after_finish_returns_finished_reservation(stocked, clock):
+    released = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    stocked.release_reservation(released.reservation_id)
+    lapsed = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    clock.advance(TTL)
+    assert stocked.reserve("WH1", {"MUG": 1}, "k1").status is ReservationStatus.RELEASED
+    assert stocked.reserve("WH1", {"MUG": 1}, "k2") is lapsed
+    assert lapsed.status is ReservationStatus.EXPIRED
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [("WH1", {"MUG": 3}), ("WH1", {"MUG": 2, "TEE": 1}), ("WH2", {"MUG": 2})],
+)
+def test_same_key_different_request_conflicts(stocked, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 2}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.reserved("MUG", "WH1") == 2
+
+
+def test_conflict_is_raised_even_when_original_is_finished(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 1}, "k1")
+
+
+# -- interaction with physical movements -------------------------------------
+def test_writeoff_below_held_leaves_holds_alone(stocked):
+    res = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")
+    assert stocked.available("MUG", "WH1") == 0
+    res = stocked.get_reservation(res.reservation_id)
+    assert (res.status, res.items) == (ReservationStatus.ACTIVE, {"MUG": 8})
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.quantity_of("MUG") == 8

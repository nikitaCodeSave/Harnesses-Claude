+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """Stock held for a cart before payment, in a single warehouse.
+
+    A hold is live while ACTIVE and before ``expires_at``; from ``expires_at`` on
+    it is EXPIRED and its units are available again (see ADR 0001).
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+
+    def is_live(self, now: datetime) -> bool:
+        return self.status is ReservationStatus.ACTIVE and now < self.expires_at
+
+
+@dataclass(frozen=True)
+class ReservationRequest:
+    """What a ``reserve`` call asked for, remembered under its idempotency key."""
+
+    warehouse: str
+    items: dict[str, int]
+    reservation_id: str
+
+

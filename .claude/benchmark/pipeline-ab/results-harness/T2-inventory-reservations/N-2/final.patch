+class InvalidReservationState(InventoryError):
+    def __init__(self, reservation_id: str, status: object, action: str) -> None:
+        super().__init__(f"cannot {action} reservation {reservation_id!r} in status {status}")
+        self.reservation_id = reservation_id
+        self.status = status
+        self.action = action

@@ -0,0 +1,281 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+def avail(service, sku="MUG", warehouse="WH1"):
+    return service.available(sku, warehouse)
+
+
+# -- reserve -------------------------------------------------------------
+def test_reserve_holds_stock_without_moving_it(stocked, ledger):
+    entries = len(ledger)
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.items == {"MUG": 4, "TEE": 2}
+    assert res.order_id is None
+    assert (avail(stocked), avail(stocked, "TEE")) == (6, 3)
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert len(ledger) == entries
+
+
+def test_reserve_holds_partially_and_omits_empty_lines(stocked):
+    stocked.place_order("WH1", {"TEE": 5})
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 1}, "k1")
+    assert res.items == {"MUG": 10}
+    assert avail(stocked) == 0
+
+
+def test_reserve_with_nothing_available_creates_nothing(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert stocked.held("CAP", "WH1") == 0
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {}, InventoryError),
+    ],
+)
+def test_rejected_reserve_holds_nothing(stocked, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert avail(stocked) == 10
+
+
+def test_reserve_sets_expiry_from_creation(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + TTL
+
+
+def test_reservation_ttl_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    assert service.reserve("WH1", {"MUG": 1}, "k1").expires_at == clock.now() + timedelta(
+        minutes=5
+    )
+
+
+def test_holds_are_per_warehouse(stocked):
+    stocked.receive("MUG", "WH2", 3)
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert avail(stocked, "MUG", "WH2") == 3
+
+
+def test_reserve_cannot_take_already_held_stock(stocked):
+    stocked.reserve("WH1", {"MUG": 7}, "k1")
+    assert stocked.reserve("WH1", {"MUG": 7}, "k2").items == {"MUG": 3}
+
+
+# -- expiry --------------------------------------------------------------
+def test_hold_lapses_at_expires_at_without_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(seconds=1))
+    assert avail(stocked) == 6
+    clock.advance(seconds=1)
+    assert avail(stocked) == 10
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_expiry_writes_nothing_to_ledger(stocked, clock, ledger):
+    entries = len(ledger)
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    avail(stocked)
+    assert len(ledger) == entries
+
+
+# -- idempotency ---------------------------------------------------------
+def test_same_key_same_request_returns_original(stocked):
+    first = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    again = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert avail(stocked) == 6
+
+
+def test_replay_matches_requested_not_held_items(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert first.items == {"MUG": 10}
+    assert stocked.reserve("WH1", {"MUG": 15}, "k1").reservation_id == first.reservation_id
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_replay_after_expiry_returns_expired_original(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    again = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert (again.reservation_id, again.status) == (first.reservation_id, ReservationStatus.EXPIRED)
+    assert avail(stocked) == 10
+
+
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [("WH1", {"MUG": 5}), ("WH1", {"MUG": 4, "TEE": 1}), ("WH2", {"MUG": 4})],
+)
+def test_same_key_different_request_conflicts(stocked, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+
+
+def test_conflict_applies_after_original_is_finished(stocked):
+    first = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(first.reservation_id)
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 1}, "k1")
+
+
+def test_replay_is_validated_like_a_new_request(stocked):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": True}, "k1")
+
+
+def test_failed_reserve_does_not_consume_key(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    stocked.receive("CAP", "WH1", 2)
+    assert stocked.reserve("WH1", {"CAP": 2}, "k1").items == {"CAP": 2}
+
+
+def test_key_is_bound_to_requested_items_not_caller_dict(stocked):
+    items = {"MUG": 4}
+    first = stocked.reserve("WH1", items, "k1")
+    items["MUG"] = 9
+    assert first.items == {"MUG": 4}
+    assert stocked.reserve("WH1", {"MUG": 4}, "k1").reservation_id == first.reservation_id
+
+
+# -- confirm -------------------------------------------------------------
+def test_confirm_turns_hold_into_placed_order(stocked, clock, ledger):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    entries = len(ledger)
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.placed_at == clock.now()
+    assert (order.quantity_of("MUG"), order.quantity_of("TEE")) == (4, 2)
+    after = stocked.get_reservation(res.reservation_id)
+    assert (after.status, after.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert (avail(stocked), avail(stocked, "TEE")) == (6, 3)
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert len(ledger) == entries
+
+
+def test_confirmed_order_survives_ttl(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    clock.advance(TTL * 3)
+    assert avail(stocked) == 6
+
+
+def test_confirm_partial_hold_orders_only_held_units(stocked):
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 1}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 10, "TEE": 1}
+
+
+def test_confirm_lapsed_hold_is_rejected(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_confirm_twice_returns_same_order_even_after_ttl(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(TTL * 2)
+    again = stocked.confirm_reservation(res.reservation_id)
+    assert again.order_id == order.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_confirm_released_hold_is_rejected(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+
+
+# -- release -------------------------------------------------------------
+def test_release_frees_held_stock(stocked, ledger):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    entries = len(ledger)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert avail(stocked) == 10
+    assert len(ledger) == entries
+
+
+def test_release_twice_is_harmless(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    assert stocked.release_reservation(res.reservation_id).status is ReservationStatus.RELEASED
+
+
+def test_release_expired_returns_it_unchanged(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    assert stocked.release_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_release_confirmed_is_rejected(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    assert avail(stocked) == 6
+
+
+# -- lookup --------------------------------------------------------------
+@pytest.mark.parametrize("action", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_is_reported(stocked, action):
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, action)("RES-9999")
+
+
+# -- interaction with orders and stock movements -------------------------
+def test_place_order_cannot_take_held_stock(stocked, repo):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3, "TEE": 1})
+    assert repo.orders() == []
+
+
+def test_writeoff_below_held_is_allowed(stocked):
+    res = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")
+    assert avail(stocked) == 0
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.get_reservation(res.reservation_id).items == {"MUG": 8}

     # -- helpers ---------------------------------------------------------
+    def _expire_if_lapsed(self, reservation: Reservation, now: datetime) -> bool:
+        """Persist the clock's verdict on an ACTIVE hold. True if it has lapsed."""
+        if reservation.status is ReservationStatus.ACTIVE and now >= reservation.expires_at:
+            reservation.status = ReservationStatus.EXPIRED
+            self._repo.save_reservation(reservation)
+        return reservation.status is ReservationStatus.EXPIRED
+
+    def _create_order(self, warehouse: str, wanted: Mapping[str, int]) -> Order:
+        order = Order(
+            order_id=self._repo.next_order_id(),
+            warehouse=warehouse,
+            lines=tuple(OrderLine(sku, qty) for sku, qty in wanted.items()),
+            status=OrderStatus.PLACED,
+            placed_at=self._clock.now(),
+        )
+        self._repo.save_order(order)
+        return order
+
     def _check_location(self, sku: str, warehouse: str) -> None:
         self._repo.get_warehouse(warehouse)
         self._repo.get_product(sku)

+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """Stock held for a cart before payment.
+
+    ``items`` is what is actually held, which may be less than was requested.
+    An ACTIVE reservation is expired from ``expires_at`` on; the service
+    evaluates that against its clock (see docs/adr/0001).

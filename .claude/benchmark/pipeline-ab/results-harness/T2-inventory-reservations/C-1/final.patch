+    ) -> Reservation:
+        """Hold stock for a cart. Each line holds what is available, up to the
+        quantity asked; lines with nothing available are left out.
+
+        Replaying ``idempotency_key`` with the same request returns the original
+        reservation as it is now; a different request raises IdempotencyConflict.
+        """
+        wanted = self._validate_items(warehouse, items)
+        record = self._repo.find_idempotency_record(idempotency_key)
+        if record is not None:
+            if record.warehouse != warehouse or dict(record.requested) != wanted:
+                raise IdempotencyConflict(idempotency_key)
+            return self.get_reservation(record.reservation_id)

+"""Stock reservations — see specs/stock-reservations.md (ACn refers to its criteria)."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import InMemoryRepository, InventoryService, Ledger, OrderStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+from inventory.models import Reservation, ReservationStatus
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 7)
+    return service
+
+
+# -- creating a hold ----------------------------------------------------------
+def test_reserve_creates_active_hold_expiring_in_20_minutes(stocked, clock):  # AC1
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    assert isinstance(r, Reservation)
+    assert (r.warehouse, r.items, r.status, r.order_id) == (
+        "WH1", {"MUG": 3, "TEE": 2}, ReservationStatus.ACTIVE, None,
+    )
+    assert r.expires_at == clock.now() + TTL
+
+
+def test_ttl_is_configurable(repo, ledger, clock):  # AC2
+    svc = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    svc.receive("MUG", "WH1", 1)
+    assert svc.reserve("WH1", {"MUG": 1}, "k").expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_partial_hold_takes_what_is_available_and_omits_empty_lines(stocked):  # AC3
+    stocked.place_order("WH1", {"TEE": 5})
+    r = stocked.reserve("WH1", {"MUG": 12, "TEE": 1}, "k")
+    assert r.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_nothing_holdable_raises_and_creates_nothing(stocked):  # AC4
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k")
+    with pytest.raises(ReservationNotFound):
+        stocked.get_reservation("RES-0001")
+    # the key was not consumed (AC25): a different request under it works
+    assert stocked.reserve("WH1", {"MUG": 1}, "k").items == {"MUG": 1}
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": 1.5}, InvalidQuantity),
+        ("WH1", {}, InventoryError),
+    ],
+)
+def test_bad_input_rejects_whole_request(stocked, repo, warehouse, items, error):  # AC5
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k")
+    assert stocked.available("MUG", "WH1") == 10
+    assert repo.reservations() == []
+
+
+def test_reservation_ids_are_unique(stocked):  # AC6
+    a = stocked.reserve("WH1", {"MUG": 1}, "a")
+    b = stocked.reserve("WH1", {"MUG": 1}, "b")
+    assert a.reservation_id != b.reservation_id
+
+
+# -- availability --------------------------------------------------------------
+def test_available_subtracts_allocations_and_holds(stocked):  # AC7
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert stocked.available("MUG", "WH1") == 5
+
+
+def test_hold_is_per_warehouse(stocked):  # AC8
+    stocked.reserve("WH1", {"MUG": 4}, "k")
+    assert stocked.available("MUG", "WH2") == 7
+
+
+def test_hold_does_not_touch_ledger_or_on_hand(stocked, ledger):  # AC9
+    before = len(ledger)
+    stocked.reserve("WH1", {"MUG": 4}, "k")
+    assert (len(ledger), stocked.on_hand("MUG", "WH1")) == (before, 10)
+
+
+def test_writeoff_below_held_floors_available_and_keeps_hold(stocked):  # AC10
+    r = stocked.reserve("WH1", {"MUG": 8}, "k")
+    stocked.adjust("MUG", "WH1", -5, note="broken")
+    stocked.receive("MUG", "WH1", 1)
+    assert stocked.available("MUG", "WH1") == 0
+    held = stocked.get_reservation(r.reservation_id)
+    assert (held.status, held.items) == (ReservationStatus.ACTIVE, {"MUG": 8})
+
+
+def test_place_order_cannot_take_held_units(stocked, repo):  # AC11
+    stocked.reserve("WH1", {"MUG": 8}, "k")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3, "TEE": 1})
+    assert repo.orders() == []
+
+
+# -- expiry --------------------------------------------------------------------
+def test_hold_is_active_just_before_expiry(stocked, clock):  # AC12
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.ACTIVE
+
+
+def test_hold_expires_at_expires_at_without_a_sweep(stocked, clock):  # AC12
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.set(r.expires_at)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_expired_hold_frees_stock_for_orders(stocked, clock):  # AC12
+    stocked.reserve("WH1", {"MUG": 10}, "k")
+    clock.advance(TTL)
+    assert stocked.place_order("WH1", {"MUG": 10}).status is OrderStatus.PLACED
+
+
+def test_confirmed_and_released_never_expire(stocked, clock):  # AC13
+    c = stocked.reserve("WH1", {"MUG": 1}, "c")
+    stocked.confirm_reservation(c.reservation_id)
+    r = stocked.reserve("WH1", {"MUG": 1}, "r")
+    stocked.release_reservation(r.reservation_id)
+    clock.advance(days=1)
+    assert stocked.get_reservation(c.reservation_id).status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.RELEASED
+
+
+# -- confirm -------------------------------------------------------------------
+def test_confirm_creates_placed_order_for_held_units(stocked, clock):  # AC14
+    stocked.place_order("WH1", {"TEE": 4})
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 3}, "k")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert (order.warehouse, order.status, order.placed_at) == ("WH1", OrderStatus.PLACED, clock.now())
+    assert (order.quantity_of("MUG"), order.quantity_of("TEE")) == (3, 1)
+    after = stocked.get_reservation(r.reservation_id)
+    assert (after.status, after.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+
+
+def test_confirm_keeps_available_and_on_hand(stocked):  # AC15
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    before = (stocked.available("MUG", "WH1"), stocked.on_hand("MUG", "WH1"))
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert (stocked.available("MUG", "WH1"), stocked.on_hand("MUG", "WH1")) == before
+    stocked.ship_order(order.order_id)
+    assert stocked.on_hand("MUG", "WH1") == 7
+
+
+def test_confirm_twice_returns_same_order_even_after_ttl(stocked, repo, clock):  # AC16
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    first = stocked.confirm_reservation(r.reservation_id)
+    clock.advance(hours=1)
+    again = stocked.confirm_reservation(r.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_confirm_of_just_expired_hold_raises(stocked, clock, repo):  # AC17
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    clock.set(r.expires_at)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+
+
+def test_confirm_of_released_raises(stocked):  # AC18
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.release_reservation(r.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(r.reservation_id)
+
+
+# -- release -------------------------------------------------------------------
+def test_release_frees_units(stocked):  # AC19
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    released = stocked.release_reservation(r.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_release_of_released_or_expired_is_noop(stocked, clock):  # AC20
+    a = stocked.reserve("WH1", {"MUG": 3}, "a")
+    stocked.release_reservation(a.reservation_id)
+    assert stocked.release_reservation(a.reservation_id).status is ReservationStatus.RELEASED
+    b = stocked.reserve("WH1", {"MUG": 3}, "b")
+    clock.advance(TTL)
+    assert stocked.release_reservation(b.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_release_of_confirmed_raises(stocked):  # AC21
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.confirm_reservation(r.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(r.reservation_id)
+
+
+@pytest.mark.parametrize("call", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_is_reported(stocked, call):  # AC22
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, call)("RES-9999")
+
+
+# -- idempotency ---------------------------------------------------------------
+def test_replay_returns_original_without_new_hold(stocked, clock):  # AC23
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    clock.advance(minutes=10)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert (again.reservation_id, again.expires_at) == (r.reservation_id, r.expires_at)
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_replay_compares_requested_not_held_items(stocked):  # AC23
+    r = stocked.reserve("WH1", {"MUG": 15}, "k")
+    assert r.items == {"MUG": 10}
+    assert stocked.reserve("WH1", {"MUG": 15}, "k").reservation_id == r.reservation_id
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k")
+
+
+def test_replay_of_finished_reservation_returns_it_as_is(stocked, clock):  # AC23
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    clock.advance(TTL)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert (again.reservation_id, again.status) == (r.reservation_id, ReservationStatus.EXPIRED)
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_replay_of_confirmed_and_released_returns_them_as_is(stocked, repo):  # AC23
+    c = stocked.reserve("WH1", {"MUG": 3}, "c")
+    order = stocked.confirm_reservation(c.reservation_id)
+    r = stocked.reserve("WH1", {"MUG": 2}, "r")
+    stocked.release_reservation(r.reservation_id)
+    again_c = stocked.reserve("WH1", {"MUG": 3}, "c")
+    again_r = stocked.reserve("WH1", {"MUG": 2}, "r")
+    assert (again_c.status, again_c.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert again_r.status is ReservationStatus.RELEASED
+    assert len(repo.reservations()) == 2
+    assert stocked.available("MUG", "WH1") == 7
+
+
+@pytest.mark.parametrize(
+    "warehouse, items", [("WH2", {"MUG": 3}), ("WH1", {"MUG": 4}), ("WH1", {"MUG": 3, "TEE": 1})]
+)
+def test_key_reuse_with_different_request_conflicts(stocked, warehouse, items):  # AC24, AC26
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.release_reservation(r.reservation_id)

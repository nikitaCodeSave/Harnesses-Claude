diff --git a/tests/test_plan_changes_trial.py b/tests/test_plan_changes_trial.py
new file mode 100644
index 0000000..6c7be85
--- /dev/null
+++ b/tests/test_plan_changes_trial.py
@@ -0,0 +1,116 @@
+from dataclasses import replace
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import InvalidPlanChange, PlanNotAvailable
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+
+def test_trial_downgrade_takes_effect_immediately_with_nothing_billed(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)  # trial 2026-01-15 to 2026-01-29
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.interval, after.status) == ("basic", Interval.MONTHLY, SubscriptionStatus.TRIALING)
+    assert (after.period_start, after.period_end) == (date(2026, 1, 15), date(2026, 1, 29))
+    assert store.invoices_for(sub.id) == []
+
+
+def test_trial_upgrade_takes_effect_immediately_with_nothing_billed(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "pro") is None
+
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.status) == ("pro", SubscriptionStatus.TRIALING)
+    assert (after.period_start, after.period_end) == (date(2026, 1, 15), date(2026, 1, 29))
+    assert store.invoices_for(sub.id) == []
+
+
+def test_trial_interval_switch_is_immediate_and_trial_end_bills_a_year(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.interval, after.status) == ("basic", Interval.ANNUAL, SubscriptionStatus.TRIALING)
+    assert (after.period_start, after.period_end) == (date(2026, 1, 15), date(2026, 1, 29))
+    assert store.invoices_for(sub.id) == []
+
+    clock.move_to(date(2026, 1, 29))
+    [invoice] = service.renew_due()
+
+    paid = store.get_subscription(sub.id)
+    assert (paid.status, paid.interval) == (SubscriptionStatus.ACTIVE, Interval.ANNUAL)
+    assert (paid.period_start, paid.period_end) == (date(2026, 1, 29), date(2027, 1, 29))
+    assert invoice.issued_on == date(2026, 1, 29)
+    assert invoice.total == Decimal("100.00")
+
+
+def test_trial_end_bills_the_first_paid_period_at_the_new_plans_full_price(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "basic")
+
+    clock.move_to(date(2026, 1, 29))
+    [invoice] = service.renew_due()
+
+    paid = store.get_subscription(sub.id)
+    assert (paid.plan_code, paid.status) == ("basic", SubscriptionStatus.ACTIVE)
+    assert (paid.period_start, paid.period_end) == (date(2026, 1, 29), date(2026, 2, 28))
+    assert invoice.total == Decimal("10.00")
+    assert store.invoices_for(sub.id) == [invoice]
+
+
+def test_trial_change_clears_a_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    store.save_subscription(replace(sub, scheduled_plan_code="pro", scheduled_interval=Interval.ANNUAL))
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.interval) == ("basic", Interval.MONTHLY)
+    assert (after.scheduled_plan_code, after.scheduled_interval) == (None, None)
+    assert store.invoices_for(sub.id) == []
+
+
+def assert_rejected(service, store, sub_id, error, plan_code, interval=None):
+    before = store.get_subscription(sub_id)
+    with pytest.raises(error):
+        service.change_plan(sub_id, plan_code, interval)
+    assert store.get_subscription(sub_id) == before
+    assert store.invoices_for(sub_id) == []
+
+
+@pytest.mark.parametrize("interval", [None, Interval.MONTHLY])
+def test_trial_asking_for_current_plan_and_interval_is_rejected(service, store, clock, interval):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+    assert_rejected(service, store, sub.id, InvalidPlanChange, "basic", interval)
+
+
+@pytest.mark.parametrize(("current", "target"), [("basic", "pro"), ("pro", "basic")])
+def test_trial_change_to_retired_plan_is_rejected(service, store, clock, current, target):
+    sub = service.subscribe("cus_1", current, trial_days=14)
+    store.retire_plan(target)
+    clock.move_to(date(2026, 1, 20))
+    assert_rejected(service, store, sub.id, PlanNotAvailable, target)
+
+
+@pytest.mark.parametrize(
+    ("target", "interval"),
+    [("basic", None), ("pro", Interval.ANNUAL)],
+    ids=["downgrade", "interval-switch"],
+)
+def test_trial_change_after_the_trial_ended_without_renewal_is_rejected(service, store, clock, target, interval):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 29))
+    assert_rejected(service, store, sub.id, InvalidPlanChange, target, interval)

+    clock.move_to(date(2026, 2, 15))
+    [invoice] = service.renew_due()
+
+    assert amounts(invoice) == [Decimal("30.00")]
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+
+def test_a_later_request_replaces_the_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert scheduled(store, sub.id) == ("pro", Interval.ANNUAL)
+
+    clock.move_to(date(2026, 2, 15))
+    [invoice] = service.renew_due()
+
+    assert amounts(invoice) == [Decimal("300.00")]

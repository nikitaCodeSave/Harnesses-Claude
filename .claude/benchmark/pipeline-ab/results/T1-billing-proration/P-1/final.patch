+++ b/tests/test_plan_changes_upgrade_schedule.py
@@ -0,0 +1,106 @@
+"""How an upgrade interacts with the scheduled change (ticket 03)."""
+
+from datetime import date
+from decimal import Decimal
+
+from billing.plans import Interval, Plan
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def scheduled(store, subscription_id):
+    sub = store.get_subscription(subscription_id)
+    return (sub.scheduled_plan_code, sub.scheduled_interval)
+
+
+def test_upgrade_with_interval_switch_is_prorated_now_and_schedules_the_switch(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")  # 2026-01-15 to 2026-02-15
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+    # Prorated at monthly prices: 10 x 21/31 = 6.774..., 30 x 21/31 = 20.322...
+    assert invoice.issued_on == date(2026, 1, 25)
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+    assert scheduled(store, sub.id) == ("pro", Interval.ANNUAL)
+
+
+def test_renewal_after_upgrade_with_interval_switch_starts_a_full_year_on_the_new_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 2, 15))
+
+    [invoice] = service.renew_due()
+
+    assert invoice.issued_on == date(2026, 2, 15)
+    assert amounts(invoice) == [Decimal("300.00")]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+    assert scheduled(store, sub.id) == (None, None)
+
+
+def test_plain_upgrade_drops_a_scheduled_downgrade(service, store, clock):
+    store.add_plan(Plan("max", "Max", Decimal("50.00"), Decimal("500.00")))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "max")
+
+    # 30 x 21/31 = 20.322..., 50 x 21/31 = 33.870...
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("33.87")]
+    assert scheduled(store, sub.id) == (None, None)
+
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+
+    assert amounts(renewal) == [Decimal("50.00")]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("max", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_upgrade_with_interval_switch_replaces_a_scheduled_change(service, store, clock):
+    store.add_plan(Plan("max", "Max", Decimal("50.00"), Decimal("500.00")))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "max", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("33.87")]
+    assert store.get_subscription(sub.id).plan_code == "max"
+    assert scheduled(store, sub.id) == ("max", Interval.ANNUAL)
+
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+
+    assert amounts(renewal) == [Decimal("500.00")]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("max", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+
+
+def test_request_is_classified_against_the_current_plan_not_the_scheduled_one(service, store, clock):
+    store.add_plan(Plan("plus", "Plus", Decimal("20.00"), Decimal("200.00")))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    # Plus is above the scheduled Basic but below the current Pro: a downgrade.
+    assert service.change_plan(sub.id, "plus") is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.get_subscription(sub.id).plan_code == "pro"
+    assert scheduled(store, sub.id) == ("plus", Interval.MONTHLY)

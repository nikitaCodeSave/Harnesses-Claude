+
+    clock.move_to(date(2027, 1, 15))
+    [invoice] = service.renew_due()
+
+    assert amounts(invoice) == [Decimal("10.00")]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 1, 15), date(2027, 2, 15))
+
+
+def test_downgrade_with_interval_switch_is_applied_together_at_renewal(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    assert scheduled(store, sub.id) == ("basic", Interval.ANNUAL)
+
+    clock.move_to(date(2026, 2, 15))
+    [invoice] = service.renew_due()
+
+    assert amounts(invoice) == [Decimal("100.00")]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+
+
+def test_equal_monthly_price_plan_is_scheduled_like_a_downgrade(service, store, clock):
+    store.add_plan(Plan("basic_plus", "Basic Plus", Decimal("10.00"), Decimal("90.00")))
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic_plus") is None

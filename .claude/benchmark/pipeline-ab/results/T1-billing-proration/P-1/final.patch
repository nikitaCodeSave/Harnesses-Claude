+
+
+def test_scheduled_plan_retired_before_renewal_is_still_applied(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+    store.retire_plan("basic")
+    clock.move_to(date(2026, 2, 15))
+
+    [invoice] = service.renew_due()
+
+    assert amounts(invoice) == [Decimal("10.00")]
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_catch_up_applies_the_scheduled_change_only_at_the_first_renewal(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)  # 2026-01-15 to 2027-01-15
+    clock.move_to(date(2026, 6, 1))
+    service.change_plan(sub.id, "basic", Interval.MONTHLY)
+    clock.move_to(date(2027, 3, 20))  # missed Jan 15, Feb 15 and Mar 15
+
+    invoices = service.renew_due()
+
+    assert [inv.issued_on for inv in invoices] == [date(2027, 1, 15), date(2027, 2, 15), date(2027, 3, 15)]
+    assert [inv.total for inv in invoices] == [Decimal("10.00")] * 3
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 3, 15), date(2027, 4, 15))
+    assert scheduled(store, sub.id) == (None, None)
+
+
+def test_interval_switch_on_a_retired_current_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    assert_rejected(service, store, sub.id, PlanNotAvailable, "basic", Interval.ANNUAL)
+
+
+def test_customer_on_retired_plan_can_schedule_a_downgrade_to_an_active_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")

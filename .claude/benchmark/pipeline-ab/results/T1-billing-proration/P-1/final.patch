+
+    clock.move_to(date(2026, 2, 15))
+    [invoice] = service.renew_due()
+
+    assert amounts(invoice) == [Decimal("10.00")]
+    assert store.get_subscription(sub.id).plan_code == "basic_plus"
+
+
+@pytest.mark.parametrize("interval", [None, Interval.MONTHLY])
+def test_asking_for_current_plan_and_interval_cancels_the_scheduled_change(service, store, clock, interval):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))

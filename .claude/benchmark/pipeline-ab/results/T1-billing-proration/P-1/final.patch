+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+    assert scheduled(store, sub.id) == (None, None)
+
+
+def test_annual_to_monthly_switch_starts_a_one_month_period_at_renewal(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)  # 2026-01-15 to 2027-01-15

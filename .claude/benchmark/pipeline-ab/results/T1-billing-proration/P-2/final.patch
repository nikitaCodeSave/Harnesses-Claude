+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+
+def test_upgrade_mid_period_bills_prorated_invoice_today(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    credit, charge = invoice.lines
+    assert invoice.issued_on == date(2026, 1, 25)
+    assert (credit.amount, charge.amount, invoice.total) == (
+        Decimal("-6.77"),
+        Decimal("20.32"),
+        Decimal("13.55"),
+    )
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+
+
+def test_upgrade_rounds_each_line_before_summing(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 12))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    credit, charge = invoice.lines
+    assert (credit.amount, charge.amount, invoice.total) == (
+        Decimal("-0.97"),
+        Decimal("2.90"),
+        Decimal("1.93"),
+    )
+
+
+def test_upgrade_lines_name_plan_interval_and_dates(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 12))
+
+    credit, charge = service.change_plan(sub.id, "pro").lines
+
+    for line, plan_name in ((credit, "Basic"), (charge, "Pro")):
+        assert plan_name in line.description
+        assert "monthly" in line.description
+        assert "2026-02-12 to 2026-02-15" in line.description
+
+
+def test_upgrade_on_first_day_credits_and_charges_whole_prices(service):
+    sub = service.subscribe("cus_1", "basic")
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    credit, charge = invoice.lines
+    assert (credit.amount, charge.amount) == (Decimal("-10.00"), Decimal("30.00"))
+
+
+def test_annual_upgrade_prorates_annual_prices_over_days_left_in_year(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 10, 1))  # 106 of 365 days left
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    credit, charge = invoice.lines
+    assert (credit.amount, charge.amount, invoice.total) == (
+        Decimal("-29.04"),
+        Decimal("87.12"),
+        Decimal("58.08"),
+    )
+    changed = store.get_subscription(sub.id)
+    assert (changed.interval, changed.period_end) == (Interval.ANNUAL, date(2027, 1, 15))
+
+
+def test_upgrade_from_free_plan_has_zero_credit_line(service, store, clock):
+    store.add_plan(Plan("free", "Free", Decimal("0"), Decimal("0")))
+    sub = service.subscribe("cus_1", "free")
+    clock.move_to(date(2026, 2, 12))
+
+    credit, charge = service.change_plan(sub.id, "basic").lines
+
+    assert (str(credit.amount), charge.amount) == ("0.00", Decimal("0.97"))
+
+
+def test_second_upgrade_credits_the_first_upgrades_plan(service, store, clock):
+    store.add_plan(Plan("max", "Max", Decimal("50.00"), Decimal("500.00")))
+    sub = service.subscribe("cus_1", "basic")

diff --git a/tests/test_change_plan.py b/tests/test_change_plan.py
new file mode 100644
index 0000000..5d70894
--- /dev/null
+++ b/tests/test_change_plan.py
@@ -0,0 +1,289 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import ScheduledChange, SubscriptionStatus
+
+
+@pytest.fixture(autouse=True)
+def more_plans(store):
+    store.add_plan(Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")))
+    store.add_plan(Plan("free", "Free", Decimal("0"), Decimal("0")))
+
+
+@pytest.fixture
+def pro_in_march(service, clock):
+    """Pro monthly, current period Mar 1 - Apr 1 (31 days), clock on Mar 11 (21 days left)."""
+    clock.move_to(date(2026, 3, 1))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 3, 11))
+    return sub
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def renew_on(service, clock, day):
+    clock.move_to(day)
+    [invoice] = service.renew_due()
+    return invoice
+
+
+# upgrades
+
+
+def test_upgrade_prorates_both_plans_over_the_remaining_days(service, store, pro_in_march):
+    invoice = service.change_plan(pro_in_march.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert (invoice.issued_on, invoice.total) == (date(2026, 3, 11), Decimal("30.49"))
+    assert store.invoices_for(pro_in_march.id)[-1] == invoice
+    upgraded = store.get_subscription(pro_in_march.id)
+    assert (upgraded.plan_code, upgraded.interval) == ("premium", Interval.MONTHLY)
+    assert (upgraded.period_start, upgraded.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+
+
+def test_renewal_after_upgrade_bills_new_plan_in_full(service, store, clock, pro_in_march):
+    service.change_plan(pro_in_march.id, "premium")
+
+    renewal = renew_on(service, clock, date(2026, 4, 1))
+
+    assert renewal.total == Decimal("75.00")
+
+
+def test_upgrade_on_first_day_of_period_swaps_full_prices(service, pro_in_march, clock):
+    clock.move_to(date(2026, 4, 1))
+    service.renew_due()
+
+    invoice = service.change_plan(pro_in_march.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-30.00"), Decimal("75.00")]
+
+
+def test_upgrade_on_annual_prorates_annual_prices(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)  # Jan 15 2026 - Jan 15 2027, 365 days
+    clock.move_to(date(2026, 7, 15))  # 184 days left
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-151.23"), Decimal("378.08")]
+    upgraded = store.get_subscription(sub.id)
+    assert (upgraded.interval, upgraded.period_end) == (Interval.ANNUAL, date(2027, 1, 15))
+
+
+def test_upgrade_from_free_plan_still_has_two_lines(service, clock):
+    sub = service.subscribe("cus_1", "free")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "basic")
+
+    assert amounts(invoice) == [Decimal("0.00"), Decimal("6.77")]
+
+
+def test_upgrade_with_interval_switch_upgrades_now_and_switches_at_period_end(
+    service, store, clock, pro_in_march
+):
+    invoice = service.change_plan(pro_in_march.id, "premium", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    upgraded = store.get_subscription(pro_in_march.id)
+    assert (upgraded.plan_code, upgraded.interval) == ("premium", Interval.MONTHLY)
+    assert upgraded.scheduled_change == ScheduledChange("premium", Interval.ANNUAL)
+
+    renewal = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(pro_in_march.id)
+    assert renewal.total == Decimal("750.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.ANNUAL, date(2027, 4, 1))
+
+
+# downgrades and interval switches
+
+
+def test_downgrade_waits_for_period_end(service, store, clock, pro_in_march):
+    assert service.change_plan(pro_in_march.id, "basic") is None
+
+    assert len(store.invoices_for(pro_in_march.id)) == 1
+    current = store.get_subscription(pro_in_march.id)
+    assert current.plan_code == "pro"
+    assert current.scheduled_change == ScheduledChange("basic", Interval.MONTHLY)
+
+    renewal = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(pro_in_march.id)
+    assert renewal.total == Decimal("10.00")
+    assert (renewed.plan_code, renewed.scheduled_change) == ("basic", None)
+
+
+def test_downgrade_is_judged_by_monthly_price_and_can_switch_interval(service, store, clock, pro_in_march):
+    # basic annual (100.00) costs more than pro monthly (30.00) but is still a downgrade
+    assert service.change_plan(pro_in_march.id, "basic", Interval.ANNUAL) is None
+    assert len(store.invoices_for(pro_in_march.id)) == 1
+
+    renewal = renew_on(service, clock, date(2026, 4, 1))
+    renewed = store.get_subscription(pro_in_march.id)
+    assert renewal.total == Decimal("100.00")
+    assert (renewed.plan_code, renewed.interval, renewed.period_end) == (
+        "basic",
+        Interval.ANNUAL,
+        date(2027, 4, 1),
+    )
+
+
+def test_monthly_to_annual_waits_for_period_end(service, store, clock, pro_in_march):
+    assert service.change_plan(pro_in_march.id, "pro", Interval.ANNUAL) is None
+    assert store.get_subscription(pro_in_march.id).interval is Interval.MONTHLY
+
+    renewal = renew_on(service, clock, date(2026, 4, 1))
+    assert renewal.total == Decimal("300.00")
+    assert store.get_subscription(pro_in_march.id).period_end == date(2027, 4, 1)
+
+
+def test_annual_to_monthly_waits_for_period_end_without_refund(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert [inv.total for inv in store.invoices_for(sub.id)] == [Decimal("300.00")]
+
+    renewal = renew_on(service, clock, date(2027, 1, 15))
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).period_end == date(2027, 2, 15)
+
+
+def test_same_monthly_price_plan_waits_for_period_end(service, store, pro_in_march):
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("280.00")))
+
+    assert service.change_plan(pro_in_march.id, "team") is None
+    assert store.get_subscription(pro_in_march.id).scheduled_change == ScheduledChange("team", Interval.MONTHLY)
+
+
+def test_scheduled_plan_retired_before_renewal_still_applies(service, store, clock, pro_in_march):
+    service.change_plan(pro_in_march.id, "basic")
+    store.retire_plan("basic")
+
+    renewal = renew_on(service, clock, date(2026, 4, 1))
+
+    assert renewal.total == Decimal("10.00")
+
+
+# one scheduled change at a time
+
+
+def test_new_request_replaces_scheduled_change(service, store, clock, pro_in_march):
+    service.change_plan(pro_in_march.id, "basic")
+    service.change_plan(pro_in_march.id, "pro", Interval.ANNUAL)
+
+    assert store.get_subscription(pro_in_march.id).scheduled_change == ScheduledChange("pro", Interval.ANNUAL)
+    assert renew_on(service, clock, date(2026, 4, 1)).total == Decimal("300.00")
+
+
+def test_upgrade_discards_scheduled_downgrade_and_prorates_from_current_plan(service, store, pro_in_march):
+    service.change_plan(pro_in_march.id, "basic")
+
+    invoice = service.change_plan(pro_in_march.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert store.get_subscription(pro_in_march.id).scheduled_change is None
+
+
+def test_upgrade_with_interval_switch_replaces_scheduled_downgrade(service, store, pro_in_march):
+    service.change_plan(pro_in_march.id, "basic")
+

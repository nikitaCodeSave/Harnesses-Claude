+"""SPEC.md acceptance criterion 19: no plan change requested, existing behaviour unchanged.
+
+These pass before the feature exists; they guard against regressions while it is built.
+The existing suite under tests/ must also keep passing unmodified.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+
+def test_subscribe_bills_first_period_in_full(service, store):
+    sub = service.subscribe("cus_1", "pro")
+    [invoice] = store.invoices_for(sub.id)
+    assert (invoice.issued_on, invoice.total) == (date(2026, 1, 10), Decimal("30.00"))
+    assert (sub.period_start, sub.period_end) == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+def test_renewals_keep_plan_and_interval(service, store, renew_on):
+    monthly = service.subscribe("cus_1", "pro")
+    annual = service.subscribe("cus_2", "basic", Interval.ANNUAL)
+
+    issued = renew_on(date(2027, 1, 10))
+
+    monthly_invoices = [inv for inv in issued if inv.subscription_id == monthly.id]
+    annual_invoices = [inv for inv in issued if inv.subscription_id == annual.id]
+    assert [inv.total for inv in monthly_invoices] == [Decimal("30.00")] * 12
+    assert [(inv.issued_on, inv.total) for inv in annual_invoices] == [(date(2027, 1, 10), Decimal("100.00"))]
+    assert store.get_subscription(monthly.id).plan_code == "pro"
+    assert store.get_subscription(annual.id).interval is Interval.ANNUAL
+
+
+def test_trial_then_renewal(service, store, renew_on):
+    sub = service.subscribe("cus_1", "premium", trial_days=14)
+    [invoice] = renew_on(date(2026, 1, 24))
+    paid = store.get_subscription(sub.id)
+    assert invoice.total == Decimal("50.00")
+    assert (paid.status, paid.period_end) == (SubscriptionStatus.ACTIVE, date(2026, 2, 24))
+
+
+def test_cancel_stops_renewals(service, renew_on):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    assert renew_on(date(2026, 3, 1)) == []

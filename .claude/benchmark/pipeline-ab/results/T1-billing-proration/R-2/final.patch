@@ -0,0 +1,268 @@
+"""SPEC.md acceptance criteria 7-9, 11-13 and 18: changes deferred to the next renewal."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+import billing.errors as errors
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+
+def assert_nothing_changed_now(store, before, invoice_count):
+    now = store.get_subscription(before.id)
+    assert now.plan_code == before.plan_code
+    assert now.interval is before.interval
+    assert (now.period_start, now.period_end) == (before.period_start, before.period_end)
+    assert now.status is before.status
+    assert len(store.invoices_for(before.id)) == invoice_count
+
+
+# Criterion 7
+
+
+def test_downgrade_returns_none_and_changes_nothing_now(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+
+def test_downgrade_applies_at_next_renewal_at_full_price(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+
+    [renewal] = renew_on(date(2026, 2, 10))
+
+    assert renewal.issued_on == date(2026, 2, 10)
+    assert renewal.total == Decimal("10.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_annual_downgrade_applies_at_next_renewal_at_full_annual_price(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "premium", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 1))
+
+    assert service.change_plan(sub.id, "pro") is None
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+    [renewal] = renew_on(date(2027, 1, 10))
+    assert renewal.total == Decimal("300.00")
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+
+def test_applied_pending_change_is_cleared(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+    renew_on(date(2026, 2, 10))
+
+    [second] = renew_on(date(2026, 3, 10))
+
+    assert second.total == Decimal("10.00")
+    # Basic with nothing pending: requesting Basic again is not a change.
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "basic")
+
+
+# Criterion 8
+
+
+def test_equal_monthly_price_is_a_downgrade(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "team") is None  # 30.00 == 30.00
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).plan_code == "team"
+
+
+def test_equal_monthly_price_is_a_downgrade_even_with_higher_annual_price(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 1))
+
+    # Team: monthly 30.00 == Pro's, annual 320.00 > Pro's 300.00. Still a downgrade.
+    assert service.change_plan(sub.id, "team") is None
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+    [renewal] = renew_on(date(2027, 1, 10))
+    assert renewal.total == Decimal("320.00")
+    assert store.get_subscription(sub.id).plan_code == "team"
+
+
+# Criterion 9
+
+
+def test_interval_switch_monthly_to_annual(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")  # [2026-01-10, 2026-02-10)
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("300.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2027, 2, 10))
+
+
+def test_interval_switch_annual_to_monthly(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)  # [2026-01-10, 2027-01-10)
+    clock.move_to(date(2026, 7, 1))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+    [renewal] = renew_on(date(2027, 1, 10))
+    assert renewal.total == Decimal("30.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 1, 10), date(2027, 2, 10))
+
+
+# Criterion 11
+
+
+def test_downgrade_with_switch_to_annual(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("100.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2027, 2, 10))
+
+
+# Criterion 12
+
+
+@pytest.mark.parametrize("pending", [("basic", None), ("pro", Interval.ANNUAL), ("basic", Interval.ANNUAL)])
+@pytest.mark.parametrize("current_interval_arg", [None, Interval.MONTHLY])
+def test_requesting_current_plan_cancels_pending_change(
+    service, store, clock, renew_on, pending, current_interval_arg
+):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, *pending)
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "pro", current_interval_arg) is None
+    assert_nothing_changed_now(store, sub, invoice_count=1)
+
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("30.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2026, 3, 10))
+
+
+@pytest.mark.parametrize("current_interval_arg", [None, Interval.MONTHLY])
+def test_requesting_current_plan_with_nothing_pending_is_rejected(service, clock, current_interval_arg):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro", current_interval_arg)
+
+
+def test_current_plan_request_after_cancelling_pending_is_rejected(service, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "pro")  # cancels the pending change
+
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+
+
+# Criterion 13
+
+
+def test_second_downgrade_replaces_the_first(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "premium")
+    clock.move_to(date(2026, 1, 20))
+    assert service.change_plan(sub.id, "pro") is None
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "basic") is None
+
+    [renewal] = renew_on(date(2026, 2, 10))
+
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_interval_switch_replaces_pending_downgrade(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "premium")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)
+
+    [renewal] = renew_on(date(2026, 2, 10))
+
+    assert renewal.total == Decimal("500.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.ANNUAL)
+
+
+# Criterion 18
+
+
+def test_overdue_catch_up_applies_pending_change_at_first_renewal(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")  # [2026-01-10, 2026-02-10)
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+
+    issued = renew_on(date(2026, 4, 15))  # renewals due 02-10, 03-10, 04-10
+
+    assert [inv.issued_on for inv in issued] == [date(2026, 2, 10), date(2026, 3, 10), date(2026, 4, 10)]
+    assert [inv.total for inv in issued] == [Decimal("10.00")] * 3
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 10), date(2026, 5, 10))
+
+
+def test_overdue_catch_up_with_pending_switch_to_annual_follows_new_period_length(
+    service, store, clock, renew_on
+):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+    # Monthly periods would make 02-10, 03-10 and 04-10 due; the first renewal
+    # already runs annual, so only one period is due.
+    issued = renew_on(date(2026, 4, 15))
+
+    assert [(inv.issued_on, inv.total) for inv in issued] == [(date(2026, 2, 10), Decimal("100.00"))]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2027, 2, 10))
+    assert renewed.status is SubscriptionStatus.ACTIVE
+
+
+def test_overdue_catch_up_with_pending_switch_to_monthly(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "premium", Interval.ANNUAL)  # [2026-01-10, 2027-01-10)
+    clock.move_to(date(2026, 7, 1))
+    service.change_plan(sub.id, "pro", Interval.MONTHLY)
+
+    issued = renew_on(date(2027, 3, 15))  # 2027-01-10, 02-10, 03-10 with monthly periods
+
+    assert [inv.issued_on for inv in issued] == [date(2027, 1, 10), date(2027, 2, 10), date(2027, 3, 10)]
+    assert [inv.total for inv in issued] == [Decimal("30.00")] * 3
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 3, 10), date(2027, 4, 10))

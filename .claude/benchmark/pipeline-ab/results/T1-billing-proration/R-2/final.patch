+"""SPEC.md acceptance criteria 1 (InvalidPlanChange) and 16 (rejections change nothing)."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+import billing
+import billing.errors as errors
+from billing.plans import Interval
+
+
+# Criterion 1
+
+
+def test_invalid_plan_change_is_a_billing_error():
+    assert issubclass(errors.InvalidPlanChange, errors.BillingError)
+
+
+def test_invalid_plan_change_is_exported_from_package():
+    assert billing.InvalidPlanChange is errors.InvalidPlanChange
+    assert "InvalidPlanChange" in billing.__all__
+
+
+# Criterion 16
+
+
+def test_unknown_subscription_is_rejected(service, store, snapshot):
+    service.subscribe("cus_1", "pro")
+    before = snapshot()
+
+    with pytest.raises(errors.SubscriptionNotFound):
+        service.change_plan("sub_missing", "premium")
+
+    assert snapshot() == before
+
+
+def test_canceled_subscription_is_rejected(service, clock, snapshot):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    service.cancel(sub.id)
+    clock.move_to(date(2026, 1, 25))
+    before = snapshot()
+
+    with pytest.raises(errors.SubscriptionNotActive):
+        service.change_plan(sub.id, "premium")
+
+    assert snapshot() == before
+
+
+def test_canceled_trial_is_rejected(service, clock, snapshot):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    service.cancel(sub.id)
+    before = snapshot()
+
+    with pytest.raises(errors.SubscriptionNotActive):
+        service.change_plan(sub.id, "basic")
+
+    assert snapshot() == before
+
+
+@pytest.fixture
+def pro_with_basic_pending(service, clock):
+    """Pro monthly [2026-01-10, 2026-02-10) with a pending downgrade to Basic."""
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    assert service.change_plan(sub.id, "basic") is None
+    clock.move_to(date(2026, 1, 25))
+    return sub
+
+
+def assert_basic_still_pending(store, renew_on, sub):
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+@pytest.mark.parametrize("interval", [None, Interval.ANNUAL])
+def test_unknown_plan_is_rejected(service, store, renew_on, snapshot, pro_with_basic_pending, interval):
+    sub = pro_with_basic_pending
+    before = snapshot()
+
+    with pytest.raises(errors.PlanNotFound):
+        service.change_plan(sub.id, "gold", interval)
+
+    assert snapshot() == before
+    assert_basic_still_pending(store, renew_on, sub)
+
+
+@pytest.mark.parametrize(
+    "plan_code, interval",
+    [("premium", None), ("premium", Interval.ANNUAL), ("team", None)],
+    ids=["retired-upgrade", "retired-upgrade+interval", "retired-downgrade"],
+)
+def test_retired_plan_other_than_current_is_rejected(
+    service, store, renew_on, snapshot, pro_with_basic_pending, plan_code, interval
+):
+    sub = pro_with_basic_pending
+    store.retire_plan(plan_code)
+    before = snapshot()
+
+    with pytest.raises(errors.PlanNotAvailable):
+        service.change_plan(sub.id, plan_code, interval)
+
+    assert snapshot() == before
+    assert_basic_still_pending(store, renew_on, sub)
+
+
+def test_retired_plan_rejected_on_trial(service, store, clock, snapshot):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    store.retire_plan("premium")
+    clock.move_to(date(2026, 1, 17))
+    before = snapshot()
+
+    with pytest.raises(errors.PlanNotAvailable):
+        service.change_plan(sub.id, "premium")
+
+    assert snapshot() == before
+
+
+@pytest.mark.parametrize("interval", [None, Interval.MONTHLY])
+def test_current_plan_and_interval_with_nothing_pending_is_rejected(service, clock, snapshot, interval):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    before = snapshot()
+
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro", interval)
+
+    assert snapshot() == before
+
+
+@pytest.mark.parametrize(
+    "plan_code, interval",
+    [("premium", None), ("basic", None), ("pro", Interval.ANNUAL), ("pro", None)],
+    ids=["upgrade", "downgrade", "interval", "current"],
+)
+@pytest.mark.parametrize("change_day", [date(2026, 2, 10), date(2026, 2, 20)], ids=["on-period-end", "after"])
+def test_overdue_subscription_is_rejected(service, store, clock, snapshot, plan_code, interval, change_day):
+    sub = service.subscribe("cus_1", "pro")  # period_end 2026-02-10, renewals not run
+    clock.move_to(change_day)
+    before = snapshot()
+
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, plan_code, interval)
+
+    assert snapshot() == before
+
+
+def test_overdue_rejection_keeps_pending_change(service, store, clock, renew_on, snapshot, pro_with_basic_pending):
+    sub = pro_with_basic_pending
+    clock.move_to(date(2026, 2, 10))
+    before = snapshot()
+
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "premium")
+
+    assert snapshot() == before
+    assert_basic_still_pending(store, renew_on, sub)
+
+
+def test_overdue_trial_is_rejected(service, clock, snapshot):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)  # trial ends 2026-01-24
+    clock.move_to(date(2026, 1, 24))
+    before = snapshot()
+
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "premium")
+
+    assert snapshot() == before

@@ -0,0 +1,69 @@
+"""Fixtures for the acceptance tests of SPEC.md (mid-cycle plan changes).
+
+Expected values in these tests come from the spec's formulas, not from the
+implementation. Every scenario is driven through the public interface only:
+``BillingService`` (subscribe / renew_due / cancel / change_plan), the store's
+public methods and ``FixedClock``.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.clock import FixedClock
+from billing.plans import Plan
+from billing.service import BillingService
+from billing.store import InMemoryStore
+
+
+@pytest.fixture
+def clock() -> FixedClock:
+    # Most scenarios start a period on 2026-01-10: [2026-01-10, 2026-02-10) is 31 days.
+    return FixedClock(date(2026, 1, 10))
+
+
+@pytest.fixture
+def store() -> InMemoryStore:
+    store = InMemoryStore()
+    store.add_plan(Plan("basic", "Basic", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("pro", "Pro", Decimal("30.00"), Decimal("300.00")))
+    store.add_plan(Plan("premium", "Premium", Decimal("50.00"), Decimal("500.00")))
+    # Higher monthly price than Pro but lower annual price: still an upgrade (criterion 6).
+    store.add_plan(Plan("flex", "Flex", Decimal("40.00"), Decimal("250.00")))
+    # Higher monthly price than Pro, same annual price: zero-total proration on annual.
+    store.add_plan(Plan("level", "Level", Decimal("40.00"), Decimal("300.00")))
+    # Same monthly price as Pro, higher annual price: a downgrade (criterion 8).
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("320.00")))
+    # Upgrade from Basic whose prorated charge lands on a half cent.
+    store.add_plan(Plan("plus", "Plus", Decimal("12.33"), Decimal("120.00")))
+    return store
+
+
+@pytest.fixture
+def service(store: InMemoryStore, clock: FixedClock) -> BillingService:
+    return BillingService(store, clock)
+
+
+@pytest.fixture
+def renew_on(service: BillingService, clock: FixedClock):
+    """Move the clock to ``day`` and run renewals; return the invoices issued."""
+
+    def run(day: date):
+        clock.move_to(day)
+        return service.renew_due()
+
+    return run
+
+
+@pytest.fixture
+def snapshot(store: InMemoryStore):
+    """Everything a rejected request must leave untouched: subscriptions and invoices."""
+
+    def take():
+        return (
+            {sub.id: sub for sub in store.subscriptions()},
+            {sub.id: list(store.invoices_for(sub.id)) for sub in store.subscriptions()},
+        )
+
+    return take

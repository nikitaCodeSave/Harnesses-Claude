+"""SPEC.md acceptance criteria 15 (trials) and 17 (retired plans)."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+
+# Criterion 15
+
+TRIAL_CHANGES = [
+    pytest.param("premium", None, "premium", Interval.MONTHLY, Decimal("50.00"), date(2026, 2, 24), id="upgrade"),
+    pytest.param("basic", None, "basic", Interval.MONTHLY, Decimal("10.00"), date(2026, 2, 24), id="downgrade"),
+    pytest.param("pro", Interval.ANNUAL, "pro", Interval.ANNUAL, Decimal("300.00"), date(2027, 1, 24), id="interval"),
+    pytest.param(
+        "premium", Interval.ANNUAL, "premium", Interval.ANNUAL, Decimal("500.00"), date(2027, 1, 24),
+        id="upgrade+interval",
+    ),
+    pytest.param(
+        "basic", Interval.ANNUAL, "basic", Interval.ANNUAL, Decimal("100.00"), date(2027, 1, 24),
+        id="downgrade+interval",
+    ),
+]
+
+
+@pytest.mark.parametrize("plan_code, interval, want_plan, want_interval, price, paid_end", TRIAL_CHANGES)
+def test_trial_change_applies_immediately_without_billing(
+    service, store, clock, plan_code, interval, want_plan, want_interval, price, paid_end
+):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)  # trial [2026-01-10, 2026-01-24)
+    clock.move_to(date(2026, 1, 17))
+
+    assert service.change_plan(sub.id, plan_code, interval) is None
+
+    assert store.invoices_for(sub.id) == []
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval) == (want_plan, want_interval)
+    assert now.period_end == date(2026, 1, 24)
+    assert now.period_start == date(2026, 1, 10)
+
+
+@pytest.mark.parametrize("plan_code, interval, want_plan, want_interval, price, paid_end", TRIAL_CHANGES)
+def test_trial_end_bills_full_price_of_new_plan_and_interval(
+    service, store, clock, renew_on, plan_code, interval, want_plan, want_interval, price, paid_end
+):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 17))
+    service.change_plan(sub.id, plan_code, interval)
+
+    [first_paid] = renew_on(date(2026, 1, 24))
+
+    assert (first_paid.issued_on, first_paid.total) == (date(2026, 1, 24), price)
+    paid = store.get_subscription(sub.id)
+    assert (paid.plan_code, paid.interval, paid.status) == (want_plan, want_interval, SubscriptionStatus.ACTIVE)
+    assert (paid.period_start, paid.period_end) == (date(2026, 1, 24), paid_end)
+
+
+def test_trial_change_leaves_nothing_pending(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 17))
+    service.change_plan(sub.id, "premium")
+    renew_on(date(2026, 1, 24))
+
+    [second_paid] = renew_on(date(2026, 2, 24))
+
+    assert second_paid.total == Decimal("50.00")
+    assert store.get_subscription(sub.id).plan_code == "premium"
+
+
+def test_trial_change_replaces_earlier_trial_change(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 17))
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    service.change_plan(sub.id, "premium")  # interval None keeps the (now annual) interval
+
+    assert store.invoices_for(sub.id) == []
+    [first_paid] = renew_on(date(2026, 1, 24))
+    assert first_paid.total == Decimal("500.00")
+
+
+# Criterion 17
+
+
+def test_retired_plan_customer_can_switch_interval_on_it(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    store.retire_plan("pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert len(store.invoices_for(sub.id)) == 1
+
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("300.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2027, 2, 10))
+
+
+def test_retired_plan_customer_can_upgrade_to_active_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    store.retire_plan("pro")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert [line.amount for line in invoice.lines] == [Decimal("-15.48"), Decimal("25.81")]
+    assert store.invoices_for(sub.id)[-1] == invoice
+    assert store.get_subscription(sub.id).plan_code == "premium"
+
+
+def test_retired_plan_customer_can_downgrade_to_active_plan(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    store.retire_plan("pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic") is None
+    assert len(store.invoices_for(sub.id)) == 1
+
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_retired_plan_customer_can_cancel_pending_change_by_requesting_it(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    store.retire_plan("pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+
+    # Pro is retired but it is the current plan, so this is allowed and cancels the pending change.
+    assert service.change_plan(sub.id, "pro") is None
+
+    [renewal] = renew_on(date(2026, 2, 10))
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).plan_code == "pro"

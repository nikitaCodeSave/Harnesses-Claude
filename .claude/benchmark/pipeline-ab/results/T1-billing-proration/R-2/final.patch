+"""SPEC.md acceptance criteria 2-6, 10 and 14: upgrades are prorated and applied now."""
+
+from datetime import date
+from decimal import Decimal
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+# Criterion 2
+
+
+def test_upgrade_issues_proration_invoice_with_spec_amounts(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")  # [2026-01-10, 2026-02-10), 31 days
+    clock.move_to(date(2026, 1, 25))  # 16 remaining days
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert invoice is not None
+    assert invoice.issued_on == date(2026, 1, 25)
+    assert invoice.subscription_id == sub.id
+    assert invoice.customer_id == "cus_1"
+    # -round(30.00 * 16 / 31) = -15.48 ; +round(50.00 * 16 / 31) = +25.81
+    assert amounts(invoice) == [Decimal("-15.48"), Decimal("25.81")]
+    # Sum of the rounded lines, not round(20.00 * 16 / 31) = 10.32.
+    assert invoice.total == Decimal("10.33")
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_upgrade_invoice_is_recorded_once_after_the_first_period_invoice(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    invoices = store.invoices_for(sub.id)
+    assert len(invoices) == 2
+    assert invoices[0].total == Decimal("30.00")
+    assert invoices[1] == invoice
+
+
+def test_upgrade_rounds_each_line_half_up_to_cents(service, clock):
+    clock.move_to(date(2026, 4, 1))
+    sub = service.subscribe("cus_1", "basic")  # [2026-04-01, 2026-05-01), 30 days
+    clock.move_to(date(2026, 4, 16))  # 15 remaining days
+
+    invoice = service.change_plan(sub.id, "plus")
+
+    # -10.00 * 15 / 30 = -5.00 ; 12.33 * 15 / 30 = 6.165 -> 6.17 (half up, not half even)
+    assert amounts(invoice) == [Decimal("-5.00"), Decimal("6.17")]
+    assert invoice.total == Decimal("1.17")
+
+
+# Criterion 3
+
+
+def test_upgrade_switches_plan_now_and_keeps_period_interval_status(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    service.change_plan(sub.id, "premium")
+
+    after = store.get_subscription(sub.id)
+    assert after.plan_code == "premium"
+    assert after.period_start == sub.period_start == date(2026, 1, 10)
+    assert after.period_end == sub.period_end == date(2026, 2, 10)
+    assert after.interval is Interval.MONTHLY
+    assert after.status is SubscriptionStatus.ACTIVE
+
+
+def test_after_upgrade_next_renewal_bills_new_plan_in_full(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "premium")
+
+    [renewal] = renew_on(date(2026, 2, 10))
+
+    assert renewal.issued_on == date(2026, 2, 10)
+    assert renewal.total == Decimal("50.00")
+    renewed = store.get_subscription(sub.id)
+    assert renewed.plan_code == "premium"
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_after_annual_upgrade_next_renewal_bills_new_annual_price(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 1))
+    service.change_plan(sub.id, "premium")
+
+    [renewal] = renew_on(date(2027, 1, 10))
+
+    assert renewal.total == Decimal("500.00")
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+
+# Criterion 4
+
+
+def test_upgrade_on_first_day_of_period_credits_and_charges_full_prices(service, store):
+    sub = service.subscribe("cus_1", "pro")  # change date == period_start
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-30.00"), Decimal("50.00")]
+    assert invoice.total == Decimal("20.00")
+    assert invoice.issued_on == date(2026, 1, 10)
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+# Criterion 5
+
+
+def test_annual_upgrade_uses_annual_prices_over_365_day_period(service, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)  # [2026-01-10, 2027-01-10), 365 days
+    clock.move_to(date(2026, 7, 1))  # 193 remaining days
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    # -round(300.00 * 193 / 365) = -158.63 ; +round(500.00 * 193 / 365) = +264.38
+    assert amounts(invoice) == [Decimal("-158.63"), Decimal("264.38")]
+    assert invoice.total == Decimal("105.75")
+    assert invoice.issued_on == date(2026, 7, 1)
+
+
+def test_annual_upgrade_divides_by_366_in_a_leap_period(service, clock):
+    clock.move_to(date(2027, 6, 1))
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)  # [2027-06-01, 2028-06-01), 366 days
+    clock.move_to(date(2027, 12, 1))  # 183 remaining days
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    # -round(300.00 * 183 / 366) = -150.00 ; +round(500.00 * 183 / 366) = +250.00
+    # (dividing by 365 would give -150.41 / +250.68)
+    assert amounts(invoice) == [Decimal("-150.00"), Decimal("250.00")]
+    assert invoice.total == Decimal("100.00")
+
+
+# Criterion 6
+
+
+def test_annual_upgrade_to_plan_with_lower_annual_price_has_negative_total(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)  # 365-day period
+    clock.move_to(date(2026, 7, 1))  # 193 remaining days
+
+    invoice = service.change_plan(sub.id, "flex")  # monthly 40 > 30, annual 250 < 300
+
+    assert invoice is not None
+    # -round(300.00 * 193 / 365) = -158.63 ; +round(250.00 * 193 / 365) = +132.19
+    assert amounts(invoice) == [Decimal("-158.63"), Decimal("132.19")]
+    assert invoice.total == Decimal("-26.44")
+    assert store.invoices_for(sub.id)[-1] == invoice
+    assert store.get_subscription(sub.id).plan_code == "flex"
+
+
+def test_zero_total_upgrade_return_value_matches_what_was_recorded(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 1))
+    before = list(store.invoices_for(sub.id))
+
+    result = service.change_plan(sub.id, "level")  # monthly 40 > 30, annual 300 == 300
+
+    after = store.invoices_for(sub.id)
+    if result is None:
+        assert after == before
+    else:
+        assert after == [*before, result]
+        assert amounts(result) == [Decimal("-158.63"), Decimal("158.63")]
+        assert result.total == Decimal("0.00")
+    assert store.get_subscription(sub.id).plan_code == "level"
+
+
+# Criterion 10
+
+
+def test_upgrade_with_interval_switch_prorates_at_current_interval_prices(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")  # monthly, [2026-01-10, 2026-02-10)
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "premium", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-15.48"), Decimal("25.81")]
+    assert invoice.total == Decimal("10.33")
+    assert store.invoices_for(sub.id)[-1] == invoice
+    now = store.get_subscription(sub.id)
+    assert now.plan_code == "premium"
+    assert now.interval is Interval.MONTHLY
+    assert (now.period_start, now.period_end) == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+def test_upgrade_with_interval_switch_starts_new_interval_at_next_renewal(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)
+
+    [renewal] = renew_on(date(2026, 2, 10))
+
+    assert renewal.total == Decimal("500.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 10), date(2027, 2, 10))
+
+
+def test_upgrade_with_switch_to_monthly_on_annual_subscription(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 1))
+
+    invoice = service.change_plan(sub.id, "premium", Interval.MONTHLY)
+
+    # Prorated at the current (annual) prices.
+    assert amounts(invoice) == [Decimal("-158.63"), Decimal("264.38")]
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+    [renewal] = renew_on(date(2027, 1, 10))
+    assert renewal.total == Decimal("50.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 1, 10), date(2027, 2, 10))
+
+
+# Criterion 14
+
+
+def test_upgrade_with_pending_downgrade_credits_current_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    assert service.change_plan(sub.id, "basic") is None  # Basic pending
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    # Credits Pro (-15.48), not Basic (-5.16); charges Premium (+25.81).
+    assert amounts(invoice) == [Decimal("-15.48"), Decimal("25.81")]
+    assert invoice.total == Decimal("10.33")
+    assert store.get_subscription(sub.id).plan_code == "premium"
+
+
+def test_upgrade_discards_pending_downgrade(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "premium")
+
+    [renewal] = renew_on(date(2026, 2, 10))
+
+    assert renewal.total == Decimal("50.00")
+    assert store.get_subscription(sub.id).plan_code == "premium"
+
+
+def test_upgrade_with_interval_switch_replaces_pending_change(service, store, clock, renew_on):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)  # pending: Basic annual
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)  # pending: annual only
+
+    [renewal] = renew_on(date(2026, 2, 10))
+
+    assert renewal.total == Decimal("500.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.ANNUAL)

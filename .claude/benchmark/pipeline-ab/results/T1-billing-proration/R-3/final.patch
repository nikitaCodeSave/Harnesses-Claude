+"""Acceptance criteria 1-8: rejected requests."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing import errors
+from billing.errors import PlanNotAvailable, PlanNotFound, SubscriptionNotActive, SubscriptionNotFound
+from billing.plans import Interval
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+
+
+# 1
+
+
+def test_unknown_subscription_is_rejected(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_missing", "premium")
+
+
+# 2
+
+
+def test_canceled_subscription_is_rejected(service, start, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "premium")
+
+
+# 3
+
+
+def test_unknown_plan_is_rejected(service, start, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")
+
+
+# 4
+
+
+@pytest.mark.parametrize(
+    ("target", "interval"),
+    [
+        ("premium", None),  # upgrade
+        ("basic", None),  # downgrade
+        ("basic", Interval.ANNUAL),  # downgrade with interval switch
+        ("premium", Interval.ANNUAL),  # upgrade with interval switch
+    ],
+)
+def test_retired_target_plan_is_rejected(service, start, store, clock, target, interval):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    store.retire_plan(target)
+    clock.move_to(MAR_11)
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, target, interval)
+
+
+def test_retired_target_plan_is_rejected_during_trial(service, start, store):
+    sub = start("pro", Interval.MONTHLY, MAR_1, trial_days=14)
+    store.retire_plan("premium")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "premium")
+
+
+def test_upgrading_off_a_retired_plan_is_allowed(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    store.retire_plan("pro")
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "premium")
+    assert invoice is not None
+    assert invoice.total == Decimal("30.49")
+    assert store.get_subscription(sub.id).plan_code == "premium"
+
+
+def test_downgrading_off_a_retired_plan_is_allowed(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    store.retire_plan("pro")
+    clock.move_to(MAR_11)
+    assert service.change_plan(sub.id, "basic") is None
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+@pytest.mark.parametrize(
+    ("current", "target"),
+    [(Interval.MONTHLY, Interval.ANNUAL), (Interval.ANNUAL, Interval.MONTHLY)],
+)
+def test_interval_switch_on_a_retired_plan_is_rejected(service, start, store, clock, current, target):
+    sub = start("pro", current, MAR_1)
+    store.retire_plan("pro")
+    clock.move_to(MAR_11)
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "pro", target)
+
+
+def test_cancelling_a_pending_change_on_a_retired_plan_is_allowed(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    store.retire_plan("pro")
+    assert service.change_plan(sub.id, "pro") is None
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+
+def test_same_target_on_a_retired_plan_without_pending_change_is_invalid_not_unavailable(
+    service, start, store, clock
+):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    store.retire_plan("pro")
+    clock.move_to(MAR_11)
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+
+
+# 5
+
+
+@pytest.mark.parametrize(
+    ("target", "interval"),
+    [
+        ("premium", None),  # upgrade
+        ("basic", None),  # downgrade
+        ("pro", Interval.ANNUAL),  # interval switch
+        ("premium", Interval.ANNUAL),  # upgrade with interval switch
+    ],
+)
+@pytest.mark.parametrize("today", [APR_1, date(2026, 4, 20)], ids=["on-period-end", "after-period-end"])
+def test_overdue_active_subscription_is_rejected(service, start, clock, target, interval, today):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(today)
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, target, interval)
+
+
+@pytest.mark.parametrize(
+    ("target", "interval"),
+    [("premium", None), ("basic", None), ("pro", Interval.ANNUAL)],
+)
+@pytest.mark.parametrize("today", [date(2026, 3, 15), date(2026, 3, 20)], ids=["on-trial-end", "after-trial-end"])
+def test_overdue_trial_is_rejected(service, start, clock, target, interval, today):

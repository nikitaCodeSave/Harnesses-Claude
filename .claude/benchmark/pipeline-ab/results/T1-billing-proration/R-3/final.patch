+
+
+# 7
+
+
+def test_unknown_subscription_beats_unknown_plan(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_missing", "gold")
+
+
+def test_canceled_subscription_beats_unknown_plan(service, start, clock):

+"""Acceptance criteria 29-31: persistence, exports, unchanged existing behaviour."""
+
+from datetime import date
+from decimal import Decimal
+
+import billing
+from billing import errors
+from billing.errors import BillingError
+from billing.plans import Interval
+from billing.service import BillingService
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+
+
+# 29
+
+
+def test_new_service_over_same_store_applies_pending_change(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+    other = BillingService(store, clock)
+    clock.move_to(APR_1)
+    [renewal] = other.renew_due()
+    assert renewal.total == Decimal("100.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+
+
+def test_new_service_over_same_store_sees_pending_change(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+
+    other = BillingService(store, clock)
+    # A pending change exists, so the same-target request cancels it (9) instead of failing (10).
+    assert other.change_plan(sub.id, "pro") is None
+    clock.move_to(APR_1)
+    [renewal] = BillingService(store, clock).renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+# 30
+
+
+def test_invalid_plan_change_is_exported_from_package():
+    assert billing.InvalidPlanChange is errors.InvalidPlanChange
+    assert "InvalidPlanChange" in billing.__all__
+    assert issubclass(billing.InvalidPlanChange, BillingError)
+
+
+# 31
+
+
+def test_subscription_without_pending_change_renews_as_before(service, start, store, clock):
+    plain = start("pro", Interval.MONTHLY, MAR_1, customer_id="cus_plain")
+    changing = start("pro", Interval.MONTHLY, MAR_1, customer_id="cus_changing")
+    clock.move_to(MAR_11)
+    service.change_plan(changing.id, "basic", Interval.ANNUAL)
+    clock.move_to(APR_1)
+    service.renew_due()
+    [first, renewal] = store.invoices_for(plain.id)
+    assert (renewal.issued_on, renewal.total) == (APR_1, Decimal("30.00"))
+    renewed = store.get_subscription(plain.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (APR_1, date(2026, 5, 1))
+
+
+def test_subscribe_and_cancel_behave_as_before_alongside_pending_changes(service, start, store, clock):
+    changing = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(changing.id, "basic")
+    fresh = service.subscribe("cus_2", "premium", Interval.ANNUAL)
+    assert (fresh.plan_code, fresh.period_start, fresh.period_end) == ("premium", MAR_11, date(2027, 3, 11))
+    [invoice] = store.invoices_for(fresh.id)
+    assert (invoice.issued_on, invoice.total) == (MAR_11, Decimal("750.00"))
+    canceled = service.cancel(fresh.id)
+    assert canceled.canceled_on == MAR_11
+    clock.move_to(date(2027, 4, 1))
+    assert all(inv.subscription_id != fresh.id for inv in service.renew_due())

+"""Acceptance criteria 25-28: renewal with a pending change."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing import errors
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+
+
+# 25
+
+
+def test_renewal_moves_to_pending_plan_and_bills_full_price(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("100.00")
+    assert renewal.issued_on == APR_1
+    assert renewal.subscription_id == sub.id
+    assert renewal.customer_id == sub.customer_id
+    assert store.invoices_for(sub.id)[-1] == renewal
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.status) == ("basic", Interval.ANNUAL, SubscriptionStatus.ACTIVE)
+    assert (renewed.period_start, renewed.period_end) == (APR_1, date(2027, 4, 1))
+
+
+def test_renewal_from_annual_to_monthly_has_monthly_length(service, start, store, clock):
+    sub = start("pro", Interval.ANNUAL, date(2026, 1, 31))
+    clock.move_to(date(2026, 6, 1))
+    service.change_plan(sub.id, "basic", Interval.MONTHLY)
+    clock.move_to(date(2027, 1, 31))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+    assert renewal.issued_on == date(2027, 1, 31)
+    renewed = store.get_subscription(sub.id)
+    # Month arithmetic clamps: Jan 31 + 1 month is Feb 28.
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 1, 31), date(2027, 2, 28))
+
+
+def test_pending_change_is_cleared_after_renewal(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    clock.move_to(APR_1)
+    service.renew_due()
+    assert service.renew_due() == []
+    # Nothing pending any more, so requesting the current plan is invalid (10).
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "basic")
+
+
+def test_pending_interval_switch_is_cleared_after_renewal(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(APR_1)
+    service.renew_due()
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(date(2027, 4, 1))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("300.00")
+    assert store.get_subscription(sub.id).period_end == date(2028, 4, 1)
+
+
+def test_renewal_after_upgrade_with_switch_then_new_upgrade_is_prorated_on_new_interval(
+    service, start, store, clock
+):
+    # After the pending Pro annual takes effect, a later upgrade prorates at annual prices.
+    sub = start("basic", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(APR_1)
+    service.renew_due()
+    clock.move_to(date(2026, 10, 1))
+    invoice = service.change_plan(sub.id, "premium")
+    # Period 2026-04-01 to 2027-04-01 (365 days), 182 days remain.
+    # 300 x 182/365 = 149.589..., 750 x 182/365 = 373.972...
+    assert sorted(line.amount for line in invoice.lines) == [Decimal("-149.59"), Decimal("373.97")]
+    assert invoice.total == Decimal("224.38")
+
+
+# 26
+
+
+def test_catch_up_applies_pending_change_to_first_missed_period(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 6, 15))
+    renewals = service.renew_due()
+    assert [(inv.issued_on, inv.total) for inv in renewals] == [
+        (date(2026, 4, 1), Decimal("10.00")),
+        (date(2026, 5, 1), Decimal("10.00")),
+        (date(2026, 6, 1), Decimal("10.00")),
+    ]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 6, 1), date(2026, 7, 1))
+
+
+def test_catch_up_with_pending_interval_switch_uses_new_interval_for_later_periods(
+    service, start, store, clock
+):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    clock.move_to(date(2027, 5, 1))
+    renewals = service.renew_due()
+    assert [(inv.issued_on, inv.total) for inv in renewals] == [
+        (date(2026, 4, 1), Decimal("100.00")),
+        (date(2027, 4, 1), Decimal("100.00")),
+    ]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 4, 1), date(2028, 4, 1))
+
+
+def test_catch_up_from_annual_to_monthly(service, start, store, clock):
+    sub = start("pro", Interval.ANNUAL, date(2026, 1, 15))
+    clock.move_to(date(2026, 7, 15))
+    service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    clock.move_to(date(2027, 3, 20))
+    renewals = service.renew_due()
+    assert [(inv.issued_on, inv.total) for inv in renewals] == [
+        (date(2027, 1, 15), Decimal("30.00")),
+        (date(2027, 2, 15), Decimal("30.00")),
+        (date(2027, 3, 15), Decimal("30.00")),
+    ]
+
+
+# 27
+
+
+def test_pending_change_to_plan_retired_later_is_honoured(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    store.retire_plan("basic")
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("100.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert renewed.period_end == date(2027, 4, 1)
+
+
+def test_pending_interval_switch_on_plan_retired_later_is_honoured(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    store.retire_plan("pro")
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("300.00")
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+
+# 28
+
+
+def test_canceled_subscription_pending_change_never_takes_effect(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    service.cancel(sub.id)
+    clock.move_to(date(2026, 6, 1))
+    assert service.renew_due() == []
+    canceled = store.get_subscription(sub.id)
+    assert canceled.status is SubscriptionStatus.CANCELED
+    assert (canceled.plan_code, canceled.interval) == ("pro", Interval.MONTHLY)
+    assert (canceled.period_start, canceled.period_end) == (MAR_1, APR_1)
+    assert len(store.invoices_for(sub.id)) == 1

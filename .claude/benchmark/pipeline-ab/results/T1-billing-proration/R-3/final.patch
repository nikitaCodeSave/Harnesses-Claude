@@ -0,0 +1,195 @@
+"""Acceptance criteria 21-24: downgrades and interval switches of active subscriptions."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+JAN_15, JUL_15, NEXT_JAN_15 = date(2026, 1, 15), date(2026, 7, 15), date(2027, 1, 15)
+
+
+# 21
+
+
+@pytest.mark.parametrize(
+    ("target", "interval", "renewal_total", "renewed_end"),
+    [
+        pytest.param("basic", None, Decimal("10.00"), date(2026, 5, 1), id="downgrade"),
+        pytest.param("pro_alt", None, Decimal("30.00"), date(2026, 5, 1), id="downgrade-equal-price"),
+        pytest.param("pro", Interval.ANNUAL, Decimal("300.00"), date(2027, 4, 1), id="interval-switch"),
+        pytest.param("basic", Interval.ANNUAL, Decimal("100.00"), date(2027, 4, 1), id="downgrade-and-switch"),
+    ],
+)
+def test_deferred_change_bills_nothing_and_applies_at_renewal(
+    service, start, store, clock, target, interval, renewal_total, renewed_end
+):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    before = store.get_subscription(sub.id)
+    invoices_before = list(store.invoices_for(sub.id))
+
+    assert service.change_plan(sub.id, target, interval) is None
+
+    assert store.invoices_for(sub.id) == invoices_before
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.interval) == ("pro", Interval.MONTHLY)
+    assert (after.period_start, after.period_end, after.status) == (
+        before.period_start,
+        before.period_end,
+        before.status,
+    )
+
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == renewal_total
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == (target, interval or Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (APR_1, renewed_end)
+
+
+def test_worked_example_downgrade(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    assert service.change_plan(sub.id, "basic") is None
+    assert len(store.invoices_for(sub.id)) == 1
+    clock.move_to(date(2026, 3, 31))
+    assert store.get_subscription(sub.id).plan_code == "pro"
+    assert service.renew_due() == []
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+    assert renewal.issued_on == APR_1
+
+
+# 22
+
+
+def test_annual_to_monthly_switch_is_deferred_without_refund(service, start, store, clock):
+    sub = start("pro", Interval.ANNUAL, JAN_15)
+    clock.move_to(JUL_15)
+    invoices_before = list(store.invoices_for(sub.id))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+
+    assert store.invoices_for(sub.id) == invoices_before
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.interval, after.period_start, after.period_end) == (
+        "pro",
+        Interval.ANNUAL,
+        JAN_15,
+        NEXT_JAN_15,
+    )
+
+    clock.move_to(NEXT_JAN_15)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert renewal.issued_on == NEXT_JAN_15
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (NEXT_JAN_15, date(2027, 2, 15))
+    assert all(line.amount >= 0 for inv in store.invoices_for(sub.id) for line in inv.lines)
+
+
+def test_annual_to_monthly_downgrade_is_deferred(service, start, store, clock):
+    sub = start("pro", Interval.ANNUAL, JAN_15)
+    clock.move_to(JUL_15)
+    assert service.change_plan(sub.id, "basic", Interval.MONTHLY) is None
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+    clock.move_to(NEXT_JAN_15)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+
+
+def test_monthly_to_annual_switch_is_deferred(service, start, store, clock):
+    sub = start("basic", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+    assert store.get_subscription(sub.id).period_end == APR_1
+
+
+# 23
+
+
+def test_worked_example_upgrade_with_interval_switch(service, start, store, clock):
+    sub = start("basic", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert sorted(line.amount for line in invoice.lines) == [Decimal("-6.77"), Decimal("20.32")]
+    assert invoice.total == Decimal("13.55")
+
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval, now.period_end) == ("pro", Interval.MONTHLY, APR_1)
+
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("300.00")
+    assert renewal.issued_on == APR_1
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (APR_1, date(2027, 4, 1))
+
+
+def test_annual_upgrade_with_switch_to_monthly(service, start, store, clock):
+    sub = start("basic", Interval.ANNUAL, JAN_15)
+    clock.move_to(JUL_15)
+    invoice = service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    assert invoice.total == Decimal("100.82")
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval, now.period_end) == ("pro", Interval.ANNUAL, NEXT_JAN_15)
+    clock.move_to(NEXT_JAN_15)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert renewed.period_end == date(2027, 2, 15)
+
+
+# 24
+
+
+def test_new_request_replaces_pending_change(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("300.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+
+
+def test_request_states_full_target_and_does_not_merge_with_pending(service, start, store, clock):
+    # Pending: Basic annual. New request: Pro Alt (interval None = current monthly).
+    # The result must be Pro Alt monthly, not Pro Alt annual.
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    service.change_plan(sub.id, "pro_alt")
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro_alt", Interval.MONTHLY)
+    assert renewed.period_end == date(2026, 5, 1)
+
+
+def test_only_the_last_of_several_requests_is_pending(service, start, store, clock):
+    sub = start("premium", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    service.change_plan(sub.id, "pro")
+    assert len(store.invoices_for(sub.id)) == 1
+    clock.move_to(date(2026, 6, 1))
+    renewals = service.renew_due()
+    assert [inv.total for inv in renewals] == [Decimal("30.00")] * 3
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)

+
+def _assert_rejected_without_side_effects(service, store, sub_id, call, error):
+    before_sub = store.get_subscription(sub_id)
+    before_invoices = list(store.invoices_for(sub_id))
+    with pytest.raises(error):
+        call()
+    assert store.get_subscription(sub_id) == before_sub
+    assert store.invoices_for(sub_id) == before_invoices
+
+
+@pytest.mark.parametrize(
+    ("target", "interval", "error"),
+    [
+        ("gold", None, PlanNotFound),
+        ("premium-retired", None, PlanNotAvailable),
+        ("pro-retired", Interval.ANNUAL, PlanNotAvailable),
+    ],
+)
+def test_rejected_plan_request_keeps_pending_change(service, start, store, clock, target, interval, error):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")  # pending downgrade
+    if target.endswith("-retired"):
+        target = target.removesuffix("-retired")
+        store.retire_plan(target)
+    _assert_rejected_without_side_effects(
+        service, store, sub.id, lambda: service.change_plan(sub.id, target, interval), error
+    )
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+
+
+def test_rejected_negative_total_upgrade_keeps_plan_and_pending_change(service, start, store, clock):
+    sub = start("pro", Interval.ANNUAL, date(2026, 1, 15))
+    clock.move_to(date(2026, 7, 15))
+    service.change_plan(sub.id, "basic")  # pending downgrade to Basic annual
+    _assert_rejected_without_side_effects(
+        service, store, sub.id, lambda: service.change_plan(sub.id, "lopsided"), errors.InvalidPlanChange
+    )
+    clock.move_to(date(2027, 1, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("100.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+
+
+def test_rejected_overdue_request_keeps_pending_change(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    clock.move_to(APR_1)
+    _assert_rejected_without_side_effects(
+        service, store, sub.id, lambda: service.change_plan(sub.id, "premium"), errors.InvalidPlanChange
+    )
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_rejected_trial_request_changes_nothing(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1, trial_days=14)
+    store.retire_plan("premium")
+    _assert_rejected_without_side_effects(
+        service, store, sub.id, lambda: service.change_plan(sub.id, "premium"), PlanNotAvailable
+    )
+
+
+def test_rejected_canceled_request_changes_nothing(service, start, store, clock):

+"""Acceptance criteria 9-10: target equals current plan and interval."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing import errors
+from billing.plans import Interval
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+
+
+# 9
+
+
+@pytest.mark.parametrize(
+    ("pending_plan", "pending_interval"),
+    [("basic", None), ("pro", Interval.ANNUAL), ("basic", Interval.ANNUAL), ("pro_alt", None)],
+)
+def test_same_target_cancels_pending_change(service, start, store, clock, pending_plan, pending_interval):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    assert service.change_plan(sub.id, pending_plan, pending_interval) is None
+    invoices_before = list(store.invoices_for(sub.id))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert store.invoices_for(sub.id) == invoices_before
+
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert renewal.issued_on == APR_1
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (APR_1, date(2026, 5, 1))
+
+
+def test_same_target_with_implicit_interval_cancels_pending_interval_switch(service, start, store, clock):
+    # new_interval=None means the current interval (monthly), not the pending one (annual).
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert service.change_plan(sub.id, "pro") is None
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+
+
+def test_same_target_cancels_interval_switch_left_pending_by_upgrade(service, start, store, clock):
+    # Upgrade with interval switch: Pro monthly now on Premium monthly, Premium annual pending.
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    invoices_before = list(store.invoices_for(sub.id))
+    assert service.change_plan(sub.id, "premium", Interval.MONTHLY) is None
+    assert store.invoices_for(sub.id) == invoices_before
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("75.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.MONTHLY)
+
+
+def test_cancelling_pending_change_leaves_subscription_unchanged(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    before = store.get_subscription(sub.id)
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "pro")
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.interval, after.status) == ("pro", Interval.MONTHLY, before.status)
+    assert (after.period_start, after.period_end) == (before.period_start, before.period_end)
+
+
+# 10
+
+
+def test_same_target_without_pending_change_is_rejected(service, start, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro", Interval.MONTHLY)
+
+
+def test_same_annual_target_without_pending_change_is_rejected(service, start, clock):
+    sub = start("pro", Interval.ANNUAL, date(2026, 1, 15))
+    clock.move_to(date(2026, 7, 15))
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+
+def test_same_target_during_trial_is_rejected(service, start):
+    sub = start("pro", Interval.MONTHLY, MAR_1, trial_days=14)
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+
+
+def test_worked_example_cancelling_a_pending_change(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    assert service.change_plan(sub.id, "basic") is None
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    with pytest.raises(errors.InvalidPlanChange):
+        service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
diff --git a/tests/acceptance/test_change_plan_trial.py b/tests/acceptance/test_change_plan_trial.py
new file mode 100644
index 0000000..01f24aa
--- /dev/null
+++ b/tests/acceptance/test_change_plan_trial.py
@@ -0,0 +1,105 @@
+"""Acceptance criteria 11-13: trialing subscriptions."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+MAR_1, MAR_11, MAR_15 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 3, 15)
+
+CHANGES = [
+    pytest.param("premium", None, "premium", Interval.MONTHLY, id="upgrade"),
+    pytest.param("basic", None, "basic", Interval.MONTHLY, id="downgrade"),
+    pytest.param("pro_alt", None, "pro_alt", Interval.MONTHLY, id="downgrade-equal-price"),
+    pytest.param("pro", Interval.ANNUAL, "pro", Interval.ANNUAL, id="interval-switch"),
+    pytest.param("premium", Interval.ANNUAL, "premium", Interval.ANNUAL, id="upgrade-and-switch"),
+    pytest.param("basic", Interval.ANNUAL, "basic", Interval.ANNUAL, id="downgrade-and-switch"),
+]
+
+
+# 11
+
+
+@pytest.mark.parametrize(("target", "interval", "plan_after", "interval_after"), CHANGES)
+def test_trial_change_applies_immediately_without_invoice(
+    service, start, store, clock, target, interval, plan_after, interval_after
+):
+    sub = start("pro", Interval.MONTHLY, MAR_1, trial_days=14)
+    clock.move_to(MAR_11)
+    assert service.change_plan(sub.id, target, interval) is None
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == (plan_after, interval_after)
+    assert store.invoices_for(sub.id) == []
+
+
+def test_trial_change_from_annual_to_monthly_applies_immediately(service, start, store):
+    sub = start("pro", Interval.ANNUAL, MAR_1, trial_days=14)
+    assert service.change_plan(sub.id, "basic", Interval.MONTHLY) is None
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("basic", Interval.MONTHLY)
+    assert store.invoices_for(sub.id) == []
+
+
+def test_trial_change_keeps_interval_when_none_given(service, start, store):
+    sub = start("pro", Interval.ANNUAL, MAR_1, trial_days=14)
+    service.change_plan(sub.id, "premium")
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+
+# 12
+
+
+@pytest.mark.parametrize(("target", "interval", "plan_after", "interval_after"), CHANGES)
+def test_trial_change_keeps_trial_end_and_status(
+    service, start, store, clock, target, interval, plan_after, interval_after
+):
+    sub = start("pro", Interval.MONTHLY, MAR_1, trial_days=14)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, target, interval)
+    changed = store.get_subscription(sub.id)
+    assert changed.period_end == MAR_15
+    assert changed.status is SubscriptionStatus.TRIALING
+
+
+# 13
+
+
+@pytest.mark.parametrize(
+    ("target", "interval", "price", "paid_end"),
+    [
+        ("premium", None, Decimal("75.00"), date(2026, 4, 15)),
+        ("basic", None, Decimal("10.00"), date(2026, 4, 15)),
+        ("pro", Interval.ANNUAL, Decimal("300.00"), date(2027, 3, 15)),
+        ("premium", Interval.ANNUAL, Decimal("750.00"), date(2027, 3, 15)),
+        ("basic", Interval.ANNUAL, Decimal("100.00"), date(2027, 3, 15)),
+    ],
+)
+def test_trial_end_bills_full_price_of_plan_after_change(
+    service, start, store, clock, target, interval, price, paid_end
+):
+    sub = start("pro", Interval.MONTHLY, MAR_1, trial_days=14)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, target, interval)
+    clock.move_to(MAR_15)
+    [invoice] = service.renew_due()
+    assert invoice.total == price
+    assert invoice.issued_on == MAR_15
+    paid = store.get_subscription(sub.id)
+    assert paid.status is SubscriptionStatus.ACTIVE
+    assert (paid.period_start, paid.period_end) == (MAR_15, paid_end)
+
+
+def test_trial_end_bills_the_last_of_several_trial_changes(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1, trial_days=14)
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")  # keeps annual: the interval is annual by now
+    clock.move_to(MAR_15)
+    [invoice] = service.renew_due()
+    assert invoice.total == Decimal("100.00")
+    paid = store.get_subscription(sub.id)
+    assert (paid.plan_code, paid.interval) == ("basic", Interval.ANNUAL)
+    assert paid.period_end == date(2027, 3, 15)
diff --git a/tests/acceptance/test_change_plan_upgrades.py b/tests/acceptance/test_change_plan_upgrades.py
new file mode 100644
index 0000000..a025cf8
--- /dev/null
+++ b/tests/acceptance/test_change_plan_upgrades.py
@@ -0,0 +1,309 @@
+"""Acceptance criteria 14-20: upgrades of active subscriptions."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+JAN_15, JUL_15, NEXT_JAN_15 = date(2026, 1, 15), date(2026, 7, 15), date(2027, 1, 15)
+
+
+def _amounts(invoice):
+    return sorted(line.amount for line in invoice.lines)
+
+
+# 14
+
+
+def test_upgrade_applies_plan_immediately_without_restarting_period(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "premium")
+    upgraded = store.get_subscription(sub.id)
+    assert upgraded.plan_code == "premium"
+    assert upgraded.interval is Interval.MONTHLY
+    assert (upgraded.period_start, upgraded.period_end) == (MAR_1, APR_1)
+    assert upgraded.status is SubscriptionStatus.ACTIVE
+
+
+def test_annual_upgrade_keeps_annual_period(service, start, store, clock):
+    sub = start("basic", Interval.ANNUAL, JAN_15)
+    clock.move_to(JUL_15)
+    service.change_plan(sub.id, "pro")
+    upgraded = store.get_subscription(sub.id)
+    assert (upgraded.plan_code, upgraded.interval) == ("pro", Interval.ANNUAL)
+    assert (upgraded.period_start, upgraded.period_end) == (JAN_15, NEXT_JAN_15)
+
+
+def test_upgrade_with_interval_switch_keeps_current_interval_and_period(service, start, store, clock):
+    sub = start("basic", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    upgraded = store.get_subscription(sub.id)
+    assert (upgraded.plan_code, upgraded.interval) == ("pro", Interval.MONTHLY)
+    assert (upgraded.period_start, upgraded.period_end) == (MAR_1, APR_1)
+
+
+def test_upgrade_of_a_renewed_subscription_keeps_renewed_period(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(APR_1)
+    service.renew_due()
+    clock.move_to(date(2026, 4, 20))
+    service.change_plan(sub.id, "premium")
+    upgraded = store.get_subscription(sub.id)
+    assert (upgraded.period_start, upgraded.period_end) == (APR_1, date(2026, 5, 1))
+
+
+def test_higher_monthly_price_is_an_upgrade_even_with_lower_annual_price(service, start, store, clock):
+    # Monthly list prices decide: Lopsided (40/month) is an upgrade over Pro (30/month)
+    # even for a monthly customer.
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "lopsided")
+    assert invoice is not None
+    assert store.get_subscription(sub.id).plan_code == "lopsided"
+    # 30 x 21/31 = 20.322..., 40 x 21/31 = 27.096...
+    assert _amounts(invoice) == [Decimal("-20.32"), Decimal("27.10")]
+
+
+# 15
+
+
+def test_upgrade_records_and_returns_one_invoice(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    before = list(store.invoices_for(sub.id))
+    invoice = service.change_plan(sub.id, "premium")
+    after = store.invoices_for(sub.id)
+    assert after[: len(before)] == before
+    assert after[len(before) :] == [invoice]
+    assert invoice.issued_on == MAR_11
+    assert invoice.subscription_id == sub.id
+    assert invoice.customer_id == sub.customer_id
+
+
+def test_worked_example_monthly_upgrade(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "premium")
+    assert len(invoice.lines) == 2
+    assert _amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")
+    upgraded = store.get_subscription(sub.id)
+    assert (upgraded.period_start, upgraded.period_end) == (MAR_1, APR_1)
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("75.00")
+    assert renewal.issued_on == APR_1
+
+
+def test_worked_example_annual_upgrade(service, start, clock):
+    sub = start("basic", Interval.ANNUAL, JAN_15)
+    clock.move_to(JUL_15)
+    invoice = service.change_plan(sub.id, "pro")
+    assert invoice.issued_on == JUL_15
+    assert len(invoice.lines) == 2
+    assert _amounts(invoice) == [Decimal("-50.41"), Decimal("151.23")]
+    assert invoice.total == Decimal("100.82")
+
+
+def test_worked_example_upgrade_with_interval_switch_prorates_at_current_interval(service, start, clock):
+    sub = start("basic", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert invoice.issued_on == MAR_11
+    assert len(invoice.lines) == 2
+    assert _amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    assert invoice.total == Decimal("13.55")
+
+
+def test_annual_to_monthly_upgrade_prorates_at_annual_prices(service, start, clock):
+    sub = start("basic", Interval.ANNUAL, JAN_15)
+    clock.move_to(JUL_15)
+    invoice = service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    assert _amounts(invoice) == [Decimal("-50.41"), Decimal("151.23")]
+    assert invoice.total == Decimal("100.82")
+
+
+def test_upgrade_in_leap_year_annual_period_uses_366_period_days(service, start, clock):
+    # Period 2027-03-01 to 2028-03-01 is 366 days; 2028-02-01 leaves 29 days.
+    # 100 x 29/366 = 7.923..., 300 x 29/366 = 23.770...
+    sub = start("basic", Interval.ANNUAL, date(2027, 3, 1))
+    clock.move_to(date(2028, 2, 1))
+    invoice = service.change_plan(sub.id, "pro")
+    assert _amounts(invoice) == [Decimal("-7.92"), Decimal("23.77")]
+    assert invoice.total == Decimal("15.85")
+
+
+def test_upgrade_in_february_uses_28_period_days(service, start, clock):
+    # Period 2026-02-01 to 2026-03-01 is 28 days; 2026-02-15 leaves 14 days.
+    sub = start("pro", Interval.MONTHLY, date(2026, 2, 1))
+    clock.move_to(date(2026, 2, 15))
+    invoice = service.change_plan(sub.id, "premium")
+    assert _amounts(invoice) == [Decimal("-15.00"), Decimal("37.50")]
+    assert invoice.total == Decimal("22.50")
+
+
+def test_upgrade_on_last_day_of_period_prorates_one_day(service, start, clock):
+    # 30 x 1/31 = 0.967..., 75 x 1/31 = 2.419...
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(date(2026, 3, 31))
+    invoice = service.change_plan(sub.id, "premium")
+    assert _amounts(invoice) == [Decimal("-0.97"), Decimal("2.42")]
+    assert invoice.total == Decimal("1.45")
+
+
+# 16
+
+
+def test_lines_are_rounded_separately_not_the_net(service, start, clock):
+    # Net 45 x 21/31 = 30.48..., but the rounded lines sum to 30.49.
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "premium")
+    assert invoice.total == Decimal("30.49")
+    assert invoice.total == sum(line.amount for line in invoice.lines)
+
+
+def test_lines_do_not_use_a_rounded_daily_rate(service, start, clock):
+    # Rounded daily rates (0.97, 2.42) x 21 would give -20.37 and +50.82.
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "premium")
+    amounts = _amounts(invoice)
+    assert Decimal("-20.37") not in amounts
+    assert Decimal("50.82") not in amounts
+    assert amounts == [Decimal("-20.32"), Decimal("50.81")]
+
+
+def test_lines_round_half_up(service, start, clock):
+    # April 2026 has 30 days; 2026-04-16 leaves 15. 20.01 x 15/30 = 10.005 -> 10.01.
+    sub = start("basic", Interval.MONTHLY, APR_1)
+    clock.move_to(date(2026, 4, 16))
+    invoice = service.change_plan(sub.id, "plus")
+    assert _amounts(invoice) == [Decimal("-5.00"), Decimal("10.01")]
+    assert invoice.total == Decimal("5.01")
+
+
+def test_line_amounts_are_whole_cents(service, start, clock):
+    sub = start("basic", Interval.ANNUAL, JAN_15)
+    clock.move_to(JUL_15)
+    invoice = service.change_plan(sub.id, "pro")
+    for line in invoice.lines:
+        assert line.amount == line.amount.quantize(Decimal("0.01"))
+        assert line.amount.as_tuple().exponent == -2
+
+
+# 17
+
+
+def test_upgrade_on_first_day_of_period_credits_whole_current_price(service, start, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    invoice = service.change_plan(sub.id, "premium")
+    assert invoice.issued_on == MAR_1
+    assert _amounts(invoice) == [Decimal("-30.00"), Decimal("75.00")]
+    assert invoice.total == Decimal("45.00")
+
+
+def test_annual_upgrade_on_first_day_of_period_credits_whole_current_price(service, start, clock):
+    sub = start("basic", Interval.ANNUAL, JAN_15)
+    invoice = service.change_plan(sub.id, "pro")
+    assert _amounts(invoice) == [Decimal("-100.00"), Decimal("300.00")]
+    assert invoice.total == Decimal("200.00")
+
+
+def test_upgrade_on_first_day_of_renewed_period_credits_whole_current_price(service, start, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(APR_1)
+    service.renew_due()
+    invoice = service.change_plan(sub.id, "premium")
+    assert invoice.issued_on == APR_1
+    assert _amounts(invoice) == [Decimal("-30.00"), Decimal("75.00")]
+
+
+# 18
+
+
+def test_upgrade_discards_pending_downgrade(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "premium")
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("75.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.MONTHLY)
+    assert renewed.period_end == date(2026, 5, 1)
+
+
+def test_upgrade_without_interval_discards_pending_interval_switch(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    service.change_plan(sub.id, "premium")
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("75.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.MONTHLY)
+
+
+def test_upgrade_with_interval_switch_replaces_pending_change(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    clock.move_to(APR_1)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("750.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (APR_1, date(2027, 4, 1))
+
+
+# 19
+
+
+def test_upgrade_while_downgrade_pending_is_prorated_from_current_plan(service, start, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(date(2026, 3, 5))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(MAR_11)
+    invoice = service.change_plan(sub.id, "premium")
+    assert _amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")
+
+
+def test_change_is_classified_against_current_plan_not_pending_plan(service, start, store, clock):
+    # Pro Alt costs more than the pending Basic but the same as the current Pro: a downgrade.
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    invoices_before = list(store.invoices_for(sub.id))
+    assert service.change_plan(sub.id, "pro_alt") is None
+    assert store.invoices_for(sub.id) == invoices_before
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+
+# 20
+
+
+def test_zero_total_upgrade_returns_the_invoice_iff_one_was_recorded(service, start, store, clock):
+    # Last day of a 31-day period: 10.00/31 -> 0.32 and 10.01/31 -> 0.32, total 0.00.
+    sub = start("basic", Interval.MONTHLY, MAR_1)
+    clock.move_to(date(2026, 3, 31))
+    before = list(store.invoices_for(sub.id))
+    result = service.change_plan(sub.id, "basic_plus")
+    new_invoices = store.invoices_for(sub.id)[len(before) :]
+    if result is None:
+        assert new_invoices == []
+    else:
+        assert new_invoices == [result]
+        assert result.total == Decimal("0.00")
+        assert _amounts(result) == [Decimal("-0.32"), Decimal("0.32")]
+    assert store.get_subscription(sub.id).plan_code == "basic_plus"

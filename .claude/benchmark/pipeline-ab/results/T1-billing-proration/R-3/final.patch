+"""Fixtures for the mid-cycle plan change acceptance tests (SPEC.md).
+
+Plans follow the spec's worked examples (Basic, Pro, Premium), plus a few
+extra plans that set up the edge cases named in the acceptance criteria.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.clock import FixedClock
+from billing.plans import Interval, Plan
+from billing.service import BillingService
+from billing.store import InMemoryStore
+
+
+@pytest.fixture
+def clock() -> FixedClock:
+    return FixedClock(date(2026, 1, 1))
+
+
+@pytest.fixture
+def store() -> InMemoryStore:
+    store = InMemoryStore()
+    # Worked-example plans.
+    store.add_plan(Plan("basic", "Basic", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("pro", "Pro", Decimal("30.00"), Decimal("300.00")))
+    store.add_plan(Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")))
+    # Same monthly price as Pro: moving between them is a downgrade.
+    store.add_plan(Plan("pro_alt", "Pro Alt", Decimal("30.00"), Decimal("280.00")))
+    # Higher monthly but lower annual price than Pro (criterion 6).
+    store.add_plan(Plan("lopsided", "Lopsided", Decimal("40.00"), Decimal("200.00")))
+    # Prorates to an exact half cent over 15 of 30 days (criterion 16).
+    store.add_plan(Plan("plus", "Plus", Decimal("20.01"), Decimal("200.10")))
+    # One cent above Basic: a one-day upgrade rounds to a 0.00 total (criterion 20).
+    store.add_plan(Plan("basic_plus", "Basic Plus", Decimal("10.01"), Decimal("100.10")))
+    return store
+
+
+@pytest.fixture
+def service(store: InMemoryStore, clock: FixedClock) -> BillingService:
+    return BillingService(store, clock)
+
+
+@pytest.fixture
+def start(service: BillingService, clock: FixedClock):
+    """Subscribe on a given day: ``start("pro", Interval.MONTHLY, date(2026, 3, 1))``."""
+
+    def _start(plan_code: str, interval: Interval, on: date, *, trial_days: int = 0, customer_id: str = "cus_1"):
+        clock.move_to(on)
+        return service.subscribe(customer_id, plan_code, interval, trial_days=trial_days)
+
+    return _start

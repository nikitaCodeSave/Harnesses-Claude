+    clock.move_to(MAR_11)
+    service.change_plan(sub.id, "basic")
+    service.cancel(sub.id)
+    _assert_rejected_without_side_effects(
+        service, store, sub.id, lambda: service.change_plan(sub.id, "premium"), SubscriptionNotActive
+    )
+
+
+def test_rejected_same_target_without_pending_changes_nothing(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    _assert_rejected_without_side_effects(
+        service, store, sub.id, lambda: service.change_plan(sub.id, "pro"), errors.InvalidPlanChange
+    )
+
+
+def test_rejected_unknown_subscription_records_nothing(service, start, store, clock):
+    sub = start("pro", Interval.MONTHLY, MAR_1)
+    clock.move_to(MAR_11)
+    before = store.get_subscription(sub.id)
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_missing", "premium")
+    assert store.get_subscription(sub.id) == before
+    assert store.subscriptions() == [before]
+    assert len(store.invoices_for(sub.id)) == 1
+    assert store.invoices_for("sub_missing") == []

+    def _prorate(price: Decimal, subscription: Subscription, from_day: date) -> Decimal:
+        """Share of ``price`` covering ``[from_day, period_end)`` of the current period."""
+        remaining = (subscription.period_end - from_day).days
+        total = (subscription.period_end - subscription.period_start).days
+        return to_money(price * remaining / total)

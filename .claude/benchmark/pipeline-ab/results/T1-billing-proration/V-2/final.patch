diff --git a/tests/test_change_plan.py b/tests/test_change_plan.py
new file mode 100644
index 0000000..d48987e
--- /dev/null
+++ b/tests/test_change_plan.py
@@ -0,0 +1,156 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+# The fixture clock starts on 2026-01-15, so a monthly subscription's first
+# period is [Jan 15, Feb 15): 31 days. Changing on Feb 1 leaves 14 of them.
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def test_upgrade_mid_period_credits_old_plan_and_charges_new(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-4.52"), Decimal("13.55")]
+    assert (invoice.issued_on, invoice.total) == (date(2026, 2, 1), Decimal("9.03"))
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_same_interval_change_keeps_the_period(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))
+    service.change_plan(sub.id, "pro")
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "pro"
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_downgrade_mid_period_owes_the_customer(service, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 2, 1))
+    invoice = service.change_plan(sub.id, "basic")
+    assert amounts(invoice) == [Decimal("-13.55"), Decimal("4.52")]
+    assert invoice.total == Decimal("-9.03")
+
+
+def test_change_on_first_day_credits_the_whole_period(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert invoice.total == Decimal("20.00")
+    paid = sum((inv.total for inv in store.invoices_for(sub.id)), Decimal(0))
+    assert paid == Decimal("30.00")
+
+
+def test_changing_back_the_same_day_nets_to_zero(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))
+    up = service.change_plan(sub.id, "pro")
+    down = service.change_plan(sub.id, "basic")
+    assert up.total + down.total == Decimal("0.00")
+
+
+def test_monthly_to_annual_starts_an_annual_period_today(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-4.52"), Decimal("300.00")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.ANNUAL)
+    assert (changed.period_start, changed.period_end) == (date(2026, 2, 1), date(2027, 2, 1))
+    clock.move_to(date(2026, 2, 15))
+    assert service.renew_due() == []
+
+
+def test_annual_to_monthly_credits_unused_months(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))  # 184 of 365 days left
+    invoice = service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    assert amounts(invoice) == [Decimal("-151.23"), Decimal("30.00")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.period_start, changed.period_end) == (date(2026, 7, 15), date(2026, 8, 15))
+
+
+def test_interval_none_keeps_current_interval(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+
+def test_change_during_trial_bills_nothing_and_keeps_trial_end(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    changed = store.get_subscription(sub.id)
+    assert changed.status is SubscriptionStatus.TRIALING
+    assert (changed.plan_code, changed.period_end) == ("pro", date(2026, 1, 29))
+    assert store.invoices_for(sub.id) == []
+    clock.move_to(date(2026, 1, 29))
+    [first] = service.renew_due()
+    assert first.total == Decimal("300.00")
+
+
+def test_moving_off_a_retired_plan_is_allowed(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    clock.move_to(date(2026, 2, 1))
+    assert service.change_plan(sub.id, "pro").total == Decimal("9.03")
+
+
+def test_change_to_retired_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "pro")
+
+
+def test_interval_switch_on_retired_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+
+def test_change_to_current_plan_and_interval_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic", Interval.MONTHLY)
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_change_with_renewal_pending_is_rejected(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 15))
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+
+
+def test_change_on_canceled_subscription_is_rejected(service):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "pro")
+
+
+def test_change_to_unknown_plan_or_subscription(service):
+    sub = service.subscribe("cus_1", "basic")
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_missing", "pro")

+    def change_plan(
+        self,
+        subscription_id: str,
+        new_plan_code: str,
+        new_interval: Interval | None = None,
+    ) -> Invoice | None:
+        """Move a subscription to another plan and/or interval, effective today.
+
+        During a trial nothing has been paid, so the plan is swapped, the
+        trial end is kept and ``None`` is returned. Otherwise one invoice is
+        issued today that credits the unused part of the current period at
+        the old price and charges for the new arrangement:
+
+        - same interval: the period is kept and the rest of it is charged at
+          the new price;
+        - new interval: a full period of the new interval starts today.
+
+        A downgrade can make the invoice total negative: the customer is
+        owed the difference.
+        """
+        subscription = self._store.get_subscription(subscription_id)
+        if subscription.is_canceled:
+            raise SubscriptionNotActive(subscription_id)
+        old_plan = self._store.get_plan(subscription.plan_code)
+        new_plan = self._store.get_plan(new_plan_code)
+        interval = new_interval or subscription.interval
+        if new_plan.code == old_plan.code and interval is subscription.interval:
+            raise InvalidPlanChange(f"{subscription_id} is already on {new_plan.code} ({interval.value})")
+        if not new_plan.active:
+            raise PlanNotAvailable(new_plan_code)
+
+        today = self._clock.today()
+        if subscription.period_end <= today:
+            raise InvalidPlanChange(
+                f"{subscription_id}: period ended on {subscription.period_end.isoformat()} "
+                "and has not been renewed yet; run renew_due first"
+            )
+
+        if subscription.status is SubscriptionStatus.TRIALING:
+            self._store.save_subscription(replace(subscription, plan_code=new_plan.code, interval=interval))
+            return None
+
+        lines: list[LineItem] = []
+        credit = self._prorate(old_plan.price_for(subscription.interval), subscription, today)
+        if credit:
+            lines.append(
+                LineItem(
+                    description=(
+                        f"Unused time on {old_plan.name} ({subscription.interval.value}) "
+                        f"{today.isoformat()} to {subscription.period_end.isoformat()}"
+                    ),
+                    amount=-credit,
+                )
+            )
+
+        if interval is subscription.interval:
+            changed = replace(subscription, plan_code=new_plan.code)
+            lines.append(
+                LineItem(
+                    description=(
+                        f"Remaining time on {new_plan.name} ({interval.value}) "
+                        f"{today.isoformat()} to {subscription.period_end.isoformat()}"
+                    ),
+                    amount=self._prorate(new_plan.price_for(interval), subscription, today),
+                )
+            )
+        else:
+            changed = replace(
+                subscription,
+                plan_code=new_plan.code,
+                interval=interval,
+                period_start=today,
+                period_end=period_end(today, interval),
+            )
+            lines.append(self._period_line(new_plan, changed))
+
+        self._store.save_subscription(changed)
+        return self._issue_invoice(changed, lines, today)
+
     # internals
 

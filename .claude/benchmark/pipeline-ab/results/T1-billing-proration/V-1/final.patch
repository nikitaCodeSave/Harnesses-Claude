+def test_rejected_request_with_renewal_due_changes_nothing(service, store, clock, plan_code, error):
+    store.add_plan(Plan("retired", "Retired", Decimal("50.00"), Decimal("500.00")))
+    store.retire_plan("retired")
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    before = store.get_subscription(sub.id)
+    clock.move_to(date(2026, 2, 15))
+
+    with pytest.raises(error):
+        service.change_plan(sub.id, plan_code)
+
+    assert store.get_subscription(sub.id) == before
+    assert len(store.invoices_for(sub.id)) == 1

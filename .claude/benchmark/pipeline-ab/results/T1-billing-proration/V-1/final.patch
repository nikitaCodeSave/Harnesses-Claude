diff --git a/tests/test_change_plan.py b/tests/test_change_plan.py
new file mode 100644
index 0000000..e895367
--- /dev/null
+++ b/tests/test_change_plan.py
@@ -0,0 +1,373 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import ScheduledChange, SubscriptionStatus
+
+# Plans: basic 10/100, pro 30/300, premium 75/750 (monthly/annual).
+# The clock starts on 2026-01-15, so a monthly period runs to 2026-02-15
+# (31 days). On 2026-01-25, 21 of those days are left.
+
+
+@pytest.fixture(autouse=True)
+def premium(store):
+    store.add_plan(Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")))
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+# upgrades
+
+
+def test_upgrade_is_prorated_by_calendar_days(service, store, clock):
+    clock.move_to(date(2026, 3, 1))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "premium"
+    assert (changed.period_start, changed.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+    assert changed.scheduled_change is None
+
+
+def test_renewal_after_upgrade_bills_new_plan_in_full(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 2, 15))
+
+    [invoice] = service.renew_due()
+
+    assert invoice.total == Decimal("30.00")
+
+
+def test_upgrade_on_first_day_charges_the_whole_difference(service):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_annual_upgrade_is_prorated_at_annual_prices(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))  # 184 of 365 days left
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [Decimal("-50.41"), Decimal("151.23")]
+    assert store.get_subscription(sub.id).period_end == date(2027, 1, 15)
+
+
+def test_repeated_upgrades_in_one_period_bill_each_day_once(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 2, 1))
+    service.change_plan(sub.id, "premium")
+
+    # 10 days basic + 7 days pro + 14 days premium, out of 31
+    assert sum(inv.total for inv in store.invoices_for(sub.id)) == Decimal("43.87")
+
+
+def test_upgrade_from_free_plan_still_has_two_lines(service, store, clock):
+    store.add_plan(Plan("free", "Free", Decimal("0"), Decimal("0")))
+    sub = service.subscribe("cus_1", "free")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [Decimal("0.00"), Decimal("20.32")]
+
+
+def test_upgrade_with_interval_switch_prorates_now_and_switches_at_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    assert changed.period_end == date(2026, 2, 15)
+    assert changed.scheduled_change == ScheduledChange("pro", Interval.ANNUAL)
+
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("300.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.ANNUAL, date(2027, 2, 15))
+
+
+# downgrades and interval switches wait for the period end
+
+
+def test_downgrade_waits_for_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    pending = store.get_subscription(sub.id)
+    assert pending.plan_code == "pro"
+    assert pending.scheduled_change == ScheduledChange("basic", Interval.MONTHLY)
+
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("10.00")
+    assert (renewed.plan_code, renewed.scheduled_change) == ("basic", None)
+
+
+def test_downgrade_with_switch_to_annual_waits_for_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("100.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+
+
+def test_downgrade_is_decided_by_monthly_list_price(service, store, clock):
+    # Cheaper per month than pro, but dearer per year.
+    store.add_plan(Plan("lite", "Lite", Decimal("20.00"), Decimal("400.00")))
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))
+
+    assert service.change_plan(sub.id, "lite") is None
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("lite", Interval.ANNUAL)
+
+
+def test_plan_with_same_monthly_price_applies_now(service, store, clock):
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("280.00")))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "team")
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("20.32")]
+    assert store.get_subscription(sub.id).plan_code == "team"
+
+
+def test_switch_to_annual_waits_for_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    assert len(store.invoices_for(sub.id)) == 1
+
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("100.00")
+    assert store.get_subscription(sub.id).period_end == date(2027, 2, 15)
+
+
+def test_switch_to_monthly_refunds_nothing_and_waits_for_year_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert [inv.total for inv in store.invoices_for(sub.id)] == [Decimal("300.00")]
+
+    clock.move_to(date(2027, 1, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("30.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.MONTHLY, date(2027, 2, 15))
+
+
+# one scheduled change at a time
+
+
+def test_new_request_replaces_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "premium")
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("pro", Interval.ANNUAL)
+
+

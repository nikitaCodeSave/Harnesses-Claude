+    clock.move_to(date(2026, 2, 15))
+
+    [renewal] = service.renew_due()
+
+    assert (renewal.issued_on, renewal.total) == (date(2026, 2, 15), Decimal("10.00"))
+    assert [line.description for line in renewal.lines] == ["Basic (monthly) 2026-02-15 to 2026-03-15"]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2026, 3, 15))
+    assert renewed.scheduled_change is None
+
+
+def test_scheduled_downgrade_to_a_plan_retired_since_is_honored(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    store.retire_plan("basic")
+    clock.move_to(date(2026, 2, 15))
+
+    [renewal] = service.renew_due()
+
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_catch_up_renewal_applies_scheduled_downgrade_once_then_continues(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 4, 20))
+
+    renewals = service.renew_due()
+
+    assert [(inv.issued_on, inv.total) for inv in renewals] == [
+        (date(2026, 2, 15), Decimal("10.00")),
+        (date(2026, 3, 15), Decimal("10.00")),
+        (date(2026, 4, 15), Decimal("10.00")),
+    ]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.scheduled_change) == ("basic", None)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 15), date(2026, 5, 15))
+
+
+def test_new_downgrade_replaces_the_scheduled_one(service, store, clock):
+    store.add_plan(Plan("lite", "Lite", Decimal("5.00"), Decimal("50.00")))
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "lite") is None
+
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("lite", Interval.MONTHLY)
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("5.00")
+
+
+def test_upgrade_clears_a_scheduled_downgrade(service, store, clock):
+    store.add_plan(Plan("max", "Max", Decimal("50.00"), Decimal("500.00")))
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+
+    invoice = service.change_plan(sub.id, "max")
+
+    assert invoice.total == Decimal("20.00")
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.scheduled_change) == ("max", None)
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("50.00")
+
+
+def test_lateral_change_clears_a_scheduled_downgrade(service, store):
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("300.00")))
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "team") is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.scheduled_change) == ("team", None)
+
+
+def test_repeating_the_scheduled_downgrade_changes_nothing(service, store):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "basic", Interval.MONTHLY) is None
+
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("basic", Interval.MONTHLY)
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_requesting_current_terms_cancels_a_scheduled_downgrade(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+
+    assert service.change_plan(sub.id, "pro") is None
+
+    after = store.get_subscription(sub.id)
+    assert (after.plan_code, after.scheduled_change) == ("pro", None)
+    assert len(store.invoices_for(sub.id)) == 1
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_customer_on_retired_plan_can_cancel_a_scheduled_downgrade(service, store, clock):
+    store.add_plan(Plan("lite", "Lite", Decimal("5.00"), Decimal("50.00")))
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    service.change_plan(sub.id, "lite")
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert store.get_subscription(sub.id).scheduled_change is None
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert (renewal.total, store.get_subscription(sub.id).plan_code) == (Decimal("10.00"), "basic")
diff --git a/tests/test_plan_changes_interval.py b/tests/test_plan_changes_interval.py
new file mode 100644
index 0000000..2fcc6c1
--- /dev/null
+++ b/tests/test_plan_changes_interval.py
@@ -0,0 +1,189 @@
+"""Interval switches, alone and combined with a plan change."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import PlanNotAvailable
+from billing.plans import Interval, Plan
+from billing.subscriptions import ScheduledChange
+
+
+def test_interval_switch_is_scheduled_and_bills_nothing(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    after = store.get_subscription(sub.id)
+    assert after.scheduled_change == ScheduledChange("basic", Interval.ANNUAL)
+    assert (after.plan_code, after.interval) == ("basic", Interval.MONTHLY)
+    assert (after.period_start, after.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_monthly_to_annual_renews_for_twelve_months_at_the_annual_price(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 2, 15))
+
+    [renewal] = service.renew_due()
+
+    assert (renewal.issued_on, renewal.total) == (date(2026, 2, 15), Decimal("100.00"))
+    assert [line.description for line in renewal.lines] == ["Basic (annual) 2026-02-15 to 2027-02-15"]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.scheduled_change) == ("basic", Interval.ANNUAL, None)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+
+
+def test_annual_to_monthly_keeps_the_paid_year_then_renews_monthly(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 6, 1))
+    assert service.change_plan(sub.id, "basic", Interval.MONTHLY) is None
+    clock.move_to(date(2027, 1, 14))
+    assert service.renew_due() == []
+
+    clock.move_to(date(2027, 2, 15))
+    renewals = service.renew_due()
+
+    assert [(inv.issued_on, inv.total) for inv in renewals] == [
+        (date(2027, 1, 15), Decimal("10.00")),
+        (date(2027, 2, 15), Decimal("10.00")),
+    ]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.interval, renewed.scheduled_change) == (Interval.MONTHLY, None)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 2, 15), date(2027, 3, 15))
+
+
+def test_upgrade_with_interval_switch_prorates_now_at_current_interval_and_schedules_switch(
+    service, store, clock
+):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))
+
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+    assert [line.amount for line in invoice.lines] == [Decimal("-8.39"), Decimal("25.16")]
+    assert [line.description for line in invoice.lines] == [
+        "Credit for unused time on Basic (monthly) 2026-01-20 to 2026-02-15",
+        "Pro (monthly) 2026-01-20 to 2026-02-15",
+    ]
+    assert (invoice.issued_on, invoice.total) == (date(2026, 1, 20), Decimal("16.77"))
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+    assert changed.scheduled_change == ScheduledChange("pro", Interval.ANNUAL)
+
+
+def test_renewal_after_upgrade_with_interval_switch_bills_new_plan_at_new_interval(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 2, 15))
+
+    [renewal] = service.renew_due()
+
+    assert (renewal.issued_on, renewal.total) == (date(2026, 2, 15), Decimal("300.00"))
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.scheduled_change) == ("pro", Interval.ANNUAL, None)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+
+
+def test_downgrade_with_interval_switch_is_all_scheduled(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    after = store.get_subscription(sub.id)
+    assert after.scheduled_change == ScheduledChange("basic", Interval.ANNUAL)
+    assert (after.plan_code, after.interval) == ("pro", Interval.MONTHLY)
+    assert len(store.invoices_for(sub.id)) == 1
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("100.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+
+
+def test_lateral_change_with_interval_switch_billing_nothing_still_schedules_switch(service, store, clock):
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("300.00")))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "team", Interval.ANNUAL) is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("team", Interval.MONTHLY)
+    assert changed.scheduled_change == ScheduledChange("team", Interval.ANNUAL)
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_annual_upgrade_with_switch_to_monthly_is_prorated_at_annual_prices(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+
+    invoice = service.change_plan(sub.id, "pro", Interval.MONTHLY)
+
+    assert [line.amount for line in invoice.lines] == [Decimal("-100.00"), Decimal("300.00")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.ANNUAL)
+    assert changed.scheduled_change == ScheduledChange("pro", Interval.MONTHLY)
+    clock.move_to(date(2027, 1, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).period_end == date(2027, 2, 15)
+
+
+def test_upgrade_without_interval_drops_a_scheduled_interval_switch(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 1, 20))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert invoice.total == Decimal("16.77")
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval, changed.scheduled_change) == ("pro", Interval.MONTHLY, None)
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).period_end == date(2026, 3, 15)
+
+
+def test_repeating_upgrade_with_interval_switch_only_keeps_the_switch_scheduled(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.scheduled_change) == ("pro", ScheduledChange("pro", Interval.ANNUAL))
+    assert len(store.invoices_for(sub.id)) == 2
+
+
+def test_requesting_current_terms_cancels_a_scheduled_interval_switch(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert store.get_subscription(sub.id).scheduled_change is None
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+
+
+def test_switching_interval_on_retired_plan_leaves_scheduled_change_alone(service, store):
+    store.add_plan(Plan("lite", "Lite", Decimal("5.00"), Decimal("50.00")))
+    sub = service.subscribe("cus_1", "basic")
+    service.change_plan(sub.id, "lite")
+    store.retire_plan("basic")
+
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+    assert store.get_subscription(sub.id).scheduled_change == ScheduledChange("lite", Interval.MONTHLY)

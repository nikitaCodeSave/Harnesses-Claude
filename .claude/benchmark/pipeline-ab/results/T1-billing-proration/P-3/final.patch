@@ -0,0 +1,103 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import InvalidPlanChange, PlanNotAvailable
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+
+def test_upgrade_during_trial_applies_now_and_bills_nothing(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "pro") is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    assert changed.status is SubscriptionStatus.TRIALING
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 1, 29))
+    assert changed.scheduled_change is None
+    assert store.invoices_for(sub.id) == []
+
+
+def test_interval_switch_during_trial_applies_now_and_bills_nothing(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("basic", Interval.ANNUAL)
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 1, 29))
+    assert changed.scheduled_change is None
+    assert store.invoices_for(sub.id) == []
+
+
+def test_downgrade_with_interval_switch_during_trial_applies_now(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("basic", Interval.ANNUAL)
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 1, 29))
+    assert changed.scheduled_change is None
+    assert store.invoices_for(sub.id) == []
+
+
+def test_first_paid_period_after_trial_bills_the_chosen_plan_and_interval(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 1, 29))
+
+    [invoice] = service.renew_due()
+
+    assert (invoice.issued_on, invoice.total) == (date(2026, 1, 29), Decimal("300.00"))
+    assert [line.description for line in invoice.lines] == ["Pro (annual) 2026-01-29 to 2027-01-29"]
+    paid = store.get_subscription(sub.id)
+    assert (paid.status, paid.plan_code, paid.interval) == (SubscriptionStatus.ACTIVE, "pro", Interval.ANNUAL)
+    assert (paid.period_start, paid.period_end) == (date(2026, 1, 29), date(2027, 1, 29))
+    assert store.invoices_for(sub.id) == [invoice]
+
+
+def test_change_to_retired_plan_during_trial_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_switching_interval_on_retired_plan_during_trial_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    store.retire_plan("basic")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+
+
+def test_requesting_current_terms_during_trial_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic", Interval.MONTHLY)
+
+
+def test_change_plan_on_trial_end_day_before_renewals_run_is_rejected(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 29))
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_change_plan_with_trial_end_overdue_is_rejected(service, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 2, 10))
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "pro")

+def test_upgrade_with_interval_switch_changes_plan_now_and_interval_at_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "small")
+    clock.move_to(date(2026, 10, 23))
+
+    invoice = service.change_plan(sub.id, "large", Interval.ANNUAL)
+
+    assert invoice is not None
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval) == ("large", Interval.MONTHLY)
+    assert (now.period_start, now.period_end) == (date(2026, 10, 1), date(2026, 11, 1))
+
+    clock.move_to(date(2026, 11, 1))
+    [renewal] = service.renew_due()
+
+    assert renewal.issued_on == date(2026, 11, 1)
+    assert renewal.total == Decimal("500.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("large", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 11, 1), date(2027, 11, 1))
+
+
+def test_annual_upgrade_with_switch_to_monthly_starts_monthly_at_period_end(service, store, clock):
+    clock.move_to(date(2027, 3, 1))
+    sub = service.subscribe("cus_1", "a120", Interval.ANNUAL)
+    clock.move_to(date(2027, 11, 22))
+
+    service.change_plan(sub.id, "mid", Interval.MONTHLY)
+
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval, now.period_end) == ("mid", Interval.ANNUAL, date(2028, 3, 1))
+
+    clock.move_to(date(2028, 3, 1))
+    [renewal] = service.renew_due()
+
+    assert renewal.total == Decimal("30.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("mid", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2028, 3, 1), date(2028, 4, 1))
+

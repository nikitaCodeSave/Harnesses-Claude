@@ -0,0 +1,247 @@
+"""Acceptance criteria 15-20: scheduled changes (downgrades and interval switches).
+
+Scheduled changes are only observable through their effect at renewal, so most
+tests here end by renewing on ``period_end`` and checking what was billed.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+PERIOD_END = date(2026, 11, 1)
+
+
+def renew(service, store, clock, sub_id, day=PERIOD_END):
+    clock.move_to(day)
+    [invoice] = service.renew_due()
+    return invoice, store.get_subscription(sub_id)
+
+
+def assert_nothing_applied(store, sub_id, before, invoices_before):
+    now = store.get_subscription(sub_id)
+    assert (now.plan_code, now.interval, now.status) == (before.plan_code, before.interval, before.status)
+    assert (now.period_start, now.period_end) == (before.period_start, before.period_end)
+    assert store.invoices_for(sub_id) == invoices_before
+
+
+@pytest.fixture
+def monthly(service, clock):
+    """Factory: paid monthly subscription started 2026-10-01, clock moved to 2026-10-10."""
+
+    def make(plan_code):
+        sub = service.subscribe("cus_1", plan_code)
+        clock.move_to(date(2026, 10, 10))
+        return sub
+
+    return make
+
+
+# 15 (and the "downgrade" worked example)
+
+
+def test_downgrade_is_scheduled_not_applied(service, store, clock, monthly):
+    sub = monthly("large")
+    invoices_before = store.invoices_for(sub.id)
+
+    result = service.change_plan(sub.id, "small")
+
+    assert result is None
+    assert_nothing_applied(store, sub.id, sub, invoices_before)
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("10.00")
+    assert renewed.plan_code == "small"
+
+
+def test_same_monthly_price_different_plan_is_scheduled(service, store, clock, monthly):
+    sub = monthly("mid")
+    invoices_before = store.invoices_for(sub.id)
+
+    assert service.change_plan(sub.id, "mid_alt") is None
+    assert_nothing_applied(store, sub.id, sub, invoices_before)
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert renewed.plan_code == "mid_alt"
+    assert invoice.total == Decimal("30.00")
+
+
+# 16
+
+
+def test_monthly_to_annual_switch_is_scheduled(service, store, clock, monthly):
+    sub = monthly("mid")
+    invoices_before = store.invoices_for(sub.id)
+
+    assert service.change_plan(sub.id, "mid", Interval.ANNUAL) is None
+    assert_nothing_applied(store, sub.id, sub, invoices_before)
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("300.00")
+    assert (renewed.plan_code, renewed.interval) == ("mid", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (PERIOD_END, date(2027, 11, 1))
+
+
+def test_annual_to_monthly_switch_is_scheduled(service, store, clock):
+    sub = service.subscribe("cus_1", "mid", Interval.ANNUAL)  # 2026-10-01 -> 2027-10-01
+    clock.move_to(date(2027, 2, 1))
+    invoices_before = store.invoices_for(sub.id)
+
+    assert service.change_plan(sub.id, "mid", Interval.MONTHLY) is None
+    assert_nothing_applied(store, sub.id, sub, invoices_before)
+
+    invoice, renewed = renew(service, store, clock, sub.id, date(2027, 10, 1))
+    assert invoice.total == Decimal("30.00")
+    assert (renewed.plan_code, renewed.interval) == ("mid", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 10, 1), date(2027, 11, 1))
+
+
+def test_downgrade_combined_with_interval_switch_is_scheduled(service, store, clock, monthly):
+    sub = monthly("large")
+    invoices_before = store.invoices_for(sub.id)
+
+    assert service.change_plan(sub.id, "small", Interval.ANNUAL) is None
+    assert_nothing_applied(store, sub.id, sub, invoices_before)
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("100.00")
+    assert (renewed.plan_code, renewed.interval) == ("small", Interval.ANNUAL)
+    assert renewed.period_end == date(2027, 11, 1)
+
+
+# 17
+
+
+def test_new_downgrade_replaces_scheduled_downgrade(service, store, clock, monthly):
+    sub = monthly("large")
+    assert service.change_plan(sub.id, "small") is None
+    assert service.change_plan(sub.id, "mid") is None
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert renewed.plan_code == "mid"
+    assert invoice.total == Decimal("30.00")
+
+
+def test_interval_none_discards_scheduled_interval_switch(service, store, clock, monthly):
+    sub = monthly("large")
+    assert service.change_plan(sub.id, "large", Interval.ANNUAL) is None
+    assert service.change_plan(sub.id, "small") is None
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("10.00")
+    assert (renewed.plan_code, renewed.interval) == ("small", Interval.MONTHLY)
+    assert renewed.period_end == date(2026, 12, 1)
+
+
+def test_interval_switch_replaces_scheduled_downgrade(service, store, clock, monthly):
+    sub = monthly("large")
+    assert service.change_plan(sub.id, "small") is None
+    assert service.change_plan(sub.id, "large", Interval.ANNUAL) is None
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("500.00")
+    assert (renewed.plan_code, renewed.interval) == ("large", Interval.ANNUAL)
+
+
+def test_downgrade_with_switch_replaces_other_downgrade_with_switch(service, store, clock, monthly):
+    sub = monthly("large")
+    assert service.change_plan(sub.id, "small", Interval.ANNUAL) is None
+    assert service.change_plan(sub.id, "mid", Interval.ANNUAL) is None
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("300.00")
+    assert (renewed.plan_code, renewed.interval) == ("mid", Interval.ANNUAL)
+
+
+# 18
+
+
+def test_upgrade_discards_scheduled_downgrade(service, store, clock, monthly):
+    sub = monthly("mid")
+    assert service.change_plan(sub.id, "small") is None
+    clock.move_to(date(2026, 10, 23))
+    assert service.change_plan(sub.id, "large") is not None
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("50.00")
+    assert (renewed.plan_code, renewed.interval) == ("large", Interval.MONTHLY)
+
+
+def test_upgrade_discards_scheduled_interval_switch(service, store, clock, monthly):
+    sub = monthly("mid")
+    assert service.change_plan(sub.id, "mid", Interval.ANNUAL) is None
+    clock.move_to(date(2026, 10, 23))
+    assert service.change_plan(sub.id, "large") is not None
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("50.00")
+    assert (renewed.plan_code, renewed.interval) == ("large", Interval.MONTHLY)
+    assert renewed.period_end == date(2026, 12, 1)
+
+
+def test_upgrade_with_switch_replaces_scheduled_downgrade_with_its_own_switch(service, store, clock, monthly):
+    sub = monthly("mid")
+    assert service.change_plan(sub.id, "small") is None
+    clock.move_to(date(2026, 10, 23))
+    assert service.change_plan(sub.id, "large", Interval.ANNUAL) is not None
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("500.00")
+    assert (renewed.plan_code, renewed.interval) == ("large", Interval.ANNUAL)
+
+
+# 19
+
+
+@pytest.mark.parametrize("new_interval", [None, Interval.MONTHLY], ids=["interval_none", "interval_explicit"])
+def test_same_target_cancels_scheduled_downgrade(service, store, clock, monthly, new_interval):
+    sub = monthly("mid")
+    assert service.change_plan(sub.id, "small") is None
+    invoices_before = store.invoices_for(sub.id)
+
+    assert service.change_plan(sub.id, "mid", new_interval) is None
+    assert_nothing_applied(store, sub.id, sub, invoices_before)
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("30.00")
+    assert renewed.plan_code == "mid"
+
+
+def test_same_target_cancels_scheduled_interval_switch(service, store, clock, monthly):
+    sub = monthly("mid")
+    assert service.change_plan(sub.id, "mid", Interval.ANNUAL) is None
+    invoices_before = store.invoices_for(sub.id)
+
+    assert service.change_plan(sub.id, "mid", Interval.MONTHLY) is None
+    assert store.invoices_for(sub.id) == invoices_before
+
+    invoice, renewed = renew(service, store, clock, sub.id)
+    assert invoice.total == Decimal("30.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.MONTHLY, date(2026, 12, 1))
+
+
+def test_same_target_after_cancelling_schedule_is_rejected_again(service, clock, monthly, invalid_plan_change):
+    sub = monthly("mid")
+    assert service.change_plan(sub.id, "small") is None
+    assert service.change_plan(sub.id, "mid") is None  # cancels the schedule
+
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "mid")
+
+
+# 20
+
+
+def test_upgrade_while_downgrade_scheduled_prorates_from_current_plan(service, store, clock, monthly):
+    sub = monthly("mid")
+    assert service.change_plan(sub.id, "small") is None
+    clock.move_to(date(2026, 10, 23))  # 9 of 31 days remaining
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert sorted(line.amount for line in invoice.lines) == [Decimal("-8.71"), Decimal("14.52")]
+    assert invoice.total == Decimal("5.81")
+    assert store.get_subscription(sub.id).status is SubscriptionStatus.ACTIVE

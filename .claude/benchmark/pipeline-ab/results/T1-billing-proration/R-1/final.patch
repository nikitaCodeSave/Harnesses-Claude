@@ -0,0 +1,97 @@
+"""Acceptance criteria 25-27: invoices in the store, the new error, unchanged behaviour."""
+
+from datetime import date
+from decimal import Decimal
+
+import billing
+import billing.errors
+from billing.errors import BillingError
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+# 25
+
+
+def test_change_invoices_are_recorded_alongside_other_invoices(service, store, clock):
+    sub = service.subscribe("cus_1", "small")
+    [first] = store.invoices_for(sub.id)
+
+    clock.move_to(date(2026, 10, 11))
+    to_mid = service.change_plan(sub.id, "mid")
+    clock.move_to(date(2026, 10, 23))
+    to_large = service.change_plan(sub.id, "large")
+    clock.move_to(date(2026, 11, 1))
+    [renewal] = service.renew_due()
+
+    assert store.invoices_for(sub.id) == [first, to_mid, to_large, renewal]
+    assert len({inv.id for inv in store.invoices_for(sub.id)}) == 4
+    assert all(inv.subscription_id == sub.id and inv.customer_id == "cus_1" for inv in (to_mid, to_large))
+
+
+def test_change_invoices_are_not_attached_to_other_subscriptions(service, store, clock):
+    sub = service.subscribe("cus_1", "small")
+    other = service.subscribe("cus_2", "small")
+    clock.move_to(date(2026, 10, 23))
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert invoice in store.invoices_for(sub.id)
+    assert invoice not in store.invoices_for(other.id)
+
+
+# 26
+
+
+def test_invalid_plan_change_is_a_billing_error(invalid_plan_change):
+    assert issubclass(invalid_plan_change, BillingError)
+
+
+def test_invalid_plan_change_is_exported_from_package():
+    assert billing.InvalidPlanChange is billing.errors.InvalidPlanChange
+    assert "InvalidPlanChange" in billing.__all__
+
+
+# 27
+
+
+def test_neighbouring_subscription_is_unaffected_by_a_change(service, store, clock):
+    changer = service.subscribe("cus_1", "mid")
+    bystander = service.subscribe("cus_2", "mid")
+    clock.move_to(date(2026, 10, 10))
+    service.change_plan(changer.id, "small", Interval.ANNUAL)
+    clock.move_to(date(2026, 10, 23))
+    service.change_plan(changer.id, "large")
+
+    assert store.get_subscription(bystander.id) == bystander
+    assert len(store.invoices_for(bystander.id)) == 1
+
+    clock.move_to(date(2026, 11, 1))
+    service.renew_due()
+    [_, renewal] = store.invoices_for(bystander.id)
+    assert (renewal.issued_on, renewal.total) == (date(2026, 11, 1), Decimal("30.00"))
+    renewed = store.get_subscription(bystander.id)
+    assert (renewed.plan_code, renewed.interval, renewed.period_end) == ("mid", Interval.MONTHLY, date(2026, 12, 1))
+
+
+def test_subscribe_renew_cancel_unchanged_without_plan_change(service, store, clock):
+    monthly = service.subscribe("cus_1", "mid")
+    annual = service.subscribe("cus_2", "small", Interval.ANNUAL)
+    trial = service.subscribe("cus_3", "large", trial_days=14)
+    assert [inv.total for inv in store.invoices_for(monthly.id)] == [Decimal("30.00")]
+    assert [inv.total for inv in store.invoices_for(annual.id)] == [Decimal("100.00")]
+    assert store.invoices_for(trial.id) == []
+
+    clock.move_to(date(2026, 10, 15))
+    [trial_invoice] = service.renew_due()
+    assert (trial_invoice.subscription_id, trial_invoice.total) == (trial.id, Decimal("50.00"))
+    assert store.get_subscription(trial.id).status is SubscriptionStatus.ACTIVE
+
+    service.cancel(trial.id)
+    clock.move_to(date(2026, 12, 1))
+    issued = service.renew_due()
+
+    assert [(inv.subscription_id, inv.issued_on, inv.total) for inv in issued] == [
+        (monthly.id, date(2026, 11, 1), Decimal("30.00")),
+        (monthly.id, date(2026, 12, 1), Decimal("30.00")),
+    ]
+    assert store.get_subscription(annual.id).period_end == date(2027, 10, 1)

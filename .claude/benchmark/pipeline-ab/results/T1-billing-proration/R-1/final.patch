+"""Fixtures for the mid-cycle plan change acceptance tests (SPEC.md).
+
+These override the ``clock``/``store``/``service`` fixtures of ``tests/conftest.py``
+with a catalogue built around the spec's worked examples.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.clock import FixedClock
+from billing.plans import Plan
+from billing.service import BillingService
+from billing.store import InMemoryStore
+
+PLANS = [
+    Plan("small", "Small", Decimal("10.00"), Decimal("100.00")),
+    Plan("legacy", "Legacy", Decimal("20.00"), Decimal("200.00")),
+    Plan("a120", "Annual 120", Decimal("12.00"), Decimal("120.00")),
+    Plan("mid", "Mid", Decimal("30.00"), Decimal("300.00")),
+    # Same monthly price as "mid": moving between them is not an upgrade.
+    Plan("mid_alt", "Mid Alt", Decimal("30.00"), Decimal("290.00")),
+    Plan("odd", "Odd", Decimal("46.69"), Decimal("466.90")),
+    Plan("large", "Large", Decimal("50.00"), Decimal("500.00")),
+]
+
+
+@pytest.fixture
+def clock() -> FixedClock:
+    return FixedClock(date(2026, 10, 1))
+
+
+@pytest.fixture
+def store() -> InMemoryStore:
+    store = InMemoryStore()
+    for plan in PLANS:
+        store.add_plan(plan)
+    return store
+
+
+@pytest.fixture
+def service(store: InMemoryStore, clock: FixedClock) -> BillingService:
+    return BillingService(store, clock)
+
+
+@pytest.fixture
+def invalid_plan_change():
+    """The ``InvalidPlanChange`` error class the spec adds to ``billing.errors``.
+
+    Imported lazily so that its absence fails individual tests instead of
+    breaking collection of the whole suite.
+    """
+    from billing.errors import InvalidPlanChange
+
+    return InvalidPlanChange

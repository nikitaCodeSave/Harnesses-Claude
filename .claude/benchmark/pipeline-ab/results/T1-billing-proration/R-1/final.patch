+"""Acceptance criteria 8-9: changes during a trial."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+TRIAL_END = date(2026, 10, 15)
+
+CHANGES = [
+    # (target plan, new_interval, expected plan, expected interval, full price at trial end, next period end)
+    ("large", None, "large", Interval.MONTHLY, Decimal("50.00"), date(2026, 11, 15)),
+    ("small", None, "small", Interval.MONTHLY, Decimal("10.00"), date(2026, 11, 15)),
+    ("mid_alt", None, "mid_alt", Interval.MONTHLY, Decimal("30.00"), date(2026, 11, 15)),
+    ("mid", Interval.ANNUAL, "mid", Interval.ANNUAL, Decimal("300.00"), date(2027, 10, 15)),
+    ("large", Interval.ANNUAL, "large", Interval.ANNUAL, Decimal("500.00"), date(2027, 10, 15)),
+    ("small", Interval.ANNUAL, "small", Interval.ANNUAL, Decimal("100.00"), date(2027, 10, 15)),
+]
+CHANGE_IDS = ["upgrade", "downgrade", "same_price", "interval_switch", "upgrade_and_switch", "downgrade_and_switch"]
+
+
+@pytest.fixture
+def trial(service, clock):
+    """Monthly "mid" subscription trialing 2026-10-01 -> 2026-10-15, clock on 2026-10-05."""
+    sub = service.subscribe("cus_1", "mid", trial_days=14)
+    clock.move_to(date(2026, 10, 5))
+    return sub
+
+
+# 8
+
+
+@pytest.mark.parametrize("target, new_interval, plan, interval, _price, _end", CHANGES, ids=CHANGE_IDS)
+def test_trial_change_applies_immediately_without_invoice(
+    service, store, trial, target, new_interval, plan, interval, _price, _end
+):
+    result = service.change_plan(trial.id, target, new_interval)
+
+    assert result is None
+    changed = store.get_subscription(trial.id)
+    assert (changed.plan_code, changed.interval) == (plan, interval)
+    assert changed.period_end == TRIAL_END
+    assert changed.status is SubscriptionStatus.TRIALING
+    assert store.invoices_for(trial.id) == []
+
+
+def test_annual_trial_can_switch_to_monthly_immediately(service, store, clock):
+    sub = service.subscribe("cus_1", "mid", Interval.ANNUAL, trial_days=14)
+    clock.move_to(date(2026, 10, 5))
+
+    assert service.change_plan(sub.id, "mid", Interval.MONTHLY) is None
+
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval, changed.period_end) == ("mid", Interval.MONTHLY, TRIAL_END)
+    assert store.invoices_for(sub.id) == []
+
+
+# 9
+
+
+@pytest.mark.parametrize("target, new_interval, plan, interval, price, end", CHANGES, ids=CHANGE_IDS)
+def test_trial_end_bills_full_price_of_plan_and_interval_then_in_force(
+    service, store, clock, trial, target, new_interval, plan, interval, price, end
+):
+    service.change_plan(trial.id, target, new_interval)
+    clock.move_to(TRIAL_END)
+
+    [invoice] = service.renew_due()
+
+    assert invoice.issued_on == TRIAL_END
+    assert invoice.total == price
+    paid = store.get_subscription(trial.id)
+    assert (paid.plan_code, paid.interval, paid.status) == (plan, interval, SubscriptionStatus.ACTIVE)
+    assert (paid.period_start, paid.period_end) == (TRIAL_END, end)
+
+
+def test_trial_end_bills_the_last_of_several_trial_changes(service, store, clock, trial):
+    assert service.change_plan(trial.id, "large") is None
+    assert service.change_plan(trial.id, "small", Interval.ANNUAL) is None
+    clock.move_to(TRIAL_END)
+
+    [invoice] = service.renew_due()
+
+    assert invoice.total == Decimal("100.00")
+    paid = store.get_subscription(trial.id)
+    assert (paid.plan_code, paid.interval, paid.period_end) == ("small", Interval.ANNUAL, date(2027, 10, 15))
+
+
+def test_trial_change_back_to_original_plan_is_a_normal_change(service, store, clock, trial):
+    assert service.change_plan(trial.id, "large") is None
+    assert service.change_plan(trial.id, "mid") is None  # current plan is now "large"
+    assert store.get_subscription(trial.id).plan_code == "mid"
+    clock.move_to(TRIAL_END)
+
+    [invoice] = service.renew_due()
+
+    assert invoice.total == Decimal("30.00")

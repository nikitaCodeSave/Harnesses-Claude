@@ -0,0 +1,211 @@
+"""Acceptance criteria 10-14: upgrades on a paid period (and the worked examples)."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+
+def amounts(invoice):
+    return sorted(line.amount for line in invoice.lines)
+
+
+# 10
+
+
+def test_upgrade_changes_plan_today_and_keeps_period_and_status(service, store, clock):
+    sub = service.subscribe("cus_1", "small")
+    clock.move_to(date(2026, 10, 23))
+
+    service.change_plan(sub.id, "large")
+
+    upgraded = store.get_subscription(sub.id)
+    assert upgraded.plan_code == "large"
+    assert upgraded.interval is Interval.MONTHLY
+    assert (upgraded.period_start, upgraded.period_end) == (date(2026, 10, 1), date(2026, 11, 1))
+    assert upgraded.status is SubscriptionStatus.ACTIVE
+
+
+# 11
+
+
+def test_upgrade_issues_one_recorded_invoice_dated_today_with_credit_and_charge(service, store, clock):
+    sub = service.subscribe("cus_1", "small")
+    [first] = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 10, 23))
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert invoice is not None
+    assert store.invoices_for(sub.id) == [first, invoice]
+    assert invoice.issued_on == date(2026, 10, 23)
+    assert (invoice.subscription_id, invoice.customer_id) == (sub.id, "cus_1")
+    assert len(invoice.lines) == 2
+    assert amounts(invoice) == [Decimal("-2.90"), Decimal("14.52")]
+
+
+def test_upgrade_on_first_day_of_period_prorates_whole_period(service, clock):
+    sub = service.subscribe("cus_1", "small")  # 2026-10-01, today counts as remaining
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("50.00")]
+    assert invoice.total == Decimal("40.00")
+
+
+def test_upgrade_on_last_day_of_period_prorates_one_day(service, clock):
+    sub = service.subscribe("cus_1", "small")
+    clock.move_to(date(2026, 10, 31))  # 1 of 31 days remaining
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert amounts(invoice) == [Decimal("-0.32"), Decimal("1.61")]
+    assert invoice.total == Decimal("1.29")
+
+
+def test_upgrade_uses_real_length_of_february(service, clock):
+    clock.move_to(date(2027, 2, 1))
+    sub = service.subscribe("cus_1", "small")  # 2027-02-01 -> 2027-03-01, 28 days
+    clock.move_to(date(2027, 2, 15))  # 14 remaining
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert amounts(invoice) == [Decimal("-5.00"), Decimal("25.00")]
+    assert invoice.total == Decimal("20.00")
+
+
+def test_upgrade_with_switch_to_annual_prorates_at_monthly_prices(service, clock):
+    sub = service.subscribe("cus_1", "small")
+    clock.move_to(date(2026, 10, 23))
+
+    invoice = service.change_plan(sub.id, "large", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-2.90"), Decimal("14.52")]
+    assert invoice.total == Decimal("11.62")
+
+
+def test_upgrade_with_switch_to_monthly_prorates_at_annual_prices(service, clock):
+    clock.move_to(date(2027, 3, 1))
+    sub = service.subscribe("cus_1", "a120", Interval.ANNUAL)  # 2027-03-01 -> 2028-03-01, 366 days
+    clock.move_to(date(2027, 11, 22))  # 100 remaining
+
+    invoice = service.change_plan(sub.id, "mid", Interval.MONTHLY)
+
+    assert amounts(invoice) == [Decimal("-32.79"), Decimal("81.97")]
+    assert invoice.total == Decimal("49.18")
+
+
+# 12 (worked examples)
+
+
+def test_worked_example_per_line_rounding(service, clock):
+    sub = service.subscribe("cus_1", "small")  # 2026-10-01 -> 2026-11-01, 31 days
+    clock.move_to(date(2026, 10, 23))  # 9 remaining
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert amounts(invoice) == [Decimal("-2.90"), Decimal("14.52")]
+    assert invoice.total == Decimal("11.62")
+    assert invoice.total != Decimal("11.61")
+
+
+def test_worked_example_leap_year_annual(service, clock):
+    clock.move_to(date(2027, 3, 1))
+    sub = service.subscribe("cus_1", "a120", Interval.ANNUAL)  # 2027-03-01 -> 2028-03-01, 366 days
+    clock.move_to(date(2027, 11, 22))  # 100 remaining
+
+    invoice = service.change_plan(sub.id, "mid")
+
+    assert amounts(invoice) == [Decimal("-32.79"), Decimal("81.97")]
+    assert invoice.total == Decimal("49.18")
+
+
+def test_exact_half_cent_rounds_half_up(service, clock):
+    clock.move_to(date(2026, 11, 1))
+    sub = service.subscribe("cus_1", "small")  # 2026-11-01 -> 2026-12-01, 30 days

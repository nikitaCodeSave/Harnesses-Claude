+"""Acceptance criteria 1-7: rejected change requests."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import PlanNotAvailable, PlanNotFound, SubscriptionNotActive, SubscriptionNotFound
+from billing.plans import Interval
+
+
+def assert_unchanged(store, subscription_id, before, invoices_before):
+    assert store.get_subscription(subscription_id) == before
+    assert store.invoices_for(subscription_id) == invoices_before
+
+
+def renew_on(service, clock, day):
+    clock.move_to(day)
+    return service.renew_due()
+
+
+# 1
+
+
+def test_unknown_subscription_raises_subscription_not_found(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_missing", "large")
+
+
+# 2
+
+
+def test_canceled_subscription_raises_subscription_not_active(service, clock):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 10))
+    service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "large")
+
+
+# 3
+
+
+def test_unknown_target_plan_raises_plan_not_found(service, clock):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 23))
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")
+
+
+# 4
+
+
+@pytest.mark.parametrize("target", ["large", "small"], ids=["upgrade", "downgrade"])
+def test_retired_target_plan_raises_plan_not_available(service, store, clock, target):
+    sub = service.subscribe("cus_1", "mid")
+    store.retire_plan(target)
+    clock.move_to(date(2026, 10, 23))
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, target)
+
+
+def test_retired_target_plan_raises_plan_not_available_during_trial(service, store, clock):
+    sub = service.subscribe("cus_1", "mid", trial_days=14)
+    store.retire_plan("large")
+    clock.move_to(date(2026, 10, 5))
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "large")
+
+
+def test_customer_on_retired_plan_can_upgrade_to_active_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "legacy")
+    store.retire_plan("legacy")
+    clock.move_to(date(2026, 10, 23))  # 9 of 31 days remaining
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert invoice is not None
+    assert sorted(line.amount for line in invoice.lines) == [Decimal("-5.81"), Decimal("14.52")]
+    assert invoice.total == Decimal("8.71")
+    assert store.get_subscription(sub.id).plan_code == "large"
+
+
+def test_customer_on_retired_plan_can_downgrade_to_active_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "legacy")
+    store.retire_plan("legacy")
+    clock.move_to(date(2026, 10, 23))
+
+    assert service.change_plan(sub.id, "small") is None
+    assert store.get_subscription(sub.id).plan_code == "legacy"
+
+    [renewal] = renew_on(service, clock, date(2026, 11, 1))
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub.id).plan_code == "small"
+
+
+def test_customer_on_retired_plan_can_change_during_trial(service, store, clock):
+    sub = service.subscribe("cus_1", "legacy", trial_days=14)
+    store.retire_plan("legacy")
+    clock.move_to(date(2026, 10, 5))
+
+    assert service.change_plan(sub.id, "small") is None
+    assert store.get_subscription(sub.id).plan_code == "small"
+
+
+def test_same_retired_plan_and_interval_is_invalid_change_not_plan_not_available(
+    service, store, clock, invalid_plan_change
+):
+    sub = service.subscribe("cus_1", "legacy")
+    store.retire_plan("legacy")
+    clock.move_to(date(2026, 10, 23))
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "legacy")
+
+
+# 5
+
+
+@pytest.mark.parametrize("today", [date(2026, 11, 1), date(2026, 11, 20)], ids=["on_period_end", "after_period_end"])
+@pytest.mark.parametrize("target", ["large", "small"], ids=["upgrade", "downgrade"])
+def test_overdue_renewal_raises_invalid_plan_change(service, clock, invalid_plan_change, today, target):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(today)
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, target)
+
+
+@pytest.mark.parametrize("today", [date(2026, 10, 15), date(2026, 10, 20)], ids=["on_trial_end", "after_trial_end"])
+def test_overdue_trial_raises_invalid_plan_change(service, clock, invalid_plan_change, today):
+    sub = service.subscribe("cus_1", "mid", trial_days=14)  # trial ends 2026-10-15
+    clock.move_to(today)
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "large")
+
+
+def test_change_is_accepted_once_renew_due_has_caught_up(service, store, clock):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 11, 5))
+    service.renew_due()  # period is now 2026-11-01 -> 2026-12-01, 26 of 30 days remaining
+
+    invoice = service.change_plan(sub.id, "large")
+
+    assert invoice is not None
+    assert sorted(line.amount for line in invoice.lines) == [Decimal("-26.00"), Decimal("43.33")]
+
+
+# 6
+
+
+@pytest.mark.parametrize("new_interval", [None, Interval.MONTHLY], ids=["interval_none", "interval_explicit"])
+def test_same_plan_and_interval_without_schedule_raises(service, clock, invalid_plan_change, new_interval):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 23))
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "mid", new_interval)
+
+
+@pytest.mark.parametrize("new_interval", [None, Interval.ANNUAL], ids=["interval_none", "interval_explicit"])
+def test_same_plan_and_interval_without_schedule_raises_on_annual(service, clock, invalid_plan_change, new_interval):
+    sub = service.subscribe("cus_1", "mid", Interval.ANNUAL)
+    clock.move_to(date(2026, 12, 1))
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "mid", new_interval)
+
+
+def test_same_plan_and_interval_during_trial_raises(service, clock, invalid_plan_change):
+    sub = service.subscribe("cus_1", "mid", trial_days=14)
+    clock.move_to(date(2026, 10, 5))
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "mid")
+
+
+# 7
+
+
+@pytest.fixture
+def sub_with_scheduled_downgrade(service, clock):
+    """Paid monthly "mid" subscription (2026-10-01 -> 11-01) with a downgrade to "small" scheduled."""
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 10))
+    assert service.change_plan(sub.id, "small") is None
+    clock.move_to(date(2026, 10, 23))
+    return sub
+
+
+def test_rejected_unknown_plan_changes_nothing(service, store, clock, sub_with_scheduled_downgrade):
+    sub_id = sub_with_scheduled_downgrade.id
+    before, invoices_before = store.get_subscription(sub_id), store.invoices_for(sub_id)
+
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub_id, "gold")
+
+    assert_unchanged(store, sub_id, before, invoices_before)
+    [renewal] = renew_on(service, clock, date(2026, 11, 1))
+    assert renewal.total == Decimal("10.00")  # the scheduled downgrade survived
+
+
+def test_rejected_retired_plan_changes_nothing(service, store, clock, sub_with_scheduled_downgrade):
+    sub_id = sub_with_scheduled_downgrade.id
+    store.retire_plan("large")
+    before, invoices_before = store.get_subscription(sub_id), store.invoices_for(sub_id)
+
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub_id, "large")
+
+    assert_unchanged(store, sub_id, before, invoices_before)
+    [renewal] = renew_on(service, clock, date(2026, 11, 1))
+    assert renewal.total == Decimal("10.00")
+
+
+def test_rejected_overdue_request_changes_nothing(service, store, clock, invalid_plan_change, sub_with_scheduled_downgrade):
+    sub_id = sub_with_scheduled_downgrade.id
+    clock.move_to(date(2026, 11, 1))
+    before, invoices_before = store.get_subscription(sub_id), store.invoices_for(sub_id)
+
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub_id, "large")
+
+    assert_unchanged(store, sub_id, before, invoices_before)
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("10.00")
+    assert store.get_subscription(sub_id).plan_code == "small"
+
+
+def test_rejected_same_target_without_schedule_changes_nothing(service, store, clock, invalid_plan_change):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 23))
+    before, invoices_before = store.get_subscription(sub.id), store.invoices_for(sub.id)
+
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "mid")
+
+    assert_unchanged(store, sub.id, before, invoices_before)
+    [renewal] = renew_on(service, clock, date(2026, 11, 1))
+    assert renewal.total == Decimal("30.00")
+
+
+def test_rejected_retired_upgrade_without_schedule_changes_nothing(service, store, clock):
+    sub = service.subscribe("cus_1", "mid")
+    store.retire_plan("large")
+    clock.move_to(date(2026, 10, 23))
+    before, invoices_before = store.get_subscription(sub.id), store.invoices_for(sub.id)
+
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "large")
+
+    assert_unchanged(store, sub.id, before, invoices_before)
+    [renewal] = renew_on(service, clock, date(2026, 11, 1))
+    assert renewal.total == Decimal("30.00")
+
+
+def test_rejected_request_on_canceled_subscription_changes_nothing(service, store, clock, sub_with_scheduled_downgrade):
+    sub_id = sub_with_scheduled_downgrade.id
+    service.cancel(sub_id)
+    before, invoices_before = store.get_subscription(sub_id), store.invoices_for(sub_id)
+
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub_id, "large")
+
+    assert_unchanged(store, sub_id, before, invoices_before)
+
+
+def test_rejected_request_during_trial_changes_nothing(service, store, clock):
+    sub = service.subscribe("cus_1", "small", trial_days=14)
+    store.retire_plan("large")
+    clock.move_to(date(2026, 10, 5))
+    before = store.get_subscription(sub.id)
+
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "large", Interval.ANNUAL)
+
+    assert_unchanged(store, sub.id, before, [])
+    [renewal] = renew_on(service, clock, date(2026, 10, 15))
+    assert renewal.total == Decimal("10.00")

@@ -0,0 +1,147 @@
+"""Acceptance criteria 21-24: scheduled changes at renewal."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+# 21
+
+
+def test_renewal_applies_scheduled_change_with_full_price_on_one_invoice(service, store, clock):
+    sub = service.subscribe("cus_1", "mid")  # 2026-10-01 -> 2026-11-01
+    clock.move_to(date(2026, 10, 10))
+    assert service.change_plan(sub.id, "small", Interval.ANNUAL) is None
+
+    clock.move_to(date(2026, 11, 1))
+    issued = service.renew_due()
+
+    assert len(issued) == 1
+    [invoice] = issued
+    assert invoice.issued_on == date(2026, 11, 1)
+    assert invoice.total == Decimal("100.00")
+    assert all(line.amount > 0 for line in invoice.lines)
+    assert store.invoices_for(sub.id)[-1] == invoice
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.status) == ("small", Interval.ANNUAL, SubscriptionStatus.ACTIVE)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 11, 1), date(2027, 11, 1))
+
+
+def test_scheduled_change_is_cleared_after_it_applies(service, store, clock, invalid_plan_change):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 10))
+    service.change_plan(sub.id, "small", Interval.ANNUAL)
+    clock.move_to(date(2026, 11, 1))
+    service.renew_due()
+
+    # Nothing is scheduled any more, so asking for the current target is rejected (criterion 6).
+    with pytest.raises(invalid_plan_change):
+        service.change_plan(sub.id, "small", Interval.ANNUAL)
+
+    clock.move_to(date(2027, 11, 1))
+    [next_renewal] = service.renew_due()
+    assert next_renewal.total == Decimal("100.00")
+    assert store.get_subscription(sub.id).period_end == date(2028, 11, 1)
+
+
+@pytest.mark.parametrize(
+    "target, price",
+    [("mid", Decimal("30.00")), ("small", Decimal("10.00"))],
+    ids=["same_plan", "downgrade"],
+)
+def test_unused_annual_time_is_never_credited(service, store, clock, target, price):
+    sub = service.subscribe("cus_1", "mid", Interval.ANNUAL)  # 2026-10-01 -> 2027-10-01
+    clock.move_to(date(2026, 10, 10))
+    assert service.change_plan(sub.id, target, Interval.MONTHLY) is None
+
+    clock.move_to(date(2027, 10, 1))
+    [invoice] = service.renew_due()
+
+    assert invoice.total == price
+    assert all(line.amount > 0 for line in invoice.lines)
+    assert len(store.invoices_for(sub.id)) == 2  # the original annual invoice and this renewal
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == (target, Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 10, 1), date(2027, 11, 1))
+
+
+# 22
+
+
+def test_catch_up_applies_scheduled_plan_change_to_first_renewal(service, store, clock):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 10))
+    service.change_plan(sub.id, "small")
+
+    clock.move_to(date(2027, 1, 15))
+    issued = service.renew_due()
+
+    assert [(inv.issued_on, inv.total) for inv in issued] == [
+        (date(2026, 11, 1), Decimal("10.00")),
+        (date(2026, 12, 1), Decimal("10.00")),
+        (date(2027, 1, 1), Decimal("10.00")),
+    ]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.period_start, renewed.period_end) == ("small", date(2027, 1, 1), date(2027, 2, 1))
+
+
+def test_catch_up_applies_scheduled_interval_switch_to_first_renewal(service, store, clock):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 10))
+    service.change_plan(sub.id, "small", Interval.ANNUAL)
+
+    clock.move_to(date(2027, 11, 15))
+    issued = service.renew_due()
+
+    assert [(inv.issued_on, inv.total) for inv in issued] == [
+        (date(2026, 11, 1), Decimal("100.00")),
+        (date(2027, 11, 1), Decimal("100.00")),
+    ]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("small", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 11, 1), date(2028, 11, 1))
+
+
+# 23
+
+
+@pytest.mark.parametrize(
+    "new_interval, price, period_end",
+    [(None, Decimal("10.00"), date(2026, 12, 1)), (Interval.ANNUAL, Decimal("100.00"), date(2027, 11, 1))],
+    ids=["monthly", "annual"],
+)
+def test_scheduled_change_applies_even_if_target_plan_retired_meanwhile(
+    service, store, clock, new_interval, price, period_end
+):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 10))
+    assert service.change_plan(sub.id, "small", new_interval) is None
+    store.retire_plan("small")
+
+    clock.move_to(date(2026, 11, 1))
+    [invoice] = service.renew_due()
+
+    assert invoice.total == price
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.period_end) == ("small", period_end)
+
+
+# 24
+
+
+def test_canceled_subscription_never_applies_its_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "mid")
+    clock.move_to(date(2026, 10, 10))
+    assert service.change_plan(sub.id, "small", Interval.ANNUAL) is None
+    service.cancel(sub.id)
+    invoices_before = store.invoices_for(sub.id)
+
+    clock.move_to(date(2026, 12, 15))
+    assert service.renew_due() == []
+
+    canceled = store.get_subscription(sub.id)
+    assert (canceled.plan_code, canceled.interval, canceled.status) == ("mid", Interval.MONTHLY, SubscriptionStatus.CANCELED)
+    assert store.invoices_for(sub.id) == invoices_before

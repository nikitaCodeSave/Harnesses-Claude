+"""Shared setup for the stock-reservation acceptance tests (SPEC.md).
+
+The base fixtures (clock, repo, ledger, service) come from tests/conftest.py.
+New names from the spec are looked up at test time through the modules, so a
+missing name fails the individual test instead of the whole collection.
+"""
+
+import pytest
+
+
+@pytest.fixture
+def stocked(service):
+    """WH1: MUG 10, TEE 5, CAP 0. WH2: MUG 7."""
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 7)
+    return service
diff --git a/tests/acceptance/test_acc_confirm_release.py b/tests/acceptance/test_acc_confirm_release.py
new file mode 100644
index 0000000..8ac9368
--- /dev/null
+++ b/tests/acceptance/test_acc_confirm_release.py
@@ -0,0 +1,207 @@
+"""SPEC acceptance criteria 18-27: Confirm, Release, Lookup."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+
+HOLD_LIFETIME = timedelta(minutes=20)  # SPEC: default hold lifetime
+
+
+def _status(name):
+    return getattr(models.ReservationStatus, name)
+
+
+def _lines(order):
+    return {line.sku: line.quantity for line in order.lines}
+
+
+# -- 18: confirm creates a normal PLACED order ------------------------------------
+def test_18_confirm_creates_placed_order_for_held_items(stocked, repo, clock):
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert _lines(order) == {"MUG": 3, "TEE": 2}
+    assert order.placed_at == clock.now()
+    assert repo.get_order(order.order_id) is not None
+
+
+def test_18_partial_hold_orders_only_held_units(stocked):
+    r = stocked.reserve("WH1", {"MUG": 15, "TEE": 2, "CAP": 4}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert _lines(order) == {"MUG": 10, "TEE": 2}
+
+
+def test_18_confirm_uses_usual_order_id_sequence(stocked):
+    first = stocked.place_order("WH1", {"MUG": 1})
+    r = stocked.reserve("WH1", {"MUG": 1}, "k")
+    confirmed = stocked.confirm_reservation(r.reservation_id)
+    last = stocked.place_order("WH1", {"MUG": 1})
+    assert (first.order_id, confirmed.order_id, last.order_id) == (
+        "ORD-0001", "ORD-0002", "ORD-0003"
+    )
+
+
+def test_18_confirm_in_other_warehouse(stocked):
+    r = stocked.reserve("WH2", {"MUG": 2}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert order.warehouse == "WH2"
+    assert stocked.allocated("MUG", "WH2") == 2
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+# -- 19: after the first confirm ----------------------------------------------------
+def test_19_reservation_becomes_confirmed_with_order_id(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.status is _status("CONFIRMED")
+    assert got.order_id == order.order_id
+
+
+def test_19_confirm_moves_held_to_allocated_without_changing_available(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 5}, "k")
+    before = (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1"))
+    assert stocked.allocated("MUG", "WH1") == 0
+    stocked.confirm_reservation(r.reservation_id)
+    after = (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1"))
+    assert before == after == (7, 0)
+    assert stocked.allocated("MUG", "WH1") == 3
+    assert stocked.allocated("TEE", "WH1") == 5
+
+
+def test_19_confirmed_order_does_not_expire_with_hold(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.confirm_reservation(r.reservation_id)
+    clock.advance(HOLD_LIFETIME * 2)
+    assert stocked.available("MUG", "WH1") == 7
+
+
+# -- 20: confirm does not re-check stock --------------------------------------------
+def test_20_confirm_after_writeoff_succeeds_or_raises_insufficient_stock(stocked, ledger):
+    r = stocked.reserve("WH1", {"MUG": 8}, "k")
+    stocked.adjust("MUG", "WH1", -5, note="broken")
+    entries = len(ledger)
+    try:
+        order = stocked.confirm_reservation(r.reservation_id)
+    except errors.InsufficientStock:
+        assert stocked.get_reservation(r.reservation_id).status is _status("ACTIVE")
+    else:
+        assert _lines(order) == {"MUG": 8}
+        assert stocked.get_reservation(r.reservation_id).status is _status("CONFIRMED")
+    assert len(ledger) == entries
+    assert stocked.on_hand("MUG", "WH1") == 5
+
+
+# -- 21: confirming a CONFIRMED reservation is idempotent ---------------------------
+@pytest.mark.parametrize("later", ["nothing", "lifetime_passed", "shipped", "cancelled"])
+def test_21_reconfirm_returns_same_order_and_creates_nothing(stocked, repo, clock, later):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    if later == "lifetime_passed":
+        clock.advance(HOLD_LIFETIME * 3)
+    elif later == "shipped":
+        stocked.ship_order(order.order_id)
+    elif later == "cancelled":
+        stocked.cancel_order(order.order_id)
+    orders_before = len(repo.orders())
+    status_before = repo.get_order(order.order_id).status
+    available_before = stocked.available("MUG", "WH1")
+
+    again = stocked.confirm_reservation(r.reservation_id)
+
+    assert again.order_id == order.order_id
+    assert len(repo.orders()) == orders_before
+    assert repo.get_order(order.order_id).status is status_before
+    assert stocked.available("MUG", "WH1") == available_before
+    assert stocked.get_reservation(r.reservation_id).status is _status("CONFIRMED")
+
+
+def test_21_reconfirm_does_not_consume_order_id(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.confirm_reservation(r.reservation_id)
+    stocked.confirm_reservation(r.reservation_id)
+    assert stocked.place_order("WH1", {"MUG": 1}).order_id == "ORD-0002"
+
+
+# -- 22 / 23: confirm of expired / released ---------------------------------------
+def test_22_confirm_expired_raises_and_creates_no_order(stocked, repo, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    clock.advance(HOLD_LIFETIME)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(r.reservation_id).status is _status("EXPIRED")
+
+
+def test_23_confirm_released_raises_and_creates_no_order(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.release_reservation(r.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(r.reservation_id).status is _status("RELEASED")
+
+
+def test_23_confirm_released_raises_even_after_lifetime(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.release_reservation(r.reservation_id)
+    clock.advance(HOLD_LIFETIME)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.confirm_reservation(r.reservation_id)
+
+
+# -- 24: release an ACTIVE reservation ----------------------------------------------
+def test_24_release_sets_released_and_frees_units(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 5}, "k")
+    released = stocked.release_reservation(r.reservation_id)
+    assert released.status is _status("RELEASED")
+    assert released.reservation_id == r.reservation_id
+    assert stocked.get_reservation(r.reservation_id).status is _status("RELEASED")
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+
+
+# -- 25: release is a no-op on RELEASED / EXPIRED -----------------------------------
+def test_25_release_released_returns_it_unchanged(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.release_reservation(r.reservation_id)
+    again = stocked.release_reservation(r.reservation_id)
+    assert again.status is _status("RELEASED")
+    assert again.reservation_id == r.reservation_id
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_25_release_expired_returns_it_unchanged(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    clock.advance(HOLD_LIFETIME)
+    again = stocked.release_reservation(r.reservation_id)
+    assert again.status is _status("EXPIRED")
+    assert stocked.get_reservation(r.reservation_id).status is _status("EXPIRED")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 26: release a CONFIRMED reservation ---------------------------------------------
+def test_26_release_confirmed_raises_and_keeps_order(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.release_reservation(r.reservation_id)
+    assert stocked.get_reservation(r.reservation_id).status is _status("CONFIRMED")
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+# -- 27: unknown ids ----------------------------------------------------------------
+@pytest.mark.parametrize(
+    "method", ["get_reservation", "confirm_reservation", "release_reservation"]
+)
+def test_27_unknown_id_raises_reservation_not_found(stocked, method):
+    stocked.reserve("WH1", {"MUG": 1}, "k")
+    with pytest.raises(errors.ReservationNotFound):
+        getattr(stocked, method)("no-such-reservation")

@@ -0,0 +1,180 @@
+"""SPEC acceptance criteria 9-12: Idempotency."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+HOLD_LIFETIME = timedelta(minutes=20)  # SPEC: default hold lifetime
+
+
+def _status(name):
+    return getattr(models.ReservationStatus, name)
+
+
+# -- 9: keys are global and never expire --------------------------------------------
+def test_9_key_is_global_across_warehouses(stocked):
+    stocked.reserve("WH1", {"MUG": 1}, "k")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 1}, "k")
+    assert stocked.available("MUG", "WH2") == 7
+
+
+def test_9_key_never_expires(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 1}, "k")
+    clock.advance(days=400)
+    again = stocked.reserve("WH1", {"MUG": 1}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert again.status is _status("EXPIRED")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2}, "k")
+
+
+# -- 10: retries return the existing reservation ---------------------------------
+def test_10_retry_of_active_returns_existing_without_new_hold(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    again = stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert again.status is _status("ACTIVE")
+    assert again.items == {"MUG": 3}
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_10_retry_does_not_move_expiry(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    clock.advance(minutes=10)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert again.expires_at == r.expires_at
+    assert stocked.get_reservation(r.reservation_id).expires_at == r.expires_at
+    clock.advance(minutes=10)  # original expiry reached
+    assert stocked.get_reservation(r.reservation_id).status is _status("EXPIRED")
+
+
+def test_10_retry_of_confirmed_returns_confirmed(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert again.status is _status("CONFIRMED")
+    assert again.order_id == order.order_id
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+def test_10_retry_of_released_returns_released_without_new_hold(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    stocked.release_reservation(r.reservation_id)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert again.status is _status("RELEASED")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_10_retry_of_expired_returns_expired_without_new_hold(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    clock.advance(HOLD_LIFETIME)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert again.status is _status("EXPIRED")
+    assert again.expires_at == r.expires_at
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_10_comparison_ignores_key_order(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k")
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert stocked.available("MUG", "WH1") == 8
+    assert stocked.available("TEE", "WH1") == 4
+
+
+def test_10_comparison_uses_requested_not_held_items(stocked):
+    r = stocked.reserve("WH1", {"MUG": 15, "CAP": 2}, "k")
+    assert r.items == {"MUG": 10}
+    again = stocked.reserve("WH1", {"MUG": 15, "CAP": 2}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert again.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_10_held_items_as_request_is_a_conflict_after_partial_hold(stocked):
+    stocked.reserve("WH1", {"MUG": 15}, "k")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k")
+
+
+def test_10_retry_after_stock_arrives_holds_no_more(stocked):
+    r = stocked.reserve("WH1", {"MUG": 15}, "k")
+    stocked.receive("MUG", "WH1", 20)
+    again = stocked.reserve("WH1", {"MUG": 15}, "k")
+    assert again.reservation_id == r.reservation_id
+    assert again.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 20
+
+
+# -- 11: conflicts ---------------------------------------------------------------------
+def test_11_different_items_conflict(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4}, "k")
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_11_extra_line_conflicts(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k")
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_11_different_warehouse_conflicts(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 3}, "k")
+
+
+@pytest.mark.parametrize("finish", ["confirm", "release", "expire"])
+def test_11_conflict_even_when_original_is_finished(stocked, clock, finish):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    if finish == "confirm":
+        stocked.confirm_reservation(r.reservation_id)
+    elif finish == "release":
+        stocked.release_reservation(r.reservation_id)
+    else:
+        clock.advance(HOLD_LIFETIME)
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 1}, "k")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 3}, "k")
+
+
+# -- 12: a failed reserve leaves no trace -----------------------------------------
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [
+        ("NOPE", {"MUG": 1}),
+        ("WH1", {"NOPE": 1}),
+        ("WH1", {"MUG": 0}),
+        ("WH1", {}),
+        ("WH1", {"CAP": 1}),  # InsufficientStock
+    ],
+)
+def test_12_failed_reserve_leaves_key_unused(stocked, warehouse, items):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve(warehouse, items, "k")
+    r = stocked.reserve("WH1", {"MUG": 2}, "k")
+    assert r.status is _status("ACTIVE")
+    assert r.items == {"MUG": 2}
+    assert stocked.available("MUG", "WH1") == 8
+
+
+def test_12_retry_after_insufficient_stock_is_treated_as_new(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k")
+    stocked.receive("CAP", "WH1", 5)
+    r = stocked.reserve("WH1", {"CAP": 2}, "k")
+    assert r.status is _status("ACTIVE")
+    assert r.items == {"CAP": 2}
+    assert stocked.available("CAP", "WH1") == 3

+
+
+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A temporary hold on stock for a cart, in a single warehouse.
+
+    An ACTIVE reservation holds ``items`` (units per SKU) until ``expires_at``;
+    holds are not stock movements and never touch the ledger. Confirming turns
+    the hold into a PLACED order, recorded in ``order_id``.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None

+"""SPEC: Interface (fixed), plus criterion 35."""
+
+import dataclasses
+from datetime import datetime, timedelta
+
+import inventory
+import inventory.errors as errors
+import inventory.models as models
+from inventory import InventoryService, Ledger
+
+HOLD_LIFETIME = timedelta(minutes=20)  # SPEC: default hold lifetime
+
+
+def test_reservation_status_members():
+    names = {member.name for member in models.ReservationStatus}
+    assert names == {"ACTIVE", "CONFIRMED", "RELEASED", "EXPIRED"}
+
+
+def test_reservation_is_dataclass_with_spec_fields():
+    assert dataclasses.is_dataclass(models.Reservation)
+    names = {f.name for f in dataclasses.fields(models.Reservation)}
+    assert {"reservation_id", "warehouse", "items", "status", "expires_at", "order_id"} <= names
+
+
+def test_reserve_returns_reservation_instance(stocked):
+    r = stocked.reserve("WH1", {"MUG": 1}, "k-1")
+    assert isinstance(r, models.Reservation)
+    assert isinstance(r.reservation_id, str)
+    assert isinstance(r.expires_at, datetime)
+
+
+def test_new_errors_subclass_inventory_error():
+    for name in ("ReservationNotFound", "ReservationExpired",
+                 "InvalidReservationState", "IdempotencyConflict"):
+        cls = getattr(errors, name)
+        assert issubclass(cls, errors.InventoryError), name
+
+
+def test_three_argument_constructor_still_works_with_default_lifetime(repo, clock):
+    service = InventoryService(repo, Ledger(), clock)
+    service.receive("MUG", "WH1", 3)
+    r = service.reserve("WH1", {"MUG": 1}, "k-ctor")
+    assert r.expires_at == clock.now() + HOLD_LIFETIME
+
+
+# -- 35 ---------------------------------------------------------------------
+def test_35_reservation_types_exported_from_top_level_package():
+    assert inventory.Reservation is models.Reservation
+    assert inventory.ReservationStatus is models.ReservationStatus
diff --git a/tests/acceptance/test_acc_reserve.py b/tests/acceptance/test_acc_reserve.py

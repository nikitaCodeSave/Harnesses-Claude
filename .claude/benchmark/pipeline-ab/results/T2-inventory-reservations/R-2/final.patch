@@ -0,0 +1,119 @@
+"""SPEC acceptance criteria 13-17: Expiry."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+HOLD_LIFETIME = timedelta(minutes=20)  # SPEC: default hold lifetime
+
+
+def _status(name):
+    return getattr(models.ReservationStatus, name)
+
+
+# -- 13: expired once now >= expires_at -----------------------------------------
+def test_13_still_active_just_before_expiry(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.set(r.expires_at - timedelta(microseconds=1))
+    assert stocked.get_reservation(r.reservation_id).status is _status("ACTIVE")
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_13_expired_at_exactly_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.set(r.expires_at)
+    assert stocked.get_reservation(r.reservation_id).status is _status("EXPIRED")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_13_default_lifetime_is_twenty_minutes(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.advance(minutes=19, seconds=59)
+    assert stocked.get_reservation(r.reservation_id).status is _status("ACTIVE")
+    clock.advance(seconds=1)
+    assert stocked.get_reservation(r.reservation_id).status is _status("EXPIRED")
+
+
+# -- 14: takes effect without a sweep -------------------------------------------
+def test_14_expired_units_are_available_again(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 4, "TEE": 5}, "k")
+    clock.advance(HOLD_LIFETIME)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_14_expired_units_can_be_ordered(stocked, clock):
+    stocked.reserve("WH1", {"TEE": 5}, "k")
+    clock.advance(HOLD_LIFETIME)
+    order = stocked.place_order("WH1", {"TEE": 5})
+    assert order.quantity_of("TEE") == 5
+
+
+def test_14_expired_units_can_be_reserved_again(stocked, clock):
+    stocked.reserve("WH1", {"TEE": 5}, "k-1")
+    clock.advance(HOLD_LIFETIME)
+    r = stocked.reserve("WH1", {"TEE": 5}, "k-2")
+    assert r.items == {"TEE": 5}
+
+
+def test_14_release_reports_expired(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.advance(HOLD_LIFETIME)
+    assert stocked.release_reservation(r.reservation_id).status is _status("EXPIRED")
+
+
+def test_14_retry_reports_expired(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.advance(HOLD_LIFETIME)
+    assert stocked.reserve("WH1", {"MUG": 4}, "k").status is _status("EXPIRED")
+
+
+def test_14_confirm_treats_it_as_expired(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.advance(HOLD_LIFETIME)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+
+
+# -- 15: expired reservations can still be fetched ---------------------------------
+def test_15_expired_reservation_is_fetchable(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.advance(days=30)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.reservation_id == r.reservation_id
+    assert got.status is _status("EXPIRED")
+    assert got.warehouse == "WH1"
+    assert got.order_id is None
+
+
+# -- 16: only ACTIVE expires ---------------------------------------------------------
+def test_16_confirmed_never_expires(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    stocked.confirm_reservation(r.reservation_id)
+    clock.advance(days=30)
+    assert stocked.get_reservation(r.reservation_id).status is _status("CONFIRMED")
+    assert stocked.allocated("MUG", "WH1") == 4
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_16_released_never_expires(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    stocked.release_reservation(r.reservation_id)
+    clock.advance(days=30)
+    assert stocked.get_reservation(r.reservation_id).status is _status("RELEASED")
+
+
+# -- 17: holds cannot be extended or refreshed -----------------------------------
+def test_17_activity_does_not_refresh_hold(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k")
+    clock.advance(minutes=15)
+    stocked.get_reservation(r.reservation_id)
+    stocked.reserve("WH1", {"MUG": 4}, "k")
+    stocked.available("MUG", "WH1")
+    clock.advance(minutes=5)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.expires_at == r.expires_at
+    assert got.status is _status("EXPIRED")
diff --git a/tests/acceptance/test_acc_idempotency.py b/tests/acceptance/test_acc_idempotency.py

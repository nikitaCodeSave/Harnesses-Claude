@@ -0,0 +1,150 @@
+"""SPEC acceptance criteria 1-8: Reserve."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+HOLD_LIFETIME = timedelta(minutes=20)  # SPEC: default hold lifetime
+
+
+# -- 1: validation like place_order -------------------------------------------
+def test_1_unknown_warehouse(stocked):
+    with pytest.raises(errors.UnknownWarehouse):
+        stocked.reserve("NOPE", {"MUG": 1}, "k")
+
+
+def test_1_unknown_sku(stocked):
+    with pytest.raises(errors.UnknownSku):
+        stocked.reserve("WH1", {"NOPE": 1}, "k")
+
+
+@pytest.mark.parametrize("quantity", [0, -1, 1.5, "2", None, True, False])
+def test_1_quantity_must_be_positive_int(stocked, quantity):
+    with pytest.raises(errors.InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": quantity}, "k")
+
+
+def test_1_empty_items(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {}, "k")
+
+
+def test_1_empty_idempotency_key(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {"MUG": 1}, "")
+
+
+# -- 2: a rejected request holds nothing ----------------------------------------
+@pytest.mark.parametrize(
+    "items, error",
+    [
+        ({"MUG": 2, "TEE": 0}, "InvalidQuantity"),
+        ({"MUG": 2, "NOPE": 1}, "UnknownSku"),
+        ({"MUG": 2, "TEE": True}, "InvalidQuantity"),
+    ],
+)
+def test_2_rejected_request_holds_nothing_for_valid_lines(stocked, items, error):
+    with pytest.raises(getattr(errors, error)):
+        stocked.reserve("WH1", items, "k")
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_2_empty_key_holds_nothing(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {"MUG": 2}, "")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 3: not all-or-nothing --------------------------------------------------------
+def test_3_each_line_holds_min_of_requested_and_available(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4, "TEE": 8}, "k")
+    assert r.items == {"MUG": 4, "TEE": 5}
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.available("TEE", "WH1") == 0
+
+
+def test_3_partial_hold_accounts_for_existing_holds_and_orders(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k-a")
+    r = stocked.reserve("WH1", {"MUG": 9}, "k-b")
+    assert r.items == {"MUG": 3}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+# -- 4: zero-available lines are omitted ------------------------------------------
+def test_4_line_with_nothing_available_is_left_out(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2, "CAP": 3}, "k")
+    assert r.items == {"MUG": 2}
+    assert "CAP" not in r.items
+
+
+def test_4_line_exhausted_by_other_hold_is_left_out(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k-a")
+    r = stocked.reserve("WH1", {"MUG": 1, "TEE": 1}, "k-b")
+    assert r.items == {"MUG": 1}
+
+
+# -- 5: nothing holdable -> InsufficientStock, no reservation ------------------
+def test_5_nothing_holdable_raises_insufficient_stock(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k")
+
+
+def test_5_nothing_holdable_creates_no_reservation(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k-a")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"TEE": 2, "CAP": 1}, "k-b")
+    assert stocked.available("TEE", "WH1") == 0
+    # No reservation was recorded under the key: it is still free (see 12).
+    stocked.receive("CAP", "WH1", 1)
+    r = stocked.reserve("WH1", {"CAP": 1}, "k-b")
+    assert r.items == {"CAP": 1}
+    assert r.status is models.ReservationStatus.ACTIVE
+
+
+# -- 6: shape of a new reservation ------------------------------------------------
+def test_6_new_reservation_is_active_without_order(stocked, clock):
+    clock.advance(minutes=7)
+    r = stocked.reserve("WH1", {"MUG": 2}, "k")
+    assert r.status is models.ReservationStatus.ACTIVE
+    assert r.order_id is None
+    assert r.warehouse == "WH1"
+    assert r.expires_at == clock.now() + HOLD_LIFETIME
+
+
+def test_6_get_reservation_matches_returned(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k")
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.reservation_id == r.reservation_id
+    assert got.status is models.ReservationStatus.ACTIVE
+    assert got.items == {"MUG": 2}
+    assert got.expires_at == r.expires_at
+    assert got.order_id is None
+
+
+# -- 7: unique ids ------------------------------------------------------------------
+def test_7_each_reservation_gets_unique_id(stocked):
+    ids = {
+        stocked.reserve("WH1", {"MUG": 1}, "k-1").reservation_id,
+        stocked.reserve("WH1", {"MUG": 1}, "k-2").reservation_id,
+        stocked.reserve("WH2", {"MUG": 1}, "k-3").reservation_id,
+    }
+    assert len(ids) == 3
+
+
+# -- 8: holds lower available, per warehouse ------------------------------------------
+def test_8_active_hold_lowers_available_in_its_warehouse_only(stocked):
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k")
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.available("TEE", "WH1") == 3
+    assert stocked.available("MUG", "WH2") == 7
+
+
+def test_8_multiple_holds_add_up(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k-1")
+    stocked.reserve("WH1", {"MUG": 4}, "k-2")
+    assert stocked.available("MUG", "WH1") == 3
diff --git a/tests/acceptance/test_acc_stock_interaction.py b/tests/acceptance/test_acc_stock_interaction.py
new file mode 100644
index 0000000..89cf59b
--- /dev/null
+++ b/tests/acceptance/test_acc_stock_interaction.py
@@ -0,0 +1,194 @@
+"""SPEC acceptance criteria 28-34 and 36: interaction with stock and orders."""
+
+import dataclasses
+import subprocess
+import sys
+from datetime import timedelta
+from pathlib import Path
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+from inventory.reports import stock_report
+
+HOLD_LIFETIME = timedelta(minutes=20)  # SPEC: default hold lifetime
+EXISTING_STOCKROW_FIELDS = {"sku", "on_hand", "allocated", "available"}
+
+
+def _status(name):
+    return getattr(models.ReservationStatus, name)
+
+
+# -- 28: holds are not stock movements ----------------------------------------------
+def test_28_reservation_operations_never_touch_ledger_or_on_hand(stocked, ledger, clock):
+    entries = len(ledger)
+
+    a = stocked.reserve("WH1", {"MUG": 3}, "k-a")
+    b = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k-b")
+    c = stocked.reserve("WH1", {"TEE": 2}, "k-c")
+    stocked.reserve("WH1", {"MUG": 3}, "k-a")  # retry
+    stocked.release_reservation(a.reservation_id)
+    stocked.confirm_reservation(b.reservation_id)
+    clock.advance(HOLD_LIFETIME)  # c expires
+    stocked.get_reservation(c.reservation_id)
+    stocked.available("TEE", "WH1")
+
+    assert len(ledger) == entries
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.on_hand("TEE", "WH1") == 5
+
+
+def test_28_on_hand_drops_only_when_resulting_order_ships(stocked, ledger):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert stocked.on_hand("MUG", "WH1") == 10
+    stocked.ship_order(order.order_id)
+    assert stocked.on_hand("MUG", "WH1") == 7
+    assert ledger.entries(sku="MUG", warehouse="WH1")[-1].ref == order.order_id
+
+
+# -- 29: receive and adjust are never blocked by holds ------------------------------
+def test_29_receive_not_blocked_by_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k")
+    stocked.receive("MUG", "WH1", 4)
+    assert stocked.on_hand("MUG", "WH1") == 14
+    assert stocked.available("MUG", "WH1") == 4
+
+
+def test_29_adjust_not_blocked_by_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k")
+    stocked.adjust("MUG", "WH1", -10, note="flood")
+    assert stocked.on_hand("MUG", "WH1") == 0
+    stocked.adjust("MUG", "WH1", 2, note="recount")
+    assert stocked.on_hand("MUG", "WH1") == 2
+
+
+# -- 30: write-off below held ---------------------------------------------------------
+def test_30_writeoff_below_held_shows_zero_and_leaves_reservation(stocked):
+    r = stocked.reserve("WH1", {"MUG": 8}, "k")
+    stocked.adjust("MUG", "WH1", -6, note="broken")
+    assert stocked.available("MUG", "WH1") == 0
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.status is _status("ACTIVE")
+    assert got.items == {"MUG": 8}
+    assert got.expires_at == r.expires_at
+
+
+# -- 31: place_order excludes holds, stays all-or-nothing ---------------------------
+def test_31_place_order_cannot_take_held_stock(stocked, repo):
+    stocked.reserve("WH1", {"MUG": 7}, "k")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 4})
+    order = stocked.place_order("WH1", {"MUG": 3})
+    assert order.quantity_of("MUG") == 3
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_31_place_order_stays_all_or_nothing_with_holds(stocked, repo):
+    stocked.reserve("WH1", {"TEE": 4}, "k")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 2, "TEE": 2})
+    assert repo.orders() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_31_place_order_can_take_released_stock(stocked):
+    r = stocked.reserve("WH1", {"TEE": 5}, "k")
+    stocked.release_reservation(r.reservation_id)
+    assert stocked.place_order("WH1", {"TEE": 5}).quantity_of("TEE") == 5
+
+
+# -- 32: confirmed order follows normal lifecycle ----------------------------------
+def test_32_shipping_order_keeps_reservation_confirmed(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    shipped = stocked.ship_order(order.order_id)
+    assert shipped.status is OrderStatus.SHIPPED
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.status is _status("CONFIRMED")
+    assert got.order_id == order.order_id
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_32_cancelling_order_keeps_reservation_confirmed(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k")
+    order = stocked.confirm_reservation(r.reservation_id)
+    cancelled = stocked.cancel_order(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.status is _status("CONFIRMED")
+    assert got.order_id == order.order_id
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 33: allocated() excludes holds ---------------------------------------------------
+def test_33_allocated_counts_only_placed_orders(stocked):
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 3}, "k")
+    assert stocked.allocated("MUG", "WH1") == 2
+    assert stocked.available("MUG", "WH1") == 5
+
+
+# -- 34: stock_report shows held units -------------------------------------------------
+def _held_field_values(row):
+    return {
+        f.name: getattr(row, f.name)
+        for f in dataclasses.fields(row)
+        if f.name not in EXISTING_STOCKROW_FIELDS
+    }
+
+
+def test_34_stock_report_rows_show_held_units(stocked, repo, clock):
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k-1")
+    stocked.reserve("WH1", {"TEE": 2}, "k-2")
+    rows = {row.sku: row for row in stock_report(repo, stocked, "WH1")}
+
+    # Existing fields keep their meaning.
+    assert (rows["MUG"].on_hand, rows["MUG"].allocated, rows["MUG"].available) == (10, 2, 5)
+    assert (rows["TEE"].on_hand, rows["TEE"].allocated, rows["TEE"].available) == (5, 0, 2)
+    assert (rows["CAP"].on_hand, rows["CAP"].allocated, rows["CAP"].available) == (0, 0, 0)
+
+    # A new field carries the held units per SKU (its name is not fixed by the spec).
+    extra = {sku: _held_field_values(row) for sku, row in rows.items()}
+    candidates = [
+        name for name in extra["MUG"]
+        if extra["MUG"][name] == 3 and extra["TEE"][name] == 3 and extra["CAP"][name] == 0
+    ]
+    assert candidates, f"no StockRow field shows held units: {extra}"
+
+
+def test_34_stock_report_held_units_drop_after_expiry(stocked, repo, clock):
+    stocked.reserve("WH1", {"MUG": 3}, "k")
+    before = _held_field_values(
+        next(r for r in stock_report(repo, stocked, "WH1") if r.sku == "MUG")
+    )
+    held_fields = [name for name, value in before.items() if value == 3]
+    assert held_fields, f"no StockRow field shows held units: {before}"
+    clock.advance(HOLD_LIFETIME)
+    after_row = next(r for r in stock_report(repo, stocked, "WH1") if r.sku == "MUG")
+    assert all(getattr(after_row, name) == 0 for name in held_fields)
+    assert after_row.available == 10

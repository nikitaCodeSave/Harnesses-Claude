+# -- confirm -------------------------------------------------------------
+def test_confirm_creates_order_for_held_units(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 2, "CAP": 1}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.placed_at == clock.now()
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 10, "TEE": 2}
+    current = stocked.get_reservation(res.reservation_id)
+    assert (current.status, current.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+
+
+def test_confirm_does_not_change_available(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.allocated("MUG", "WH1") == 4
+
+
+def test_confirm_twice_returns_same_order_even_after_ttl(stocked, clock, repo):

+++ b/tests/test_reservations.py
@@ -0,0 +1,283 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 3)
+    return service
+
+
+# -- reserve -------------------------------------------------------------
+def test_reserve_holds_stock_and_reduces_available(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.items == {"MUG": 4, "TEE": 2}
+    assert res.warehouse == "WH1"
+    assert res.order_id is None
+    assert res.expires_at == clock.now() + TTL
+    assert (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1")) == (6, 3)
+
+
+def test_reserve_never_touches_ledger(stocked, ledger):
+    before = len(ledger)
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    other = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    stocked.release_reservation(other.reservation_id)
+    assert len(ledger) == before
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_reserve_is_partial(stocked):
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 3}, "k1")
+    assert res.items == {"MUG": 10, "TEE": 3}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_reserve_omits_lines_with_nothing_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2, "CAP": 1}, "k1")
+    assert res.items == {"MUG": 2}
+
+
+def test_reserve_fails_when_nothing_can_be_held(stocked, repo):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert repo.reservations() == []
+
+
+def test_failed_reserve_leaves_no_trace_of_its_key(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    stocked.receive("CAP", "WH1", 1)
+    assert stocked.reserve("WH1", {"CAP": 1}, "k1").items == {"CAP": 1}
+
+
+def test_holds_count_against_each_other(stocked):
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    second = stocked.reserve("WH1", {"TEE": 4}, "k2")
+    assert second.items == {"TEE": 1}
+
+
+def test_holds_count_against_place_order(stocked):
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2})
+
+
+def test_orders_count_against_reserve(stocked):
+    stocked.place_order("WH1", {"TEE": 4})
+    assert stocked.reserve("WH1", {"TEE": 3}, "k1").items == {"TEE": 1}
+
+
+def test_hold_is_per_warehouse(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert stocked.available("MUG", "WH2") == 3
+
+
+@pytest.mark.parametrize(
+    ("warehouse", "items", "error"),
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": -1}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_invalid_request_holds_nothing(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- idempotency ---------------------------------------------------------
+def test_same_key_same_request_returns_existing(stocked, repo):
+    first = stocked.reserve("WH1", {"MUG": 4, "TEE": 1}, "k1")
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 4}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert len(repo.reservations()) == 1
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_same_request_means_what_was_asked_not_what_was_held(stocked):
+    first = stocked.reserve("WH1", {"MUG": 12, "CAP": 1}, "k1")
+    assert first.items == {"MUG": 10}
+    assert stocked.reserve("WH1", {"MUG": 12, "CAP": 1}, "k1") is first
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_replay_does_not_extend_the_hold(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(minutes=10)
+    assert stocked.reserve("WH1", {"MUG": 1}, "k1").expires_at == first.expires_at
+
+
+@pytest.mark.parametrize(
+    ("warehouse", "items"),
+    [("WH2", {"MUG": 1}), ("WH1", {"MUG": 2}), ("WH1", {"MUG": 1, "TEE": 1})],
+)
+def test_same_key_different_request_conflicts(stocked, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+
+
+@pytest.mark.parametrize("finish", ["confirm", "release", "expire"])
+def test_replay_returns_reservation_in_current_state(stocked, clock, repo, finish):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    if finish == "confirm":
+        stocked.confirm_reservation(res.reservation_id)
+    elif finish == "release":
+        stocked.release_reservation(res.reservation_id)
+    else:
+        clock.advance(TTL)
+    expected = {
+        "confirm": ReservationStatus.CONFIRMED,
+        "release": ReservationStatus.RELEASED,
+        "expire": ReservationStatus.EXPIRED,
+    }[finish]
+    again = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert (again.reservation_id, again.status) == (res.reservation_id, expected)
+    assert len(repo.reservations()) == 1
+
+
+# -- expiry --------------------------------------------------------------
+def test_hold_is_active_just_before_expiry(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_hold_expires_at_expires_at_without_a_sweep(stocked, clock):

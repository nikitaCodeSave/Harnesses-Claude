+# -- confirm ---------------------------------------------------------------
+def test_confirm_places_order_for_held_units(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 2}, "k1")
+    clock.advance(minutes=19)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 10, "TEE": 2}
+    assert res.status is ReservationStatus.CONFIRMED
+    assert res.order_id == order.order_id
+    assert (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1")) == (0, 3)
+    assert (stocked.held("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (0, 10)
+
+
+def test_confirm_twice_returns_same_order_even_after_ttl(stocked, repo, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    assert stocked.confirm_reservation(res.reservation_id) is order
+    assert len(repo.orders()) == 1
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.CONFIRMED
+

+"""SPEC.md acceptance criteria 6-10: availability."""
+
+import dataclasses
+from datetime import timedelta
+
+from inventory import models
+from inventory.reports import StockRow, stock_report
+
+HOLD = timedelta(minutes=20)
+
+
+# -- 6. available = on-hand - allocated - active holds, floored at 0 ----------
+def test_available_subtracts_allocations_and_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 10 - 3 - 4
+
+
+def test_available_sums_holds_from_several_reservations(stocked):
+    stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k2")
+    assert stocked.available("MUG", "WH1") == 5
+    assert stocked.available("TEE", "WH1") == 4
+
+
+def test_holds_only_count_for_their_own_sku_and_warehouse(stocked):
+    stocked.reserve("WH1", {"MUG": 6}, "k1")
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH2") == 4
+
+
+def test_only_active_unexpired_reservations_hold_stock(stocked, clock):
+    released = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    stocked.release_reservation(released.reservation_id)
+    confirmed = stocked.reserve("WH1", {"MUG": 2}, "k2")
+    stocked.confirm_reservation(confirmed.reservation_id)  # becomes an allocation
+    stocked.reserve("WH1", {"MUG": 3}, "k3")
+    clock.advance(minutes=10)
+    stocked.reserve("WH1", {"MUG": 4}, "k4")
+    clock.advance(minutes=10)  # k3 has lapsed, k4 has not
+    assert stocked.available("MUG", "WH1") == 10 - 2 - 4
+
+
+def test_available_is_floored_at_zero(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.adjust("MUG", "WH1", -4, "breakage")
+    assert stocked.available("MUG", "WH1") == 0
+
+
+# -- 7. allocated counts only PLACED orders; on-hand unaffected ---------------
+def test_allocated_does_not_include_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 5}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 2
+
+
+def test_on_hand_is_not_affected_by_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 5, "TEE": 5}, "k1")
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.on_hand("TEE", "WH1") == 5
+
+
+# -- 8. stock_report unchanged, available column reflects holds ---------------
+def test_stock_row_fields_are_unchanged():
+    assert [f.name for f in dataclasses.fields(StockRow)] == [
+        "sku",
+        "on_hand",
+        "allocated",
+        "available",
+    ]
+
+
+def test_stock_report_available_reflects_holds(stocked, repo):
+    stocked.place_order("WH1", {"MUG": 1})
+    stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    assert stock_report(repo, stocked, "WH1") == [
+        StockRow("CAP", 0, 0, 0),
+        StockRow("MUG", 10, 1, 5),
+        StockRow("TEE", 5, 0, 3),
+    ]
+
+
+# -- 9. release / expiry frees units immediately ------------------------------
+def test_release_frees_units_immediately(stocked):
+    res = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_expiry_frees_units_at_the_exact_instant(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(res.expires_at)
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_freed_units_can_be_reserved_again(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.advance(HOLD)
+    again = stocked.reserve("WH1", {"MUG": 10}, "k2")
+    assert again.items == {"MUG": 10}
+
+
+# -- 10. receive / adjust are never blocked by holds -------------------------
+def test_receive_is_not_blocked_by_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.receive("MUG", "WH1", 3)
+    assert stocked.on_hand("MUG", "WH1") == 13
+    assert stocked.available("MUG", "WH1") == 3
+
+
+def test_write_off_below_held_units_is_allowed(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -10, "flood")
+    assert stocked.on_hand("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_write_off_leaves_reservation_unchanged(stocked):
+    res = stocked.reserve("WH1", {"MUG": 8, "TEE": 2}, "k1")
+    stocked.adjust("MUG", "WH1", -5, "breakage")
+    after = stocked.get_reservation(res.reservation_id)
+    assert after.status is models.ReservationStatus.ACTIVE
+    assert after.items == {"MUG": 8, "TEE": 2}
+    assert after.expires_at == res.expires_at
+    assert stocked.available("MUG", "WH1") == 0

@@ -0,0 +1,90 @@
+"""SPEC.md acceptance criteria 36-37: compatibility."""
+
+import re
+import subprocess
+import sys
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+
+from inventory import FixedClock, InventoryService, models
+
+ROOT = Path(__file__).resolve().parents[2]
+PACKAGE = ROOT / "src" / "inventory"
+
+
+# -- 36. the existing suite passes unchanged --------------------------------
+def test_existing_test_suite_passes():
+    result = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "pytest",
+            "-q",
+            "-p",
+            "no:cacheprovider",
+            "tests",
+            "--ignore=tests/acceptance",
+        ],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+def test_existing_tests_are_unmodified():
+    probe = subprocess.run(
+        ["git", "rev-parse", "--verify", "HEAD"], cwd=ROOT, capture_output=True, text=True
+    )
+    if probe.returncode != 0:
+        pytest.skip("not a git checkout")
+    existing = [
+        str(p.relative_to(ROOT)) for p in (ROOT / "tests").glob("*.py")
+    ]
+    diff = subprocess.run(
+        ["git", "diff", "--name-only", "HEAD", "--", *existing],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+    )
+    assert diff.stdout.strip() == ""
+
+
+# -- 37. no package code reads the wall clock --------------------------------
+WALL_CLOCK = [
+    re.compile(r"\b(datetime|date)\s*\.\s*(now|utcnow|today)\s*\("),
+    re.compile(r"\btime\s*\.\s*(time|time_ns|monotonic|monotonic_ns|perf_counter|localtime|gmtime|ctime)\s*\("),
+    re.compile(r"^\s*from\s+time\s+import\b", re.MULTILINE),
+]
+
+
+def test_package_source_never_reads_the_wall_clock():
+    offenders = []
+    for path in sorted(PACKAGE.rglob("*.py")):
+        source = path.read_text()
+        for pattern in WALL_CLOCK:
+            for match in pattern.finditer(source):
+                offenders.append(f"{path.name}: {match.group(0).strip()}")
+    assert offenders == []
+
+
+@pytest.mark.parametrize(
+    "start",
+    [
+        datetime(1999, 12, 31, 23, 50, tzinfo=timezone.utc),
+        datetime(2199, 6, 1, 12, 0, tzinfo=timezone.utc),
+    ],
+)
+def test_expiry_follows_the_injected_clock_only(repo, ledger, start):
+    clock = FixedClock(start)
+    service = InventoryService(repo, ledger, clock)
+    service.receive("MUG", "WH1", 5)
+    res = service.reserve("WH1", {"MUG": 2}, "k1")
+    assert res.expires_at == start + timedelta(minutes=20)
+    assert service.get_reservation(res.reservation_id).status is models.ReservationStatus.ACTIVE
+    assert service.available("MUG", "WH1") == 3
+    clock.advance(minutes=20)
+    assert service.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+    assert service.available("MUG", "WH1") == 5

+"""SPEC.md acceptance criteria 23-29: confirm."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import Order, OrderStatus, errors, models
+
+TICK = timedelta(microseconds=1)
+
+
+def _lines(order):
+    return {line.sku: line.quantity for line in order.lines}
+
+
+# -- 23. confirm places an ordinary PLACED order for the held units ----------
+def test_confirm_places_order_for_held_units(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    clock.advance(minutes=5)
+    confirmed_at = clock.now()
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert isinstance(order, Order)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert _lines(order) == {"MUG": 4, "TEE": 2}
+    assert order.placed_at == confirmed_at
+
+
+def test_confirm_after_partial_hold_orders_only_held_units(stocked):
+    res = stocked.reserve("WH1", {"MUG": 25, "TEE": 1, "CAP": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert _lines(order) == {"MUG": 10, "TEE": 1}
+
+
+def test_confirm_uses_the_normal_order_id_sequence(stocked):
+    stocked.place_order("WH1", {"MUG": 1})
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.order_id == "ORD-0002"
+    assert stocked.place_order("WH1", {"MUG": 1}).order_id == "ORD-0003"
+
+
+def test_confirmed_order_is_stored_like_any_order(stocked, repo):
+    res = stocked.reserve("WH2", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    stored = repo.get_order(order.order_id)
+    assert stored.status is OrderStatus.PLACED
+    assert stored.warehouse == "WH2"
+    assert _lines(stored) == {"MUG": 3}
+
+
+def test_confirm_just_before_expiry_succeeds(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.set(res.expires_at - TICK)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert _lines(order) == {"MUG": 2}
+
+
+# -- 24. reservation becomes CONFIRMED and points at the order -----------------
+def test_confirm_marks_reservation_confirmed_with_order_id(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    after = stocked.get_reservation(res.reservation_id)
+    assert after.status is models.ReservationStatus.CONFIRMED
+    assert after.order_id == order.order_id
+
+
+# -- 25. confirming moves the hold into an allocation -------------------------
+def test_confirm_does_not_change_available_or_on_hand(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 5}, "k1")
+    before = {
+        sku: (stocked.available(sku, "WH1"), stocked.on_hand(sku, "WH1"))
+        for sku in ("MUG", "TEE", "CAP")
+    }
+    stocked.confirm_reservation(res.reservation_id)
+    after = {
+        sku: (stocked.available(sku, "WH1"), stocked.on_hand(sku, "WH1"))
+        for sku in ("MUG", "TEE", "CAP")
+    }
+    assert after == before == {"MUG": (6, 10), "TEE": (0, 5), "CAP": (0, 0)}
+
+
+def test_confirmed_units_show_as_allocated(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 0
+    stocked.confirm_reservation(res.reservation_id)
+    assert stocked.allocated("MUG", "WH1") == 4
+
+
+def test_confirmed_units_stay_taken_after_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    assert stocked.available("MUG", "WH1") == 6
+
+
+# -- 26. the order can be shipped or cancelled -------------------------------
+def test_confirmed_order_can_be_shipped(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    shipped = stocked.ship_order(order.order_id)
+    assert shipped.status is OrderStatus.SHIPPED
+    assert stocked.on_hand("MUG", "WH1") == 6
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_confirmed_order_can_be_cancelled(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    cancelled = stocked.cancel_order(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 27. confirming twice returns the same order ------------------------------
+def test_confirming_again_returns_same_order_and_creates_nothing(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    second = stocked.confirm_reservation(res.reservation_id)
+    assert second.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.allocated("MUG", "WH1") == 4
+    assert stocked.place_order("WH1", {"MUG": 1}).order_id == "ORD-0002"
+
+
+def test_confirming_again_after_expires_at_returns_same_order(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=5)
+    second = stocked.confirm_reservation(res.reservation_id)
+    assert second.order_id == first.order_id
+    assert len(repo.orders()) == 1
+
+
+# -- 28. confirming an expired reservation -> ReservationExpired -------------
+def test_confirm_at_exact_expiry_raises(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+def test_confirm_long_after_expiry_raises_and_creates_no_order(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(hours=3)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+    assert stocked.place_order("WH1", {"MUG": 1}).order_id == "ORD-0001"
+
+
+# -- 29. confirming a RELEASED reservation -> InvalidReservationState --------
+def test_confirm_released_reservation_raises(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10

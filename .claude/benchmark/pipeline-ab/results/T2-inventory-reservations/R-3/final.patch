+"""SPEC.md acceptance criteria 11-17: reserve."""
+
+import pytest
+
+from inventory import errors, models
+
+
+# -- 11. each line holds min(requested, available) ----------------------------
+def test_line_holds_everything_when_enough_is_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 7}, "k1")
+    assert res.items == {"MUG": 7}
+
+
+def test_line_holds_only_what_is_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 25, "TEE": 3}, "k1")
+    assert res.items == {"MUG": 10, "TEE": 3}
+
+
+def test_partial_fill_accounts_for_orders_and_other_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    res = stocked.reserve("WH1", {"MUG": 5}, "k2")
+    assert res.items == {"MUG": 3}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_partial_fill_uses_the_requested_warehouse_only(stocked):
+    res = stocked.reserve("WH2", {"MUG": 9}, "k1")
+    assert res.items == {"MUG": 4}
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 12. lines with 0 available are omitted ----------------------------------
+def test_line_with_nothing_available_is_left_out(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2, "CAP": 3}, "k1")
+    assert res.items == {"MUG": 2}
+    assert "CAP" not in res.items
+
+
+def test_line_exhausted_by_other_holds_is_left_out(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    res = stocked.reserve("WH1", {"TEE": 1, "MUG": 1}, "k2")
+    assert res.items == {"MUG": 1}
+
+
+# -- 13. a successful reserve returns a new ACTIVE reservation ----------------
+def test_reserve_returns_active_reservation(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 9, "CAP": 1}, "k1")
+    assert isinstance(res, models.Reservation)
+    assert res.status is models.ReservationStatus.ACTIVE
+    assert res.order_id is None
+    assert res.warehouse == "WH1"
+    assert res.items == {"MUG": 2, "TEE": 5}
+
+
+# -- 14. nothing can be held -> InsufficientStock, nothing created ---------
+def test_reserve_raises_when_nothing_can_be_held(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+
+
+def test_failed_reserve_creates_no_reservation_or_hold(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k0")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2, "TEE": 1}, "k1")
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 0
+    nxt = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert nxt.reservation_id == "RES-0002"
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0003")
+
+
+def test_insufficient_stock_does_not_consume_the_key(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    stocked.receive("CAP", "WH1", 5)
+    res = stocked.reserve("WH1", {"CAP": 2}, "k1")
+    assert res.items == {"CAP": 2}
+    assert res.status is models.ReservationStatus.ACTIVE
+
+
+# -- 15. validation reuses the existing errors --------------------------------
+def test_unknown_warehouse_is_rejected(stocked):
+    with pytest.raises(errors.UnknownWarehouse):
+        stocked.reserve("NOPE", {"MUG": 1}, "k1")
+
+
+def test_unknown_sku_is_rejected(stocked):
+    with pytest.raises(errors.UnknownSku):
+        stocked.reserve("WH1", {"GHOST": 1}, "k1")
+
+
+@pytest.mark.parametrize("quantity", [0, -1, 1.5, "2", True, None])
+def test_bad_quantity_is_rejected(stocked, quantity):
+    with pytest.raises(errors.InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": quantity}, "k1")
+
+
+def test_empty_items_is_rejected(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {}, "k1")
+
+
+# -- 16. a rejected request holds nothing and consumes no key ----------------
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("WH1", {"MUG": 3, "GHOST": 1}, "UnknownSku"),
+        ("WH1", {"MUG": 3, "TEE": 0}, "InvalidQuantity"),
+        ("WH1", {"MUG": 3, "TEE": -2}, "InvalidQuantity"),
+        ("NOPE", {"MUG": 3}, "UnknownWarehouse"),
+    ],
+)
+def test_rejected_request_holds_nothing_and_keeps_key_free(stocked, warehouse, items, error):
+    with pytest.raises(getattr(errors, error)):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+    res = stocked.reserve("WH1", {"TEE": 2}, "k1")
+    assert res.items == {"TEE": 2}
+    assert res.reservation_id == "RES-0001"
+
+
+# -- 17. reservation IDs ----------------------------------------------------
+def test_reservation_ids_are_sequential(stocked):
+    ids = [stocked.reserve("WH1", {"MUG": 1}, f"k{i}").reservation_id for i in range(3)]
+    assert ids == ["RES-0001", "RES-0002", "RES-0003"]
+
+
+def test_reservation_ids_are_independent_of_order_ids(stocked):
+    first_order = stocked.place_order("WH1", {"MUG": 1})
+    stocked.place_order("WH1", {"MUG": 1})
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert first_order.order_id == "ORD-0001"
+    assert res.reservation_id == "RES-0001"
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.order_id == "ORD-0003"
+    assert stocked.place_order("WH1", {"MUG": 1}).order_id == "ORD-0004"
+    assert stocked.reserve("WH1", {"MUG": 1}, "k2").reservation_id == "RES-0002"
+
+
+def test_idempotent_retry_does_not_consume_an_id(stocked):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert stocked.reserve("WH1", {"MUG": 1}, "k2").reservation_id == "RES-0002"

+"""Shared fixtures for the stock-reservation acceptance tests (SPEC.md).
+
+The ``clock``, ``repo``, ``ledger`` and ``service`` fixtures come from
+``tests/conftest.py``. Clock starts at 2024-03-01 09:00 UTC.
+"""
+
+import pytest
+
+
+@pytest.fixture
+def stocked(service):
+    """WH1: MUG 10, TEE 5, CAP 0. WH2: MUG 4."""
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 4)
+    return service

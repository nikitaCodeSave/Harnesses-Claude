@@ -0,0 +1,171 @@
+"""SPEC.md acceptance criteria 18-22: idempotency."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import errors, models
+
+STATES = ("ACTIVE", "CONFIRMED", "RELEASED", "EXPIRED")
+
+
+def _reservation_in(service, clock, state, warehouse="WH1", items=None, key="k1"):
+    """Create a reservation via ``key`` and drive it into ``state``."""
+    items = items if items is not None else {"MUG": 3, "TEE": 1}
+    res = service.reserve(warehouse, items, key)
+    if state == "CONFIRMED":
+        service.confirm_reservation(res.reservation_id)
+    elif state == "RELEASED":
+        service.release_reservation(res.reservation_id)
+    elif state == "EXPIRED":
+        clock.advance(minutes=20)
+    return service.get_reservation(res.reservation_id)
+
+
+# -- 18. same key + same request returns the existing reservation -----------
+@pytest.mark.parametrize("state", STATES)
+def test_retry_returns_existing_reservation_in_current_state(stocked, clock, state):
+    before = _reservation_in(stocked, clock, state)
+    clock.advance(minutes=1)
+    retry = stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k1")
+    assert retry.reservation_id == before.reservation_id
+    assert retry.status is getattr(models.ReservationStatus, state)
+    assert retry.items == before.items
+    assert retry.expires_at == before.expires_at
+    assert retry.order_id == before.order_id
+    assert retry.warehouse == "WH1"
+
+
+@pytest.mark.parametrize("state", STATES)
+def test_retry_changes_nothing(stocked, clock, state, repo):
+    before = _reservation_in(stocked, clock, state)
+    snapshot = (
+        stocked.available("MUG", "WH1"),
+        stocked.available("TEE", "WH1"),
+        stocked.allocated("MUG", "WH1"),
+        stocked.on_hand("MUG", "WH1"),
+        len(repo.orders()),
+    )
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k1")
+    after = stocked.get_reservation(before.reservation_id)
+    assert after.status is before.status
+    assert after.items == before.items
+    assert after.expires_at == before.expires_at
+    assert after.order_id == before.order_id
+    assert snapshot == (
+        stocked.available("MUG", "WH1"),
+        stocked.available("TEE", "WH1"),
+        stocked.allocated("MUG", "WH1"),
+        stocked.on_hand("MUG", "WH1"),
+        len(repo.orders()),
+    )
+
+
+def test_retry_with_items_in_a_different_order_matches(stocked):
+    first = stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k1")
+    retry = stocked.reserve("WH1", {"TEE": 1, "MUG": 3}, "k1")
+    assert retry.reservation_id == first.reservation_id
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_retry_creates_no_second_hold(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_retry_after_more_stock_arrives_does_not_top_up_a_partial_hold(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    stocked.receive("MUG", "WH1", 20)
+    retry = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert retry.reservation_id == first.reservation_id
+    assert retry.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 20
+
+
+# -- 19. "same request" compares requested items, not held items --------------
+def test_retry_of_partial_fill_with_original_request_matches(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15, "CAP": 2}, "k1")
+    assert first.items == {"MUG": 10}
+    retry = stocked.reserve("WH1", {"CAP": 2, "MUG": 15}, "k1")
+    assert retry.reservation_id == first.reservation_id
+    assert retry.items == {"MUG": 10}
+
+
+def test_request_equal_to_held_items_conflicts_after_partial_fill(stocked):
+    stocked.reserve("WH1", {"MUG": 15, "CAP": 2}, "k1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_request_equal_to_held_items_matches_when_fully_filled(stocked):
+    first = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    retry = stocked.reserve("WH1", dict(first.items), "k1")
+    assert retry.reservation_id == first.reservation_id
+
+
+# -- 20. same key + different request -> IdempotencyConflict ----------------
+@pytest.mark.parametrize("state", STATES)
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [
+        ("WH2", {"MUG": 3, "TEE": 1}),  # different warehouse
+        ("WH1", {"MUG": 3}),  # line missing
+        ("WH1", {"MUG": 3, "TEE": 2}),  # different quantity
+        ("WH1", {"MUG": 3, "TEE": 1, "CAP": 1}),  # extra line
+    ],
+)
+def test_reused_key_with_different_request_conflicts(stocked, clock, state, warehouse, items):
+    before = _reservation_in(stocked, clock, state)
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+    after = stocked.get_reservation(before.reservation_id)
+    assert after.status is before.status
+    assert after.items == before.items
+
+
+def test_conflict_creates_nothing(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"TEE": 2}, "k1")
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.reserve("WH1", {"TEE": 2}, "k2").reservation_id == "RES-0002"
+
+
+# -- 21. keys are global and never expire ---------------------------------------
+def test_keys_are_global_across_warehouses(stocked):
+    stocked.reserve("WH1", {"MUG": 2}, "shared")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 2}, "shared")
+    assert stocked.available("MUG", "WH2") == 4
+
+
+def test_keys_never_expire(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.advance(timedelta(days=400))
+    retry = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert retry.reservation_id == first.reservation_id
+    assert retry.status is models.ReservationStatus.EXPIRED
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 5}, "k1")
+
+
+# -- 22. a raised reserve leaves no trace -------------------------------------
+def test_key_of_failed_reserve_can_be_used_for_any_request(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    with pytest.raises(errors.UnknownSku):
+        stocked.reserve("WH1", {"GHOST": 1}, "k1")
+    res = stocked.reserve("WH2", {"MUG": 2}, "k1")
+    assert res.warehouse == "WH2"
+    assert res.items == {"MUG": 2}
+    assert res.reservation_id == "RES-0001"
+
+
+def test_conflicting_call_leaves_original_key_binding_intact(stocked):
+    first = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 3}, "k1")
+    retry = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert retry.reservation_id == first.reservation_id

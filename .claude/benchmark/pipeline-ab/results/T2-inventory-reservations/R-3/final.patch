@@ -0,0 +1,121 @@
+"""SPEC.md acceptance criteria 1-5: hold lifetime."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import errors, models
+
+HOLD = timedelta(minutes=20)
+TICK = timedelta(microseconds=1)
+
+
+# -- 1. expires_at = clock time at reserve + hold duration --------------------
+def test_expires_at_is_reserve_time_plus_hold(stocked, clock):
+    clock.advance(minutes=7, seconds=3)
+    reserved_at = clock.now()
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert res.expires_at == reserved_at + HOLD
+
+
+# -- 2. default hold is 20 minutes, fixed per service ---------------------------
+def test_default_hold_duration_is_twenty_minutes(stocked, clock):
+    start = clock.now()
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at - start == timedelta(minutes=20)
+
+
+def test_hold_duration_is_the_same_for_every_call(stocked, clock):
+    first_at = clock.now()
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(hours=3)
+    second_at = clock.now()
+    second = stocked.reserve("WH1", {"TEE": 1}, "k2")
+    assert first.expires_at - first_at == HOLD
+    assert second.expires_at - second_at == HOLD
+
+
+def test_reserve_has_no_per_call_duration_parameter(stocked):
+    with pytest.raises(TypeError):
+        stocked.reserve("WH1", {"MUG": 1}, "k1", timedelta(hours=1))
+
+
+# -- 3. ACTIVE reservations lapse on their own ---------------------------------
+def test_reservation_is_active_just_before_expiry(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at - TICK)
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_reservation_expires_at_the_exact_instant(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at)
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_expiry_frees_stock_without_any_other_call(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 6
+    clock.advance(HOLD)
+    # Nothing but the read itself happens here.
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_expiry_visible_through_available_before_get_reservation(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    clock.advance(minutes=45)
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+# -- 4. only ACTIVE reservations expire ------------------------------------------
+def test_confirmed_reservation_stays_confirmed_after_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=2)
+    after = stocked.get_reservation(res.reservation_id)
+    assert after.status is models.ReservationStatus.CONFIRMED
+
+
+def test_released_reservation_stays_released_after_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    clock.advance(hours=2)
+    after = stocked.get_reservation(res.reservation_id)
+    assert after.status is models.ReservationStatus.RELEASED
+
+
+# -- 5. nothing ever moves expires_at ----------------------------------------
+def test_idempotent_retry_does_not_move_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    original = res.expires_at
+    clock.advance(minutes=10)
+    retry = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert retry.expires_at == original
+    assert stocked.get_reservation(res.reservation_id).expires_at == original
+
+
+def test_retry_does_not_revive_a_lapsed_hold(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(minutes=25)
+    retry = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert retry.expires_at == res.expires_at
+    assert retry.status is models.ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_reads_and_other_operations_do_not_move_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    original = res.expires_at
+    clock.advance(minutes=5)
+    stocked.get_reservation(res.reservation_id)
+    stocked.available("MUG", "WH1")
+    stocked.reserve("WH1", {"MUG": 1}, "k2")
+    stocked.receive("MUG", "WH1", 5)
+    stocked.place_order("WH1", {"MUG": 1})
+    clock.advance(minutes=10)
+    assert stocked.get_reservation(res.reservation_id).expires_at == original
+    clock.set(original)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)

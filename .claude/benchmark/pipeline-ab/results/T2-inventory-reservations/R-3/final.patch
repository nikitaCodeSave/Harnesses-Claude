@@ -0,0 +1,40 @@
+"""SPEC.md acceptance criterion 35: direct orders compete with holds."""
+
+import pytest
+
+from inventory import errors
+
+
+def test_place_order_cannot_take_held_units(stocked):
+    stocked.reserve("WH1", {"MUG": 6}, "k1")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 5})
+
+
+def test_place_order_can_take_what_holds_leave(stocked):
+    stocked.reserve("WH1", {"MUG": 6}, "k1")
+    order = stocked.place_order("WH1", {"MUG": 4})
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 4}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_place_order_stays_all_or_nothing(stocked, repo):
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 2, "TEE": 2})
+    assert repo.orders() == []
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 1
+
+
+def test_place_order_can_use_units_once_hold_expires(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(res.expires_at)
+    order = stocked.place_order("WH1", {"MUG": 10})
+    assert order.quantity_of("MUG") == 10
+
+
+def test_place_order_can_use_units_once_hold_released(stocked):
+    res = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    assert stocked.place_order("WH1", {"MUG": 10}).quantity_of("MUG") == 10

+++ b/tests/acceptance/test_release_and_lookup.py
@@ -0,0 +1,120 @@
+"""SPEC.md acceptance criteria 30-34: release and lookup."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import OrderStatus, errors, models
+
+
+# -- 30. release frees an ACTIVE reservation ----------------------------------
+def test_release_marks_reservation_released_and_returns_it(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert isinstance(released, models.Reservation)
+    assert released.reservation_id == res.reservation_id
+    assert released.status is models.ReservationStatus.RELEASED
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.RELEASED
+
+
+def test_release_frees_units_at_once(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+
+
+# -- 31. releasing RELEASED or EXPIRED is a no-op ------------------------------
+def test_releasing_twice_is_a_no_op(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.release_reservation(res.reservation_id)
+    second = stocked.release_reservation(res.reservation_id)
+    assert second.reservation_id == first.reservation_id
+    assert second.status is models.ReservationStatus.RELEASED
+    assert second.items == first.items
+    assert second.expires_at == first.expires_at
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_releasing_expired_reservation_is_a_no_op(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.reservation_id == res.reservation_id
+    assert released.status is models.ReservationStatus.EXPIRED
+    assert released.expires_at == res.expires_at
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 32. releasing CONFIRMED -> InvalidReservationState -------------------
+def test_releasing_confirmed_reservation_raises(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    after = stocked.get_reservation(res.reservation_id)
+    assert after.status is models.ReservationStatus.CONFIRMED
+    assert after.order_id == order.order_id
+    assert after.items == {"MUG": 4}
+
+
+def test_releasing_confirmed_reservation_leaves_order_alone(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+    assert stocked.allocated("MUG", "WH1") == 4
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_releasing_confirmed_reservation_after_expires_at_raises(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+
+
+# -- 33. get_reservation reports the current status ----------------------------
+def test_get_reservation_returns_the_reservation(stocked):
+    res = stocked.reserve("WH2", {"MUG": 9}, "k1")
+    got = stocked.get_reservation(res.reservation_id)
+    assert isinstance(got, models.Reservation)
+    assert got.reservation_id == res.reservation_id
+    assert got.warehouse == "WH2"
+    assert got.items == {"MUG": 4}
+    assert got.status is models.ReservationStatus.ACTIVE
+    assert got.expires_at == res.expires_at
+    assert got.order_id is None
+
+
+def test_get_reservation_reports_lapsed_reservation_as_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(minutes=20)
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_expired_reservations_stay_retrievable(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(timedelta(days=90))
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.reservation_id == res.reservation_id
+    assert got.status is models.ReservationStatus.EXPIRED
+    assert got.expires_at == res.expires_at
+
+
+# -- 34. unknown IDs -> ReservationNotFound -----------------------------------
+@pytest.mark.parametrize("method", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_id_raises(stocked, method):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(errors.ReservationNotFound):
+        getattr(stocked, method)("RES-9999")
+
+
+@pytest.mark.parametrize("method", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_order_id_is_not_a_reservation_id(stocked, method):
+    stocked.place_order("WH1", {"MUG": 1})
+    with pytest.raises(errors.ReservationNotFound):
+        getattr(stocked, method)("ORD-0001")

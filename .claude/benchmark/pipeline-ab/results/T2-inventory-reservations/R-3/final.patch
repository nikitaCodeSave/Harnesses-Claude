+"""Interface section of SPEC.md: models, errors and method signatures."""
+
+import dataclasses
+import inspect
+
+from inventory import InventoryService, errors, models
+
+
+def test_reservation_is_a_dataclass_with_the_specified_fields():
+    assert dataclasses.is_dataclass(models.Reservation)
+    names = {f.name for f in dataclasses.fields(models.Reservation)}
+    assert {"reservation_id", "warehouse", "items", "status", "expires_at", "order_id"} <= names
+
+
+def test_reservation_status_has_exactly_the_specified_members():
+    assert {m.name for m in models.ReservationStatus} == {
+        "ACTIVE",
+        "CONFIRMED",
+        "RELEASED",
+        "EXPIRED",
+    }
+
+
+def test_new_errors_subclass_inventory_error():
+    for name in (
+        "ReservationNotFound",
+        "ReservationExpired",
+        "InvalidReservationState",
+        "IdempotencyConflict",
+    ):
+        cls = getattr(errors, name)
+        assert issubclass(cls, errors.InventoryError), name
+
+
+def test_service_exposes_the_reservation_methods():
+    for name in ("reserve", "confirm_reservation", "release_reservation", "get_reservation"):
+        assert callable(getattr(InventoryService, name, None)), name
+
+
+def test_reserve_takes_warehouse_items_and_idempotency_key():
+    params = list(inspect.signature(InventoryService.reserve).parameters)
+    assert params[1:4] == ["warehouse", "items", "idempotency_key"]
+
+
+def test_service_is_still_built_from_repository_ledger_clock(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock)
+    service.receive("MUG", "WH1", 1)
+    assert service.reserve("WH1", {"MUG": 1}, "k").items == {"MUG": 1}

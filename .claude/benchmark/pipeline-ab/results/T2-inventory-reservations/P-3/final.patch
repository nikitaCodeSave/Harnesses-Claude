@@ -0,0 +1,599 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import (
+    InventoryService,
+    Order,
+    OrderLine,
+    OrderStatus,
+    Reservation,
+    ReservationStatus,
+)
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+def test_reserve_returns_active_reservation_expiring_in_20_minutes(stocked, clock):
+    reservation = stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    assert isinstance(reservation, Reservation)
+    assert reservation.warehouse == "WH1"
+    assert reservation.status is ReservationStatus.ACTIVE
+    assert reservation.order_id is None
+    assert reservation.expires_at == clock.now() + timedelta(minutes=20)
+
+
+def test_each_reservation_has_a_unique_identifier(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1}, "cart-1")
+    second = stocked.reserve("WH1", {"MUG": 1}, "cart-2")
+    assert first.reservation_id != second.reservation_id
+
+
+def test_get_reservation_returns_what_was_reserved(stocked):
+    reservation = stocked.reserve("WH1", {"MUG": 2, "TEE": 3}, "cart-1")
+    found = stocked.get_reservation(reservation.reservation_id)
+    assert (found.reservation_id, found.warehouse, found.items, found.status, found.order_id) == (
+        reservation.reservation_id, "WH1", {"MUG": 2, "TEE": 3}, ReservationStatus.ACTIVE, None,
+    )
+    assert found.expires_at == reservation.expires_at
+
+
+def test_reserved_units_are_no_longer_available(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    assert (
+        stocked.on_hand("MUG", "WH1"),
+        stocked.allocated("MUG", "WH1"),
+        stocked.reserved("MUG", "WH1"),
+        stocked.available("MUG", "WH1"),
+    ) == (10, 0, 4, 6)
+
+
+def test_reserved_sums_active_reservations(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    stocked.reserve("WH1", {"MUG": 3}, "cart-2")
+    assert stocked.reserved("MUG", "WH1") == 7
+
+
+def test_nothing_is_reserved_before_any_reservation(stocked):
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+def test_short_line_reserves_what_is_available_and_others_are_unaffected(stocked):
+    reservation = stocked.reserve("WH1", {"MUG": 3, "TEE": 6}, "cart-1")
+    assert reservation.items == {"MUG": 3, "TEE": 5}
+    assert (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1")) == (7, 0)
+
+
+def test_line_with_nothing_available_is_left_out(stocked):
+    reservation = stocked.reserve("WH1", {"MUG": 2, "CAP": 1}, "cart-1")
+    assert reservation.items == {"MUG": 2}
+
+
+def test_line_already_fully_reserved_is_left_out(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "cart-1")
+    reservation = stocked.reserve("WH1", {"MUG": 1, "TEE": 1}, "cart-2")
+    assert reservation.items == {"MUG": 1}
+
+
+def test_reserve_fails_when_no_line_can_reserve_anything(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "cart-1")
+    with pytest.raises(InsufficientStock) as excinfo:
+        stocked.reserve("WH1", {"CAP": 2, "TEE": 1}, "cart-2")
+    assert (excinfo.value.sku, excinfo.value.available) == ("CAP", 0)
+
+
+def test_failed_reserve_claims_nothing(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH2", {"MUG": 1}, "cart-1")
+    assert stocked.reserved("MUG", "WH2") == 0
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+def test_reserve_in_unknown_warehouse_is_rejected(stocked):
+    with pytest.raises(UnknownWarehouse):
+        stocked.reserve("WH9", {"MUG": 1}, "cart-1")
+
+
+def test_reserve_of_unknown_sku_rejects_the_whole_request(stocked):
+    with pytest.raises(UnknownSku):
+        stocked.reserve("WH1", {"MUG": 2, "NOPE": 1}, "cart-1")
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+@pytest.mark.parametrize("bad", [0, -1, 1.5, "2", True, None])
+def test_reserve_with_invalid_quantity_rejects_the_whole_request(stocked, bad):
+    with pytest.raises(InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": 2, "TEE": bad}, "cart-1")
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+def test_reserve_with_no_items_is_rejected(stocked):
+    with pytest.raises(InvalidOrder):
+        stocked.reserve("WH1", {}, "cart-1")
+
+
+def test_empty_reservation_is_rejected_as_a_reservation_not_an_order(stocked):
+    with pytest.raises(InvalidOrder) as excinfo:
+        stocked.reserve("WH1", {}, "cart-1")
+    assert str(excinfo.value) == "a reservation needs at least one line"
+
+
+@pytest.mark.parametrize("key", ["", "   "])
+def test_reserve_with_empty_or_blank_key_is_rejected(stocked, key):
+    with pytest.raises(InvalidOrder):
+        stocked.reserve("WH1", {"MUG": 2}, key)
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+def test_place_order_cannot_take_reserved_units(stocked, repo):
+    stocked.reserve("WH1", {"TEE": 4}, "cart-1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 1, "TEE": 2})
+    assert repo.orders() == []
+
+
+def test_place_order_can_take_what_is_left_after_reservations(stocked):
+    stocked.reserve("WH1", {"TEE": 4}, "cart-1")
+    stocked.place_order("WH1", {"TEE": 1})
+    assert (
+        stocked.allocated("TEE", "WH1"),
+        stocked.reserved("TEE", "WH1"),
+        stocked.available("TEE", "WH1"),
+    ) == (1, 4, 0)
+
+
+def test_reservation_does_not_change_another_warehouse(stocked):
+    stocked.receive("MUG", "WH2", 8)
+    stocked.reserve("WH1", {"MUG": 6}, "cart-1")
+    assert (stocked.reserved("MUG", "WH2"), stocked.available("MUG", "WH2")) == (0, 8)
+
+
+def test_reservation_does_not_change_other_skus(stocked):
+    stocked.reserve("WH1", {"MUG": 6}, "cart-1")
+    assert (stocked.reserved("TEE", "WH1"), stocked.available("TEE", "WH1")) == (0, 5)
+
+
+@pytest.mark.parametrize(
+    "error", [ReservationNotFound, ReservationExpired, InvalidReservationState, IdempotencyConflict]
+)
+def test_reservation_errors_are_inventory_errors(error):
+    assert issubclass(error, InventoryError)
+
+
+def test_unknown_reservation_is_reported(stocked):
+    with pytest.raises(ReservationNotFound):
+        stocked.get_reservation("RES-9999")
+
+
+# -- idempotent retries ------------------------------------------------------
+def test_retry_with_same_key_and_request_returns_the_original_reservation(stocked):
+    original = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    retry = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert retry.reservation_id == original.reservation_id
+    assert (stocked.reserved("MUG", "WH1"), stocked.available("MUG", "WH1")) == (3, 7)
+
+
+def test_retry_does_not_move_the_expiry_time(stocked, clock):
+    original = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    expires_at = original.expires_at
+    clock.advance(timedelta(minutes=5))
+    retry = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert retry.expires_at == expires_at
+
+
+def test_reusing_a_key_for_another_warehouse_is_a_conflict(stocked):
+    stocked.receive("MUG", "WH2", 5)
+    stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 3}, "cart-1")
+    assert stocked.reserved("MUG", "WH2") == 0
+
+
+@pytest.mark.parametrize(
+    "retry_items",
+    [
+        {"MUG": 4, "TEE": 2},
+        {"MUG": 3},
+        {"MUG": 3, "TEE": 2, "CAP": 1},
+        {"CAP": 3, "TEE": 2},
+    ],
+    ids=["other-quantity", "missing-sku", "extra-sku", "other-sku"],
+)
+def test_reusing_a_key_for_different_items_is_a_conflict(stocked, retry_items):
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "cart-1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", retry_items, "cart-1")
+    assert (stocked.reserved("MUG", "WH1"), stocked.reserved("TEE", "WH1")) == (3, 2)
+
+
+def test_retry_of_a_partially_filled_reservation_matches_what_was_requested(stocked):
+    original = stocked.reserve("WH1", {"MUG": 2, "TEE": 8, "CAP": 1}, "cart-1")
+    retry = stocked.reserve("WH1", {"MUG": 2, "TEE": 8, "CAP": 1}, "cart-1")
+    assert retry.reservation_id == original.reservation_id
+    assert retry.items == {"MUG": 2, "TEE": 5}
+
+
+def test_retry_with_the_reserved_items_instead_of_the_request_is_a_conflict(stocked):
+    stocked.reserve("WH1", {"MUG": 2, "TEE": 8, "CAP": 1}, "cart-1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2, "TEE": 5}, "cart-1")
+
+
+def test_item_order_does_not_matter_when_matching_a_retry(stocked):
+    original = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "cart-1")
+    retry = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "cart-1")
+    assert retry.reservation_id == original.reservation_id
+    assert stocked.reserved("MUG", "WH1") == 2
+
+
+@pytest.mark.parametrize(
+    ("warehouse", "items", "error"),
+    [
+        ("WH1", {"CAP": 1}, InsufficientStock),
+        ("WH1", {"NOPE": 1}, UnknownSku),
+        ("WH9", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 0}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+    ids=["insufficient-stock", "unknown-sku", "unknown-warehouse", "bad-quantity", "no-items"],
+)
+def test_failed_reserve_leaves_the_key_free(stocked, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "cart-1")
+    reservation = stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    assert reservation.items == {"MUG": 2}
+    assert stocked.reserved("MUG", "WH1") == 2
+
+
+def test_key_can_be_reused_once_stock_arrives(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "cart-1")
+    stocked.receive("CAP", "WH1", 2)
+    reservation = stocked.reserve("WH1", {"CAP": 2}, "cart-1")
+    assert reservation.items == {"CAP": 2}
+
+
+def test_keys_are_global_across_warehouses(stocked):
+    stocked.receive("MUG", "WH2", 5)
+    stocked.reserve("WH2", {"MUG": 1}, "cart-1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 1}, "cart-1")
+    assert (stocked.reserved("MUG", "WH1"), stocked.reserved("MUG", "WH2")) == (0, 1)
+
+
+@pytest.mark.parametrize(
+    ("warehouse", "items", "error"),
+    [
+        ("WH1", {"NOPE": 1}, UnknownSku),
+        ("WH9", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": -1}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+    ids=["unknown-sku", "unknown-warehouse", "bad-quantity", "no-items"],
+)
+def test_invalid_request_reusing_a_bound_key_reports_the_validation_error(
+    stocked, warehouse, items, error
+):
+    stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "cart-1")
+
+
+def test_reservation_exposes_only_its_public_fields(stocked):
+    reservation = stocked.reserve("WH1", {"MUG": 2, "CAP": 1}, "cart-1")
+    assert set(vars(reservation)) == {
+        "reservation_id", "warehouse", "items", "status", "expires_at", "order_id",
+    }
+
+
+# -- expiry ------------------------------------------------------------------
+def test_reservation_is_still_active_just_before_it_expires(stocked, clock):
+    reservation = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    clock.advance(minutes=19, seconds=59)
+    assert stocked.get_reservation(reservation.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.reserved("MUG", "WH1") == 3
+
+
+@pytest.mark.parametrize("after", [timedelta(0), timedelta(minutes=5)], ids=["exactly", "after"])
+def test_lookup_reports_expired_from_expires_at(stocked, clock, after):
+    reservation = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    clock.set(reservation.expires_at + after)
+    assert stocked.get_reservation(reservation.reservation_id).status is ReservationStatus.EXPIRED
+
+
+@pytest.mark.parametrize("after", [timedelta(0), timedelta(minutes=5)], ids=["exactly", "after"])
+def test_expired_units_stop_counting_as_reserved(stocked, clock, after):
+    reservation = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    clock.set(reservation.expires_at + after)
+    assert (stocked.reserved("MUG", "WH1"), stocked.available("MUG", "WH1")) == (0, 10)
+
+
+def test_expired_units_can_be_reserved_again(stocked, clock):
+    stocked.reserve("WH1", {"TEE": 5}, "cart-1")
+    clock.advance(minutes=20)
+    reservation = stocked.reserve("WH1", {"TEE": 5}, "cart-2")
+    assert reservation.items == {"TEE": 5}
+    assert (stocked.reserved("TEE", "WH1"), stocked.available("TEE", "WH1")) == (5, 0)
+
+
+def test_expired_units_can_be_ordered(stocked, clock):
+    stocked.reserve("WH1", {"TEE": 5}, "cart-1")
+    clock.advance(minutes=20)
+    order = stocked.place_order("WH1", {"TEE": 5})
+    assert (stocked.allocated("TEE", "WH1"), stocked.available("TEE", "WH1")) == (5, 0)
+    assert order.lines[0].quantity == 5
+
+
+def test_retry_after_expiry_returns_the_expired_reservation_and_reserves_nothing(stocked, clock):
+    original = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    clock.advance(minutes=25)
+    retry = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert (retry.reservation_id, retry.status, retry.expires_at) == (
+        original.reservation_id, ReservationStatus.EXPIRED, original.expires_at,
+    )
+    assert (stocked.reserved("MUG", "WH1"), stocked.available("MUG", "WH1")) == (0, 10)
+
+
+def test_reusing_a_key_with_a_different_request_after_expiry_is_a_conflict(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    clock.advance(minutes=25)
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    assert stocked.reserved("MUG", "WH1") == 0
+
+
+def test_custom_reservation_ttl_sets_expiry_and_when_it_happens(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 10)
+    reservation = service.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert reservation.expires_at == clock.now() + timedelta(minutes=5)
+    clock.advance(minutes=4, seconds=59)
+    assert service.get_reservation(reservation.reservation_id).status is ReservationStatus.ACTIVE
+    clock.advance(seconds=1)
+    assert service.get_reservation(reservation.reservation_id).status is ReservationStatus.EXPIRED
+    assert service.reserved("MUG", "WH1") == 0
+
+
+def test_service_built_without_a_ttl_expires_reservations_after_20_minutes(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock)
+    service.receive("MUG", "WH1", 10)
+    reservation = service.reserve("WH1", {"MUG": 3}, "cart-1")
+    clock.advance(minutes=19, seconds=59)
+    assert service.reserved("MUG", "WH1") == 3
+    clock.advance(seconds=1)
+    assert service.reserved("MUG", "WH1") == 0
+    assert service.get_reservation(reservation.reservation_id).status is ReservationStatus.EXPIRED
+
+
+# -- confirm ---------------------------------------------------------------
+
+
+def test_confirm_returns_a_placed_order_of_the_reserved_units(stocked, clock):
+    stocked.place_order("WH1", {"TEE": 1})
+    reservation = stocked.reserve("WH1", {"MUG": 2, "TEE": 6}, "cart-1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(reservation.reservation_id)
+    assert isinstance(order, Order)
+    assert order.order_id == "ORD-0002"
+    assert order.warehouse == "WH1"
+    assert order.status is OrderStatus.PLACED
+    assert order.placed_at == clock.now()
+    assert sorted(order.lines, key=lambda line: line.sku) == [
+        OrderLine("MUG", 2),
+        OrderLine("TEE", 4),
+    ]
+
+
+def test_confirmed_reservation_records_its_order(stocked):
+    reservation = stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    order = stocked.confirm_reservation(reservation.reservation_id)
+    confirmed = stocked.get_reservation(reservation.reservation_id)
+    assert confirmed.status is ReservationStatus.CONFIRMED
+    assert confirmed.order_id == order.order_id
+
+
+def test_confirm_moves_units_from_reserved_to_allocated_without_changing_available(stocked):
+    stocked.place_order("WH1", {"MUG": 1})
+    reservation = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert (stocked.reserved("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (3, 1)
+    assert stocked.available("MUG", "WH1") == 6
+    stocked.confirm_reservation(reservation.reservation_id)
+    assert (stocked.reserved("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (0, 4)
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_confirm_does_not_recheck_availability(stocked):
+    reservation = stocked.reserve("WH1", {"MUG": 8}, "cart-1")
+    stocked.adjust("MUG", "WH1", -5, "breakage")
+    order = stocked.confirm_reservation(reservation.reservation_id)

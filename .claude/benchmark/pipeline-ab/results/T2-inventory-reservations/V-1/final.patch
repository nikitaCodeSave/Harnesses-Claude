index 0000000..4a2e079
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,253 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+from inventory.reports import StockRow, stock_report
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+# -- reserve ------------------------------------------------------------------
+def test_reserve_holds_stock_without_touching_ledger(stocked, ledger, clock):
+    entries_before = len(ledger)
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.items == {"MUG": 4}
+    assert res.expires_at == clock.now() + TTL
+    assert res.order_id is None
+    assert (stocked.on_hand("MUG", "WH1"), stocked.held("MUG", "WH1")) == (10, 4)
+    assert stocked.available("MUG", "WH1") == 6
+    assert len(ledger) == entries_before
+
+
+def test_holds_are_per_warehouse(stocked):
+    stocked.receive("MUG", "WH2", 3)
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert stocked.available("MUG", "WH2") == 3
+
+
+def test_reserve_holds_partial_lines_and_drops_empty_ones(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k0")
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 1, "CAP": 2}, "k1")
+    assert res.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_reserve_fails_when_nothing_can_be_held(stocked, repo):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert repo.reservations() == []
+
+
+def test_failed_reserve_leaves_key_free(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    stocked.receive("CAP", "WH1", 1)
+    res = stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert (res.reservation_id, res.items) == ("RES-0001", {"CAP": 1})
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 0}, InvalidQuantity),
+        ("WH1", {"MUG": True}, InvalidQuantity),
+        ("WH1", {"MUG": 2, "TEE": -1}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_invalid_reserve_requests_hold_nothing(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert stocked.reserve("WH1", {"MUG": 1}, "k1").items == {"MUG": 1}
+
+
+def test_place_order_respects_holds(stocked):

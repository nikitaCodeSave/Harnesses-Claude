+    # -- reservations ----------------------------------------------------
+    def reserve(self, warehouse: str, items: Mapping[str, int], idempotency_key: str) -> Reservation:
+        """Hold stock for a cart for ``RESERVATION_TTL``.
+
+        Each line holds as much as is available, up to what was asked; lines
+        with nothing available are left out. Fails with InsufficientStock only
+        if no line can hold anything. A retry with the same key and the same
+        request returns the original reservation, whatever its status now.
+        """
+        wanted = self._validate_items(warehouse, items)
+        previous = self._repo.find_reservation_request(idempotency_key)
+        if previous is not None:
+            if (previous.warehouse, previous.items) != (warehouse, wanted):
+                raise IdempotencyConflict(idempotency_key, previous.reservation_id)
+            return self.get_reservation(previous.reservation_id)
+
+        held: dict[str, int] = {}
+        for sku, quantity in wanted.items():
+            take = min(quantity, self.available(sku, warehouse))
+            if take > 0:
+                held[sku] = take
+        if not held:
+            sku, quantity = next(iter(wanted.items()))
+            raise InsufficientStock(sku, warehouse, quantity, 0)
+
+        reservation = Reservation(
+            reservation_id=self._repo.next_reservation_id(),
+            warehouse=warehouse,
+            items=held,
+            status=ReservationStatus.ACTIVE,
+            expires_at=self._clock.now() + RESERVATION_TTL,
+        )
+        self._repo.save_reservation(reservation)
+        self._repo.save_reservation_request(
+            ReservationRequest(idempotency_key, warehouse, wanted, reservation.reservation_id)
+        )
+        return reservation
+
+    def get_reservation(self, reservation_id: str) -> Reservation:
+        return self._settle(self._repo.get_reservation(reservation_id))
+
+    def confirm_reservation(self, reservation_id: str) -> Order:
+        """Turn an active hold into a PLACED order. Repeat calls return the same order."""
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            assert reservation.order_id is not None
+            return self._repo.get_order(reservation.order_id)
+        if reservation.status is ReservationStatus.EXPIRED:
+            raise ReservationExpired(reservation_id, reservation.expires_at)
+        if reservation.status is not ReservationStatus.ACTIVE:
+            raise InvalidReservationState(reservation_id, reservation.status, "confirm")
+        # The hold becomes the order's allocation, so no stock check here.
+        order = self._create_order(reservation.warehouse, reservation.items)
+        reservation.status = ReservationStatus.CONFIRMED
+        reservation.order_id = order.order_id
+        self._repo.save_reservation(reservation)
+        return order
+
+    def release_reservation(self, reservation_id: str) -> Reservation:
+        """Give the held stock back. Releasing a released or expired hold is a no-op."""
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            raise InvalidReservationState(reservation_id, reservation.status, "release")
+        if reservation.status is ReservationStatus.ACTIVE:
+            reservation.status = ReservationStatus.RELEASED
+            self._repo.save_reservation(reservation)
+        return reservation
+
     # -- helpers ---------------------------------------------------------
+    def _create_order(self, warehouse: str, items: Mapping[str, int]) -> Order:
+        order = Order(

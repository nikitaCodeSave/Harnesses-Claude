+def test_confirm_after_expiry_fails(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(minutes=30)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+# -- confirm --------------------------------------------------------------------
+def test_confirm_turns_hold_into_order(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.placed_at == clock.now()
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 4, "TEE": 2}
+    got = stocked.get_reservation(res.reservation_id)
+    assert (got.status, got.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert (stocked.held("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (0, 4)
+
+
+def test_confirm_does_not_change_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    before = stocked.available("MUG", "WH1")
+    stocked.confirm_reservation(res.reservation_id)
+    assert stocked.available("MUG", "WH1") == before == 6
+

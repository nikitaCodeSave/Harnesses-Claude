+# -- idempotency ----------------------------------------------------------------
+def test_retry_returns_original_without_new_hold_or_extension(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(minutes=5)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.expires_at == first.expires_at
+    assert stocked.held("MUG", "WH1") == 3
+
+
+def test_retry_compares_requested_not_held_items(stocked):
+    first = stocked.reserve("WH1", {"MUG": 50, "CAP": 1}, "k1")
+    assert first.items == {"MUG": 10}
+    assert stocked.reserve("WH1", {"CAP": 1, "MUG": 50}, "k1") is first
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+@pytest.mark.parametrize(
+    "warehouse, items", [("WH2", {"MUG": 3}), ("WH1", {"MUG": 4}), ("WH1", {"MUG": 3, "TEE": 1})]
+)
+def test_same_key_different_request_conflicts(stocked, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+
+
+def test_key_stays_bound_after_reservation_ends(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert (again.reservation_id, again.status) == (res.reservation_id, ReservationStatus.RELEASED)
+    assert stocked.held("MUG", "WH1") == 0
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 1}, "k1")
+
+
+def test_retry_of_expired_reservation_reports_expired(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL)
+    assert stocked.reserve("WH1", {"MUG": 3}, "k1").status is ReservationStatus.EXPIRED

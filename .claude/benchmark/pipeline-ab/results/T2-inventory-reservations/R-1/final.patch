@@ -0,0 +1,81 @@
+"""SPEC acceptance criteria 27-30: Release."""
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+
+
+# -- AC27 --------------------------------------------------------------------
+def test_ac27_releasing_active_frees_units_at_once(stocked):
+    r = stocked.reserve("WH1", {"MUG": 6, "TEE": 5}, "k1")
+    released = stocked.release_reservation(r.reservation_id)
+    assert released.reservation_id == r.reservation_id
+    assert released.status is models.ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.RELEASED
+
+
+def test_ac27_released_units_can_be_ordered_straight_away(stocked):
+    r = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    order = stocked.place_order("WH1", {"TEE": 5})
+    assert order.quantity_of("TEE") == 5
+
+
+# -- AC28 --------------------------------------------------------------------
+def test_ac28_releasing_released_changes_nothing(stocked):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    stocked.reserve("WH1", {"MUG": 4}, "k2")
+    again = stocked.release_reservation(r.reservation_id)
+    assert again.reservation_id == r.reservation_id
+    assert again.status is models.ReservationStatus.RELEASED
+    assert again.items == {"MUG": 6}
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_ac28_released_stays_released_after_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    clock.advance(hours=1)
+    again = stocked.release_reservation(r.reservation_id)
+    assert again.status is models.ReservationStatus.RELEASED
+
+
+# -- AC29 --------------------------------------------------------------------
+def test_ac29_releasing_lapsed_returns_it_expired(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.advance(minutes=30)
+    result = stocked.release_reservation(r.reservation_id)
+    assert result.reservation_id == r.reservation_id
+    assert result.status is models.ReservationStatus.EXPIRED
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_ac29_releasing_exactly_at_expires_at_returns_it_expired(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(r.expires_at)
+    result = stocked.release_reservation(r.reservation_id)
+    assert result.status is models.ReservationStatus.EXPIRED
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+# -- AC30 --------------------------------------------------------------------
+def test_ac30_releasing_confirmed_raises_and_leaves_order_alone(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.release_reservation(r.reservation_id)
+    stored = repo.get_order(order.order_id)
+    assert stored.status is OrderStatus.PLACED
+    assert stored.closed_at is None
+    assert {line.sku: line.quantity for line in stored.lines} == {"MUG": 6}
+    assert stocked.allocated("MUG", "WH1") == 6
+    assert stocked.available("MUG", "WH1") == 4
+    current = stocked.get_reservation(r.reservation_id)
+    assert current.status is models.ReservationStatus.CONFIRMED
+    assert current.order_id == order.order_id

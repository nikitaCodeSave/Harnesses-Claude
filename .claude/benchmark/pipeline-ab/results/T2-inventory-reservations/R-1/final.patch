+"""SPEC acceptance criteria 16-20: Availability."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+HOLD = timedelta(minutes=20)
+
+
+# -- AC16 --------------------------------------------------------------------
+def test_ac16_active_hold_reduces_available(stocked):
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.available("TEE", "WH1") == 3
+
+
+def test_ac16_holds_add_up(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.reserve("WH1", {"MUG": 4}, "k2")
+    assert stocked.available("MUG", "WH1") == 3
+
+
+def test_ac16_holds_never_affect_another_warehouse(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert stocked.available("MUG", "WH2") == 7
+    stocked.reserve("WH2", {"MUG": 2}, "k2")
+    assert stocked.available("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH2") == 5
+
+
+# -- AC17 --------------------------------------------------------------------
+def test_ac17_allocated_and_on_hand_ignore_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 5}, "k1")
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.allocated("MUG", "WH1") == 2
+    assert stocked.available("MUG", "WH1") == 3
+
+
+# -- AC18 --------------------------------------------------------------------
+def test_ac18_place_order_cannot_take_held_stock(stocked, repo):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3})
+    assert repo.orders() == []
+    order = stocked.place_order("WH1", {"MUG": 2})
+    assert order.quantity_of("MUG") == 2
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_ac18_place_order_stays_all_or_nothing_against_holds(stocked, repo):
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 1, "TEE": 2})
+    assert repo.orders() == []
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 1
+
+
+# -- AC19 --------------------------------------------------------------------
+def test_ac19_hold_still_counts_just_before_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(r.expires_at - timedelta(microseconds=1))
+    assert stocked.available("MUG", "WH1") == 4
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.ACTIVE
+
+
+def test_ac19_hold_lapses_exactly_at_expires_at_without_sweep(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(r.expires_at)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_ac19_lapsed_hold_units_can_be_ordered(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.advance(HOLD)
+    order = stocked.place_order("WH1", {"MUG": 10})
+    assert order.quantity_of("MUG") == 10
+
+
+def test_ac19_lapsed_hold_units_can_be_reserved_again(stocked, clock):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    clock.advance(minutes=25)
+    r = stocked.reserve("WH1", {"TEE": 5}, "k2")
+    assert r.items == {"TEE": 5}
+
+
+# -- AC20 --------------------------------------------------------------------
+def test_ac20_writeoff_below_held_is_allowed_and_available_floors_at_zero(stocked):
+    r = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    before = (r.reservation_id, dict(r.items), r.expires_at)
+    stocked.adjust("MUG", "WH1", -5, note="broken")
+    assert stocked.on_hand("MUG", "WH1") == 5
+    assert stocked.available("MUG", "WH1") == 0
+    current = stocked.get_reservation(r.reservation_id)
+    assert (current.reservation_id, current.items, current.expires_at) == before
+    assert current.status is models.ReservationStatus.ACTIVE
+
+
+def test_ac20_writeoff_to_zero_is_not_blocked_by_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -10, note="flood")
+    assert stocked.on_hand("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_ac20_receive_is_not_blocked_by_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.receive("MUG", "WH1", 4)
+    assert stocked.on_hand("MUG", "WH1") == 14
+    assert stocked.available("MUG", "WH1") == 4
+
+
+def test_ac20_receive_after_writeoff_below_held_stays_floored(stocked):
+    r = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")  # on-hand 5, held 8
+    stocked.receive("MUG", "WH1", 2)  # on-hand 7, held 8
+    assert stocked.available("MUG", "WH1") == 0
+    assert stocked.get_reservation(r.reservation_id).items == {"MUG": 8}

@@ -0,0 +1,161 @@
+"""SPEC acceptance criteria 1-10: Reserve."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import InventoryService
+
+HOLD = timedelta(minutes=20)
+
+
+# -- AC1 ---------------------------------------------------------------------
+def test_ac1_new_reservation_is_active_without_order_and_expires_after_hold(stocked, clock):
+    clock.advance(minutes=7)
+    reserved_at = clock.now()
+    r = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert isinstance(r, models.Reservation)
+    assert r.status is models.ReservationStatus.ACTIVE
+    assert r.order_id is None
+    assert r.expires_at == reserved_at + HOLD
+    assert r.warehouse == "WH1"
+    assert r.items == {"MUG": 3}
+
+
+# -- AC2 ---------------------------------------------------------------------
+def test_ac2_three_argument_constructor_still_works_and_defaults_to_20_minutes(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock)
+    service.receive("MUG", "WH1", 5)
+    r = service.reserve("WH1", {"MUG": 1}, "cart-1")
+    assert r.expires_at - clock.now() == timedelta(minutes=20)
+
+
+def test_ac2_default_hold_is_still_active_just_before_20_minutes(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    clock.advance(minutes=19, seconds=59)
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+
+
+# -- AC3 ---------------------------------------------------------------------
+def test_ac3_reservation_ids_are_sequential(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    second = stocked.reserve("WH2", {"MUG": 1}, "k2")
+    third = stocked.reserve("WH1", {"TEE": 1}, "k3")
+    assert [first.reservation_id, second.reservation_id, third.reservation_id] == [
+        "RES-0001",
+        "RES-0002",
+        "RES-0003",
+    ]
+
+
+# -- AC4 ---------------------------------------------------------------------
+def test_ac4_each_line_holds_min_of_requested_and_available(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4, "TEE": 8}, "k1")
+    assert r.items == {"MUG": 4, "TEE": 5}
+
+
+def test_ac4_available_right_now_accounts_for_orders_and_other_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 3})  # MUG available 7
+    first = stocked.reserve("WH1", {"MUG": 5}, "k1")  # MUG available 2
+    second = stocked.reserve("WH1", {"MUG": 5}, "k2")
+    assert first.items == {"MUG": 5}
+    assert second.items == {"MUG": 2}
+
+
+# -- AC5 ---------------------------------------------------------------------
+def test_ac5_line_with_nothing_available_is_left_out_of_items(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2, "CAP": 1}, "k1")
+    assert r.items == {"MUG": 2}
+    assert "CAP" not in r.items
+
+
+def test_ac5_line_fully_held_elsewhere_is_left_out_of_items(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    r = stocked.reserve("WH1", {"TEE": 1, "MUG": 1}, "k2")
+    assert r.items == {"MUG": 1}
+
+
+# -- AC6 ---------------------------------------------------------------------
+def test_ac6_nothing_holdable_raises_insufficient_stock_and_creates_nothing(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 3}, "k1")
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0001")
+
+
+def test_ac6_every_line_at_zero_raises_insufficient_stock(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1, "TEE": 2}, "k2")
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0002")
+    assert stocked.available("TEE", "WH1") == 0
+
+
+# -- AC7 ---------------------------------------------------------------------
+def test_ac7_unknown_warehouse(stocked):
+    with pytest.raises(errors.UnknownWarehouse):
+        stocked.reserve("NOPE", {"MUG": 1}, "k1")
+
+
+def test_ac7_unknown_sku(stocked):
+    with pytest.raises(errors.UnknownSku):
+        stocked.reserve("WH1", {"NOPE": 1}, "k1")
+
+
+# True is included because validation must match place_order, which rejects bools.
+@pytest.mark.parametrize("quantity", [0, -1, 1.5, "2", None, True])
+def test_ac7_bad_quantity(stocked, quantity):
+    with pytest.raises(errors.InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": quantity}, "k1")
+
+
+def test_ac7_empty_items(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {}, "k1")
+
+
+# -- AC8 ---------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("WH1", {"MUG": 3, "TEE": 0}, "InvalidQuantity"),
+        ("WH1", {"MUG": 3, "TEE": -2}, "InvalidQuantity"),
+        ("WH1", {"MUG": 3, "TEE": 1.5}, "InvalidQuantity"),
+        ("WH1", {"MUG": 3, "NOPE": 1}, "UnknownSku"),
+        ("NOPE", {"MUG": 3}, "UnknownWarehouse"),
+    ],
+)
+def test_ac8_rejected_request_holds_nothing_even_for_valid_lines(stocked, warehouse, items, error):
+    with pytest.raises(getattr(errors, error)):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0001")
+
+
+# -- AC9 ---------------------------------------------------------------------
+def test_ac9_empty_idempotency_key_is_rejected_and_creates_nothing(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {"MUG": 2}, "")
+    assert stocked.available("MUG", "WH1") == 10
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0001")
+
+
+# -- AC10 --------------------------------------------------------------------
+def test_ac10_holds_never_write_to_the_ledger_or_change_on_hand(stocked, ledger, clock):
+    entries = len(ledger)
+    a = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    stocked.reserve("WH1", {"MUG": 1}, "k2")
+    stocked.release_reservation(a.reservation_id)
+    clock.advance(minutes=30)  # the second hold lapses
+    stocked.get_reservation("RES-0002")
+    stocked.available("MUG", "WH1")
+    assert len(ledger) == entries
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.on_hand("TEE", "WH1") == 5

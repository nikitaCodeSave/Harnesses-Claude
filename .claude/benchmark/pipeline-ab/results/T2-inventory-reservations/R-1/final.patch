--- /dev/null
+++ b/tests/acceptance/test_interface.py
@@ -0,0 +1,29 @@
+"""SPEC "Interface (fixed)": new models and errors.
+
+New names are looked up on the module at test time so that each test fails on
+its own until the feature exists, instead of breaking collection.
+"""
+
+import dataclasses
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+
+def test_reservation_is_a_dataclass_with_the_named_fields():
+    assert dataclasses.is_dataclass(models.Reservation)
+    names = {f.name for f in dataclasses.fields(models.Reservation)}
+    assert {"reservation_id", "warehouse", "items", "status", "expires_at", "order_id"} <= names
+
+
+def test_reservation_status_members():
+    assert {m.name for m in models.ReservationStatus} == {"ACTIVE", "CONFIRMED", "RELEASED", "EXPIRED"}
+
+
+@pytest.mark.parametrize(
+    "name", ["ReservationNotFound", "ReservationExpired", "InvalidReservationState", "IdempotencyConflict"]
+)
+def test_new_errors_subclass_inventory_error(name):
+    assert issubclass(getattr(errors, name), errors.InventoryError)

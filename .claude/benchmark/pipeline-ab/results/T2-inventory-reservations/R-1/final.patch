+"""SPEC acceptance criteria 31-32: Lookup."""
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+
+# -- AC31 --------------------------------------------------------------------
+def test_ac31_get_reservation_returns_the_reservation(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    found = stocked.get_reservation(r.reservation_id)
+    assert isinstance(found, models.Reservation)
+    assert found.reservation_id == r.reservation_id
+    assert found.warehouse == "WH1"
+    assert found.items == {"MUG": 2, "TEE": 1}
+    assert found.expires_at == r.expires_at
+    assert found.order_id is None
+    assert found.status is models.ReservationStatus.ACTIVE
+
+
+def test_ac31_status_is_as_of_clock_now(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.ACTIVE
+    clock.set(r.expires_at)
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+    clock.advance(days=1)
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+# -- AC32 --------------------------------------------------------------------
+@pytest.mark.parametrize("method", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_ac32_unknown_reservation_id_raises_not_found(stocked, method):
+    with pytest.raises(errors.ReservationNotFound):
+        getattr(stocked, method)("RES-9999")
+
+
+@pytest.mark.parametrize("method", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_ac32_unknown_id_raises_not_found_when_other_reservations_exist(stocked, method):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(errors.ReservationNotFound):
+        getattr(stocked, method)("RES-0002")

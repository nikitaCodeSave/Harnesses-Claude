+"""SPEC acceptance criteria 21-26: Confirm."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+
+HOLD = timedelta(minutes=20)
+
+
+def _lines(order):
+    return {line.sku: line.quantity for line in order.lines}
+
+
+# -- AC21 --------------------------------------------------------------------
+def test_ac21_confirm_creates_placed_order_with_held_lines(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    clock.advance(minutes=5)
+    confirmed_at = clock.now()
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.order_id.startswith("ORD-")
+    assert order.placed_at == confirmed_at
+    assert order.warehouse == "WH1"
+    assert len(order.lines) == 2
+    assert _lines(order) == {"MUG": 3, "TEE": 2}
+
+
+def test_ac21_order_ids_continue_the_ord_sequence(stocked):
+    first = stocked.place_order("WH1", {"MUG": 1})
+    r = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    confirmed = stocked.confirm_reservation(r.reservation_id)
+    last = stocked.place_order("WH1", {"MUG": 1})
+    assert [first.order_id, confirmed.order_id, last.order_id] == ["ORD-0001", "ORD-0002", "ORD-0003"]
+
+
+def test_ac21_order_after_partial_hold_covers_only_held_units(stocked):
+    r = stocked.reserve("WH1", {"MUG": 15, "TEE": 2, "CAP": 4}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert len(order.lines) == 2
+    assert _lines(order) == {"MUG": 10, "TEE": 2}
+
+
+def test_ac21_order_is_stored_like_any_other(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert [o.order_id for o in repo.orders(status=OrderStatus.PLACED)] == [order.order_id]
+
+
+# -- AC22 --------------------------------------------------------------------
+def test_ac22_reservation_becomes_confirmed_with_order_id(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    current = stocked.get_reservation(r.reservation_id)
+    assert current.status is models.ReservationStatus.CONFIRMED
+    assert current.order_id == order.order_id
+
+
+# -- AC23 --------------------------------------------------------------------
+def test_ac23_available_is_unchanged_by_confirm(stocked):
+    stocked.place_order("WH1", {"MUG": 1})
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    before = stocked.available("MUG", "WH1")
+    stocked.confirm_reservation(r.reservation_id)
+    assert before == 5
+    assert stocked.available("MUG", "WH1") == 5
+    assert stocked.allocated("MUG", "WH1") == 5
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_ac23_allocation_outlives_the_hold_expiry(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(r.reservation_id)
+    clock.advance(hours=2)
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.allocated("MUG", "WH1") == 4
+
+
+def test_ac23_confirm_does_not_recheck_stock(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")  # on-hand 5 < held 8
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert _lines(order) == {"MUG": 8}
+    assert len(repo.orders()) == 1
+
+
+def test_ac23_on_hand_changes_only_when_the_order_ships(stocked, ledger):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    entries = len(ledger)
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert len(ledger) == entries
+    assert stocked.on_hand("MUG", "WH1") == 10
+    stocked.ship_order(order.order_id)
+    assert stocked.on_hand("MUG", "WH1") == 6
+    assert stocked.available("MUG", "WH1") == 6
+
+
+# -- AC24 --------------------------------------------------------------------
+def test_ac24_confirming_twice_returns_the_same_order(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(r.reservation_id)
+    second = stocked.confirm_reservation(r.reservation_id)
+    assert second.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_ac24_confirming_again_after_expires_at_returns_the_same_order(stocked, clock, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(r.reservation_id)
+    clock.advance(hours=1)
+    second = stocked.confirm_reservation(r.reservation_id)
+    assert second.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.CONFIRMED
+
+
+# -- AC25 --------------------------------------------------------------------
+def test_ac25_confirming_a_lapsed_reservation_raises(stocked, clock, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(minutes=21)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_ac25_confirming_exactly_at_expires_at_raises(stocked, clock, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(r.expires_at)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+
+
+def test_ac25_confirming_just_before_expires_at_succeeds(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(r.expires_at - timedelta(microseconds=1))
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert _lines(order) == {"MUG": 3}
+
+
+# -- AC26 --------------------------------------------------------------------
+def test_ac26_confirming_a_released_reservation_raises(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.RELEASED

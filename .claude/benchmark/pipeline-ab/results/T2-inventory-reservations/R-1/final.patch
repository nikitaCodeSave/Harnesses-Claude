@@ -0,0 +1,218 @@
+"""SPEC acceptance criteria 11-15: Idempotency."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+HOLD = timedelta(minutes=20)
+
+
+def _snapshot(r):
+    return (r.reservation_id, r.warehouse, dict(r.items), r.expires_at, r.order_id)
+
+
+# -- AC11 --------------------------------------------------------------------
+def test_ac11_keys_are_global_across_warehouses(stocked):
+    stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 2}, "cart-1")
+    assert stocked.available("MUG", "WH2") == 7
+
+
+def test_ac11_keys_are_remembered_for_the_life_of_the_service(stocked, clock):
+    original = stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    for n in range(5):
+        stocked.reserve("WH1", {"TEE": 1}, f"other-{n}")
+    clock.advance(days=30)
+    again = stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    assert again.reservation_id == original.reservation_id
+
+
+# -- AC12 --------------------------------------------------------------------
+def test_ac12_item_order_does_not_matter(stocked):
+    first = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "cart-1")
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "cart-1")
+    assert again.reservation_id == first.reservation_id
+    assert stocked.available("MUG", "WH1") == 8
+
+
+def test_ac12_comparison_uses_requested_not_held_items(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "cart-1")  # holds 10
+    assert first.items == {"MUG": 10}
+    again = stocked.reserve("WH1", {"MUG": 15}, "cart-1")
+    assert again.reservation_id == first.reservation_id
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "cart-1")
+
+
+def test_ac12_line_left_out_for_zero_stock_is_still_part_of_the_request(stocked):
+    first = stocked.reserve("WH1", {"MUG": 2, "CAP": 1}, "cart-1")
+    assert first.items == {"MUG": 2}
+    again = stocked.reserve("WH1", {"MUG": 2, "CAP": 1}, "cart-1")
+    assert again.reservation_id == first.reservation_id
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+
+
+# -- AC13 --------------------------------------------------------------------
+def test_ac13_retry_of_active_returns_original_without_new_hold(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    before = _snapshot(first)
+    clock.advance(minutes=5)
+    again = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert _snapshot(again) == before
+    assert again.status is models.ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 7
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0002")
+
+
+def test_ac13_retry_does_not_rehold_when_more_stock_arrives(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "cart-1")  # holds 10
+    stocked.receive("MUG", "WH1", 10)
+    again = stocked.reserve("WH1", {"MUG": 15}, "cart-1")
+    assert again.reservation_id == first.reservation_id
+    assert again.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_ac13_retry_of_expired_returns_it_expired_without_new_hold(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    before = _snapshot(first)
+    clock.advance(HOLD)
+    again = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert _snapshot(again) == before
+    assert again.status is models.ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0002")
+
+
+def test_ac13_retry_of_released_returns_it_released_without_new_hold(stocked):
+    first = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    before = _snapshot(first)
+    stocked.release_reservation(first.reservation_id)
+    again = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert _snapshot(again) == before
+    assert again.status is models.ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0002")
+
+
+def test_ac13_retry_of_confirmed_returns_it_confirmed_without_new_hold(stocked, repo):
+    first = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    order = stocked.confirm_reservation(first.reservation_id)
+    again = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert again.reservation_id == first.reservation_id
+    assert again.status is models.ReservationStatus.CONFIRMED
+    assert again.order_id == order.order_id
+    assert again.items == {"MUG": 3}
+    assert again.expires_at == first.expires_at
+    assert stocked.available("MUG", "WH1") == 7
+    assert len(repo.orders()) == 1
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0002")
+
+
+# -- AC14 --------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [
+        ("WH2", {"MUG": 3}),  # different warehouse
+        ("WH1", {"MUG": 4}),  # different quantity
+        ("WH1", {"MUG": 3, "TEE": 1}),  # extra line
+        ("WH1", {"TEE": 3}),  # different SKU
+    ],
+)
+def test_ac14_different_request_with_known_key_conflicts(stocked, warehouse, items):
+    first = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    before = _snapshot(first)
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve(warehouse, items, "cart-1")
+    current = stocked.get_reservation(first.reservation_id)
+    assert _snapshot(current) == before
+    assert current.status is models.ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH2") == 7
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0002")
+
+
+def test_ac14_missing_line_conflicts(stocked):
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "cart-1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+
+
+def _finish_released(service, clock, rid):
+    service.release_reservation(rid)
+
+
+def _finish_confirmed(service, clock, rid):
+    service.confirm_reservation(rid)
+
+
+def _finish_expired(service, clock, rid):
+    clock.advance(HOLD)
+
+
+@pytest.mark.parametrize(
+    "finish, status",
+    [
+        (_finish_released, "RELEASED"),
+        (_finish_confirmed, "CONFIRMED"),
+        (_finish_expired, "EXPIRED"),
+    ],
+)
+def test_ac14_conflict_even_when_original_is_finished(stocked, clock, repo, finish, status):
+    first = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    finish(stocked, clock, first.reservation_id)
+    available = stocked.available("MUG", "WH1")
+    orders = len(repo.orders())
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    assert stocked.get_reservation(first.reservation_id).status is getattr(models.ReservationStatus, status)
+    assert stocked.available("MUG", "WH1") == available
+    assert len(repo.orders()) == orders
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation("RES-0002")
+
+
+# -- AC15 --------------------------------------------------------------------
+def test_ac15_key_of_call_rejected_for_no_stock_is_treated_as_new(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "cart-1")
+    r = stocked.reserve("WH1", {"MUG": 1}, "cart-1")
+    assert r.items == {"MUG": 1}
+    assert r.status is models.ReservationStatus.ACTIVE
+
+
+def test_ac15_key_of_failed_call_can_reserve_once_stock_arrives(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "cart-1")
+    stocked.receive("CAP", "WH1", 5)
+    r = stocked.reserve("WH1", {"CAP": 2}, "cart-1")
+    assert r.items == {"CAP": 2}
+    assert stocked.available("CAP", "WH1") == 3
+
+
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [
+        ("NOPE", {"MUG": 1}),
+        ("WH1", {"NOPE": 1}),
+        ("WH1", {"MUG": 0}),
+        ("WH1", {}),
+    ],
+)
+def test_ac15_key_of_invalid_call_is_treated_as_new(stocked, warehouse, items):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve(warehouse, items, "cart-1")
+    r = stocked.reserve("WH2", {"MUG": 2}, "cart-1")
+    assert (r.warehouse, r.items) == ("WH2", {"MUG": 2})
+    assert stocked.available("MUG", "WH2") == 5
diff --git a/tests/acceptance/test_interface.py b/tests/acceptance/test_interface.py

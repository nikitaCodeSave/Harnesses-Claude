@@ -69,3 +69,37 @@ class Adjustment:
     at: datetime
     ref: str | None = None
     note: str | None = None
+
+
+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """Stock held for a cart in one warehouse until ``expires_at``.
+
+    ``items`` is what was actually held per SKU, which can be less than what
+    was requested. An ACTIVE reservation lapses (becomes EXPIRED) as soon as
+    the clock reaches ``expires_at``; nothing has to sweep it.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+
+
+@dataclass(frozen=True)
+class IdempotencyRecord:
+    """The first successful reserve request made under an idempotency key."""
+
+    key: str
+    warehouse: str
+    requested: dict[str, int]
+    reservation_id: str

+"""SPEC acceptance criterion 33: Compatibility.
+
+The rest of "existing behaviour stays unchanged" is covered by the existing
+suite under tests/, which must keep passing unmodified.
+"""
+
+import dataclasses
+
+from inventory.reports import StockRow, stock_report
+
+
+def test_ac33_stock_row_keeps_its_four_columns():
+    assert [f.name for f in dataclasses.fields(StockRow)] == ["sku", "on_hand", "allocated", "available"]
+
+
+def test_ac33_stock_report_available_reflects_holds(stocked, repo):
+    stocked.place_order("WH1", {"TEE": 1})
+    stocked.reserve("WH1", {"MUG": 4, "TEE": 3}, "k1")
+    assert stock_report(repo, stocked, "WH1") == [
+        StockRow("CAP", 0, 0, 0),
+        StockRow("MUG", 10, 0, 6),
+        StockRow("TEE", 5, 1, 1),
+    ]
+
+
+def test_ac33_stock_report_available_recovers_when_hold_lapses(stocked, repo, clock):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(minutes=20)
+    assert stock_report(repo, stocked, "WH1")[1] == StockRow("MUG", 10, 0, 10)

+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A time-limited hold on stock for a cart in a single warehouse.
+
+    While ACTIVE its ``items`` are Held: no longer Available, but not Allocated.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None
+    requested: dict[str, int]
+    reserved_at: datetime
+
+    def quantity_of(self, sku: str) -> int:
+        return self.items.get(sku, 0)
+
+    def has_expired_at(self, now: datetime) -> bool:
+        """True if this ACTIVE reservation's expiry time has been reached at ``now``."""
+        return self.status is ReservationStatus.ACTIVE and now >= self.expires_at
+
+    def is_replay_of(self, warehouse: str, requested: Mapping[str, int]) -> bool:
+        """True if a reserve request for ``warehouse`` and ``requested`` is this same request."""
+        return self.warehouse == warehouse and self.requested == dict(requested)

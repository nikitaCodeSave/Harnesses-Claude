+
+@pytest.mark.parametrize(
+    ("warehouse", "items"),
+    [
+        ("WH2", {"MUG": 3}),
+        ("WH1", {"MUG": 4}),
+        ("WH1", {"MUG": 3, "TEE": 1}),
+        ("WH1", {"TEE": 3}),
+    ],
+)
+def test_reusing_a_key_for_a_different_request_is_a_conflict(stocked, warehouse, items):
+    stocked.receive("MUG", "WH2", 10)
+    stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    with pytest.raises(IdempotencyConflict) as raised:
+        stocked.reserve(warehouse, items, "cart-1")
+    assert raised.value.idempotency_key == "cart-1"
+    assert (stocked.held("MUG", "WH1"), stocked.held("TEE", "WH1")) == (3, 0)

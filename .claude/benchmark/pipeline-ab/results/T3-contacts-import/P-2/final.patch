@@ -0,0 +1,826 @@
+import csv
+
+import pytest
+
+import contactbook
+from contactbook import (
+    Contact,
+    ContactError,
+    ImportFileError,
+    ImportReport,
+    InMemoryContactRepository,
+    RowIssue,
+    import_contacts,
+)
+from contactbook.export import export_csv
+
+
+def test_row_in_export_format_creates_a_contact():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(
+        repo, "name,email,phone,tags\nAnn Lee,ann@example.com,+15551234567,vip\n"
+    )
+
+    assert report.created == ["ann@example.com"]
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == [
+        Contact("Ann Lee", "ann@example.com", "+15551234567", frozenset({"vip"}))
+    ]
+
+
+def test_values_are_normalised_by_the_validators():

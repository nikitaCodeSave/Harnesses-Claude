+"""CSV import of contacts.
+
+``import_contacts`` loads a whole spreadsheet (saved as CSV) into a repository
+and returns an ``ImportReport``. The file uses the export's columns
+(``name``, ``email``, ``phone``, ``tags``), matched by header name. The
+address-book export's ``first_name`` and ``last_name`` pair may stand in for
+``name``; issues on the pair are reported on column ``name``.
+
+The import runs in two phases: file-level checks (decoding, CSV parsing, header,
+at most ``MAX_ROWS`` non-blank rows) happen before any row is applied, then each
+row is read and applied in file order.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from typing import TypeVar
+
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .errors import ImportFileError, ValidationError
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+HEADER_ROW = 1
+MAX_ROWS = 1000
+NAME_PARTS = ("first_name", "last_name")
+KNOWN_COLUMNS = frozenset(EXPORT_COLUMNS) | frozenset(NAME_PARTS)
+_BOM = "\ufeff"
+
+_T = TypeVar("_T")
+
+
+@dataclass(frozen=True, slots=True)
+class RowIssue:
+    """A problem on one spreadsheet row (the header is row 1).
+
+    ``column`` is the header name of the cell at fault, or ``None`` when the
+    issue concerns the row as a whole.
+    """
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    """What an import did. Emails are normalised and listed in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True, slots=True)
+class _Header:
+    """Position of each known column in a row; absent columns are missing.
+
+    ``width`` is the number of header cells; cells beyond it are extra.
+    ``order`` maps every named header cell (trimmed, lower-cased) to its
+    position, so issues on any column can follow the header's order.
+    ``warnings`` are the header's own Row warnings (unknown or unnamed columns).
+    ``uses_name_pair`` is true when ``first_name``/``last_name`` stand in for
+    ``name``.
+    """
+
+    positions: dict[str, int]
+    width: int
+    order: dict[str, int]
+    warnings: list[RowIssue]
+    uses_name_pair: bool
+
+    def cell(self, cells: list[str], column: str) -> str:
+        """The raw cell for ``column``; blank when the column or cell is absent."""
+        position = self.positions.get(column)
+        if position is None or position >= len(cells):
+            return ""
+        return cells[position]
+
+    def name_cell(self, cells: list[str]) -> str:
+        """The raw name: the ``name`` cell, or the pair's non-blank parts joined."""
+        if not self.uses_name_pair:
+            return self.cell(cells, "name")
+        parts = (self.cell(cells, column).strip() for column in NAME_PARTS)
+        return " ".join(part for part in parts if part)
+
+    def issue_order(self, issue: RowIssue) -> tuple[int, int, int]:
+        """Sort key: by row, then header column order, ``column=None`` last."""
+        position = None
+        if issue.column is not None:
+            position = self.order.get(issue.column.strip().lower())
+        if position is None:
+            return (issue.row, 1, 0)
+        return (issue.row, 0, position)
+
+
+@dataclass(frozen=True, slots=True)
+class _Row:
+    """A row's values, already validated and normalised."""
+
+    number: int
+    name: str
+    email: str
+    phone: str | None
+    tags: frozenset[str]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import every row of a CSV file into ``repo``.
+
+    Raises ImportFileError, with ``repo`` untouched, when the file as a whole
+    can't be imported.
+    """
+    text = _decode(data)
+    try:
+        sheet_rows = list(csv.reader(io.StringIO(text)))
+    except csv.Error as error:
+        raise ImportFileError(f"the file is not valid CSV: {error}") from None
+    if not sheet_rows:
+        raise ImportFileError("the file is empty")
+    header = _read_header(sheet_rows[0])
+
+    report = ImportReport(warnings=list(header.warnings))
+    contact_rows = [
+        (number, cells)
+        for number, cells in enumerate(sheet_rows[1:], start=HEADER_ROW + 1)
+        if not _is_blank(cells)
+    ]
+    if len(contact_rows) > MAX_ROWS:
+        raise ImportFileError(
+            f"the file has {len(contact_rows)} contact rows; split it into files "
+            f"of at most {MAX_ROWS}"
+        )
+    valid_rows: list[_Row] = []
+    first_row_by_email: dict[str, int] = {}
+    for number, cells in contact_rows:
+        row = _read_row(header, number, cells, first_row_by_email, report)
+        if row is not None:
+            valid_rows.append(row)
+    for row in valid_rows:
+        _apply(repo, row, report)
+    report.errors.sort(key=header.issue_order)
+    report.warnings.sort(key=header.issue_order)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            data = data.decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8; in Excel, save it as "CSV UTF-8"'
+            ) from None
+    elif not isinstance(data, str):
+        raise TypeError(
+            f"import_contacts expects str or bytes, not {type(data).__name__}"
+        )
+    return data.removeprefix(_BOM)
+
+
+def _read_header(cells: list[str]) -> _Header:
+    if len(cells) == 1 and ";" in cells[0]:
+        raise ImportFileError(
+            "the file looks semicolon-separated; save it with commas as the delimiter"
+        )
+    positions: dict[str, int] = {}
+    order: dict[str, int] = {}
+    warnings: list[RowIssue] = []
+    unnamed: list[RowIssue] = []
+    for i, cell in enumerate(cells):
+        column = cell.strip().lower()
+        if not column:
+            unnamed.append(
+                RowIssue(HEADER_ROW, None, f"column {i + 1} has no name, ignored")
+            )
+            continue
+        order.setdefault(column, i)
+        if column not in KNOWN_COLUMNS:
+            warnings.append(
+                RowIssue(HEADER_ROW, cell.strip(), "unknown column, ignored")
+            )
+            continue
+        if column in positions:
+            raise ImportFileError(f"the header has the {column} column twice")
+        positions[column] = i
+    if "email" not in positions:
+        raise ImportFileError("the header has no email column")
+    uses_name_pair = "name" not in positions
+    if not uses_name_pair and any(part in positions for part in NAME_PARTS):
+        raise ImportFileError(
+            "the header has name together with first_name/last_name; keep only one"
+        )
+    if uses_name_pair and not all(part in positions for part in NAME_PARTS):
+        raise ImportFileError("the header has no name column")
+    if uses_name_pair:
+        # Issues on the pair are reported on ``name``, at the pair's position.
+        order["name"] = min(positions[part] for part in NAME_PARTS)
+    return _Header(positions, len(cells), order, warnings + unnamed, uses_name_pair)
+
+
+def _is_blank(cells: list[str]) -> bool:
+    """No cells, or only cells that are empty after trimming whitespace."""
+    return not any(cell.strip() for cell in cells)
+
+
+def _read_row(
+    header: _Header,
+    number: int,
+    cells: list[str],
+    first_row_by_email: dict[str, int],
+    report: ImportReport,
+) -> _Row | None:
+    """Validate one row, reporting its issues; ``None`` when the row is skipped.
+
+    ``first_row_by_email`` maps each valid email seen so far to the first row
+    that had it.
+    """
+    errors: list[RowIssue] = []
+
+    def parse_cell(
+        column: str,
+        parse: Callable[[str], _T],
+        *,
+        issues: list[RowIssue],
+        cell: str | None = None,
+    ) -> _T | None:
+        """Parse ``column``'s cell (or ``cell``); a failure is added to ``issues``."""
+        try:
+            return parse(header.cell(cells, column) if cell is None else cell)
+        except ValidationError as error:
+            issues.append(RowIssue(number, column, error.message))
+            return None
+
+    name = parse_cell(
+        "name", validate_name, issues=errors, cell=header.name_cell(cells)
+    )
+    email = parse_cell("email", normalize_email, issues=errors)
+    if email is not None:
+        first = first_row_by_email.setdefault(email, number)
+        if first != number:
+            errors.append(
+                RowIssue(number, "email", f"duplicate of the email in row {first}")
+            )
+    # An invalid phone is a Row warning: the row goes ahead as if it were blank.
+    phone = parse_cell("phone", _read_phone, issues=report.warnings)
+    tags = parse_cell("tags", _read_tags, issues=errors)
+
+    if len(cells) > header.width:
+        extra = len(cells) - header.width
+        report.warnings.append(
+            RowIssue(number, None, f"{extra} cell(s) beyond the header were ignored")
+        )
+    report.errors.extend(errors)
+    if errors:
+        return None
+    return _Row(number=number, name=name, email=email, phone=phone, tags=tags)
+
+
+def _read_phone(cell: str) -> str | None:
+    if not cell.strip():
+        return None
+    return normalize_phone(cell)
+
+
+def _read_tags(cell: str) -> frozenset[str]:
+    pieces = (piece.strip() for piece in cell.split(TAG_SEPARATOR))
+    return frozenset(normalize_tag(piece) for piece in pieces if piece)
+
+
+def _apply(repo: InMemoryContactRepository, row: _Row, report: ImportReport) -> None:
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(
+            Contact(name=row.name, email=row.email, phone=row.phone, tags=row.tags)
+        )
+        report.created.append(row.email)
+        return
+    # ADR 0001: merge, don't replace. The name is replaced, tags are only added,
+    # and a row without a phone keeps the stored one.
+    merged = existing.rename(row.name).with_tags(*row.tags)
+    if row.phone is not None:
+        merged = merged.with_phone(row.phone)
+    repo.update(merged)
+    report.updated.append(row.email)

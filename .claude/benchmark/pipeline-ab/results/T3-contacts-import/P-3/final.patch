+
+    assert report == ImportReport(created=[], updated=[], errors=[], warnings=[])
+    assert repo.all() == before
+
+
+def test_reimporting_an_export_reports_nothing_and_changes_nothing():
+    repo = InMemoryContactRepository(
+        [
+            Contact.create(
+                name="Ann Lee", email="ann@example.com", phone="+1 555 123 4567", tags=["vip", "partner"]
+            ),
+            Contact.create(name="Bob Stone", email="bob@example.com"),
+            Contact.create(name="Zoë, Jr.", email="zoe@example.com", tags=["key account"]),
+        ]
+    )
+    before = repo.all()
+
+    report = import_contacts(repo, export_csv(repo.all()))
+
+    assert report == ImportReport(created=[], updated=[], errors=[], warnings=[])
+    assert repo.all() == before
+
+
+def test_file_mixing_new_and_existing_emails_fills_created_and_updated_in_file_order():
+    repo = InMemoryContactRepository(
+        [
+            Contact.create(name="Ann Lee", email="ann@example.com"),
+            Contact.create(name="Bob Stone", email="bob@example.com", tags=["vip"]),
+            Contact.create(name="Cat Moss", email="cat@example.com"),
+        ]
+    )
+    data = HEADER + (
+        "Dan Park,dan@example.com,,\n"
+        "Cat Moss,cat@example.com,,\n"  # unchanged
+        "Bob Stone,BOB@example.com,,partner\n"
+        "Eve Hart,eve@example.com,,\n"
+        "Ann Lee-Smith,ann@example.com,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report == ImportReport(
+        created=["dan@example.com", "eve@example.com"],
+        updated=["bob@example.com", "ann@example.com"],
+        errors=[],
+        warnings=[],
+    )
+    assert len(repo) == 5
+    assert repo.get("bob@example.com").tags == frozenset({"vip", "partner"})
+    assert repo.get("ann@example.com").name == "Ann Lee-Smith"

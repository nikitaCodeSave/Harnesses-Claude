+from contactbook.importer import RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def _repo_with_ann(phone=None, tags=()):
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone=phone, tags=tags)]
+    )
+
+
+def test_later_row_with_same_normalised_email_is_a_duplicate_error_and_not_applied():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Bob Stone,bob@example.com,,\n"
+        "Ann Lee,Ann@Example.com,,vip\n"
+        "Ann Other, ann@example.com ,5551234567,prospect\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == [RowIssue(row=4, column="email", message="duplicate of row 3")]
+    assert report.created == ["bob@example.com", "ann@example.com"]
+    assert report.updated == []
+    assert repo.find("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", tags=["vip"]
+    )
+
+
+def test_duplicates_of_a_rejected_first_row_are_still_errors_and_nothing_is_imported():
+    repo = _repo_with_ann(tags=["vip"])
+    before = repo.all()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Smith,ann@example.com,,bad_tag!\n"
+        "Ann Smith,ANN@example.com,5559999999,prospect\n"
+        "Ann Jones,ann@example.com,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == [
+        RowIssue(row=2, column="tags", message="invalid tag: 'bad_tag!'"),
+        RowIssue(row=3, column="email", message="duplicate of row 2"),
+        RowIssue(row=4, column="email", message="duplicate of row 2"),
+    ]
+    assert report.created == []
+    assert report.updated == []
+    assert repo.all() == before
+
+
+def test_rows_with_missing_or_invalid_email_take_no_part_in_duplicate_detection():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Lee,not-an-email,,\n"
+        "Bob Stone,,,\n"
+        "Cat Moss,not-an-email,,\n"
+        "Dan Fox,,,\n"
+        "Eve Hart,eve@example.com,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [
+        (2, "email"),
+        (3, "email"),
+        (4, "email"),
+        (5, "email"),
+    ]
+    assert not any("duplicate" in e.message for e in report.errors)
+    assert report.created == ["eve@example.com"]
+
+
+def test_an_existing_contact_repeated_in_the_file_is_listed_once():
+    repo = _repo_with_ann()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Smith,ann@example.com,,\n"
+        "Bob Stone,bob@example.com,,\n"
+        "Ann Jones,Ann@example.com,,vip\n"
+        "Bob Other,bob@example.com,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["bob@example.com"]
+    assert report.updated == ["ann@example.com"]
+    assert report.errors == [
+        RowIssue(row=4, column="email", message="duplicate of row 2"),
+        RowIssue(row=5, column="email", message="duplicate of row 3"),
+    ]
+    assert repo.all() == [
+        Contact.create(name="Ann Smith", email="ann@example.com"),
+        Contact.create(name="Bob Stone", email="bob@example.com"),
+    ]

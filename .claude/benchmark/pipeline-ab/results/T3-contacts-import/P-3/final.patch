+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def _repo_with_ann(phone=None, tags=()):
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone=phone, tags=tags)]
+    )
+
+
+def test_new_email_with_invalid_phone_is_created_without_phone_and_warned():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,123,vip\n")
+
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com", tags=frozenset({"vip"}))]
+    assert report == ImportReport(
+        created=["ann@example.com"],
+        updated=[],
+        errors=[],
+        warnings=[RowIssue(2, "phone", "must have 7-15 digits")],
+    )
+
+
+def test_rejected_row_reports_its_bad_phone_as_an_error_not_a_warning():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,123,bad_tag!\n")
+
+    assert repo.all() == []
+    assert report == ImportReport(
+        created=[],
+        updated=[],
+        errors=[
+            RowIssue(2, "phone", "must have 7-15 digits"),
+            RowIssue(2, "tags", "invalid tag: 'bad_tag!'"),
+        ],
+        warnings=[],
+    )
+
+
+def test_duplicate_row_with_bad_phone_reports_the_phone_as_an_error():
+    repo = InMemoryContactRepository()
+    data = HEADER + "Ann Lee,ann@example.com,,\nAnn Lee,ann@example.com,123,\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == []
+    assert [(e.row, e.column) for e in report.errors] == [(3, "phone"), (3, "email")]
+
+
+def test_phone_warnings_are_listed_in_row_order():
+    repo = InMemoryContactRepository()
+    data = HEADER + (
+        "Ann Lee,ann@example.com,12ab,\n"
+        ",bob@example.com,123,\n"
+        "Cat Moss,cat@example.com,555 123 4567,\n"
+        "Dan Ross,dan@example.com,123,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com", "cat@example.com", "dan@example.com"]
+    assert report.warnings == [
+        RowIssue(2, "phone", "is not a phone number: '12ab'"),
+        RowIssue(5, "phone", "must have 7-15 digits"),
+    ]
+
+
+def test_existing_email_with_invalid_phone_keeps_stored_phone_and_merges_the_rest():
+    repo = _repo_with_ann(phone="555-123-4567", tags=["vip"])
+
+    report = import_contacts(repo, HEADER + "Ann Smith,ann@example.com,555-12ab,partner\n")
+
+    assert repo.all() == [
+        Contact(
+            name="Ann Smith",
+            email="ann@example.com",
+            phone="5551234567",
+            tags=frozenset({"vip", "partner"}),
+        )
+    ]
+    assert report == ImportReport(
+        created=[],
+        updated=["ann@example.com"],
+        errors=[],
+        warnings=[RowIssue(2, "phone", "is not a phone number: '555-12ab'")],
+    )
+
+
+def test_update_whose_only_difference_is_a_bad_phone_is_unchanged_but_still_warned():
+    repo = _repo_with_ann(phone="555-123-4567", tags=["vip"])
+    before = repo.all()
+
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,123,vip\n")
+
+    assert repo.all() == before
+    assert report == ImportReport(
+        created=[],
+        updated=[],
+        errors=[],
+        warnings=[RowIssue(2, "phone", "must have 7-15 digits")],
+    )
+
+
+def test_applied_long_row_with_bad_phone_gets_both_warnings():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "\nAnn Lee,ann@example.com,123,vip,extra\n")
+
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com", tags=frozenset({"vip"}))]
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert [(w.row, w.column) for w in report.warnings] == [(3, "phone"), (3, None)]
+    assert "1 extra cell" in report.warnings[1].message
+
+
+def test_rejected_long_row_with_bad_phone_carries_only_errors():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,123,bad_tag!,extra\n")
+
+    assert repo.all() == []
+    assert report.errors == [
+        RowIssue(2, "phone", "must have 7-15 digits"),
+        RowIssue(2, "tags", "invalid tag: 'bad_tag!'"),
+    ]
+    assert report.warnings == []
diff --git a/tests/test_import_row_errors.py b/tests/test_import_row_errors.py
new file mode 100644
index 0000000..2e8c358
--- /dev/null
+++ b/tests/test_import_row_errors.py
@@ -0,0 +1,112 @@
+from contactbook.importer import RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def _repo_with_ann(phone=None, tags=()):
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone=phone, tags=tags)]
+    )
+
+
+def test_row_with_invalid_email_is_skipped_and_reported_while_valid_rows_import():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Lee,not-an-email,,\n"
+        "Bob Stone,bob@example.com,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["bob@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [(2, "email")]
+    assert "not-an-email" in report.errors[0].message
+    assert not report.errors[0].message.startswith("email")
+    assert repo.all() == [Contact(name="Bob Stone", email="bob@example.com")]
+
+
+def test_every_invalid_field_in_a_row_is_reported_once_with_its_column():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Bob Stone,bob@example.com,,\n"
+        ",,,vip;bad_tag!\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == [
+        RowIssue(row=3, column="name", message="is required"),
+        RowIssue(row=3, column="email", message="is required"),
+        RowIssue(row=3, column="tags", message="invalid tag: 'bad_tag!'"),
+    ]
+    assert report.created == ["bob@example.com"]
+    assert repo.all() == [Contact(name="Bob Stone", email="bob@example.com")]
+
+
+def test_rejected_row_leaves_an_existing_contact_completely_unchanged():
+    repo = _repo_with_ann(phone="5551234567", tags=["vip"])
+    before = repo.all()
+    data = "name,email,phone,tags\nAnn Smith,ANN@example.com,5559999999,new;bad_tag!\n"
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "tags")]
+    assert report.created == []
+    assert report.updated == []
+    assert repo.all() == before
+
+
+def test_blank_name_is_an_error_even_for_an_existing_contact():
+    repo = _repo_with_ann(phone="5551234567", tags=["vip"])
+    before = repo.all()
+    data = "name,email,phone,tags\n  ,ann@example.com,5559999999,prospect\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == [RowIssue(row=2, column="name", message="is required")]
+    assert report.created == []
+    assert report.updated == []
+    assert repo.all() == before
+
+
+def test_tags_cell_is_split_on_semicolons_with_blanks_dropped_and_repeats_collapsed():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Lee,ann@example.com,,vip; ;prospect;\n"
+        "Bob Stone,bob@example.com,,vip;VIP\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == []
+    assert repo.get("ann@example.com").tags == frozenset({"vip", "prospect"})
+    assert repo.get("bob@example.com").tags == frozenset({"vip"})
+
+
+def test_tag_containing_a_comma_is_invalid_and_rejects_the_row():
+    repo = InMemoryContactRepository()
+    data = 'name,email,phone,tags\nAnn Lee,ann@example.com,,"vip, prospect"\n'
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "tags")]
+    assert "vip, prospect" in report.errors[0].message
+    assert report.created == []
+    assert len(repo) == 0
+
+
+def test_errors_are_listed_in_row_order():
+    data = (
+        "name,email,phone,tags\n"
+        ",ann@example.com,,\n"
+        "Bob Stone,bob@example.com,,\n"
+        "Cat Moss,cat@,,\n"
+    )
+
+    report = import_contacts(InMemoryContactRepository(), data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name"), (4, "email")]
+    assert report.created == ["bob@example.com"]
diff --git a/tests/test_import_rows.py b/tests/test_import_rows.py

+++ b/tests/test_import_rows.py
@@ -0,0 +1,108 @@
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def test_blank_rows_count_toward_row_numbers():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Lee,ann@example.com,,\n"
+        "\n"
+        "\n"
+        "Bob Stone,not-an-email,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(5, "email")]
+    assert report.created == ["ann@example.com"]
+
+
+def test_quoted_cell_with_line_breaks_counts_as_one_row():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        '"Ann\nLee\nJr",ann@example.com,,\n'
+        "Bob Stone,not-an-email,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(3, "email")]
+
+
+def test_blank_lines_before_the_header_still_count_toward_row_numbers():
+    repo = InMemoryContactRepository()
+    data = (
+        "\n"
+        ",,,\n"
+        "name,email,phone,tags\n"
+        "Bob Stone,not-an-email,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(4, "email")]
+
+
+def test_row_of_only_commas_before_the_header_is_skipped_and_still_counts_toward_row_numbers():
+    repo = InMemoryContactRepository()
+    data = (
+        ",,,\n"
+        "name,email,phone,tags\n"
+        "Ann Lee,ann@example.com,,\n"
+        "Bob Stone,not-an-email,,\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [(4, "email")]
+
+
+def test_rows_of_blank_cells_are_skipped_silently():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        ",,,\n"
+        "  , ,,\n"
+        "Ann Lee,ann@example.com,,\n"
+        ",\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report == ImportReport(created=["ann@example.com"])
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com")]
+
+
+def test_short_row_treats_missing_cells_as_blank():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Lee,ann@example.com\n"
+        "Bob Stone\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [RowIssue(row=3, column="email", message="is required")]
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com")]
+
+
+def test_long_row_is_imported_with_a_warning_about_the_ignored_cells():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann Lee,ann@example.com,,vip,Acme,notes\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert [(w.row, w.column) for w in report.warnings] == [(2, None)]
+    assert "2 extra cells" in report.warnings[0].message
+    assert repo.all() == [Contact.create(name="Ann Lee", email="ann@example.com", tags=["vip"])]

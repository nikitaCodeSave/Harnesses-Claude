+"""CSV import of contacts.
+
+Reads the Export format back in, but is lenient about the header: columns may
+come in any order and case, phone and tags are optional, unknown columns are
+ignored, and the name may be split across first_name and last_name columns.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+NAME_PARTS = ("first_name", "last_name")
+KNOWN_COLUMNS = (*EXPORT_COLUMNS, *NAME_PARTS)
+BOM = "\ufeff"
+MAX_CONTACT_ROWS = 1000
+
+
+@dataclass
+class RowIssue:
+    """A Row error or Row warning: Excel row number, column (or None), reason."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What one Import did. Emails are normalised and in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Load a whole CSV file into ``repo``: create new Contacts, merge existing ones.
+
+    The header needs an email column and either a name column or both
+    first_name and last_name; see the module docstring for what else is accepted.
+    Raises ImportFileError, with nothing imported, if the file can't be imported
+    at all; problems with single rows end up in the returned report instead.
+    """
+    text = _decode(data)
+    # Excel row numbers: every CSV record counts, blank ones included.
+    rows = [
+        (row_number, cells)
+        for row_number, cells in enumerate(_parse(text), start=1)
+        if not _is_blank(cells)
+    ]
+    if not rows:
+        raise ImportFileError("file is empty")
+    header_row, header = rows[0]
+    _reject_semicolon_separated(header)
+    report = ImportReport()
+    columns = _read_header(header, header_row, report)
+    # Row limit: after the header checks, before any row is processed.
+    # Blank rows were already dropped; rows that will be rejected still count.
+    contact_rows = len(rows) - 1
+    if contact_rows > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"file has {contact_rows} contact rows; the limit is {MAX_CONTACT_ROWS} rows, "
+            "so split it into smaller files and import each one"
+        )
+
+    contacts = []
+    first_row_by_email: dict[str, int] = {}
+    for row_number, cells in rows[1:]:
+        cells = cells + [""] * (len(header) - len(cells))  # short row: missing cells are blank
+        values = {name: cells[index] for name, index in columns.items()}
+        name = _row_name(values)
+        tags = [tag for tag in values.get("tags", "").split(TAG_SEPARATOR) if tag.strip()]
+        phone = values.get("phone")
+        issues = _field_issues(row_number, name, values["email"], phone, tags)
+        email_key = _email_key(values["email"])
+        if email_key in first_row_by_email:
+            first_row = first_row_by_email[email_key]
+            issues.append(RowIssue(row_number, "email", f"duplicate of row {first_row}"))
+        elif email_key is not None:
+            first_row_by_email[email_key] = row_number
+        if any(issue.column != "phone" for issue in issues):
+            report.errors.extend(issues)
+            continue
+        if issues:
+            # A bad phone alone doesn't cost the row: drop the phone, warn.
+            report.warnings.extend(issues)
+            phone = None
+        extra_cells = len(cells) - len(header)
+        if extra_cells > 0:
+            report.warnings.append(
+                RowIssue(
+                    row_number,
+                    None,
+                    f"{extra_cells} extra cell{'s' if extra_cells != 1 else ''} ignored",
+                )
+            )
+        contacts.append(
+            Contact.create(
+                name=name,
+                email=values["email"],
+                phone=phone,
+                tags=tags,
+            )
+        )
+
+    for contact in contacts:
+        _apply(repo, contact, report)
+    return report
+
+
+def _read_header(cells: list[str], row: int, report: ImportReport) -> dict[str, int]:
+    """Map each recognised column to its cell index; warn about unknown ones."""
+    columns = {}
+    for index, cell in enumerate(cells):
+        written = cell.strip()
+        name = written.lower()
+        if name in KNOWN_COLUMNS:
+            if name in columns:
+                raise ImportFileError(f'column "{name}" appears more than once')
+            columns[name] = index
+        else:
+            report.warnings.append(RowIssue(row, None, f'ignored unknown column "{written}"'))
+    if "name" in columns and any(part in columns for part in NAME_PARTS):
+        raise ImportFileError('name given twice: use "name" or "first_name"/"last_name", not both')
+    if "email" not in columns:
+        raise ImportFileError('missing required column "email"')
+    if "name" not in columns and not all(part in columns for part in NAME_PARTS):
+        raise ImportFileError(
+            'missing required column "name" (or both "first_name" and "last_name")'
+        )
+    return columns
+
+
+def _row_name(values: dict[str, str]) -> str:
+    """The row's raw name: the name cell, or the first/last name parts joined."""
+    if "name" in values:
+        return values["name"]
+    parts = (values[part].strip() for part in NAME_PARTS)
+    return " ".join(part for part in parts if part)
+
+
+def _decode(data: str | bytes) -> str:
+    """Turn the file content into text: strict UTF-8 for bytes, BOM removed."""
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                "file is not UTF-8 encoded; in Excel, re-save it as "
+                '"CSV UTF-8 (Comma delimited)" and import that file'
+            ) from None
+    elif isinstance(data, str):
+        text = data
+    else:
+        raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+    return text.removeprefix(BOM)
+
+
+def _parse(text: str) -> list[list[str]]:
+    """Every CSV record in ``text``, blank ones included (comma, standard quoting)."""
+    try:
+        return list(csv.reader(io.StringIO(text, newline=""), strict=True))
+    except csv.Error as exc:
+        raise ImportFileError(f"file is not valid CSV ({exc}); check for unclosed quotes") from None
+
+
+def _reject_semicolon_separated(header: list[str]) -> None:
+    if len(header) == 1 and ";" in header[0]:
+        raise ImportFileError(
+            "file looks semicolon-separated; contactbook needs comma-separated CSV. "
+            'In Excel, re-save it as "CSV UTF-8 (Comma delimited)"'
+        )
+
+
+def _field_issues(
+    row: int, name: str, email: str, phone: str | None, tags: list[str]
+) -> list[RowIssue]:
+    """One RowIssue per invalid field (name, email, phone, tags), in that order.
+
+    The caller decides whether they become Row errors or (a bad phone alone) a Row warning.
+
+    A blank phone means "no phone given" and is not an issue.
+    """
+    checks = (
+        lambda: validate_name(name),
+        lambda: normalize_email(email),
+        lambda: phone and phone.strip() and normalize_phone(phone),
+        lambda: normalize_tags(tags),
+    )
+    issues = []
+    for check in checks:
+        try:
+            check()
+        except ValidationError as error:
+            issues.append(RowIssue(row, error.field, error.message))
+    return issues
+
+
+def _email_key(email: str) -> str | None:
+    """The normalised email that duplicate detection compares on.
+
+    None for a missing or invalid email: such rows take no part in duplicate detection.
+    """
+    try:
+        return normalize_email(email)
+    except ValidationError:
+        return None
+
+
+def _apply(repo: InMemoryContactRepository, incoming: Contact, report: ImportReport) -> None:
+    """Create ``incoming``, or merge it into the stored Contact with that email.
+
+    Merge: the name is replaced, a phone replaces the stored one (no phone keeps
+    it), and tags are added to the stored ones.
+    """
+    stored = repo.find(incoming.email)
+    if stored is None:
+        repo.add(incoming)
+        report.created.append(incoming.email)
+        return
+    merged = stored.rename(incoming.name).with_tags(*incoming.tags)
+    if incoming.phone:
+        merged = merged.with_phone(incoming.phone)
+    if merged == stored:
+        return
+    repo.update(merged)
+    report.updated.append(incoming.email)
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)

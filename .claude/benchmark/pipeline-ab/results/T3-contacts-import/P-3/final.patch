@@ -0,0 +1,66 @@
+import pytest
+
+from contactbook import ImportFileError
+from contactbook.importer import import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def _repo_with_ann(phone=None, tags=()):
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone=phone, tags=tags)]
+    )
+
+
+def _contact_rows(count: int) -> str:
+    return "".join(f"Person {i},person{i}@example.com,,\n" for i in range(count))
+
+
+def test_file_over_1000_contact_rows_is_rejected_and_nothing_is_imported():
+    repo = _repo_with_ann()
+    before = repo.all()
+
+    with pytest.raises(ImportFileError, match="1000 rows") as raised:
+        import_contacts(repo, HEADER + _contact_rows(1001))
+
+    assert "split" in str(raised.value)
+    assert repo.all() == before
+
+
+def test_file_with_exactly_1000_contact_rows_is_imported():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, HEADER + _contact_rows(1000))
+
+    assert len(report.created) == 1000
+    assert report.errors == []
+    assert repo.find("person999@example.com") == Contact(
+        name="Person 999", email="person999@example.com"
+    )
+
+
+def test_blank_rows_do_not_count_toward_the_limit():
+    repo = InMemoryContactRepository()
+    data = HEADER + "\n,,,\n" + _contact_rows(1000) + "\n" + ",,,\n" * 5 + "  ,\t, ,\n"
+
+    report = import_contacts(repo, data)
+
+    assert len(report.created) == 1000
+
+
+@pytest.mark.parametrize(
+    "rejected_row",
+    [
+        "Bad Email,not-an-email,,\n",  # invalid field
+        "Person Again,person0@example.com,,\n",  # duplicate email in the file
+    ],
+)
+def test_rows_that_would_be_rejected_count_toward_the_limit(rejected_row):
+    repo = InMemoryContactRepository()
+
+    with pytest.raises(ImportFileError, match="1000 rows"):
+        import_contacts(repo, HEADER + _contact_rows(1000) + rejected_row)
+
+    assert repo.all() == []

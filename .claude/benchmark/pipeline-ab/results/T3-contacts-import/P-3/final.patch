+
+def test_row_with_existing_email_updates_that_contact_instead_of_adding_one():
+    repo = _repo_with_ann()
+
+    report = import_contacts(repo, HEADER + "Ann Smith,  ANN@Example.com ,,\n")
+
+    assert repo.all() == [Contact(name="Ann Smith", email="ann@example.com")]
+    assert report == ImportReport(created=[], updated=["ann@example.com"], errors=[], warnings=[])

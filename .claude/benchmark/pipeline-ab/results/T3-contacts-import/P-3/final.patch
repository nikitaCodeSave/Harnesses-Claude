+
+def test_filled_in_phone_cell_replaces_the_stored_phone():
+    repo = _repo_with_ann(phone="555-123-4567")
+
+    import_contacts(repo, HEADER + "Ann Lee,ann@example.com,+44 20 7946 0000,\n")
+

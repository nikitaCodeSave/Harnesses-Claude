+import pytest
+
+from contactbook import ImportFileError
+from contactbook.importer import ImportReport, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def _repo_with_ann(phone=None, tags=()):
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone=phone, tags=tags)]
+    )
+
+
+def test_clean_file_creates_one_normalised_contact_per_row():
+    repo = InMemoryContactRepository()
+    data = (
+        "name,email,phone,tags\n"
+        "Ann  Lee,Ann@Example.COM,+1 (555) 123-4567,vip;Key Account\n"
+        "Bob Stone,bob@example.com,,\n"
+    )
+
+    import_contacts(repo, data)
+
+    assert repo.all() == [
+        Contact(
+            name="Ann Lee",
+            email="ann@example.com",
+            phone="+15551234567",
+            tags=frozenset({"vip", "key-account"}),
+        ),
+        Contact(name="Bob Stone", email="bob@example.com"),
+    ]
+
+
+def test_report_lists_created_emails_in_file_order_and_nothing_else():
+    data = (
+        "name,email,phone,tags\n"
+        "Cat Moss,Cat@Example.com,,\n"
+        "Ann Lee,ann@example.com,,\n"
+    )
+
+    report = import_contacts(InMemoryContactRepository(), data)
+
+    assert report == ImportReport(
+        created=["cat@example.com", "ann@example.com"],
+        updated=[],
+        errors=[],
+        warnings=[],
+    )
+
+
+@pytest.mark.parametrize("data", ["", "   \n\n  \n"])
+def test_empty_file_is_rejected_and_changes_nothing(data):
+    repo = _repo_with_ann()
+    before = repo.all()
+
+    with pytest.raises(ImportFileError, match="file is empty"):
+        import_contacts(repo, data)
+
+    assert repo.all() == before
+
+
+@pytest.mark.parametrize(
+    ("header", "missing"),
+    [("email,phone,tags", "name"), ("name,phone,tags", "email")],
+)
+def test_file_missing_a_required_column_is_rejected_and_changes_nothing(header, missing):
+    repo = _repo_with_ann()
+    before = repo.all()
+    data = f"{header}\nBob Stone,,\n"
+
+    with pytest.raises(ImportFileError, match=missing):
+        import_contacts(repo, data)
+
+    assert repo.all() == before
+
+
+def test_header_only_file_returns_an_empty_report():
+    repo = _repo_with_ann()
+    before = repo.all()
+
+    report = import_contacts(repo, "name,email,phone,tags\n")
+
+    assert report == ImportReport(created=[], updated=[], errors=[], warnings=[])
+    assert repo.all() == before
+
+
+@pytest.mark.parametrize("data", [None, 42, ["name,email"]])
+def test_data_that_is_neither_text_nor_bytes_is_a_type_error(data):
+    with pytest.raises(TypeError):
+        import_contacts(InMemoryContactRepository(), data)

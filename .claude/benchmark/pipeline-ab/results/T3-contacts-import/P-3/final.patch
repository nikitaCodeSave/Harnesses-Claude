@@ -0,0 +1,77 @@
+import pytest
+
+from contactbook import ContactError, ImportFileError
+from contactbook.importer import ImportReport, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+CLEAN_TEXT = "name,email,phone,tags\nZoë Brontë,zoe@example.com,,vip\n"
+ZOE = Contact(name="Zoë Brontë", email="zoe@example.com", tags=frozenset({"vip"}))
+
+
+def _repo_with_ann(phone=None, tags=()):
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone=phone, tags=tags)]
+    )
+
+
+def test_utf8_bytes_import_exactly_like_the_same_text():
+    from_bytes, from_text = InMemoryContactRepository(), InMemoryContactRepository()
+
+    bytes_report = import_contacts(from_bytes, CLEAN_TEXT.encode("utf-8"))
+    text_report = import_contacts(from_text, CLEAN_TEXT)
+
+    assert bytes_report == text_report == ImportReport(created=["zoe@example.com"])
+    assert from_bytes.all() == from_text.all() == [ZOE]
+
+
+@pytest.mark.parametrize(
+    "data",
+    [b"\xef\xbb\xbf" + CLEAN_TEXT.encode("utf-8"), "\ufeff" + CLEAN_TEXT],
+    ids=["excel-csv-utf8-bytes", "text"],
+)
+def test_leading_bom_is_ignored_so_the_name_column_is_still_found(data):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, data)
+
+    assert report == ImportReport(created=["zoe@example.com"])
+    assert repo.all() == [ZOE]
+
+
+def test_cp1252_file_is_rejected_with_a_hint_to_resave_as_csv_utf8():
+    repo = _repo_with_ann()
+    before = repo.all()
+    data = CLEAN_TEXT.encode("cp1252")  # what Excel's plain "CSV" produces
+
+    with pytest.raises(ImportFileError, match="CSV UTF-8") as raised:
+        import_contacts(repo, data)
+
+    assert isinstance(raised.value, ContactError)
+    assert repo.all() == before
+
+
+def test_semicolon_separated_file_is_rejected_as_such():
+    repo = _repo_with_ann()
+    before = repo.all()
+    data = "name;email;phone;tags\nBob Stone;bob@example.com;;vip\n"
+
+    with pytest.raises(ImportFileError, match="semicolon"):
+        import_contacts(repo, data)
+
+    assert repo.all() == before
+
+
+def test_csv_with_an_unclosed_quote_is_rejected_and_changes_nothing():
+    repo = _repo_with_ann()
+    before = repo.all()
+    data = (
+        "name,email,phone,tags\n"
+        "Bob Stone,bob@example.com,,vip\n"
+        '"Cat Moss,cat@example.com,,\n'
+    )
+
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, data)
+
+    assert repo.all() == before

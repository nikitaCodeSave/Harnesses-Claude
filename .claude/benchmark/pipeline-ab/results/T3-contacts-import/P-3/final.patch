+
+def test_headers_match_regardless_of_case_spaces_and_order():
+    repo = InMemoryContactRepository()
+    data = " Email ,NAME\nann@example.com,Ann Lee\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com")]
+
+
+def test_phone_and_tags_columns_are_optional_and_merge_as_blank():
+    repo = _repo_with_ann(phone="5551234567", tags=["vip"])
+    data = "name,email\nAnn Smith,ann@example.com\nBob Stone,bob@example.com\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["bob@example.com"]
+    assert report.updated == ["ann@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.find("ann@example.com") == Contact.create(
+        name="Ann Smith", email="ann@example.com", phone="5551234567", tags=["vip"]
+    )
+
+
+def test_each_unknown_column_is_ignored_with_a_warning_on_the_header_row():
+    repo = InMemoryContactRepository()
+    data = "name,Company,email, Notes \nAnn Lee,Acme,ann@example.com,likes tea\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert [(w.row, w.column) for w in report.warnings] == [(1, None), (1, None)]
+    assert 'ignored unknown column "Company"' in report.warnings[0].message
+    assert '"Notes"' in report.warnings[1].message
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com")]
+
+
+def test_a_recognised_column_given_twice_rejects_the_file():
+    repo = _repo_with_ann()
+    before = repo.all()
+    data = "name,email,Email\nBob Stone,bob@example.com,bob@example.com\n"
+
+    with pytest.raises(ImportFileError, match="email"):
+        import_contacts(repo, data)
+
+    assert repo.all() == before
+
+
+def test_first_and_last_name_columns_are_joined_into_the_name():
+    repo = InMemoryContactRepository()
+    data = (
+        "First_Name, last_name ,email\n"
+        " Ann , Lee ,ann@example.com\n"
+        "Cher,,cher@example.com\n"
+        ",Prince,prince@example.com\n"
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com", "cher@example.com", "prince@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == [
+        Contact(name="Ann Lee", email="ann@example.com"),
+        Contact(name="Cher", email="cher@example.com"),
+        Contact(name="Prince", email="prince@example.com"),
+    ]
+
+
+def test_blank_first_and_last_name_is_a_name_required_error():
+    repo = InMemoryContactRepository()
+    data = "first_name,last_name,email\n , ,blank@example.com\nAnn,Lee,ann@example.com\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == [RowIssue(row=2, column="name", message="is required")]
+    assert report.created == ["ann@example.com"]
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com")]
+
+
+def test_first_and_last_name_too_long_together_is_a_name_error():
+    repo = InMemoryContactRepository()
+    data = f"first_name,last_name,email\n{'A' * 60},{'B' * 60},long@example.com\n"
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name")]
+    assert "longer than" in report.errors[0].message
+    assert report.created == []
+    assert repo.all() == []
+
+
+@pytest.mark.parametrize("header", ["first_name,email", "email,Last_Name"])
+def test_only_one_of_first_and_last_name_is_a_missing_name_column(header):
+    repo = _repo_with_ann()
+    before = repo.all()
+
+    with pytest.raises(ImportFileError, match="name"):
+        import_contacts(repo, f"{header}\nBob,bob@example.com\n")
+
+    assert repo.all() == before
+
+
+@pytest.mark.parametrize(
+    "header", ["name,first_name,last_name,email", "name,email,last_name", "First_Name,email,Name"]
+)
+def test_name_together_with_first_or_last_name_rejects_the_file(header):
+    repo = _repo_with_ann()
+    before = repo.all()
+
+    with pytest.raises(ImportFileError, match="name"):
+        import_contacts(repo, f"{header}\nBob,bob@example.com,Bob,Bob\n")
+
+    assert repo.all() == before
+
+
+def test_unknown_column_warning_uses_the_header_row_after_leading_blank_rows():
+    repo = InMemoryContactRepository()
+    data = "\n,,\nname,email,company\nAnn Lee,ann@example.com,Acme\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert [(w.row, w.column) for w in report.warnings] == [(3, None)]

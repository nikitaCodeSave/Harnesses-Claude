@@ -0,0 +1,266 @@
+"""CSV import of contacts.
+
+Reads the columns written by ``export_csv`` (and ``first_name``/``last_name``
+files from the address-book export script) and merges them into a repository.
+An import only adds: it never removes tags or clears a phone. Bad rows are
+skipped and reported; a file that can't be imported as a whole raises
+ImportFileError before anything is changed.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_DATA_ROWS = 1000
+
+_BOM = "\ufeff"
+_RECOGNISED_COLUMNS = ("name", "email", "phone", "tags", "first_name", "last_name")
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row. ``row`` is the 1-based line number in the file
+    (the header is row 1); ``column`` is ``name``, ``email``, ``phone``,
+    ``tags`` or None when the issue isn't about one field."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _Columns:
+    """Header positions of the columns the importer reads."""
+
+    email: int
+    name: int | None
+    first_name: int | None
+    last_name: int | None
+    phone: int | None
+    tags: int | None
+    width: int
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import CSV ``data`` into ``repo`` and report what happened.
+
+    Raises ImportFileError (leaving ``repo`` untouched) if the file can't be
+    imported as a whole, and TypeError if ``data`` is not str or bytes.
+    """
+    text = _decode(data)
+    if not text.strip():
+        raise ImportFileError("the file is empty")
+
+    header, rows = _parse(text)
+    report = ImportReport()
+    columns = _read_header(header, report)
+    if not rows:
+        # A header with no data rows returns an empty report, header warnings
+        # included (SPEC criterion 15).
+        return ImportReport()
+
+    # Everything that can reject the file has been checked; from here on each
+    # row stands on its own.
+    first_seen: dict[str, int] = {}
+    for row_number, cells in rows:
+        _import_row(repo, columns, row_number, cells, first_seen, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, str):
+        return data.removeprefix(_BOM)
+    if not isinstance(data, bytes):
+        raise TypeError(f"data must be str or bytes, not {type(data).__name__}")
+    try:
+        return data.decode("utf-8-sig")
+    except UnicodeDecodeError as exc:
+        line = data[: exc.start].count(b"\n") + 1
+        raise ImportFileError(
+            f"the file is not valid UTF-8 (line {line}); "
+            'open it in your spreadsheet and re-save it as "CSV UTF-8"'
+        ) from None
+
+
+def _parse(text: str) -> tuple[list[str], list[tuple[int, list[str]]]]:
+    """Split the file into the header and the non-blank data rows.
+
+    Each data row comes with the line number it starts on.
+    """
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    header: list[str] | None = None
+    rows: list[tuple[int, list[str]]] = []
+    try:
+        while True:
+            row_number = reader.line_num + 1
+            try:
+                cells = next(reader)
+            except StopIteration:
+                break
+            if header is None:
+                header = cells
+            elif any(cell.strip() for cell in cells):
+                rows.append((row_number, cells))
+                if len(rows) > MAX_DATA_ROWS:
+                    raise ImportFileError(
+                        f"the file has more than {MAX_DATA_ROWS} data rows; "
+                        "split it into smaller files"
+                    )
+    except csv.Error as exc:
+        raise ImportFileError(
+            f"the file is not valid CSV near line {reader.line_num}: {exc}"
+        ) from None
+    return header or [], rows
+
+
+def _read_header(header: list[str], report: ImportReport) -> _Columns:
+    positions: dict[str, int] = {}
+    unrecognised: list[str] = []
+    for index, raw in enumerate(header):
+        name = raw.strip().lower()
+        if name in _RECOGNISED_COLUMNS:
+            if name in positions:
+                raise ImportFileError(f"the header has more than one {name!r} column")
+            positions[name] = index
+        elif name and name not in unrecognised:
+            unrecognised.append(name)
+
+    has_name = "name" in positions
+    has_first_last = "first_name" in positions and "last_name" in positions
+    missing = []
+    if not has_name and not has_first_last:
+        missing.append("name (or both first_name and last_name)")
+    if "email" not in positions:
+        missing.append("email")
+    if missing:
+        raise ImportFileError(f"the header is missing required columns: {', '.join(missing)}")
+
+    if has_name:
+        # A name column wins; first_name/last_name are then just extra columns.
+        for name in ("first_name", "last_name"):
+            if name in positions:
+                unrecognised.append(name)
+                del positions[name]
+    for name in unrecognised:
+        report.warnings.append(
+            RowIssue(row=1, column=None, message=f"column {name!r} is not recognised and was ignored")
+        )
+
+    return _Columns(
+        email=positions["email"],
+        name=positions.get("name"),
+        first_name=positions.get("first_name"),
+        last_name=positions.get("last_name"),
+        phone=positions.get("phone"),
+        tags=positions.get("tags"),
+        width=len(header),
+    )
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    columns: _Columns,
+    row_number: int,
+    cells: list[str],
+    first_seen: dict[str, int],
+    report: ImportReport,
+) -> None:
+    def cell(index: int | None) -> str:
+        if index is None or index >= len(cells):
+            return ""
+        return cells[index]
+
+    errors: list[RowIssue] = []
+
+    def error(column: str, message: str) -> None:
+        errors.append(RowIssue(row=row_number, column=column, message=message))
+
+    if len(cells) > columns.width:
+        extra = len(cells) - columns.width
+        report.warnings.append(
+            RowIssue(
+                row=row_number,
+                column=None,
+                message=f"{extra} cell(s) beyond the header were ignored",
+            )
+        )
+
+    if columns.name is not None:
+        raw_name = cell(columns.name)
+    else:
+        parts = (cell(columns.first_name).strip(), cell(columns.last_name).strip())
+        raw_name = " ".join(part for part in parts if part)
+    try:
+        name = validate_name(raw_name)
+    except ValidationError as exc:
+        error("name", f"name {exc.message}")
+
+    try:
+        email = normalize_email(cell(columns.email))
+    except ValidationError as exc:
+        error("email", f"email {exc.message}")
+    else:
+        if email in first_seen:
+            error("email", f"{email} already appears in row {first_seen[email]}")
+        else:
+            first_seen[email] = row_number
+
+    tags: set[str] = set()
+    bad_tags: list[str] = []
+    for piece in cell(columns.tags).split(TAG_SEPARATOR):
+        piece = piece.strip()
+        if not piece:
+            continue
+        try:
+            tags.add(normalize_tag(piece))
+        except ValidationError:
+            bad_tags.append(repr(piece))
+    if bad_tags:
+        error("tags", f"invalid tag(s): {', '.join(bad_tags)}")
+
+    if errors:
+        report.errors.extend(errors)
+        return
+
+    phone: str | None = None
+    raw_phone = cell(columns.phone)
+    if raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(
+                    row=row_number,
+                    column="phone",
+                    message=f"phone {exc.message}; imported without a phone",
+                )
+            )
+
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact.create(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+        return
+
+    contact = existing.rename(name).with_tags(*tags)
+    if phone is not None:
+        contact = contact.with_phone(phone)
+    if contact != existing:
+        repo.update(contact)
+        report.updated.append(email)

@@ -0,0 +1,56 @@
+"""SPEC.md, "Round trip": criteria 32-33."""
+
+import pytest
+
+from contactbook.export import export_csv
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def sample_contacts():
+    return [
+        Contact.create(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip", "lead"]),
+        Contact.create(name="Bob Stone", email="bob@example.com"),
+        Contact.create(name="Lee, Carl", email="carl@example.com", tags=["key-account"]),
+        Contact.create(name='Dana "DJ" Fox', email="dana@example.com", phone="5550001111"),
+        Contact.create(name="Zoë Ångström", email="zoe@example.com", tags=["partner"]),
+    ]
+
+
+# Criterion 32: importing export_csv(contacts) into an empty repo recreates them.
+
+
+@pytest.mark.parametrize("as_bytes", [False, True], ids=["str", "bytes"])
+def test_export_then_import_into_empty_repo_recreates_contacts(import_contacts, as_bytes):
+    contacts = sample_contacts()
+    data = export_csv(contacts)
+    if as_bytes:
+        data = data.encode("utf-8")
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.errors == []
+    assert report.warnings == []
+    assert report.updated == []
+    assert report.created == [c.email for c in contacts]
+    assert sorted(repo.all(), key=lambda c: c.email) == sorted(contacts, key=lambda c: c.email)
+
+
+def test_export_of_no_contacts_imports_nothing(import_contacts, repo):
+    report = import_contacts(repo, export_csv([]))
+    assert report.created == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert len(repo) == 0
+
+
+# Criterion 33: re-importing a repo's own export changes nothing.
+
+
+def test_reimporting_own_export_reports_nothing_and_changes_nothing(import_contacts):
+    repo = InMemoryContactRepository(sample_contacts())
+    before = repo.all()
+    report = import_contacts(repo, export_csv(repo.all()))
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert repo.all() == before
diff --git a/tests/acceptance/test_import_rows.py b/tests/acceptance/test_import_rows.py
new file mode 100644
index 0000000..4a269b7
--- /dev/null
+++ b/tests/acceptance/test_import_rows.py
@@ -0,0 +1,260 @@
+"""SPEC.md, "Row handling": criteria 16-23."""
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def error_rows(report, column=None):
+    return [i.row for i in report.errors if column is None or i.column == column]
+
+
+# Criterion 16 (with the "Row number" and "Blank row" terms): blank rows are
+# skipped silently but still count in the row numbering.
+
+
+def test_blank_rows_are_skipped_silently(import_contacts, repo):
+    data = (
+        "name,email,phone,tags\n"
+        "\n"
+        "Ann Lee,ann@example.com,,\n"
+        ",,,\n"
+        "  , ,\t,  \n"
+        "Bob Stone,bob@example.com,,\n"
+    )
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+
+
+def test_blank_rows_count_in_row_numbering(import_contacts, repo):
+    data = (
+        "name,email,phone,tags\n"  # row 1
+        "\n"  # row 2
+        ",,,\n"  # row 3
+        "Ann Lee,not-an-email,,\n"  # row 4
+        "   \n"  # row 5
+        "Bob Stone,,,\n"  # row 6
+    )
+    report = import_contacts(repo, data)
+    assert sorted(set(error_rows(report, "email"))) == [4, 6]
+
+
+def test_multiline_quoted_cell_is_numbered_by_its_first_line(import_contacts, repo):
+    data = (
+        "name,email\n"  # row 1
+        '"Ann\nLee",ann@example.com\n'  # rows 2-3, numbered 2
+        "Bob Stone,not-an-email\n"  # row 4
+        '"Carl\n\nWong",bad-carl\n'  # rows 5-7, numbered 5
+        "Dana Fox,\n"  # row 8
+    )
+    report = import_contacts(repo, data)
+    assert repo.get("ann@example.com").name == "Ann Lee"
+    assert sorted(set(error_rows(report))) == [4, 5, 8]
+
+
+# Criterion 17: missing cells are empty; extra cells are ignored with a warning.
+
+
+def test_row_with_fewer_cells_treats_missing_cells_as_empty(import_contacts, repo):
+    report = import_contacts(repo, "name,email,phone,tags\nAnn Lee,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    contact = repo.get("ann@example.com")
+    assert contact.phone is None
+    assert contact.tags == frozenset()
+
+
+def test_row_with_fewer_cells_missing_email_is_an_email_error(import_contacts, repo):
+    report = import_contacts(repo, "name,phone,email\nAnn Lee,5551234567\n")
+    assert error_rows(report, "email") == [2]
+    assert len(repo) == 0
+
+
+def test_row_with_extra_cells_ignores_them_and_warns(import_contacts, repo):
+    data = "name,email\nAnn Lee,ann@example.com,surplus,more\nBob Stone,bob@example.com\n"
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == []
+    assert repo.get("ann@example.com") == Contact.create(name="Ann Lee", email="ann@example.com")
+    assert [(w.row, w.column) for w in report.warnings] == [(2, None)]
+
+
+# Criterion 18: email is normalised; missing or invalid email is an error.
+
+
+def test_email_is_trimmed_and_lower_cased(import_contacts, repo):
+    report = import_contacts(repo, "name,email\nAnn Lee,  Ann.Lee@Example.COM \n")
+    assert report.created == ["ann.lee@example.com"]
+    assert repo.all()[0].email == "ann.lee@example.com"
+
+
+@pytest.mark.parametrize("email", ["", "   ", "not-an-email", "ann@example", "a b@example.com"])
+def test_missing_or_invalid_email_is_an_error(import_contacts, repo, email):
+    report = import_contacts(repo, f"name,email\nAnn Lee,{email}\n")
+    assert error_rows(report, "email") == [2]
+    assert error_rows(report) == [2]
+    assert report.created == []
+    assert len(repo) == 0
+
+
+# Criterion 19: name rules, including first_name/last_name files.
+
+
+def test_name_is_trimmed_and_inner_whitespace_collapsed(import_contacts, repo):
+    import_contacts(repo, "name,email\n   Ann    Lee  ,ann@example.com\n")
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+@pytest.mark.parametrize(
+    "first, last, expected",
+    [
+        ("Ann", "Lee", "Ann Lee"),
+        ("  Ann ", "  Lee  ", "Ann Lee"),
+        ("Mary  Ann", "Lee", "Mary Ann Lee"),
+        ("", "Lee", "Lee"),
+        ("   ", "Lee", "Lee"),
+        ("Ann", "", "Ann"),
+    ],
+)
+def test_first_and_last_name_are_joined(import_contacts, repo, first, last, expected):
+    report = import_contacts(repo, f"first_name,last_name,email\n{first},{last},ann@example.com\n")
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == expected
+
+
+@pytest.mark.parametrize("first, last", [("", ""), ("  ", " ")])
+def test_blank_first_and_last_name_is_a_name_error(import_contacts, repo, first, last):
+    report = import_contacts(repo, f"first_name,last_name,email\n{first},{last},ann@example.com\n")
+    assert error_rows(report, "name") == [2]
+    assert len(repo) == 0
+
+
+def test_too_long_joined_name_is_a_name_error(import_contacts, repo):
+    report = import_contacts(
+        repo, f"first_name,last_name,email\n{'A' * 60},{'B' * 60},ann@example.com\n"
+    )
+    assert error_rows(report, "name") == [2]
+    assert len(repo) == 0
+
+
+@pytest.mark.parametrize("name", ["", "    "])
+def test_blank_name_is_a_name_error(import_contacts, repo, name):
+    report = import_contacts(repo, f"name,email\n{name},ann@example.com\n")
+    assert error_rows(report, "name") == [2]
+    assert len(repo) == 0
+
+
+def test_name_of_101_characters_is_an_error(import_contacts, repo):
+    report = import_contacts(repo, f"name,email\n{'x' * 101},ann@example.com\n")
+    assert error_rows(report, "name") == [2]
+    assert len(repo) == 0
+
+
+def test_name_of_100_characters_is_accepted(import_contacts, repo):
+    report = import_contacts(repo, f"name,email\n{'x' * 100},ann@example.com\n")
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "x" * 100
+
+
+def test_name_is_required_on_update_rows(import_contacts, repo_with_ann, ann):
+    report = import_contacts(repo_with_ann, "name,email,tags\n,ann@example.com,lead\n")
+    assert error_rows(report, "name") == [2]
+    assert report.updated == []
+    assert repo_with_ann.all() == [ann]
+
+
+# Criterion 20: tags are split on ';', normalised, deduplicated; invalid tags
+# make the row an error.
+
+
+def test_tags_are_split_trimmed_and_normalised(import_contacts, repo):
+    report = import_contacts(
+        repo, "name,email,tags\nAnn Lee,ann@example.com, VIP ; Key Account ;;vip; ;\n"
+    )
+    assert report.errors == []
+    assert repo.get("ann@example.com").tags == {"vip", "key-account"}
+
+
+@pytest.mark.parametrize("tags", ["vip;bad!tag", "vip;" + "x" * 33, "под;vip"])
+def test_invalid_tag_is_a_tags_error(import_contacts, repo, tags):
+    report = import_contacts(repo, f"name,email,tags\nAnn Lee,ann@example.com,{tags}\n")
+    assert error_rows(report, "tags") == [2]
+    assert len(repo) == 0
+
+
+@pytest.mark.parametrize("cell", ["", "   ", ";", " ; ; "])

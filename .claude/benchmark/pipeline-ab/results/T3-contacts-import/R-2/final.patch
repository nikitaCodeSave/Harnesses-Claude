+def test_valid_rows_around_error_rows_are_all_applied(import_contacts):
+    existing = Contact.create(name="Dana Fox", email="dana@example.com")
+    repo = InMemoryContactRepository([existing])
+    data = (
+        "name,email,phone,tags\n"
+        ",bad-row@example.com,,\n"  # 2: error
+        "Ann Lee,ann@example.com,,vip\n"  # 3
+        "Bob Stone,not-an-email,,\n"  # 4: error
+        "Dana Fox,dana@example.com,,lead\n"  # 5: update
+        "Eve Moss,eve@example.com,,b@d\n"  # 6: error
+        "Carl Wong,carl@example.com,,\n"  # 7
+    )
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com", "carl@example.com"]
+    assert report.updated == ["dana@example.com"]
+    assert sorted(set(error_rows(report))) == [2, 4, 6]
+    assert repo.get("dana@example.com").tags == {"lead"}
+    assert "bad-row@example.com" not in repo

@@ -0,0 +1,56 @@
+"""Shared fixtures for the CSV import acceptance tests (SPEC.md).
+
+The importer and ImportFileError are looked up when a test calls them, not when
+fixtures are set up, so that while the feature is missing each test fails on its
+own (as FAILED, not as a setup ERROR or a collection error).
+"""
+
+import importlib
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+@pytest.fixture
+def importer_module():
+    """Return a function that imports and returns contactbook.importer."""
+    return lambda: importlib.import_module("contactbook.importer")
+
+
+@pytest.fixture
+def import_contacts(importer_module):
+    def call(repo, data):
+        return importer_module().import_contacts(repo, data)
+
+    return call
+
+
+@pytest.fixture
+def import_file_error():
+    """Return a function that returns contactbook.errors.ImportFileError."""
+    return lambda: importlib.import_module("contactbook.errors").ImportFileError
+
+
+@pytest.fixture
+def raises_import_file_error(import_file_error):
+    """``with raises_import_file_error() as excinfo:`` is pytest.raises(ImportFileError)."""
+    return lambda: pytest.raises(import_file_error())
+
+
+@pytest.fixture
+def repo():
+    return InMemoryContactRepository()
+
+
+@pytest.fixture
+def ann():
+    return Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=["vip"]
+    )
+
+
+@pytest.fixture
+def repo_with_ann(ann):
+    return InMemoryContactRepository([ann])
diff --git a/tests/acceptance/test_import_create_update.py b/tests/acceptance/test_import_create_update.py
new file mode 100644
index 0000000..342c27e
--- /dev/null
+++ b/tests/acceptance/test_import_create_update.py
@@ -0,0 +1,212 @@
+"""SPEC.md, "Creating and updating": criteria 24-28."""
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+# Criterion 24: existing contacts are matched by normalised email.
+
+
+@pytest.mark.parametrize("email", ["ann@example.com", "ANN@Example.COM", "  Ann@example.com  "])
+def test_existing_contact_is_matched_by_normalised_email(
+    import_contacts, repo_with_ann, email
+):
+    report = import_contacts(repo_with_ann, f"name,email\nAnn Smith,{email}\n")
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert len(repo_with_ann) == 1
+    assert repo_with_ann.get("ann@example.com").name == "Ann Smith"
+
+
+# Criterion 25: a new email creates a contact with the row's name, tags and phone.
+
+
+def test_new_email_creates_contact(import_contacts, repo):
+    report = import_contacts(
+        repo, "name,email,phone,tags\nAnn Lee,ann@example.com,555-123-4567,vip;lead\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.updated == []
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=["vip", "lead"]
+    )
+
+
+def test_new_contact_without_phone(import_contacts, repo):
+    import_contacts(repo, "name,email,phone,tags\nAnn Lee,ann@example.com,,\n")
+    assert repo.get("ann@example.com").phone is None
+
+
+# Criterion 26: updates replace the name, keep a phone unless a valid one is
+# given, union tags, and report only real changes.
+
+
+def test_update_replaces_name(import_contacts, repo_with_ann):
+    report = import_contacts(repo_with_ann, "name,email\nAnn Smith,ann@example.com\n")
+    assert report.updated == ["ann@example.com"]
+    assert repo_with_ann.get("ann@example.com") == Contact.create(
+        name="Ann Smith", email="ann@example.com", phone="5551234567", tags=["vip"]
+    )
+
+
+def test_update_replaces_phone_when_row_has_valid_phone(import_contacts, repo_with_ann):
+    report = import_contacts(
+        repo_with_ann, "name,email,phone\nAnn Lee,ann@example.com,+1 555 999 0000\n"
+    )
+    assert report.updated == ["ann@example.com"]
+    assert repo_with_ann.get("ann@example.com").phone == "+15559990000"
+
+
+@pytest.mark.parametrize(
+    "header, row",
+    [
+        ("name,email,phone", "Ann Lee,ann@example.com,"),
+        ("name,email,phone", "Ann Lee,ann@example.com,   "),
+        ("name,email", "Ann Lee,ann@example.com"),
+    ],
+    ids=["empty-cell", "whitespace-cell", "no-phone-column"],
+)
+def test_update_keeps_phone_when_row_has_no_phone(import_contacts, repo_with_ann, header, row):
+    import_contacts(repo_with_ann, f"{header}\n{row}\n")
+    assert repo_with_ann.get("ann@example.com").phone == "5551234567"
+
+
+def test_update_keeps_phone_when_row_phone_is_invalid(import_contacts, repo_with_ann, ann):
+    report = import_contacts(repo_with_ann, "name,email,phone\nAnn Lee,ann@example.com,nope\n")
+    assert report.errors == []
+    assert [(w.row, w.column) for w in report.warnings] == [(2, "phone")]
+    assert repo_with_ann.get("ann@example.com").phone == "5551234567"
+    # Nothing else changed, so the contact is identical (criterion 26).
+    assert report.updated == []
+    assert report.created == []
+    assert repo_with_ann.all() == [ann]
+
+
+def test_update_unions_tags(import_contacts, repo_with_ann):
+    report = import_contacts(
+        repo_with_ann, "name,email,tags\nAnn Lee,ann@example.com,Lead;Key Account\n"
+    )
+    assert report.updated == ["ann@example.com"]
+    assert repo_with_ann.get("ann@example.com").tags == {"vip", "lead", "key-account"}
+
+
+@pytest.mark.parametrize("tags", ["", "lead"])
+def test_update_never_removes_tags(import_contacts, tags):
+    repo = InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", tags=["vip", "partner"])]
+    )
+    import_contacts(repo, f"name,email,tags\nAnn Lee,ann@example.com,{tags}\n")
+    assert {"vip", "partner"} <= repo.get("ann@example.com").tags
+
+
+@pytest.mark.parametrize(
+    "header, row",
+    [
+        ("name,email", "Ann Lee,ann@example.com"),
+        ("name,email,phone,tags", "Ann Lee,ANN@example.com,,"),
+        ("name,email,phone,tags", "  Ann   Lee ,ann@example.com,555 123 4567,VIP"),
+        ("name,email,phone,tags", "Ann Lee,ann@example.com,5551234567,vip"),
+    ],
+    ids=["minimal", "blank-phone-and-tags", "same-after-normalising", "exact"],
+)
+def test_unchanged_contact_is_in_neither_list(import_contacts, repo_with_ann, ann, header, row):
+    report = import_contacts(repo_with_ann, f"{header}\n{row}\n")
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert repo_with_ann.all() == [ann]
+
+
+# Criterion 27: the first data row with an email decides; later rows with the
+# same email are errors on the later row.
+
+
+def test_later_duplicate_email_is_an_error(import_contacts, repo):
+    data = (
+        "name,email\n"
+        "Ann Lee,ann@example.com\n"  # 2
+        "Bob Stone,bob@example.com\n"  # 3
+        "Ann Second,ANN@example.com\n"  # 4: duplicate
+        "Ann Third, ann@example.com \n"  # 5: duplicate
+    )
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert [(i.row, i.column) for i in report.errors] == [(4, "email"), (5, "email")]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_duplicate_of_an_update_row_is_an_error(import_contacts, repo_with_ann):
+    data = "name,email,tags\nAnn Smith,ann@example.com,\nAnn Jones,ann@example.com,lead\n"
+    report = import_contacts(repo_with_ann, data)
+    assert report.updated == ["ann@example.com"]
+    assert [(i.row, i.column) for i in report.errors] == [(3, "email")]
+    contact = repo_with_ann.get("ann@example.com")
+    assert contact.name == "Ann Smith"
+    assert contact.tags == {"vip"}
+
+
+def test_first_occurrence_wins_even_when_it_is_an_error(import_contacts, repo):
+    data = (
+        "name,email,tags\n"
+        ",ann@example.com,\n"  # 2: error (blank name), still the first occurrence
+        "Ann Lee,ann@example.com,\n"  # 3: duplicate
+        "Ann Lee,Ann@Example.com,vip\n"  # 4: duplicate
+    )
+    report = import_contacts(repo, data)
+    assert report.created == []
+    assert "ann@example.com" not in repo
+    assert 2 in [i.row for i in report.errors]
+    assert [(i.row, i.column) for i in report.errors if i.row in (3, 4)] == [
+        (3, "email"),
+        (4, "email"),
+    ]
+
+
+def test_first_occurrence_with_bad_tags_still_makes_later_rows_duplicates(
+    import_contacts, repo_with_ann, ann
+):
+    data = "name,email,tags\nAnn Lee,ann@example.com,bad!tag\nAnn Smith,ann@example.com,lead\n"
+    report = import_contacts(repo_with_ann, data)
+    assert report.updated == []
+    assert (3, "email") in [(i.row, i.column) for i in report.errors]
+    assert repo_with_ann.all() == [ann]
+
+
+# Criterion 28: stored contacts hold the same values Contact.create would produce.
+
+
+def test_created_contact_holds_normalised_values(import_contacts, repo):
+    import_contacts(
+        repo,
+        'name,email,phone,tags\n  Ann   Lee ," Ann.Lee@Example.COM ","+1 (555) 123-4567",VIP; Key Account\n',
+    )
+    assert repo.all() == [
+        Contact.create(
+            name="  Ann   Lee ",
+            email=" Ann.Lee@Example.COM ",
+            phone="+1 (555) 123-4567",
+            tags=["VIP", "Key Account"],
+        )
+    ]
+
+
+def test_created_contact_from_first_last_file_holds_normalised_values(import_contacts, repo):
+    import_contacts(repo, "first_name,last_name,email\n  Ann ,  Lee ,ANN@EXAMPLE.COM\n")
+    assert repo.all() == [Contact.create(name="Ann Lee", email="ann@example.com")]
+
+
+def test_updated_contact_holds_normalised_values(import_contacts, repo_with_ann):
+    import_contacts(
+        repo_with_ann,
+        "name,email,phone,tags\n  Ann   Smith ,ANN@example.com,(555) 777-8888,Key Account\n",
+    )
+    assert repo_with_ann.all() == [
+        Contact.create(
+            name="Ann Smith",
+            email="ann@example.com",
+            phone="5557778888",
+            tags=["vip", "key-account"],
+        )
+    ]
diff --git a/tests/acceptance/test_import_file_rejection.py b/tests/acceptance/test_import_file_rejection.py
new file mode 100644
index 0000000..c3b985f
--- /dev/null
+++ b/tests/acceptance/test_import_file_rejection.py
@@ -0,0 +1,149 @@
+"""SPEC.md, "Whole-file rejection": criteria 12-15."""
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def data_rows(count, start=0):
+    return [f"Person {i},person{i}@example.com" for i in range(start, start + count)]
+
+
+def csv_text(rows, header="name,email"):
+    return "\n".join([header, *rows]) + "\n"
+
+
+# Criterion 12: the listed whole-file problems raise ImportFileError.
+
+
+@pytest.mark.parametrize(
+    "data",
+    ["", "   ", "\n", "\n\n\n", " \r\n\t\n  ", "﻿", b"", b"  \n ", b"\xef\xbb\xbf"],
+    ids=repr,
+)
+def test_empty_or_whitespace_only_file_raises(import_contacts, raises_import_file_error, repo, data):
+    with raises_import_file_error():
+        import_contacts(repo, data)
+    assert len(repo) == 0
+
+
+def test_unclosed_quoted_cell_raises(import_contacts, raises_import_file_error, repo):
+    data = 'name,email\nAnn Lee,ann@example.com\n"Bob Stone,bob@example.com\n'
+    with raises_import_file_error():
+        import_contacts(repo, data)
+    assert len(repo) == 0
+
+
+def test_invalid_utf8_is_a_whole_file_error(import_contacts, raises_import_file_error, repo):
+    with raises_import_file_error():
+        import_contacts(repo, b"name,email\nAnn \xe9,ann@example.com\n")
+
+
+def test_missing_required_column_is_a_whole_file_error(import_contacts, raises_import_file_error, repo):
+    with raises_import_file_error():
+        import_contacts(repo, "name,phone\nAnn Lee,5551234567\n")
+
+
+def test_duplicated_recognised_column_is_a_whole_file_error(
+    import_contacts, raises_import_file_error, repo
+):
+    with raises_import_file_error():
+        import_contacts(repo, "name,email,email\nAnn Lee,ann@example.com,ann@example.com\n")
+
+
+# Criterion 13: at most 1000 data rows; blank rows don't count; error and
+# duplicate rows do.
+
+
+def test_exactly_1000_data_rows_are_imported(import_contacts, repo):
+    report = import_contacts(repo, csv_text(data_rows(1000)))
+    assert len(report.created) == 1000
+    assert report.errors == []
+    assert len(repo) == 1000
+
+
+def test_1001_data_rows_are_rejected(import_contacts, raises_import_file_error, repo):
+    with raises_import_file_error():
+        import_contacts(repo, csv_text(data_rows(1001)))
+    assert len(repo) == 0
+
+
+def test_blank_rows_do_not_count_towards_the_limit(import_contacts, repo):
+    rows = []
+    for row in data_rows(1000):
+        rows.extend([row, "", ",", "  ,  "])
+    report = import_contacts(repo, csv_text(rows))
+    assert len(report.created) == 1000
+    assert report.errors == []
+    assert len(repo) == 1000
+
+
+def test_error_and_duplicate_rows_count_towards_the_limit(
+    import_contacts, raises_import_file_error, repo
+):
+    rows = data_rows(990)
+    rows += [f"Bad {i},not-an-email" for i in range(6)]
+    rows += [f"Again {i},person{i}@example.com" for i in range(5)]
+    assert len(rows) == 1001
+    with raises_import_file_error():
+        import_contacts(repo, csv_text(rows))
+    assert len(repo) == 0
+
+
+def test_1000_rows_including_errors_and_duplicates_are_imported(import_contacts, repo):
+    rows = data_rows(990)
+    rows += [f"Bad {i},not-an-email" for i in range(5)]
+    rows += [f"Again {i},person{i}@example.com" for i in range(5)]
+    assert len(rows) == 1000
+    report = import_contacts(repo, csv_text(rows))
+    assert len(report.created) == 990
+    assert len(repo) == 990
+
+
+# Criterion 14: on ImportFileError the repository is exactly as before, even when
+# the problem is found near the end of the file.
+
+
+def existing_contacts():
+    return [
+        # The file below also has a row for person1, which would rename this contact.
+        Contact.create(name="Old Name", email="person1@example.com", phone="5550000001", tags=["old"]),
+        Contact.create(name="Keep Me", email="keep@example.com"),
+    ]
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        csv_text(data_rows(1001)),
+        csv_text(data_rows(900)) + '"Unclosed,late@example.com\n',
+        csv_text(data_rows(900)).encode("utf-8") + b"Late \xff,late@example.com\n",
+    ],
+    ids=["1001-rows", "unclosed-quote-at-end", "invalid-utf8-at-end"],
+)
+def test_repository_unchanged_when_file_is_rejected(import_contacts, raises_import_file_error, data):
+    repo = InMemoryContactRepository(existing_contacts())
+    before = repo.all()
+    with raises_import_file_error():
+        import_contacts(repo, data)
+    assert repo.all() == before
+
+
+# Criterion 15: a valid header with no data rows returns an empty report.
+
+
+@pytest.mark.parametrize(
+    "data",
+    ["name,email", "name,email\n", "name,email\n\n,\n  ,  \n", b"name,email\r\n\r\n"],
+    ids=repr,
+)
+def test_header_without_data_rows_returns_empty_report(import_contacts, data):
+    repo = InMemoryContactRepository(existing_contacts())
+    before = repo.all()
+    report = import_contacts(repo, data)
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == before
diff --git a/tests/acceptance/test_import_header.py b/tests/acceptance/test_import_header.py
new file mode 100644
index 0000000..de87fa4
--- /dev/null
+++ b/tests/acceptance/test_import_header.py
@@ -0,0 +1,154 @@
+"""SPEC.md, "Header": criteria 7-11."""
+
+import pytest
+
+
+# Criterion 7: header names match ignoring case and surrounding whitespace;
+# column order is free.
+
+
+def test_header_matching_ignores_case_and_whitespace(import_contacts, repo):
+    report = import_contacts(repo, " NAME , Email ,Phone,  TAGS\nAnn Lee,ann@example.com,5551234567,vip\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    contact = repo.get("ann@example.com")
+    assert contact.name == "Ann Lee"
+    assert contact.phone == "5551234567"
+    assert contact.tags == {"vip"}
+
+
+def test_column_order_is_free(import_contacts, repo):
+    report = import_contacts(repo, "tags,email,phone,name\nvip,ann@example.com,5551234567,Ann Lee\n")
+    assert report.errors == []
+    contact = repo.get("ann@example.com")
+    assert contact.name == "Ann Lee"
+    assert contact.phone == "5551234567"
+    assert contact.tags == {"vip"}
+
+
+def test_first_and_last_name_headers_match_ignoring_case(import_contacts, repo):
+    report = import_contacts(repo, " First_Name ,LAST_NAME,EMAIL\nAnn,Lee,ann@example.com\n")
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# Criterion 8: an email column and a name source are required.
+
+
+@pytest.mark.parametrize(
+    "header, missing",
+    [
+        ("email", "name"),
+        ("first_name,email", "name"),
+        ("last_name,email", "name"),
+        ("phone,tags,email", "name"),
+        ("name", "email"),
+        ("name,e-mail", "email"),
+        ("first_name,last_name", "email"),
+        ("phone,tags", "email"),
+    ],
+)
+def test_missing_required_column_raises(
+    import_contacts, raises_import_file_error, repo, header, missing
+):
+    with raises_import_file_error() as excinfo:
+        import_contacts(repo, header + "\n" + ",".join(["x"] * (header.count(",") + 1)) + "\n")
+    assert missing in str(excinfo.value).lower()
+    assert len(repo) == 0
+
+
+def test_first_and_last_name_together_are_a_name_source(import_contacts, repo):
+    report = import_contacts(repo, "first_name,last_name,email\nAnn,Lee,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_name_column_wins_over_first_and_last_name(import_contacts, repo):
+    report = import_contacts(
+        repo, "name,first_name,last_name,email\nAnn Lee,Xavier,Young,ann@example.com\n"
+    )
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_when_name_column_present_first_last_do_not_fill_a_blank_name(
+    import_contacts, repo
+):
+    report = import_contacts(
+        repo, "name,first_name,last_name,email\n,Ann,Lee,ann@example.com\n"
+    )
+    assert [(i.row, i.column) for i in report.errors] == [(2, "name")]
+    assert len(repo) == 0
+
+
+def test_first_last_ignored_with_name_column_are_unrecognised(import_contacts, repo):
+    report = import_contacts(
+        repo, "name,first_name,last_name,email\nAnn Lee,Ann,Lee,ann@example.com\n"
+    )
+    assert report.errors == []
+    for warning in report.warnings:
+        assert warning.row == 1
+        assert warning.column is None
+
+
+# Criterion 9: phone and tags are optional.
+
+
+def test_phone_and_tags_columns_are_optional(import_contacts, repo):
+    report = import_contacts(repo, "name,email\nAnn Lee,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    contact = repo.get("ann@example.com")
+    assert contact.phone is None
+    assert contact.tags == frozenset()
+
+
+# Criterion 10: a repeated recognised column is a whole-file error;
+# repeated unrecognised or empty header cells are not.
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "name,email,name",
+        "name,email, EMAIL ",
+        "Name,NAME,email",
+        "name,email,phone,Phone",
+        "name,email,tags,TAGS",
+        "first_name,last_name,email,First_Name",
+        "first_name,last_name,email,last_name",
+    ],
+)
+def test_duplicated_recognised_column_raises(import_contacts, raises_import_file_error, repo, header):
+    width = header.count(",") + 1
+    row = ",".join(["Ann Lee", "ann@example.com"] + [""] * (width - 2))
+    with raises_import_file_error():
+        import_contacts(repo, f"{header}\n{row}\n")
+    assert len(repo) == 0
+
+
+def test_repeated_unrecognised_columns_are_not_an_error(import_contacts, repo):
+    report = import_contacts(repo, "name,company,email,company\nAnn Lee,Acme,ann@example.com,Beta\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+
+
+def test_repeated_empty_header_cells_are_not_an_error(import_contacts, repo):
+    report = import_contacts(repo, "name,,email,,\nAnn Lee,x,ann@example.com,y,z\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+
+
+# Criterion 11: unrecognised columns are ignored; any warning has row=1, column=None.
+
+
+def test_unrecognised_columns_are_ignored(import_contacts, repo):
+    report = import_contacts(
+        repo, "name,company,email,notes\nAnn Lee,Acme,ann@example.com,met at expo\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+    for warning in report.warnings:
+        assert warning.row == 1
+        assert warning.column is None
diff --git a/tests/acceptance/test_import_input.py b/tests/acceptance/test_import_input.py
new file mode 100644
index 0000000..74f2950
--- /dev/null
+++ b/tests/acceptance/test_import_input.py
@@ -0,0 +1,133 @@
+"""SPEC.md, "Input and encoding": criteria 1-6."""
+
+import pytest
+
+from contactbook.errors import ContactError
+from contactbook.models import Contact
+
+
+# Criterion 1: bytes are decoded as UTF-8; a leading UTF-8 BOM is ignored.
+
+
+def test_bytes_input_is_decoded_as_utf8(import_contacts, repo):
+    data = "name,email\nZoë Ångström,zoe@example.com\n".encode("utf-8")
+    report = import_contacts(repo, data)
+    assert report.created == ["zoe@example.com"]
+    assert report.errors == []
+    assert repo.get("zoe@example.com").name == "Zoë Ångström"
+
+
+def test_bytes_input_with_utf8_bom_is_accepted(import_contacts, repo):
+    data = b"\xef\xbb\xbf" + "name,email\nZoë,zoe@example.com\n".encode("utf-8")
+    report = import_contacts(repo, data)
+    assert report.created == ["zoe@example.com"]
+    assert report.errors == []
+    assert repo.get("zoe@example.com").name == "Zoë"
+
+
+# Criterion 2: str is accepted as is; a leading BOM character is ignored.
+
+
+def test_str_input_is_accepted(import_contacts, repo):
+    report = import_contacts(repo, "name,email\nZoë,zoe@example.com\n")
+    assert report.created == ["zoe@example.com"]
+    assert repo.get("zoe@example.com").name == "Zoë"
+
+
+def test_str_input_with_bom_character_is_accepted(import_contacts, repo):
+    report = import_contacts(repo, "﻿name,email\nAnn Lee,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+
+
+# Criterion 3: invalid UTF-8 raises ImportFileError mentioning "CSV UTF-8";
+# no fallback to another encoding.
+
+
+def test_invalid_utf8_raises_import_file_error(import_contacts, raises_import_file_error, repo):
+    data = "name,email\nZoë,zoe@example.com\n".encode("latin-1")
+    with raises_import_file_error() as excinfo:
+        import_contacts(repo, data)
+    assert "CSV UTF-8" in str(excinfo.value)
+    assert len(repo) == 0
+
+
+def test_invalid_utf8_has_no_encoding_fallback(import_contacts, raises_import_file_error, repo):
+    data = b"name,email\n\xff\xfe\xfd,bad@example.com\n"
+    with raises_import_file_error():
+        import_contacts(repo, data)
+    assert len(repo) == 0
+
+
+def test_import_file_error_is_a_contact_error(import_file_error):
+    assert issubclass(import_file_error(), ContactError)
+
+
+# Criterion 4: \n or \r\n line endings; a trailing line break adds no row.
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n"])
+def test_line_endings_are_accepted(import_contacts, repo, newline):
+    data = newline.join(
+        ["name,email,phone,tags", "Ann Lee,ann@example.com,555 123 4567,vip"]
+    ) + newline
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=["vip"]
+    )
+
+
+def test_crlf_line_endings_as_bytes(import_contacts, repo):
+    data = b"name,email,tags\r\nAnn Lee,ann@example.com,vip\r\n"
+    report = import_contacts(repo, data)
+    assert report.errors == []
+    assert repo.get("ann@example.com").tags == {"vip"}
+
+
+@pytest.mark.parametrize("ending", ["", "\n", "\r\n"])
+def test_trailing_line_break_does_not_create_an_extra_row(import_contacts, repo, ending):
+    report = import_contacts(repo, "name,email\nAnn Lee,ann@example.com" + ending)
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert len(repo) == 1
+
+
+def test_crlf_blank_lines_count_in_row_numbering(import_contacts, repo):
+    report = import_contacts(repo, "name,email\r\n\r\nBad,not-an-email\r\n")
+    assert [issue.row for issue in report.errors] == [3]
+
+
+# Criterion 5: the delimiter is the comma; ';' files are not detected.
+
+
+def test_semicolon_delimited_file_fails_header_check(
+    import_contacts, raises_import_file_error, repo
+):
+    with raises_import_file_error():
+        import_contacts(repo, "name;email\nAnn Lee;ann@example.com\n")
+    assert len(repo) == 0
+
+
+def test_semicolon_inside_a_comma_file_is_not_a_delimiter(import_contacts, repo):
+    report = import_contacts(repo, "name,email,tags\nAnn Lee,ann@example.com,vip;lead\n")
+    assert report.errors == []
+    assert repo.get("ann@example.com").tags == {"vip", "lead"}
+
+
+# Criterion 6: anything other than str or bytes raises TypeError, unwrapped.
+
+
+@pytest.mark.parametrize(
+    "data",
+    [None, 42, ["name,email", "Ann Lee,ann@example.com"], bytearray(b"name,email\n")],
+    ids=["none", "int", "list", "bytearray"],
+)
+def test_non_str_non_bytes_input_raises_type_error(import_contacts, repo, data):
+    with pytest.raises(TypeError) as excinfo:
+        import_contacts(repo, data)
+    assert not isinstance(excinfo.value, ContactError)
+    assert len(repo) == 0
diff --git a/tests/acceptance/test_import_report.py b/tests/acceptance/test_import_report.py
new file mode 100644
index 0000000..5cc6838
--- /dev/null
+++ b/tests/acceptance/test_import_report.py
@@ -0,0 +1,147 @@
+"""SPEC.md, "Interface" and "Report": criteria 29-31."""
+
+import dataclasses
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+CANONICAL_COLUMNS = {"name", "email", "phone", "tags", None}
+
+
+# Interface: ImportReport and RowIssue are dataclasses with the named fields.
+
+
+def test_import_report_is_a_dataclass_with_spec_fields(importer_module):
+    report_cls = importer_module().ImportReport
+    assert dataclasses.is_dataclass(report_cls)
+    assert {f.name for f in dataclasses.fields(report_cls)} >= {
+        "created",
+        "updated",
+        "errors",
+        "warnings",
+    }
+
+
+def test_row_issue_is_a_dataclass_with_spec_fields(importer_module):
+    issue_cls = importer_module().RowIssue
+    assert dataclasses.is_dataclass(issue_cls)
+    assert {f.name for f in dataclasses.fields(issue_cls)} >= {"row", "column", "message"}
+
+
+def test_import_returns_report_of_lists_and_row_issues(importer_module, repo):
+    report = importer_module().import_contacts(
+        repo, "name,email\nAnn Lee,ann@example.com\nBob,not-an-email\n"
+    )
+    assert isinstance(report, importer_module().ImportReport)
+    assert isinstance(report.created, list)
+    assert isinstance(report.updated, list)
+    assert isinstance(report.errors, list)
+    assert isinstance(report.warnings, list)
+    assert all(isinstance(i, importer_module().RowIssue) for i in report.errors)
+    assert isinstance(report.errors[0].row, int)
+
+
+# Criterion 29: created/updated in file order, each email at most once.
+
+
+def test_created_and_updated_are_in_file_order(import_contacts):
+    repo = InMemoryContactRepository(
+        [
+            Contact.create(name="Zed Old", email="zed@example.com"),
+            Contact.create(name="Amy Old", email="amy@example.com"),
+        ]
+    )
+    data = (
+        "name,email\n"
+        "Carl Wong,carl@example.com\n"
+        "Amy New,amy@example.com\n"
+        "Bob Stone,bob@example.com\n"
+        "Zed New,zed@example.com\n"
+        "Ann Lee,ann@example.com\n"
+    )
+    report = import_contacts(repo, data)
+    assert report.created == ["carl@example.com", "bob@example.com", "ann@example.com"]
+    assert report.updated == ["amy@example.com", "zed@example.com"]
+
+
+def test_no_email_appears_twice_across_created_and_updated(import_contacts, repo_with_ann):
+    data = (
+        "name,email\n"
+        "Bob Stone,bob@example.com\n"
+        "Ann Smith,ann@example.com\n"
+        "Bob Again,BOB@example.com\n"
+        "Ann Again,ann@example.com\n"
+    )
+    report = import_contacts(repo_with_ann, data)
+    emails = report.created + report.updated
+    assert sorted(emails) == ["ann@example.com", "bob@example.com"]
+    assert len(emails) == len(set(emails))
+
+
+# Criterion 30: errors and warnings in row order; messages are short readable text.
+
+
+def problem_file():
+    return (
+        "name,email,phone,tags\n"  # 1
+        "Ann Lee,ann@example.com,not a phone,\n"  # 2: warning (phone)
+        "Bob Stone,not-an-email,,\n"  # 3: error (email)
+        "Carl Wong,carl@example.com,,,extra\n"  # 4: warning (extra cells)
+        "Dana Fox,dana@example.com,,bad!tag\n"  # 5: error (tags)
+        ",eve@example.com,,\n"  # 6: error (name)
+        "Fay Ng,fay@example.com,123,\n"  # 7: warning (phone)
+        "Ann Again,ann@example.com,,\n"  # 8: error (duplicate email)
+    )
+
+
+def test_errors_and_warnings_are_in_row_order(import_contacts, repo):
+    report = import_contacts(repo, problem_file())
+    error_rows = [i.row for i in report.errors]
+    warning_rows = [i.row for i in report.warnings]
+    assert error_rows == sorted(error_rows)
+    assert warning_rows == sorted(warning_rows)
+    assert set(error_rows) == {3, 5, 6, 8}
+    assert set(warning_rows) == {2, 4, 7}
+    assert report.created == ["ann@example.com", "carl@example.com", "fay@example.com"]
+
+
+def test_issue_messages_are_human_readable_text(import_contacts, repo):
+    report = import_contacts(repo, problem_file())
+    for issue in report.errors + report.warnings:
+        assert isinstance(issue.message, str)
+        assert issue.message.strip()
+
+
+def test_issue_columns_identify_the_problem(import_contacts, repo):
+    report = import_contacts(repo, problem_file())
+    errors = {(i.row, i.column) for i in report.errors}
+    assert {(3, "email"), (5, "tags"), (6, "name"), (8, "email")} <= errors
+    warnings = {(i.row, i.column) for i in report.warnings}
+    assert warnings == {(2, "phone"), (4, None), (7, "phone")}
+
+
+# Criterion 31: RowIssue.column is always a canonical column or None.
+
+
+def test_columns_are_canonical_not_header_spellings(import_contacts, repo):
+    data = (
+        " Name ,  EMAIL ,Phone,TAGS,Company\n"
+        ",ann@example.com,,\n"
+        "Bob Stone,not-an-email,,\n"
+        "Carl Wong,carl@example.com,abc,\n"
+        "Dana Fox,dana@example.com,,b@d\n"
+        "Eve Moss,eve@example.com,,,Acme,extra\n"
+    )
+    report = import_contacts(repo, data)
+    issues = report.errors + report.warnings
+    assert issues
+    assert {i.column for i in issues} <= CANONICAL_COLUMNS
+    assert {(i.row, i.column) for i in report.errors} >= {(2, "name"), (3, "email"), (5, "tags")}
+    assert (4, "phone") in {(i.row, i.column) for i in report.warnings}
+
+
+def test_first_last_name_problems_are_reported_as_name(import_contacts, repo):
+    data = "First_Name,Last_Name,Email\n,,ann@example.com\n  ,  ,bob@example.com\n"
+    report = import_contacts(repo, data)
+    assert {(i.row, i.column) for i in report.errors} == {(2, "name"), (3, "name")}
+    assert {i.column for i in report.errors + report.warnings} <= CANONICAL_COLUMNS

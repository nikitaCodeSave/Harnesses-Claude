@@ -0,0 +1,184 @@
+"""AC 29-32: applying rows to the repository."""
+
+import pytest
+from support import ann, csv_text, import_contacts, issues, repo_with, snapshot
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+
+# ann() is stored as: Ann Lee, ann@example.com, 5551234567, {vip}
+
+
+# AC 29
+
+
+def test_rejected_row_does_not_partly_update_an_existing_contact():
+    repo = repo_with(ann())
+    before = snapshot(repo)
+
+    report = import_contacts(
+        repo, csv_text(HEADER, "Ann Changed,ann@example.com,555 999 0000,lead;bad!tag")
+    )
+
+    assert issues(report.errors) == [(2, "tags")]
+    assert report.updated == []
+    assert snapshot(repo) == before
+
+
+def test_errors_in_one_row_do_not_prevent_other_rows():
+    repo = repo_with(ann())
+    data = csv_text(
+        HEADER,
+        "Bob Stone,bob@example.com,,",
+        "Bad Row,not-an-email,,",
+        "Ann Smith,ann@example.com,,",
+        ",carl@example.com,,",
+        "Dee Long,dee@example.com,,",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert issues(report.errors) == [(3, "email"), (5, "name")]
+    assert report.created == ["bob@example.com", "dee@example.com"]
+    assert report.updated == ["ann@example.com"]
+    assert [contact.email for contact in repo.all()] == [
+        "ann@example.com",
+        "bob@example.com",
+        "dee@example.com",
+    ]
+    assert repo.get("ann@example.com").name == "Ann Smith"
+
+
+# AC 30
+
+
+def test_new_email_creates_a_contact_with_normalised_values():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(
+        repo,
+        csv_text(HEADER, "  Bob   Stone , Bob@Example.com ,+1 (555) 123-4567,Lead; Key Account"),
+    )
+
+    assert report.created == ["bob@example.com"]
+    assert report.updated == []
+    assert repo.all() == [
+        Contact(
+            name="Bob Stone",
+            email="bob@example.com",
+            phone="+15551234567",
+            tags=frozenset({"lead", "key-account"}),
+        )
+    ]
+
+
+# AC 31
+
+
+@pytest.mark.parametrize(
+    ("row", "expected"),
+    [
+        (
+            "Ann Smith,ann@example.com,,",
+            Contact("Ann Smith", "ann@example.com", "5551234567", frozenset({"vip"})),
+        ),
+        (
+            "Ann Lee,ann@example.com,+44 20 7946 0958,",
+            Contact("Ann Lee", "ann@example.com", "+442079460958", frozenset({"vip"})),
+        ),
+        (
+            "Ann Lee,ann@example.com,   ,",
+            Contact("Ann Lee", "ann@example.com", "5551234567", frozenset({"vip"})),
+        ),
+        (
+            "Ann Lee,ann@example.com,,Lead;Partner",
+            Contact(
+                "Ann Lee", "ann@example.com", "5551234567", frozenset({"vip", "lead", "partner"})
+            ),
+        ),
+        (
+            "Ann Lee,ann@example.com,,vip",
+            Contact("Ann Lee", "ann@example.com", "5551234567", frozenset({"vip"})),
+        ),
+        (
+            "Ann Jones,ann@example.com,555.765.4321,lead",
+            Contact("Ann Jones", "ann@example.com", "5557654321", frozenset({"vip", "lead"})),
+        ),
+    ],
+    ids=["name", "valid phone", "blank phone", "new tags", "known tag", "everything"],
+)
+def test_existing_email_updates_the_stored_contact(row, expected):
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, csv_text(HEADER, row))
+
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == [expected]
+
+
+def test_invalid_phone_leaves_the_stored_phone_and_warns():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Smith,ann@example.com,abc,lead"))
+
+    assert report.updated == ["ann@example.com"]
+    assert report.errors == []
+    assert issues(report.warnings) == [(2, "phone")]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="5551234567",
+        tags=frozenset({"vip", "lead"}),
+    )
+
+
+def test_unchanged_contact_is_still_reported_as_updated():
+    repo = repo_with(ann())
+    before = snapshot(repo)
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,555 123 4567,vip"))
+
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert snapshot(repo) == before
+
+
+def test_contact_without_phone_stays_without_phone_on_empty_cell():
+    repo = repo_with(ann(phone=None, tags=[]))
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,"))
+
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee", email="ann@example.com", phone=None, tags=frozenset()
+    )
+
+
+# AC 32
+
+
+def test_each_applied_row_is_listed_once_and_no_email_twice():
+    repo = repo_with(ann(), ann(name="Bob Stone", email="bob@example.com"))
+    data = csv_text(
+        HEADER,
+        "Carl Jones,carl@example.com,,",  # row 2, created
+        "Ann Smith,ann@example.com,,",  # row 3, updated
+        "Carl Again,Carl@example.com,,",  # row 4, duplicate
+        "Ann Again,ANN@example.com,,",  # row 5, duplicate
+        "Bob Stone,bob@example.com,abc,",  # row 6, updated with warning
+        "Dee Long,dee@example.com,,",  # row 7, created
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["carl@example.com", "dee@example.com"]
+    assert report.updated == ["ann@example.com", "bob@example.com"]
+    assert issues(report.errors) == [(4, "email"), (5, "email")]
+    listed = report.created + report.updated
+    assert len(listed) == len(set(listed))
+    assert len(repo) == 4

+        name="Ann Smith",
+        email="ann@example.com",
+        phone="5551234567",
+        tags=frozenset({"vip"}),
+    )
+
+
+# AC 12
+
+
+@pytest.mark.parametrize(
+    ("header", "row"),
+    [
+        ("id,name,company,email,notes", "17,Bob Stone,ACME; Inc!!,bob@example.com,???"),
+        ("notes,name,notes,email", "x,Bob Stone,y,bob@example.com"),
+        ("name,email,,", "Bob Stone,bob@example.com,stray,cells"),
+        ("name,email,e-mail,phone number", "Bob Stone,bob@example.com,not an email,abc"),
+    ],
+)
+def test_unknown_columns_are_ignored_silently(header, row):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(header, row))
+
+    assert report.created == ["bob@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.get("bob@example.com") == Contact(
+        name="Bob Stone", email="bob@example.com", phone=None, tags=frozenset()
+    )

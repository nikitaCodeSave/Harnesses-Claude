@@ -0,0 +1,63 @@
+"""Shared helpers for the CSV import acceptance tests (see SPEC.md).
+
+The importer's public names are looked up when a test runs, not when the module
+is collected, so that each acceptance criterion passes or fails on its own.
+"""
+
+from __future__ import annotations
+
+import importlib
+
+import pytest
+
+import contactbook.errors as errors
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def importer():
+    """The ``contactbook.importer`` module."""
+    return importlib.import_module("contactbook.importer")
+
+
+def import_contacts(repo: InMemoryContactRepository, data):
+    return importer().import_contacts(repo, data)
+
+
+def import_file_error() -> type[Exception]:
+    return errors.ImportFileError
+
+
+def raises_import_file_error():
+    return pytest.raises(import_file_error())
+
+
+def csv_text(*lines: str) -> str:
+    """Join lines into CSV text with ``\\n`` line endings and a final newline."""
+    return "".join(line + "\n" for line in lines)
+
+
+def ann(**overrides) -> Contact:
+    """The contact most tests start from: Ann Lee, with a phone and a tag."""
+    fields = {
+        "name": "Ann Lee",
+        "email": "ann@example.com",
+        "phone": "555 123 4567",
+        "tags": ["vip"],
+    }
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def repo_with(*contacts: Contact) -> InMemoryContactRepository:
+    return InMemoryContactRepository(contacts)
+
+
+def snapshot(repo: InMemoryContactRepository) -> list[Contact]:
+    """Everything stored, in order; Contact is immutable and compares by value."""
+    return list(repo.all())
+
+
+def issues(row_issues) -> list[tuple[int, str | None]]:
+    """(row, column) pairs of a list of RowIssue, in report order."""
+    return [(issue.row, issue.column) for issue in row_issues]

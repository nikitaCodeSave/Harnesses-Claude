+"""AC 10-14: header matching, optional and unknown columns, round trip with export."""
+
+import pytest
+from support import ann, csv_text, import_contacts, repo_with, snapshot
+
+from contactbook.export import export_csv
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+# AC 10
+
+
+@pytest.mark.parametrize(
+    ("header", "row"),
+    [
+        ("name,email,phone,tags", "Ann Lee,ann@example.com,555 123 4567,vip;lead"),
+        ("tags,phone,email,name", "vip;lead,555 123 4567,ann@example.com,Ann Lee"),
+        (" Email ,TAGS,  name,Phone ", "ann@example.com,vip;lead,Ann Lee,555 123 4567"),
+        ("NAME,eMaIl,PHONE,Tags", "Ann Lee,ann@example.com,555 123 4567,vip;lead"),
+    ],
+)
+def test_columns_are_matched_by_name_ignoring_order_case_and_outer_spaces(header, row):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(header, row))
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == [
+        Contact(
+            name="Ann Lee",
+            email="ann@example.com",
+            phone="5551234567",
+            tags=frozenset({"vip", "lead"}),
+        )
+    ]
+
+
+# AC 11
+
+
+def test_phone_and_tags_columns_are_optional_for_new_contacts():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text("email,name", "bob@example.com,Bob Stone"))
+
+    assert report.created == ["bob@example.com"]
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.get("bob@example.com") == Contact(
+        name="Bob Stone", email="bob@example.com", phone=None, tags=frozenset()
+    )
+
+
+def test_missing_phone_and_tags_columns_leave_existing_phone_and_tags_alone():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, csv_text("name,email", "Ann Smith,ann@example.com"))

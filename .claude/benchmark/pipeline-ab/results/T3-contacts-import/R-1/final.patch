+"""CSV import of contacts.
+
+Accepts the columns written by :func:`contactbook.export.export_csv`
+(``name,email,phone,tags``) and the address-book layout that has
+``first_name`` / ``last_name`` instead of ``name``. File-level problems raise
+ImportFileError before anything is stored; problems in single rows are
+reported in the ImportReport and only reject that row.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_DATA_ROWS = 1000
+RECOGNISED_COLUMNS = ("name", "email", "phone", "tags", "first_name", "last_name")
+MAX_MESSAGE_LENGTH = 200
+
+_BOM = "\ufeff"
+
+
+@dataclass(slots=True)
+class RowIssue:
+    """A problem in one record. ``row`` is 1-based and the header is row 1."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True, slots=True)
+class _Row:
+    """A data row after validation; ``errors`` empty means it can be applied."""
+
+    name: str | None
+    email: str | None
+    phone: str | None
+    tags: frozenset[str]
+    errors: list[RowIssue]
+    warnings: list[RowIssue]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV file content.
+
+    ``data`` is raw bytes (decoded as UTF-8, BOM allowed) or decoded text.
+    Raises ImportFileError, leaving ``repo`` untouched, when the file as a
+    whole can't be imported.
+    """
+    records = _parse(_decode(data))
+    header, *rest = records
+    columns = _read_header(header)
+    numbered = [
+        (number, record)
+        for number, record in enumerate(rest, start=2)
+        if not _is_blank(record)
+    ]
+    if len(numbered) > MAX_DATA_ROWS:
+        raise ImportFileError(
+            f"the file has {len(numbered)} contact rows; at most {MAX_DATA_ROWS} "
+            "can be imported at once, split it into smaller files"
+        )
+
+    report = ImportReport()
+    claimed: dict[str, int] = {}  # email -> row number of the applied row
+    for number, record in numbered:
+        row = _validate_row(number, record, columns, len(header))
+        errors = list(row.errors)
+        if row.email is not None and row.email in claimed:
+            errors.append(
+                RowIssue(
+                    number,
+                    "email",
+                    f"email {row.email} is already used by row {claimed[row.email]}",
+                )
+            )
+        if errors:
+            report.errors.extend(errors)
+            continue
+        claimed[row.email] = number
+        report.warnings.extend(row.warnings)
+        _apply(repo, row, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and import it again'
+            ) from None
+    elif isinstance(data, str):
+        text = data
+    else:
+        raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+    text = text.removeprefix(_BOM)
+    if not text.strip():
+        raise ImportFileError("the file is empty")
+    # Same records for \n and \r\n files, including line breaks inside quoted cells.
+    return text.replace("\r\n", "\n")
+
+
+def _parse(text: str) -> list[list[str]]:
+    try:
+        return list(csv.reader(io.StringIO(text, newline=""), strict=True))
+    except csv.Error as exc:
+        raise ImportFileError(
+            f"the file is not valid CSV ({exc}); check for unclosed quotes"
+        ) from None
+
+
+def _read_header(header: list[str]) -> dict[str, int]:
+    """Map each recognised column name to its index in the header."""
+    columns: dict[str, int] = {}
+    duplicates: list[str] = []
+    for index, cell in enumerate(header):
+        name = cell.strip().lower()
+        if name not in RECOGNISED_COLUMNS:
+            continue
+        if name in columns:
+            duplicates.append(name)
+        else:
+            columns[name] = index
+    if duplicates:
+        repeated = ", ".join(dict.fromkeys(duplicates))
+        raise ImportFileError(f"the header has these columns more than once: {repeated}")
+    missing = []
+    if "email" not in columns:
+        missing.append("email")
+    if not columns.keys() & {"name", "first_name", "last_name"}:
+        missing.append("name (or first_name and last_name)")
+    if missing:
+        raise ImportFileError("the header is missing the column(s): " + ", ".join(missing))
+    return columns
+
+
+def _is_blank(record: list[str]) -> bool:
+    return all(not cell.strip() for cell in record)
+
+
+def _validate_row(number: int, record: list[str], columns: dict[str, int], width: int) -> _Row:
+    if any(cell.strip() for cell in record[width:]):
+        error = RowIssue(
+            number,
+            None,
+            f"the row has text after the last of the {width} header columns; "
+            "check for an unquoted comma",
+        )
+        return _Row(None, None, None, frozenset(), [error], [])
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return record[index] if index is not None and index < len(record) else ""
+
+    errors: list[RowIssue] = []
+    warnings: list[RowIssue] = []
+
+    def check(column: str, normalise, raw):
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(number, column, _message(exc)))
+            return None
+
+    if "name" in columns:
+        raw_name = cell("name")
+    else:
+        parts = (cell("first_name"), cell("last_name"))
+        raw_name = " ".join(part for part in parts if part.strip())
+    name = check("name", validate_name, raw_name)
+    email = check("email", normalize_email, cell("email"))
+    tags = check("tags", _normalise_tags_cell, cell("tags"))
+
+    phone = None
+    if cell("phone").strip():
+        try:
+            phone = normalize_phone(cell("phone"))
+        except ValidationError as exc:
+            message = _message(exc) + "; the phone was not imported"
+            warnings.append(RowIssue(number, "phone", message))
+
+    return _Row(name, email, phone, tags or frozenset(), errors, warnings)
+
+
+def _normalise_tags_cell(raw: str) -> frozenset[str]:
+    return frozenset(normalize_tag(piece) for piece in raw.split(TAG_SEPARATOR) if piece.strip())
+
+
+def _message(exc: ValidationError) -> str:
+    # Tag messages already say "tag" ("invalid tag: 'x'"); the others need the field.
+    message = exc.message if exc.field == "tags" else f"{exc.field} {exc.message}"
+    if len(message) > MAX_MESSAGE_LENGTH:
+        message = message[: MAX_MESSAGE_LENGTH - 3] + "..."
+    return message
+
+
+def _apply(repo: InMemoryContactRepository, row: _Row, report: ImportReport) -> None:
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(Contact.create(name=row.name, email=row.email, phone=row.phone, tags=row.tags))
+        report.created.append(row.email)
+        return
+    contact = existing.rename(row.name).with_tags(*row.tags)
+    if row.phone is not None:
+        contact = contact.with_phone(row.phone)
+    repo.update(contact)
+    report.updated.append(row.email)

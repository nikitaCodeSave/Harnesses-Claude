@@ -0,0 +1,72 @@
+"""Interface section, plus AC 6 (TypeError) and AC 9 (ImportFileError hierarchy)."""
+
+import dataclasses
+import io
+
+import pytest
+from support import ann, csv_text, import_contacts, import_file_error, importer, repo_with, snapshot
+
+from contactbook.errors import ContactError
+from contactbook.repository import InMemoryContactRepository
+
+
+def test_import_contacts_returns_an_import_report_dataclass():
+    report = import_contacts(
+        InMemoryContactRepository(), csv_text("name,email", "Ann Lee,ann@example.com")
+    )
+
+    assert isinstance(report, importer().ImportReport)
+    assert dataclasses.is_dataclass(report)
+    field_names = {field.name for field in dataclasses.fields(report)}
+    assert field_names >= {"created", "updated", "errors", "warnings"}
+    assert report.created == ["ann@example.com"]
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []
+
+
+def test_row_issues_are_row_issue_dataclasses():
+    report = import_contacts(
+        InMemoryContactRepository(), csv_text("name,email", "Ann Lee,not-an-email")
+    )
+
+    [issue] = report.errors
+    assert isinstance(issue, importer().RowIssue)
+    assert dataclasses.is_dataclass(issue)
+    assert {field.name for field in dataclasses.fields(issue)} >= {"row", "column", "message"}
+    assert issue.row == 2
+    assert issue.column == "email"
+    assert isinstance(issue.message, str)
+
+
+# AC 6
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        None,
+        42,
+        ["name,email", "Ann Lee,ann@example.com"],
+        io.StringIO("name,email\nAnn Lee,ann@example.com\n"),
+        bytearray(b"name,email\nAnn Lee,ann@example.com\n"),
+        memoryview(b"name,email\nAnn Lee,ann@example.com\n"),
+    ],
+    ids=["None", "int", "list", "StringIO", "bytearray", "memoryview"],
+)
+def test_data_that_is_not_str_or_bytes_raises_type_error(data):
+    repo = repo_with(ann())
+    before = snapshot(repo)
+
+    with pytest.raises(TypeError) as excinfo:
+        import_contacts(repo, data)
+
+    assert not isinstance(excinfo.value, ContactError)
+    assert snapshot(repo) == before
+
+
+# AC 9
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(import_file_error(), ContactError)

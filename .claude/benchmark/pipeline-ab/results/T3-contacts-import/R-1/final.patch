index 0000000..38f4311
--- /dev/null
+++ b/tests/acceptance/test_import_decoding.py
@@ -0,0 +1,179 @@
+"""AC 1-5: decoding and line endings."""
+
+import pytest
+from support import (
+    ann,
+    csv_text,
+    import_contacts,
+    issues,
+    raises_import_file_error,
+    repo_with,
+    snapshot,
+)
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+BOM = "\ufeff"
+
+# Header orders where a BOM left in place would spoil the first column's name.
+HEADERS_AND_ROWS = [
+    ("email,name", "ann@example.com,Ann Lee"),
+    ("name,email", "Ann Lee,ann@example.com"),
+]
+
+
+# AC 1
+
+
+def test_bytes_are_decoded_as_utf8():
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        "name,email",
+        "Zoë Ångström,zoe@example.com",
+        "Иван Петров,ivan@example.com",
+    ).encode("utf-8")
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["zoe@example.com", "ivan@example.com"]
+    assert report.errors == []
+    assert repo.get("zoe@example.com").name == "Zoë Ångström"
+    assert repo.get("ivan@example.com").name == "Иван Петров"
+
+
+@pytest.mark.parametrize(("header", "row"), HEADERS_AND_ROWS)
+def test_utf8_bom_in_bytes_is_not_part_of_first_header_name(header, row):
+    repo = InMemoryContactRepository()
+    data = b"\xef\xbb\xbf" + csv_text(header, row).encode("utf-8")
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# AC 2
+
+
+@pytest.mark.parametrize(("header", "row"), HEADERS_AND_ROWS)
+def test_bom_character_at_start_of_str_is_ignored(header, row):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, BOM + csv_text(header, row))
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# AC 3
+
+
+@pytest.mark.parametrize(
+    ("encoding", "name"),
+    [("cp1251", "Иван Петров"), ("cp1252", "José Müller")],
+)
+def test_non_utf8_bytes_raise_import_file_error_asking_for_csv_utf8(encoding, name):
+    data = csv_text("name,email", f"{name},someone@example.com").encode(encoding)
+    with pytest.raises(UnicodeDecodeError):
+        data.decode("utf-8")  # the fixture really is not UTF-8
+    repo = repo_with(ann())
+    before = snapshot(repo)
+
+    with raises_import_file_error() as excinfo:
+        import_contacts(repo, data)
+
+    assert "CSV UTF-8" in str(excinfo.value)
+    assert snapshot(repo) == before
+
+
+def test_invalid_utf8_late_in_the_file_still_rejects_the_whole_file():
+    valid = csv_text("name,email", "Bob Stone,bob@example.com", "Ann Smith,ann@example.com")
+    data = valid.encode("utf-8") + csv_text("José Müller,jose@example.com").encode("cp1252")
+    repo = repo_with(ann())
+    before = snapshot(repo)
+
+    with raises_import_file_error() as excinfo:
+        import_contacts(repo, data)
+
+    assert "CSV UTF-8" in str(excinfo.value)
+    assert snapshot(repo) == before
+
+
+# AC 4
+
+
+@pytest.mark.parametrize("encoding", ["utf-16", "utf-16-le", "utf-32", "latin-1"])
+def test_no_other_encoding_is_attempted(encoding):
+    data = csv_text("name,email", "José Müller,jose@example.com").encode(encoding)
+    with pytest.raises(UnicodeDecodeError):
+        data.decode("utf-8")  # the fixture really is not UTF-8
+    repo = InMemoryContactRepository()
+
+    with raises_import_file_error():
+        import_contacts(repo, data)
+
+    assert len(repo) == 0
+
+
+# AC 5
+
+LINES = [
+    "name,email,phone,tags",
+    "Ann Smith,ann@example.com,+44 20 7946 0958,lead",
+    '"Bob',
+    'Stone",bob@example.com,,vip;Key Account',
+    "",
+    "Carl,not-an-email,,",
+    " , , , ",
+    "Dee,dee@example.com,12,",
+    "Eve,eve@example.com,555 765 4321,partner",
+]
+
+
+def _import_with_line_ending(line_ending, as_bytes):
+    repo = repo_with(ann())
+    text = "".join(line + line_ending for line in LINES)
+    report = import_contacts(repo, text.encode("utf-8") if as_bytes else text)
+    return report, snapshot(repo)
+
+
+@pytest.mark.parametrize("as_bytes", [False, True], ids=["str", "bytes"])
+def test_lf_and_crlf_files_import_identically(as_bytes):
+    lf_report, lf_contacts = _import_with_line_ending("\n", as_bytes)
+    crlf_report, crlf_contacts = _import_with_line_ending("\r\n", as_bytes)
+
+    assert crlf_report == lf_report
+    assert crlf_contacts == lf_contacts
+
+
+def test_crlf_file_values_carry_no_stray_carriage_returns():
+    report, contacts = _import_with_line_ending("\r\n", as_bytes=False)
+
+    assert report.updated == ["ann@example.com"]
+    assert report.created == ["bob@example.com", "dee@example.com", "eve@example.com"]
+    assert issues(report.errors) == [(5, "email")]
+    assert issues(report.warnings) == [(7, "phone")]
+    assert contacts == [
+        Contact(
+            name="Ann Smith",
+            email="ann@example.com",
+            phone="+442079460958",
+            tags=frozenset({"vip", "lead"}),
+        ),
+        Contact(
+            name="Bob Stone",
+            email="bob@example.com",
+            phone=None,
+            tags=frozenset({"vip", "key-account"}),
+        ),
+        Contact(name="Dee", email="dee@example.com", phone=None, tags=frozenset()),
+        Contact(
+            name="Eve",
+            email="eve@example.com",
+            phone="5557654321",
+            tags=frozenset({"partner"}),
+        ),
+    ]

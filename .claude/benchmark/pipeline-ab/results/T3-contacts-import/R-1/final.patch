+        b"\xef\xbb\xbfname,email\n\n",
+    ],
+    ids=repr,
+)
+def test_header_only_file_returns_an_empty_report(data):
+    repo = repo_with(ann())
+    before = snapshot(repo)
+
+    report = import_contacts(repo, data)

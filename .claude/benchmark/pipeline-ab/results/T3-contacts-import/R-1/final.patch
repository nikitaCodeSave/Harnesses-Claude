diff --git a/tests/acceptance/test_import_file_rejection.py b/tests/acceptance/test_import_file_rejection.py
new file mode 100644
index 0000000..ff29b6f
--- /dev/null
+++ b/tests/acceptance/test_import_file_rejection.py
@@ -0,0 +1,172 @@
+"""AC 7-8: problems that reject the whole file and leave the repository untouched."""
+
+import pytest
+from support import ann, csv_text, import_contacts, raises_import_file_error, repo_with, snapshot
+
+# Rows that would update the existing contact and create a new one if they were
+# applied, so a partial import shows up as a changed repository.
+APPLICABLE_ROWS = ["Ann Smith,ann@example.com,+44 20 7946 0958,lead", "Bob Stone,bob@example.com,,"]
+
+
+def assert_rejected(data):
+    """Import ``data`` into a non-empty repository; expect ImportFileError and no change."""
+    repo = repo_with(ann(), ann(name="Carl Jones", email="carl@example.com", phone=None))
+    before = snapshot(repo)
+
+    with raises_import_file_error() as excinfo:
+        import_contacts(repo, data)
+
+    assert snapshot(repo) == before
+    return excinfo.value
+
+
+# AC 7: empty file
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "",
+        b"",
+        "   ",
+        "\n",
+        "\n\n\n",
+        "  \n\t\n \n",
+        "\r\n\r\n",
+        b"\xef\xbb\xbf",
+        "\ufeff",
+        b" \n\n",
+    ],
+    ids=repr,
+)
+def test_empty_file_is_rejected(data):
+    assert_rejected(data)
+
+
+# AC 7: not parseable as CSV
+
+
+@pytest.mark.parametrize("as_bytes", [False, True], ids=["str", "bytes"])
+def test_unclosed_quote_is_rejected(as_bytes):
+    text = csv_text(
+        "name,email,phone,tags",
+        *APPLICABLE_ROWS,
+        '"Dee Unclosed,dee@example.com,,',
+        "Eve,eve@example.com,,",
+    )
+    assert_rejected(text.encode("utf-8") if as_bytes else text)
+
+
+# AC 7 and 8: missing email column
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["name,phone,tags", "name,e-mail,phone,tags", "name,mail,phone,tags"],
+)
+def test_missing_email_column_is_rejected_and_named(header):
+    error = assert_rejected(csv_text(header, *APPLICABLE_ROWS))
+
+    assert "email" in str(error)
+
+
+# AC 7 and 8: missing name column(s)
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["email,phone,tags,x", "first,email,phone,tags", "full name,email,phone,tags"],
+)
+def test_missing_name_columns_are_rejected_and_named(header):
+    rows = ["ann@example.com,,,", "bob@example.com,,,"]
+    if not header.startswith("email"):
+        rows = ["Ann Smith,ann@example.com,,", "Bob Stone,bob@example.com,,"]
+
+    error = assert_rejected(csv_text(header, *rows))
+
+    assert "name" in str(error)
+
+
+def test_missing_email_and_name_columns_are_both_named():
+    error = assert_rejected(csv_text("phone,tags", "555 123 4567,vip"))
+
+    assert "email" in str(error)
+    assert "name" in str(error)
+
+
+# AC 7: duplicate recognised columns
+
+
+@pytest.mark.parametrize(
+    ("header", "row"),
+    [
+        ("name,email,email", "Bob Stone,bob@example.com,bob@example.com"),
+        ("name,email, EMAIL ", "Bob Stone,bob@example.com,bob@example.com"),
+        ("Name,name,email", "Bob Stone,Bob Stone,bob@example.com"),
+        ("name,email,phone,Phone", "Bob Stone,bob@example.com,,"),
+        ("name,email,tags,TAGS ", "Bob Stone,bob@example.com,vip,vip"),
+        ("first_name,last_name,email,First_Name", "Bob,Stone,bob@example.com,Bob"),
+        ("first_name,last_name,email, last_name", "Bob,Stone,bob@example.com,Stone"),
+        ("name,first_name,email,FIRST_NAME", "Bob Stone,Bob,bob@example.com,Bob"),
+    ],
+)
+def test_recognised_column_appearing_twice_is_rejected(header, row):
+    assert_rejected(csv_text(header, row, "Ann Smith" + "," * header.count(",")))
+
+
+# AC 7: more than 1000 data rows
+
+
+def people(count, start=0):
+    return [f"Person Number,person{i}@example.com" for i in range(start, start + count)]
+
+
+def test_more_than_1000_data_rows_is_rejected():
+    assert_rejected(csv_text("name,email", "Ann Smith,ann@example.com", *people(1000)))
+
+
+def test_rejected_rows_count_toward_the_limit():
+    bad_rows = ["Bad Email,not-an-email", "No Email,"]
+    assert_rejected(csv_text("name,email", *people(999), *bad_rows))
+
+
+def test_duplicate_rows_count_toward_the_limit():
+    assert_rejected(csv_text("name,email", *people(1000), "Person Again,person0@example.com"))
+
+
+def test_exactly_1000_data_rows_is_accepted():
+    repo = repo_with()
+
+    report = import_contacts(repo, csv_text("name,email", *people(1000)))
+
+    assert len(report.created) == 1000
+    assert report.errors == []
+    assert len(repo) == 1000
+
+
+def test_blank_rows_do_not_count_toward_the_limit():
+    rows = []
+    for i, row in enumerate(people(1000)):
+        rows.append(row)
+        if i % 100 == 0:
+            rows.extend(["", ",", " , "])
+    repo = repo_with()
+
+    report = import_contacts(repo, csv_text("name,email", *rows))
+
+    assert len(report.created) == 1000
+    assert report.errors == []
+    assert report.warnings == []
+
+
+def test_1000_data_rows_including_rejected_ones_is_accepted():
+    rows = people(998) + ["Bad Email,not-an-email", "No Email,"]
+    repo = repo_with()
+
+    report = import_contacts(repo, csv_text("name,email", *rows))
+
+    assert len(report.created) == 998
+    assert [(issue.row, issue.column) for issue in report.errors] == [
+        (1000, "email"),
+        (1001, "email"),
+    ]

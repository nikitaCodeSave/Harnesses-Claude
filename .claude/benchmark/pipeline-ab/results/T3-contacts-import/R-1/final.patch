+"""AC 33-37: the report's order, row numbers, columns and messages."""
+
+from support import ann, csv_text, import_contacts, issues, repo_with
+
+from contactbook.repository import InMemoryContactRepository
+
+# AC 33
+
+
+def test_created_and_updated_are_in_file_order():
+    repo = repo_with(
+        ann(name="Bob Stone", email="bob@example.com"),
+        ann(name="Amy Wu", email="amy@example.com"),
+    )
+    data = csv_text(
+        "name,email",
+        "Zed Moss,Zed@Example.com",
+        "Amy Wu,amy@example.com",
+        "Mia Park,mia@example.com",
+        "Bob Stone,BOB@example.com",
+        "Kim Lund,kim@example.com",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["zed@example.com", "mia@example.com", "kim@example.com"]
+    assert report.updated == ["amy@example.com", "bob@example.com"]
+
+
+# AC 34
+
+MULTILINE_FILE = csv_text(
+    "name,email,phone,notes",  # row 1
+    'Ann Lee,ann@example.com,abc,"line one',  # row 2: phone warning
+    "line two",
+    'line three"',
+    "Bob Stone,not-an-email,,",  # row 3: email error
+    '"Carl',
+    'Jones",carl@example.com,,',  # row 4: two-line name
+    "Dee Long,dee@example.com,12,",  # row 5: phone warning
+    ",,,",  # row 6: blank
+    'Eve Gray,eve@,,"a',  # row 7: email error
+    'b"',
+    ",fay@example.com,,",  # row 8: name error
+)
+
+
+def test_row_numbers_count_records_not_text_lines():
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, MULTILINE_FILE)
+
+    assert issues(report.errors) == [(3, "email"), (7, "email"), (8, "name")]
+    assert issues(report.warnings) == [(2, "phone"), (5, "phone")]
+    assert report.created == ["ann@example.com", "carl@example.com", "dee@example.com"]
+    assert repo.get("carl@example.com").name == "Carl Jones"
+
+
+def test_errors_and_warnings_are_ordered_by_row_number():
+    data = csv_text(
+        "name,email,phone,tags",
+        "Ann Lee,ann@example.com,abc,",  # row 2: warning
+        ",not-an-email,,bad!",  # row 3: three errors
+        "Bob Stone,bob@example.com,,x,y",  # row 4: whole-row error
+        "Carl Jones,carl@example.com,12,",  # row 5: warning
+        "Dee Long,,,",  # row 6: error
+        "Eve Gray,eve@example.com,1,",  # row 7: warning
+    )
+
+    report = import_contacts(InMemoryContactRepository(), data)
+
+    error_rows = [issue.row for issue in report.errors]
+    assert error_rows == sorted(error_rows)
+    assert error_rows == [3, 3, 3, 4, 6]
+    assert [issue.row for issue in report.warnings] == [2, 5, 7]
+
+
+# AC 35
+
+
+def test_issue_columns_are_contact_fields_or_none():
+    data = csv_text(
+        " First_Name ,Last_Name,E-Mail Address,EMAIL,Phone,TAGS",
+        ",,x,ann@example.com,abc,",  # row 2: name error
+        "Bob,Stone,x,not-an-email,abc,bad!",  # row 3: email and tags errors
+        "Carl,Jones,x,carl@example.com,abc,,surplus",  # row 4: whole-row error
+        "Dee,Long,x,dee@example.com,abc,",  # row 5: phone warning
+    )
+
+    report = import_contacts(InMemoryContactRepository(), data)
+
+    by_row_then_column = sorted(issues(report.errors), key=lambda issue: (issue[0], str(issue[1])))
+    assert by_row_then_column == [(2, "name"), (3, "email"), (3, "tags"), (4, None)]
+    assert issues(report.warnings) == [(5, "phone")]
+    for issue in report.errors + report.warnings:
+        assert issue.column in {"name", "email", "phone", "tags", None}
+
+
+# AC 36
+
+
+def test_messages_are_short_readable_text():
+    data = csv_text(
+        "name,email,phone,tags",
+        f"{'a' * 101},not-an-email,abc,bad!",
+        "Bob Stone,bob@example.com,abc,",
+        "Bob Again,bob@example.com,,",
+        "Carl Jones,carl@example.com,,,extra",
+        "Dee Long,,,",
+    )
+
+    report = import_contacts(InMemoryContactRepository(), data)
+
+    assert len(report.errors) == 6
+    assert len(report.warnings) == 1
+    for issue in report.errors + report.warnings:
+        assert isinstance(issue.message, str)
+        assert issue.message.strip()
+        assert "\n" not in issue.message
+        assert len(issue.message) <= 200
+        assert "Traceback" not in issue.message
+        assert "Error(" not in issue.message
+
+
+# AC 37
+
+
+def test_blank_rows_produce_no_entries_but_count_toward_row_numbers():
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        "name,email",  # row 1
+        "",  # row 2
+        "Ann Lee,not-an-email",  # row 3
+        "   ",  # row 4
+        " , ",  # row 5
+        ",,,,",  # row 6: more cells than the header, all empty
+        "Bob Stone,bob@example.com",  # row 7
+        "\t,",  # row 8
+        ",carl@example.com",  # row 9
+    )
+
+    report = import_contacts(repo, data)
+
+    assert issues(report.errors) == [(3, "email"), (9, "name")]
+    assert report.warnings == []
+    assert report.created == ["bob@example.com"]
+    assert report.updated == []

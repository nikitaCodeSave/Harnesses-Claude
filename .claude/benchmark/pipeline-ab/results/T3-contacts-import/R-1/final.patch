@@ -0,0 +1,141 @@
+"""AC 26-28: the same email more than once in one file."""
+
+import re
+
+from support import ann, csv_text, import_contacts, issues, repo_with
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+
+
+def mentions_row(message, row):
+    return re.search(rf"(?<!\d){row}(?!\d)", message) is not None
+
+
+# AC 26
+
+
+def test_emails_are_compared_after_normalisation():
+    repo = InMemoryContactRepository()
+    data = csv_text(HEADER, "Ann Lee,Ann@Example.com,,", "Ann Again, ann@EXAMPLE.com ,,")
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert issues(report.errors) == [(3, "email")]
+    assert len(repo) == 1
+
+
+def test_existing_email_in_other_case_updates_the_stored_contact():
+    repo = repo_with(ann())
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Smith,ANN@Example.COM,,"))
+
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert len(repo) == 1
+    assert repo.get("ann@example.com").name == "Ann Smith"
+
+
+# AC 27
+
+
+def test_first_applied_row_wins_and_later_rows_mention_its_row_number():
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        HEADER,
+        "",  # row 2, blank
+        "Ann First,ann@example.com,555 123 4567,vip",  # row 3, wins
+        "Bob Stone,bob@example.com,,",  # row 4
+        "Ann Second,ann@example.com,555 765 4321,lead",  # row 5
+        "Ann Third,ANN@example.com,,",  # row 6
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert issues(report.errors) == [(5, "email"), (6, "email")]
+    assert all(mentions_row(issue.message, 3) for issue in report.errors)
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann First", email="ann@example.com", phone="5551234567", tags=frozenset({"vip"})
+    )
+
+
+def test_later_duplicate_with_other_problems_also_gets_the_duplicate_error():
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        HEADER,
+        "Ann First,ann@example.com,,",  # row 2, wins
+        "Ann Second,ann@example.com,abc,bad!tag",  # row 3
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert sorted(issue.column for issue in report.errors) == ["email", "tags"]
+    assert all(issue.row == 3 for issue in report.errors)
+    [email_error] = [issue for issue in report.errors if issue.column == "email"]
+    assert mentions_row(email_error.message, 2)
+    assert report.warnings == []
+
+
+def test_first_row_updating_an_existing_contact_wins():
+    repo = repo_with(ann())
+    data = csv_text(
+        HEADER,
+        "Ann Smith,ann@example.com,,lead",  # row 2, wins
+        "Ann Jones,ann@example.com,+44 20 7946 0958,partner",  # row 3
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert issues(report.errors) == [(3, "email")]
+    assert mentions_row(report.errors[0].message, 2)
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="5551234567",
+        tags=frozenset({"vip", "lead"}),
+    )
+
+
+# AC 28
+
+
+def test_rejected_row_does_not_claim_its_email():
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        HEADER,
+        "Ann Lee,ann@example.com,,bad!tag",  # row 2, rejected
+        "Bob Stone,bob@example.com,,",  # row 3
+        "Carl Jones,carl@example.com,,",  # row 4
+        "Ann Lee,ann@example.com,,vip",  # row 5, applied
+    )
+
+    report = import_contacts(repo, data)
+
+    assert issues(report.errors) == [(2, "tags")]
+    assert report.created == ["bob@example.com", "carl@example.com", "ann@example.com"]
+    assert repo.get("ann@example.com").tags == frozenset({"vip"})
+
+
+def test_duplicate_points_at_the_first_applied_row_not_the_first_rejected_one():
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        HEADER,
+        ",ann@example.com,,",  # row 2, rejected: no name
+        "Bob Stone,bob@example.com,,",  # row 3
+        "Ann Lee,ann@example.com,,",  # row 4, wins
+        "Ann Again,ann@example.com,,",  # row 5
+    )
+
+    report = import_contacts(repo, data)
+

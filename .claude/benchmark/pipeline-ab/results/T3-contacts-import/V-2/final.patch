diff --git a/tests/test_importer.py b/tests/test_importer.py
new file mode 100644
index 0000000..d937624
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,137 @@
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def test_import_creates_contacts_with_normalised_values():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "  Ann   Lee ,Ann@Example.COM,+1 (555) 123-4567,Key Account;vip\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.updated == [] and report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"key-account", "vip"}),
+    )
+
+
+def test_export_then_import_round_trips():
+    contacts = [
+        Contact.create(name="Ann Lee", email="ann@example.com", phone="+15551234567"),
+        Contact.create(name="Bob, Jr.", email="bob@example.com", tags=["lead", "vip"]),
+    ]
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, export_csv(contacts).encode())
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert repo.all() == contacts
+    # Importing the same file again changes nothing.
+    again = import_contacts(repo, export_csv(contacts))
+    assert again.created == [] and again.updated == []
+
+
+def test_existing_contact_is_updated_without_losing_data():
+    repo = InMemoryContactRepository(
+        [Contact.create(name="Ann", email="ann@example.com", phone="5551234567", tags=["vip"])]
+    )
+    report = import_contacts(repo, HEADER + "Ann Lee,ANN@example.com,,lead\n")
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    ann = repo.get("ann@example.com")
+    assert ann.name == "Ann Lee"
+    assert ann.phone == "5551234567"  # blank cell keeps the stored phone
+    assert ann.tags == {"vip", "lead"}  # tags are added, not replaced
+
+
+def test_invalid_rows_are_reported_and_skipped_others_imported():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        HEADER
+        + "Ann Lee,ann@example.com,,\n"
+        + ",not-an-email,12,ok\n"
+        + "Bob,bob@example.com,,bad!tag\n",
+    )
+    assert report.created == ["ann@example.com"]
+    assert [(i.row, i.column) for i in report.errors] == [
+        (3, "name"),
+        (3, "email"),
+        (3, "phone"),
+        (4, "tags"),
+    ]
+    assert len(repo) == 1
+
+
+def test_duplicate_email_in_file_is_an_error_on_the_later_row():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "Ann,ann@example.com,,\nAnn Lee,ANN@example.com,,\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [RowIssue(3, "email", "duplicate of row 2; row skipped")]
+    assert repo.get("ann@example.com").name == "Ann"
+
+
+def test_spreadsheet_quirks_are_tolerated():
+    data = (
+        "\ufeffName,E-mail,Email,Phone\r\n"
+        "Ann,x,ann@example.com,,extra\r\n"
+        ",,,\r\n"
+        "\r\n"
+        "Bob,,bob@example.com\r\n"
+    ).encode("utf-8")
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == []
+    assert report.warnings == [
+        RowIssue(1, "E-mail", "unknown column ignored"),
+        RowIssue(2, None, "1 value(s) outside the named columns ignored"),
+    ]
+
+
+def test_semicolon_delimited_file():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, 'name;email;phone;tags\nAnn;ann@example.com;;"lead;vip"\n')
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").tags == {"lead", "vip"}
+
+
+@pytest.mark.parametrize(
+    "data, message",
+    [
+        (b"", "empty"),
+        ("  \n", "empty"),
+        ("Ann Lee,ann@example.com\n", "missing required column"),
+        ("name,phone\nAnn,5551234567\n", "missing required column(s): email"),
+        ("name,email,EMAIL\n", "more than once"),
+        ("name,email\nAnn L\xe9e,ann@example.com\n".encode("cp1252"), "not UTF-8"),
+    ],
+)
+def test_unusable_file_raises_and_stores_nothing(data, message):
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError) as excinfo:
+        import_contacts(repo, data)
+    assert message in str(excinfo.value)
+    assert isinstance(excinfo.value, ContactError)
+    assert len(repo) == 0
+
+
+def test_malformed_csv_stores_nothing():
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError, match="malformed CSV"):
+        import_contacts(repo, HEADER + "Ann,ann@example.com,,\n" + "x" * 200_000 + "\n")
+    assert len(repo) == 0
+
+
+def test_header_only_imports_nothing():
+    report = import_contacts(InMemoryContactRepository(), HEADER)
+    assert report.created == [] and report.errors == [] and report.warnings == []

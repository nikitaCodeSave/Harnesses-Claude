@@ -0,0 +1,195 @@
+"""CSV import of contacts.
+
+Reads the format written by ``export.export_csv`` (a header row with the
+columns name, email, phone, tags) so a file can be exported, edited in a
+spreadsheet and loaded back.
+
+Rules:
+
+* The whole file is read and checked before anything is stored. Problems with
+  the file as a whole (not UTF-8, malformed CSV, no usable header) raise
+  ImportFileError and leave the repository untouched.
+* Each data row is imported on its own: a row with an invalid value is
+  reported in ``ImportReport.errors`` and skipped, the other rows still go in.
+* A row whose email is not in the repository creates a contact. A row whose
+  email is already there updates that contact: the name is replaced, the tags
+  are added to the existing ones and a non-empty phone replaces the stored one.
+  Blank cells never erase data. Rows that change nothing are not reported.
+* Row numbers are spreadsheet row numbers: the header is row 1.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+REQUIRED_COLUMNS = ("name", "email")
+# Spreadsheets in some locales save "CSV" with semicolons or tabs.
+_DELIMITERS = (",", ";", "\t")
+
+
+@dataclass
+class RowIssue:
+    """A problem found in one row; ``column`` is None when it concerns the whole row."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did. ``created`` and ``updated`` hold normalised emails."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import contacts from CSV content (raw bytes or decoded text) into ``repo``."""
+    report = ImportReport()
+    contacts = _read_contacts(_decode(data), report)
+    for contact in contacts:
+        _store(repo, contact, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, (bytes, bytearray)):
+        try:
+            text = bytes(data).decode("utf-8-sig")
+        except UnicodeDecodeError as exc:
+            raise ImportFileError(
+                f"file is not UTF-8 text (bad byte at offset {exc.start}); "
+                "save it from the spreadsheet as 'CSV UTF-8'"
+            ) from None
+    elif isinstance(data, str):
+        text = data.removeprefix("\ufeff")
+    else:
+        raise TypeError(f"expected str or bytes, got {type(data).__name__}")
+    if not text.strip():
+        raise ImportFileError("file is empty")
+    return text
+
+
+def _read_contacts(text: str, report: ImportReport) -> list[Contact]:
+    """Parse and validate every row; return the contacts to store, in file order."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=_detect_delimiter(text))
+    try:
+        records = list(reader)
+    except csv.Error as exc:
+        raise ImportFileError(f"malformed CSV near line {reader.line_num}: {exc}") from None
+
+    columns, unknown = _read_header(records[0], report)
+    contacts: list[Contact] = []
+    first_row_for_email: dict[str, int] = {}
+    for row, record in enumerate(records[1:], start=2):
+        if not any(cell.strip() for cell in record):
+            continue  # spreadsheets leave blank rows (",,,") behind
+
+        values = dict.fromkeys(EXPORT_COLUMNS, "")
+        stray = 0
+        for index, cell in enumerate(record):
+            if index in columns:
+                values[columns[index]] = cell
+            elif index not in unknown and cell.strip():
+                stray += 1
+        if stray:
+            report.warnings.append(
+                RowIssue(row, None, f"{stray} value(s) outside the named columns ignored")
+            )
+
+        contact = _parse_row(row, values, report)
+        if contact is None:
+            continue
+        first_row = first_row_for_email.setdefault(contact.email, row)
+        if first_row != row:
+            report.errors.append(
+                RowIssue(row, "email", f"duplicate of row {first_row}; row skipped")
+            )
+            continue
+        contacts.append(contact)
+    return contacts
+
+
+def _detect_delimiter(text: str) -> str:
+    first_line = text.split("\n", 1)[0]
+    for delimiter in _DELIMITERS:
+        header = next(csv.reader([first_line], delimiter=delimiter), [])
+        if set(REQUIRED_COLUMNS) <= {cell.strip().lower() for cell in header}:
+            return delimiter
+    return ","
+
+
+def _read_header(header: list[str], report: ImportReport) -> tuple[dict[int, str], set[int]]:
+    """Map cell index -> known column; also return the indexes of unknown named columns."""
+    columns: dict[int, str] = {}
+    unknown: set[int] = set()
+    for index, raw in enumerate(header):
+        name = raw.strip().lower()
+        if not name:
+            continue
+        if name not in EXPORT_COLUMNS:
+            unknown.add(index)
+            report.warnings.append(RowIssue(1, raw.strip(), "unknown column ignored"))
+        elif name in columns.values():
+            raise ImportFileError(f"column {name!r} appears more than once in the header")
+        else:
+            columns[index] = name
+
+    missing = [name for name in REQUIRED_COLUMNS if name not in columns.values()]
+    if missing:
+        raise ImportFileError(
+            f"header is missing required column(s): {', '.join(missing)}; "
+            f"expected {','.join(EXPORT_COLUMNS)}"
+        )
+    return columns, unknown
+
+
+def _parse_row(row: int, values: dict[str, str], report: ImportReport) -> Contact | None:
+    """Validate one row, reporting every bad value; None if any was rejected."""
+    issues: list[RowIssue] = []
+
+    def check(normalize, raw):
+        try:
+            return normalize(raw)
+        except ValidationError as exc:
+            issues.append(RowIssue(row, exc.field, exc.message))
+            return None
+
+    name = check(validate_name, values["name"])
+    email = check(normalize_email, values["email"])
+    phone = check(normalize_phone, values["phone"]) if values["phone"].strip() else None
+    tags = [
+        check(normalize_tag, piece)
+        for piece in values["tags"].split(TAG_SEPARATOR)
+        if piece.strip()
+    ]
+    if issues:
+        report.errors.extend(issues)
+        return None
+    return Contact.create(name=name, email=email, phone=phone, tags=tags)
+
+
+def _store(repo: InMemoryContactRepository, contact: Contact, report: ImportReport) -> None:
+    existing = repo.find(contact.email)
+    if existing is None:
+        repo.add(contact)
+        report.created.append(contact.email)
+        return
+
+    merged = existing.rename(contact.name).with_tags(*contact.tags)
+    if contact.phone is not None:
+        merged = merged.with_phone(contact.phone)
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(contact.email)

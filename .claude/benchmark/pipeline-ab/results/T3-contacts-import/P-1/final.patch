@@ -0,0 +1,671 @@
+import pytest
+
+from contactbook import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+BOM = "\N{ZERO WIDTH NO-BREAK SPACE}"
+
+
+def _where(issues: list[RowIssue]) -> list[tuple[int, str | None]]:
+    """``(row, column)`` of each issue, in report order."""
+    return [(issue.row, issue.column) for issue in issues]
+
+
+def test_import_creates_a_contact_per_row_and_reports_them_in_file_order():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        "name,email,phone,tags\n"
+        "Bob Stone,bob@example.com,,\n"
+        "Ann Lee,ann@example.com,+15551234567,vip\n",
+    )
+    assert report == ImportReport(
+        created=["bob@example.com", "ann@example.com"], updated=[], errors=[], warnings=[]
+    )
+    assert repo.all() == [
+        Contact(name="Bob Stone", email="bob@example.com"),
+        Contact(
+            name="Ann Lee",
+            email="ann@example.com",
+            phone="+15551234567",
+            tags=frozenset({"vip"}),
+        ),
+    ]
+
+
+def test_import_normalises_values_like_contacts_added_by_hand():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        "name,email,phone,tags\n"
+        '"  Ann   Lee ", Ann@Example.COM ,+1 (555) 123-4567,"vip; ;Key Account;"\n',
+    )
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"vip", "key-account"}),
+    )
+
+
+def test_import_matches_columns_by_name_ignoring_case_spaces_and_order():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        " Tags ,EMAIL, Phone,Name \n"
+        "lead,ann@example.com,5551234567,Ann Lee\n",
+    )
+    assert report.created == ["ann@example.com"]
+    assert repo.all() == [
+        Contact(
+            name="Ann Lee",
+            email="ann@example.com",
+            phone="5551234567",
+            tags=frozenset({"lead"}),
+        )
+    ]
+
+
+def test_import_without_phone_and_tags_columns_creates_contacts_without_them():

+"""CSV import of contacts.
+
+The file has the same columns as the CSV export. See ``import_contacts``.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from collections.abc import Callable
+from dataclasses import dataclass, field, replace
+from typing import TYPE_CHECKING
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import (
+    normalize_email,
+    normalize_optional_phone,
+    normalize_tags,
+    validate_name,
+)
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+    from _csv import Reader as CsvReader
+
+NAME_HALVES = ("first_name", "last_name")
+KNOWN_COLUMNS = frozenset({*EXPORT_COLUMNS, *NAME_HALVES})
+MAX_ROWS = 1000
+
+_BOM = "\N{ZERO WIDTH NO-BREAK SPACE}"
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row: ``row`` is the spreadsheet line number (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did. Emails are normalised and listed in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import a CSV file of contacts into ``repo`` and report what happened.
+
+    The whole file is read and checked before ``repo`` is touched, so an
+    ImportFileError always leaves the repository unchanged.
+    """
+    reader = csv.reader(io.StringIO(_decode(data)), strict=True)
+    try:
+        columns, header_width, header_warnings = _read_header(reader)
+        rows = list(_data_rows(reader))
+    except csv.Error as error:
+        raise ImportFileError(
+            f"the file is not valid CSV (line {reader.line_num}: {error})"
+        ) from None
+    if len(rows) > MAX_ROWS:
+        raise ImportFileError(
+            f"the file has {len(rows)} contact rows; split it into files of at most {MAX_ROWS}"
+        )
+
+    report = ImportReport(warnings=header_warnings)
+    claimed: dict[str, int] = {}
+    for row, cells in rows:
+        contact, errors, warnings = _read_contact(
+            row, cells, columns, header_width, claimed
+        )
+        report.errors.extend(errors)
+        report.warnings.extend(warnings)
+        if contact is None:
+            continue
+        _create_or_merge(repo, contact, report)
+    return report
+
+
+def _create_or_merge(
+    repo: InMemoryContactRepository, contact: Contact, report: ImportReport
+) -> None:
+    """Add a new contact, or merge into the stored one with the same email (ADR-0001).
+
+    A merge takes the file's name, takes the phone only if the row gave a valid
+    one (``contact.phone`` is None otherwise) and adds the file's tags. A merge
+    that changes nothing is not written and not reported.
+    """
+    existing = repo.find(contact.email)
+    if existing is None:
+        repo.add(contact)
+        report.created.append(contact.email)
+        return
+    merged = replace(
+        existing,
+        name=contact.name,
+        phone=contact.phone or existing.phone,
+        tags=existing.tags | contact.tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(contact.email)
+
+
+def _data_rows(reader: CsvReader) -> Iterator[tuple[int, list[str]]]:
+    """Yield ``(row, cells)`` for each non-blank row after the header.
+
+    ``row`` is the file line the row starts on. The csv reader's ``line_num``
+    is the line a record *ends* on, so a row starts one line after the
+    previous record ended. Blank rows are skipped but still count as lines.
+    """
+    start = reader.line_num + 1
+    for cells in reader:
+        if any(cell.strip() for cell in cells):
+            yield start, cells
+        start = reader.line_num + 1
+
+
+def _read_contact(
+    row: int,
+    cells: list[str],
+    columns: dict[str, int],
+    header_width: int,
+    claimed: dict[str, int],
+) -> tuple[Contact | None, list[RowIssue], list[RowIssue]]:
+    """Validate each field of a row on its own, so every bad field is reported.
+
+    ``claimed`` maps each normalised email to the first row that used it. A
+    row with a valid email claims it, even if the row has other errors; a later
+    row with that email is a row error.
+
+    Returns the contact (None if the row has errors), the row's errors and its
+    warnings. An invalid phone is only ever a warning: the row goes on as if no
+    phone had been given. A row with more cells than the header is a row error,
+    but its fields are still checked and its email still claimed.
+    """
+    errors: list[RowIssue] = []
+    warnings: list[RowIssue] = []
+    if len(cells) > header_width:
+        message = f"has {len(cells)} cells but the header has {header_width}"
+        errors.append(RowIssue(row, None, message))
+
+    def validated[T](validate: Callable[[], T], issues: list[RowIssue]) -> T | None:
+        """``validate()``, or None after recording its ValidationError in ``issues``."""
+        try:
+            return validate()
+        except ValidationError as error:
+            issues.append(RowIssue(row, error.field, error.message))
+            return None
+
+    name = validated(lambda: validate_name(_name_cell(cells, columns)), errors)
+    email = validated(lambda: normalize_email(_cell(cells, columns, "email")), errors)
+    phone = validated(
+        lambda: normalize_optional_phone(_cell(cells, columns, "phone")), warnings
+    )
+    tags = validated(
+        lambda: normalize_tags(_split_tags(_cell(cells, columns, "tags"))), errors
+    )
+    if email is not None:
+        first = claimed.setdefault(email, row)
+        if first != row:
+            errors.append(RowIssue(row, "email", f"same email as row {first}"))
+    if errors:
+        return None, errors, warnings
+    return Contact(name=name, email=email, phone=phone, tags=tags), errors, warnings
+
+
+def _name_cell(cells: list[str], columns: dict[str, int]) -> str:
+    """The ``name`` cell, or the ``first_name`` and ``last_name`` cells joined.
+
+    ``validate_name`` trims and collapses whitespace, so an empty half drops
+    out and the two halves end up separated by one space.
+    """
+    if "name" in columns:
+        return _cell(cells, columns, "name")
+    return " ".join(_cell(cells, columns, half) for half in NAME_HALVES)
+
+
+def _read_header(reader: CsvReader) -> tuple[dict[str, int], int, list[RowIssue]]:
+    """Map each normalised column name to its cell index, or raise ImportFileError.
+
+    Also returns the header's width in cells, and one warning per unknown
+    column, which is otherwise ignored. Blank header cells are ignored silently.
+    """
+    header = next(reader, [])
+    if not any(cell.strip() for cell in header):
+        raise ImportFileError("the file has no header row")
+    if len(header) == 1 and ";" in header[0]:
+        raise ImportFileError(
+            "the file looks semicolon-separated; export it as comma-separated CSV"
+        )
+    columns: dict[str, int] = {}
+    warnings: list[RowIssue] = []
+    for index, written in enumerate(header):
+        name = written.strip().lower()
+        if not name:
+            continue
+        if name in columns:
+            raise ImportFileError(f"the file has the {name!r} column twice")
+        columns[name] = index
+        if name not in KNOWN_COLUMNS:
+            warnings.append(RowIssue(row=1, column=written, message="unknown column, ignored"))
+    if "email" not in columns:
+        raise ImportFileError("the file has no 'email' column")
+    _check_name_columns(columns)
+    return columns, len(header), warnings
+
+
+def _check_name_columns(columns: dict[str, int]) -> None:
+    """The name comes from ``name`` or from both halves, never a mix of the two."""
+    halves = [half for half in NAME_HALVES if half in columns]
+    if "name" in columns and halves:
+        raise ImportFileError(
+            f"the file has both 'name' and {halves[0]!r} columns; give the name one way"
+        )
+    if "name" not in columns and not halves:
+        raise ImportFileError("the file has no 'name' column")
+    if len(halves) == 1:
+        missing = next(half for half in NAME_HALVES if half not in columns)
+        raise ImportFileError(
+            f"the file has a {halves[0]!r} column but no {missing!r} column"
+        )
+
+
+def _cell(cells: list[str], columns: dict[str, int], column: str) -> str:
+    """The row's cell for ``column``, or "" when the file has no such column
+    or the row is short of cells."""
+    index = columns.get(column)
+    return cells[index] if index is not None and index < len(cells) else ""
+
+
+def _decode(data: str | bytes) -> str:
+    """Return the file as text: bytes are UTF-8, and a leading BOM is dropped."""
+    if isinstance(data, bytes):
+        try:
+            data = data.decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; save it as "CSV UTF-8" and import it again'
+            ) from None
+    return data.removeprefix(_BOM)
+
+
+def _split_tags(cell: str) -> list[str]:
+    """The tags cell split on TAG_SEPARATOR, without empty or whitespace pieces.
+
+    The pieces are not trimmed here; ``normalize_tags`` does that.
+    """
+    return [piece for piece in cell.split(TAG_SEPARATOR) if piece.strip()]

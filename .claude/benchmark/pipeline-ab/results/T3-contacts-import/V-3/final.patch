@@ -0,0 +1,244 @@
+"""CSV import of contacts.
+
+Reads the format written by export.py: a header row naming the columns, then one
+contact per row with tags joined by TAG_SEPARATOR in a single cell. Instead of
+``name`` the file may have ``first_name`` and ``last_name`` columns (as written by
+the address-book export); the name is then the two joined with a space. Rows are
+matched to stored contacts by email: unknown emails are added, known ones are
+updated.
+
+Imports never remove data: a filled name or phone cell replaces the stored value,
+an empty phone cell keeps it, and tags from the file are added to the stored ones.
+
+Problems with single rows are collected in the report and the row is skipped;
+the rest of the file is still imported. Problems with the file as a whole raise
+ImportFileError before anything is stored.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+NAME_PARTS = ("first_name", "last_name")
+KNOWN_COLUMNS = (*EXPORT_COLUMNS, *NAME_PARTS)
+HEADER_ROW = 1
+
+
+@dataclass
+class RowIssue:
+    """A problem found in one row.
+
+    ``row`` is the row number as a spreadsheet shows it: the header is row 1,
+    the first contact row 2. ``column`` is the header name the issue is about,
+    or None when it concerns the row as a whole.
+    """
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did. Emails are normalised, in file order.
+
+    Rows that match a stored contact without changing it appear in neither
+    ``created`` nor ``updated``. Rows listed in ``errors`` were skipped;
+    ``warnings`` did not stop anything from being imported.
+    """
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _Row:
+    """A validated row. ``None`` for phone or tags means the cell was empty."""
+
+    number: int
+    name: str
+    email: str
+    phone: str | None
+    tags: frozenset[str] | None
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import contacts from CSV content into ``repo`` and report the outcome.
+
+    ``data`` is the file content, either raw bytes (UTF-8, with or without a
+    byte order mark) or already decoded text. Raises ImportFileError if the file
+    can't be read or its header doesn't say where names and emails are; in that case
+    the repository is left untouched.
+    """
+    records = _read_records(_decode(data))
+    if not any(_has_content(cells) for cells in records):
+        raise ImportFileError("the file is empty")
+
+    report = ImportReport()
+    columns = _read_header(records[0], report)
+    width = len(records[0])
+
+    rows: list[_Row] = []
+    first_seen: dict[str, int] = {}
+    for number, cells in enumerate(records[1:], start=HEADER_ROW + 1):
+        if not _has_content(cells):
+            continue
+        row = _parse_row(number, cells, columns, width, first_seen, report)
+        if row is not None:
+            rows.append(row)
+
+    for row in rows:
+        _apply(repo, row, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, str):
+        return data.removeprefix("\ufeff")
+    if not isinstance(data, bytes | bytearray):
+        raise TypeError(f"expected str or bytes, got {type(data).__name__}")
+    try:
+        return bytes(data).decode("utf-8-sig")
+    except UnicodeDecodeError as exc:
+        raise ImportFileError(
+            f"the file is not UTF-8 text (invalid byte at position {exc.start}); "
+            "save it from the spreadsheet as 'CSV UTF-8'"
+        ) from None
+
+
+def _read_records(text: str) -> list[list[str]]:
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        return list(reader)
+    except csv.Error as exc:
+        raise ImportFileError(f"not a valid CSV file (line {reader.line_num}): {exc}") from None
+
+
+def _read_header(cells: Sequence[str], report: ImportReport) -> dict[str, int]:
+    """Map known column names to their index; warn about unknown ones."""
+    columns: dict[str, int] = {}
+    for index, cell in enumerate(cells):
+        column = cell.strip().lower()
+        if not column:
+            continue
+        if column in columns:
+            if column in KNOWN_COLUMNS:
+                raise ImportFileError(f"column {column!r} appears more than once in the header")
+            continue
+        columns[column] = index
+        if column not in KNOWN_COLUMNS:
+            report.warnings.append(
+                RowIssue(HEADER_ROW, cell.strip(), "unknown column; its values are ignored")
+            )
+
+    parts = [column for column in NAME_PARTS if column in columns]
+    if "name" in columns and parts:
+        raise ImportFileError(
+            f"the header row has both name and {' and '.join(parts)}; "
+            "keep either name or first_name and last_name"
+        )
+    if len(parts) == 1:
+        (other,) = set(NAME_PARTS) - set(parts)
+        raise ImportFileError(f"the header row has {parts[0]} but no {other} column")
+    missing = [column for column in ("name", "email") if column not in columns]
+    if parts:
+        missing.remove("name")
+    if missing:
+        raise ImportFileError(
+            f"the header row has no {' or '.join(missing)} column "
+            f"(expected {','.join(EXPORT_COLUMNS)}, or first_name,last_name instead of name; "
+            f"found {','.join(cells)!r})"
+        )
+    return {column: index for column, index in columns.items() if column in KNOWN_COLUMNS}
+
+
+def _parse_row(
+    number: int,
+    cells: Sequence[str],
+    columns: dict[str, int],
+    width: int,
+    first_seen: dict[str, int],
+    report: ImportReport,
+) -> _Row | None:
+    """Validate one row; record its problems in ``report`` and return None if any."""
+    used = max(i for i, cell in enumerate(cells) if cell.strip()) + 1
+    if used > width:
+        # Usually an unquoted comma inside a value, which shifts every later cell.
+        report.errors.append(
+            RowIssue(number, None, f"has {used} values but the header has {width} columns")
+        )
+        return None
+
+    issues: list[RowIssue] = []
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    def check[T](column: str, normalise: Callable[[str], T], raw: str) -> T | None:
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            issues.append(RowIssue(number, column, exc.message))
+            return None
+
+    if "name" in columns:
+        raw_name = cell("name")
+    else:
+        raw_name = " ".join(cell(part).strip() for part in NAME_PARTS)
+    name = check("name", validate_name, raw_name)
+    email = check("email", normalize_email, cell("email"))
+    if email is not None:
+        if email in first_seen:
+            issues.append(
+                RowIssue(number, "email", f"duplicate of row {first_seen[email]}; row skipped")
+            )
+        else:
+            first_seen[email] = number
+
+    phone = None
+    if cell("phone").strip():
+        phone = check("phone", normalize_phone, cell("phone"))
+
+    tags = None
+    raw_tags = [tag for tag in cell("tags").split(TAG_SEPARATOR) if tag.strip()]
+    if raw_tags:
+        tags = frozenset(check("tags", normalize_tag, tag) for tag in raw_tags)
+
+    if issues:
+        report.errors.extend(issues)
+        return None
+    assert name is not None and email is not None
+    return _Row(number, name, email, phone, tags)
+
+
+def _apply(repo: InMemoryContactRepository, row: _Row, report: ImportReport) -> None:
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(Contact(row.name, row.email, row.phone, row.tags or frozenset()))
+        report.created.append(row.email)
+        return
+    changed = replace(
+        existing,
+        name=row.name,
+        phone=row.phone if row.phone is not None else existing.phone,
+        tags=existing.tags | (row.tags or frozenset()),
+    )
+    if changed != existing:
+        repo.update(changed)
+        report.updated.append(row.email)
+
+
+def _has_content(cells: Sequence[str]) -> bool:
+    return any(cell.strip() for cell in cells)

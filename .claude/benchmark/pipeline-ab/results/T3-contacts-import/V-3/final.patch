@@ -0,0 +1,185 @@
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def ann(**overrides):
+    fields = {"name": "Ann Lee", "email": "ann@example.com"}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def test_new_rows_are_created_with_normalised_values():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + " Ann  Lee ,Ann@Example.COM,+1 (555) 123-4567,VIP; Key Account\n"
+    )
+    assert report == ImportReport(created=["ann@example.com"])
+    assert repo.get("ann@example.com") == Contact(
+        "Ann Lee", "ann@example.com", "+15551234567", frozenset({"vip", "key-account"})
+    )
+
+
+def test_export_round_trips():
+    contacts = [ann(phone="+15551234567", tags=["vip", "lead"]), ann(email="bob@example.com")]
+    repo = InMemoryContactRepository()
+    import_contacts(repo, export_csv(contacts))
+    assert repo.all() == contacts
+
+
+def test_reimporting_own_export_changes_nothing():
+    repo = InMemoryContactRepository([ann(tags=["vip"])])
+    report = import_contacts(repo, export_csv(repo.all()))
+    assert report == ImportReport()
+
+
+def test_existing_contact_is_updated_by_email_ignoring_case():
+    repo = InMemoryContactRepository([ann(phone="5551234567")])
+    report = import_contacts(repo, HEADER + "Ann Smith,ANN@example.com,5559876543,\n")
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == ann(name="Ann Smith", phone="5559876543")
+
+
+def test_tags_are_added_to_stored_tags_never_removed():
+    repo = InMemoryContactRepository([ann(tags=["vip", "partner"])])
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,,Lead;VIP\n")
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").tags == {"vip", "partner", "lead"}
+
+
+def test_tags_already_stored_are_not_an_update():
+    repo = InMemoryContactRepository([ann(tags=["vip", "partner"])])
+    assert import_contacts(repo, HEADER + "Ann Lee,ann@example.com,,vip\n") == ImportReport()
+
+
+def test_empty_phone_and_tags_cells_keep_stored_values():
+    repo = InMemoryContactRepository([ann(phone="5551234567", tags=["vip"])])
+    import_contacts(repo, HEADER + "Ann Smith,ann@example.com,,\n")
+    assert repo.get("ann@example.com") == ann(name="Ann Smith", phone="5551234567", tags=["vip"])
+
+
+def test_optional_columns_may_be_missing_and_order_does_not_matter():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, " Email ,NAME\nann@example.com,Ann Lee\n")
+    assert report.created == ["ann@example.com"]
+
+
+def test_first_and_last_name_columns_are_joined_into_name():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        "email,First_Name,last_name\n"
+        "ann@example.com, Ann , Lee \n"
+        "bob@example.com,Bob,\n"
+        "cat@example.com,,\n",
+    )
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+    assert repo.get("bob@example.com").name == "Bob"
+    assert report.errors == [RowIssue(4, "name", "is required")]
+
+
+def test_name_problem_in_first_and_last_name_file_is_reported_under_name():
+    long_last_name = "x" * 100
+    report = import_contacts(
+        InMemoryContactRepository(),
+        f"first_name,last_name,email\nAnn,{long_last_name},ann@example.com\n",
+    )
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name")]
+
+
+def test_bad_rows_are_reported_and_skipped_while_good_rows_import():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        HEADER
+        + "Ann Lee,ann@example.com,,\n"
+        + ",not-an-email,12,bad!tag\n"
+        + "Bob,bob@example.com,,\n",
+    )
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [
+        (3, "name"),
+        (3, "email"),
+        (3, "phone"),
+        (3, "tags"),
+    ]
+    assert len(repo) == 2
+
+
+def test_duplicate_email_in_file_keeps_first_row():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "Ann Lee,ann@example.com,,\nAnn Smith,ANN@example.com,,\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [RowIssue(3, "email", "duplicate of row 2; row skipped")]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_row_numbers_count_spreadsheet_rows_not_lines():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + '"Ann\nLee",ann@example.com,,\n,,,\nBob,bob,,\n'
+    )
+    assert repo.get("ann@example.com").name == "Ann Lee"
+    assert [e.row for e in report.errors] == [4]
+
+
+def test_row_with_more_values_than_columns_is_rejected():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "Lee, Ann,ann@example.com,5551234567,vip\nBob,bob@example.com,,,,\n"
+    )
+    assert report.errors == [RowIssue(2, None, "has 5 values but the header has 4 columns")]
+    assert report.created == ["bob@example.com"]
+
+
+def test_unknown_column_is_a_warning():
+    report = import_contacts(
+        InMemoryContactRepository(), "name,email,Company\nAnn,ann@example.com,Acme\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == [RowIssue(1, "Company", "unknown column; its values are ignored")]
+
+
+def test_bytes_with_bom_and_crlf_are_accepted():
+    data = "\ufeffname,email\r\nZoë,zoe@example.com\r\n".encode("utf-8")
+    repo = InMemoryContactRepository()
+    import_contacts(repo, data)
+    assert repo.get("zoe@example.com").name == "Zoë"
+
+
+def test_non_utf8_bytes_fail_the_whole_file():
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), "name,email\nZoë,z@x.io\n".encode("cp1252"))
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "",
+        "\n\n",
+        "phone,tags\n1234567,vip\n",
+        "name;email\nAnn;ann@example.com\n",
+        "name,email,email\n",
+        "first_name,email\n",
+        "name,first_name,last_name,email\n",
+        "first_name,last_name,last_name,email\n",
+    ],
+)
+def test_unusable_file_raises_and_imports_nothing(data):
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, data + "Ann,ann@example.com\n")
+    assert len(repo) == 0
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)

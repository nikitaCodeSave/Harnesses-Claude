@@ -0,0 +1,79 @@
+"""SPEC.md acceptance criteria 39-41: created vs. updated."""
+
+from contactbook.models import Contact
+from contactbook.service import ContactBook
+from support import (
+    HEADER,
+    ann,
+    assert_clean,
+    csv_text,
+    make_repo,
+    run_import,
+)
+
+# 39. new email creates
+
+
+def test_c39_new_email_creates_a_contact():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text(HEADER, "Bob Stone,bob@example.com,+1 555 222 3333,vip"))
+
+    assert_clean(report)
+    assert report.created == ["bob@example.com"]
+    assert report.updated == []
+    assert len(repo) == 2
+    assert repo.get("bob@example.com") == Contact.create("Bob Stone", "bob@example.com", "+15552223333", ["vip"])
+
+
+# 40. existing email updates
+
+
+def test_c40_existing_email_updates_without_creating_a_second_contact():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text(HEADER, "Ann Renamed,ANN@EXAMPLE.COM,,vip"))
+
+    assert_clean(report)
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert len(repo) == 1
+    assert repo.get("ann@example.com") == Contact.create("Ann Renamed", "ann@example.com", "+15551234567", ["lead", "vip"])
+
+
+def test_c40_row_that_changes_nothing_is_not_created_and_not_an_error():
+    existing = ann()
+    repo = make_repo(existing)
+    report = run_import(repo, csv_text(HEADER, "Ann Lee,ann@example.com,+1 555 123 4567,lead"))
+
+    assert_clean(report)
+    assert report.created == []
+    assert report.updated in ([], ["ann@example.com"])
+    assert repo.all() == [existing]
+
+
+# 41. stored values normalised like ContactBook.add
+
+
+def test_c41_stored_values_match_contact_book_add():
+    raw = dict(name="  Ann   Lee ", email=" Ann.Lee@Example.COM ", phone="+1 (555) 123-4567")
+    raw_tags = ["Key Account", "VIP", "vip"]
+    expected = ContactBook().add(raw["name"], raw["email"], raw["phone"], raw_tags)
+
+    repo = make_repo()
+    row = f'"{raw["name"]}",{raw["email"]},{raw["phone"]},{";".join(raw_tags)}'
+    report = run_import(repo, csv_text(HEADER, row))
+
+    assert_clean(report)
+    assert repo.all() == [expected]
+    assert expected == Contact("Ann Lee", "ann.lee@example.com", "+15551234567", frozenset({"key-account", "vip"}))
+
+
+def test_c41_updated_values_match_contact_book_normalisation():
+    repo = make_repo(Contact.create("Ann Lee", "ann@example.com"))
+    report = run_import(repo, csv_text(HEADER, "  Annie   Lee ,ann@example.com, 555 999 0000 ,Key Account"))
+
+    assert_clean(report)
+    book = ContactBook(make_repo(Contact.create("Ann Lee", "ann@example.com")))
+    book.rename("ann@example.com", "  Annie   Lee ")
+    book.set_phone("ann@example.com", " 555 999 0000 ")
+    expected = book.tag("ann@example.com", "Key Account")
+    assert repo.get("ann@example.com") == expected

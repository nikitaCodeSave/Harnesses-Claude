@@ -0,0 +1,182 @@
+"""SPEC.md acceptance criteria 1-6: input and encoding."""
+
+import pytest
+
+from contactbook.models import Contact
+from support import (
+    HEADER,
+    ann,
+    assert_clean,
+    assert_file_error,
+    assert_row_error,
+    csv_text,
+    error_rows,
+    make_repo,
+    run_import,
+    snapshot,
+)
+
+MIXED = csv_text(
+    HEADER,
+    "José Müller,jose@example.com,+49 30 1234567,kunde",
+    "Ann Lee,ANN@example.com,,vip",
+    "",
+    "Bad Email,not-an-email,,",
+    "Bad Phone,phone@example.com,call me,",
+)
+
+
+# 1. bytes or str, same result
+
+
+def test_c01_bytes_and_str_give_the_same_result():
+    repo_text, repo_bytes = make_repo(ann()), make_repo(ann())
+
+    report_text = run_import(repo_text, MIXED)
+    report_bytes = run_import(repo_bytes, MIXED.encode("utf-8"))
+
+    assert report_text == report_bytes
+    assert snapshot(repo_text) == snapshot(repo_bytes)
+    assert report_text.created == ["jose@example.com", "phone@example.com"]
+    assert error_rows(report_text) == {5}
+
+
+# 2. bytes are UTF-8, leading BOM ignored
+
+
+def test_c02_bytes_are_decoded_as_utf8():
+    repo = make_repo()
+    data = csv_text("name,email", "José Müller,jose@example.com").encode("utf-8")
+
+    report = run_import(repo, data)
+
+    assert report.created == ["jose@example.com"]
+    assert repo.get("jose@example.com").name == "José Müller"
+
+
+@pytest.mark.parametrize("header", ["name,email,phone,tags", "email,name"])
+def test_c02_leading_utf8_bom_in_bytes_is_ignored(header):
+    repo = make_repo()
+    row = "Ann Lee,ann@example.com,," if header.startswith("name") else "ann@example.com,Ann Lee"
+    data = b"\xef\xbb\xbf" + csv_text(header, row).encode("utf-8")
+
+    report = run_import(repo, data)
+
+    assert_clean(report)
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# 3. str starting with the BOM character
+
+
+@pytest.mark.parametrize("header", ["name,email,phone,tags", "email,name"])
+def test_c03_str_with_leading_bom_character_is_handled_as_without_it(header):
+    repo = make_repo()
+    row = "Ann Lee,ann@example.com,," if header.startswith("name") else "ann@example.com,Ann Lee"
+    data = "﻿" + csv_text(header, row)
+
+    report = run_import(repo, data)
+
+    assert_clean(report)
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# 4. invalid UTF-8 bytes
+
+
+def test_c04_invalid_utf8_raises_import_file_error_mentioning_csv_utf8():
+    data = csv_text("name,email", "José Müller,jose@example.com").encode("latin-1")
+
+    error = assert_file_error(make_repo(), data)
+
+    assert "CSV UTF-8" in str(error)
+
+
+def test_c04_invalid_utf8_late_in_file_applies_nothing():
+    repo = make_repo(ann())
+    data = (
+        csv_text(HEADER, "Ann Renamed,ann@example.com,,vip", "Bob Stone,bob@example.com,,").encode("utf-8")
+        + b"Ren\xe9 Roy,rene@example.com,,\n"
+    )
+
+    error = assert_file_error(repo, data)
+
+    assert "CSV UTF-8" in str(error)
+
+
+# 5. comma delimiter, standard CSV quoting
+
+
+def test_c05_quoted_field_may_contain_a_comma():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, '"Lee, Ann",ann@example.com,,'))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").name == "Lee, Ann"
+
+
+def test_c05_quoted_field_may_contain_a_semicolon():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, '"Ann; Lee",ann@example.com,,"vip;lead"'))
+
+    assert_clean(report)
+    stored = repo.get("ann@example.com")
+    assert stored.name == "Ann; Lee"
+    assert stored.tags == {"vip", "lead"}
+
+
+def test_c05_quoted_field_may_contain_doubled_quotes():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, '"Ann ""Annie"" Lee",ann@example.com,,'))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").name == 'Ann "Annie" Lee'
+
+
+def test_c05_quoted_field_may_contain_a_line_break():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, '"Ann', 'Lee",ann@example.com,,', "Bob Stone,bob@example.com,,"))
+
+    assert_clean(report)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    # The name validator collapses the inner line break into one space (criterion 29).
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# 6. \n and \r\n line endings
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n"])
+def test_c06_line_endings(newline):
+    repo = make_repo()
+    data = csv_text(
+        HEADER,
+        "Ann Lee,ann@example.com,+1 555 123 4567,vip",
+        "",
+        "Bad,not-an-email,,",
+        "Bob Stone,bob@example.com,,lead",
+        newline=newline,
+    )
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert error_rows(report) == {4}
+    assert_row_error(report, 4, "email")
+    assert report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip"])
+    assert repo.get("bob@example.com") == Contact.create("Bob Stone", "bob@example.com", None, ["lead"])
+
+
+def test_c06_crlf_with_multiline_quoted_field():
+    repo = make_repo()
+    data = csv_text(HEADER, '"Ann', 'Lee",ann@example.com,,vip', "Bad,not-an-email,,", newline="\r\n")
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert error_rows(report) == {4}
+    assert repo.get("ann@example.com").name == "Ann Lee"
+    assert repo.get("ann@example.com").tags == {"vip"}

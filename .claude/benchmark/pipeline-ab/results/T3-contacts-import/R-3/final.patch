+"""SPEC.md acceptance criteria 42-43: round trip with export_csv."""
+
+import pytest
+
+from contactbook.export import export_csv
+from contactbook.models import Contact
+from support import assert_clean, make_repo, run_import, snapshot
+
+CONTACTS = [
+    Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["lead", "vip"]),
+    Contact.create("Bob Stone", "bob@example.com"),
+    Contact.create('Lee, "Cy" Young', "cy@example.com", "5559990000", ["key-account"]),
+    Contact.create("José Müller; GmbH", "jose@example.de", None, ["kunde", "dach", "q3"]),
+]
+
+
+# 42. export -> import into an empty repository
+
+
+@pytest.mark.parametrize("as_bytes", [False, True], ids=["str", "bytes"])
+def test_c42_import_of_export_into_empty_repo_reproduces_the_contacts(as_bytes):
+    exported = export_csv(CONTACTS)
+    data = exported.encode("utf-8") if as_bytes else exported
+    repo = make_repo()
+
+    report = run_import(repo, data)
+
+    assert_clean(report)
+    assert report.created == [c.email for c in CONTACTS]
+    assert report.updated == []
+    assert len(repo) == len(CONTACTS)
+    for contact in CONTACTS:
+        assert repo.get(contact.email) == contact
+
+
+# 43. export -> import back into the same repository
+
+
+def test_c43_import_of_export_into_the_same_repo_changes_nothing():
+    repo = make_repo(*CONTACTS)
+    before = snapshot(repo)
+
+    report = run_import(repo, export_csv(repo.all()))
+
+    assert report.created == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert snapshot(repo) == before

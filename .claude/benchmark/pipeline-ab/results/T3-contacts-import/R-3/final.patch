@@ -0,0 +1,161 @@
+"""SPEC.md acceptance criteria 19-21 and 24, and the "Row number" term.
+
+Rows with more or fewer cells than the header (criteria 22-23) are deliberately
+not tested: any handling is acceptable.
+"""
+
+from contactbook.models import Contact
+from support import (
+    HEADER,
+    ann,
+    assert_row_error,
+    csv_text,
+    error_rows,
+    make_repo,
+    run_import,
+)
+
+# Row number (Terms): physical lines, header is row 1.
+
+
+def test_row_numbers_are_physical_line_numbers():
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,,", "Bad One,not-an-email,,", "Bob Stone,bob@example.com,,", ",,,", "Bad Two,also-bad,,")
+    report = run_import(make_repo(), data)
+
+    assert error_rows(report) == {3, 6}
+
+
+def test_multiline_record_gets_the_number_of_its_first_line_and_later_rows_keep_counting():
+    data = csv_text(
+        HEADER,
+        '"Ann',
+        'Lee",not-an-email,,',
+        "Bob Stone,bob@example.com,,",
+        '"Cy',
+        "",
+        'Young",cy@example.com,,',
+        "Bad,still-bad,,",
+    )
+    report = run_import(make_repo(), data)
+
+    assert report.created == ["bob@example.com", "cy@example.com"]
+    assert error_rows(report) == {2, 8}
+    assert_row_error(report, 2, "email")
+    assert_row_error(report, 8, "email")
+
+
+# 19. blank rows skipped silently but counted
+
+
+def test_c19_blank_rows_are_skipped_and_still_counted():
+    repo = make_repo()
+    data = csv_text(HEADER, "", "Ann Lee,ann@example.com,,", "   ", ",,,", " ,\t, , ", "Bad,not-an-email,,", "")
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.updated == []
+    assert report.warnings == []
+    assert error_rows(report) == {7}
+    assert_row_error(report, 7, "email")
+    assert len(repo) == 1
+
+
+# 20. rows are independent; an error row is not applied at all
+
+
+def test_c20_error_row_does_not_touch_the_matching_existing_contact():
+    existing = ann()
+    repo = make_repo(existing)
+    data = csv_text(
+        HEADER,
+        "Ann Renamed,ANN@example.com,+1 555 999 0000,vip;bad!tag",
+        "Bob Stone,bob@example.com,,",
+    )
+
+    report = run_import(repo, data)
+
+    assert_row_error(report, 2, "tags")
+    assert repo.get("ann@example.com") == existing
+    assert report.created == ["bob@example.com"]
+    assert "ann@example.com" not in report.updated
+
+
+def test_c20_name_error_on_existing_contact_changes_nothing():
+    existing = ann()
+    repo = make_repo(existing)
+    data = csv_text(HEADER, "   ,ann@example.com,+1 555 999 0000,vip", "Cy Young,cy@example.com,,")
+
+    report = run_import(repo, data)
+
+    assert_row_error(report, 2, "name")
+    assert repo.get("ann@example.com") == existing
+    assert report.created == ["cy@example.com"]
+    assert report.updated == []
+
+
+def test_c20_other_rows_still_applied_around_error_rows():
+    repo = make_repo()
+    data = csv_text(HEADER, "Bad,nope,,", "Ann Lee,ann@example.com,,", "Bad,,,", "Bob Stone,bob@example.com,,")
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert error_rows(report) == {2, 4}
+    assert len(repo) == 2
+
+
+# 21. every rejected row has an error with its row number
+
+
+def test_c21_every_rejected_row_is_reported_with_its_row_number():
+    repo = make_repo(ann())
+    data = csv_text(
+        HEADER,
+        "Good One,one@example.com,,",  # 2 applied
+        ",two@example.com,,",  # 3 name
+        "Three,,,",  # 4 email
+        "Four,four@example.com,,bad!",  # 5 tags
+        f"{'F' * 101},five@example.com,,",  # 6 name too long
+        "Good Again,ONE@example.com,,",  # 7 duplicate email
+        "Ann Lee,ann@example.com,,vip",  # 8 applied (update)
+    )
+
+    report = run_import(repo, data)
+
+    assert error_rows(report) == {3, 4, 5, 6, 7}
+    assert_row_error(report, 3, "name")
+    assert_row_error(report, 4, "email")
+    assert_row_error(report, 5, "tags")
+    assert_row_error(report, 6, "name")
+    assert_row_error(report, 7, "email")
+    assert report.created == ["one@example.com"]
+    assert report.updated == ["ann@example.com"]
+    assert report.warnings == []
+
+
+# 24. created / updated hold normalised emails in file order, each once
+
+
+def test_c24_created_and_updated_hold_normalised_emails_in_file_order():
+    repo = make_repo(
+        Contact.create("Bob Stone", "bob@example.com"),
+        Contact.create("Dee Park", "dee@example.com"),
+    )
+    data = csv_text(
+        HEADER,
+        "Cy Young,  Cy@Example.COM ,,",
+        "Dee Park,DEE@example.com,,vip",
+        "Ann Lee, ann@EXAMPLE.com,,",
+        "Bob Stone,Bob@Example.com,,vip",
+        "Ann Again,ann@example.com,,",
+    )
+
+    report = run_import(repo, data)
+
+    assert report.created == ["cy@example.com", "ann@example.com"]
+    assert report.updated == ["dee@example.com", "bob@example.com"]
+    every = report.created + report.updated
+    assert len(every) == len(set(every))
+    assert_row_error(report, 6, "email")
+    assert len(repo) == 4

+"""Shared helpers for the CSV import acceptance tests (SPEC.md).
+
+The importer is imported lazily, inside each call, so that while the feature is
+missing every test fails on its own instead of the whole module failing to collect.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from contactbook.errors import ContactError
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+
+
+def run_import(repo: InMemoryContactRepository, data: str | bytes):
+    from contactbook.importer import import_contacts
+
+    return import_contacts(repo, data)
+
+
+def import_file_error_class() -> type[Exception]:
+    from contactbook.errors import ImportFileError
+
+    return ImportFileError
+
+
+def csv_text(*lines: str, newline: str = "\n") -> str:
+    """Join physical lines into file content, with a trailing line break."""
+    return newline.join(lines) + newline
+
+
+def make_repo(*contacts: Contact) -> InMemoryContactRepository:
+    return InMemoryContactRepository(contacts)
+
+
+def ann(**overrides) -> Contact:
+    values = dict(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["lead"])
+    values.update(overrides)
+    return Contact.create(**values)
+
+
+def snapshot(repo: InMemoryContactRepository) -> list[tuple]:
+    return [(c.name, c.email, c.phone, c.tags) for c in repo.all()]
+
+
+def assert_file_error(repo: InMemoryContactRepository, data: str | bytes) -> Exception:
+    """The import raises ImportFileError and leaves the repository as it was (criterion 18)."""
+    error_class = import_file_error_class()
+    assert issubclass(error_class, ContactError)
+    before = snapshot(repo)
+    with pytest.raises(error_class) as info:
+        run_import(repo, data)
+    assert snapshot(repo) == before
+    return info.value
+
+
+def error_rows(report) -> set[int]:
+    return {issue.row for issue in report.errors}
+
+
+def warning_rows(report) -> set[int]:
+    return {issue.row for issue in report.warnings}
+
+
+def assert_row_error(report, row: int, column: str | None) -> None:
+    """Row ``row`` was rejected with at least one issue on ``column`` (criterion 21)."""
+    issues = [issue for issue in report.errors if issue.row == row]
+    assert issues, f"expected an error for row {row}, got {report.errors!r}"
+    assert any(issue.column == column for issue in issues), (
+        f"expected an error on column {column!r} for row {row}, got {issues!r}"
+    )
+
+
+def assert_clean(report) -> None:
+    assert report.errors == []
+    assert report.warnings == []

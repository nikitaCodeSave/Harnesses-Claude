+"""SPEC.md acceptance criteria 32-35: phone."""
+
+import pytest
+
+from contactbook.models import Contact
+from support import (
+    HEADER,
+    ann,
+    assert_clean,
+    assert_row_error,
+    csv_text,
+    error_rows,
+    make_repo,
+    run_import,
+    warning_rows,
+)
+
+# 32. valid phone is normalised; replaces stored phone
+
+
+def test_c32_new_contact_gets_the_normalised_phone():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, "Ann Lee,ann@example.com,+1 (555) 123-4567,"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+def test_c32_valid_phone_replaces_the_stored_phone():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text(HEADER, "Ann Lee,ann@example.com,555.999.0000,"))
+
+    assert_clean(report)
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").phone == "5559990000"
+
+
+# 33. empty phone cell / no phone column keeps the stored phone
+
+
+def test_c33_empty_phone_cell_keeps_the_stored_phone():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text(HEADER, "Ann Renamed,ann@example.com,,"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+def test_c33_missing_phone_column_keeps_the_stored_phone():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text("name,email,tags", "Ann Renamed,ann@example.com,"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+@pytest.mark.parametrize(
+    ("header", "row"),
+    [(HEADER, "Bob Stone,bob@example.com,,"), ("name,email", "Bob Stone,bob@example.com")],
+)
+def test_c33_new_contact_without_phone_has_none(header, row):
+    repo = make_repo()
+    report = run_import(repo, csv_text(header, row))
+
+    assert_clean(report)
+    assert repo.get("bob@example.com").phone is None
+
+
+# 34. invalid phone is a warning; rest of the row applied
+
+
+@pytest.mark.parametrize("phone", ["call me", "12345", "+1 555 123 4567 8901 23", "555-CALL-NOW"])
+def test_c34_invalid_phone_on_new_contact_creates_it_without_phone(phone):
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, f"Bob Stone,bob@example.com,{phone},vip"))
+
+    assert report.errors == []
+    assert report.created == ["bob@example.com"]
+    assert {(w.row, w.column) for w in report.warnings} == {(2, "phone")}
+    assert repo.get("bob@example.com") == Contact.create("Bob Stone", "bob@example.com", None, ["vip"])
+
+
+def test_c34_invalid_phone_on_existing_contact_updates_the_rest_and_keeps_phone():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text(HEADER, "Ann Renamed,ann@example.com,not a phone,vip"))
+
+    assert report.errors == []
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert {(w.row, w.column) for w in report.warnings} == {(2, "phone")}
+    assert repo.get("ann@example.com") == Contact.create("Ann Renamed", "ann@example.com", "+15551234567", ["lead", "vip"])
+
+
+def test_c34_warning_carries_the_physical_row_number():
+    repo = make_repo()
+    data = csv_text(HEADER, "", "Ann Lee,ann@example.com,,", '"Bob', 'Stone",bob@example.com,123,')
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert {(w.row, w.column) for w in report.warnings} == {(4, "phone")}
+
+
+# 35. phone failure is the only cause of warnings
+
+
+def test_c35_only_phone_failures_produce_warnings():
+    repo = make_repo(ann())
+    data = csv_text(
+        HEADER,
+        "Bob Stone,bob@example.com,+1 555 123 4567,vip",  # 2 clean create
+        ",cy@example.com,,",  # 3 name error
+        "Dee Park,not-an-email,,",  # 4 email error
+        "Eve Moss,eve@example.com,,bad!",  # 5 tags error
+        f"{'F' * 101},fay@example.com,,",  # 6 name too long
+        "Bob Again,bob@example.com,,",  # 7 duplicate
+        "Gus Hart,gus@example.com,nope,",  # 8 phone warning
+        "Ann Lee,ann@example.com,,",  # 9 unchanged existing contact
+        "",  # 10 blank
+        "Hal Ito,hal@example.com,,",  # 11 clean create
+    )
+
+    report = run_import(repo, data)
+
+    assert error_rows(report) == {3, 4, 5, 6, 7}
+    assert warning_rows(report) == {8}
+    assert all(w.column == "phone" for w in report.warnings)
+    assert report.created == ["bob@example.com", "gus@example.com", "hal@example.com"]
+    assert_row_error(report, 7, "email")

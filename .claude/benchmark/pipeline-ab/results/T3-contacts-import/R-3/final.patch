@@ -0,0 +1,109 @@
+"""SPEC.md acceptance criteria 36-38: tags."""
+
+import pytest
+
+from support import (
+    HEADER,
+    ann,
+    assert_clean,
+    assert_row_error,
+    csv_text,
+    error_rows,
+    make_repo,
+    run_import,
+)
+
+# 36. split on ";", normalised, empties and repeats ignored
+
+
+def test_c36_tags_are_split_on_semicolon_and_normalised():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,VIP; Key Account ;lead"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").tags == {"vip", "key-account", "lead"}
+
+
+def test_c36_empty_pieces_and_repeats_are_ignored():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,;vip;;VIP; ;vip ;"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").tags == {"vip"}
+
+
+@pytest.mark.parametrize("cell", [";", ";;", " ; ; "])
+def test_c36_only_empty_pieces_mean_no_tags(cell):
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, f"Ann Lee,ann@example.com,,{cell}"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").tags == frozenset()
+
+
+# 37. any invalid tag rejects the row
+
+
+@pytest.mark.parametrize("cell", ["vip;bad!tag", "vip;" + "x" * 33, "под-ключ", "vip;-lead"])
+def test_c37_invalid_tag_rejects_the_whole_row(cell):
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, f"Ann Lee,ann@example.com,,{cell}"))
+
+    assert error_rows(report) == {2}
+    assert_row_error(report, 2, "tags")
+    assert report.created == []
+    assert len(repo) == 0
+
+
+def test_c37_invalid_tag_leaves_existing_contact_untouched():
+    existing = ann()
+    repo = make_repo(existing)
+    report = run_import(repo, csv_text(HEADER, "Ann Renamed,ann@example.com,+1 555 999 0000,vip;no good!"))
+
+    assert_row_error(report, 2, "tags")
+    assert report.updated == []
+    assert repo.get("ann@example.com") == existing
+
+
+def test_c37_tag_of_32_characters_is_accepted():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, f"Ann Lee,ann@example.com,,{'x' * 32}"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").tags == {"x" * 32}
+
+
+# 38. tags are added, never removed
+
+
+def test_c38_file_tags_are_added_to_stored_tags():
+    repo = make_repo(ann(tags=["lead", "partner"]))
+    report = run_import(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,VIP;lead"))
+
+    assert_clean(report)
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").tags == {"lead", "partner", "vip"}
+
+
+def test_c38_empty_tags_cell_keeps_stored_tags():
+    repo = make_repo(ann(tags=["lead", "partner"]))
+    report = run_import(repo, csv_text(HEADER, "Ann Renamed,ann@example.com,,"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").tags == {"lead", "partner"}
+
+
+def test_c38_missing_tags_column_keeps_stored_tags():
+    repo = make_repo(ann(tags=["lead", "partner"]))
+    report = run_import(repo, csv_text("name,email,phone", "Ann Renamed,ann@example.com,"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").tags == {"lead", "partner"}
+
+
+def test_c38_subset_of_stored_tags_removes_nothing():
+    repo = make_repo(ann(tags=["lead", "partner"]))
+    report = run_import(repo, csv_text(HEADER, "Ann Renamed,ann@example.com,,partner"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").tags == {"lead", "partner"}
diff --git a/tests/acceptance/test_whole_file.py b/tests/acceptance/test_whole_file.py
new file mode 100644
index 0000000..3e23d69
--- /dev/null
+++ b/tests/acceptance/test_whole_file.py
@@ -0,0 +1,94 @@
+"""SPEC.md acceptance criteria 16-18: whole-file rejection."""
+
+from support import (
+    HEADER,
+    ann,
+    assert_clean,
+    assert_file_error,
+    csv_text,
+    error_rows,
+    make_repo,
+    run_import,
+)
+
+
+def valid_rows(count: int, start: int = 0) -> list[str]:
+    return [f"User {i},user{i}@example.com,," for i in range(start, start + count)]
+
+
+# 16. at most 1000 contact rows
+
+
+def test_c16_exactly_1000_contact_rows_are_accepted():
+    repo = make_repo()
+
+    report = run_import(repo, csv_text(HEADER, *valid_rows(1000)))
+
+    assert_clean(report)
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_c16_1001_contact_rows_raise():
+    assert_file_error(make_repo(ann()), csv_text(HEADER, *valid_rows(1001)))
+
+
+def test_c16_blank_rows_do_not_count():
+    rows = []
+    for line in valid_rows(1000):
+        rows += [line, "", " , , , "]
+    repo = make_repo()
+
+    report = run_import(repo, csv_text(HEADER, *rows))
+
+    assert_clean(report)
+    assert len(report.created) == 1000
+
+
+def test_c16_rows_that_would_be_errors_count():
+    rows = valid_rows(900) + [f"Bad {i},not-an-email-{i},," for i in range(101)]
+    assert_file_error(make_repo(ann()), csv_text(HEADER, *rows))
+
+
+def test_c16_1000_rows_including_error_rows_are_accepted():
+    rows = valid_rows(990) + [f"Bad {i},not-an-email-{i},," for i in range(10)]
+    repo = make_repo()
+
+    report = run_import(repo, csv_text(HEADER, *rows))
+
+    assert len(report.created) == 990
+    assert error_rows(report) == set(range(992, 1002))
+
+
+# 17. unclosed quoted field
+
+
+def test_c17_unclosed_quote_raises():
+    assert_file_error(make_repo(), csv_text(HEADER, '"Ann Lee,ann@example.com,,'))
+
+
+def test_c17_unclosed_quote_after_valid_rows_raises():
+    data = csv_text(HEADER, "Bob Stone,bob@example.com,,", 'Cy Young,cy@example.com,"+1 555,')
+    assert_file_error(make_repo(), data)
+
+
+# 18. ImportFileError leaves the repository untouched
+
+
+def test_c18_too_many_rows_applies_nothing_even_for_earlier_valid_rows():
+    repo = make_repo(ann())
+    rows = ["Ann Renamed,ann@example.com,+1 555 999 0000,vip"] + valid_rows(1000)
+    assert_file_error(repo, csv_text(HEADER, *rows))
+    assert len(repo) == 1
+
+
+def test_c18_unclosed_quote_applies_nothing_even_for_earlier_valid_rows():
+    repo = make_repo(ann())
+    data = csv_text(HEADER, "Ann Renamed,ann@example.com,+1 555 999 0000,vip", "Bob Stone,bob@example.com,,", '"Cy')
+    assert_file_error(repo, data)
+    assert len(repo) == 1
+
+
+def test_c18_header_problem_applies_nothing():
+    repo = make_repo(ann())
+    assert_file_error(repo, csv_text("name,email,email", "Ann Renamed,ann@example.com,ann@example.com"))
diff --git a/tests/test_importer.py b/tests/test_importer.py
new file mode 100644
index 0000000..e6f39ea
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,48 @@
+import pytest
+
+from contactbook.errors import ImportFileError
+from contactbook.importer import RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def test_row_with_more_cells_than_header_is_an_error_without_column():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "name,email\nAnn Lee,ann@example.com,extra\n")
+
+    assert [(issue.row, issue.column) for issue in report.errors] == [(2, None)]
+    assert len(repo) == 0
+
+
+def test_row_with_fewer_cells_than_header_fills_missing_cells_with_empty():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "name,email,phone,tags\nAnn Lee,ann@example.com\n")
+
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com")
+
+
+def test_blank_lines_before_the_header_are_skipped_but_counted():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "\nname,email\nAnn Lee,ann@example.com\nBad,nope\n")
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors[0].row == 4
+
+
+def test_unknown_duplicate_columns_are_ignored():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "notes,name,email,notes\nx,Ann Lee,ann@example.com,y\n")
+
+    assert report.created == ["ann@example.com"]
+
+
+def test_unclosed_quote_error_names_the_row():
+    with pytest.raises(ImportFileError, match="row 3"):
+        import_contacts(InMemoryContactRepository(), 'name,email\nAnn,ann@example.com\n"Bob,b@example.com\n')
+
+
+def test_invalid_phone_warning_message():
+    report = import_contacts(InMemoryContactRepository(), "name,email,phone\nAnn,ann@example.com,abc\n")
+
+    assert report.warnings == [RowIssue(2, "phone", "is not a phone number: 'abc'; the phone was not changed")]

+"""SPEC.md, "Interface": the public names other code relies on."""
+
+import dataclasses
+
+from contactbook.errors import ContactError
+from support import HEADER, csv_text, make_repo, run_import
+
+
+def test_import_report_is_a_dataclass_with_the_specified_fields():
+    from contactbook.importer import ImportReport
+
+    assert dataclasses.is_dataclass(ImportReport)
+    names = {f.name for f in dataclasses.fields(ImportReport)}
+    assert {"created", "updated", "errors", "warnings"} <= names
+
+
+def test_row_issue_is_a_dataclass_with_the_specified_fields():
+    from contactbook.importer import RowIssue
+
+    assert dataclasses.is_dataclass(RowIssue)
+    names = {f.name for f in dataclasses.fields(RowIssue)}
+    assert {"row", "column", "message"} <= names
+
+
+def test_import_file_error_derives_from_contact_error():
+    from contactbook.errors import ImportFileError
+
+    assert issubclass(ImportFileError, ContactError)
+
+
+def test_import_contacts_returns_an_import_report_of_row_issues():
+    from contactbook.importer import ImportReport, RowIssue
+
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,,", "Bob,not-an-email,,", "Cy,cy@example.com,abc,")
+    report = run_import(make_repo(), data)
+
+    assert isinstance(report, ImportReport)
+    assert report.created == ["ann@example.com", "cy@example.com"]
+    assert report.updated == []
+    for issue in report.errors + report.warnings:
+        assert isinstance(issue, RowIssue)
+        assert isinstance(issue.row, int)
+        assert issue.column in {"name", "email", "phone", "tags", None}
+        assert isinstance(issue.message, str) and issue.message.strip()

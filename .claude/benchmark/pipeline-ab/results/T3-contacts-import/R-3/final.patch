new file mode 100644
index 0000000..950bb53
--- /dev/null
+++ b/tests/acceptance/test_header.py
@@ -0,0 +1,189 @@
+"""SPEC.md acceptance criteria 7-15: header."""
+
+import pytest
+
+from contactbook.models import Contact
+from support import (
+    ann,
+    assert_clean,
+    assert_file_error,
+    assert_row_error,
+    csv_text,
+    make_repo,
+    run_import,
+    snapshot,
+)
+
+
+def filler_row(header: str) -> str:
+    """A data row with exactly as many cells as ``header``."""
+    samples = {"name": "Ann Lee", "email": "ann@example.com", "first_name": "Ann", "last_name": "Lee"}
+    return ",".join(samples.get(column.strip().lower(), "x") for column in header.split(","))
+
+
+# 7. header required
+
+
+@pytest.mark.parametrize(
+    "data",
+    ["", b"", b"\xef\xbb\xbf", "﻿", "\n", "\n\n\n", "   \n\t\n", "\r\n\r\n", ",,,\n", " , ,\n\n"],
+    ids=repr,
+)
+def test_c07_file_without_a_non_blank_line_raises(data):
+    assert_file_error(make_repo(ann()), data)
+
+
+# 8. case-insensitive, whitespace-insensitive, any order
+
+
+def test_c08_header_names_ignore_case_and_surrounding_whitespace():
+    repo = make_repo()
+    data = csv_text(" Name , Email ,PHONE,\tTags ", "Ann Lee,ann@example.com,+1 555 123 4567,vip")
+
+    report = run_import(repo, data)
+
+    assert_clean(report)
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip"])
+
+
+def test_c08_columns_in_any_order():
+    repo = make_repo()
+    data = csv_text("tags,phone,email,name", "vip,+1 555 123 4567,ann@example.com,Ann Lee")
+
+    report = run_import(repo, data)
+
+    assert_clean(report)
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip"])
+
+
+def test_c08_first_and_last_name_headers_ignore_case_and_whitespace():
+    repo = make_repo()
+    data = csv_text(" EMAIL, First_Name ,LAST_NAME ", "ann@example.com,Ann,Lee")
+
+    report = run_import(repo, data)
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# 9. email column required
+
+
+@pytest.mark.parametrize("header", ["name,phone,tags", "first_name,last_name,phone", "name,e-mail"])
+def test_c09_missing_email_column_raises(header):
+    assert_file_error(make_repo(), csv_text(header, filler_row(header)))
+
+
+# 10. name column or first_name + last_name required
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["email,phone,tags", "email,first_name", "email,last_name,phone", "email"],
+)
+def test_c10_missing_name_source_raises(header):
+    assert_file_error(make_repo(), csv_text(header, filler_row(header)))
+
+
+def test_c10_first_and_last_name_pair_is_a_name_source():
+    repo = make_repo()
+    report = run_import(repo, csv_text("first_name,last_name,email", "Ann,Lee,ann@example.com"))
+
+    assert_clean(report)
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# 11. name together with first_name/last_name
+
+
+def test_c11_empty_name_with_first_and_last_name_is_rejected_or_uses_them():
+    # Either outcome is fine; the row must just be handled consistently.
+    repo = make_repo()
+    data = csv_text("name,first_name,last_name,email", ",Ann,Lee,ann@example.com")
+
+    report = run_import(repo, data)
+
+    if report.created:
+        assert report.created == ["ann@example.com"]
+        assert report.errors == []
+        assert repo.get("ann@example.com").name == "Ann Lee"
+    else:
+        assert_row_error(report, 2, "name")
+        assert len(repo) == 0
+
+
+# 12. phone and tags optional
+
+
+def test_c12_phone_and_tags_columns_are_optional():
+    repo = make_repo()
+    report = run_import(repo, csv_text("email,name", "ann@example.com,Ann Lee"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com")
+
+
+# 13. unknown columns ignored
+
+
+def test_c13_unknown_columns_are_ignored():
+    repo = make_repo()
+    data = csv_text(
+        "Company,name,email,Notes,phone,tags,id",
+        "ACME,Ann Lee,ann@example.com,\"anything, at all\",+1 555 123 4567,vip,!!!",
+    )
+
+    report = run_import(repo, data)
+
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    # An optional notice about unknown columns is allowed, but it is not tied to a known column.
+    assert all(issue.column is None for issue in report.warnings)
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip"])
+
+
+# 14. duplicate columns
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "name,email,email",
+        "name, email ,EMAIL",
+        "name,Name,email",
+        "name,email,phone,Phone",
+        "name,email,tags, TAGS ",
+        "first_name,last_name,email,First_Name",
+        "first_name,last_name,email,last_name",
+    ],
+)
+def test_c14_duplicate_column_raises(header):
+    assert_file_error(make_repo(), csv_text(header, filler_row(header)))
+
+
+# 15. header-only file
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "name,email,phone,tags\n",
+        "name,email,phone,tags",
+        "name,email,phone,tags\r\n",
+        "name,email,phone,tags\n\n\n",
+        "name,email,phone,tags\n  \n,,,\n , , ,\n",
+    ],
+    ids=repr,
+)
+def test_c15_header_only_file_returns_an_empty_report(data):
+    repo = make_repo(ann())
+    before = snapshot(repo)
+
+    report = run_import(repo, data)
+
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert snapshot(repo) == before

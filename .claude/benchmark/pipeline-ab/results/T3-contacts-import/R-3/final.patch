+"""CSV import of contacts.
+
+Reads the format written by ``export.export_csv`` (``name,email,phone,tags``) and
+address-book exports that have ``first_name`` / ``last_name`` instead of ``name``.
+Problems with the file as a whole raise ImportFileError before anything is stored;
+problems with single rows are collected in the returned ImportReport.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_CONTACT_ROWS = 1000
+
+_KNOWN_COLUMNS = ("name", "email", "phone", "tags", "first_name", "last_name")
+_UNQUOTED_RE = re.compile(r"[^,\r\n]*")
+_BOM = "\ufeff"
+
+
+@dataclass(frozen=True, slots=True)
+class RowIssue:
+    """A problem with one row. ``row`` is the physical line number (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    """What an import did; ``created`` / ``updated`` hold normalised emails in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True, slots=True)
+class _Row:
+    number: int
+    name: str
+    email: str
+    phone: str | None
+    tags: frozenset[str]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV file content.
+
+    Raises ImportFileError, leaving ``repo`` untouched, if the file can't be
+    imported at all (bad encoding, broken quoting, unusable header, too many rows).
+    """
+    records = _parse_csv(_decode(data))
+    contact_records = [(number, cells) for number, cells in records if not _is_blank(cells)]
+    if not contact_records:
+        raise ImportFileError("the file is empty: a header line is required")
+    (_, header), *rows = contact_records
+    columns = _read_header(header)
+    if len(rows) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(rows)} contact rows; at most {MAX_CONTACT_ROWS} "
+            "can be imported at once, please split it"
+        )
+
+    report = ImportReport()
+    applied: set[str] = set()
+    for number, cells in rows:
+        row = _validate_row(number, cells, len(header), columns, applied, report)
+        if row is not None:
+            applied.add(row.email)
+            _apply(repo, row, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            data = data.decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not valid UTF-8; re-save it as "CSV UTF-8" and import again'
+            ) from None
+    return data.removeprefix(_BOM)
+
+
+def _parse_csv(text: str) -> list[tuple[int, list[str]]]:
+    """Split CSV text into records, each with the line number it starts on.
+
+    Standard quoting: a field that starts with ``"`` runs to the next unpaired
+    ``"`` and may contain commas, line breaks and doubled quotes. Line numbers
+    count physical lines, including those inside quoted fields.
+    """
+    records: list[tuple[int, list[str]]] = []
+    length = len(text)
+    line = 1
+    pos = 0
+    while pos < length:
+        start_line = line
+        cells: list[str] = []
+        while True:
+            if pos < length and text[pos] == '"':
+                pos, line, cell = _quoted_field(text, pos, line)
+            else:
+                end = _UNQUOTED_RE.match(text, pos).end()
+                cell, pos = text[pos:end], end
+            cells.append(cell)
+            if pos < length and text[pos] == ",":
+                pos += 1
+                continue
+            break
+        if pos < length:
+            pos += 2 if text.startswith("\r\n", pos) else 1
+            line += 1
+        records.append((start_line, cells))
+    return records
+
+
+def _quoted_field(text: str, pos: int, line: int) -> tuple[int, int, str]:
+    """Read a quoted field starting at the opening quote; return (pos, line, value)."""
+    start_line = line
+    parts: list[str] = []
+    pos += 1
+    while True:
+        close = text.find('"', pos)
+        if close == -1:
+            raise ImportFileError(
+                f"row {start_line}: a quoted field is never closed (missing '\"')"
+            )
+        chunk = text[pos:close]
+        line += chunk.count("\n") + chunk.count("\r") - chunk.count("\r\n")
+        parts.append(chunk)
+        if text.startswith('""', close):
+            parts.append('"')
+            pos = close + 2
+            continue
+        pos = close + 1
+        break
+    # Be lenient with stray text between the closing quote and the delimiter.
+    end = _UNQUOTED_RE.match(text, pos).end()
+    parts.append(text[pos:end])
+    return end, line, "".join(parts)
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _read_header(header: list[str]) -> dict[str, int]:
+    """Map known column names to their index; unknown columns are ignored."""
+    columns: dict[str, int] = {}
+    for index, raw in enumerate(header):
+        column = raw.strip().lower()
+        if column not in _KNOWN_COLUMNS:
+            continue
+        if column in columns:
+            raise ImportFileError(f"the header has the column {column!r} more than once")
+        columns[column] = index
+    if "email" not in columns:
+        raise ImportFileError("the header has no 'email' column")
+    if "name" not in columns and not ("first_name" in columns and "last_name" in columns):
+        raise ImportFileError(
+            "the header needs a 'name' column, or both 'first_name' and 'last_name'"
+        )
+    if "name" in columns:
+        columns.pop("first_name", None)
+        columns.pop("last_name", None)
+    return columns
+
+
+def _validate_row(
+    number: int,
+    cells: list[str],
+    header_width: int,
+    columns: dict[str, int],
+    applied: set[str],
+    report: ImportReport,
+) -> _Row | None:
+    """Return the normalised row, or None after recording its errors in ``report``."""
+    if len(cells) > header_width:
+        report.errors.append(
+            RowIssue(number, None, f"has {len(cells)} cells but the header has {header_width}")
+        )
+        return None
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    errors: list[RowIssue] = []
+
+    email = None
+    try:
+        email = normalize_email(cell("email"))
+    except ValidationError as exc:
+        errors.append(RowIssue(number, "email", exc.message))
+    if email is not None and email in applied:
+        errors.append(
+            RowIssue(number, "email", f"{email} already appears in an earlier row of this file")
+        )
+
+    if "name" in columns:
+        raw_name = cell("name")
+    else:
+        raw_name = " ".join(
+            part for part in (cell("first_name").strip(), cell("last_name").strip()) if part
+        )
+    name = None
+    try:
+        name = validate_name(raw_name)
+    except ValidationError as exc:
+        errors.append(RowIssue(number, "name", exc.message))
+
+    tags: set[str] = set()
+    for piece in cell("tags").split(TAG_SEPARATOR):
+        if not piece.strip():
+            continue
+        try:
+            tags.add(normalize_tag(piece))
+        except ValidationError as exc:
+            errors.append(RowIssue(number, "tags", exc.message))
+
+    if errors:
+        report.errors.extend(errors)
+        return None
+
+    phone = None
+    if cell("phone").strip():
+        try:
+            phone = normalize_phone(cell("phone"))
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(number, "phone", f"{exc.message}; the phone was not changed")
+            )
+
+    return _Row(number, name, email, phone, frozenset(tags))
+
+
+def _apply(repo: InMemoryContactRepository, row: _Row, report: ImportReport) -> None:
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(Contact(name=row.name, email=row.email, phone=row.phone, tags=row.tags))
+        report.created.append(row.email)
+        return
+    changed = existing.rename(row.name).with_tags(*row.tags)
+    if row.phone is not None:
+        changed = changed.with_phone(row.phone)
+    if changed != existing:
+        repo.update(changed)
+        report.updated.append(row.email)

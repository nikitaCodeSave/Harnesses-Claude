@@ -0,0 +1,116 @@
+"""SPEC.md acceptance criteria 29-31: name."""
+
+import pytest
+
+from support import (
+    HEADER,
+    ann,
+    assert_clean,
+    assert_row_error,
+    csv_text,
+    error_rows,
+    make_repo,
+    run_import,
+)
+
+# 29. name required and validated on every row
+
+
+def test_c29_name_is_trimmed_and_inner_whitespace_collapsed():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, "  Ann    Lee  ,ann@example.com,,"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+@pytest.mark.parametrize("name", ["", "   ", "\t", "A" * 101], ids=["empty", "spaces", "tab", "too-long"])
+def test_c29_empty_or_invalid_name_is_a_name_error(name):
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, f"{name},ann@example.com,,"))
+
+    assert error_rows(report) == {2}
+    assert_row_error(report, 2, "name")
+    assert len(repo) == 0
+
+
+def test_c29_name_of_exactly_100_characters_is_accepted():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, f"{'A' * 100},ann@example.com,,"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").name == "A" * 100
+
+
+def test_c29_name_is_required_when_updating_an_existing_contact():
+    existing = ann()
+    repo = make_repo(existing)
+    report = run_import(repo, csv_text(HEADER, ",ann@example.com,+1 555 999 0000,vip"))
+
+    assert_row_error(report, 2, "name")
+    assert report.updated == []
+    assert repo.get("ann@example.com") == existing
+
+
+# 30. first_name / last_name
+
+
+@pytest.mark.parametrize(
+    ("first", "last", "expected"),
+    [
+        ("Ann", "Lee", "Ann Lee"),
+        ("", "Lee", "Lee"),
+        ("Ann", "", "Ann"),
+        ("  Ann  ", "  van   Lee ", "Ann van Lee"),
+        ("   ", "Lee", "Lee"),
+    ],
+)
+def test_c30_first_and_last_name_are_joined_with_one_space(first, last, expected):
+    repo = make_repo()
+    report = run_import(repo, csv_text("first_name,last_name,email", f"{first},{last},ann@example.com"))
+
+    assert_clean(report)
+    assert repo.get("ann@example.com").name == expected
+
+
+@pytest.mark.parametrize(("first", "last"), [("", ""), ("  ", " ")])
+def test_c30_both_names_empty_is_a_name_error(first, last):
+    repo = make_repo()
+    report = run_import(repo, csv_text("first_name,last_name,email,phone", f"{first},{last},ann@example.com,"))
+
+    assert error_rows(report) == {2}
+    assert_row_error(report, 2, "name")
+    assert len(repo) == 0
+
+
+def test_c30_name_problems_are_reported_on_column_name():
+    repo = make_repo()
+    data = csv_text("email,last_name,first_name", f"ann@example.com,{'L' * 60},{'F' * 60}", "bob@example.com,,")
+
+    report = run_import(repo, data)
+
+    assert error_rows(report) == {2, 3}
+    for issue in report.errors:
+        assert issue.column == "name"
+    assert len(repo) == 0
+
+
+# 31. the file's name replaces the stored name
+
+
+def test_c31_name_replaces_the_stored_name():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text(HEADER, "Ann   Lee-Stone,ann@example.com,,"))
+
+    assert_clean(report)
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee-Stone"
+
+
+def test_c31_first_and_last_name_replace_the_stored_name():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text("email,first_name,last_name", "ann@example.com,Annie,Stone"))
+
+    assert_clean(report)
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Annie Stone"

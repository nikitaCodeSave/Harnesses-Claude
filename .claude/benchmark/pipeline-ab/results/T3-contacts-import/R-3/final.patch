@@ -0,0 +1,142 @@
+"""SPEC.md acceptance criteria 25-28: email."""
+
+import pytest
+
+from contactbook.models import Contact
+from support import (
+    HEADER,
+    ann,
+    assert_row_error,
+    csv_text,
+    error_rows,
+    make_repo,
+    run_import,
+)
+
+# 25. normalised with the email validator
+
+
+def test_c25_email_is_trimmed_and_lower_cased():
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, "Ann Lee,  Ann.Lee@Example.COM  ,,"))
+
+    assert report.errors == []
+    assert report.created == ["ann.lee@example.com"]
+    assert repo.all()[0].email == "ann.lee@example.com"
+
+
+def test_c25_spacing_and_case_match_an_existing_contact():
+    repo = make_repo(ann())
+    report = run_import(repo, csv_text(HEADER, "Ann Renamed,  ANN@Example.com ,,"))
+
+    assert report.errors == []
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert len(repo) == 1
+    assert repo.get("ann@example.com").name == "Ann Renamed"
+
+
+# 26. missing, empty or invalid email
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        "Ann Lee,,,",
+        "Ann Lee,   ,,",
+        "Ann Lee,not-an-email,,",
+        "Ann Lee,ann@example,,",
+        "Ann Lee,ann lee@example.com,,",
+        "Ann Lee,ann@@example.com,,",
+        "Ann Lee,,+1 555 123 4567,vip",
+    ],
+)
+def test_c26_missing_empty_or_invalid_email_is_an_email_error(row):
+    repo = make_repo()
+    report = run_import(repo, csv_text(HEADER, row))
+
+    assert error_rows(report) == {2}
+    assert_row_error(report, 2, "email")
+    assert report.created == []
+    assert len(repo) == 0
+
+
+# 27. first applied row for an email wins
+
+
+def test_c27_later_row_with_same_email_is_rejected_after_a_create():
+    repo = make_repo()
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,,vip", "Ann Other, ANN@EXAMPLE.COM ,+1 555 999 0000,lead")
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.updated == []
+    assert error_rows(report) == {3}
+    assert_row_error(report, 3, "email")
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com", None, ["vip"])
+
+
+def test_c27_later_row_with_same_email_is_rejected_after_an_update():
+    repo = make_repo(ann())
+    data = csv_text(HEADER, "Ann Renamed,ann@example.com,,vip", "Ann Other,Ann@Example.com,+1 555 999 0000,partner")
+
+    report = run_import(repo, data)
+
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert error_rows(report) == {3}
+    assert_row_error(report, 3, "email")
+    assert repo.get("ann@example.com") == Contact.create("Ann Renamed", "ann@example.com", "+15551234567", ["lead", "vip"])
+
+
+def test_c27_later_row_is_rejected_when_the_first_got_a_phone_warning():
+    repo = make_repo()
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,not a phone,", "Ann Other,ann@example.com,+1 555 999 0000,")
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert {(w.row, w.column) for w in report.warnings} == {(2, "phone")}
+    assert error_rows(report) == {3}
+    assert_row_error(report, 3, "email")
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com")
+
+
+def test_c27_every_later_duplicate_is_rejected():
+    repo = make_repo()
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,,", "Ann B,ann@example.com,,", "Bob,bob@example.com,,", "Ann C,ANN@example.com,,")
+
+    report = run_import(repo, data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert error_rows(report) == {3, 5}
+    assert_row_error(report, 3, "email")
+    assert_row_error(report, 5, "email")
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# 28. an earlier rejected row does not block a later valid one
+
+
+def test_c28_valid_row_after_a_rejected_row_with_same_email_creates():
+    repo = make_repo()
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,,bad!tag", "Ann Lee,ANN@example.com,,vip")
+
+    report = run_import(repo, data)
+
+    assert error_rows(report) == {2}
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com", None, ["vip"])
+
+
+def test_c28_valid_row_after_a_rejected_row_with_same_email_updates():
+    repo = make_repo(ann())
+    data = csv_text(HEADER, ",ann@example.com,,vip", "Ann Renamed,ann@example.com,,partner")
+
+    report = run_import(repo, data)
+
+    assert error_rows(report) == {2}
+    assert_row_error(report, 2, "name")
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create("Ann Renamed", "ann@example.com", "+15551234567", ["lead", "partner"])

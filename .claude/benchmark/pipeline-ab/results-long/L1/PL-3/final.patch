+# only books, at most twice, from five days before the due date ---------------
+
+
+def _refusal_reason(service, loan_id):
+    """Ask to renew, expect a refusal, and check that it changed nothing."""
+    before = service.get_loan(loan_id)
+    due_on, renewals = before.due_on, before.renewals
+    balance = service.balance(before.member_id)
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan_id)
+    after = service.get_loan(loan_id)
+    assert (after.due_on, after.renewals) == (due_on, renewals)
+    assert service.balance(before.member_id) == balance
+    assert refused.value.loan_id == loan_id
+    return refused.value.reason
+
+
+# The renewal rules are the same for an adult and a child.
+FOR_EVERY_CATEGORY = pytest.mark.parametrize("member", ["ann", "kid"])
+
+
+@FOR_EVERY_CATEGORY
+@pytest.mark.parametrize(
+    "day",
+    [
+        date(2026, 3, 2),  # the day it was borrowed
+        date(2026, 3, 4),  # five days before the due date
+        date(2026, 3, 9),  # the due date
+        date(2026, 3, 14),  # overdue: Late days 10-14 March
+    ],
+)
+def test_a_dvd_is_never_renewed(service, clock, member, day):
+    loan = service.checkout(member, "D1")  # due Monday 9 March
+    clock.set(day)
+    assert "book" in _refusal_reason(service, loan.loan_id)
+    assert str(service.balance(member)) == "0.00"
+
+
+def test_a_returned_dvd_is_refused_for_the_return_not_for_being_a_dvd(
+    service, clock
+):
+    loan = service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 9))
+    service.return_copy("D1")
+    assert "returned" in _refusal_reason(service, loan.loan_id)
+
+
+@FOR_EVERY_CATEGORY
+def test_a_book_cannot_be_renewed_six_days_before_its_due_date(
+    service, clock, member
+):
+    loan = service.checkout(member, "B1")  # due Monday 23 March
+    clock.set(date(2026, 3, 17))
+    assert "too early" in _refusal_reason(service, loan.loan_id)
+
+
+@FOR_EVERY_CATEGORY
+@pytest.mark.parametrize(
+    ("day", "due_on"),
+    [
+        (date(2026, 3, 18), date(2026, 4, 8)),  # five days before the due date
+        (date(2026, 3, 23), date(2026, 4, 13)),  # the due date
+        (date(2026, 3, 28), date(2026, 4, 18)),  # overdue
+    ],
+)
+def test_a_book_can_be_renewed_from_five_days_before_its_due_date(
+    service, clock, member, day, due_on
+):
+    loan = service.checkout(member, "B1")  # due Monday 23 March
+    clock.set(day)
+    assert service.renew(loan.loan_id).due_on == due_on
+
+
+@FOR_EVERY_CATEGORY
+def test_after_a_renewal_the_window_counts_from_the_new_due_date(
+    service, clock, member
+):
+    loan = service.checkout(member, "B1")
+    clock.set(date(2026, 3, 19))
+    service.renew(loan.loan_id)  # now due Thursday 9 April
+    clock.set(date(2026, 4, 3))
+    assert "too early" in _refusal_reason(service, loan.loan_id)
+    clock.set(date(2026, 4, 4))
+    renewed = service.renew(loan.loan_id)
+    assert renewed.due_on == date(2026, 4, 25)
+    assert renewed.renewals == 2
+
+
+def _renewed_twice(service, clock, member):
+    loan = service.checkout(member, "B1")
+    clock.set(date(2026, 3, 19))
+    service.renew(loan.loan_id)
+    clock.set(date(2026, 4, 4))
+    service.renew(loan.loan_id)  # now due Saturday 25 April
+    return loan
+
+
+@FOR_EVERY_CATEGORY
+@pytest.mark.parametrize(
+    "day",
+    [
+        date(2026, 4, 5),  # too early as well
+        date(2026, 4, 22),  # inside the window
+        date(2026, 4, 25),  # the due date
+        date(2026, 4, 30),  # overdue: refused without a Fine
+    ],
+)
+def test_a_third_renewal_is_refused_for_the_limit(service, clock, member, day):
+    loan = _renewed_twice(service, clock, member)
+    clock.set(day)
+    reason = _refusal_reason(service, loan.loan_id)
+    assert "already been renewed" in reason
+    assert "too early" not in reason
+    assert str(service.balance(member)) == "0.00"
+
+
+# members who owe anything can't renew ----------------------------------------
+
+
+def _block_error(service, loan_id):
+    """Ask to renew, expect a block, and check that it changed nothing."""
+    before = service.get_loan(loan_id)
+    due_on, renewals = before.due_on, before.renewals
+    balance = service.balance(before.member_id)
+    with pytest.raises(AccountBlocked) as blocked:
+        service.renew(loan_id)
+    after = service.get_loan(loan_id)
+    assert (after.due_on, after.renewals) == (due_on, renewals)
+    assert service.balance(before.member_id) == balance
+    assert blocked.value.member_id == before.member_id
+    assert blocked.value.balance == balance
+    assert blocked.value.threshold == Decimal("0.01")
+    return blocked.value
+
+
+@FOR_EVERY_CATEGORY
+@pytest.mark.parametrize("owed", [Decimal("0.01"), Decimal("4.50")])
+def test_a_member_who_owes_anything_is_blocked_from_renewing(
+    service, clock, member, owed
+):
+    loan = service.checkout(member, "B1")
+    service.add_charge(member, owed, "damaged case")
+    clock.set(date(2026, 3, 19))
+    assert _block_error(service, loan.loan_id).balance == owed
+
+
+def test_paying_back_to_nothing_unblocks_renewing_straight_away(service, clock):

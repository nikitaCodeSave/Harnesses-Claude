diff --git a/tests/test_account.py b/tests/test_account.py
new file mode 100644
index 0000000..039e93a
--- /dev/null
+++ b/tests/test_account.py
@@ -0,0 +1,139 @@
+from decimal import Decimal
+
+import pytest
+
+from lending.errors import InvalidAmount, MemberNotFound
+
+# Refused for Charges and Payments alike.
+INVALID_AMOUNTS = [
+    Decimal("0"),
+    Decimal("-1.00"),
+    Decimal("NaN"),
+    Decimal("sNaN"),
+    Decimal("Infinity"),
+    Decimal("-Infinity"),
+    Decimal("0.001"),
+    Decimal("2.505"),
+    Decimal("1E+30"),
+    2.5,
+    2,
+    "2.50",
+]
+
+
+def test_new_member_owes_nothing(service):
+    assert str(service.balance("ann")) == "0.00"
+
+
+def test_manual_charges_add_up_on_the_balance(service):
+    assert service.add_charge("ann", Decimal("2.50"), "damaged case") == Decimal("2.50")
+    assert service.add_charge("ann", Decimal("4.00"), "lost sleeve") == Decimal("6.50")
+    assert service.balance("ann") == Decimal("6.50")
+
+
+def test_a_manual_charge_needs_no_reason(service):
+    assert service.add_charge("ann", Decimal("3.00"), "") == Decimal("3.00")
+
+
+def test_unknown_member_has_no_balance(service):
+    with pytest.raises(MemberNotFound):
+        service.balance("nobody")
+
+
+def test_unknown_member_cannot_be_charged(service):
+    with pytest.raises(MemberNotFound):
+        service.add_charge("nobody", Decimal("1.00"), "damaged case")
+
+
+@pytest.mark.parametrize("amount", INVALID_AMOUNTS, ids=repr)
+def test_invalid_charge_amount_is_refused(service, amount):
+    service.add_charge("ann", Decimal("5.00"), "damaged case")
+    with pytest.raises(InvalidAmount) as refused:
+        service.add_charge("ann", amount, "damaged case")
+    assert refused.value.amount is amount
+    assert repr(amount) in str(refused.value)
+    assert service.balance("ann") == Decimal("5.00")
+
+
+def test_whole_cents_are_judged_by_value(service):
+    assert str(service.add_charge("ann", Decimal("1.000"), "damaged case")) == "1.00"
+    assert str(service.balance("ann")) == "1.00"
+
+
+def test_unknown_member_wins_over_invalid_amount(service):
+    with pytest.raises(MemberNotFound):
+        service.add_charge("nobody", Decimal("-1"), "damaged case")
+
+
+# Payments -------------------------------------------------------------
+
+
+def test_a_part_payment_reduces_the_balance(service):
+    service.add_charge("ann", Decimal("10.00"), "lost copy")
+    assert service.pay("ann", Decimal("4.00")) == Decimal("6.00")
+    assert service.balance("ann") == Decimal("6.00")
+
+
+def test_payments_add_up(service):
+    service.add_charge("ann", Decimal("10.00"), "lost copy")
+    service.pay("ann", Decimal("4.00"))
+    assert service.pay("ann", Decimal("2.50")) == Decimal("3.50")
+
+
+def test_paying_exactly_the_balance_clears_it(service):
+    service.add_charge("ann", Decimal("2.50"), "damaged case")
+    service.add_charge("ann", Decimal("4.00"), "lost sleeve")
+    assert str(service.pay("ann", Decimal("6.50"))) == "0.00"
+    assert str(service.balance("ann")) == "0.00"
+
+
+def test_a_payment_is_not_assigned_to_a_charge(service):
+    service.add_charge("ann", Decimal("2.50"), "damaged case")
+    service.add_charge("ann", Decimal("4.00"), "lost sleeve")
+    assert service.pay("ann", Decimal("5.00")) == Decimal("1.50")
+
+
+def test_charges_after_a_payment_add_to_what_is_left(service):
+    service.add_charge("ann", Decimal("5.00"), "damaged case")
+    service.pay("ann", Decimal("5.00"))
+    assert service.add_charge("ann", Decimal("1.25"), "lost sleeve") == Decimal("1.25")
+
+
+def test_overpayment_is_refused(service):
+    service.add_charge("ann", Decimal("6.00"), "damaged case")
+    with pytest.raises(InvalidAmount) as refused:
+        service.pay("ann", Decimal("6.01"))
+    assert refused.value.amount == Decimal("6.01")
+    assert "6.01" in str(refused.value)
+    assert service.balance("ann") == Decimal("6.00")
+
+
+def test_no_payment_is_taken_when_nothing_is_owed(service):
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("0.01"))
+    assert str(service.balance("ann")) == "0.00"
+
+
+@pytest.mark.parametrize("amount", INVALID_AMOUNTS, ids=repr)
+def test_invalid_payment_amount_is_refused(service, amount):
+    service.add_charge("ann", Decimal("5.00"), "damaged case")
+    with pytest.raises(InvalidAmount) as refused:
+        service.pay("ann", amount)
+    assert refused.value.amount is amount
+    assert repr(amount) in str(refused.value)
+    assert service.balance("ann") == Decimal("5.00")
+
+
+def test_payment_whole_cents_are_judged_by_value(service):
+    service.add_charge("ann", Decimal("3.00"), "damaged case")
+    assert str(service.pay("ann", Decimal("1.000"))) == "2.00"
+
+
+def test_unknown_member_cannot_pay(service):
+    with pytest.raises(MemberNotFound):
+        service.pay("nobody", Decimal("1.00"))
+
+
+def test_unknown_member_wins_over_invalid_payment(service):
+    with pytest.raises(MemberNotFound):
+        service.pay("nobody", Decimal("-1"))
diff --git a/tests/test_blocked.py b/tests/test_blocked.py
new file mode 100644
index 0000000..63e0a96
--- /dev/null
+++ b/tests/test_blocked.py
@@ -0,0 +1,102 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Material
+from lending.errors import AccountBlocked, MemberNotFound
+
+
+def test_a_balance_of_exactly_ten_blocks_borrowing(service):
+    service.add_charge("ann", Decimal("10.00"), "lost copy")
+    with pytest.raises(AccountBlocked) as blocked:
+        service.checkout("ann", "B1")
+    assert blocked.value.member_id == "ann"
+    assert blocked.value.balance == Decimal("10.00")
+    assert blocked.value.threshold == Decimal("10.00")
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("ann") == []
+
+
+def test_a_higher_balance_is_blocked_too(service):
+    service.add_charge("ann", Decimal("12.00"), "lost copy")
+    with pytest.raises(AccountBlocked) as blocked:
+        service.checkout("ann", "B1")
+    assert blocked.value.balance == Decimal("12.00")
+    assert "owes 12.00, limit 10.00" in str(blocked.value)
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+def test_a_balance_just_under_ten_can_still_borrow(service):
+    service.add_charge("ann", Decimal("9.99"), "damaged case")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+    assert service.get_copy("B1").status is CopyStatus.ON_LOAN
+
+
+def test_the_block_comes_before_the_copy_being_on_loan(service):
+    service.checkout("kid", "B1")
+    service.add_charge("ann", Decimal("10.00"), "lost copy")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_the_block_comes_before_the_loan_limit(service):
+    service.add_title("978-9", "Short Stories", Material.BOOK, Decimal("9.00"))
+    for n in range(9):
+        service.add_copy(f"S{n}", "978-9")
+    for n in range(8):
+        service.checkout("ann", f"S{n}")
+    service.add_charge("ann", Decimal("10.00"), "lost copy")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "S8")
+
+
+def test_the_block_comes_before_an_unknown_copy(service):
+    service.add_charge("ann", Decimal("10.00"), "lost copy")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "nope")
+
+
+def test_an_unknown_member_is_still_not_found(service):
+    with pytest.raises(MemberNotFound):
+        service.checkout("nobody", "B1")
+
+
+def test_a_child_is_blocked_by_manual_charges_at_the_same_threshold(service):
+    service.add_charge("kid", Decimal("9.99"), "damaged case")
+    service.checkout("kid", "B1")
+    service.add_charge("kid", Decimal("0.01"), "torn page")
+    with pytest.raises(AccountBlocked) as blocked:
+        service.checkout("kid", "B2")
+    assert blocked.value.member_id == "kid"
+    assert blocked.value.threshold == Decimal("10.00")
+
+
+def test_paying_below_the_threshold_unblocks_straight_away(service):
+    service.add_charge("ann", Decimal("12.00"), "lost copy")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    service.pay("ann", Decimal("2.01"))
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+def test_paying_only_down_to_the_threshold_still_blocks(service):
+    service.add_charge("ann", Decimal("12.00"), "lost copy")
+    service.pay("ann", Decimal("2.00"))
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_a_fine_on_return_can_block(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 6, 1))  # far past due: the Fine is capped at 12.00
+    service.return_copy("D1")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_an_overdue_copy_still_out_does_not_block(service, clock):
+    service.checkout("ann", "D1")
+    service.add_charge("ann", Decimal("9.00"), "damaged case")
+    clock.set(date(2026, 6, 1))  # Fine building up, but not posted (ADR-0001)
+    assert service.checkout("ann", "B1").copy_id == "B1"
diff --git a/tests/test_fines.py b/tests/test_fines.py
new file mode 100644
index 0000000..3539166
--- /dev/null
+++ b/tests/test_fines.py
@@ -0,0 +1,92 @@
+from datetime import date
+from decimal import Decimal
+
+from lending import CopyStatus
+
+
+def test_late_book_is_fined_per_late_day_leaving_out_sundays(service, clock):
+    loan = service.checkout("ann", "B1")
+    assert loan.due_on == date(2026, 3, 23)
+    clock.set(date(2026, 3, 30))  # 24-30 March, less Sunday 29 March: 6 Late days
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_late_dvd_is_fined_per_late_day_leaving_out_sundays(service, clock):
+    loan = service.checkout("ann", "D1")
+    assert loan.due_on == date(2026, 3, 9)
+    clock.set(date(2026, 3, 16))  # 10-16 March, less Sunday 15 March: 6 Late days
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("6.00")
+
+
+def test_return_on_the_due_date_is_not_fined(service, clock):
+    loan = service.checkout("ann", "D1")
+    clock.set(loan.due_on)
+    service.return_copy("D1")
+    assert str(service.balance("ann")) == "0.00"
+
+
+def test_early_return_is_not_fined(service, clock):
+    service.checkout("ann", "D1")
+    clock.advance(2)
+    service.return_copy("D1")
+    assert str(service.balance("ann")) == "0.00"
+
+
+def test_sunday_return_after_a_saturday_due_date_is_not_fined(service, clock):
+    clock.set(date(2026, 3, 7))  # a Saturday: +21 days is Saturday 28 March
+    loan = service.checkout("ann", "B1")
+    assert loan.due_on == date(2026, 3, 28)
+    clock.set(date(2026, 3, 29))
+    service.return_copy("B1")
+    assert str(service.balance("ann")) == "0.00"
+
+
+def test_a_very_late_dvd_costs_at_most_its_replacement_cost(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 6, 1))
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_a_very_late_book_costs_at_most_its_replacement_cost(service, clock):
+    service.checkout("ann", "B1")
+    clock.set(date(2026, 12, 1))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("18.00")
+
+
+def test_a_child_is_never_fined(service, clock):
+    service.checkout("kid", "D1")
+    clock.set(date(2026, 3, 16))
+    loan = service.return_copy("D1")
+    assert str(service.balance("kid")) == "0.00"
+    assert not loan.is_open
+    assert service.open_loans("kid") == []
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+
+
+def test_a_late_return_still_hands_back_the_closed_loan(service, clock):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 30))
+    returned = service.return_copy("B1")
+    assert returned is service.get_loan(loan.loan_id)
+    assert returned.returned_on == date(2026, 3, 30)
+    assert not returned.is_open
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+def test_an_overdue_copy_still_out_does_not_change_the_balance(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 6, 1))
+    assert service.overdue_loans() != []
+    assert str(service.balance("ann")) == "0.00"
+
+
+def test_a_fine_adds_to_manual_charges(service, clock):
+    service.add_charge("ann", Decimal("2.50"), "damaged case")
+    service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("4.00")
diff --git a/tests/test_holds.py b/tests/test_holds.py
new file mode 100644
index 0000000..b77e179
--- /dev/null
+++ b/tests/test_holds.py
@@ -0,0 +1,681 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    DuplicateCopy,
+    HoldNotAllowed,
+    HoldNotFound,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+
+
+def test_a_hold_on_a_title_with_every_copy_out_is_waiting(service):
+    service.checkout("kid", "D1")
+    hold = service.place_hold("ann", "dvd-1")
+    assert hold.hold_id == "H0001"
+    assert hold.member_id == "ann"
+    assert hold.isbn == "dvd-1"
+    assert hold.placed_on == date(2026, 3, 2)
+    assert hold.status is HoldStatus.WAITING
+    assert hold.copy_id is None
+    assert hold.pickup_by is None
+
+
+def test_the_hold_queue_is_in_placement_order(service, clock):
+    service.register_member("bob", "Bob Adult")
+    service.register_member("cat", "Cat Adult")
+    service.checkout("kid", "D1")
+    service.place_hold("bob", "dvd-1")
+    service.place_hold("ann", "dvd-1")  # same day, placed second
+    clock.advance()
+    service.place_hold("cat", "dvd-1")
+    assert [h.member_id for h in service.holds_for("dvd-1")] == ["bob", "ann", "cat"]
+
+
+def test_a_title_nobody_is_waiting_for_has_an_empty_queue(service):
+    assert service.holds_for("dvd-1") == []
+
+
+def test_the_queue_of_an_unknown_title_is_not_found(service):
+    with pytest.raises(TitleNotFound):
+        service.holds_for("nope")
+
+
+def test_no_hold_while_a_copy_is_on_the_shelf(service):
+    service.checkout("kid", "B1")  # B2 is still on the shelf
+    with pytest.raises(HoldNotAllowed, match="on the shelf"):
+        service.place_hold("ann", "978-1")
+    assert service.holds_for("978-1") == []
+
+
+def test_no_hold_on_a_title_with_no_copies(service):
+    service.add_title("978-2", "On Order", Material.BOOK, Decimal("15.00"))
+    with pytest.raises(HoldNotAllowed, match="no copies in circulation"):
+        service.place_hold("ann", "978-2")
+
+
+def test_no_hold_on_a_title_whose_copies_are_all_withdrawn(service):
+    service.withdraw_copy("D1")
+    with pytest.raises(HoldNotAllowed, match="no copies in circulation"):

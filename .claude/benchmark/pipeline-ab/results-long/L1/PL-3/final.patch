+def test_a_hold_placed_after_a_renewal_only_stops_the_next_one(service, clock):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 19))
+    service.renew(loan.loan_id)  # now due Thursday 9 April
+    hold = _someone_waits_for_978_1(service)
+    assert service.get_loan(loan.loan_id).due_on == date(2026, 4, 9)
+    clock.set(date(2026, 4, 4))
+    assert hold.hold_id in _refusal_reason(service, loan.loan_id)
+
+
+def test_an_overdue_renewal_refused_for_a_waiting_hold_posts_no_fine(
+    service, clock
+):
+    loan = service.checkout("ann", "B1")  # due Monday 23 March
+    _someone_waits_for_978_1(service)
+    clock.set(date(2026, 3, 28))  # 5 Late days, not fined
+    assert "waiting" in _refusal_reason(service, loan.loan_id)
+    assert str(service.balance("ann")) == "0.00"
+
+

+
+def test_money_owed_is_reported_before_too_early(service, clock):
+    loan = service.checkout("ann", "B1")
+    service.add_charge("ann", Decimal("3.00"), "lost card")
+    clock.set(date(2026, 3, 17))  # six days before the due date
+    _block_error(service, loan.loan_id)
+
+
+# no renewal while someone is waiting for the Title ---------------------------
+
+
+def _someone_waits_for_978_1(service):
+    """With B1 already out, put B2 out with kid too, then have a third member
+    place a Waiting Hold on 978-1."""
+    service.checkout("kid", "B2")
+    service.register_member("cat", "Cat Adult")
+    return service.place_hold("cat", "978-1")
+
+
+def test_a_waiting_hold_on_the_title_refuses_the_renewal(service, clock):
+    loan = service.checkout("ann", "B1")  # due Monday 23 March
+    hold = _someone_waits_for_978_1(service)
+    clock.set(date(2026, 3, 19))
+    reason = _refusal_reason(service, loan.loan_id)
+    assert hold.hold_id in reason
+    assert "waiting" in reason
+    assert service.get_copy("B1").status is CopyStatus.ON_LOAN
+    assert [(h.hold_id, h.status) for h in service.holds_for("978-1")] == [
+        (hold.hold_id, HoldStatus.WAITING)
+    ]
+
+
+def test_once_the_waiting_hold_is_ready_the_renewal_goes_through(service, clock):
+    loan = service.checkout("ann", "B1")
+    hold = _someone_waits_for_978_1(service)
+    clock.set(date(2026, 3, 19))
+    service.return_copy("B2")  # set aside for cat's Hold, now Ready
+    assert service.holds_for("978-1")[0].status is HoldStatus.READY
+    renewed = service.renew(loan.loan_id)
+    assert (renewed.due_on, renewed.renewals) == (date(2026, 4, 9), 1)
+    assert [(h.hold_id, h.status) for h in service.holds_for("978-1")] == [
+        (hold.hold_id, HoldStatus.READY)
+    ]
+
+
+def test_once_the_waiting_hold_is_cancelled_the_renewal_goes_through(
+    service, clock
+):
+    loan = service.checkout("ann", "B1")
+    hold = _someone_waits_for_978_1(service)
+    clock.set(date(2026, 3, 19))
+    _refusal_reason(service, loan.loan_id)
+    service.cancel_hold(hold.hold_id)
+    assert service.renew(loan.loan_id).due_on == date(2026, 4, 9)
+

@@ -0,0 +1,473 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Hold, HoldStatus, Material, policy
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    HoldNotAllowed,
+    HoldNotFound,
+    LendingError,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+from lending.reports import overdue_report
+
+
+@pytest.fixture
+def out(service):
+    """Both copies of 978-1 are on loan to ann; bob, cat and dee can queue."""
+    for member_id, name in [("bob", "Bob"), ("cat", "Cat"), ("dee", "Dee")]:
+        service.register_member(member_id, name)
+    service.checkout("ann", "B1")
+    service.checkout("ann", "B2")
+    return service
+
+
+def statuses(service, isbn="978-1"):
+    return [(h.member_id, h.status) for h in service.holds_for(isbn)]
+
+
+# interface ---------------------------------------------------------------
+
+
+def test_interface_names_exist():
+    assert [s.name for s in HoldStatus] == [
+        "WAITING", "READY", "FULFILLED", "CANCELLED", "EXPIRED",
+    ]
+    assert CopyStatus.ON_HOLD_SHELF in CopyStatus
+    assert issubclass(HoldNotAllowed, LendingError)
+    assert issubclass(HoldNotFound, LendingError)
+    assert list(Hold.__dataclass_fields__) == [
+        "hold_id", "member_id", "isbn", "placed_on", "status", "copy_id", "pickup_by",
+    ]
+
+
+# placing -----------------------------------------------------------------
+
+
+def test_place_hold_when_every_copy_is_out(out):
+    hold = out.place_hold("bob", "978-1")
+    assert hold.member_id == "bob"
+    assert hold.isbn == "978-1"
+    assert hold.placed_on == date(2026, 3, 2)
+    assert hold.status is HoldStatus.WAITING
+    assert hold.copy_id is None
+    assert hold.pickup_by is None
+    assert out.holds_for("978-1") == [hold]
+
+
+def test_place_hold_unknown_member_or_title(out):
+    with pytest.raises(MemberNotFound):
+        out.place_hold("nobody", "978-1")
+    with pytest.raises(TitleNotFound):
+        out.place_hold("bob", "no-such-isbn")
+
+
+def test_owing_five_blocks_holds(out):
+    out.add_charge("bob", Decimal("5.00"), "lost card")
+    with pytest.raises(AccountBlocked):
+        out.place_hold("bob", "978-1")
+    assert out.holds_for("978-1") == []
+
+
+def test_owing_just_under_five_can_hold(out):
+    out.add_charge("bob", Decimal("4.99"), "lost card")
+    assert out.place_hold("bob", "978-1").status is HoldStatus.WAITING
+
+
+def test_hold_block_is_checked_before_availability(out):
+    out.add_charge("bob", Decimal("5.00"), "lost card")
+    with pytest.raises(AccountBlocked):
+        out.place_hold("bob", "dvd-1")  # D1 is on the shelf
+
+
+def test_no_hold_while_a_copy_is_on_the_shelf(out):
+    with pytest.raises(HoldNotAllowed):
+        out.place_hold("bob", "dvd-1")
+
+
+def test_no_hold_on_a_title_without_copies(out):
+    out.add_title("978-2", "No Copies Yet", Material.BOOK, Decimal("10.00"))
+    with pytest.raises(HoldNotAllowed):
+        out.place_hold("bob", "978-2")
+
+
+def test_no_hold_when_every_copy_is_withdrawn(out):
+    out.withdraw_copy("D1")
+    with pytest.raises(HoldNotAllowed):
+        out.place_hold("bob", "dvd-1")
+
+
+def test_no_second_active_hold_on_the_same_title(out, clock):
+    out.place_hold("bob", "978-1")
+    with pytest.raises(HoldNotAllowed):
+        out.place_hold("bob", "978-1")
+    out.return_copy("B1")  # bob's hold is now READY
+    with pytest.raises(HoldNotAllowed):
+        out.place_hold("bob", "978-1")
+    assert len(out.holds_for("978-1")) == 1
+
+
+def test_no_hold_on_a_title_the_member_has_on_loan(out):
+    with pytest.raises(HoldNotAllowed):
+        out.place_hold("ann", "978-1")
+
+
+def test_child_can_place_a_hold(out):
+    assert out.place_hold("kid", "978-1").status is HoldStatus.WAITING
+
+
+# queue -------------------------------------------------------------------
+
+
+def test_holds_for_lists_active_holds_in_placement_order(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    clock.advance()
+    cat = out.place_hold("cat", "978-1")
+    dee = out.place_hold("dee", "978-1")  # same day as cat, placed after
+    assert out.holds_for("978-1") == [bob, cat, dee]
+
+    out.cancel_hold(cat.hold_id)
+    out.return_copy("B1")
+    out.checkout("bob", "B1")  # bob FULFILLED
+    assert out.holds_for("978-1") == [dee]
+
+
+def test_holds_for_unknown_title(service):
+    with pytest.raises(TitleNotFound):
+        service.holds_for("no-such-isbn")
+
+
+def test_holds_for_leaves_out_expired(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    clock.set(bob.pickup_by)
+    clock.advance()
+    out.expire_holds()
+    assert out.holds_for("978-1") == []
+
+
+# setting a copy aside ----------------------------------------------------
+
+
+def test_return_sets_copy_aside_for_first_in_line(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    cat = out.place_hold("cat", "978-1")
+    clock.set(date(2026, 3, 30))  # B1 was due Mon 23 Mar: 6 open days late
+    loan = out.return_copy("B1")
+
+    assert loan.copy_id == "B1"
+    assert loan.returned_on == date(2026, 3, 30)
+    assert out.balance("ann") == Decimal("1.50")
+    assert out.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+    assert bob.status is HoldStatus.READY
+    assert bob.copy_id == "B1"
+    assert bob.pickup_by == date(2026, 4, 6)
+    assert cat.status is HoldStatus.WAITING
+    assert cat.copy_id is None
+
+
+def test_pickup_by_is_seven_days_after_set_aside(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")  # Mon 2 Mar 2026
+    assert bob.pickup_by == date(2026, 3, 9)
+
+
+def test_pickup_by_never_falls_on_a_sunday(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    clock.set(date(2026, 3, 1))  # Sunday; +7 is Sunday 8 March
+    out.return_copy("B1")
+    assert bob.pickup_by == date(2026, 3, 9)
+
+
+def test_pickup_by_policy():
+    assert policy.pickup_by(date(2026, 3, 2)) == date(2026, 3, 9)
+    assert policy.pickup_by(date(2026, 3, 1)) == date(2026, 3, 9)
+    assert policy.pickup_by(date(2026, 3, 7)) == date(2026, 3, 14)
+
+
+def test_return_with_nobody_waiting_shelves_the_copy(out):
+    out.return_copy("B1")
+    assert out.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+def test_new_copy_is_set_aside_for_first_in_line(out):
+    bob = out.place_hold("bob", "978-1")
+    out.place_hold("cat", "978-1")
+    out.add_copy("B3", "978-1")
+    assert out.get_copy("B3").status is CopyStatus.ON_HOLD_SHELF
+    assert bob.status is HoldStatus.READY
+    assert bob.copy_id == "B3"
+    assert bob.pickup_by == date(2026, 3, 9)
+
+
+def test_new_copy_with_nobody_waiting_is_available(out):
+    assert out.add_copy("B3", "978-1").status is CopyStatus.AVAILABLE
+
+
+# picking up --------------------------------------------------------------
+
+
+def test_member_collects_their_held_copy(out):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    loan = out.checkout("bob", "B1")
+    assert loan.member_id == "bob"
+    assert bob.status is HoldStatus.FULFILLED
+    assert out.holds_for("978-1") == []
+    assert out.get_copy("B1").status is CopyStatus.ON_LOAN
+
+
+def test_member_collects_on_pickup_by_day(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    clock.set(bob.pickup_by)
+    out.expire_holds()
+    out.checkout("bob", "B1")
+    assert bob.status is HoldStatus.FULFILLED
+
+
+def test_someone_else_cannot_borrow_a_held_copy(out):
+    out.place_hold("bob", "978-1")
+    out.place_hold("cat", "978-1")
+    out.return_copy("B1")
+    with pytest.raises(CopyNotAvailable):
+        out.checkout("cat", "B1")
+    with pytest.raises(CopyNotAvailable):
+        out.checkout("dee", "B1")
+    assert out.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_blocked_member_cannot_collect_but_keeps_the_hold(out):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    out.add_charge("bob", Decimal("10.00"), "damaged case")
+    with pytest.raises(AccountBlocked):
+        out.checkout("bob", "B1")
+    assert bob.status is HoldStatus.READY
+    assert out.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+    out.pay("bob", Decimal("1.00"))
+    out.checkout("bob", "B1")
+    assert bob.status is HoldStatus.FULFILLED
+
+
+def test_member_at_loan_limit_cannot_collect_but_keeps_the_hold(out):
+    out.add_title("978-9", "Picture Book", Material.BOOK, Decimal("9.00"))
+    for n in range(4):
+        out.add_copy(f"P{n}", "978-9")
+        out.checkout("kid", f"P{n}")
+    hold = out.place_hold("kid", "978-1")
+    out.return_copy("B1")
+    with pytest.raises(LoanLimitReached):
+        out.checkout("kid", "B1")
+    assert hold.status is HoldStatus.READY
+    assert out.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_borrowing_another_copy_fulfils_hold_and_shelves_set_aside_copy(out):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")  # set aside for bob
+    out.return_copy("B2")  # nobody else waiting: shelved
+    assert out.get_copy("B2").status is CopyStatus.AVAILABLE
+
+    out.checkout("bob", "B2")
+    assert bob.status is HoldStatus.FULFILLED
+    assert bob.copy_id == "B1"
+    assert out.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert out.holds_for("978-1") == []
+
+
+def test_ready_member_cannot_take_a_copy_set_aside_for_someone_else(out):
+    bob = out.place_hold("bob", "978-1")
+    out.place_hold("cat", "978-1")
+    out.return_copy("B1")  # bob READY with B1
+    out.return_copy("B2")  # cat READY with B2
+    with pytest.raises(CopyNotAvailable):
+        out.checkout("bob", "B2")
+    assert bob.status is HoldStatus.READY
+    assert out.get_copy("B2").status is CopyStatus.ON_HOLD_SHELF
+
+
+# cancelling --------------------------------------------------------------
+
+
+def test_cancel_waiting_hold(out):
+    bob = out.place_hold("bob", "978-1")
+    cat = out.place_hold("cat", "978-1")
+    dee = out.place_hold("dee", "978-1")
+    cancelled = out.cancel_hold(cat.hold_id)
+    assert cancelled is cat
+    assert cat.status is HoldStatus.CANCELLED
+    assert out.holds_for("978-1") == [bob, dee]
+
+
+def test_cancel_ready_hold_passes_copy_to_next_waiting(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    cat = out.place_hold("cat", "978-1")
+    out.return_copy("B1")
+    clock.set(date(2026, 3, 7))  # Saturday; +7 is Saturday 14 March
+    out.cancel_hold(bob.hold_id)
+    assert bob.status is HoldStatus.CANCELLED
+    assert cat.status is HoldStatus.READY
+    assert cat.copy_id == "B1"
+    assert cat.pickup_by == date(2026, 3, 14)
+    assert out.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+    assert out.balance("bob") == Decimal("0.00")
+
+
+def test_cancel_ready_hold_window_follows_sunday_rule(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    cat = out.place_hold("cat", "978-1")
+    out.return_copy("B1")
+    clock.set(date(2026, 3, 8))  # Sunday
+    out.cancel_hold(bob.hold_id)
+    assert cat.pickup_by == date(2026, 3, 16)
+
+
+def test_cancel_ready_hold_with_nobody_waiting_shelves_copy(out):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    out.cancel_hold(bob.hold_id)
+    assert out.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert out.balance("bob") == Decimal("0.00")
+
+
+def test_cancel_unknown_hold(out):
+    with pytest.raises(HoldNotFound):
+        out.cancel_hold("H9999")
+
+
+def test_cancel_finished_hold_is_not_allowed(out, clock):
+    fulfilled = out.place_hold("bob", "978-1")
+    cancelled = out.place_hold("cat", "978-1")
+    expired = out.place_hold("dee", "978-1")
+    out.cancel_hold(cancelled.hold_id)
+    out.return_copy("B1")
+    out.checkout("bob", "B1")
+    out.return_copy("B2")
+    clock.set(expired.pickup_by)
+    clock.advance()
+    out.expire_holds()
+    for hold, status in [
+        (fulfilled, HoldStatus.FULFILLED),
+        (cancelled, HoldStatus.CANCELLED),
+        (expired, HoldStatus.EXPIRED),
+    ]:
+        assert hold.status is status
+        with pytest.raises(HoldNotAllowed):
+            out.cancel_hold(hold.hold_id)
+        assert hold.status is status
+
+
+# expiring ----------------------------------------------------------------
+
+
+def test_expire_leaves_holds_alone_on_pickup_by_day(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    clock.set(bob.pickup_by)
+    assert out.expire_holds() == []
+    assert bob.status is HoldStatus.READY
+
+
+def test_expire_day_after_pickup_by_charges_and_passes_copy_on(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    cat = out.place_hold("cat", "978-1")
+    out.return_copy("B1")  # pickup_by Mon 9 Mar
+    clock.set(date(2026, 3, 10))
+    assert out.expire_holds() == [bob]
+    assert bob.status is HoldStatus.EXPIRED
+    assert out.balance("bob") == Decimal("1.00")
+    assert cat.status is HoldStatus.READY
+    assert cat.copy_id == "B1"
+    assert cat.pickup_by == date(2026, 3, 17)
+    assert out.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_expire_with_nobody_waiting_shelves_copy(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    clock.set(date(2026, 3, 10))
+    assert out.expire_holds() == [bob]
+    assert out.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+def test_child_no_show_is_not_charged(out, clock):
+    hold = out.place_hold("kid", "978-1")
+    out.return_copy("B1")
+    clock.set(date(2026, 3, 10))
+    assert out.expire_holds() == [hold]
+    assert out.balance("kid") == Decimal("0.00")
+
+
+def test_expire_twice_the_same_day_does_nothing_more(out, clock):
+    out.place_hold("bob", "978-1")
+    out.place_hold("cat", "978-1")
+    out.return_copy("B1")
+    clock.set(date(2026, 3, 10))
+    assert len(out.expire_holds()) == 1
+    assert out.expire_holds() == []
+    assert out.balance("bob") == Decimal("1.00")
+    assert out.balance("cat") == Decimal("0.00")
+
+
+def test_expire_catches_up_after_missed_days(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    cat = out.place_hold("cat", "978-1")
+    dee = out.place_hold("dee", "978-1")
+    out.return_copy("B1")  # bob, pickup_by 9 Mar
+    clock.set(date(2026, 3, 3))
+    out.return_copy("B2")  # cat, pickup_by 10 Mar
+    clock.set(date(2026, 3, 20))  # job hasn't run since
+    assert out.expire_holds() == [bob, cat]
+    assert out.balance("bob") == Decimal("1.00")
+    assert out.balance("cat") == Decimal("1.00")
+    # dee got B1 in this run and keeps it; B2 found nobody and was shelved.
+    assert dee.status is HoldStatus.READY
+    assert dee.copy_id == "B1"
+    assert dee.pickup_by == date(2026, 3, 27)
+    assert out.get_copy("B2").status is CopyStatus.AVAILABLE
+
+
+def test_waiting_holds_never_expire(out, clock):
+    bob = out.place_hold("bob", "978-1")
+    clock.advance(365)
+    assert out.expire_holds() == []
+    assert bob.status is HoldStatus.WAITING
+
+
+def test_no_show_fees_count_toward_the_hold_block(out, clock):
+    out.add_charge("bob", Decimal("4.00"), "lost card")
+    out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    clock.set(date(2026, 3, 10))
+    out.expire_holds()
+    assert out.balance("bob") == Decimal("5.00")
+    with pytest.raises(AccountBlocked):
+        out.place_hold("bob", "978-1")
+
+
+def test_no_show_fees_count_toward_the_borrow_block(out, clock):
+    out.place_hold("bob", "978-1")
+    out.return_copy("B1")
+    out.add_charge("bob", Decimal("9.00"), "lost card")
+    clock.set(date(2026, 3, 10))
+    out.expire_holds()
+    assert out.balance("bob") == Decimal("10.00")
+    with pytest.raises(AccountBlocked):
+        out.checkout("bob", "D1")
+
+
+# unchanged behaviour -----------------------------------------------------
+
+
+def test_overdue_report_ignores_holds(out, clock):
+    out.place_hold("bob", "978-1")
+    clock.set(date(2026, 3, 30))
+    lines = overdue_report(out, clock.today())
+    assert [(l.copy_id, l.days_overdue) for l in lines] == [("B1", 7), ("B2", 7)]

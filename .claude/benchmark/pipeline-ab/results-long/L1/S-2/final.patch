@@ -0,0 +1,283 @@
+"""Overdue fines and member accounts. Numbers in comments refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Material
+from lending.errors import (
+    AccountBlocked,
+    CopyNotFound,
+    InvalidAmount,
+    LendingError,
+    MemberNotFound,
+)
+from lending.reports import overdue_report
+
+D = Decimal
+
+
+def late_dvd_return(service, clock, member, returned_on):
+    """Borrow D1 on START (due Mon 9 Mar) and hand it back on ``returned_on``."""
+    service.checkout(member, "D1")
+    clock.set(returned_on)
+    return service.return_copy("D1")
+
+
+# balance basics -----------------------------------------------------------
+
+
+def test_new_member_owes_nothing(service):  # 1
+    assert service.balance("ann") == D("0")
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda s: s.balance("nobody"),
+        lambda s: s.add_charge("nobody", D("1.00"), "lost card"),
+        lambda s: s.pay("nobody", D("1.00")),
+    ],
+    ids=["balance", "add_charge", "pay"],
+)
+def test_unknown_member_has_no_account(service, call):  # 2
+    with pytest.raises(MemberNotFound):
+        call(service)
+
+
+# fines --------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("returned_on", [date(2026, 3, 5), date(2026, 3, 9)])
+def test_return_on_or_before_due_date_is_free(service, clock, returned_on):  # 3
+    late_dvd_return(service, clock, "ann", returned_on)
+    assert service.balance("ann") == D("0")
+
+
+def test_late_dvd_skips_sundays(service, clock):  # 4
+    # Due Mon 9 Mar, back Mon 16 Mar: Tue-Sat plus Mon, Sun 15 doesn't count.
+    late_dvd_return(service, clock, "ann", date(2026, 3, 16))
+    assert service.balance("ann") == D("6.00")
+
+
+@pytest.mark.parametrize(
+    "returned_on, fine",
+    [(date(2026, 3, 24), D("0.25")), (date(2026, 3, 27), D("1.00"))],
+)
+def test_late_book_is_a_quarter_per_open_day(service, clock, returned_on, fine):  # 5
+    service.checkout("ann", "B1")  # due Mon 23 Mar
+    clock.set(returned_on)
+    service.return_copy("B1")
+    assert service.balance("ann") == fine
+
+
+def test_sunday_after_saturday_due_date_is_not_a_late_day(service, clock):  # 6
+    clock.set(date(2026, 3, 7))  # Saturday
+    loan = service.checkout("ann", "D1")
+    assert loan.due_on == date(2026, 3, 14)  # Saturday
+    clock.set(date(2026, 3, 16))  # Monday
+    service.return_copy("D1")
+    assert service.balance("ann") == D("1.00")
+
+
+@pytest.mark.parametrize(
+    "returned_on, fine",
+    [
+        (date(2026, 3, 21), D("11.00")),  # 11 open days late
+        (date(2026, 3, 23), D("12.00")),  # 12 open days: exactly the cap
+        (date(2026, 4, 2), D("12.00")),  # 21 open days late, capped
+    ],
+)
+def test_fine_is_capped_at_replacement_cost(service, clock, returned_on, fine):  # 7
+    late_dvd_return(service, clock, "ann", returned_on)
+    assert service.balance("ann") == fine
+
+
+def test_children_are_never_fined(service, clock):  # 8
+    loan = late_dvd_return(service, clock, "kid", date(2026, 4, 30))
+    assert service.balance("kid") == D("0")
+    assert loan.returned_on == date(2026, 4, 30)
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("kid") == []
+
+
+def test_late_return_still_returns_the_closed_loan(service, clock):  # 9
+    loan = service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 16))
+    returned = service.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == date(2026, 3, 16)
+    assert not returned.is_open
+
+
+def test_each_late_return_adds_its_own_fine(service, clock):  # 10
+    service.checkout("ann", "D1")  # due Mon 9 Mar
+    service.checkout("ann", "B1")  # due Mon 23 Mar
+    clock.set(date(2026, 3, 11))
+    service.return_copy("D1")  # 2 days: 2.00
+    clock.set(date(2026, 3, 25))
+    service.return_copy("B1")  # 2 days: 0.50
+    assert service.balance("ann") == D("2.50")
+
+
+def test_same_copy_borrowed_twice_late_is_fined_twice(service, clock):  # 10
+    late_dvd_return(service, clock, "ann", date(2026, 3, 10))  # 1.00
+    service.checkout("ann", "D1")  # Tue 10 Mar, due Tue 17 Mar
+    clock.set(date(2026, 3, 18))
+    service.return_copy("D1")  # 1.00
+    assert service.balance("ann") == D("2.00")
+
+
+def test_overdue_copy_still_out_adds_nothing(service, clock):  # 11
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 4, 30))
+    assert service.overdue_loans()  # it really is overdue
+    assert service.balance("ann") == D("0")
+
+
+# charges and payments ----------------------------------------------------
+
+
+def test_add_charge_raises_balance_and_returns_it(service):  # 12
+    assert service.add_charge("ann", D("2.50"), "lost card") == D("2.50")
+    assert service.add_charge("ann", D("1.25"), "damaged case") == D("3.75")
+    assert service.balance("ann") == D("3.75")
+
+
+def test_charge_adds_to_fines(service, clock):  # 12
+    late_dvd_return(service, clock, "ann", date(2026, 3, 10))  # 1.00
+    assert service.add_charge("ann", D("0.50"), "damaged case") == D("1.50")
+
+
+def test_pay_lowers_balance_and_returns_it(service):  # 13
+    service.add_charge("ann", D("5.00"), "lost card")
+    assert service.pay("ann", D("1.50")) == D("3.50")
+    assert service.pay("ann", D("3.50")) == D("0")
+    assert service.balance("ann") == D("0")
+
+
+@pytest.mark.parametrize("owed, paid", [("2.00", "2.01"), ("0", "0.01")])
+def test_overpayment_is_rejected(service, owed, paid):  # 14
+    if D(owed):
+        service.add_charge("ann", D(owed), "lost card")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", D(paid))
+    assert service.balance("ann") == D(owed)
+
+
+BAD_AMOUNTS = [
+    D("0"),
+    D("0.00"),
+    D("-1.00"),
+    D("0.001"),
+    D("1.005"),
+    D("NaN"),
+    D("Infinity"),
+    D("1E+30"),
+    0.5,  # float: money is Decimal
+    "1.00",
+]
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_bad_charge_amount_is_rejected(service, amount):  # 15
+    service.add_charge("ann", D("3.00"), "lost card")
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", amount, "lost card")
+    assert service.balance("ann") == D("3.00")
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_bad_payment_amount_is_rejected(service, amount):  # 15
+    service.add_charge("ann", D("3.00"), "lost card")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", amount)
+    assert service.balance("ann") == D("3.00")
+
+
+def test_whole_cent_amounts_with_other_spellings_are_accepted(service):  # 15
+    assert service.add_charge("ann", D("2.5"), "lost card") == D("2.50")
+    assert service.add_charge("ann", 3, "lost card") == D("5.50")
+    assert service.pay("ann", D("0.500")) == D("5.00")
+
+
+# blocking -----------------------------------------------------------------
+
+
+def test_owing_ten_blocks_checkout(service):  # 16
+    service.add_charge("ann", D("10.00"), "lost card")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("ann") == []
+
+
+def test_owing_just_under_ten_can_borrow(service):  # 16
+    service.add_charge("ann", D("9.99"), "lost card")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+def test_fines_count_toward_the_block(service, clock):  # 16
+    late_dvd_return(service, clock, "ann", date(2026, 3, 21))  # 11.00
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_children_are_blocked_at_the_same_threshold(service):  # 16
+    service.add_charge("kid", D("10.00"), "lost card")
+    with pytest.raises(AccountBlocked):
+        service.checkout("kid", "B1")
+
+
+def test_blocked_member_can_return_pay_and_borrow_again(service, clock):  # 17
+    service.checkout("ann", "B1")
+    service.add_charge("ann", D("12.00"), "lost card")
+    clock.advance(1)
+    service.return_copy("B1")
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.pay("ann", D("2.01")) == D("9.99")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+def test_blocked_member_returning_late_is_still_fined(service, clock):  # 17
+    service.checkout("ann", "D1")
+    service.add_charge("ann", D("10.00"), "lost card")
+    clock.set(date(2026, 3, 10))
+    service.return_copy("D1")
+    assert service.balance("ann") == D("11.00")
+
+
+def test_block_is_checked_before_availability(service):  # 18
+    service.checkout("kid", "B1")
+    service.add_charge("ann", D("10.00"), "lost card")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_unknown_member_and_copy_are_checked_before_block(service):  # 18
+    service.add_charge("ann", D("10.00"), "lost card")
+    with pytest.raises(MemberNotFound):
+        service.checkout("nobody", "B1")
+    with pytest.raises(CopyNotFound):
+        service.checkout("ann", "NOPE")
+
+
+def test_new_errors_are_lending_errors():  # 19
+    assert issubclass(AccountBlocked, LendingError)
+    assert issubclass(InvalidAmount, LendingError)
+
+
+def test_account_blocked_says_who_and_how_much(service):  # 16
+    service.add_charge("ann", D("10.50"), "lost card")
+    with pytest.raises(AccountBlocked) as caught:
+        service.checkout("ann", "B1")
+    assert caught.value.member_id == "ann"
+    assert caught.value.balance == D("10.50")
+
+
+def test_overdue_report_ignores_fines(service, clock):  # 20
+    service.checkout("ann", "D1")
+    service.add_charge("ann", D("3.00"), "lost card")
+    lines = overdue_report(service, as_of=date(2026, 3, 12))
+    assert [(l.copy_id, l.days_overdue) for l in lines] == [("D1", 3)]

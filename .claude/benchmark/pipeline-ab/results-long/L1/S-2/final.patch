@@ -0,0 +1,224 @@
+"""Renewals. Comments give the SPEC.md "Spec: renewals" criterion each test covers."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Material
+from lending.errors import AccountBlocked, LendingError, LoanNotFound, RenewalRefused
+from lending.reports import overdue_report
+
+# Book loans made at START (Mon 2 Mar 2026) are due Mon 23 Mar 2026.
+DUE = date(2026, 3, 23)
+
+
+@pytest.fixture
+def book_loan(service):
+    return service.checkout("ann", "B1")
+
+
+def test_renewal_refused_is_a_lending_error_and_loans_start_unrenewed(book_loan):  # 1
+    assert issubclass(RenewalRefused, LendingError)
+    assert book_loan.renewals == 0
+
+
+def test_renewal_extends_the_same_loan_in_place(service, clock, book_loan):  # 2
+    clock.set(date(2026, 3, 19))
+    renewed = service.renew(book_loan.loan_id)
+    assert renewed.loan_id == book_loan.loan_id
+    assert renewed.copy_id == "B1"
+    assert renewed.member_id == "ann"
+    assert renewed.borrowed_on == date(2026, 3, 2)
+    assert renewed.is_open
+    assert renewed.renewals == 1
+    assert service.get_loan(book_loan.loan_id).renewals == 1
+    assert service.get_copy("B1").status is CopyStatus.ON_LOAN
+    assert [l.loan_id for l in service.loan_history("ann")] == [book_loan.loan_id]
+
+
+def test_new_due_date_counts_from_the_renewal_day(service, clock, book_loan):  # 3
+    clock.set(date(2026, 3, 19))  # Thursday
+    assert service.renew(book_loan.loan_id).due_on == date(2026, 4, 9)
+
+
+def test_new_due_date_never_falls_on_a_sunday(service, clock, book_loan):  # 4
+    clock.set(date(2026, 3, 22))  # Sunday: +21 days is Sunday 12 April
+    assert service.renew(book_loan.loan_id).due_on == date(2026, 4, 13)
+
+
+@pytest.mark.parametrize("day", [date(2026, 3, 18), DUE])
+def test_renewable_from_five_days_before_due(service, clock, book_loan, day):  # 5
+    clock.set(day)
+    assert service.renew(book_loan.loan_id).renewals == 1
+
+
+def test_too_early_to_renew(service, clock, book_loan):  # 5
+    clock.set(date(2026, 3, 17))
+    with pytest.raises(RenewalRefused):
+        service.renew(book_loan.loan_id)
+
+
+def test_unknown_loan_cannot_be_renewed(service):  # 6
+    with pytest.raises(LoanNotFound):
+        service.renew("L9999")
+
+
+def test_returned_loan_cannot_be_renewed(service, clock, book_loan):  # 7
+    clock.set(date(2026, 3, 19))
+    service.return_copy("B1")
+    with pytest.raises(RenewalRefused):
+        service.renew(book_loan.loan_id)
+
+
+def test_dvds_are_never_renewable(service, clock):  # 8
+    loan = service.checkout("ann", "D1")  # due Mon 9 Mar
+    clock.set(date(2026, 3, 7))
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+
+
+@pytest.mark.parametrize("member", ["ann", "kid"])
+def test_at_most_two_renewals(service, clock, member):  # 9
+    loan = service.checkout(member, "B1")
+    clock.set(date(2026, 3, 18))
+    service.renew(loan.loan_id)  # due Wed 8 Apr
+    clock.set(date(2026, 4, 3))
+    service.renew(loan.loan_id)  # due Fri 24 Apr
+    clock.set(date(2026, 4, 20))
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+    assert loan.renewals == 2
+    assert loan.due_on == date(2026, 4, 24)
+
+
+@pytest.mark.parametrize("member", ["ann", "kid"])
+def test_owing_anything_blocks_renewal(service, clock, member):  # 10
+    loan = service.checkout(member, "B1")
+    service.add_charge(member, Decimal("0.01"), "damaged case")
+    clock.set(date(2026, 3, 19))
+    with pytest.raises(AccountBlocked):
+        service.renew(loan.loan_id)
+    service.pay(member, Decimal("0.01"))
+    assert service.renew(loan.loan_id).renewals == 1
+
+
+def test_waiting_hold_blocks_renewal(service, clock, book_loan):  # 11
+    service.register_member("bob", "Bob Adult")
+    service.checkout("kid", "B2")
+    service.place_hold("bob", "978-1")
+    clock.set(date(2026, 3, 19))
+    with pytest.raises(RenewalRefused):
+        service.renew(book_loan.loan_id)
+
+
+def test_ready_hold_does_not_block_renewal(service, clock, book_loan):  # 11
+    service.register_member("bob", "Bob Adult")
+    service.checkout("kid", "B2")
+    hold = service.place_hold("bob", "978-1")
+    clock.set(date(2026, 3, 19))
+    service.return_copy("B2")  # set aside for bob
+    assert hold.copy_id == "B2"
+    assert service.renew(book_loan.loan_id).renewals == 1
+
+
+def test_refused_renewal_changes_nothing(service, clock, book_loan):  # 12
+    service.register_member("bob", "Bob Adult")
+    service.checkout("kid", "B2")
+    service.place_hold("bob", "978-1")
+    clock.set(date(2026, 3, 26))  # 3 open days overdue
+    with pytest.raises(RenewalRefused):
+        service.renew(book_loan.loan_id)
+    assert book_loan.due_on == DUE
+    assert book_loan.renewals == 0
+    assert service.balance("ann") == Decimal("0.00")
+
+
+def test_too_early_refusal_changes_nothing(service, clock, book_loan):  # 12
+    clock.set(date(2026, 3, 10))
+    with pytest.raises(RenewalRefused):
+        service.renew(book_loan.loan_id)
+    assert book_loan.due_on == DUE
+    assert book_loan.renewals == 0
+
+
+def test_overdue_renewal_posts_the_fine_so_far(service, clock, book_loan):  # 13
+    clock.set(date(2026, 3, 26))  # Thu: 24, 25, 26 March late
+    renewed = service.renew(book_loan.loan_id)
+    assert service.balance("ann") == Decimal("0.75")
+    assert renewed.renewals == 1
+    assert renewed.due_on == date(2026, 4, 16)
+
+
+def test_return_after_renewal_fines_only_from_the_new_due_date(
+    service, clock, book_loan
+):  # 14
+    clock.set(date(2026, 3, 26))
+    service.renew(book_loan.loan_id)  # 0.75 posted; due Thu 16 Apr
+    clock.set(date(2026, 4, 20))  # Mon: 17, 18, 20 April late (19th is Sunday)
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_on_time_return_after_overdue_renewal_adds_nothing(
+    service, clock, book_loan
+):  # 14
+    clock.set(date(2026, 3, 26))
+    service.renew(book_loan.loan_id)
+    clock.set(date(2026, 4, 16))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("0.75")
+
+
+def test_child_renewing_late_is_not_fined(service, clock):  # 15
+    loan = service.checkout("kid", "B1")
+    clock.set(date(2026, 3, 26))
+    assert service.renew(loan.loan_id).renewals == 1
+    assert service.balance("kid") == Decimal("0.00")
+
+
+def test_cap_covers_the_whole_loan(service, clock):  # 16
+    service.add_title("978-5", "Pamphlet", Material.BOOK, Decimal("1.50"))
+    service.add_copy("C1", "978-5")
+    loan = service.checkout("ann", "C1")  # due Mon 23 Mar
+    clock.set(date(2026, 3, 27))  # 4 open days late: 1.00
+    service.renew(loan.loan_id)  # due Fri 17 Apr
+    assert service.balance("ann") == Decimal("1.00")
+    clock.set(date(2026, 4, 23))  # 5 open days late: 1.25, but only 0.50 left
+    service.return_copy("C1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_cap_reached_at_renewal_leaves_nothing_for_the_return(service, clock):  # 16
+    service.add_title("978-5", "Pamphlet", Material.BOOK, Decimal("1.00"))
+    service.add_copy("C1", "978-5")
+    loan = service.checkout("ann", "C1")
+    clock.set(date(2026, 3, 31))  # 7 open days late: 1.75, capped at 1.00
+    service.renew(loan.loan_id)
+    assert service.balance("ann") == Decimal("1.00")
+    clock.set(date(2026, 5, 4))
+    service.return_copy("C1")
+    assert service.balance("ann") == Decimal("1.00")
+
+
+def test_unpaid_renewal_fine_blocks_the_next_renewal(service, clock, book_loan):  # 17
+    clock.set(date(2026, 3, 26))
+    service.renew(book_loan.loan_id)  # 0.75 posted; due Thu 16 Apr
+    clock.set(date(2026, 4, 14))
+    with pytest.raises(AccountBlocked):
+        service.renew(book_loan.loan_id)
+    service.pay("ann", Decimal("0.75"))
+    assert service.renew(book_loan.loan_id).renewals == 2
+
+
+def test_renewed_loan_is_overdue_only_after_its_new_due_date(
+    service, clock, book_loan
+):  # 18
+    clock.set(date(2026, 3, 19))
+    service.renew(book_loan.loan_id)  # due Thu 9 Apr
+    assert service.overdue_loans(date(2026, 3, 24)) == []
+    assert overdue_report(service, date(2026, 4, 9)) == []
+    [line] = overdue_report(service, date(2026, 4, 10))
+    assert line.loan_id == book_loan.loan_id
+    assert line.due_on == date(2026, 4, 9)
+    assert line.days_overdue == 1

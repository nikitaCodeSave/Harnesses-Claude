@@ -41,3 +42,83 @@ def due_date(material: Material, borrowed_on: date) -> date:
 
 def loan_limit(category: MemberCategory) -> int:
     return LOAN_LIMITS[category]
+
+
+# fines and accounts ---------------------------------------------------
+
+FINE_PER_LATE_DAY: dict[Material, Decimal] = {
+    Material.BOOK: Decimal("0.25"),
+    Material.DVD: Decimal("1.00"),
+}
+
+# A member owing this much or more may not borrow.
+BORROW_BLOCK_THRESHOLD = Decimal("10.00")
+
+CENT = Decimal("0.01")
+
+
+def pays_fees(category: MemberCategory) -> bool:
+    """Children are never charged fines or fees."""
+    return category is not MemberCategory.CHILD
+
+
+def late_days(due_on: date, returned_on: date) -> int:
+    """Open days after ``due_on`` up to and including ``returned_on``."""
+    days = 0
+    day = due_on + timedelta(days=1)
+    while day <= returned_on:
+        if is_open_day(day):
+            days += 1
+        day += timedelta(days=1)
+    return days
+
+
+def overdue_fine(
+    material: Material,
+    category: MemberCategory,
+    due_on: date,
+    returned_on: date,
+    replacement_cost: Decimal,
+) -> Decimal:
+    """Fine for a loan due ``due_on`` as if handed back on ``returned_on``.
+
+    Capped at the title's replacement cost; zero for members who don't pay fees.
+    """
+    if not pays_fees(category):
+        return Decimal("0.00")
+    fine = FINE_PER_LATE_DAY[material] * late_days(due_on, returned_on)
+    return min(fine, replacement_cost).quantize(CENT)
+
+
+# holds -----------------------------------------------------------------
+
+# A member owing this much or more may not place a hold; lower than borrowing.
+HOLD_BLOCK_THRESHOLD = Decimal("5.00")
+
+HOLD_PICKUP_DAYS = 7
+
+# Posted when a copy set aside on the hold shelf isn't collected in time.
+NO_SHOW_FEE = Decimal("1.00")
+
+
+def pickup_by(set_aside_on: date) -> date:
+    """Last day to collect a copy set aside on ``set_aside_on``; never a closed day."""
+    return next_open_day(set_aside_on + timedelta(days=HOLD_PICKUP_DAYS))
+
+
+# renewals --------------------------------------------------------------
+
+RENEWABLE_MATERIALS: frozenset[Material] = frozenset({Material.BOOK})
+
+MAX_RENEWALS = 2
+
+# A loan can be renewed from this many days before its due date onwards.
+RENEWAL_WINDOW_DAYS = 5
+
+# Only paid-up members may renew: owing even a cent blocks it.
+RENEW_BLOCK_THRESHOLD = CENT
+
+
+def renewable_from(due_on: date) -> date:
+    """First day a loan due ``due_on`` may be renewed."""
+    return due_on - timedelta(days=RENEWAL_WINDOW_DAYS)

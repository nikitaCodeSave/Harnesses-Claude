+++ b/tests/test_renewals.py
@@ -0,0 +1,238 @@
+"""Renewals. Numbers in comments refer to the Renewals criteria in SPEC.md."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import LendingError, LoanNotFound, RenewalRefused
+
+# From conftest: START is Mon 2 March 2026. Book B1/B2 due Mon 23 March,
+# renewable from Wed 18 March. DVD D1 due Mon 9 March.
+
+DUE = date(2026, 3, 23)
+WINDOW_OPENS = date(2026, 3, 18)
+
+
+def renew_on(service, clock, loan_id, day):
+    clock.set(day)
+    return service.renew(loan_id)
+
+
+def snapshot(service, loan):
+    return (
+        loan.due_on,
+        loan.renewals,
+        loan.returned_on,
+        service.balance(loan.member_id),
+        service.get_copy(loan.copy_id).status,
+    )
+
+
+@pytest.fixture
+def cheap(service):
+    """A book whose replacement cost (1.00) is reached after 4 late days."""
+    service.add_title("978-9", "Pamphlet", Material.BOOK, Decimal("1.00"))
+    service.add_copy("C1", "978-9")
+    return "C1"
+
+
+# renewing in place -----------------------------------------------------
+
+
+def test_new_loan_has_no_renewals(service):  # 1
+    assert service.checkout("ann", "B1").renewals == 0
+
+
+def test_renewal_extends_the_same_loan(service, clock):  # 2
+    loan = service.checkout("ann", "B1")
+    renewed = renew_on(service, clock, loan.loan_id, WINDOW_OPENS)
+    assert renewed is loan
+    assert service.get_loan(loan.loan_id) is loan
+    assert (renewed.loan_id, renewed.copy_id, renewed.member_id) == (
+        loan.loan_id, "B1", "ann",
+    )
+    assert renewed.borrowed_on == date(2026, 3, 2)
+    assert renewed.is_open
+    assert renewed.renewals == 1
+    assert renewed.due_on == date(2026, 4, 8)  # Wed 18 March + 21
+
+
+def test_renewal_keeps_one_loan_on_loan(service, clock):  # 3
+    loan = service.checkout("ann", "B1")
+    renew_on(service, clock, loan.loan_id, WINDOW_OPENS)
+    assert service.get_copy("B1").status is CopyStatus.ON_LOAN
+    assert [l.loan_id for l in service.open_loans("ann")] == [loan.loan_id]
+    assert [l.loan_id for l in service.loan_history("ann")] == [loan.loan_id]
+
+
+def test_new_due_date_moves_off_sunday(service, clock):  # 4
+    loan = service.checkout("ann", "B1")
+    renewed = renew_on(service, clock, loan.loan_id, date(2026, 3, 22))  # Sunday
+    assert renewed.due_on == date(2026, 4, 13)  # Sun 12 April -> Monday
+
+
+# when a renewal is refused ---------------------------------------------
+
+
+def test_window_opens_five_days_before_due(service, clock):  # 5
+    loan = service.checkout("ann", "B1")
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)  # borrow day
+    with pytest.raises(RenewalRefused):
+        renew_on(service, clock, loan.loan_id, date(2026, 3, 17))
+    assert loan.due_on == DUE and loan.renewals == 0
+    renew_on(service, clock, loan.loan_id, WINDOW_OPENS)
+    assert loan.renewals == 1
+
+
+def test_at_most_two_renewals(service, clock):  # 6
+    loan = service.checkout("ann", "B1")
+    renew_on(service, clock, loan.loan_id, WINDOW_OPENS)  # due Wed 8 April
+    renew_on(service, clock, loan.loan_id, date(2026, 4, 3))  # due Fri 24 April
+    assert loan.renewals == 2
+    clock.set(date(2026, 4, 20))
+    before = snapshot(service, loan)
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+    assert snapshot(service, loan) == before
+    assert loan.renewals == 2
+
+
+def test_dvds_cannot_be_renewed(service, clock):  # 7
+    loan = service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 9))
+    before = snapshot(service, loan)
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+    assert snapshot(service, loan) == before
+
+
+def test_returned_loan_cannot_be_renewed(service, clock):  # 8
+    loan = service.checkout("ann", "B1")
+    clock.set(WINDOW_OPENS)
+    service.return_copy("B1")
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+    assert loan.renewals == 0 and loan.due_on == DUE
+
+
+def test_unknown_loan_is_not_found(service):  # 8
+    with pytest.raises(LoanNotFound):
+        service.renew("L9999")
+
+
+def test_any_balance_owed_blocks_renewal(service, clock):  # 9
+    loan = service.checkout("ann", "B1")
+    service.add_charge("ann", Decimal("0.01"), "lost bookmark")
+    clock.set(WINDOW_OPENS)
+    before = snapshot(service, loan)
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+    assert snapshot(service, loan) == before
+    service.pay("ann", Decimal("0.01"))
+    assert service.renew(loan.loan_id).renewals == 1
+
+
+def test_waiting_queue_blocks_renewal_ready_hold_does_not(service, clock):  # 10
+    service.register_member("bob", "Bob Adult")
+    loan = service.checkout("ann", "B1")
+    service.checkout("bob", "B2")
+    hold = service.place_hold("kid", "978-1")
+    clock.set(WINDOW_OPENS)
+    before = snapshot(service, loan)
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+    assert snapshot(service, loan) == before
+    assert hold.status is HoldStatus.WAITING
+
+    service.return_copy("B2")  # set aside for kid; nobody left waiting
+    assert hold.status is HoldStatus.READY
+    assert service.renew(loan.loan_id).renewals == 1
+
+
+def test_loan_limit_does_not_apply(service, clock):  # 11
+    service.add_copy("B3", "978-1")
+    service.add_copy("B4", "978-1")
+    loans = [service.checkout("kid", c) for c in ("B1", "B2", "B3", "B4")]
+    assert len(service.open_loans("kid")) == 4  # a child's limit
+    assert renew_on(service, clock, loans[0].loan_id, WINDOW_OPENS).renewals == 1
+
+
+# fines -----------------------------------------------------------------
+
+
+def test_overdue_renewal_charges_fine_so_far(service, clock):  # 12
+    loan = service.checkout("ann", "B1")
+    renew_on(service, clock, loan.loan_id, date(2026, 3, 26))  # Tue, Wed, Thu late
+    assert service.balance("ann") == Decimal("0.75")
+    assert loan.due_on == date(2026, 4, 16)
+    assert loan.renewals == 1
+
+
+@pytest.mark.parametrize("day", [WINDOW_OPENS, DUE])
+def test_renewal_on_or_before_due_is_free(service, clock, day):  # 13
+    loan = service.checkout("ann", "B1")
+    renew_on(service, clock, loan.loan_id, day)
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_return_by_new_due_date_charges_nothing_more(service, clock):  # 14
+    loan = service.checkout("ann", "B1")
+    renew_on(service, clock, loan.loan_id, date(2026, 3, 26))
+    clock.set(date(2026, 4, 16))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("0.75")
+
+
+def test_late_return_after_renewal_counts_from_new_due_date(service, clock):  # 14
+    loan = service.checkout("ann", "B1")
+    renew_on(service, clock, loan.loan_id, date(2026, 3, 26))
+    clock.set(date(2026, 4, 18))  # Fri 17, Sat 18
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.25")
+
+
+def test_child_overdue_renewal_is_free(service, clock):  # 15
+    loan = service.checkout("kid", "B1")
+    renew_on(service, clock, loan.loan_id, date(2026, 4, 10))
+    assert service.balance("kid") == Decimal("0")
+    assert loan.renewals == 1
+
+
+def test_renewal_fine_is_capped(service, clock, cheap):  # 16
+    loan = service.checkout("ann", cheap)
+    renew_on(service, clock, loan.loan_id, date(2026, 3, 30))  # 6 late days
+    assert service.balance("ann") == Decimal("1.00")
+    clock.set(date(2026, 5, 15))  # long after the new due date
+    service.return_copy(cheap)
+    assert service.balance("ann") == Decimal("1.00")
+
+
+def test_cap_covers_renewal_and_return_together(service, clock, cheap):  # 16
+    loan = service.checkout("ann", cheap)
+    renew_on(service, clock, loan.loan_id, date(2026, 3, 26))  # 0.75
+    service.pay("ann", Decimal("0.75"))
+    clock.set(date(2026, 4, 20))  # 16 April due; 17, 18, 20 late = 0.75
+    service.return_copy(cheap)
+    assert service.balance("ann") == Decimal("0.25")  # 1.00 cap less 0.75
+
+
+def test_refused_overdue_renewal_keeps_lateness(service, clock):  # 17
+    service.register_member("bob", "Bob Adult")
+    loan = service.checkout("ann", "B1")
+    service.checkout("bob", "B2")
+    service.place_hold("kid", "978-1")
+    clock.set(date(2026, 3, 26))
+    before = snapshot(service, loan)
+    with pytest.raises(RenewalRefused):
+        service.renew(loan.loan_id)
+    assert snapshot(service, loan) == before
+    assert service.balance("ann") == Decimal("0")
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("0.75")
+
+
+def test_renewal_refused_is_a_lending_error():  # 18
+    assert issubclass(RenewalRefused, LendingError)

 def loan_limit(category: MemberCategory) -> int:
     return LOAN_LIMITS[category]
+
+
+# Fines -----------------------------------------------------------------
+
+FINE_PER_LATE_DAY: dict[Material, Decimal] = {
+    Material.BOOK: Decimal("0.25"),
+    Material.DVD: Decimal("1.00"),
+}
+
+# Categories that are never fined for late returns.
+FINE_EXEMPT: frozenset[MemberCategory] = frozenset({MemberCategory.CHILD})
+
+# A member owing this much or more cannot borrow.
+BLOCK_THRESHOLD = Decimal("10.00")
+
+CENT = Decimal("0.01")
+
+
+def late_days(due_on: date, returned_on: date) -> int:
+    """Open days after ``due_on`` up to and including ``returned_on``.
+
+    Closed days don't count: nobody could have brought the copy back then.
+    """
+    days = 0
+    day = due_on + timedelta(days=1)
+    while day <= returned_on:
+        if is_open_day(day):
+            days += 1
+        day += timedelta(days=1)
+    return days
+
+
+def overdue_fine(
+    material: Material,
+    category: MemberCategory,
+    due_on: date,
+    returned_on: date,
+    replacement_cost: Decimal,
+    already_fined: Decimal = Decimal("0"),
+) -> Decimal:
+    """Fine for one loan, never more than replacing the copy.
+
+    ``already_fined`` is what the loan was charged at earlier renewals; the
+    loan's fines all together stay within the replacement cost.
+    """
+    if category in FINE_EXEMPT:
+        return Decimal("0.00")
+    fine = FINE_PER_LATE_DAY[material] * late_days(due_on, returned_on)
+    headroom = max(replacement_cost - already_fined, Decimal("0"))
+    return min(fine, headroom).quantize(CENT)
+
+
+def is_blocked(balance: Decimal) -> bool:
+    return balance >= BLOCK_THRESHOLD
+
+
+# Renewals --------------------------------------------------------------
+
+RENEWABLE_MATERIALS: frozenset[Material] = frozenset({Material.BOOK})
+
+MAX_RENEWALS = 2
+
+# A loan can be renewed from this many calendar days before it is due.
+RENEWAL_WINDOW_DAYS = 5
+
+
+def renewable_from(due_on: date) -> date:
+    return due_on - timedelta(days=RENEWAL_WINDOW_DAYS)
+
+
+# Holds -----------------------------------------------------------------
+
+# A member owing this much or more cannot place a hold. Lower than the
+# borrowing bar: a hold ties up a copy for someone who already owes.
+HOLD_BLOCK_THRESHOLD = Decimal("5.00")
+
+PICKUP_DAYS = 7
+
+# Charged when a copy set aside for a hold is not collected in time.
+NO_SHOW_FEE = Decimal("1.00")
+
+# Categories that never pay the no-show fee.
+NO_SHOW_EXEMPT: frozenset[MemberCategory] = frozenset({MemberCategory.CHILD})
+
+
+def pickup_by(set_aside_on: date) -> date:
+    """Last day to collect a held copy, never a closed day."""
+    return next_open_day(set_aside_on + timedelta(days=PICKUP_DAYS))
+
+
+def is_hold_blocked(balance: Decimal) -> bool:
+    return balance >= HOLD_BLOCK_THRESHOLD

@@ -0,0 +1,249 @@
+"""Overdue fines and member accounts. Numbers in comments refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Material
+from lending.errors import AccountBlocked, InvalidAmount, LendingError, MemberNotFound
+
+# From conftest: START is Mon 2 March 2026. Book B1/B2 due Mon 23 March,
+# DVD D1 (replacement 12.00) due Mon 9 March.
+
+
+def return_on(service, clock, copy_id, day):
+    clock.set(day)
+    return service.return_copy(copy_id)
+
+
+# fines -----------------------------------------------------------------
+
+
+def test_new_member_owes_nothing(service):  # 1
+    assert service.balance("ann") == Decimal("0")
+
+
+@pytest.mark.parametrize("day", [date(2026, 3, 23), date(2026, 3, 10)])
+def test_return_on_or_before_due_date_is_free(service, clock, day):  # 2
+    service.checkout("ann", "B1")
+    return_on(service, clock, "B1", day)
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_book_one_day_late_costs_25_cents(service, clock):  # 3
+    service.checkout("ann", "B1")
+    return_on(service, clock, "B1", date(2026, 3, 24))
+    assert service.balance("ann") == Decimal("0.25")
+
+
+def test_sundays_are_not_late_days(service, clock):  # 4
+    service.checkout("ann", "B1")
+    return_on(service, clock, "B1", date(2026, 3, 30))  # 7 days, Sun 29th free
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_dvd_costs_1_00_per_late_day(service, clock):  # 5
+    service.checkout("ann", "D1")
+    return_on(service, clock, "D1", date(2026, 3, 12))  # Tue, Wed, Thu
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_saturday_due_returned_monday_is_one_late_day(service, clock):  # 6
+    clock.set(date(2026, 3, 7))  # Saturday: DVD due Saturday 14 March
+    loan = service.checkout("ann", "D1")
+    assert loan.due_on == date(2026, 3, 14)
+    return_on(service, clock, "D1", date(2026, 3, 16))
+    assert service.balance("ann") == Decimal("1.00")
+
+
+def test_children_are_never_fined(service, clock):  # 7
+    loan = service.checkout("kid", "D1")
+    returned = return_on(service, clock, "D1", date(2026, 4, 9))
+    assert returned.loan_id == loan.loan_id and not returned.is_open
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.balance("kid") == Decimal("0")
+
+
+def test_fine_is_capped_at_replacement_cost(service, clock):  # 8
+    service.checkout("ann", "D1")
+    return_on(service, clock, "D1", date(2026, 4, 9))  # 27 open days late
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_fines_from_separate_returns_add_up(service, clock):  # 9
+    service.checkout("ann", "B1")
+    service.checkout("ann", "D1")
+    return_on(service, clock, "D1", date(2026, 3, 10))  # 1.00
+    return_on(service, clock, "B1", date(2026, 3, 24))  # 0.25
+    assert service.balance("ann") == Decimal("1.25")
+
+
+def test_unreturned_overdue_copy_adds_nothing(service, clock):  # 10
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 4, 9))
+    assert service.balance("ann") == Decimal("0")
+    service.checkout("ann", "B1")  # not blocked either
+
+
+def test_return_copy_still_returns_the_closed_loan(service, clock):  # 11
+    loan = service.checkout("ann", "D1")
+    returned = return_on(service, clock, "D1", date(2026, 3, 12))
+    assert returned is service.get_loan(loan.loan_id)
+    assert returned.returned_on == date(2026, 3, 12)
+
+
+# charges and payments --------------------------------------------------
+
+
+def test_add_charge_returns_new_balance(service):  # 12
+    assert service.add_charge("ann", Decimal("2.50"), "lost case") == Decimal("2.50")
+    assert service.add_charge("ann", Decimal("1.5"), "torn page") == Decimal("4.00")
+    assert service.balance("ann") == Decimal("4.00")
+
+
+def test_pay_lowers_balance_and_full_payment_clears_it(service):  # 13
+    service.add_charge("ann", Decimal("5.00"), "lost case")
+    assert service.pay("ann", Decimal("1.75")) == Decimal("3.25")
+    assert service.pay("ann", Decimal("3.25")) == Decimal("0")
+    assert service.balance("ann") == Decimal("0")
+
+
+# blocking --------------------------------------------------------------
+
+
+@pytest.mark.parametrize("owed", ["10.00", "10.01", "25.00"])
+def test_owing_ten_or_more_blocks_checkout(service, owed):  # 14, 17
+    service.add_charge("ann", Decimal(owed), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_late_fine_reaching_exactly_ten_blocks(service, clock):  # 14
+    service.checkout("ann", "D1")
+    return_on(service, clock, "D1", date(2026, 3, 20))  # 10 open days late
+    assert service.balance("ann") == Decimal("10.00")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_owing_just_under_ten_can_borrow(service):  # 15
+    service.add_charge("ann", Decimal("9.99"), "damaged disc")
+    service.checkout("ann", "B1")
+
+
+def test_paying_down_lifts_the_block(service):  # 16
+    service.add_charge("ann", Decimal("12.00"), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    service.pay("ann", Decimal("2.01"))
+    service.checkout("ann", "B1")
+
+
+def test_same_threshold_for_children(service):  # 14
+    service.add_charge("kid", Decimal("10.00"), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        service.checkout("kid", "B1")
+
+
+def test_blocked_checkout_changes_nothing(service):  # 18
+    service.add_charge("ann", Decimal("10.00"), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.open_loans("ann") == []
+    assert service.loan_history("ann") == []
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.balance("ann") == Decimal("10.00")
+
+
+def test_blocked_member_can_still_return_pay_and_be_charged(service, clock):  # 19
+    service.checkout("ann", "D1")
+    service.add_charge("ann", Decimal("10.00"), "damaged disc")
+    return_on(service, clock, "D1", date(2026, 3, 10))
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.balance("ann") == Decimal("11.00")
+    assert service.add_charge("ann", Decimal("1.00"), "replacement card") == Decimal("12.00")
+    assert service.pay("ann", Decimal("12.00")) == Decimal("0")
+
+
+def test_late_return_can_push_member_over_threshold(service, clock):  # 19
+    service.checkout("ann", "D1")
+    service.add_charge("ann", Decimal("9.00"), "damaged disc")
+    return_on(service, clock, "D1", date(2026, 3, 10))  # +1.00
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+# refused amounts -------------------------------------------------------
+
+BAD_AMOUNTS = [
+    Decimal("0"),
+    Decimal("-1.00"),
+    Decimal("0.001"),
+    Decimal("1.005"),
+    Decimal("NaN"),
+    Decimal("Infinity"),
+    1.5,
+    5,
+    "5.00",
+    None,
+]
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_bad_charge_amount_is_refused(service, amount):  # 20
+    service.add_charge("ann", Decimal("3.00"), "lost case")
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", amount, "lost case")
+    assert service.balance("ann") == Decimal("3.00")
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_bad_payment_amount_is_refused(service, amount):  # 20
+    service.add_charge("ann", Decimal("3.00"), "lost case")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", amount)
+    assert service.balance("ann") == Decimal("3.00")
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_charge_needs_a_reason(service, reason):  # 21
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", Decimal("1.00"), reason)
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_overpayment_is_refused(service):  # 22
+    service.add_charge("ann", Decimal("3.00"), "lost case")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("3.01"))
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_cannot_pay_when_nothing_is_owed(service):  # 22
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("0.01"))
+    assert service.balance("ann") == Decimal("0")
+
+
+# unknown members and error types --------------------------------------
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda s: s.balance("nobody"),
+        lambda s: s.add_charge("nobody", Decimal("1.00"), "lost case"),
+        lambda s: s.pay("nobody", Decimal("1.00")),
+        lambda s: s.checkout("nobody", "B1"),
+    ],
+    ids=["balance", "add_charge", "pay", "checkout"],
+)
+def test_unknown_member(service, call):  # 23
+    with pytest.raises(MemberNotFound):
+        call(service)
+
+
+def test_new_errors_are_lending_errors():  # 24
+    assert issubclass(AccountBlocked, LendingError)
+    assert issubclass(InvalidAmount, LendingError)

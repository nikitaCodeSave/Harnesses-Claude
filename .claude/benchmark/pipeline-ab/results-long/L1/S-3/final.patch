@@ -0,0 +1,462 @@
+"""Holds: queueing for a title, the hold shelf, cancellation and expiry.
+
+Numbers in the comments refer to the acceptance criteria in SPEC.md (Holds).
+"""
+
+from datetime import date, timedelta
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    HoldNotAllowed,
+    HoldNotFound,
+    LendingError,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+
+# From conftest: START is Mon 2 March 2026. Copies B1/B2 of the book are due Mon
+# 23 March when borrowed on START; D1 is the only copy of dvd-1.
+START = date(2026, 3, 2)
+BOOK = "978-1"
+
+
+@pytest.fixture
+def held(service):
+    """Both copies of BOOK out with Lou; Bob and Cat register to queue."""
+    service.register_member("lou", "Lou Lender")
+    service.register_member("bob", "Bob Borrower")
+    service.register_member("cat", "Cat Reader")
+    service.checkout("lou", "B1")
+    service.checkout("lou", "B2")
+    return service
+
+
+def ids(holds):
+    return [h.hold_id for h in holds]
+
+
+# placing -----------------------------------------------------------------
+
+
+def test_hold_on_title_with_every_copy_out_waits(held):  # 1
+    hold = held.place_hold("ann", BOOK)
+    assert hold.status is HoldStatus.WAITING
+    assert hold.member_id == "ann" and hold.isbn == BOOK
+    assert hold.placed_on == START
+    assert hold.copy_id is None and hold.pickup_by is None
+    assert held.holds_for(BOOK) == [hold]
+
+
+def test_no_hold_while_a_copy_is_on_the_shelf(service):  # 2
+    service.checkout("ann", "B1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("kid", BOOK)
+
+
+def test_copies_on_the_hold_shelf_count_as_out(held):  # 3
+    held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    assert held.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+    hold = held.place_hold("bob", BOOK)
+    assert hold.status is HoldStatus.WAITING
+
+
+def test_no_hold_on_a_title_without_copies(service):  # 4
+    service.add_title("978-9", "Unbought", Material.BOOK, Decimal("5.00"))
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "978-9")
+
+
+def test_no_hold_on_a_title_whose_copies_are_all_withdrawn(service):  # 4
+    service.withdraw_copy("D1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "dvd-1")
+
+
+def test_one_waiting_hold_per_member_per_title(held):  # 5
+    held.place_hold("ann", BOOK)
+    with pytest.raises(HoldNotAllowed):
+        held.place_hold("ann", BOOK)
+
+
+def test_no_second_hold_while_one_is_ready(held):  # 5
+    held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    with pytest.raises(HoldNotAllowed):
+        held.place_hold("ann", BOOK)
+
+
+def test_no_hold_on_a_title_the_member_has_on_loan(held):  # 6
+    with pytest.raises(HoldNotAllowed):
+        held.place_hold("lou", BOOK)
+
+
+def test_can_hold_again_after_cancel_or_expiry(held, clock):  # 7
+    first = held.place_hold("ann", BOOK)
+    held.cancel_hold(first.hold_id)
+    second = held.place_hold("ann", BOOK)
+    assert second.status is HoldStatus.WAITING
+
+    held.place_hold("bob", BOOK)
+    held.return_copy("B1")  # set aside for ann
+    clock.set(second.pickup_by + timedelta(days=1))
+    assert held.expire_holds() == [second]  # B1 moves on to bob
+    third = held.place_hold("ann", BOOK)
+    assert third.status is HoldStatus.WAITING
+
+
+def test_can_hold_again_after_fulfilment(held):  # 7
+    hold = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    held.checkout("ann", "B1")
+    held.return_copy("B1")
+    assert hold.status is HoldStatus.FULFILLED
+    held.checkout("bob", "B1")  # take the shelf copy so a hold is allowed
+    again = held.place_hold("ann", BOOK)
+    assert again.status is HoldStatus.WAITING
+
+
+def test_hold_block_starts_at_five(held):  # 8
+    held.add_charge("ann", Decimal("5.00"), "lost card")
+    with pytest.raises(AccountBlocked) as err:
+        held.place_hold("ann", BOOK)
+    assert err.value.threshold == Decimal("5.00")
+
+    held.add_charge("bob", Decimal("7.50"), "damage")
+    with pytest.raises(AccountBlocked):
+        held.place_hold("bob", BOOK)
+
+    held.add_charge("cat", Decimal("4.99"), "damage")
+    assert held.place_hold("cat", BOOK).status is HoldStatus.WAITING
+
+
+def test_unknown_member_or_title(held):  # 9
+    with pytest.raises(MemberNotFound):
+        held.place_hold("nobody", BOOK)
+    with pytest.raises(TitleNotFound):
+        held.place_hold("ann", "no-such-isbn")
+    with pytest.raises(TitleNotFound):
+        held.holds_for("no-such-isbn")
+
+
+def test_refused_hold_adds_nothing(held):  # 10
+    held.place_hold("ann", BOOK)
+    before = ids(held.holds_for(BOOK))
+    held.add_charge("bob", Decimal("6.00"), "damage")
+    for member in ("ann", "lou", "bob"):
+        with pytest.raises(LendingError):
+            held.place_hold(member, BOOK)
+    assert ids(held.holds_for(BOOK)) == before
+
+
+def test_children_can_hold(held):  # 11
+    assert held.place_hold("kid", BOOK).status is HoldStatus.WAITING
+
+
+# the queue ----------------------------------------------------------------
+
+
+def test_holds_for_lists_active_holds_in_placing_order(held, clock):  # 12
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)  # same day as ann
+    clock.advance()
+    c = held.place_hold("cat", BOOK)
+    d = held.place_hold("kid", BOOK)
+    held.return_copy("B1")  # ann READY
+    held.cancel_hold(c.hold_id)
+    assert ids(held.holds_for(BOOK)) == [a.hold_id, b.hold_id, d.hold_id]
+    assert held.holds_for("dvd-1") == []
+
+
+def test_holds_for_leaves_out_fulfilled_and_expired(held, clock):  # 12
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    c = held.place_hold("cat", BOOK)
+    held.return_copy("B1")  # ann
+    held.checkout("ann", "B1")
+    held.return_copy("B2")  # bob
+    clock.set(b.pickup_by + timedelta(days=1))
+    held.expire_holds()  # bob expires, B2 goes to cat
+    assert a.status is HoldStatus.FULFILLED
+    assert b.status is HoldStatus.EXPIRED
+    assert held.holds_for(BOOK) == [c]
+
+
+# returns ------------------------------------------------------------------
+
+
+def test_return_sets_copy_aside_for_first_in_line(held):  # 13
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    held.return_copy("B2")
+    assert held.get_copy("B2").status is CopyStatus.ON_HOLD_SHELF
+    assert a.status is HoldStatus.READY
+    assert a.copy_id == "B2"
+    assert a.pickup_by == START + timedelta(days=7)
+    assert b.status is HoldStatus.WAITING and b.copy_id is None
+
+
+def test_pickup_window_ending_on_sunday_moves_to_monday(held, clock):  # 14
+    a = held.place_hold("ann", BOOK)
+    clock.set(date(2026, 3, 8))  # a Sunday: + 7 is Sunday 15 March
+    held.return_copy("B1")
+    assert a.pickup_by == date(2026, 3, 16)
+
+
+def test_return_to_a_hold_still_closes_loan_and_fines(held, clock):  # 15
+    held.place_hold("ann", BOOK)
+    loan = held.open_loans("lou")[0]
+    clock.set(loan.due_on + timedelta(days=1))  # Tue 24 March, 1 late day
+    closed = held.return_copy(loan.copy_id)
+    assert closed is loan
+    assert closed.returned_on == clock.today()
+    assert held.balance("lou") == Decimal("0.25")
+
+
+def test_return_with_nobody_waiting_shelves_copy(held):  # 16
+    held.return_copy("B1")
+    assert held.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+# collecting ---------------------------------------------------------------
+
+
+def test_holder_collects_set_aside_copy(held):  # 17
+    hold = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    loan = held.checkout("ann", "B1")
+    assert loan.member_id == "ann" and loan.copy_id == "B1"
+    assert hold.status is HoldStatus.FULFILLED
+    assert held.holds_for(BOOK) == []
+    assert held.get_copy("B1").status is CopyStatus.ON_LOAN
+
+
+def test_nobody_else_can_take_a_set_aside_copy(held):  # 18
+    hold = held.place_hold("ann", BOOK)
+    held.place_hold("bob", BOOK)
+    held.return_copy("B1")
+    for other in ("bob", "cat"):
+        with pytest.raises(CopyNotAvailable):
+            held.checkout(other, "B1")
+    assert held.open_loans("bob") == [] and held.open_loans("cat") == []
+    assert hold.status is HoldStatus.READY
+    assert held.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_blocked_holder_keeps_ready_hold(held):  # 19
+    hold = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    pickup = hold.pickup_by
+    held.add_charge("ann", Decimal("10.00"), "damage")
+    with pytest.raises(AccountBlocked):
+        held.checkout("ann", "B1")
+    assert hold.status is HoldStatus.READY and hold.pickup_by == pickup
+    assert held.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_holder_at_loan_limit_keeps_ready_hold(held):  # 19
+    held.add_title("978-2", "Short Stories", Material.BOOK, Decimal("10.00"))
+    for n in range(4):
+        held.add_copy(f"S{n}", "978-2")
+    held.place_hold("kid", BOOK)
+    for n in range(4):
+        held.checkout("kid", f"S{n}")
+    held.return_copy("B1")
+    hold = held.holds_for(BOOK)[0]
+    with pytest.raises(LoanLimitReached):
+        held.checkout("kid", "B1")
+    assert hold.status is HoldStatus.READY
+    assert held.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_borrowing_another_copy_fulfils_a_waiting_hold(held):  # 20
+    hold = held.place_hold("ann", BOOK)
+    held.add_copy("B3", BOOK)  # new copies go on the shelf, not to the queue
+    assert held.get_copy("B3").status is CopyStatus.AVAILABLE
+    held.checkout("ann", "B3")
+    assert hold.status is HoldStatus.FULFILLED
+    assert held.holds_for(BOOK) == []
+
+
+def test_borrowing_another_copy_releases_ready_copy_to_next(held):  # 21
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    held.return_copy("B1")  # ann READY with B1
+    held.add_copy("B3", BOOK)
+    held.checkout("ann", "B3")
+    assert a.status is HoldStatus.FULFILLED
+    assert b.status is HoldStatus.READY and b.copy_id == "B1"
+    assert held.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_borrowing_another_copy_shelves_ready_copy_if_nobody_waits(held):  # 21
+    a = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    held.add_copy("B3", BOOK)
+    held.checkout("ann", "B3")
+    assert a.status is HoldStatus.FULFILLED
+    assert held.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+# cancelling ---------------------------------------------------------------
+
+
+def test_cancel_waiting_hold(held):  # 22
+    hold = held.place_hold("ann", BOOK)
+    cancelled = held.cancel_hold(hold.hold_id)
+    assert cancelled is hold and cancelled.status is HoldStatus.CANCELLED
+    assert held.holds_for(BOOK) == []
+
+
+def test_cancel_ready_hold_passes_copy_to_next_in_line(held, clock):  # 23
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    held.return_copy("B1")
+    clock.set(date(2026, 3, 4))  # Wednesday
+    assert held.cancel_hold(a.hold_id).status is HoldStatus.CANCELLED
+    assert b.status is HoldStatus.READY and b.copy_id == "B1"
+    assert b.pickup_by == date(2026, 3, 11)
+    assert held.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+    assert held.balance("ann") == Decimal("0.00")
+
+
+def test_cancel_ready_hold_new_window_skips_sunday(held, clock):  # 23
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    held.return_copy("B1")
+    clock.set(date(2026, 3, 8))  # Sunday; + 7 is Sunday 15 March
+    held.cancel_hold(a.hold_id)
+    assert b.pickup_by == date(2026, 3, 16)
+
+
+def test_cancel_ready_hold_with_nobody_waiting_shelves_copy(held):  # 23
+    a = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    held.cancel_hold(a.hold_id)
+    assert held.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert held.balance("ann") == Decimal("0.00")
+
+
+def test_cancel_inactive_or_unknown_hold(held, clock):  # 24
+    fulfilled = held.place_hold("ann", BOOK)
+    cancelled = held.place_hold("bob", BOOK)
+    expired = held.place_hold("cat", BOOK)
+    held.return_copy("B1")  # ann
+    held.checkout("ann", "B1")
+    held.cancel_hold(cancelled.hold_id)
+    held.return_copy("B2")  # cat
+    clock.set(expired.pickup_by + timedelta(days=1))
+    held.expire_holds()
+    for hold in (fulfilled, cancelled, expired):
+        with pytest.raises(HoldNotAllowed):
+            held.cancel_hold(hold.hold_id)
+    with pytest.raises(HoldNotFound):
+        held.cancel_hold("H9999")
+
+
+# expiry -------------------------------------------------------------------
+
+
+def test_ready_hold_lasts_through_its_pickup_day(held, clock):  # 25
+    hold = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    clock.set(hold.pickup_by)
+    assert held.expire_holds() == []
+    assert hold.status is HoldStatus.READY
+    clock.advance()
+    assert held.expire_holds() == [hold]
+    assert hold.status is HoldStatus.EXPIRED
+
+
+def test_no_show_fee_for_adults_only(held, clock):  # 26
+    adult = held.place_hold("ann", BOOK)
+    child = held.place_hold("kid", BOOK)
+    held.return_copy("B1")
+    held.return_copy("B2")
+    clock.set(adult.pickup_by + timedelta(days=1))
+    assert held.expire_holds() == [adult, child]
+    assert held.balance("ann") == Decimal("1.00")
+    assert held.balance("kid") == Decimal("0.00")
+
+
+def test_expired_copy_goes_to_next_in_line(held, clock):  # 27
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    held.return_copy("B1")
+    clock.set(date(2026, 3, 11))  # Wednesday, after ann's Monday 9 March
+    held.expire_holds()
+    assert b.status is HoldStatus.READY and b.copy_id == "B1"
+    assert b.pickup_by == date(2026, 3, 18)
+    assert held.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_expiry_run_on_sunday_gives_monday_window(held, clock):  # 27
+    held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    held.return_copy("B1")
+    clock.set(date(2026, 3, 15))  # Sunday; + 7 is Sunday 22 March
+    held.expire_holds()
+    assert b.pickup_by == date(2026, 3, 23)
+
+
+def test_expired_copy_with_nobody_waiting_is_shelved(held, clock):  # 27
+    a = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    clock.set(a.pickup_by + timedelta(days=1))
+    held.expire_holds()
+    assert held.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+def test_expiry_returns_only_what_it_expired_and_runs_once(held, clock):  # 28
+    a = held.place_hold("ann", BOOK)
+    b = held.place_hold("bob", BOOK)
+    held.return_copy("B1")
+    clock.set(a.pickup_by + timedelta(days=1))
+    expired = held.expire_holds()
+    assert expired == [a]
+    assert all(h.status is HoldStatus.EXPIRED for h in expired)
+    assert b.status is HoldStatus.READY  # got B1 today, not expired with it
+    assert held.expire_holds() == []
+    assert held.balance("ann") == Decimal("1.00")
+    assert held.balance("bob") == Decimal("0.00")
+
+
+def test_waiting_holds_never_expire(held, clock):  # 29
+    hold = held.place_hold("ann", BOOK)
+    clock.advance(365)
+    assert held.expire_holds() == []
+    assert hold.status is HoldStatus.WAITING
+
+
+def test_no_show_fee_counts_toward_the_hold_block(held, clock):  # 30
+    held.checkout("bob", "D1")  # every dvd-1 copy out, so a hold is allowed
+    held.add_charge("ann", Decimal("4.00"), "damage")
+    a = held.place_hold("ann", BOOK)
+    held.return_copy("B1")
+    clock.set(a.pickup_by + timedelta(days=1))
+    held.expire_holds()
+    assert held.balance("ann") == Decimal("5.00")
+    with pytest.raises(AccountBlocked):
+        held.place_hold("ann", "dvd-1")
+
+
+def test_no_show_fee_counts_toward_the_borrowing_block(held, clock):  # 30
+    a = held.place_hold("ann", BOOK)
+    held.add_charge("ann", Decimal("9.00"), "damage")  # after placing the hold
+    held.return_copy("B1")
+    clock.set(a.pickup_by + timedelta(days=1))
+    held.expire_holds()  # B1 back on the shelf, ann owes 10.00
+    assert held.balance("ann") == Decimal("10.00")
+    with pytest.raises(AccountBlocked):
+        held.checkout("ann", "B1")
+
+
+def test_hold_errors_are_lending_errors():  # 31
+    assert issubclass(HoldNotAllowed, LendingError)
+    assert issubclass(HoldNotFound, LendingError)

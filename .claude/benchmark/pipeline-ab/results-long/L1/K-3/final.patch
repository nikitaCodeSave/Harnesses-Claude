@@ -0,0 +1,543 @@
+"""Holds. Numbers in comments refer to docs/specs/0002-holds.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material, MemberCategory
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    HoldNotAllowed,
+    HoldNotFound,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+
+# Fixture dates: START is Mon 2 March 2026. DVDs are due Mon 9 March.
+# March 2026 Sundays: 1, 8, 15, 22, 29.
+
+
+@pytest.fixture
+def svc(service):
+    service.register_member("bob", "Bob Adult")
+    service.register_member("cat", "Cat Adult")
+    return service
+
+
+@pytest.fixture
+def dvd_out(svc):
+    """The only DVD copy is on loan to Ann."""
+    svc.checkout("ann", "D1")
+    return svc
+
+
+def snapshot(svc):
+    """Everything a refused operation must leave alone."""
+    return (
+        [(h.hold_id, h.status, h.copy_id, h.pickup_by)
+         for isbn in ("978-1", "dvd-1") for h in svc.holds_for(isbn)],
+        [svc.get_copy(c).status for c in ("B1", "B2", "D1")],
+        [svc.balance(m) for m in ("ann", "bob", "cat", "kid")],
+    )
+
+
+def ready_for_bob(svc, clock, on=date(2026, 3, 9)):
+    """Bob holds the DVD; Ann returns it on ``on`` so it is set aside for him."""
+    hold = svc.place_hold("bob", "dvd-1")
+    clock.set(on)
+    svc.return_copy("D1")
+    return hold
+
+
+# placing a hold --------------------------------------------------------------
+
+
+def test_place_hold_when_every_copy_is_out(dvd_out, clock):  # 1
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    assert hold.hold_id
+    assert hold.member_id == "bob"
+    assert hold.isbn == "dvd-1"
+    assert hold.placed_on == clock.today()
+    assert hold.status is HoldStatus.WAITING
+    assert hold.copy_id is None
+    assert hold.pickup_by is None
+    assert dvd_out.place_hold("cat", "dvd-1").hold_id != hold.hold_id
+
+
+def test_no_hold_while_a_copy_is_on_the_shelf(svc):  # 2, 11
+    svc.checkout("ann", "B1")  # B2 still on the shelf
+    before = snapshot(svc)
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("bob", "978-1")
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("bob", "dvd-1")
+    assert snapshot(svc) == before
+
+
+def test_no_hold_on_title_without_copies(svc):  # 3
+    svc.add_title("978-9", "No Copies Yet", Material.BOOK, Decimal("10.00"))
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("bob", "978-9")
+    assert svc.holds_for("978-9") == []
+
+
+def test_no_hold_on_title_with_only_withdrawn_copies(svc):  # 3
+    svc.add_title("978-8", "Gone", Material.BOOK, Decimal("10.00"))
+    svc.add_copy("G1", "978-8")
+    svc.withdraw_copy("G1")
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("bob", "978-8")
+    assert svc.holds_for("978-8") == []
+
+
+def test_hold_allowed_when_only_copy_is_on_hold_shelf(dvd_out, clock):  # 4
+    ready_for_bob(dvd_out, clock)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    hold = dvd_out.place_hold("cat", "dvd-1")
+    assert hold.status is HoldStatus.WAITING
+
+
+def test_no_second_active_hold_on_same_title(dvd_out, clock):  # 5, 11
+    first = dvd_out.place_hold("bob", "dvd-1")
+    before = snapshot(dvd_out)
+    with pytest.raises(HoldNotAllowed):
+        dvd_out.place_hold("bob", "dvd-1")
+    assert snapshot(dvd_out) == before
+    clock.set(date(2026, 3, 9))
+    dvd_out.return_copy("D1")  # now READY
+    assert first.status is HoldStatus.READY
+    with pytest.raises(HoldNotAllowed):
+        dvd_out.place_hold("bob", "dvd-1")
+
+
+def test_new_hold_allowed_after_cancel(dvd_out):  # 5
+    first = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.cancel_hold(first.hold_id)
+    again = dvd_out.place_hold("bob", "dvd-1")
+    assert again.status is HoldStatus.WAITING
+    assert [h.hold_id for h in dvd_out.holds_for("dvd-1")] == [again.hold_id]
+
+
+def test_new_hold_allowed_after_expiry(dvd_out, clock):  # 5
+    first = ready_for_bob(dvd_out, clock)
+    dvd_out.place_hold("cat", "dvd-1")
+    clock.set(date(2026, 3, 17))
+    dvd_out.expire_holds()  # D1 passes to Cat; nothing on the shelf
+    assert first.status is HoldStatus.EXPIRED
+    assert dvd_out.place_hold("bob", "dvd-1").status is HoldStatus.WAITING
+
+
+def test_no_hold_on_title_the_member_has_on_loan(svc):  # 6, 11
+    svc.checkout("ann", "B1")
+    svc.checkout("kid", "B2")
+    before = snapshot(svc)
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "978-1")
+    assert snapshot(svc) == before
+    assert svc.place_hold("bob", "978-1").status is HoldStatus.WAITING
+
+
+def test_exactly_five_blocks_placing_a_hold(dvd_out):  # 7, 11
+    dvd_out.add_charge("bob", Decimal("5.00"), "lost case")
+    before = snapshot(dvd_out)
+    with pytest.raises(AccountBlocked):
+        dvd_out.place_hold("bob", "dvd-1")
+    assert snapshot(dvd_out) == before
+
+
+def test_just_under_five_can_place_a_hold(dvd_out):  # 7
+    dvd_out.add_charge("bob", Decimal("4.99"), "lost case")
+    assert dvd_out.place_hold("bob", "dvd-1").status is HoldStatus.WAITING
+
+
+def test_owing_between_five_and_ten_can_borrow_but_not_hold(dvd_out):  # 8
+    dvd_out.add_charge("bob", Decimal("9.99"), "lost case")
+    with pytest.raises(AccountBlocked):
+        dvd_out.place_hold("bob", "dvd-1")
+    assert dvd_out.checkout("bob", "B1").member_id == "bob"
+
+
+def test_children_hold_and_several_titles_at_once(svc):  # 9
+    svc.checkout("ann", "D1")
+    svc.checkout("ann", "B1")
+    svc.checkout("cat", "B2")
+    assert svc.place_hold("kid", "dvd-1").status is HoldStatus.WAITING
+    assert svc.place_hold("bob", "dvd-1").status is HoldStatus.WAITING
+    assert svc.place_hold("bob", "978-1").status is HoldStatus.WAITING
+
+
+def test_unknown_member_or_title(dvd_out):  # 10, 11
+    before = snapshot(dvd_out)
+    with pytest.raises(MemberNotFound):
+        dvd_out.place_hold("nobody", "dvd-1")
+    with pytest.raises(TitleNotFound):
+        dvd_out.place_hold("bob", "no-such-isbn")
+    assert snapshot(dvd_out) == before
+
+
+# the queue -------------------------------------------------------------------
+
+
+def test_holds_for_is_in_placement_order_and_only_active(dvd_out, clock):  # 12
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    kid = dvd_out.place_hold("kid", "dvd-1")
+    assert [h.member_id for h in dvd_out.holds_for("dvd-1")] == ["bob", "cat", "kid"]
+    dvd_out.cancel_hold(cat.hold_id)
+    clock.set(date(2026, 3, 9))
+    dvd_out.return_copy("D1")  # set aside for Bob
+    assert dvd_out.holds_for("dvd-1") == [bob, kid]
+    dvd_out.checkout("bob", "D1")  # fulfilled
+    assert dvd_out.holds_for("dvd-1") == [kid]
+
+
+def test_expired_holds_leave_the_queue(dvd_out, clock):  # 12
+    ready_for_bob(dvd_out, clock)
+    clock.set(date(2026, 3, 17))
+    dvd_out.expire_holds()
+    assert dvd_out.holds_for("dvd-1") == []
+
+
+def test_holds_for_empty_and_unknown(svc):  # 13
+    assert svc.holds_for("978-1") == []
+    with pytest.raises(TitleNotFound):
+        svc.holds_for("no-such-isbn")
+
+
+# setting aside on return -----------------------------------------------------
+
+
+def test_return_sets_copy_aside_for_first_in_line(dvd_out, clock):  # 14
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    clock.set(date(2026, 3, 9))
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert bob.status is HoldStatus.READY
+    assert bob.copy_id == "D1"
+    assert bob.pickup_by is not None
+    assert cat.status is HoldStatus.WAITING
+    assert cat.copy_id is None
+
+
+def test_return_without_waiting_holds_shelves_copy(dvd_out, clock):  # 15
+    clock.set(date(2026, 3, 9))
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+
+
+def test_return_value_and_fine_unchanged_when_set_aside(dvd_out, clock):  # 16
+    loan = dvd_out.open_loans("ann")[0]
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(date(2026, 3, 12))  # 3 open days late
+    returned = dvd_out.return_copy("D1")
+    assert returned is dvd_out.get_loan(loan.loan_id)
+    assert returned.returned_on == date(2026, 3, 12)
+    assert dvd_out.balance("ann") == Decimal("3.00")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_pickup_by_is_seven_days_later(dvd_out, clock):  # 17
+    hold = ready_for_bob(dvd_out, clock, on=date(2026, 3, 9))
+    assert hold.pickup_by == date(2026, 3, 16)
+
+
+def test_pickup_by_on_sunday_moves_to_monday(dvd_out, clock):  # 17
+    hold = ready_for_bob(dvd_out, clock, on=date(2026, 3, 15))  # a Sunday
+    assert hold.pickup_by == date(2026, 3, 23)
+
+
+def test_pickup_by_is_calendar_days_not_open_days(dvd_out, clock):  # 17
+    hold = ready_for_bob(dvd_out, clock, on=date(2026, 3, 11))  # Wed
+    assert hold.pickup_by == date(2026, 3, 18)  # Wed, though a Sunday passed
+
+
+def test_new_copy_is_set_aside_for_first_in_line(dvd_out):  # 18
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    copy = dvd_out.add_copy("D2", "dvd-1")
+    assert copy.status is CopyStatus.ON_HOLD_SHELF
+    assert bob.status is HoldStatus.READY
+    assert bob.copy_id == "D2"
+    assert bob.pickup_by == date(2026, 3, 9)
+    assert cat.status is HoldStatus.WAITING
+
+
+def test_new_copy_without_holds_is_on_the_shelf(svc):  # 18
+    assert svc.add_copy("D2", "dvd-1").status is CopyStatus.AVAILABLE
+
+
+# collecting ------------------------------------------------------------------
+
+
+def test_holder_collects_set_aside_copy(dvd_out, clock):  # 19
+    hold = ready_for_bob(dvd_out, clock)
+    loan = dvd_out.checkout("bob", "D1")
+    assert loan.member_id == "bob"
+    assert loan.copy_id == "D1"
+    assert loan.borrowed_on == date(2026, 3, 9)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_LOAN
+    assert hold.status is HoldStatus.FULFILLED
+    assert hold.copy_id == "D1"
+    assert dvd_out.holds_for("dvd-1") == []
+
+
+def test_others_cannot_borrow_set_aside_copy(dvd_out, clock):  # 20
+    hold = ready_for_bob(dvd_out, clock)
+    before = snapshot(dvd_out)
+    with pytest.raises(CopyNotAvailable):
+        dvd_out.checkout("cat", "D1")
+    with pytest.raises(CopyNotAvailable):
+        dvd_out.checkout("ann", "D1")
+    assert snapshot(dvd_out) == before
+    assert hold.status is HoldStatus.READY
+    assert dvd_out.loan_history("cat") == []
+
+
+def test_collect_on_pickup_by_day(dvd_out, clock):  # 21, 26
+    hold = ready_for_bob(dvd_out, clock)
+    clock.set(hold.pickup_by)
+    assert dvd_out.expire_holds() == []
+    assert dvd_out.checkout("bob", "D1").copy_id == "D1"
+    assert hold.status is HoldStatus.FULFILLED
+
+
+def test_blocked_holder_cannot_collect_and_hold_stays(dvd_out, clock):  # 22
+    hold = ready_for_bob(dvd_out, clock)
+    dvd_out.add_charge("bob", Decimal("10.00"), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        dvd_out.checkout("bob", "D1")
+    assert hold.status is HoldStatus.READY
+    assert hold.pickup_by == date(2026, 3, 16)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    dvd_out.pay("bob", Decimal("0.01"))
+    assert dvd_out.checkout("bob", "D1").copy_id == "D1"
+
+
+def test_holder_at_loan_limit_cannot_collect_and_hold_stays(dvd_out, clock):  # 22
+    for n in range(4):
+        dvd_out.add_title(f"x-{n}", f"Extra {n}", Material.BOOK, Decimal("5.00"))
+        dvd_out.add_copy(f"X{n}", f"x-{n}")
+        dvd_out.checkout("kid", f"X{n}")  # children may have 4 loans
+    hold = dvd_out.place_hold("kid", "dvd-1")
+    clock.set(date(2026, 3, 9))
+    dvd_out.return_copy("D1")
+    with pytest.raises(LoanLimitReached):
+        dvd_out.checkout("kid", "D1")
+    assert hold.status is HoldStatus.READY
+    assert hold.pickup_by == date(2026, 3, 16)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_borrowing_another_copy_collects_the_hold(svc, clock):  # 23
+    svc.checkout("ann", "B1")
+    svc.checkout("cat", "B2")
+    hold = svc.place_hold("bob", "978-1")
+    svc.return_copy("B1")  # set aside for Bob
+    svc.return_copy("B2")  # nobody else waiting -> shelf
+    assert svc.get_copy("B2").status is CopyStatus.AVAILABLE
+    svc.checkout("bob", "B2")
+    assert hold.status is HoldStatus.FULFILLED
+    assert hold.copy_id == "B2"
+    assert svc.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert svc.get_copy("B2").status is CopyStatus.ON_LOAN
+
+
+def test_cannot_withdraw_copy_on_hold_shelf(dvd_out, clock):  # 24
+    hold = ready_for_bob(dvd_out, clock)
+    with pytest.raises(CopyNotAvailable):
+        dvd_out.withdraw_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert hold.status is HoldStatus.READY
+
+
+# expiry ----------------------------------------------------------------------
+
+
+def test_expire_returns_expired_holds_in_placement_order(svc, clock):  # 25
+    svc.checkout("ann", "D1")
+    svc.checkout("ann", "B1")
+    svc.checkout("ann", "B2")
+    cat = svc.place_hold("cat", "978-1")
+    bob = svc.place_hold("bob", "dvd-1")
+    clock.set(date(2026, 3, 9))
+    svc.return_copy("D1")  # Bob's is set aside first
+    svc.return_copy("B1")
+    clock.set(date(2026, 3, 17))
+    assert svc.expire_holds() == [cat, bob]
+    assert cat.status is HoldStatus.EXPIRED
+    assert bob.status is HoldStatus.EXPIRED
+
+
+def test_expire_leaves_holds_not_yet_due(svc, clock):  # 25
+    svc.checkout("ann", "D1")
+    svc.checkout("ann", "B1")
+    svc.checkout("ann", "B2")
+    early = svc.place_hold("bob", "dvd-1")
+    late = svc.place_hold("cat", "978-1")
+    clock.set(date(2026, 3, 9))
+    svc.return_copy("D1")  # pickup by 16 March
+    clock.set(date(2026, 3, 12))
+    svc.return_copy("B1")  # pickup by 19 March
+    clock.set(date(2026, 3, 17))
+    assert svc.expire_holds() == [early]
+    assert late.status is HoldStatus.READY
+
+
+def test_hold_expires_on_first_run_after_missed_days(dvd_out, clock):  # 26, 28
+    hold = ready_for_bob(dvd_out, clock)
+    clock.set(date(2026, 3, 25))  # job did not run since 16 March
+    assert dvd_out.expire_holds() == [hold]
+    assert dvd_out.balance("bob") == Decimal("1.00")
+
+
+def test_second_run_same_day_expires_nothing(dvd_out, clock):  # 27, 28
+    hold = ready_for_bob(dvd_out, clock)
+    clock.set(date(2026, 3, 17))
+    assert dvd_out.expire_holds() == [hold]
+    assert dvd_out.expire_holds() == []
+    assert dvd_out.balance("bob") == Decimal("1.00")
+    clock.advance(1)
+    assert dvd_out.expire_holds() == []
+    assert dvd_out.balance("bob") == Decimal("1.00")
+
+
+def test_children_pay_no_no_show_fee(dvd_out, clock):  # 28
+    hold = dvd_out.place_hold("kid", "dvd-1")
+    clock.set(date(2026, 3, 9))
+    dvd_out.return_copy("D1")
+    clock.set(date(2026, 3, 17))
+    assert dvd_out.expire_holds() == [hold]
+    assert dvd_out.balance("kid") == 0
+
+
+def test_no_show_fee_counts_towards_hold_block(svc, clock):  # 29
+    svc.checkout("ann", "D1")
+    svc.checkout("ann", "B1")
+    svc.checkout("ann", "B2")
+    svc.add_charge("bob", Decimal("4.00"), "lost case")
+    ready_for_bob(svc, clock)
+    clock.set(date(2026, 3, 17))
+    svc.expire_holds()
+    assert svc.balance("bob") == Decimal("5.00")
+    with pytest.raises(AccountBlocked):
+        svc.place_hold("bob", "978-1")
+
+
+def test_no_show_fee_counts_towards_borrow_block(dvd_out, clock):  # 29
+    dvd_out.add_charge("bob", Decimal("4.00"), "lost case")
+    ready_for_bob(dvd_out, clock)
+    dvd_out.add_charge("bob", Decimal("5.00"), "lost case")
+    clock.set(date(2026, 3, 17))
+    dvd_out.expire_holds()
+    assert dvd_out.balance("bob") == Decimal("10.00")
+    with pytest.raises(AccountBlocked):
+        dvd_out.checkout("bob", "B1")
+
+
+def test_expired_copy_passes_to_next_in_line(dvd_out, clock):  # 30
+    ready_for_bob(dvd_out, clock)
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    clock.set(date(2026, 3, 17))  # Tue
+    dvd_out.expire_holds()
+    assert cat.status is HoldStatus.READY
+    assert cat.copy_id == "D1"
+    assert cat.pickup_by == date(2026, 3, 24)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_expired_copy_passed_on_sunday_gets_monday(dvd_out, clock):  # 30
+    ready_for_bob(dvd_out, clock)
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    clock.set(date(2026, 3, 22))  # Sun
+    dvd_out.expire_holds()
+    assert cat.pickup_by == date(2026, 3, 30)
+
+
+def test_expired_copy_with_nobody_waiting_is_shelved(dvd_out, clock):  # 30
+    ready_for_bob(dvd_out, clock)
+    clock.set(date(2026, 3, 17))
+    dvd_out.expire_holds()
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+
+
+def test_waiting_holds_never_expire(dvd_out, clock):  # 31
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    clock.set(date(2027, 3, 1))
+    assert dvd_out.expire_holds() == []
+    assert hold.status is HoldStatus.WAITING
+    assert dvd_out.balance("bob") == 0
+
+
+# cancelling ------------------------------------------------------------------
+
+
+def test_cancel_waiting_hold(dvd_out, clock):  # 32, 34
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    assert dvd_out.cancel_hold(bob.hold_id) is bob
+    assert bob.status is HoldStatus.CANCELLED
+    assert dvd_out.holds_for("dvd-1") == [cat]
+    clock.set(date(2026, 3, 9))
+    dvd_out.return_copy("D1")
+    assert cat.status is HoldStatus.READY
+    assert dvd_out.balance("bob") == 0
+
+
+def test_cancel_ready_hold_passes_copy_on(dvd_out, clock):  # 33, 34
+    bob = ready_for_bob(dvd_out, clock)
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    clock.set(date(2026, 3, 14))  # Sat
+    assert dvd_out.cancel_hold(bob.hold_id).status is HoldStatus.CANCELLED
+    assert cat.status is HoldStatus.READY
+    assert cat.copy_id == "D1"
+    assert cat.pickup_by == date(2026, 3, 21)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert dvd_out.balance("bob") == 0
+
+
+def test_cancel_ready_hold_on_sunday_gives_monday(dvd_out, clock):  # 33
+    bob = ready_for_bob(dvd_out, clock)
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    clock.set(date(2026, 3, 15))  # Sun
+    dvd_out.cancel_hold(bob.hold_id)
+    assert cat.pickup_by == date(2026, 3, 23)
+
+
+def test_cancel_ready_hold_with_nobody_waiting_shelves_copy(dvd_out, clock):  # 33, 34
+    bob = ready_for_bob(dvd_out, clock)
+    dvd_out.cancel_hold(bob.hold_id)
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert dvd_out.balance("bob") == 0
+
+
+def test_cannot_cancel_a_finished_hold(svc, clock):  # 35
+    svc.checkout("ann", "D1")
+    svc.checkout("ann", "B1")
+    svc.checkout("ann", "B2")
+    cancelled = svc.place_hold("cat", "978-1")
+    svc.cancel_hold(cancelled.hold_id)
+    expired = svc.place_hold("kid", "978-1")
+    fulfilled = ready_for_bob(svc, clock)
+    svc.checkout("bob", "D1")
+    svc.return_copy("B1")  # set aside for Kim
+    clock.set(date(2026, 3, 17))
+    svc.expire_holds()
+    before = snapshot(svc)
+    for hold, status in [
+        (cancelled, HoldStatus.CANCELLED),
+        (expired, HoldStatus.EXPIRED),
+        (fulfilled, HoldStatus.FULFILLED),
+    ]:
+        with pytest.raises(HoldNotAllowed):
+            svc.cancel_hold(hold.hold_id)
+        assert hold.status is status
+    assert snapshot(svc) == before
+
+
+def test_cancel_unknown_hold(svc):  # 36
+    with pytest.raises(HoldNotFound):
+        svc.cancel_hold("H9999")
diff --git a/tests/test_renewals.py b/tests/test_renewals.py
new file mode 100644

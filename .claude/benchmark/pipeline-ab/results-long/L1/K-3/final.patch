+# Overdue fines: charged per late day when the copy comes back.
+FINE_PER_LATE_DAY: dict[Material, Decimal] = {
+    Material.BOOK: Decimal("0.25"),
+    Material.DVD: Decimal("1.00"),
+}
+
+# Members in these categories are never fined.
+FINE_EXEMPT: frozenset[MemberCategory] = frozenset({MemberCategory.CHILD})
+

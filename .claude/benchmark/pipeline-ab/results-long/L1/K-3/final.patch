+BORROW_BLOCK_THRESHOLD = Decimal("10.00")
+HOLD_BLOCK_THRESHOLD = Decimal("5.00")
+# Renewing is blocked by any amount above this, i.e. anything owed (ADR 0007).
+RENEW_BLOCK_THRESHOLD = Decimal("0.00")
+
+# Renewals (ADR 0009): books only, at most twice per loan, from this many
+# calendar days before the due date onwards.
+RENEWABLE: frozenset[Material] = frozenset({Material.BOOK})
+MAX_RENEWALS = 2
+RENEWAL_WINDOW_DAYS = 5
+
+# Holds: a set-aside copy waits this many calendar days (ADR 0004).
+PICKUP_DAYS = 7
+NO_SHOW_FEE = Decimal("1.00")
+
+
+def late_days(due_on: date, returned_on: date) -> int:
+    """Open days after ``due_on`` up to and including ``returned_on``."""
+    days = 0
+    day = due_on + timedelta(days=1)
+    while day <= returned_on:
+        if is_open_day(day):
+            days += 1
+        day += timedelta(days=1)
+    return days
+
+
+def overdue_fine(
+    material: Material,
+    category: MemberCategory,
+    replacement_cost: Decimal,
+    due_on: date,
+    returned_on: date,
+    already_fined: Decimal = Decimal("0.00"),
+) -> Decimal:
+    """The fine for a loan returned (or renewed) on ``returned_on``; zero if on
+    time or the member is exempt.
+
+    Capped per loan (ADR 0005): together with ``already_fined`` (the loan's
+    earlier fines) it never exceeds the replacement cost.
+    """
+    if category in FINE_EXEMPT:
+        return Decimal("0.00")
+    fine = FINE_PER_LATE_DAY[material] * late_days(due_on, returned_on)
+    return max(min(fine, replacement_cost - already_fined), Decimal("0.00"))
+
+
+def is_blocked_from_borrowing(balance: Decimal) -> bool:
+    return balance >= BORROW_BLOCK_THRESHOLD
+
+
+def is_blocked_from_holds(balance: Decimal) -> bool:
+    return balance >= HOLD_BLOCK_THRESHOLD
+
+
+def is_blocked_from_renewing(balance: Decimal) -> bool:
+    """Renewing needs a zero balance (ADR 0007)."""
+    return balance > RENEW_BLOCK_THRESHOLD
+
+
+def is_renewable(material: Material) -> bool:
+    return material in RENEWABLE
+
+
+def renewal_opens(due_on: date) -> date:
+    """First day a loan due on ``due_on`` can be renewed; no last day."""
+    return due_on - timedelta(days=RENEWAL_WINDOW_DAYS)
+
+
+def pickup_date(set_aside_on: date) -> date:
+    """Last day to collect a held copy, never a closed day."""
+    return next_open_day(set_aside_on + timedelta(days=PICKUP_DAYS))
+
+
+def no_show_fee(category: MemberCategory) -> Decimal:
+    """Fee for an uncollected hold; zero for members exempt from fines."""
+    if category in FINE_EXEMPT:
+        return Decimal("0.00")
+    return NO_SHOW_FEE

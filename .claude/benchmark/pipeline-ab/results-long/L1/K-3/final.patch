+++ b/tests/test_renewals.py
@@ -0,0 +1,324 @@
+"""Renewals. Numbers in comments refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, EntryKind, HoldStatus, Material
+from lending.errors import (
+    AccountBlocked,
+    LoanLimitReached,
+    LoanNotFound,
+    RenewalRefused,
+)
+
+# Fixture dates: START is Mon 2 March 2026, so a book borrowed then is due
+# Mon 23 March and renewable from Wed 18 March. Sundays: 1, 8, 15, 22, 29
+# March and 5, 12, 19, 26 April.
+
+
+@pytest.fixture
+def svc(service):
+    service.register_member("bob", "Bob Adult")
+    return service
+
+
+@pytest.fixture
+def loan(svc):
+    """Ann borrows book copy B1 on Mon 2 March, due Mon 23 March."""
+    return svc.checkout("ann", "B1")
+
+
+def fines(svc, member_id="ann"):
+    return [
+        (e.amount, e.loan_id) for e in svc._repo.entries_of(member_id)
+        if e.kind is EntryKind.FINE
+    ]
+
+
+def snapshot(svc, loan_id):
+    """Everything a refused renewal must leave alone."""
+    loan = svc.get_loan(loan_id)
+    return (
+        loan.due_on, loan.renewals, loan.returned_on,
+        svc.get_copy(loan.copy_id).status,
+        [svc.balance(m) for m in ("ann", "bob", "kid")],
+        [(h.hold_id, h.status) for h in svc.holds_for("978-1")],
+    )
+
+
+# granting a renewal ------------------------------------------------------------
+
+
+def test_new_loan_has_no_renewals(loan):  # 1
+    assert loan.renewals == 0
+
+
+def test_renewal_moves_due_date_in_place(svc, loan, clock):  # 2
+    clock.set(date(2026, 3, 19))
+    renewed = svc.renew(loan.loan_id)
+    assert renewed is svc.get_loan(loan.loan_id)
+    assert renewed.loan_id == loan.loan_id
+    assert renewed.copy_id == "B1"
+    assert renewed.member_id == "ann"
+    assert renewed.borrowed_on == date(2026, 3, 2)
+    assert renewed.due_on == date(2026, 4, 9)
+    assert renewed.renewals == 1
+
+
+def test_renewed_loan_is_still_the_one_open_loan(svc, loan, clock):  # 3
+    clock.set(date(2026, 3, 19))
+    svc.renew(loan.loan_id)
+    assert svc.get_loan(loan.loan_id).is_open
+    assert svc.get_copy("B1").status is CopyStatus.ON_LOAN
+    assert [l.loan_id for l in svc.loan_history("ann")] == [loan.loan_id]
+    assert [l.loan_id for l in svc.open_loans("ann")] == [loan.loan_id]
+
+
+def test_due_date_on_sunday_moves_to_monday(svc, loan, clock):  # 4
+    clock.set(date(2026, 3, 22))
+    assert svc.renew(loan.loan_id).due_on == date(2026, 4, 13)
+
+
+def test_second_renewal_counts_from_its_own_day(svc, loan, clock):  # 5
+    clock.set(date(2026, 3, 19))
+    svc.renew(loan.loan_id)  # due Thu 9 April, renewable from Sat 4 April
+    clock.set(date(2026, 4, 4))
+    renewed = svc.renew(loan.loan_id)
+    assert renewed.due_on == date(2026, 4, 25)
+    assert renewed.renewals == 2
+
+
+def test_child_can_renew_a_book(svc, clock):  # 6
+    loan = svc.checkout("kid", "B2")
+    clock.set(date(2026, 3, 19))
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_member_at_loan_limit_can_renew(svc, clock):  # 7
+    svc.add_copy("B3", "978-1")
+    svc.add_copy("B4", "978-1")
+    loans = [svc.checkout("kid", c) for c in ("B1", "B2", "B3", "B4")]
+    with pytest.raises(LoanLimitReached):
+        svc.checkout("kid", "D1")
+    clock.set(date(2026, 3, 19))
+    assert svc.renew(loans[0].loan_id).renewals == 1
+
+
+# refusals ----------------------------------------------------------------------
+
+
+def test_third_renewal_is_refused(svc, loan, clock):  # 8
+    for day in (date(2026, 3, 19), date(2026, 4, 4)):
+        clock.set(day)
+        svc.renew(loan.loan_id)  # due 9 April, then Sat 25 April
+    clock.set(date(2026, 4, 20))
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+
+
+def test_window_opens_five_days_before_due(svc, loan, clock):  # 9
+    clock.set(date(2026, 3, 18))
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_renewing_before_the_window_is_refused(svc, loan, clock):  # 9
+    clock.set(date(2026, 3, 17))
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+
+
+def test_overdue_loan_can_be_renewed(svc, loan, clock):  # 10
+    clock.set(date(2026, 4, 10))
+    renewed = svc.renew(loan.loan_id)
+    assert renewed.renewals == 1
+    assert renewed.due_on == date(2026, 5, 1)
+
+
+def test_dvd_cannot_be_renewed(svc, clock):  # 11
+    loan = svc.checkout("ann", "D1")  # due Mon 9 March
+    clock.set(date(2026, 3, 7))
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+
+
+def test_returned_loan_cannot_be_renewed(svc, loan, clock):  # 12
+    clock.set(date(2026, 3, 19))
+    svc.return_copy("B1")
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+
+
+def test_unknown_loan(svc):  # 13
+    with pytest.raises(LoanNotFound):
+        svc.renew("L9999")
+
+
+def test_any_balance_blocks_renewing_until_paid(svc, loan, clock):  # 14
+    svc.add_charge("ann", Decimal("0.01"), "lost bookmark")
+    clock.set(date(2026, 3, 19))
+    with pytest.raises(AccountBlocked):
+        svc.renew(loan.loan_id)
+    svc.pay("ann", Decimal("0.01"))
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+@pytest.fixture
+def bob_waiting(svc, loan):
+    """Both copies of 978-1 are out (B2 to Kim) and Bob waits for the title."""
+    svc.checkout("kid", "B2")
+    return svc.place_hold("bob", "978-1")
+
+
+def test_waiting_hold_blocks_renewing(svc, loan, bob_waiting, clock):  # 15
+    clock.set(date(2026, 3, 19))
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+
+
+def test_ready_hold_does_not_block_renewing(svc, loan, bob_waiting, clock):  # 15
+    clock.set(date(2026, 3, 19))
+    svc.return_copy("B2")
+    assert svc.holds_for("978-1")[0].status is HoldStatus.READY
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_cancelled_hold_does_not_block_renewing(svc, loan, bob_waiting, clock):  # 15
+    clock.set(date(2026, 3, 19))
+    svc.cancel_hold(bob_waiting.hold_id)
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def _too_early(svc, clock):
+    loan = svc.checkout("ann", "B1")
+    clock.set(date(2026, 3, 17))
+    return loan.loan_id
+
+
+def _dvd(svc, clock):
+    loan = svc.checkout("ann", "D1")
+    clock.set(date(2026, 3, 31))  # overdue: a renewal would post a fine
+    return loan.loan_id
+
+
+def _returned(svc, clock):
+    loan = svc.checkout("ann", "B1")
+    clock.set(date(2026, 3, 19))
+    svc.return_copy("B1")
+    return loan.loan_id
+
+
+def _limit(svc, clock):
+    loan = svc.checkout("ann", "B1")
+    for day in (date(2026, 3, 19), date(2026, 4, 4)):
+        clock.set(day)
+        svc.renew(loan.loan_id)
+    clock.set(date(2026, 5, 4))  # overdue too
+    return loan.loan_id
+
+
+def _waiting(svc, clock):
+    loan = svc.checkout("ann", "B1")
+    svc.checkout("kid", "B2")
+    svc.place_hold("bob", "978-1")
+    clock.set(date(2026, 3, 31))  # overdue
+    return loan.loan_id
+
+
+def _owes(svc, clock):
+    loan = svc.checkout("ann", "B1")
+    svc.add_charge("ann", Decimal("3.00"), "damaged cover")
+    clock.set(date(2026, 3, 31))  # overdue
+    return loan.loan_id
+
+
+@pytest.mark.parametrize(
+    "setup, error",
+    [
+        (_too_early, RenewalRefused),
+        (_dvd, RenewalRefused),
+        (_returned, RenewalRefused),
+        (_limit, RenewalRefused),
+        (_waiting, RenewalRefused),
+        (_owes, AccountBlocked),
+    ],
+)
+def test_refused_renewal_changes_nothing(svc, clock, setup, error):  # 16
+    loan_id = setup(svc, clock)
+    before = snapshot(svc, loan_id)
+    with pytest.raises(error):
+        svc.renew(loan_id)
+    assert snapshot(svc, loan_id) == before
+
+
+# fines -------------------------------------------------------------------------
+
+
+def test_renewing_on_time_posts_nothing(svc, loan, clock):  # 17
+    clock.set(date(2026, 3, 23))  # the due date itself
+    svc.renew(loan.loan_id)
+    assert fines(svc) == []
+    assert svc.balance("ann") == Decimal("0.00")
+
+
+def test_overdue_renewal_posts_fine_so_far(svc, loan, clock):  # 18
+    clock.set(date(2026, 3, 31))
+    renewed = svc.renew(loan.loan_id)
+    assert fines(svc) == [(Decimal("1.75"), loan.loan_id)]
+    assert renewed.due_on == date(2026, 4, 21)
+
+
+def test_return_after_renewal_charges_only_new_lateness(svc, loan, clock):  # 19
+    clock.set(date(2026, 3, 31))
+    svc.renew(loan.loan_id)
+    svc.pay("ann", Decimal("1.75"))
+    clock.set(date(2026, 4, 23))
+    svc.return_copy("B1")
+    assert fines(svc) == [
+        (Decimal("1.75"), loan.loan_id), (Decimal("0.50"), loan.loan_id),
+    ]
+    assert svc.balance("ann") == Decimal("0.50")
+
+
+def test_child_overdue_renewal_charges_nothing(svc, clock):  # 20
+    loan = svc.checkout("kid", "B2")
+    clock.set(date(2026, 3, 31))
+    svc.renew(loan.loan_id)
+    assert fines(svc, "kid") == []
+    assert svc.balance("kid") == Decimal("0.00")
+
+
+def test_cap_is_per_loan(svc, clock):  # 21
+    svc.add_title("978-2", "Pamphlet", Material.BOOK, Decimal("2.00"))
+    svc.add_copy("P1", "978-2")
+    loan = svc.checkout("ann", "P1")
+    clock.set(date(2026, 3, 31))
+    svc.renew(loan.loan_id)
+    clock.set(date(2026, 4, 27))
+    svc.return_copy("P1")
+    assert fines(svc) == [
+        (Decimal("1.75"), loan.loan_id), (Decimal("0.25"), loan.loan_id),
+    ]
+    assert svc.balance("ann") == Decimal("2.00")
+
+
+def test_nothing_posted_once_cap_reached(svc, clock):  # 22
+    svc.add_title("978-3", "Leaflet", Material.BOOK, Decimal("1.00"))
+    svc.add_copy("F1", "978-3")
+    loan = svc.checkout("ann", "F1")
+    clock.set(date(2026, 3, 31))
+    svc.renew(loan.loan_id)  # 1.75 calculated, capped at 1.00
+    svc.pay("ann", Decimal("1.00"))
+    clock.set(date(2026, 4, 23))  # overdue again (due Tue 21 April)
+    svc.renew(loan.loan_id)
+    clock.set(date(2026, 5, 30))  # overdue again (due Thu 14 May)
+    svc.return_copy("F1")
+    assert fines(svc) == [(Decimal("1.00"), loan.loan_id)]
+    assert svc.balance("ann") == Decimal("0.00")
+
+
+def test_unrenewed_loan_fined_as_before(svc, loan, clock):  # 23
+    clock.set(date(2026, 3, 31))
+    svc.return_copy("B1")
+    assert fines(svc) == [(Decimal("1.75"), loan.loan_id)]

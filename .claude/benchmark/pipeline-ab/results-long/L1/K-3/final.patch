@@ -0,0 +1,249 @@
+"""Overdue fines and member accounts. Numbers in comments refer to docs/specs/0001-fines.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    InvalidAmount,
+    LendingError,
+    MemberNotFound,
+)
+
+# Fixture dates: START is Mon 2 March 2026. Books are due Mon 23 March, DVDs Mon 9 March.
+
+
+# fines on return -----------------------------------------------------------
+
+
+def test_late_book_fine_skips_sunday(service, clock):  # 1
+    service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_late_dvd_fine_is_one_per_late_day(service, clock):  # 2
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 12))  # Tue, Wed, Thu late
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_return_on_due_date_is_free(service, clock):  # 3
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 9))
+    service.return_copy("D1")
+    assert service.balance("ann") == 0
+
+
+def test_return_before_due_date_is_free(service, clock):  # 3
+    service.checkout("ann", "B1")
+    clock.advance(5)
+    service.return_copy("B1")
+    assert service.balance("ann") == 0
+
+
+def test_first_late_day_is_charged(service, clock):  # 3 (no grace period)
+    service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 24))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("0.25")
+
+
+def test_children_are_never_fined(service, clock):  # 4
+    loan = service.checkout("kid", "D1")
+    clock.set(date(2026, 4, 30))
+    returned = service.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == date(2026, 4, 30)
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("kid") == []
+    assert service.balance("kid") == 0
+
+
+def test_fine_is_capped_at_replacement_cost(service, clock):  # 5
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 4, 1))  # 20 open days after 9 March
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_fine_just_under_cap_is_not_capped(service, clock):  # 5
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 21))  # 11 open days after 9 March
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("11.00")
+
+
+def test_each_late_return_adds_its_own_fine(service, clock):  # 6
+    service.checkout("ann", "B1")
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 24))
+    service.return_copy("D1")  # 13 open days late -> 12.00 cap
+    service.return_copy("B1")  # 1 open day late -> 0.25
+    assert service.balance("ann") == Decimal("12.25")
+
+
+def test_return_value_unchanged_and_works_while_blocked(service, clock):  # 7
+    loan = service.checkout("ann", "B1")
+    service.add_charge("ann", Decimal("25.00"), "damaged case")
+    clock.set(date(2026, 3, 30))
+    returned = service.return_copy("B1")
+    assert returned is service.get_loan(loan.loan_id)
+    assert returned.returned_on == date(2026, 3, 30)
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.balance("ann") == Decimal("26.50")
+
+
+def test_overdue_loan_still_out_adds_nothing(service, clock):  # 8
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 4, 30))
+    assert service.overdue_loans() != []
+    assert service.balance("ann") == 0
+
+
+# balance, charges and payments --------------------------------------------
+
+
+def test_new_member_owes_nothing(service):  # 9
+    assert service.balance("ann") == 0
+
+
+def test_add_charge_returns_new_balance(service):  # 10
+    assert service.add_charge("ann", Decimal("2.50"), "lost case") == Decimal("2.50")
+    assert service.add_charge("ann", Decimal("1.25"), "printing") == Decimal("3.75")
+    assert service.balance("ann") == Decimal("3.75")
+
+
+def test_partial_and_full_payment(service):  # 11
+    service.add_charge("ann", Decimal("5.00"), "lost case")
+    assert service.pay("ann", Decimal("1.50")) == Decimal("3.50")
+    assert service.pay("ann", Decimal("3.50")) == 0
+    assert service.balance("ann") == 0
+
+
+def test_pay_works_while_blocked(service):  # 12, 18
+    service.add_charge("ann", Decimal("15.00"), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.pay("ann", Decimal("5.01")) == Decimal("9.99")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+BAD_AMOUNTS = [
+    Decimal("0"),
+    Decimal("0.00"),
+    Decimal("-1.00"),
+    Decimal("0.005"),
+    Decimal("1.001"),
+    Decimal("NaN"),
+    Decimal("Infinity"),
+    1.50,
+    2,
+    "1.00",
+    None,
+]
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS)
+def test_bad_charge_amounts_are_refused_and_change_nothing(service, amount):  # 13, 20
+    service.add_charge("ann", Decimal("4.00"), "lost case")
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", amount, "lost case")
+    assert service.balance("ann") == Decimal("4.00")
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS)
+def test_bad_payment_amounts_are_refused_and_change_nothing(service, amount):  # 13, 20
+    service.add_charge("ann", Decimal("4.00"), "lost case")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", amount)
+    assert service.balance("ann") == Decimal("4.00")
+
+
+def test_trailing_zeros_are_still_whole_cents(service):  # 13
+    assert service.add_charge("ann", Decimal("1.500"), "printing") == Decimal("1.50")
+    assert service.pay("ann", Decimal("1.5")) == 0
+
+
+def test_overpayment_is_refused_and_changes_nothing(service):  # 14, 20
+    service.add_charge("ann", Decimal("4.00"), "lost case")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("4.01"))
+    assert service.balance("ann") == Decimal("4.00")
+
+
+def test_paying_with_nothing_owed_is_refused(service):  # 14
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("0.01"))
+    assert service.balance("ann") == 0
+
+
+@pytest.mark.parametrize("reason", ["", "   ", None])
+def test_manual_charge_needs_a_reason(service, reason):  # 15, 20
+    with pytest.raises(LendingError):
+        service.add_charge("ann", Decimal("1.00"), reason)
+    assert service.balance("ann") == 0
+
+
+def test_unknown_member_account(service):  # 16
+    with pytest.raises(MemberNotFound):
+        service.balance("nobody")
+    with pytest.raises(MemberNotFound):
+        service.add_charge("nobody", Decimal("1.00"), "lost case")
+    with pytest.raises(MemberNotFound):
+        service.pay("nobody", Decimal("1.00"))
+
+
+# blocking -----------------------------------------------------------------
+
+
+def test_exactly_ten_blocks_checkout(service):  # 17
+    service.add_charge("ann", Decimal("10.00"), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_just_under_ten_can_borrow(service):  # 17
+    service.add_charge("ann", Decimal("9.99"), "damaged disc")
+    assert service.checkout("ann", "B1").member_id == "ann"
+
+
+def test_fines_count_towards_blocking(service, clock):  # 17
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 21))  # 11.00 fine
+    service.return_copy("D1")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "D1")
+
+
+def test_blocked_member_can_borrow_after_paying_below_ten(service):  # 18
+    service.add_charge("ann", Decimal("10.00"), "damaged disc")
+    service.pay("ann", Decimal("0.01"))
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+# refusals change nothing --------------------------------------------------
+
+
+def test_blocked_checkout_changes_nothing(service):  # 19
+    service.add_charge("ann", Decimal("12.00"), "damaged disc")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.loan_history("ann") == []
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_other_refused_checkout_leaves_balance(service):  # 19
+    service.add_charge("ann", Decimal("3.00"), "printing")
+    service.checkout("kid", "B1")
+    with pytest.raises(CopyNotAvailable):
+        service.checkout("ann", "B1")
+    assert service.loan_history("ann") == []
+    assert service.balance("ann") == Decimal("3.00")
diff --git a/tests/test_holds.py b/tests/test_holds.py

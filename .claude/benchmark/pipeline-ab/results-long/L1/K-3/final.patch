 """Domain errors. Every failure the service reports is a ``LendingError``."""
 
+from decimal import Decimal
+
 
 class LendingError(Exception):
     """Base class for all lending domain errors."""
@@ -69,3 +71,52 @@ class NoOpenLoan(LendingError):
     def __init__(self, copy_id: str) -> None:
         super().__init__(f"copy {copy_id!r} is not on loan")
         self.copy_id = copy_id
+
+
+class AccountBlocked(LendingError):
+    """The member owes too much to borrow or place a hold until they pay some off."""
+
+    def __init__(self, member_id: str, balance: Decimal) -> None:
+        super().__init__(f"member {member_id!r} owes {balance}")
+        self.member_id = member_id
+        self.balance = balance
+
+
+class InvalidAmount(LendingError):
+    """A money amount that cannot be charged or paid."""
+
+    def __init__(self, amount: object, why: str) -> None:
+        super().__init__(f"amount {amount!r} not accepted: {why}")
+        self.amount = amount
+        self.why = why
+
+
+class MissingReason(LendingError):
+    """A manual charge was given no reason."""
+
+    def __init__(self, member_id: str) -> None:
+        super().__init__(f"manual charge for {member_id!r} needs a reason")
+        self.member_id = member_id
+
+
+class HoldNotAllowed(LendingError):
+    """A hold that cannot be placed, or cancelled because it is already over."""
+
+    def __init__(self, why: str) -> None:
+        super().__init__(f"hold not allowed: {why}")
+        self.why = why
+
+
+class RenewalRefused(LendingError):
+    """A loan that cannot be renewed (a balance owed is ``AccountBlocked``)."""
+
+    def __init__(self, loan_id: str, why: str) -> None:
+        super().__init__(f"loan {loan_id!r} cannot be renewed: {why}")
+        self.loan_id = loan_id
+        self.why = why
+
+
+class HoldNotFound(LendingError):
+    def __init__(self, hold_id: str) -> None:
+        super().__init__(f"no hold {hold_id!r}")
+        self.hold_id = hold_id

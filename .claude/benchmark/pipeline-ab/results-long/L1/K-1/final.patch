new file mode 100644
index 0000000..faae78a
--- /dev/null
+++ b/tests/test_renewals.py
@@ -0,0 +1,270 @@
+"""Renewals. Numbers refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import AccountBlocked, LoanNotFound, RenewalRefused
+from lending.reports import overdue_report
+
+# The conftest clock starts on Monday 2 March 2026. Book title "978-1" (18.00)
+# has copies B1 and B2; Ann borrows B1 that day, due Monday 23 March.
+
+DUE = date(2026, 3, 23)
+
+
+@pytest.fixture
+def svc(service):
+    service.register_member("bob", "Bob Borrower")
+    service.register_member("cat", "Cat Queue")
+    return service
+
+
+@pytest.fixture
+def loan(svc):
+    return svc.checkout("ann", "B1")
+
+
+def renew_on(svc, clock, loan, on):
+    clock.set(on)
+    return svc.renew(loan.loan_id)
+
+
+def snapshot(svc, loan):
+    loan = svc.get_loan(loan.loan_id)
+    return (
+        loan.due_on, loan.renewals, loan.returned_on,
+        svc.balance(loan.member_id), svc.get_copy(loan.copy_id).status,
+    )
+
+
+# granting a renewal ---------------------------------------------------------
+
+
+def test_1_renew_extends_the_same_loan_in_place(svc, clock, loan):
+    renewed = renew_on(svc, clock, loan, date(2026, 3, 19))
+    assert renewed.loan_id == loan.loan_id
+    assert (renewed.copy_id, renewed.member_id) == ("B1", "ann")
+    assert renewed.borrowed_on == date(2026, 3, 2)
+    assert renewed.is_open
+    assert renewed.due_on == date(2026, 4, 9)
+    assert renewed.renewals == 1
+    stored = svc.get_loan(loan.loan_id)
+    assert (stored.due_on, stored.renewals) == (date(2026, 4, 9), 1)
+
+
+def test_2_new_loan_has_no_renewals(loan):
+    assert loan.renewals == 0
+
+
+@pytest.mark.parametrize(
+    "on, due",
+    [
+        (date(2026, 3, 19), date(2026, 4, 9)),  # Thursday → Thursday
+        (date(2026, 3, 22), date(2026, 4, 13)),  # Sunday 12 April → Monday
+    ],
+)
+def test_3_new_due_date_counts_from_the_renewal_day(svc, clock, loan, on, due):
+    assert renew_on(svc, clock, loan, on).due_on == due
+
+
+def test_4_renewed_copy_stays_out_and_history_shows_one_loan(svc, clock, loan):
+    renew_on(svc, clock, loan, date(2026, 3, 19))
+    assert svc.get_copy("B1").status is CopyStatus.ON_LOAN
+    assert [l.loan_id for l in svc.loan_history("ann")] == [loan.loan_id]
+    assert [l.loan_id for l in svc.open_loans("ann")] == [loan.loan_id]
+
+
+@pytest.mark.parametrize("on", [date(2026, 3, 18), DUE])
+def test_5_on_time_renewal_charges_nothing(svc, clock, loan, on):
+    renew_on(svc, clock, loan, on)
+    assert svc.balance("ann") == 0
+
+
+# window and limit -----------------------------------------------------------
+
+
+def test_6_too_early_is_refused(svc, clock, loan):
+    with pytest.raises(RenewalRefused):
+        renew_on(svc, clock, loan, date(2026, 3, 17))
+
+
+@pytest.mark.parametrize(
+    "on", [date(2026, 3, 18), DUE, date(2026, 3, 24), date(2026, 6, 1)]
+)
+def test_6_renewable_from_five_days_before_due_with_no_upper_limit(
+    svc, clock, loan, on
+):
+    assert renew_on(svc, clock, loan, on).renewals == 1
+
+
+def test_7_window_counts_from_the_current_due_date(svc, clock, loan):
+    renew_on(svc, clock, loan, date(2026, 3, 19))  # now due Thu 9 April
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    with pytest.raises(RenewalRefused):
+        renew_on(svc, clock, loan, date(2026, 4, 3))
+    assert renew_on(svc, clock, loan, date(2026, 4, 4)).renewals == 2
+
+
+def test_8_third_renewal_is_refused(svc, clock, loan):
+    renew_on(svc, clock, loan, date(2026, 3, 18))  # due Wed 8 April
+    renew_on(svc, clock, loan, date(2026, 4, 3))  # due Fri 24 April
+    with pytest.raises(RenewalRefused):
+        renew_on(svc, clock, loan, date(2026, 4, 20))
+    assert svc.get_loan(loan.loan_id).renewals == 2
+
+
+# refusals -------------------------------------------------------------------
+
+
+def test_9_unknown_loan_is_loan_not_found(svc):
+    with pytest.raises(LoanNotFound):
+        svc.renew("L9999")
+
+
+def test_10_returned_loan_is_refused(svc, clock, loan):
+    clock.set(date(2026, 3, 20))
+    svc.return_copy("B1")
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+
+
+def test_11_dvd_is_refused(svc, clock):
+    dvd = svc.checkout("ann", "D1")  # due Mon 9 March
+    for on in (date(2026, 3, 9), date(2026, 3, 12)):
+        with pytest.raises(RenewalRefused):
+            renew_on(svc, clock, dvd, on)
+    assert svc.balance("ann") == 0
+
+
+def test_12_waiting_hold_blocks_ready_hold_does_not(svc, clock, loan):
+    svc.checkout("bob", "B2")
+    hold = svc.place_hold("cat", "978-1")
+    clock.set(DUE)
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    svc.return_copy("B2")  # set aside for Cat
+    assert hold.status is HoldStatus.READY
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+@pytest.mark.parametrize("member_id, copy_id", [("ann", "B1"), ("kid", "B2")])
+def test_13_any_balance_blocks_until_paid(svc, clock, member_id, copy_id):
+    loan = svc.checkout(member_id, copy_id)
+    svc.add_charge(member_id, Decimal("0.01"), "lost bookmark")
+    clock.set(DUE)
+    with pytest.raises(AccountBlocked):
+        svc.renew(loan.loan_id)
+    svc.pay(member_id, Decimal("0.01"))
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_13_no_show_fee_blocks_renewal(svc, clock, loan):
+    svc.checkout("bob", "D1")
+    svc.place_hold("ann", "dvd-1")
+    clock.set(date(2026, 3, 9))
+    svc.return_copy("D1")  # ready for Ann, pickup by Mon 16 March
+    clock.set(date(2026, 3, 18))
+    svc.expire_holds()  # 1.00 no-show fee
+    with pytest.raises(AccountBlocked):
+        svc.renew(loan.loan_id)
+
+
+def test_14_refused_renewal_changes_nothing(svc, clock, loan):
+    # Overdue (would charge a fine) but blocked by a waiting hold.
+    svc.checkout("bob", "B2")
+    svc.place_hold("cat", "978-1")
+    clock.set(date(2026, 3, 30))
+    before = snapshot(svc, loan)
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    assert snapshot(svc, loan) == before
+
+
+def test_14_refused_for_balance_charges_no_fine(svc, clock, loan):
+    svc.add_charge("ann", Decimal("0.01"), "lost bookmark")
+    clock.set(date(2026, 3, 30))
+    before = snapshot(svc, loan)
+    with pytest.raises(AccountBlocked):
+        svc.renew(loan.loan_id)
+    assert snapshot(svc, loan) == before
+
+
+def test_14_refused_for_window_or_limit_changes_nothing(svc, clock, loan):
+    clock.set(date(2026, 3, 17))
+    before = snapshot(svc, loan)
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    assert snapshot(svc, loan) == before
+
+
+# lateness is never lost -----------------------------------------------------
+
+
+def test_15_overdue_renewal_charges_the_fine_so_far(svc, clock, loan):
+    renewed = renew_on(svc, clock, loan, date(2026, 3, 30))  # 6 late days
+    assert svc.balance("ann") == Decimal("1.50")
+    assert renewed.due_on == date(2026, 4, 20)
+
+
+def test_16_accrued_fine_blocks_the_next_renewal_until_paid(svc, clock, loan):
+    renew_on(svc, clock, loan, date(2026, 3, 30))  # 1.50, due Mon 20 April
+    clock.set(date(2026, 4, 20))
+    with pytest.raises(AccountBlocked):
+        svc.renew(loan.loan_id)
+    svc.pay("ann", Decimal("1.50"))
+    assert svc.renew(loan.loan_id).renewals == 2
+
+
+def test_17_return_counts_lateness_from_the_new_due_date(svc, clock, loan):
+    renew_on(svc, clock, loan, date(2026, 3, 30))  # 1.50
+    clock.set(date(2026, 4, 22))  # Tue 21, Wed 22 late
+    svc.return_copy("B1")
+    assert svc.balance("ann") == Decimal("2.00")
+
+
+def test_18_child_overdue_renewal_is_free(svc, clock):
+    loan = svc.checkout("kid", "B2")
+    renewed = renew_on(svc, clock, loan, date(2026, 3, 30))
+    assert renewed.renewals == 1
+    assert svc.balance("kid") == 0
+
+
+def test_19_fines_for_one_loan_never_exceed_replacement_cost(svc, clock):
+    svc.add_title("978-2", "Pamphlet", Material.BOOK, Decimal("2.00"))
+    svc.add_copy("C1", "978-2")
+    loan = svc.checkout("ann", "C1")  # due Mon 23 March
+    renew_on(svc, clock, loan, date(2026, 3, 27))  # 4 late days: 1.00
+    assert svc.balance("ann") == Decimal("1.00")
+    assert loan.due_on == date(2026, 4, 17)
+    svc.pay("ann", Decimal("1.00"))
+    clock.set(date(2026, 4, 24))  # 6 late days would be 1.50
+    svc.return_copy("C1")
+    assert svc.balance("ann") == Decimal("1.00")
+
+
+def test_19_cap_reached_at_renewal_leaves_nothing_for_return(svc, clock):
+    svc.add_title("978-2", "Pamphlet", Material.BOOK, Decimal("2.00"))
+    svc.add_copy("C1", "978-2")
+    loan = svc.checkout("ann", "C1")
+    renew_on(svc, clock, loan, date(2026, 4, 6))  # 12 late days: capped at 2.00
+    assert svc.balance("ann") == Decimal("2.00")
+    clock.set(date(2026, 5, 15))
+    svc.return_copy("C1")
+    assert svc.balance("ann") == Decimal("2.00")
+
+
+# general --------------------------------------------------------------------
+
+
+def test_20_overdue_listings_use_the_renewed_due_date(svc, clock, loan):
+    renew_on(svc, clock, loan, date(2026, 3, 19))  # due Thu 9 April
+    assert svc.overdue_loans(date(2026, 3, 30)) == []
+    assert overdue_report(svc, as_of=date(2026, 3, 30)) == []
+    [line] = overdue_report(svc, as_of=date(2026, 4, 10))
+    assert (line.loan_id, line.due_on, line.days_overdue) == (
+        loan.loan_id, date(2026, 4, 9), 1,
+    )

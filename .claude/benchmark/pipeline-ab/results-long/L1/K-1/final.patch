new file mode 100644
index 0000000..4181bd5
--- /dev/null
+++ b/tests/test_accounts.py
@@ -0,0 +1,258 @@
+"""Overdue fines and member accounts. Numbers refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus
+from lending.errors import AccountBlocked, InvalidAmount, MemberNotFound
+
+# The conftest clock starts on Monday 2 March 2026:
+# book B1 is due Monday 23 March, DVD D1 Monday 9 March.
+
+BAD_AMOUNTS = [
+    Decimal("0"),
+    Decimal("0.00"),
+    Decimal("-0"),
+    Decimal("-1.00"),
+    Decimal("0.005"),
+    Decimal("2.501"),
+    Decimal("NaN"),
+    Decimal("Infinity"),
+    Decimal("1E+40"),
+    1.5,
+    5,
+    "5.00",
+]
+
+
+def late_return(service, clock, member_id, copy_id, on):
+    service.checkout(member_id, copy_id)
+    clock.set(on)
+    return service.return_copy(copy_id)
+
+
+# fines on return -----------------------------------------------------------
+
+
+def test_1_book_six_late_days_skipping_sunday(service, clock):
+    late_return(service, clock, "ann", "B1", date(2026, 3, 30))
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_2_dvd_one_day_late_costs_one(service, clock):
+    late_return(service, clock, "ann", "D1", date(2026, 3, 10))
+    assert service.balance("ann") == Decimal("1.00")
+
+
+@pytest.mark.parametrize("on", [date(2026, 3, 5), date(2026, 3, 9)])
+def test_3_on_time_or_early_costs_nothing(service, clock, on):
+    late_return(service, clock, "ann", "D1", on)
+    assert service.balance("ann") == 0
+
+
+def test_4_sunday_return_adds_nothing_for_the_sunday(service, clock):
+    # Tue 10 .. Sat 14 March are late days; Sunday 15 is not.
+    late_return(service, clock, "ann", "D1", date(2026, 3, 15))
+    assert service.balance("ann") == Decimal("5.00")
+
+
+def test_5_fine_is_capped_at_replacement_cost(service, clock):
+    # Wed 1 April is 20 open days after Mon 9 March; the DVD costs 12.00.
+    late_return(service, clock, "ann", "D1", date(2026, 4, 1))
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_5_fine_below_the_cap_is_not_cut(service, clock):
+    # Sat 21 March is 11 open days late.
+    late_return(service, clock, "ann", "D1", date(2026, 3, 21))
+    assert service.balance("ann") == Decimal("11.00")
+
+
+def test_6_children_are_never_fined(service, clock):
+    loan = late_return(service, clock, "kid", "D1", date(2026, 4, 1))
+    assert service.balance("kid") == 0
+    assert loan.returned_on == date(2026, 4, 1)
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("kid") == []
+
+
+def test_7_late_return_still_returns_the_closed_loan(service, clock):
+    loan = service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 12))
+    returned = service.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == date(2026, 3, 12)
+    assert not returned.is_open
+
+
+def test_8_each_late_return_adds_its_own_fine(service, clock):
+    service.checkout("ann", "B1")
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 10))
+    service.return_copy("D1")  # 1.00
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")  # 1.50
+    assert service.balance("ann") == Decimal("2.50")
+
+
+def test_8_same_copy_late_twice_is_fined_twice(service, clock):
+    late_return(service, clock, "ann", "D1", date(2026, 3, 10))  # 1.00
+    service.checkout("ann", "D1")  # due Tue 17 March
+    clock.set(date(2026, 3, 19))
+    service.return_copy("D1")  # 2.00
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_9_overdue_loan_still_out_adds_nothing(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 4, 1))
+    assert service.overdue_loans() != []
+    assert service.balance("ann") == 0
+
+
+# balance -------------------------------------------------------------------
+
+
+def test_10_new_member_owes_nothing(service):
+    member = service.register_member("new", "New Member")
+    owed = service.balance(member.member_id)
+    assert owed == Decimal("0")
+    assert isinstance(owed, Decimal)
+
+
+def test_11_unknown_member_is_member_not_found(service):
+    with pytest.raises(MemberNotFound):
+        service.balance("nobody")
+    for amount in (Decimal("1.00"), Decimal("-1"), 1.5):
+        with pytest.raises(MemberNotFound):
+            service.add_charge("nobody", amount, "damage")
+        with pytest.raises(MemberNotFound):
+            service.pay("nobody", amount)
+
+
+def test_12_amounts_are_decimal(service, clock):
+    late_return(service, clock, "ann", "B1", date(2026, 3, 30))
+    assert isinstance(service.balance("ann"), Decimal)
+    assert isinstance(service.add_charge("ann", Decimal("2.00"), "damage"), Decimal)
+    assert isinstance(service.pay("ann", Decimal("1.00")), Decimal)
+
+
+# manual charges ------------------------------------------------------------
+
+
+def test_13_charge_adds_to_the_same_balance_as_fines(service, clock):
+    late_return(service, clock, "ann", "B1", date(2026, 3, 30))  # 1.50
+    assert service.add_charge("ann", Decimal("3.20"), "torn cover") == Decimal("4.70")
+    assert service.balance("ann") == Decimal("4.70")
+
+
+def test_13_children_can_be_charged_manually(service):
+    assert service.add_charge("kid", Decimal("2.00"), "lost case") == Decimal("2.00")
+
+
+def test_13_trailing_zeros_are_still_whole_cents(service):
+    assert service.add_charge("ann", Decimal("1.500"), "damage") == Decimal("1.50")
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_14_charge_refuses_bad_amounts(service, amount):
+    service.add_charge("ann", Decimal("4.00"), "damage")
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", amount, "damage")
+    assert service.balance("ann") == Decimal("4.00")
+
+
+@pytest.mark.parametrize("reason", ["", "   "])
+def test_14_charge_needs_a_reason(service, reason):
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", Decimal("1.00"), reason)
+    assert service.balance("ann") == 0
+
+
+# payments ------------------------------------------------------------------
+
+
+def test_15_payment_lowers_the_balance(service):
+    service.add_charge("ann", Decimal("7.00"), "damage")
+    assert service.pay("ann", Decimal("2.50")) == Decimal("4.50")
+    assert service.balance("ann") == Decimal("4.50")
+
+
+def test_15_paying_everything_leaves_zero(service, clock):
+    late_return(service, clock, "ann", "B1", date(2026, 3, 30))
+    assert service.pay("ann", Decimal("1.50")) == 0
+    assert service.balance("ann") == 0
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_16_payment_refuses_bad_amounts(service, amount):
+    service.add_charge("ann", Decimal("20.00"), "damage")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", amount)
+    assert service.balance("ann") == Decimal("20.00")
+
+
+def test_16_cannot_pay_more_than_owed(service):
+    service.add_charge("ann", Decimal("3.00"), "damage")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("3.01"))
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_16_cannot_pay_when_nothing_is_owed(service):
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("0.01"))
+    assert service.balance("ann") == 0
+
+
+# borrowing block -----------------------------------------------------------
+
+
+def test_17_exactly_ten_blocks_borrowing(service):
+    service.add_charge("ann", Decimal("10.00"), "damage")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_17_just_under_ten_may_borrow(service):
+    service.add_charge("ann", Decimal("9.99"), "damage")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+def test_17_fines_count_toward_the_block(service, clock):
+    # Fri 20 March is 10 open days after the DVD's due date: 10.00.
+    late_return(service, clock, "ann", "D1", date(2026, 3, 20))
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_17_children_share_the_same_bar(service):
+    service.add_charge("kid", Decimal("10.00"), "lost case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("kid", "B1")
+
+
+def test_18_refused_checkout_changes_nothing(service):
+    service.add_charge("ann", Decimal("15.00"), "damage")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.loan_history("ann") == []
+    assert service.checkout("kid", "B1").member_id == "kid"
+
+
+def test_19_blocked_member_can_return_and_pay_then_borrow(service, clock):
+    service.checkout("ann", "B1")
+    service.add_charge("ann", Decimal("10.00"), "damage")
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")  # +1.50
+    assert service.balance("ann") == Decimal("11.50")
+    assert service.pay("ann", Decimal("1.51")) == Decimal("9.99")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+def test_20_unknown_member_cannot_borrow(service):
+    with pytest.raises(MemberNotFound):
+        service.checkout("nobody", "B1")
diff --git a/tests/test_holds.py b/tests/test_holds.py
new file mode 100644
index 0000000..d536be4
--- /dev/null
+++ b/tests/test_holds.py
@@ -0,0 +1,460 @@
+"""Holds. Numbers refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    HoldNotAllowed,
+    HoldNotFound,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+
+# The conftest clock starts on Monday 2 March 2026. DVD title "dvd-1" has one
+# copy, D1, due back Monday 9 March when borrowed on the 2nd. Book title
+# "978-1" has two copies, B1 and B2.
+
+MON_9 = date(2026, 3, 9)
+MON_16 = date(2026, 3, 16)
+TUE_17 = date(2026, 3, 17)
+
+
+@pytest.fixture
+def svc(service):
+    service.register_member("bob", "Bob Borrower")
+    service.register_member("cat", "Cat Queue")
+    return service
+
+
+@pytest.fixture
+def dvd_out(svc):
+    """Bob has the only copy of dvd-1."""
+    svc.checkout("bob", "D1")
+    return svc
+
+
+def set_aside(svc, clock, on=MON_9):
+    """Ann, then Cat, queue for dvd-1; Bob returns D1 on ``on``."""
+    ann = svc.place_hold("ann", "dvd-1")
+    cat = svc.place_hold("cat", "dvd-1")
+    clock.set(on)
+    svc.return_copy("D1")
+    return ann, cat
+
+
+def ids(holds):
+    return [h.hold_id for h in holds]
+
+
+# placing a hold -------------------------------------------------------------
+
+
+def test_1_new_hold_is_waiting(dvd_out):
+    hold = dvd_out.place_hold("ann", "dvd-1")
+    assert hold.hold_id
+    assert (hold.member_id, hold.isbn) == ("ann", "dvd-1")
+    assert hold.placed_on == date(2026, 3, 2)
+    assert hold.status is HoldStatus.WAITING
+    assert hold.copy_id is None and hold.pickup_by is None
+    assert dvd_out.holds_for("dvd-1") == [hold]
+
+
+def test_1_hold_ids_are_unique(dvd_out):
+    a = dvd_out.place_hold("ann", "dvd-1")
+    c = dvd_out.place_hold("cat", "dvd-1")
+    assert a.hold_id != c.hold_id
+
+
+def test_2_unknown_member_or_title(dvd_out):
+    with pytest.raises(MemberNotFound):
+        dvd_out.place_hold("nobody", "dvd-1")
+    with pytest.raises(TitleNotFound):
+        dvd_out.place_hold("ann", "no-such-isbn")
+
+
+@pytest.mark.parametrize("member_id", ["ann", "kid"])
+def test_3_balance_of_five_blocks_holds(dvd_out, member_id):
+    dvd_out.add_charge(member_id, Decimal("5.00"), "lost card")
+    with pytest.raises(AccountBlocked):
+        dvd_out.place_hold(member_id, "dvd-1")
+
+
+@pytest.mark.parametrize("member_id", ["ann", "kid"])
+def test_3_balance_of_4_99_may_hold(dvd_out, member_id):
+    dvd_out.add_charge(member_id, Decimal("4.99"), "lost card")
+    assert dvd_out.place_hold(member_id, "dvd-1").status is HoldStatus.WAITING
+
+
+def test_4_refused_while_a_copy_is_on_the_shelf(svc):
+    svc.checkout("bob", "B1")  # B2 is still on the shelf
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "978-1")
+
+
+def test_4_copy_on_hold_shelf_for_someone_else_counts_as_out(dvd_out, clock):
+    dvd_out.place_hold("ann", "dvd-1")
+    clock.set(MON_9)
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert dvd_out.place_hold("cat", "dvd-1").status is HoldStatus.WAITING
+
+
+def test_5_refused_for_title_with_no_copies(svc):
+    svc.add_title("978-9", "Empty Shelf", Material.BOOK, Decimal("10.00"))
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "978-9")
+
+
+def test_5_refused_when_every_copy_is_withdrawn(svc):
+    svc.withdraw_copy("D1")
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "dvd-1")
+
+
+def test_6_one_active_hold_per_member_and_title(dvd_out):
+    first = dvd_out.place_hold("ann", "dvd-1")
+    with pytest.raises(HoldNotAllowed):
+        dvd_out.place_hold("ann", "dvd-1")
+    dvd_out.cancel_hold(first.hold_id)
+    again = dvd_out.place_hold("ann", "dvd-1")
+    assert again.hold_id != first.hold_id
+    assert dvd_out.holds_for("dvd-1") == [again]
+
+
+def test_6_ready_hold_also_counts(dvd_out, clock):
+    ann, _ = set_aside(dvd_out, clock)
+    assert ann.status is HoldStatus.READY
+    with pytest.raises(HoldNotAllowed):
+        dvd_out.place_hold("ann", "dvd-1")
+
+
+def test_6_may_hold_again_after_fulfilled_and_returned(dvd_out, clock):
+    ann, _ = set_aside(dvd_out, clock)
+    dvd_out.checkout("ann", "D1")
+    dvd_out.return_copy("D1")  # goes to Cat
+    assert dvd_out.place_hold("ann", "dvd-1").status is HoldStatus.WAITING
+
+
+def test_7_refused_while_member_has_the_title_on_loan(svc):
+    svc.checkout("ann", "D1")
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "dvd-1")
+
+
+def test_8_refused_hold_changes_nothing(dvd_out):
+    dvd_out.add_charge("ann", Decimal("5.00"), "lost card")
+    kept = dvd_out.place_hold("cat", "dvd-1")
+    for member_id, isbn in [("ann", "dvd-1"), ("cat", "dvd-1"), ("bob", "dvd-1")]:
+        with pytest.raises((AccountBlocked, HoldNotAllowed)):
+            dvd_out.place_hold(member_id, isbn)
+    assert dvd_out.holds_for("dvd-1") == [kept]
+    assert dvd_out.balance("ann") == Decimal("5.00")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_LOAN
+
+
+# returning a copy someone is waiting for ------------------------------------
+
+
+def test_9_return_sets_copy_aside_for_first_in_line(dvd_out, clock):
+    ann, cat = set_aside(dvd_out, clock)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert ann.status is HoldStatus.READY and ann.copy_id == "D1"
+    assert cat.status is HoldStatus.WAITING and cat.copy_id is None
+
+
+@pytest.mark.parametrize(
+    "returned_on, pickup_by",
+    [
+        (MON_9, MON_16),
+        (date(2026, 3, 14), date(2026, 3, 21)),  # Sat -> Sat
+        (date(2026, 3, 15), date(2026, 3, 23)),  # Sun -> Sun 22 -> Mon 23
+    ],
+)
+def test_10_pickup_by_is_seven_days_sunday_to_monday(
+    dvd_out, clock, returned_on, pickup_by
+):
+    ann, _ = set_aside(dvd_out, clock, on=returned_on)
+    assert ann.pickup_by == pickup_by
+
+
+def test_11_no_waiting_hold_shelves_the_copy(dvd_out, clock):
+    hold = dvd_out.place_hold("ann", "dvd-1")
+    dvd_out.cancel_hold(hold.hold_id)
+    clock.set(MON_9)
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+
+
+def test_12_return_still_closes_loan_and_charges_fine(dvd_out, clock):
+    dvd_out.place_hold("ann", "dvd-1")
+    clock.set(date(2026, 3, 10))  # one late day
+    loan = dvd_out.return_copy("D1")
+    assert loan.returned_on == date(2026, 3, 10) and not loan.is_open
+    assert dvd_out.balance("bob") == Decimal("1.00")
+    assert dvd_out.holds_for("dvd-1")[0].pickup_by == TUE_17
+
+
+# collecting -----------------------------------------------------------------
+
+
+def test_13_hold_member_collects_and_hold_is_fulfilled(dvd_out, clock):
+    ann, cat = set_aside(dvd_out, clock)
+    loan = dvd_out.checkout("ann", "D1")
+    assert loan.member_id == "ann" and loan.copy_id == "D1"
+    assert loan.borrowed_on == MON_9 and loan.due_on == MON_16
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_LOAN
+    assert ann.status is HoldStatus.FULFILLED
+    assert dvd_out.holds_for("dvd-1") == [cat]
+
+
+@pytest.mark.parametrize("member_id", ["cat", "bob", "kid"])
+def test_14_nobody_else_may_borrow_from_the_hold_shelf(dvd_out, clock, member_id):
+    ann, _ = set_aside(dvd_out, clock)
+    with pytest.raises(CopyNotAvailable):
+        dvd_out.checkout(member_id, "D1")
+    assert ann.status is HoldStatus.READY
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_15_loan_limit_still_applies(dvd_out, clock):
+    hold = dvd_out.place_hold("kid", "dvd-1")
+    for copy_id in ["B3", "B4"]:
+        dvd_out.add_copy(copy_id, "978-1")
+    for copy_id in ["B1", "B2", "B3", "B4"]:  # a child's limit is 4
+        dvd_out.checkout("kid", copy_id)
+    clock.set(MON_9)
+    dvd_out.return_copy("D1")
+    with pytest.raises(LoanLimitReached):
+        dvd_out.checkout("kid", "D1")
+    assert hold.status is HoldStatus.READY
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert len(dvd_out.open_loans("kid")) == 4
+
+
+def test_15_borrowing_block_still_applies(dvd_out, clock):
+    ann, _ = set_aside(dvd_out, clock)
+    dvd_out.add_charge("ann", Decimal("10.00"), "lost book")
+    with pytest.raises(AccountBlocked):
+        dvd_out.checkout("ann", "D1")
+    assert ann.status is HoldStatus.READY
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert dvd_out.open_loans("ann") == []
+    dvd_out.pay("ann", Decimal("10.00"))
+    dvd_out.checkout("ann", "D1")
+    assert ann.status is HoldStatus.FULFILLED
+
+
+def test_16_collecting_on_the_pickup_by_day_works(dvd_out, clock):
+    ann, _ = set_aside(dvd_out, clock)
+    clock.set(MON_16)
+    assert dvd_out.expire_holds() == []
+    dvd_out.checkout("ann", "D1")
+    assert ann.status is HoldStatus.FULFILLED
+
+
+# cancelling -----------------------------------------------------------------
+
+
+def test_17_cancel_waiting_hold(dvd_out):
+    ann = dvd_out.place_hold("ann", "dvd-1")
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    result = dvd_out.cancel_hold(ann.hold_id)

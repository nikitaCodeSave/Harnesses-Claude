+
+
+# fines and accounts ----------------------------------------------------
+
+FINE_PER_DAY: dict[Material, Decimal] = {
+    Material.BOOK: Decimal("0.25"),
+    Material.DVD: Decimal("1.00"),
+}
+
+# Children are never charged overdue fines.
+FINED_CATEGORIES: frozenset[MemberCategory] = frozenset({MemberCategory.ADULT})
+
+# A member owing this much or more cannot borrow.
+BORROW_BLOCK_AT = Decimal("10.00")
+
+# A member owing this much or more cannot place a hold (ADR 0003).
+HOLD_BLOCK_AT = Decimal("5.00")
+
+# A member owing anything at all cannot renew: only paid-up members (ADR 0006).
+RENEW_BLOCK_AT = Decimal("0.01")
+

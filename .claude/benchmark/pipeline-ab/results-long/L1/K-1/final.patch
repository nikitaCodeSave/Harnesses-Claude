+RENEWABLE_MATERIALS: frozenset[Material] = frozenset({Material.BOOK})
+MAX_RENEWALS = 2
+
+# A loan can be renewed from this many days before its due date onwards.
+RENEW_WINDOW_DAYS = 5
+
+
+def renewable_from(due_on: date) -> date:
+    """First day a loan due ``due_on`` can be renewed."""
+    return due_on - timedelta(days=RENEW_WINDOW_DAYS)
+
+
+# holds -----------------------------------------------------------------
+
+# Calendar days a ready hold waits on the hold shelf (ADR 0005).
+PICKUP_DAYS = 7
+
+# Charged when a ready hold expires uncollected; children are exempt (ADR 0003).
+NO_SHOW_FEE = Decimal("1.00")
+NO_SHOW_FEE_CATEGORIES: frozenset[MemberCategory] = frozenset({MemberCategory.ADULT})
+
+
+def pickup_by(set_aside_on: date) -> date:
+    """Last day to collect a copy set aside on ``set_aside_on``."""
+    return next_open_day(set_aside_on + timedelta(days=PICKUP_DAYS))
+
+
+def no_show_fee(category: MemberCategory) -> Decimal:
+    if category not in NO_SHOW_FEE_CATEGORIES:
+        return Decimal("0.00")
+    return NO_SHOW_FEE
+
+
+def late_days(due_on: date, as_of: date) -> int:
+    """Open days after ``due_on`` up to and including ``as_of``.
+
+    Closed days don't count: nobody could have brought the copy back then.
+    Unlike the overdue report, which counts calendar days.
+    """
+    days = 0
+    day = due_on + timedelta(days=1)
+    while day <= as_of:
+        if is_open_day(day):
+            days += 1
+        day += timedelta(days=1)
+    return days
+
+
+def late_fine(
+    material: Material,
+    category: MemberCategory,
+    due_on: date,
+    as_of: date,
+    replacement_cost: Decimal,
+    already_fined: Decimal = Decimal("0.00"),
+) -> Decimal:
+    """Fine for a copy due ``due_on`` coming back on ``as_of``.
+
+    Zero for categories never fined. Renewals of overdue loans must charge
+    through this too (ADR 0004). The replacement cost caps all fines for one
+    loan together, so ``already_fined`` (charged earlier on the same loan) uses
+    up part of it (ADR 0007).
+    """
+    if category not in FINED_CATEGORIES:
+        return Decimal("0.00")
+    fine = FINE_PER_DAY[material] * late_days(due_on, as_of)
+    return max(min(fine, replacement_cost - already_fined), Decimal("0.00"))

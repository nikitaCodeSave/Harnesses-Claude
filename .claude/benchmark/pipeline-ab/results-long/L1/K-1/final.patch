+    assert dvd_out.holds_for("dvd-1") == [cat]
+    assert dvd_out.balance("ann") == 0
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_LOAN
+
+
+def test_18_cancel_ready_hold_passes_copy_to_next_in_line(dvd_out, clock):
+    ann, cat = set_aside(dvd_out, clock)
+    clock.set(date(2026, 3, 11))
+    dvd_out.cancel_hold(ann.hold_id)
+    assert ann.status is HoldStatus.CANCELLED
+    assert dvd_out.balance("ann") == 0
+    assert cat.status is HoldStatus.READY and cat.copy_id == "D1"
+    assert cat.pickup_by == date(2026, 3, 18)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    dvd_out.checkout("cat", "D1")
+    assert cat.status is HoldStatus.FULFILLED
+
+
+def test_18_cancel_on_a_sunday_moves_next_pickup_to_monday(dvd_out, clock):
+    ann, cat = set_aside(dvd_out, clock)
+    clock.set(date(2026, 3, 15))
+    dvd_out.cancel_hold(ann.hold_id)
+    assert cat.pickup_by == date(2026, 3, 23)
+
+
+def test_18_cancel_ready_hold_with_nobody_waiting_shelves_copy(dvd_out, clock):
+    ann, cat = set_aside(dvd_out, clock)
+    dvd_out.cancel_hold(cat.hold_id)
+    dvd_out.cancel_hold(ann.hold_id)
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert dvd_out.holds_for("dvd-1") == []
+    dvd_out.checkout("bob", "D1")
+
+
+def test_19_cancel_unknown_hold(svc):
+    with pytest.raises(HoldNotFound):
+        svc.cancel_hold("H9999")
+
+
+def test_19_cancel_finished_holds_is_refused(dvd_out, clock):
+    ann, cat = set_aside(dvd_out, clock)
+    dvd_out.checkout("ann", "D1")  # fulfilled
+    dvd_out.cancel_hold(cat.hold_id)  # cancelled
+    dvd_out.register_member("dee", "Dee")
+    dee = dvd_out.place_hold("dee", "dvd-1")
+    dvd_out.return_copy("D1")
+    clock.set(TUE_17)
+    dvd_out.expire_holds()  # expired
+    assert dee.status is HoldStatus.EXPIRED
+    for hold, status in [
+        (ann, HoldStatus.FULFILLED),
+        (cat, HoldStatus.CANCELLED),
+        (dee, HoldStatus.EXPIRED),
+    ]:
+        with pytest.raises(HoldNotAllowed):
+            dvd_out.cancel_hold(hold.hold_id)
+        assert hold.status is status
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+
+
+# the daily job --------------------------------------------------------------
+
+
+def test_20_expires_only_after_pickup_by(dvd_out, clock):
+    ann, _ = set_aside(dvd_out, clock)
+    clock.set(MON_16)
+    assert dvd_out.expire_holds() == []
+    assert ann.status is HoldStatus.READY
+    clock.set(TUE_17)
+    assert dvd_out.expire_holds() == [ann]
+    assert ann.status is HoldStatus.EXPIRED
+
+
+def test_20_returns_every_hold_it_expired(svc, clock):
+    svc.checkout("bob", "B1")
+    svc.checkout("cat", "B2")
+    a = svc.place_hold("ann", "978-1")
+    k = svc.place_hold("kid", "978-1")
+    svc.return_copy("B1")
+    svc.return_copy("B2")
+    clock.set(date(2026, 3, 10))
+    assert ids(svc.expire_holds()) == ids([a, k])
+
+
+def test_20_nothing_to_expire(svc):
+    assert svc.expire_holds() == []
+
+
+def test_21_adult_no_show_fee(dvd_out, clock):
+    set_aside(dvd_out, clock)
+    clock.set(TUE_17)
+    dvd_out.expire_holds()
+    assert dvd_out.balance("ann") == Decimal("1.00")
+    assert dvd_out.balance("cat") == 0
+
+
+def test_21_children_pay_no_no_show_fee(dvd_out, clock):
+    kid = dvd_out.place_hold("kid", "dvd-1")
+    clock.set(MON_9)
+    dvd_out.return_copy("D1")
+    clock.set(TUE_17)
+    assert dvd_out.expire_holds() == [kid]
+    assert dvd_out.balance("kid") == 0
+
+
+def test_21_fee_counts_toward_the_hold_bar(dvd_out, clock):
+    dvd_out.add_charge("ann", Decimal("4.00"), "lost card")
+    set_aside(dvd_out, clock)
+    clock.set(TUE_17)
+    dvd_out.expire_holds()
+    dvd_out.checkout("cat", "D1")
+    with pytest.raises(AccountBlocked):
+        dvd_out.place_hold("ann", "dvd-1")
+
+
+def test_21_fee_counts_toward_the_borrowing_block(dvd_out, clock):
+    set_aside(dvd_out, clock)
+    dvd_out.add_charge("ann", Decimal("9.00"), "lost book")  # after placing
+    clock.set(TUE_17)
+    dvd_out.expire_holds()
+    assert dvd_out.balance("ann") == Decimal("10.00")
+    with pytest.raises(AccountBlocked):
+        dvd_out.checkout("ann", "B1")
+
+
+@pytest.mark.parametrize(
+    "run_on, pickup_by",
+    [
+        (TUE_17, date(2026, 3, 24)),
+        (date(2026, 3, 19), date(2026, 3, 26)),  # missed two days
+        (date(2026, 3, 22), date(2026, 3, 30)),  # Sun -> Sun 29 -> Mon 30
+    ],
+)
+def test_22_copy_passes_on_counting_from_the_run_day(
+    dvd_out, clock, run_on, pickup_by
+):
+    ann, cat = set_aside(dvd_out, clock)
+    clock.set(run_on)
+    assert dvd_out.expire_holds() == [ann]
+    assert cat.status is HoldStatus.READY and cat.copy_id == "D1"
+    assert cat.pickup_by == pickup_by
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_22_copy_goes_back_on_shelf_when_nobody_waits(dvd_out, clock):
+    ann = dvd_out.place_hold("ann", "dvd-1")
+    clock.set(MON_9)
+    dvd_out.return_copy("D1")
+    clock.set(TUE_17)
+    dvd_out.expire_holds()
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert dvd_out.holds_for("dvd-1") == []
+
+
+def test_23_waiting_holds_never_expire(dvd_out, clock):
+    ann = dvd_out.place_hold("ann", "dvd-1")
+    clock.set(date(2027, 3, 2))
+    assert dvd_out.expire_holds() == []
+    assert ann.status is HoldStatus.WAITING
+    assert dvd_out.balance("ann") == 0
+
+
+def test_23_second_run_same_day_does_nothing_more(dvd_out, clock):
+    ann, cat = set_aside(dvd_out, clock)
+    clock.set(TUE_17)
+    assert dvd_out.expire_holds() == [ann]
+    assert dvd_out.expire_holds() == []
+    assert dvd_out.balance("ann") == Decimal("1.00")
+    assert cat.status is HoldStatus.READY
+
+
+# listing --------------------------------------------------------------------
+
+
+def test_24_holds_for_lists_active_holds_in_placement_order(dvd_out, clock):
+    dvd_out.register_member("dee", "Dee")
+    ann = dvd_out.place_hold("ann", "dvd-1")
+    cat = dvd_out.place_hold("cat", "dvd-1")
+    dee = dvd_out.place_hold("dee", "dvd-1")
+    dvd_out.cancel_hold(cat.hold_id)
+    clock.set(MON_9)
+    dvd_out.return_copy("D1")
+    assert dvd_out.holds_for("dvd-1") == [ann, dee]
+    assert [h.status for h in dvd_out.holds_for("dvd-1")] == [
+        HoldStatus.READY, HoldStatus.WAITING,
+    ]
+
+
+def test_24_holds_for_empty_and_unknown(svc):
+    assert svc.holds_for("dvd-1") == []
+    with pytest.raises(TitleNotFound):
+        svc.holds_for("no-such-isbn")

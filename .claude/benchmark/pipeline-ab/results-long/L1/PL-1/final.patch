+    assert blocked.value.action == "holds"
+    assert blocked.value.limit == Decimal("5.00")
+    assert service.holds_for("dvd-1") == []
+
+
+def test_a_member_owing_4_99_can_place_a_hold(service):
+    service.checkout("kid", "D1")
+    service.add_charge("ann", Decimal("4.99"), "damaged case")
+    assert service.place_hold("ann", "dvd-1").status is HoldStatus.WAITING
+
+
+def test_child_members_are_blocked_from_holds_too(service):
+    service.checkout("ann", "D1")
+    service.add_charge("kid", Decimal("5.00"), "torn page")
+    with pytest.raises(AccountBlocked):
+        service.place_hold("kid", "dvd-1")
+
+
+def test_a_member_blocked_from_holds_keeps_their_place_in_the_queue(service):

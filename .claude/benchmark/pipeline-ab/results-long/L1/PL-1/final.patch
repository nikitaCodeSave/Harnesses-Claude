+
+
+def test_successive_manual_charges_add_up(service):
+    service.add_charge("ann", Decimal("2.50"), "damaged case")
+    assert service.add_charge("ann", Decimal("1.25"), "lost sleeve") == Decimal("3.75")
+    assert service.balance("ann") == Decimal("3.75")
+
+
+def test_child_members_can_be_given_manual_charges(service):
+    assert service.add_charge("kid", Decimal("4.00"), "torn page") == Decimal("4.00")
+    assert service.balance("kid") == Decimal("4.00")
+
+
+def test_manual_charges_stay_on_their_own_members_account(service):
+    service.add_charge("ann", Decimal("2.50"), "damaged case")
+    assert service.balance("kid") == Decimal("0")
+
+
+@pytest.mark.parametrize("reason", ["", "   ", "x" * 1000, "ripped cover ☹\nsecond line"])
+def test_any_reason_text_is_accepted(service, reason):
+    assert service.add_charge("ann", Decimal("1.00"), reason) == Decimal("1.00")
+
+
+def test_balance_of_unknown_member_is_member_not_found(service):

+    assert service.balance("ann") == Decimal("0")
+
+
+def test_returning_one_late_day_after_the_due_date_is_fined_one_day(service, clock):
+    service.checkout("ann", "B1")
+    return_on(service, clock, "B1", date(2026, 3, 24))
+    assert service.balance("ann") == Decimal("0.25")
+
+
+def test_a_saturday_due_date_returned_on_monday_is_one_late_day(service, clock):

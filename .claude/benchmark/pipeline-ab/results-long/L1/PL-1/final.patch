+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Hold, HoldStatus, Material, MemberCategory
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    HoldNotAllowed,
+    HoldNotFound,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+
+# The fixture's DVD Title "dvd-1" has one copy, D1: the natural Title for queues.
+# The book Title "978-1" has two copies, B1 and B2.
+
+
+def queue(service, isbn):
+    return [h.member_id for h in service.holds_for(isbn)]
+
+
+# Placing a Hold ---------------------------------------------------------
+
+
+def test_placing_a_hold_returns_a_new_waiting_hold_dated_today(service, clock):
+    service.checkout("kid", "D1")
+    clock.set(date(2026, 3, 4))
+    hold = service.place_hold("ann", "dvd-1")
+    assert isinstance(hold, Hold)
+    assert hold.member_id == "ann"
+    assert hold.isbn == "dvd-1"
+    assert hold.placed_on == date(2026, 3, 4)
+    assert hold.status is HoldStatus.WAITING
+    assert hold.copy_id is None
+    assert hold.pickup_by is None
+
+
+def test_a_hold_is_refused_while_a_copy_is_on_the_shelf(service):
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "dvd-1")
+
+
+def test_a_hold_is_refused_while_any_copy_is_on_the_shelf(service):
+    service.checkout("kid", "B1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "978-1")
+
+
+def test_a_hold_is_allowed_once_every_copy_is_on_loan(service):
+    service.checkout("kid", "B1")
+    service.register_member("bob", "Bob Adult")
+    service.checkout("bob", "B2")
+    assert service.place_hold("ann", "978-1").status is HoldStatus.WAITING
+
+
+def test_a_hold_is_refused_on_a_title_with_no_copies(service):
+    service.add_title("978-2", "Coming Soon", Material.BOOK, Decimal("15.00"))
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "978-2")
+
+
+def test_a_hold_is_refused_on_a_title_whose_copies_are_all_withdrawn(service):
+    service.withdraw_copy("D1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "dvd-1")
+
+
+def test_a_hold_is_refused_when_some_copies_are_withdrawn_and_the_rest_on_the_shelf(
+    service,
+):
+    service.withdraw_copy("B1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "978-1")
+
+
+def test_a_withdrawn_copy_does_not_stop_a_hold_behind_a_copy_on_loan(service):
+    service.withdraw_copy("B1")
+    service.checkout("kid", "B2")
+    assert service.place_hold("ann", "978-1").status is HoldStatus.WAITING
+
+
+def test_a_second_hold_on_the_same_title_is_refused(service):
+    service.checkout("kid", "D1")
+    service.place_hold("ann", "dvd-1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "dvd-1")
+
+
+def test_a_hold_is_refused_for_a_member_with_the_title_on_loan(service):
+    service.checkout("ann", "D1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "dvd-1")
+
+
+def test_a_hold_is_refused_for_a_member_with_another_copy_of_the_title_on_loan(
+    service,
+):
+    service.checkout("ann", "B1")
+    service.checkout("kid", "B2")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "978-1")
+
+
+def test_a_member_can_hold_a_title_after_returning_their_copy_of_it(service):
+    service.checkout("ann", "D1")
+    service.return_copy("D1")
+    service.checkout("kid", "D1")
+    assert service.place_hold("ann", "dvd-1").status is HoldStatus.WAITING
+
+
+def refuse_for_copy_on_shelf(service):
+    pass
+
+
+def refuse_for_no_circulating_copies(service):
+    service.withdraw_copy("D1")
+
+
+def refuse_for_existing_hold(service):
+    service.checkout("kid", "D1")
+    service.place_hold("ann", "dvd-1")
+
+
+def refuse_for_title_on_loan(service):
+    service.checkout("ann", "D1")
+
+
+REFUSALS = [
+    pytest.param(refuse_for_copy_on_shelf, "on the shelf", id="copy-on-shelf"),
+    pytest.param(
+        refuse_for_no_circulating_copies, "in circulation", id="no-circulating-copies"
+    ),
+    pytest.param(refuse_for_existing_hold, "already has a Hold", id="already-has-a-hold"),
+    pytest.param(refuse_for_title_on_loan, "on loan", id="has-the-title-on-loan"),
+]
+
+
+@pytest.mark.parametrize("arrange, why", REFUSALS)
+def test_a_refused_hold_says_why(service, arrange, why):
+    arrange(service)
+    with pytest.raises(HoldNotAllowed) as refused:
+        service.place_hold("ann", "dvd-1")
+    assert refused.value.member_id == "ann"
+    assert refused.value.isbn == "dvd-1"
+    assert why in refused.value.reason
+    assert refused.value.reason in str(refused.value)
+
+
+@pytest.mark.parametrize("arrange, why", REFUSALS)
+def test_a_refused_hold_changes_nothing(service, arrange, why):
+    arrange(service)
+    before = service.holds_for("dvd-1")
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("ann", "dvd-1")
+    assert service.holds_for("dvd-1") == before
+
+
+def test_child_members_can_place_holds(service):
+    service.checkout("ann", "D1")
+    hold = service.place_hold("kid", "dvd-1")
+    assert hold.member_id == "kid"
+    assert queue(service, "dvd-1") == ["kid"]
+
+
+def test_a_member_can_hold_any_number_of_different_titles(service):
+    service.register_member("bob", "Bob Adult")
+    films = [f"dvd-{n}" for n in range(10, 18)]  # bob's loan limit is 8
+    for n, isbn in enumerate(films):
+        service.add_title(isbn, f"Film {n}", Material.DVD, Decimal("12.00"))
+        service.add_copy(f"F{n}", isbn)
+        service.checkout("bob", f"F{n}")
+        service.place_hold("ann", isbn)
+    assert [queue(service, isbn) for isbn in films] == [["ann"]] * len(films)
+
+
+# Blocked from holds -----------------------------------------------------
+
+
+def test_a_member_owing_exactly_5_00_is_blocked_from_holds(service):
+    service.checkout("kid", "D1")
+    service.add_charge("ann", Decimal("5.00"), "damaged case")
+    with pytest.raises(AccountBlocked) as blocked:
+        service.place_hold("ann", "dvd-1")

+def _check_amount(amount: object) -> None:
+    """Money on an Account is a positive Decimal in whole cents."""
+    if not isinstance(amount, Decimal):
+        raise InvalidAmount(amount, "not a Decimal")
+    if not amount.is_finite():
+        raise InvalidAmount(amount, "not a finite number")
+    if amount <= 0:
+        raise InvalidAmount(amount, "not positive")
+    # Read the digits rather than quantize, which fails on very large values.
+    _, digits, exponent = amount.as_tuple()
+    assert isinstance(exponent, int)  # finite, so never 'n', 'N' or 'F'
+    sub_cent_places = -exponent - 2
+    if sub_cent_places > 0 and any(digits[-sub_cent_places:]):
+        raise InvalidAmount(amount, "not in whole cents")

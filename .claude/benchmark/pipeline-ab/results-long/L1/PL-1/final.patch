+
+
+def test_each_refusal_gives_its_own_reason(service, clock):
+    dvd = service.checkout("ann", "D1")
+    book = service.checkout("ann", "B1")
+    reasons = set()
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(dvd.loan_id)  # a DVD, also before its window
+    reasons.add(refused.value.reason)
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(book.loan_id)  # before the window
+    reasons.add(refused.value.reason)
+    for day in (date(2026, 3, 18), date(2026, 4, 3)):
+        clock.set(day)
+        service.renew(book.loan_id)
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(book.loan_id)  # allowance used up, also before the window
+    reasons.add(refused.value.reason)
+    assert len(reasons) == 3
+
+
+def test_a_returned_dvd_loan_is_reported_as_returned(service):

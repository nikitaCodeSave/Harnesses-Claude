+    loan = service.checkout("ann", "B1")
+    assert service.open_loans("ann") == [loan]
+
+
+def test_paying_below_the_hold_limit_lets_the_member_place_holds_again(service):
+    service.checkout("kid", "D1")
+    service.add_charge("ann", Decimal("5.00"), "damaged case")
+    with pytest.raises(AccountBlocked):
+        service.place_hold("ann", "dvd-1")

+    # 24 March - 6 April is 14 days; Sundays 29 March and 5 April are skipped.
+    return_on(service, clock, "B1", date(2026, 4, 6))
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_returning_on_the_due_date_costs_nothing(service, clock):

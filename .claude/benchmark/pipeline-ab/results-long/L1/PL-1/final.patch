+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import AccountBlocked, LoanNotFound, RenewalRefused
+
+# The fixture's book Title "978-1" has copies B1 and B2; a book borrowed on
+# START, Monday 2 March, is due Monday 23 March.
+
+
+# Granting a Renewal -----------------------------------------------------
+
+
+def test_a_newly_checked_out_loan_has_never_been_renewed(service):
+    assert service.checkout("ann", "B1").renewals == 0
+
+
+def test_renewing_keeps_the_same_loan_with_a_full_loan_period_from_today(
+    service, clock
+):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 18))  # Wednesday
+    renewed = service.renew(loan.loan_id)
+    assert renewed is service.get_loan(loan.loan_id)
+    assert renewed.loan_id == loan.loan_id
+    assert renewed.copy_id == "B1"
+    assert renewed.member_id == "ann"
+    assert renewed.borrowed_on == date(2026, 3, 2)
+    assert renewed.due_on == date(2026, 4, 8)  # Wednesday
+    assert renewed.renewals == 1
+
+
+def test_a_renewed_due_date_never_falls_on_a_sunday(service, clock):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 22))  # a Sunday: +21 days is Sunday 12 April
+    assert service.renew(loan.loan_id).due_on == date(2026, 4, 13)
+
+
+def test_a_renewed_loan_is_still_one_open_loan_with_the_copy_on_loan(
+    service, clock
+):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 18))
+    service.renew(loan.loan_id)
+    assert service.get_loan(loan.loan_id).due_on == date(2026, 4, 8)
+    assert [l.loan_id for l in service.loan_history("ann")] == [loan.loan_id]
+    assert [l.loan_id for l in service.open_loans("ann")] == [loan.loan_id]
+    assert service.get_copy("B1").status is CopyStatus.ON_LOAN
+
+
+# After a Renewal ----------------------------------------------------------
+
+
+def test_a_renewed_loan_is_not_overdue_until_its_new_due_date(service, clock):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 18))
+    service.renew(loan.loan_id)
+    clock.set(date(2026, 3, 25))  # past the old due date, Monday 23 March
+    assert service.overdue_loans() == []
+    assert service.overdue_loans(as_of=date(2026, 4, 9)) == [loan]
+
+
+def test_returning_a_renewed_copy_works_like_any_other_return(service, clock):
+    service.register_member("bob", "Bob Adult")
+    loan = service.checkout("ann", "B1")
+    service.checkout("bob", "B2")
+    clock.set(date(2026, 3, 18))
+    service.renew(loan.loan_id)
+    hold = service.place_hold("kid", "978-1")
+    clock.set(date(2026, 4, 10))  # Friday: Late days 9 and 10 April
+    returned = service.return_copy("B1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == date(2026, 4, 10)
+    assert service.open_loans("ann") == []
+    assert service.balance("ann") == Decimal("0.50")
+    assert service.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+    assert service.holds_for("978-1")[0].hold_id == hold.hold_id
+    assert service.holds_for("978-1")[0].copy_id == "B1"
+
+
+# Refusals -----------------------------------------------------------------
+
+
+def test_renewing_an_unknown_loan_is_an_error(service):
+    with pytest.raises(LoanNotFound):
+        service.renew("nope")
+
+
+def test_a_returned_loan_cannot_be_renewed_and_is_left_as_it_was(service, clock):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 18))
+    service.return_copy("B1")
+    clock.set(date(2026, 3, 20))
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan.loan_id)
+    assert refused.value.loan_id == loan.loan_id
+    stored = service.get_loan(loan.loan_id)
+    assert stored.due_on == date(2026, 3, 23)
+    assert stored.renewals == 0
+    assert stored.returned_on == date(2026, 3, 18)
+    assert service.balance("ann") == Decimal("0.00")
+
+
+# Which Loans can be renewed -------------------------------------------------
+
+
+def _assert_unchanged(service, loan_id, due_on, renewals):
+    stored = service.get_loan(loan_id)
+    assert stored.due_on == due_on
+    assert stored.renewals == renewals
+
+
+@pytest.mark.parametrize("member_id", ["ann", "kid"])
+def test_a_book_loan_can_be_renewed_twice_but_not_a_third_time(
+    service, clock, member_id
+):
+    loan = service.checkout(member_id, "B1")
+    clock.set(date(2026, 3, 18))
+    assert service.renew(loan.loan_id).due_on == date(2026, 4, 8)
+    clock.set(date(2026, 4, 3))
+    assert service.renew(loan.loan_id).due_on == date(2026, 4, 24)
+    assert service.get_loan(loan.loan_id).renewals == 2
+    clock.set(date(2026, 4, 24))  # the due date, well inside the window
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan.loan_id)
+    assert refused.value.loan_id == loan.loan_id
+    assert "at most 2" in refused.value.reason
+    _assert_unchanged(service, loan.loan_id, date(2026, 4, 24), 2)
+
+
+@pytest.mark.parametrize("member_id", ["ann", "kid"])
+def test_a_dvd_loan_can_never_be_renewed(service, clock, member_id):
+    loan = service.checkout(member_id, "D1")  # due Monday 9 March
+    clock.set(date(2026, 3, 9))  # the due date: inside the window, nothing waiting
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan.loan_id)
+    assert "dvd" in refused.value.reason
+    _assert_unchanged(service, loan.loan_id, date(2026, 3, 9), 0)
+
+
+@pytest.mark.parametrize("member_id", ["ann", "kid"])
+def test_a_book_due_monday_23_march_is_refused_on_tuesday_17_march(
+    service, clock, member_id
+):
+    loan = service.checkout(member_id, "B1")
+    clock.set(date(2026, 3, 17))
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan.loan_id)
+    assert "Renewal window" in refused.value.reason
+    assert "2026-03-18" in refused.value.reason  # when to come back
+    _assert_unchanged(service, loan.loan_id, date(2026, 3, 23), 0)
+
+
+@pytest.mark.parametrize(
+    "renewed_on, new_due_on",
+    [
+        (date(2026, 3, 18), date(2026, 4, 8)),  # Wednesday: the window opens
+        (date(2026, 3, 23), date(2026, 4, 13)),  # the due date itself
+        (date(2026, 3, 25), date(2026, 4, 15)),  # overdue
+    ],
+)
+def test_a_book_due_monday_23_march_can_be_renewed_from_wednesday_18_march_on(
+    service, clock, renewed_on, new_due_on
+):
+    loan = service.checkout("ann", "B1")
+    clock.set(renewed_on)
+    renewed = service.renew(loan.loan_id)
+    assert renewed.due_on == new_due_on
+    assert renewed.renewals == 1
+
+
+def test_renewing_on_the_checkout_day_is_refused(service):
+    loan = service.checkout("ann", "B1")
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan.loan_id)
+    assert "Renewal window" in refused.value.reason
+    _assert_unchanged(service, loan.loan_id, date(2026, 3, 23), 0)
+
+
+def test_a_second_renewal_on_the_same_day_as_the_first_is_refused(service, clock):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 18))
+    service.renew(loan.loan_id)
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan.loan_id)
+    assert "Renewal window" in refused.value.reason
+    _assert_unchanged(service, loan.loan_id, date(2026, 4, 8), 1)
+
+
+def test_the_window_for_a_second_renewal_counts_from_the_new_due_date(
+    service, clock
+):
+    loan = service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 18))
+    service.renew(loan.loan_id)  # now due Wednesday 8 April
+    clock.set(date(2026, 4, 2))
+    with pytest.raises(RenewalRefused) as refused:
+        service.renew(loan.loan_id)
+    assert "2026-04-03" in refused.value.reason
+    _assert_unchanged(service, loan.loan_id, date(2026, 4, 8), 1)
+    clock.set(date(2026, 4, 3))  # Friday
+    renewed = service.renew(loan.loan_id)
+    assert renewed.due_on == date(2026, 4, 24)

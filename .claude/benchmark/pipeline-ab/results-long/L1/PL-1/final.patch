+    assert "returned" in refused.value.reason
+
+
+def test_a_returned_book_loan_renewed_twice_is_reported_as_returned(
+    service, clock
+):
+    loan = service.checkout("ann", "B1")
+    for day in (date(2026, 3, 18), date(2026, 4, 3)):

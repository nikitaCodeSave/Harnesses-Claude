+# Fines on late return --------------------------------------------------
+# Loans start on Monday 2 March 2026: books are due Mon 23 March, DVDs Mon 9 March.
+
+
+def return_on(service, clock, copy_id, day):
+    clock.set(day)
+    return service.return_copy(copy_id)
+
+
+def test_book_six_late_days_late_is_fined_1_50(service, clock):
+    service.checkout("ann", "B1")
+    # 24-30 March is 7 days; Sunday 29 March is not a Late day.
+    return_on(service, clock, "B1", date(2026, 3, 30))
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_dvd_six_late_days_late_is_fined_6_00(service, clock):
+    service.checkout("ann", "D1")
+    # 10-16 March is 7 days; Sunday 15 March is not a Late day.
+    return_on(service, clock, "D1", date(2026, 3, 16))
+    assert service.balance("ann") == Decimal("6.00")
+
+
+def test_a_loan_spanning_two_sundays_skips_both(service, clock):

+            raise RenewalRefused(loan_id, f"members are waiting for {title.isbn!r}")
+        owed = self.balance(loan.member_id)
+        if owed > policy.RENEW_MAX_BALANCE:
+            raise AccountBlocked(loan.member_id, owed, policy.RENEW_MAX_BALANCE)

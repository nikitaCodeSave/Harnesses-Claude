+"""Overdue fines and member accounts. Test names cite docs/specs/overdue-fines.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus
+from lending.errors import (
+    AccountBlocked,
+    InvalidAmount,
+    InvalidReason,
+    LendingError,
+    MemberNotFound,
+)
+from lending.policy import late_days
+
+# Fixture copies: B1/B2 book "978-1" (replacement 18.00), D1 DVD "dvd-1" (12.00).
+# START is Mon 2 March 2026: books due Mon 23 March, DVDs due Mon 9 March.
+
+
+def test_new_errors_are_lending_errors():
+    for cls in (AccountBlocked, InvalidAmount, InvalidReason):
+        assert issubclass(cls, LendingError)
+
+
+# Late days ----------------------------------------------------------------
+
+
+def test_a1_return_on_due_date_costs_nothing(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 9))
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("0.00")
+
+
+def test_a1_early_return_costs_nothing(service, clock):
+    service.checkout("ann", "B1")
+    clock.advance(3)
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("0.00")
+
+
+def test_a2_sundays_are_not_late_days():
+    # Due Sat 7 March; Sun 8 is closed, so Mon 9 is the first late day.
+    assert late_days(date(2026, 3, 7), date(2026, 3, 8)) == 0
+    assert late_days(date(2026, 3, 7), date(2026, 3, 9)) == 1
+
+
+def test_a3_owner_example_counts_six_late_days():
+    assert late_days(date(2026, 3, 23), date(2026, 3, 30)) == 6
+
+
+# Fine amount --------------------------------------------------------------
+
+
+def test_f1_f2_book_owner_example_charges_1_50(service, clock):
+    service.checkout("ann", "B1")  # due Mon 23 March
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_f1_dvd_charges_1_00_per_late_day(service, clock):
+    service.checkout("ann", "D1")  # due Mon 9 March
+    clock.set(date(2026, 3, 12))  # Tue, Wed, Thu
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_f3_fine_is_capped_at_replacement_cost(service, clock):
+    service.checkout("ann", "D1")  # due 9 March, replacement 12.00
+    clock.set(date(2026, 4, 30))  # far more than 12 open days late
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_f3_fine_just_below_cap_is_not_capped(service, clock):
+    service.checkout("ann", "D1")  # due Mon 9 March
+    clock.set(date(2026, 3, 21))  # 11 open late days (Sun 15 excluded)
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("11.00")
+
+
+def test_f4_children_are_never_fined(service, clock):
+    loan = service.checkout("kid", "D1")
+    clock.set(date(2026, 4, 30))
+    returned = service.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == date(2026, 4, 30)
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.balance("kid") == Decimal("0.00")
+
+
+def test_f5_overdue_copy_still_out_adds_nothing(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 4, 30))
+    assert service.balance("ann") == Decimal("0.00")
+
+
+def test_f6_each_late_return_adds_its_own_fine(service, clock):
+    service.checkout("ann", "D1")  # due 9 March
+    service.checkout("ann", "B1")  # due 23 March
+    clock.set(date(2026, 3, 10))
+    service.return_copy("D1")  # 1 late day: 1.00
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")  # 6 late days: 1.50
+    assert service.balance("ann") == Decimal("2.50")
+
+
+def test_f7_late_return_returns_the_closed_loan(service, clock):
+    loan = service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 12))
+    returned = service.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == date(2026, 3, 12)
+    assert not returned.is_open
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+
+
+# Balance ------------------------------------------------------------------
+
+
+def test_b1_new_member_owes_nothing(service):
+    assert service.balance("ann") == Decimal("0.00")
+
+
+def test_b2_balance_is_fines_plus_charges_minus_payments(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 12))
+    service.return_copy("D1")  # 3.00
+    service.add_charge("ann", Decimal("4.20"), "torn sleeve")
+    service.pay("ann", Decimal("2.00"))
+    assert service.balance("ann") == Decimal("5.20")
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda s: s.balance("nobody"),
+        lambda s: s.add_charge("nobody", Decimal("1.00"), "damage"),
+        lambda s: s.pay("nobody", Decimal("1.00")),
+    ],
+)
+def test_b3_unknown_member(service, call):
+    with pytest.raises(MemberNotFound):
+        call(service)
+
+
+def test_b4_balance_never_negative(service):
+    service.add_charge("ann", Decimal("1.00"), "damage")
+    service.pay("ann", Decimal("1.00"))
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("0.01"))
+    assert service.balance("ann") == Decimal("0.00")
+
+
+# Manual charges -----------------------------------------------------------
+
+
+def test_c1_add_charge_returns_new_balance(service):
+    assert service.add_charge("ann", Decimal("2.50"), "scratched disc") == Decimal("2.50")
+    assert service.add_charge("ann", Decimal("1.00"), "lost case") == Decimal("3.50")
+    assert service.balance("ann") == Decimal("3.50")
+
+
+def test_c2_children_can_be_charged_manually(service):
+    assert service.add_charge("kid", Decimal("3.00"), "crayon on pages") == Decimal("3.00")
+
+
+@pytest.mark.parametrize("reason", ["", "   "])
+def test_c3_charge_needs_a_reason(service, reason):
+    with pytest.raises(InvalidReason):
+        service.add_charge("ann", Decimal("1.00"), reason)
+    assert service.balance("ann") == Decimal("0.00")
+
+
+# Payments -----------------------------------------------------------------
+
+
+def test_p1_partial_payment_returns_new_balance(service):
+    service.add_charge("ann", Decimal("6.00"), "damage")
+    assert service.pay("ann", Decimal("2.50")) == Decimal("3.50")
+    assert service.balance("ann") == Decimal("3.50")
+
+
+def test_p2_paying_exact_balance_clears_it(service):
+    service.add_charge("ann", Decimal("6.00"), "damage")
+    assert service.pay("ann", Decimal("6.00")) == Decimal("0.00")
+
+
+def test_p3_overpayment_is_refused(service):
+    service.add_charge("ann", Decimal("6.00"), "damage")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("6.01"))
+    assert service.balance("ann") == Decimal("6.00")
+
+
+def test_p3_paying_with_nothing_owed_is_refused(service):
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("1.00"))
+
+
+# Amounts ------------------------------------------------------------------
+
+BAD_AMOUNTS = [
+    Decimal("0"),
+    Decimal("0.00"),
+    Decimal("-1.00"),
+    Decimal("0.005"),
+    Decimal("1.001"),
+    Decimal("NaN"),
+    Decimal("Infinity"),
+    1.5,
+    "1.00",
+    None,
+    True,
+]
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS)
+def test_m1_m2_bad_charge_amounts_are_refused(service, amount):
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", amount, "damage")
+    assert service.balance("ann") == Decimal("0.00")
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS)
+def test_m1_m2_bad_payment_amounts_are_refused(service, amount):
+    service.add_charge("ann", Decimal("5.00"), "damage")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", amount)
+    assert service.balance("ann") == Decimal("5.00")
+
+
+def test_m1_whole_cents_with_trailing_zeros_are_accepted(service):
+    assert service.add_charge("ann", Decimal("1.500"), "damage") == Decimal("1.50")
+
+
+def test_m2_int_amounts_are_whole_euros(service):

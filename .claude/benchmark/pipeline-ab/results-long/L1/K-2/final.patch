+    return svc
+
+
+def test_new_errors_are_lending_errors():
+    for cls in (HoldNotAllowed, HoldNotFound):
+        assert issubclass(cls, LendingError)
+
+
+# Placing a hold -------------------------------------------------------------
+
+
+def test_hp1_place_hold_returns_waiting_hold(dvd_out, clock):

+    svc.pay("cat", svc.balance("cat"))
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_x6_any_balance_blocks(svc, loan, clock):
+    svc.add_charge("ann", Decimal("0.01"), "lost bookmark")
+    clock.set(DUE)
+    before = snapshot(svc, loan)
+    with pytest.raises(AccountBlocked) as err:
+        svc.renew(loan.loan_id)
+    assert err.value.member_id == "ann"
+    assert err.value.balance == Decimal("0.01")
+    assert err.value.bar == Decimal("0.00")
+    assert snapshot(svc, loan) == before
+
+
+def test_x6_paying_off_lifts_refusal(svc, loan, clock):
+    svc.add_charge("ann", Decimal("3.00"), "damage")
+    clock.set(DUE)
+    with pytest.raises(AccountBlocked):
+        svc.renew(loan.loan_id)
+    svc.pay("ann", Decimal("2.99"))
+    with pytest.raises(AccountBlocked):
+        svc.renew(loan.loan_id)
+    svc.pay("ann", Decimal("0.01"))
+    assert svc.balance("ann") == Decimal("0.00")
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_x7_refusal_on_overdue_loan_charges_nothing(svc, loan, waiting, clock):
+    clock.set(date(2026, 3, 30))  # overdue: would charge €1.50 if renewed
+    before = snapshot(svc, loan)
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    assert snapshot(svc, loan) == before
+    assert svc.balance("ann") == Decimal("0.00")
+
+
+def test_x8_children_same_rules(svc, clock):
+    loan = svc.checkout("kid", "B2")
+    clock.set(date(2026, 3, 17))
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)

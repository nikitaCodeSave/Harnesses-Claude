+"""Renewals. Test names cite SPEC.md criteria."""
+
+from datetime import date, timedelta
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, EntryKind, HoldStatus, Loan
+from lending.errors import (
+    AccountBlocked,
+    LendingError,
+    LoanNotFound,
+    RenewalRefused,
+)
+from lending.policy import late_days
+
+# Fixture copies: B1/B2 book "978-1" (replacement €18.00), D1 DVD "dvd-1".
+# START is Mon 2 March 2026; a book borrowed then is due Mon 23 March 2026.
+DUE = date(2026, 3, 23)
+
+
+@pytest.fixture
+def svc(service):
+    service.register_member("bob", "Bob Adult")
+    service.register_member("cat", "Cat Adult")
+    return service
+
+
+@pytest.fixture
+def loan(svc):
+    """ann has B1 out, due Mon 23 March."""
+    loan = svc.checkout("ann", "B1")
+    assert loan.due_on == DUE
+    return loan
+
+
+def late_by(due_on: date, n: int) -> date:
+    """The day on which a loan due on ``due_on`` has ``n`` late days."""
+    day = due_on
+    while late_days(due_on, day) < n:
+        day += timedelta(days=1)
+    return day
+
+
+def fines(svc, member_id):
+    return [e for e in svc._repo.entries_of(member_id) if e.kind is EntryKind.FINE]
+
+
+def snapshot(svc, loan):
+    return (
+        loan.due_on,
+        loan.renewals,
+        loan.returned_on,
+        svc.get_copy(loan.copy_id).status,
+        svc.balance(loan.member_id),
+        len(svc._repo.entries_of(loan.member_id)),
+        [(h.hold_id, h.status, h.copy_id) for h in svc._repo.all_holds()],
+    )
+
+
+def test_x9_renewal_refused_is_lending_error():
+    assert issubclass(RenewalRefused, LendingError)
+
+
+# A successful renewal ------------------------------------------------------
+
+
+def test_r1_returns_same_open_loan_with_one_more_renewal(svc, loan, clock):
+    clock.set(date(2026, 3, 19))
+    renewed = svc.renew(loan.loan_id)
+    assert isinstance(renewed, Loan)
+    assert renewed.loan_id == loan.loan_id
+    assert renewed.is_open
+    assert renewed.renewals == 1
+
+
+def test_r2_fresh_period_from_renewal_day(svc, loan, clock):
+    clock.set(date(2026, 3, 19))  # Thursday
+    assert svc.renew(loan.loan_id).due_on == date(2026, 4, 9)  # Thursday
+
+
+def test_r2_due_date_matches_checkout_made_that_day(svc, loan, clock):
+    clock.set(date(2026, 3, 21))
+    other = svc.checkout("bob", "B2")
+    assert svc.renew(loan.loan_id).due_on == other.due_on == date(2026, 4, 11)
+
+
+def test_r2_due_date_moves_past_sunday(svc, loan, clock):
+    clock.set(date(2026, 3, 22))  # Sunday; 21 days later is Sunday 12 April
+    assert svc.renew(loan.loan_id).due_on == date(2026, 4, 13)
+
+
+def test_r3_nothing_else_changes(svc, loan, clock):
+    clock.set(date(2026, 3, 20))
+    svc.renew(loan.loan_id)
+    assert loan.borrowed_on == date(2026, 3, 2)
+    assert loan.copy_id == "B1"
+    assert loan.member_id == "ann"
+    assert svc.get_copy("B1").status is CopyStatus.ON_LOAN
+    assert [l.loan_id for l in svc.loan_history("ann")] == [loan.loan_id]
+    assert [l.loan_id for l in svc.open_loans("ann")] == [loan.loan_id]
+
+
+def test_r4_get_loan_shows_renewal(svc, loan, clock):
+    clock.set(date(2026, 3, 19))
+    svc.renew(loan.loan_id)
+    stored = svc.get_loan(loan.loan_id)
+    assert stored.due_on == date(2026, 4, 9)
+    assert stored.renewals == 1
+
+
+def test_r5_new_loan_has_no_renewals(loan):
+    assert loan.renewals == 0
+    assert Loan("L1", "C1", "m", date(2026, 1, 1), date(2026, 1, 22)).renewals == 0
+
+
+# Limit and window ----------------------------------------------------------
+
+
+def test_l1_two_renewals_then_refused(svc, loan, clock):
+    clock.set(loan.due_on)
+    svc.renew(loan.loan_id)
+    clock.set(loan.due_on)
+    svc.renew(loan.loan_id)
+    assert loan.renewals == 2
+    clock.set(loan.due_on)
+    before = snapshot(svc, loan)
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    assert snapshot(svc, loan) == before
+
+
+def test_l2_window_opens_five_days_before_due(svc, loan, clock):
+    clock.set(date(2026, 3, 17))
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    assert loan.renewals == 0 and loan.due_on == DUE
+    clock.set(date(2026, 3, 18))
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_l2_renewable_on_due_date(svc, loan, clock):
+    clock.set(DUE)
+    assert svc.renew(loan.loan_id).due_on == date(2026, 4, 13)
+
+
+def test_l2_renewable_when_overdue(svc, loan, clock):
+    clock.set(date(2026, 4, 2))
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_l2_refused_on_checkout_day(svc, loan, clock):
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+
+
+def test_l3_window_follows_new_due_date(svc, loan, clock):
+    clock.set(date(2026, 3, 19))
+    svc.renew(loan.loan_id)  # due Thu 9 April
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    clock.advance()
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    clock.set(date(2026, 4, 3))
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    clock.set(date(2026, 4, 4))
+    assert svc.renew(loan.loan_id).renewals == 2
+
+
+# Refusals ------------------------------------------------------------------
+
+
+def test_x1_unknown_loan(svc):
+    with pytest.raises(LoanNotFound):
+        svc.renew("L9999")
+
+
+def test_x2_returned_loan(svc, loan, clock):
+    clock.set(date(2026, 3, 20))
+    svc.return_copy("B1")
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    assert loan.returned_on == date(2026, 3, 20)
+    assert loan.renewals == 0
+
+
+def test_x3_dvd_refused(svc, clock):
+    dvd = svc.checkout("ann", "D1")  # due Mon 9 March
+    for day in (dvd.due_on - timedelta(days=1), dvd.due_on, date(2026, 3, 12)):
+        clock.set(day)
+        before = snapshot(svc, dvd)
+        with pytest.raises(RenewalRefused):
+            svc.renew(dvd.loan_id)
+        assert snapshot(svc, dvd) == before
+
+
+@pytest.fixture
+def waiting(svc, loan):
+    """Both copies of 978-1 out (B1 ann, B2 bob); cat waits for the title."""
+    svc.checkout("bob", "B2")
+    hold = svc.place_hold("cat", "978-1")
+    assert hold.status is HoldStatus.WAITING
+    return hold
+
+
+def test_x4_waiting_hold_blocks(svc, loan, waiting, clock):
+    clock.set(DUE)
+    before = snapshot(svc, loan)
+    with pytest.raises(RenewalRefused):
+        svc.renew(loan.loan_id)
+    assert snapshot(svc, loan) == before
+
+
+def test_x5_ready_hold_does_not_block(svc, loan, waiting, clock):
+    svc.return_copy("B2")  # set aside for cat
+    assert waiting.status is HoldStatus.READY
+    clock.set(DUE)
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_x5_cancelled_hold_does_not_block(svc, loan, waiting, clock):
+    svc.cancel_hold(waiting.hold_id)
+    clock.set(DUE)
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_x5_fulfilled_hold_does_not_block(svc, loan, waiting, clock):
+    svc.return_copy("B2")
+    svc.checkout("cat", "B2")
+    assert waiting.status is HoldStatus.FULFILLED
+    clock.set(DUE)
+    assert svc.renew(loan.loan_id).renewals == 1
+
+
+def test_x5_expired_hold_does_not_block(svc, loan, waiting, clock):

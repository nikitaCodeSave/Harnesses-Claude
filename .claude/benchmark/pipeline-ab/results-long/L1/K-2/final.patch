+        """Fine ``loan`` for its lateness as of ``on`` (docs/adr/0002), within
+        what is left of the loan's fine cap (docs/adr/0008)."""
+        member = self._repo.get_member(loan.member_id)
+        title = self._repo.get_title(self._repo.get_copy(loan.copy_id).isbn)
+        already_fined = sum(
+            (
+                e.amount
+                for e in self._repo.entries_of(loan.member_id)
+                if e.kind is EntryKind.FINE and e.loan_id == loan.loan_id
+            ),
+            Decimal("0.00"),
+        )
+        fine = policy.overdue_fine(
+            title.material,
+            member.category,
+            title.replacement_cost,
+            loan.due_on,
+            on,
+            already_fined,
+        )
+        if fine > 0:
+            days = policy.late_days(loan.due_on, on)
+            self._record(
+                loan.member_id,
+                EntryKind.FINE,
+                fine,
+                f"{days} late day(s) on copy {loan.copy_id}",
+                loan_id=loan.loan_id,
+            )
+
+    def _record(
+        self,
+        member_id: str,
+        kind: EntryKind,
+        amount: Decimal,
+        reason: str,
+        loan_id: str | None = None,
+    ) -> None:
+        self._repo.add_entry(
+            AccountEntry(
+                entry_id=self._repo.next_id("E"),
+                member_id=member_id,
+                kind=kind,
+                amount=amount,
+                on=self._clock.today(),
+                reason=reason,
+                loan_id=loan_id,
+            )
+        )

+    clock.set(dvd.due_on)
+    with pytest.raises(RenewalRefused):
+        svc.renew(dvd.loan_id)
+
+
+def test_x8_child_with_balance_blocked(svc, clock):
+    loan = svc.checkout("kid", "B2")

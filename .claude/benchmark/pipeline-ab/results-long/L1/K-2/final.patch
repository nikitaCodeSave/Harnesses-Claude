+from decimal import Decimal
 
 from .models import Material, MemberCategory
 
@@ -41,3 +42,93 @@ def due_date(material: Material, borrowed_on: date) -> date:
 
 def loan_limit(category: MemberCategory) -> int:
     return LOAN_LIMITS[category]
+
+
+# Fines and account blocks (docs/adr/0002, 0003). -------------------------
+
+FINE_PER_LATE_DAY: dict[Material, Decimal] = {
+    Material.BOOK: Decimal("0.25"),
+    Material.DVD: Decimal("1.00"),
+}
+
+# Children are never fined.
+FINED_CATEGORIES: frozenset[MemberCategory] = frozenset({MemberCategory.ADULT})
+
+# A member owing this much or more cannot check out.
+BORROW_BLOCK_AT = Decimal("10.00")
+
+# A member owing this much or more cannot place a hold.
+HOLD_BLOCK_AT = Decimal("5.00")
+
+CENT = Decimal("0.01")
+
+
+# Holds (docs/adr/0004, 0006). -------------------------------------------
+
+PICKUP_DAYS = 7
+
+NO_SHOW_FEE = Decimal("1.00")
+
+# Children never pay the no-show fee.
+NO_SHOW_FEE_CATEGORIES: frozenset[MemberCategory] = frozenset({MemberCategory.ADULT})
+
+
+def pickup_by(set_aside_on: date) -> date:
+    """Last day to collect a copy set aside on ``set_aside_on``."""
+    return next_open_day(set_aside_on + timedelta(days=PICKUP_DAYS))
+
+
+def no_show_fee(category: MemberCategory) -> Decimal:
+    if category not in NO_SHOW_FEE_CATEGORIES:
+        return Decimal("0.00")
+    return NO_SHOW_FEE
+
+
+def late_days(due_on: date, on: date) -> int:
+    """Open days after ``due_on`` up to and including ``on``."""
+    day = due_on + timedelta(days=1)
+    count = 0
+    while day <= on:
+        if is_open_day(day):
+            count += 1
+        day += timedelta(days=1)
+    return count
+
+
+def overdue_fine(
+    material: Material,
+    category: MemberCategory,
+    replacement_cost: Decimal,
+    due_on: date,
+    on: date,
+    already_fined: Decimal = Decimal("0.00"),
+) -> Decimal:
+    """Fine for a loan reckoned on ``on``: late days x rate, capped so that
+    all fines on the loan (``already_fined`` plus this one) stay within the
+    replacement cost (docs/adr/0008). Zero for children and for copies back
+    on time."""
+    if category not in FINED_CATEGORIES:
+        return Decimal("0.00")
+    fine = FINE_PER_LATE_DAY[material] * late_days(due_on, on)
+    left = max(replacement_cost - already_fined, Decimal("0.00"))
+    return min(fine, left).quantize(CENT)
+
+
+# Renewals (docs/adr/0005, 0007, 0008). ----------------------------------
+
+# DVDs cannot be renewed.
+RENEWABLE_MATERIALS: frozenset[Material] = frozenset({Material.BOOK})
+
+MAX_RENEWALS = 2
+
+# A loan can be renewed from this many calendar days before its due date.
+RENEW_WINDOW_DAYS = 5
+
+# Only a paid-up member may renew: refused when the balance is above this.
+# Not a "balance >= bar" check like BORROW_BLOCK_AT (docs/adr/0007).
+RENEW_MAX_BALANCE = Decimal("0.00")
+
+
+def renewable_from(due_on: date) -> date:
+    """First day a loan due on ``due_on`` can be renewed."""
+    return due_on - timedelta(days=RENEW_WINDOW_DAYS)

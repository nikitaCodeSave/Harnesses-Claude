+    assert hold.status is HoldStatus.WAITING
+    assert hold.copy_id is None and hold.pickup_by is None
+
+
+def test_hp1_hold_ids_are_unique(dvd_out):
+    a = dvd_out.place_hold("bob", "dvd-1")
+    b = dvd_out.place_hold("cat", "dvd-1")
+    assert a.hold_id != b.hold_id
+
+
+def test_hp2_unknown_member(dvd_out):

+    # accounts ----------------------------------------------------------
+
+    def balance(self, member_id: str) -> Decimal:
+        """What the member owes right now: fines, charges and fees less payments."""
+        self._repo.get_member(member_id)
+        total = Decimal("0.00")
+        for entry in self._repo.entries_of(member_id):
+            if entry.kind is EntryKind.PAYMENT:
+                total -= entry.amount
+            else:
+                total += entry.amount
+        return total
+
+    def add_charge(self, member_id: str, amount: Decimal, reason: str) -> Decimal:
+        """Manual staff charge, e.g. for damage. Returns the new balance."""
+        self._repo.get_member(member_id)
+        amount = _valid_amount(amount)
+        if not isinstance(reason, str) or not reason.strip():
+            raise InvalidReason(reason)
+        self._record(member_id, EntryKind.CHARGE, amount, reason.strip())
+        return self.balance(member_id)
+
+    def pay(self, member_id: str, amount: Decimal) -> Decimal:
+        """Record a payment of at most the balance. Returns the new balance."""
+        owed = self.balance(member_id)
+        amount = _valid_amount(amount)
+        if amount > owed:

+"""Holds: see SPEC.md. Test names carry the acceptance criterion numbers."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material, MemberCategory
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    HoldNotAllowed,
+    HoldNotFound,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+
+
+@pytest.fixture
+def svc(service):
+    service.register_member("bob", "Bob Adult")
+    service.register_member("cat", "Cat Adult")
+    service.register_member("dan", "Dan Adult")
+    return service
+
+
+@pytest.fixture
+def dvd_out(svc):
+    """D1, the only copy of dvd-1, is on loan to bob (due Monday 9 March)."""
+    svc.checkout("bob", "D1")
+    return svc
+
+
+@pytest.fixture
+def book_out(svc):
+    """Both copies of 978-1 are on loan, to bob (B1) and cat (B2)."""
+    svc.checkout("bob", "B1")
+    svc.checkout("cat", "B2")
+    return svc
+
+
+def set_aside_d1_for_ann(svc, clock, on=date(2026, 3, 9)):
+    """ann holds dvd-1, bob returns D1 on ``on``; returns ann's (now READY) hold."""
+    hold = svc.place_hold("ann", "dvd-1")
+    clock.set(on)
+    svc.return_copy("D1")
+    return hold
+
+
+# placing holds ---------------------------------------------------------
+
+
+def test_01_place_hold_waits_in_queue(dvd_out):
+    hold = dvd_out.place_hold("ann", "dvd-1")
+    assert hold.member_id == "ann"
+    assert hold.isbn == "dvd-1"
+    assert hold.status is HoldStatus.WAITING
+    assert hold.placed_on == date(2026, 3, 2)
+    assert hold.copy_id is None
+    assert hold.pickup_by is None
+
+
+def test_02_no_hold_while_a_copy_is_on_the_shelf(svc):
+    svc.checkout("bob", "B1")  # B2 is still AVAILABLE
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "978-1")
+
+
+def test_03_no_hold_on_title_without_copies(svc):
+    svc.add_title("978-0", "Never Bought", Material.BOOK, Decimal("10.00"))
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "978-0")
+
+
+def test_03_no_hold_when_every_copy_is_withdrawn(svc):
+    svc.withdraw_copy("D1")
+    with pytest.raises(HoldNotAllowed):
+        svc.place_hold("ann", "dvd-1")

+"""Renewals: see SPEC.md. Test names carry the acceptance criterion numbers."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import AccountBlocked, LoanNotFound, RenewalRefused
+
+DUE = date(2026, 3, 23)  # a book checked out on the start day, Monday 2 March
+
+
+@pytest.fixture
+def svc(service):
+    service.register_member("bob", "Bob Adult")
+    service.register_member("cat", "Cat Adult")
+    return service
+
+
+@pytest.fixture
+def loan(svc):
+    """ann has B1 out, due Monday 23 March."""
+    return svc.checkout("ann", "B1")
+
+
+def assert_refused_unchanged(svc, loan_id, error):
+    """``renew`` raises ``error`` and leaves the loan and the account alone (24)."""
+    before = svc.get_loan(loan_id)
+    due_on, renewals = before.due_on, before.renewals
+    owed = svc.balance(before.member_id)
+    with pytest.raises(error):
+        svc.renew(loan_id)
+    after = svc.get_loan(loan_id)
+    assert after.due_on == due_on
+    assert after.renewals == renewals
+    assert svc.balance(after.member_id) == owed
+
+
+# Granting -------------------------------------------------------------
+
+
+def test_01_new_loan_has_no_renewals(loan):
+    assert loan.renewals == 0
+
+
+def test_02_renew_returns_same_loan_in_place(svc, clock, loan):
+    clock.set(date(2026, 3, 19))
+    renewed = svc.renew(loan.loan_id)
+    assert renewed.loan_id == loan.loan_id
+    assert renewed.copy_id == "B1"
+    assert renewed.member_id == "ann"
+    assert renewed.borrowed_on == date(2026, 3, 2)
+    assert renewed.renewals == 1
+    stored = svc.get_loan(loan.loan_id)
+    assert (stored.due_on, stored.renewals, stored.borrowed_on) == (
+        renewed.due_on, 1, date(2026, 3, 2),
+    )
+    assert stored.is_open
+    assert svc.get_copy("B1").status is CopyStatus.ON_LOAN
+
+
+def test_03_new_due_date_is_full_period_from_renewal_day(svc, clock, loan):
+    clock.set(date(2026, 3, 19))  # Thursday
+    assert svc.renew(loan.loan_id).due_on == date(2026, 4, 9)
+
+
+def test_04_new_due_date_never_falls_on_a_sunday(svc, clock, loan):
+    clock.set(date(2026, 3, 22))  # Sunday: +21 days is Sunday 12 April
+    assert svc.renew(loan.loan_id).due_on == date(2026, 4, 13)
+
+
+def test_05_renewal_does_not_add_a_loan(svc, clock, loan):
+    clock.set(date(2026, 3, 19))

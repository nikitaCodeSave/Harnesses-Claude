         """Open loans past their due date on ``as_of`` (default: today)."""
         day = as_of or self._clock.today()
         return [l for l in self._repo.all_loans() if l.is_overdue(day)]
+
+    # holds -------------------------------------------------------------
+
+    def place_hold(self, member_id: str, isbn: str) -> Hold:
+        """Join the queue for a title none of whose copies is on the shelf."""
+        self._repo.get_member(member_id)
+        self._repo.get_title(isbn)
+        copies = self._repo.copies_of(isbn)
+        if any(c.status is CopyStatus.AVAILABLE for c in copies):
+            raise HoldNotAllowed(f"a copy of {isbn!r} is on the shelf")
+        if all(c.status is CopyStatus.WITHDRAWN for c in copies):
+            raise HoldNotAllowed(f"no copy of {isbn!r} is in circulation")
+        if any(h.member_id == member_id for h in self.holds_for(isbn)):
+            raise HoldNotAllowed(f"member {member_id!r} already holds {isbn!r}")
+        if any(
+            self._repo.get_copy(l.copy_id).isbn == isbn for l in self.open_loans(member_id)
+        ):
+            raise HoldNotAllowed(f"member {member_id!r} has {isbn!r} on loan")
+        owed = self.balance(member_id)
+        if owed >= policy.HOLD_BLOCK_AT:
+            raise AccountBlocked(member_id, owed, policy.HOLD_BLOCK_AT)
+
+        hold = Hold(
+            hold_id=self._repo.next_id("H"),
+            member_id=member_id,
+            isbn=isbn,
+            placed_on=self._clock.today(),
+            status=HoldStatus.WAITING,
+        )
+        self._repo.add_hold(hold)
+        return hold
+
+    def cancel_hold(self, hold_id: str) -> Hold:
+        """Leave the queue. A copy already set aside passes to the next in line."""
+        hold = self._repo.get_hold(hold_id)
+        if not hold.is_active:
+            raise HoldNotAllowed(f"hold {hold_id!r} is {hold.status.value}")
+        was_ready = hold.status is HoldStatus.READY
+        hold.status = HoldStatus.CANCELLED
+        if was_ready:
+            self._shelve(self._repo.get_copy(hold.copy_id))
+        return hold
+
+    def expire_holds(self) -> list[Hold]:
+        """The daily job: expire READY holds past ``pickup_by`` and charge the no-show fee."""
+        today = self._clock.today()
+        expired = [
+            h for h in self._repo.all_holds()
+            if h.status is HoldStatus.READY and h.pickup_by < today
+        ]
+        for hold in expired:
+            hold.status = HoldStatus.EXPIRED
+            member = self._repo.get_member(hold.member_id)
+            if policy.is_fined(member.category):
+                self._post(
+                    hold.member_id, EntryKind.NO_SHOW_FEE, policy.NO_SHOW_FEE,
+                    f"no-show {hold.hold_id}",
+                )
+            self._shelve(self._repo.get_copy(hold.copy_id))
+        return expired
+
+    def holds_for(self, isbn: str) -> list[Hold]:
+        """Active holds on the title, first in line first."""
+        self._repo.get_title(isbn)
+        return [h for h in self._repo.holds_on(isbn) if h.is_active]
+
+    def _shelve(self, copy: Copy) -> None:
+        """Set ``copy`` aside for the first WAITING hold on its title, else shelve it."""
+        waiting = next(
+            (h for h in self._repo.holds_on(copy.isbn) if h.status is HoldStatus.WAITING),
+            None,
+        )
+        if waiting is None:
+            copy.status = CopyStatus.AVAILABLE
+            return
+        copy.status = CopyStatus.ON_HOLD_SHELF
+        waiting.status = HoldStatus.READY
+        waiting.copy_id = copy.copy_id
+        waiting.pickup_by = policy.pickup_by(self._clock.today())
+
+    def _ready_hold_for(self, copy_id: str) -> Hold:
+        return next(
+            h for h in self._repo.all_holds()
+            if h.status is HoldStatus.READY and h.copy_id == copy_id
+        )
+
+    def _fulfil_hold(self, member_id: str, copy: Copy) -> None:
+        """The member now has a copy of the title, so their hold on it is done.
+
+        If they took a different copy than the one set aside for them, that
+        one passes to the next in line.
+        """
+        for hold in self.holds_for(copy.isbn):
+            if hold.member_id != member_id:
+                continue
+            set_aside = hold.copy_id if hold.status is HoldStatus.READY else None
+            hold.status = HoldStatus.FULFILLED
+            if set_aside is not None and set_aside != copy.copy_id:
+                self._shelve(self._repo.get_copy(set_aside))
+
+    # accounts ----------------------------------------------------------
+
+    def balance(self, member_id: str) -> Decimal:
+        """What the member owes now: posted charges less payments."""
+        self._repo.get_member(member_id)
+        total = sum((e.amount for e in self._repo.entries_of(member_id)), Decimal(0))
+        return total.quantize(_CENT)
+
+    def add_charge(self, member_id: str, amount: Decimal, reason: str) -> Decimal:
+        """Manual staff charge. Returns the new balance."""
+        self._repo.get_member(member_id)
+        amount = _valid_amount(amount)
+        self._post(member_id, EntryKind.CHARGE, amount, reason)
+        return self.balance(member_id)
+
+    def pay(self, member_id: str, amount: Decimal) -> Decimal:
+        """Record a payment. Returns what is still owed; accounts never hold credit."""
+        owed = self.balance(member_id)
+        amount = _valid_amount(amount)
+        if amount > owed:
+            raise InvalidAmount(amount, f"more than the {owed} owed")
+        self._post(member_id, EntryKind.PAYMENT, -amount, "payment")
+        return self.balance(member_id)
+
+    def _charge_overdue_fine(self, loan: Loan, copy: Copy, until: date) -> None:
+        """Charge lateness against ``loan.due_on`` up to ``until``.
+
+        The cap is per loan, so fines already charged for this loan count
+        against it.
+        """
+        member = self._repo.get_member(loan.member_id)
+        title = self._repo.get_title(copy.isbn)
+        fine = policy.overdue_fine(title.material, member.category, loan.due_on, until)
+        charged = sum(
+            (
+                e.amount
+                for e in self._repo.entries_of(loan.member_id)
+                if e.kind is EntryKind.FINE and e.loan_id == loan.loan_id
+            ),
+            Decimal(0),
+        )
+        fine = min(fine, title.replacement_cost - charged)
+        if fine > 0:
+            self._post(
+                loan.member_id, EntryKind.FINE, fine.quantize(_CENT),
+                f"overdue {copy.copy_id}", loan_id=loan.loan_id,
+            )
+
+    def _post(
+        self,
+        member_id: str,
+        kind: EntryKind,
+        amount: Decimal,
+        reason: str,
+        loan_id: str | None = None,
+    ) -> None:
+        self._repo.add_entry(
+            AccountEntry(
+                entry_id=self._repo.next_id("E"),
+                member_id=member_id,
+                kind=kind,
+                amount=amount,
+                posted_on=self._clock.today(),
+                reason=reason,
+                loan_id=loan_id,
+            )
+        )
+
+
+_CENT = Decimal("0.01")
+
+
+def _valid_amount(amount: object) -> Decimal:
+    """A positive, finite amount in whole cents, or ``InvalidAmount``."""
+    if isinstance(amount, bool) or not isinstance(amount, (Decimal, int)):
+        raise InvalidAmount(amount, "must be a Decimal or int")
+    amount = Decimal(amount)
+    if not amount.is_finite():
+        raise InvalidAmount(amount, "must be finite")
+    if amount <= 0:
+        raise InvalidAmount(amount, "must be positive")
+    try:
+        cents = amount.quantize(_CENT)
+    except InvalidOperation:  # too many digits to hold in cents
+        raise InvalidAmount(amount, "too large") from None
+    if amount != cents:
+        raise InvalidAmount(amount, "must be whole cents")
+    return cents

 from .models import Material, MemberCategory
 
@@ -19,6 +20,34 @@ LOAN_LIMITS: dict[MemberCategory, int] = {
     MemberCategory.CHILD: 4,
 }
 
+# Charged per open day late. A loan's fines never exceed its replacement cost.
+FINE_PER_DAY: dict[Material, Decimal] = {
+    Material.BOOK: Decimal("0.25"),
+    Material.DVD: Decimal("1.00"),
+}
+
+# A member owing this much or more cannot borrow.
+BORROW_BLOCK_AT = Decimal("10.00")
+
+# A member owing this much or more cannot place a hold; lower than the borrowing bar.
+HOLD_BLOCK_AT = Decimal("5.00")
+
+# Calendar days a member has to collect a copy set aside for their hold.
+HOLD_PICKUP_DAYS = 7
+
+# Charged when a copy set aside for a hold is not collected in time.
+NO_SHOW_FEE = Decimal("1.00")
+
+# Only these materials can be renewed, at most MAX_RENEWALS times per loan.
+RENEWABLE: frozenset[Material] = frozenset({Material.BOOK})
+MAX_RENEWALS = 2
+
+# A loan can be renewed from this many calendar days before its due date onwards.
+RENEW_WINDOW_DAYS = 5
+
+# Only paid-up members can renew: owing any amount at all blocks it.
+RENEW_BLOCK_AT = Decimal("0.01")
+
 # date.weekday(): Monday is 0, Sunday is 6. The library is closed on Sundays.
 CLOSED_WEEKDAYS: frozenset[int] = frozenset({6})
 
@@ -39,5 +68,40 @@ def due_date(material: Material, borrowed_on: date) -> date:
     return next_open_day(borrowed_on + timedelta(days=LOAN_DAYS[material]))
 
 
+def renewable_from(due_on: date) -> date:
+    """First day a loan due on ``due_on`` may be renewed."""
+    return due_on - timedelta(days=RENEW_WINDOW_DAYS)
+
+
+def pickup_by(set_aside_on: date) -> date:
+    """Last day to collect a held copy, never ending on a closed day."""
+    return next_open_day(set_aside_on + timedelta(days=HOLD_PICKUP_DAYS))
+
+
 def loan_limit(category: MemberCategory) -> int:
     return LOAN_LIMITS[category]
+
+
+def late_days(due_on: date, returned_on: date) -> int:
+    """Open days after ``due_on`` up to and including ``returned_on``."""
+    days = 0
+    day = due_on + timedelta(days=1)
+    while day <= returned_on:
+        if is_open_day(day):
+            days += 1
+        day += timedelta(days=1)
+    return days
+
+
+def is_fined(category: MemberCategory) -> bool:
+    """Children are never fined."""
+    return category is not MemberCategory.CHILD
+
+
+def overdue_fine(
+    material: Material, category: MemberCategory, due_on: date, returned_on: date
+) -> Decimal:
+    """Fine for lateness counted against ``due_on``, before the per-loan cap."""
+    if not is_fined(category):
+        return Decimal("0.00")
+    return FINE_PER_DAY[material] * late_days(due_on, returned_on)

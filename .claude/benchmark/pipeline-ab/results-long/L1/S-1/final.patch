@@ -0,0 +1,257 @@
+"""Overdue fines and member accounts. Numbers in comments refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Material
+from lending.errors import AccountBlocked, InvalidAmount, LendingError, MemberNotFound
+
+# Fixture loans start Monday 2 March 2026: DVDs are due Monday 9 March,
+# books Monday 23 March.
+
+
+def late_dvd_return(service, clock, member, returned_on, copy_id="D1"):
+    clock.set(date(2026, 3, 2))
+    service.checkout(member, copy_id)
+    clock.set(returned_on)
+    return service.return_copy(copy_id)
+
+
+# fines on return ------------------------------------------------------
+
+
+def test_new_member_owes_nothing(service):  # 1
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_return_on_due_date_is_not_fined(service, clock):  # 2
+    late_dvd_return(service, clock, "ann", date(2026, 3, 9))
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_early_return_is_not_fined(service, clock):  # 2
+    late_dvd_return(service, clock, "ann", date(2026, 3, 4))
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_dvd_fined_one_per_late_day(service, clock):  # 3
+    late_dvd_return(service, clock, "ann", date(2026, 3, 14))
+    assert service.balance("ann") == Decimal("5.00")
+
+
+def test_sundays_are_not_late_days(service, clock):  # 4
+    late_dvd_return(service, clock, "ann", date(2026, 3, 16))
+    assert service.balance("ann") == Decimal("6.00")
+
+
+def test_book_fined_quarter_per_late_day(service, clock):  # 5
+    service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_fine_capped_at_replacement_cost(service, clock):  # 6
+    # 13 open late days at 1.00 would be 13.00; the DVD costs 12.00.
+    late_dvd_return(service, clock, "ann", date(2026, 3, 24))
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_fine_cap_uses_the_titles_own_cost(service, clock):  # 6
+    service.add_title("dvd-2", "Short Film", Material.DVD, Decimal("3.00"))
+    service.add_copy("D2", "dvd-2")
+    late_dvd_return(service, clock, "ann", date(2026, 3, 14), copy_id="D2")
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_each_late_return_adds_its_own_fine(service, clock):  # 7
+    service.checkout("ann", "D1")
+    service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")  # 6 late days x 0.25
+    service.return_copy("D1")  # 18 late days, capped at 12.00
+    assert service.balance("ann") == Decimal("13.50")
+
+
+def test_children_are_never_fined(service, clock):  # 8
+    loan = late_dvd_return(service, clock, "kid", date(2026, 3, 24))
+    assert loan.returned_on == date(2026, 3, 24)
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("kid") == []
+    assert service.balance("kid") == Decimal("0")
+
+
+def test_late_return_still_returns_the_closed_loan(service, clock):  # 9
+    loan = service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 14))
+    returned = service.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert not returned.is_open
+
+
+def test_blocked_member_can_still_return(service, clock):  # 9
+    service.checkout("ann", "D1")
+    service.add_charge("ann", Decimal("10.00"), "damaged case")
+    clock.set(date(2026, 3, 14))
+    service.return_copy("D1")
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.balance("ann") == Decimal("15.00")
+
+
+# manual charges -------------------------------------------------------
+
+
+def test_add_charge_returns_new_balance(service):  # 10
+    assert service.add_charge("ann", Decimal("2.50"), "lost card") == Decimal("2.50")
+    assert service.add_charge("ann", Decimal("1.25"), "printing") == Decimal("3.75")
+    assert service.balance("ann") == Decimal("3.75")
+
+
+def test_children_can_be_charged_manually(service):  # 11
+    assert service.add_charge("kid", Decimal("4.00"), "torn page") == Decimal("4.00")
+
+
+def test_manual_charges_count_toward_block(service):  # 11
+    service.add_charge("ann", Decimal("10.00"), "damaged case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_fines_and_charges_share_one_balance(service, clock):  # 10, 18
+    late_dvd_return(service, clock, "ann", date(2026, 3, 16))  # 6.00
+    assert service.add_charge("ann", Decimal("4.00"), "lost card") == Decimal("10.00")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+# payments -------------------------------------------------------------
+
+
+def test_partial_payment_returns_what_is_still_owed(service):  # 12
+    service.add_charge("ann", Decimal("8.00"), "lost card")
+    assert service.pay("ann", Decimal("3.00")) == Decimal("5.00")
+    assert service.balance("ann") == Decimal("5.00")
+
+
+def test_paying_in_full_clears_the_balance(service):  # 13
+    service.add_charge("ann", Decimal("8.00"), "lost card")
+    assert service.pay("ann", Decimal("8.00")) == Decimal("0")
+
+
+def test_overpayment_is_rejected(service):  # 14
+    service.add_charge("ann", Decimal("8.00"), "lost card")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("8.01"))
+    assert service.balance("ann") == Decimal("8.00")
+
+
+def test_payment_with_nothing_owed_is_rejected(service):  # 14
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("1.00"))
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_blocked_member_can_pay(service):  # 15
+    service.add_charge("ann", Decimal("12.00"), "damaged case")
+    assert service.pay("ann", Decimal("1.00")) == Decimal("11.00")
+
+
+# invalid amounts ------------------------------------------------------
+
+BAD_AMOUNTS = [
+    Decimal("0"),
+    Decimal("-1.00"),
+    -5,
+    Decimal("0.005"),
+    Decimal("1.999"),
+    Decimal("NaN"),
+    Decimal("Infinity"),
+    Decimal("1E+40"),
+    1.5,
+    "2.00",
+    True,
+]
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_bad_charge_is_rejected_and_balance_unchanged(service, amount):  # 16, 17
+    service.add_charge("ann", Decimal("5.00"), "lost card")
+    with pytest.raises(InvalidAmount):
+        service.add_charge("ann", amount, "bad")
+    assert service.balance("ann") == Decimal("5.00")
+
+
+@pytest.mark.parametrize("amount", BAD_AMOUNTS, ids=repr)
+def test_bad_payment_is_rejected_and_balance_unchanged(service, amount):  # 16, 17
+    service.add_charge("ann", Decimal("5.00"), "lost card")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", amount)
+    assert service.balance("ann") == Decimal("5.00")
+
+
+def test_whole_cent_amounts_are_accepted(service):  # 16
+    assert service.add_charge("ann", 3, "int amount") == Decimal("3.00")
+    assert service.add_charge("ann", Decimal("0.010"), "trailing zero") == Decimal("3.01")
+
+
+def test_new_errors_are_lending_errors():
+    assert issubclass(AccountBlocked, LendingError)
+    assert issubclass(InvalidAmount, LendingError)
+
+
+# blocking -------------------------------------------------------------
+
+
+def test_balance_of_exactly_ten_blocks_checkout(service):  # 18
+    service.add_charge("ann", Decimal("10.00"), "damaged case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_balance_just_under_ten_can_borrow(service):  # 18
+    service.add_charge("ann", Decimal("9.99"), "damaged case")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+def test_refused_checkout_leaves_no_trace(service):  # 19
+    service.add_charge("ann", Decimal("10.00"), "damaged case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.open_loans("ann") == []
+    assert service.loan_history("ann") == []
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+
+
+def test_paying_below_threshold_unblocks(service):  # 20
+    service.add_charge("ann", Decimal("10.00"), "damaged case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.pay("ann", Decimal("0.01")) == Decimal("9.99")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+def test_holding_an_overdue_copy_does_not_block(service, clock):  # 21
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 30))  # D1 is weeks overdue but not yet returned
+    assert service.balance("ann") == Decimal("0")
+    assert service.checkout("ann", "B1").copy_id == "B1"
+
+
+# unknown members ------------------------------------------------------
+
+
+def test_unknown_member_balance(service):  # 22
+    with pytest.raises(MemberNotFound):
+        service.balance("nobody")
+
+
+def test_unknown_member_charge(service):  # 22
+    with pytest.raises(MemberNotFound):
+        service.add_charge("nobody", Decimal("1.00"), "x")
+
+
+def test_unknown_member_payment(service):  # 22
+    with pytest.raises(MemberNotFound):
+        service.pay("nobody", Decimal("1.00"))

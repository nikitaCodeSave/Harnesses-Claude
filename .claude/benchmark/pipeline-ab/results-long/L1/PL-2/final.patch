@@ -0,0 +1,94 @@
+from decimal import Decimal
+
+import pytest
+
+from lending.errors import InvalidAmount, LendingError, MemberNotFound
+
+
+def test_part_payment_returns_what_is_still_owed(service):
+    service.add_charge("ann", Decimal("5.50"), "lost insert")
+    assert service.pay("ann", Decimal("2.00")) == Decimal("3.50")
+    assert service.balance("ann") == Decimal("3.50")
+
+
+def test_paying_everything_owed_clears_the_balance(service):
+    service.add_charge("ann", Decimal("5.50"), "lost insert")
+    assert service.pay("ann", Decimal("5.50")) == Decimal("0")
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_several_payments_each_return_the_new_balance(service):
+    service.add_charge("ann", Decimal("5.50"), "lost insert")
+    assert service.pay("ann", Decimal("2.00")) == Decimal("3.50")
+    assert service.pay("ann", Decimal("3.50")) == Decimal("0")
+
+
+def test_whole_number_payment_is_accepted_as_money(service):
+    service.add_charge("ann", Decimal("5.50"), "lost insert")
+    balance = service.pay("ann", 5)
+    assert balance == Decimal("0.50")
+    assert isinstance(balance, Decimal)
+
+
+def test_payment_on_a_child_reduces_only_their_balance(service):
+    service.add_charge("kid", Decimal("4.00"), "chewed cover")
+    service.add_charge("ann", Decimal("3.00"), "torn page")
+    assert service.pay("kid", Decimal("1.00")) == Decimal("3.00")
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_payment_of_more_than_is_owed_is_refused_and_changes_nothing(service):
+    service.add_charge("ann", Decimal("5.50"), "lost insert")
+    amount = Decimal("5.51")
+    with pytest.raises(InvalidAmount) as refused:
+        service.pay("ann", amount)
+    assert isinstance(refused.value, LendingError)
+    assert refused.value.amount is amount
+    assert service.balance("ann") == Decimal("5.50")
+
+
+@pytest.mark.parametrize("amount", [Decimal("0.01"), Decimal("1.00"), 1])
+def test_any_payment_when_nothing_is_owed_is_refused(service, amount):
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", amount)
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_payment_after_the_balance_is_cleared_is_refused(service):
+    service.add_charge("ann", Decimal("3.00"), "torn page")
+    service.pay("ann", Decimal("3.00"))
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("0.01"))
+    assert service.balance("ann") == Decimal("0")
+
+
+@pytest.mark.parametrize(
+    "amount",
+    [
+        Decimal("0"),
+        Decimal("-1.00"),
+        Decimal("0.005"),
+        Decimal("NaN"),
+        Decimal("Infinity"),
+        2.5,
+        True,
+    ],
+    ids=["zero", "negative", "fraction-of-a-penny", "nan", "infinity", "float", "bool"],
+)
+def test_payment_that_is_not_money_is_refused_and_changes_nothing(service, amount):
+    service.add_charge("ann", Decimal("3.00"), "torn page")
+    with pytest.raises(InvalidAmount) as refused:
+        service.pay("ann", amount)
+    assert isinstance(refused.value, LendingError)
+    assert refused.value.amount is amount
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_unknown_member_cannot_pay(service):
+    with pytest.raises(MemberNotFound):
+        service.pay("nobody", Decimal("1.00"))
+
+
+def test_unknown_member_is_reported_before_a_bad_amount(service):
+    with pytest.raises(MemberNotFound):
+        service.pay("nobody", Decimal("-1.00"))
diff --git a/tests/test_renewals.py b/tests/test_renewals.py
new file mode 100644
index 0000000..bfb14a0
--- /dev/null
+++ b/tests/test_renewals.py
@@ -0,0 +1,377 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, Material
+from lending.errors import (
+    AccountBlocked,
+    LendingError,
+    LoanNotFound,
+    RenewalRefused,
+)
+from lending.models import EntryKind
+from lending.reports import overdue_report
+
+
+@pytest.fixture
+def b1_out(service):
+    """``ann`` borrows B1 on Mon 2 Mar; it is due Mon 23 Mar."""
+    return service.checkout("ann", "B1")
+
+
+@pytest.fixture
+def d1_out(service):
+    """``ann`` borrows D1 on Mon 2 Mar; it is due Mon 9 Mar."""
+    return service.checkout("ann", "D1")
+
+
+def assert_renewal_fails[E: LendingError](service, loan_id, error: type[E]) -> E:
+    """Renewing raises ``error`` and changes nothing."""
+    before = service.get_loan(loan_id)
+    due_on, renewals = before.due_on, before.renewals
+    balance = service.balance(before.member_id)
+    with pytest.raises(error) as failed:
+        service.renew(loan_id)
+    assert isinstance(failed.value, LendingError)
+    after = service.get_loan(loan_id)
+    assert (after.due_on, after.renewals) == (due_on, renewals)
+    assert service.balance(before.member_id) == balance
+    return failed.value
+
+
+def assert_refused(service, loan_id):
+    refused = assert_renewal_fails(service, loan_id, RenewalRefused)
+    assert refused.loan_id == loan_id
+    assert refused.reason
+    return refused
+
+
+def assert_blocked(service, loan_id):
+    blocked = assert_renewal_fails(service, loan_id, AccountBlocked)
+    assert blocked.member_id == service.get_loan(loan_id).member_id
+    assert blocked.threshold == Decimal("0.01")
+    return blocked
+
+
+def test_a_new_loan_has_not_been_renewed(service, b1_out):
+    assert b1_out.renewals == 0
+    assert service.get_loan(b1_out.loan_id).renewals == 0
+
+
+# the renewal window ---------------------------------------------------
+
+
+def test_renewing_the_day_before_the_window_opens_is_too_early(
+    service, clock, b1_out
+):
+    clock.set(date(2026, 3, 17))
+    refused = assert_refused(service, b1_out.loan_id)
+    assert "2026-03-18" in refused.reason
+
+
+def test_a_book_due_mon_23_mar_renewed_on_wed_18_mar_is_due_wed_8_apr(
+    service, clock, b1_out
+):
+    clock.set(date(2026, 3, 18))
+    loan = service.renew(b1_out.loan_id)
+    assert loan.due_on == date(2026, 4, 8)
+    assert loan.renewals == 1
+    assert loan.loan_id == b1_out.loan_id
+    assert loan.copy_id == "B1"
+    assert loan.member_id == "ann"
+    assert loan.borrowed_on == date(2026, 3, 2)
+    assert loan.is_open
+    assert service.get_copy("B1").status is CopyStatus.ON_LOAN
+    assert service.balance("ann") == 0
+
+
+def test_renewing_on_the_day_of_borrowing_is_too_early(service, b1_out):
+    assert_refused(service, b1_out.loan_id)
+
+
+def test_an_overdue_loan_is_inside_the_window(service, clock, b1_out):
+    clock.set(date(2026, 3, 24))
+    assert service.renew(b1_out.loan_id).due_on == date(2026, 4, 14)
+
+
+def test_a_due_date_on_a_sunday_moves_to_the_monday(service, clock, b1_out):
+    # Sun 22 Mar + 21 days is Sun 12 Apr, so the loan is due Mon 13 Apr.
+    clock.set(date(2026, 3, 22))
+    assert service.renew(b1_out.loan_id).due_on == date(2026, 4, 13)
+
+

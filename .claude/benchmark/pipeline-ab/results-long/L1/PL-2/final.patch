+    assert hold.status is HoldStatus.WAITING
+    assert dvd_out.holds_for("dvd-1") == [hold]
+    assert dvd_out.balance("bob") == Decimal("0")
+
+
+def test_a_collected_hold_is_never_expired_or_charged(d1_set_aside_for_bob, clock):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    service.checkout("bob", "D1")
+    clock.set(FRI_13_MAR)
+    assert service.expire_holds() == []
+    assert hold.status is HoldStatus.FULFILLED
+    assert service.balance("bob") == Decimal("0")
+    assert service.get_copy("D1").status is CopyStatus.ON_LOAN
+
+
+def test_a_cancelled_ready_hold_is_never_expired_or_charged(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    service.cancel_hold(hold.hold_id)
+    clock.set(FRI_13_MAR)
+    assert service.expire_holds() == []
+    assert hold.status is HoldStatus.CANCELLED
+    assert service.balance("bob") == Decimal("0")
+
+
+def test_a_cancelled_waiting_hold_is_never_expired_or_charged(dvd_out, clock):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.cancel_hold(hold.hold_id)
+    clock.set(date(2026, 9, 1))
+    assert dvd_out.expire_holds() == []
+    assert hold.status is HoldStatus.CANCELLED
+    assert dvd_out.balance("bob") == Decimal("0")
+
+
+def test_the_job_returns_the_holds_it_expired_in_queue_order(dvd_out, clock):
+    dvd_out.checkout("ann", "B1")
+    dvd_out.checkout("ann", "B2")
+    carol = dvd_out.place_hold("carol", "978-1")
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    dvd_out.return_copy("B2")
+    clock.set(FRI_13_MAR)
+    assert dvd_out.expire_holds() == [carol, bob]
+    assert dvd_out.balance("carol") == Decimal("1.00")
+    assert dvd_out.balance("bob") == Decimal("1.00")
+
+
+def test_a_no_show_fee_counts_towards_the_hold_blocking_threshold(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    service.add_charge("bob", Decimal("4.00"), "torn sleeve")
+    clock.set(FRI_13_MAR)
+    service.expire_holds()
+    assert service.balance("bob") == Decimal("5.00")
+    service.checkout("ann", "B1")
+    service.checkout("ann", "B2")
+    with pytest.raises(AccountBlocked) as refused:
+        service.place_hold("bob", "978-1")
+    assert refused.value.threshold == Decimal("5.00")
+
+
+def test_a_no_show_fee_counts_towards_the_borrowing_blocking_threshold(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    service.add_charge("bob", Decimal("9.00"), "lost DVD case")
+    clock.set(FRI_13_MAR)
+    service.expire_holds()
+    with pytest.raises(AccountBlocked) as refused:
+        service.checkout("bob", "B1")
+    assert refused.value.threshold == Decimal("10.00")
+
+
+# borrowing another copy ----------------------------------------------
+
+
+def test_borrowing_a_new_copy_fulfils_a_waiting_hold(dvd_out):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.add_copy("D2", "dvd-1")
+    loan = dvd_out.checkout("bob", "D2")
+    assert loan.copy_id == "D2"
+    assert hold.status is HoldStatus.FULFILLED
+    assert hold.copy_id == "D2"
+    assert hold.pickup_by is None
+    assert dvd_out.holds_for("dvd-1") == []
+
+
+def test_borrowing_a_new_copy_passes_the_set_aside_copy_to_the_next_in_the_queue(
+    dvd_out, clock
+):
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    carol = dvd_out.place_hold("carol", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    dvd_out.add_copy("D2", "dvd-1")
+    clock.set(date(2026, 3, 10))
+    dvd_out.checkout("bob", "D2")
+    assert bob.status is HoldStatus.FULFILLED
+    assert bob.copy_id == "D2"
+    assert dvd_out.balance("bob") == Decimal("0")
+    assert dvd_out.holds_for("dvd-1") == [carol]
+    assert carol.status is HoldStatus.READY
+    assert carol.copy_id == "D1"
+    assert carol.pickup_by == date(2026, 3, 17)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert dvd_out.get_copy("D2").status is CopyStatus.ON_LOAN
+
+
+def test_borrowing_a_new_copy_with_nobody_waiting_shelves_the_set_aside_copy(
+    d1_set_aside_for_bob,
+):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    service.add_copy("D2", "dvd-1")
+    service.checkout("bob", "D2")
+    assert hold.status is HoldStatus.FULFILLED
+    assert hold.copy_id == "D2"
+    assert service.balance("bob") == Decimal("0")
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert [c.copy_id for c in service.available_copies("dvd-1")] == ["D1"]
+
+
+def test_collecting_the_set_aside_copy_passes_nothing_on(dvd_out, clock):
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    carol = dvd_out.place_hold("carol", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    dvd_out.checkout("bob", "D1")
+    assert bob.status is HoldStatus.FULFILLED
+    assert bob.copy_id == "D1"
+    assert dvd_out.holds_for("dvd-1") == [carol]
+    assert carol.status is HoldStatus.WAITING
+    assert carol.copy_id is None
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_LOAN
+
+
+def test_a_blocked_member_borrowing_a_new_copy_keeps_their_hold(
+    d1_set_aside_for_bob,
+):
+    service = d1_set_aside_for_bob
+    service.add_copy("D2", "dvd-1")

+RENEWAL_LIMITS: dict[Material, int] = {
+    Material.BOOK: 2,
+    Material.DVD: 0,
+}
+
+# Calendar days before the due date from which a loan can be renewed. There is
+# no upper bound, so an overdue loan is always inside the window.
+RENEWAL_WINDOW_DAYS: int = 5
+
 # date.weekday(): Monday is 0, Sunday is 6. The library is closed on Sundays.
 CLOSED_WEEKDAYS: frozenset[int] = frozenset({6})
 
@@ -39,5 +72,51 @@ def due_date(material: Material, borrowed_on: date) -> date:
     return next_open_day(borrowed_on + timedelta(days=LOAN_DAYS[material]))
 
 
+def pickup_by_date(set_aside_on: date) -> date:
+    """Pickup time counted in calendar days, never ending on a closed day."""
+    return next_open_day(set_aside_on + timedelta(days=PICKUP_DAYS))
+
+
+def renewable_from(due_on: date) -> date:
+    """The first day a loan due on ``due_on`` can be renewed."""
+    return due_on - timedelta(days=RENEWAL_WINDOW_DAYS)
+
+
+def renewal_limit(material: Material) -> int:
+    return RENEWAL_LIMITS[material]
+
+
 def loan_limit(category: MemberCategory) -> int:
     return LOAN_LIMITS[category]
+
+
+def pays_automatic_charges(category: MemberCategory) -> bool:
+    """Children are never charged automatically (fines, no-show fees)."""
+    return category is not MemberCategory.CHILD
+
+
+def late_days(due_on: date, until: date) -> int:
+    """Open days strictly after ``due_on``, up to and including ``until``."""
+    days = 0
+    day = due_on + timedelta(days=1)
+    while day <= until:
+        if is_open_day(day):
+            days += 1
+        day += timedelta(days=1)
+    return days
+
+
+def fine(
+    due_on: date,
+    until: date,
+    material: Material,
+    replacement_cost: Decimal,
+    already_fined: Decimal,
+) -> Decimal:
+    """The fine for lateness from ``due_on`` to ``until``.
+
+    All fines on one loan together never exceed the replacement cost, so this
+    is at most what is left of it after ``already_fined``.
+    """
+    owed = late_days(due_on, until) * FINE_PER_DAY[material]
+    return max(min(owed, replacement_cost - already_fined), Decimal("0"))

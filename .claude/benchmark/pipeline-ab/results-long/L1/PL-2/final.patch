+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus
+from lending.errors import AccountBlocked, LendingError, MemberNotFound
+
+
+def test_member_owing_exactly_the_threshold_is_blocked_from_borrowing(service):
+    service.add_charge("ann", Decimal("10.00"), "lost DVD case")
+    with pytest.raises(AccountBlocked) as refused:
+        service.checkout("ann", "B1")
+    assert isinstance(refused.value, LendingError)
+    assert refused.value.member_id == "ann"
+    assert refused.value.balance == Decimal("10.00")
+    assert refused.value.threshold == Decimal("10.00")
+
+
+def test_member_owing_more_than_the_threshold_is_blocked(service):
+    service.add_charge("ann", Decimal("25.00"), "lost book")
+    with pytest.raises(AccountBlocked) as refused:
+        service.checkout("ann", "B1")
+    assert refused.value.balance == Decimal("25.00")
+
+
+def test_member_owing_a_penny_under_the_threshold_can_still_borrow(service):
+    service.add_charge("ann", Decimal("9.99"), "torn pages")
+    loan = service.checkout("ann", "B1")
+    assert loan.member_id == "ann"
+    assert service.get_copy("B1").status is CopyStatus.ON_LOAN
+
+
+def test_blocked_member_who_pays_below_the_threshold_can_borrow_again(service):
+    service.add_charge("ann", Decimal("12.00"), "lost DVD")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "D1")
+    service.pay("ann", Decimal("2.01"))
+    loan = service.checkout("ann", "D1")
+    assert loan.copy_id == "D1"
+
+
+def test_paying_down_only_to_the_threshold_still_blocks(service):
+    service.add_charge("ann", Decimal("12.00"), "lost DVD")
+    service.pay("ann", Decimal("2.00"))
+    with pytest.raises(AccountBlocked) as refused:
+        service.checkout("ann", "D1")
+    assert refused.value.balance == Decimal("10.00")
+
+
+def test_child_with_manual_charges_at_the_threshold_is_blocked_like_an_adult(service):
+    service.add_charge("kid", Decimal("10.00"), "chewed covers")
+    with pytest.raises(AccountBlocked) as refused:
+        service.checkout("kid", "B1")
+    assert refused.value.member_id == "kid"
+    assert refused.value.balance == Decimal("10.00")
+    assert refused.value.threshold == Decimal("10.00")
+
+
+def test_blocked_member_asking_for_a_copy_on_loan_is_told_they_are_blocked(service):
+    service.checkout("kid", "B1")
+    service.add_charge("ann", Decimal("10.00"), "lost DVD case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_blocked_member_at_their_loan_limit_is_told_they_are_blocked(service):
+    for copy_id in ("B3", "B4", "B5", "B6"):
+        service.add_copy(copy_id, "978-1")
+        service.checkout("kid", copy_id)
+    service.add_charge("kid", Decimal("10.00"), "chewed covers")
+    with pytest.raises(AccountBlocked):
+        service.checkout("kid", "B1")
+
+
+def test_unknown_member_is_still_not_found(service):
+    with pytest.raises(MemberNotFound):
+        service.checkout("nobody", "B1")
+
+
+def test_refused_checkout_leaves_the_copy_available_and_makes_no_loan(service):
+    service.add_charge("ann", Decimal("10.00"), "lost DVD case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("ann") == []
+    assert service.loan_history("ann") == []
diff --git a/tests/test_fines.py b/tests/test_fines.py
new file mode 100644
index 0000000..3194a5a
--- /dev/null
+++ b/tests/test_fines.py
@@ -0,0 +1,99 @@
+from datetime import date
+from decimal import Decimal
+
+from lending import CopyStatus
+
+
+def test_dvd_returned_a_week_late_is_fined_for_six_open_days(service, clock):
+    service.checkout("ann", "D1")  # due Mon 9 March
+    clock.set(date(2026, 3, 16))  # Sunday 15 March is not counted
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("6.00")
+
+
+def test_book_returned_a_week_late_is_fined_for_six_open_days(service, clock):
+    service.checkout("ann", "B1")  # due Mon 23 March
+    clock.set(date(2026, 3, 30))  # Sunday 29 March is not counted
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_return_on_the_sunday_after_a_saturday_due_date_is_not_fined(service, clock):
+    clock.set(date(2026, 3, 7))
+    service.checkout("ann", "D1")  # due Sat 14 March
+    clock.set(date(2026, 3, 15))
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_return_on_the_monday_after_a_saturday_due_date_is_one_day_late(service, clock):
+    clock.set(date(2026, 3, 7))
+    service.checkout("ann", "D1")  # due Sat 14 March
+    clock.set(date(2026, 3, 16))
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("1.00")
+
+
+def test_return_on_the_due_date_is_not_fined(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 9))
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_return_before_the_due_date_is_not_fined(service, clock):
+    service.checkout("ann", "D1")
+    clock.advance(3)
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_fine_never_exceeds_the_replacement_cost(service, clock):
+    service.checkout("ann", "D1")  # due Mon 9 March; replacement cost 12.00
+    clock.set(date(2026, 3, 25))  # 14 open days late
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_child_late_return_is_processed_normally_and_not_fined(service, clock):
+    service.checkout("kid", "D1")
+    clock.set(date(2026, 3, 16))
+    returned = service.return_copy("D1")
+    assert returned.returned_on == date(2026, 3, 16)
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("kid") == []
+    assert service.balance("kid") == Decimal("0")
+
+
+def test_fine_adds_to_an_existing_balance(service, clock):
+    service.add_charge("ann", Decimal("2.50"), "lost insert")
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 16))
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("8.50")
+
+
+def test_fine_can_be_paid(service, clock):
+    service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 16))
+    service.return_copy("D1")
+    assert service.pay("ann", Decimal("6.00")) == Decimal("0")
+
+
+def test_late_return_still_hands_back_the_closed_loan(service, clock):
+    loan = service.checkout("ann", "D1")
+    clock.set(date(2026, 3, 16))
+    returned = service.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == date(2026, 3, 16)
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert service.open_loans("ann") == []
+
+
+def test_a_late_return_fine_names_the_returned_copy(service, repo, clock):
+    loan = service.checkout("ann", "B1")  # due Mon 23 March
+    clock.set(date(2026, 3, 30))
+    service.return_copy("B1")
+    [fine] = repo.entries_of("ann")
+    assert fine.reason == "late return of B1"
+    assert (fine.loan_id, fine.counted_from) == (loan.loan_id, date(2026, 3, 23))
diff --git a/tests/test_holds.py b/tests/test_holds.py
new file mode 100644
index 0000000..75e04ca
--- /dev/null
+++ b/tests/test_holds.py
@@ -0,0 +1,729 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending import CopyStatus, HoldStatus, Material
+from lending.errors import (
+    AccountBlocked,
+    CopyNotAvailable,
+    HoldNotAllowed,
+    HoldNotFound,
+    LendingError,
+    LoanLimitReached,
+    MemberNotFound,
+    TitleNotFound,
+)
+
+
+@pytest.fixture
+def dvd_out(service):
+    """``ann`` has D1, the only copy of ``dvd-1``; ``bob`` and ``carol`` exist."""
+    service.register_member("bob", "Bob Adult")
+    service.register_member("carol", "Carol Adult")
+    service.checkout("ann", "D1")
+    return service
+
+
+def assert_refused(service, member_id, isbn):
+    before = service.holds_for(isbn)
+    with pytest.raises(HoldNotAllowed) as refused:
+        service.place_hold(member_id, isbn)
+    assert isinstance(refused.value, LendingError)
+    assert refused.value.reason
+    assert service.holds_for(isbn) == before
+    return refused.value
+
+
+# placing -------------------------------------------------------------
+
+
+def test_member_places_a_hold_on_a_title_whose_only_copy_is_out(dvd_out):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    assert hold.hold_id == "H0001"
+    assert hold.member_id == "bob"
+    assert hold.isbn == "dvd-1"
+    assert hold.status is HoldStatus.WAITING
+    assert hold.placed_on == date(2026, 3, 2)
+    assert hold.copy_id is None
+    assert hold.pickup_by is None
+    assert dvd_out.holds_for("dvd-1") == [hold]
+
+
+def test_hold_refused_while_a_copy_is_on_the_shelf(service):
+    service.checkout("ann", "B1")
+    assert_refused(service, "kid", "978-1")
+
+
+def test_hold_refused_on_a_title_with_no_copies(service):
+    service.add_title("978-2", "Uncatalogued Shelf", Material.BOOK, Decimal("9.00"))
+    assert_refused(service, "ann", "978-2")
+
+
+def test_hold_refused_on_a_title_whose_only_copy_is_withdrawn(service):
+    service.withdraw_copy("D1")
+    assert_refused(service, "ann", "dvd-1")
+
+
+def test_withdrawn_copies_dont_stop_a_hold_while_another_copy_is_out(dvd_out):
+    dvd_out.add_copy("D2", "dvd-1")
+    dvd_out.withdraw_copy("D2")
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    assert hold.status is HoldStatus.WAITING
+
+
+def test_second_active_hold_by_the_same_member_on_a_title_is_refused(dvd_out):
+    first = dvd_out.place_hold("bob", "dvd-1")
+    assert_refused(dvd_out, "bob", "dvd-1")
+    assert dvd_out.holds_for("dvd-1") == [first]
+
+
+def test_member_with_a_copy_of_the_title_on_loan_is_refused_a_hold(dvd_out):
+    assert_refused(dvd_out, "ann", "dvd-1")
+
+
+def test_a_refused_hold_takes_no_place_in_the_hold_numbering(dvd_out):
+    assert_refused(dvd_out, "ann", "dvd-1")
+    assert dvd_out.place_hold("bob", "dvd-1").hold_id == "H0001"
+
+
+def test_member_can_hold_again_after_cancelling(dvd_out):
+    first = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.cancel_hold(first.hold_id)
+    again = dvd_out.place_hold("bob", "dvd-1")
+    assert again.status is HoldStatus.WAITING
+    assert dvd_out.holds_for("dvd-1") == [again]
+
+
+# blocking ------------------------------------------------------------
+
+
+def test_member_owing_the_hold_blocking_threshold_is_blocked(dvd_out):
+    dvd_out.add_charge("bob", Decimal("5.00"), "lost DVD case")
+    with pytest.raises(AccountBlocked) as refused:
+        dvd_out.place_hold("bob", "dvd-1")
+    assert refused.value.member_id == "bob"
+    assert refused.value.balance == Decimal("5.00")
+    assert refused.value.threshold == Decimal("5.00")
+    assert dvd_out.holds_for("dvd-1") == []
+
+
+def test_member_owing_a_penny_under_the_hold_threshold_can_place_a_hold(dvd_out):
+    dvd_out.add_charge("bob", Decimal("4.99"), "torn sleeve")
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    assert hold.status is HoldStatus.WAITING
+
+
+def test_child_owing_the_hold_blocking_threshold_is_blocked(dvd_out):
+    dvd_out.add_charge("kid", Decimal("5.00"), "chewed covers")
+    with pytest.raises(AccountBlocked) as refused:
+        dvd_out.place_hold("kid", "dvd-1")
+    assert refused.value.threshold == Decimal("5.00")
+
+
+def test_blocked_member_asking_about_a_title_on_the_shelf_is_told_they_are_blocked(
+    service,
+):
+    service.add_charge("ann", Decimal("5.00"), "lost DVD case")
+    with pytest.raises(AccountBlocked):
+        service.place_hold("ann", "978-1")
+
+
+def test_blocked_member_asking_about_an_unknown_title_is_told_they_are_blocked(
+    service,
+):
+    service.add_charge("ann", Decimal("5.00"), "lost DVD case")
+    with pytest.raises(AccountBlocked):
+        service.place_hold("ann", "no-such-isbn")
+
+
+# not found -----------------------------------------------------------
+
+
+def test_unknown_member_cannot_place_a_hold(service):
+    with pytest.raises(MemberNotFound):
+        service.place_hold("nobody", "no-such-isbn")
+
+
+def test_hold_on_an_unknown_title_is_not_found(service):
+    with pytest.raises(TitleNotFound):
+        service.place_hold("ann", "no-such-isbn")
+
+
+def test_listing_holds_on_an_unknown_title_is_not_found(service):
+    with pytest.raises(TitleNotFound):
+        service.holds_for("no-such-isbn")
+
+
+def test_cancelling_an_unknown_hold_is_not_found(service):
+    with pytest.raises(HoldNotFound) as missing:
+        service.cancel_hold("H9999")
+    assert isinstance(missing.value, LendingError)
+    assert missing.value.hold_id == "H9999"
+
+
+# the queue -----------------------------------------------------------
+
+
+def test_a_title_with_no_holds_has_an_empty_queue(service):
+    assert service.holds_for("dvd-1") == []
+
+
+def test_holds_are_listed_earliest_placed_first(dvd_out, clock):
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    clock.advance(1)
+    carol = dvd_out.place_hold("carol", "dvd-1")
+    assert [h.member_id for h in dvd_out.holds_for("dvd-1")] == ["bob", "carol"]
+    assert dvd_out.holds_for("dvd-1") == [bob, carol]
+
+
+def test_holds_placed_the_same_day_queue_in_placement_order(dvd_out):
+    dvd_out.place_hold("carol", "dvd-1")
+    dvd_out.place_hold("bob", "dvd-1")
+    assert [h.member_id for h in dvd_out.holds_for("dvd-1")] == ["carol", "bob"]
+
+
+def test_cancelled_holds_leave_the_queue(dvd_out):
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    carol = dvd_out.place_hold("carol", "dvd-1")
+    dvd_out.cancel_hold(bob.hold_id)
+    assert dvd_out.holds_for("dvd-1") == [carol]
+
+
+def test_holds_on_one_title_are_not_listed_on_another(dvd_out):
+    dvd_out.place_hold("bob", "dvd-1")
+    assert dvd_out.holds_for("978-1") == []
+
+
+# cancelling ----------------------------------------------------------
+
+
+def test_cancelling_a_waiting_hold(dvd_out):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    cancelled = dvd_out.cancel_hold(hold.hold_id)
+    assert cancelled.hold_id == hold.hold_id
+    assert cancelled.status is HoldStatus.CANCELLED
+
+
+def test_cancelling_a_hold_costs_nothing(dvd_out):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.cancel_hold(hold.hold_id)
+    assert dvd_out.balance("bob") == Decimal("0")
+
+
+def test_cancelling_a_hold_twice_is_refused(dvd_out):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.cancel_hold(hold.hold_id)
+    with pytest.raises(HoldNotAllowed) as refused:
+        dvd_out.cancel_hold(hold.hold_id)
+    assert refused.value.reason
+
+
+# setting aside on return ---------------------------------------------
+
+THU_5_MAR = date(2026, 3, 5)
+
+
+def test_a_returned_copy_is_set_aside_for_the_waiting_hold(dvd_out, clock):
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert dvd_out.available_copies("dvd-1") == []
+
+
+def test_the_hold_a_copy_is_set_aside_for_is_ready_until_a_week_later(
+    dvd_out, clock
+):
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    [hold] = dvd_out.holds_for("dvd-1")
+    assert hold.member_id == "bob"
+    assert hold.status is HoldStatus.READY
+    assert hold.copy_id == "D1"
+    assert hold.pickup_by == date(2026, 3, 12)
+
+
+def test_a_copy_set_aside_on_a_sunday_can_be_collected_until_the_monday_week(
+    dvd_out, clock
+):
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(date(2026, 3, 8))  # Sunday: returned through the book drop
+    dvd_out.return_copy("D1")
+    [hold] = dvd_out.holds_for("dvd-1")
+    assert hold.pickup_by == date(2026, 3, 16)
+
+
+def test_returning_a_copy_set_aside_still_closes_and_returns_the_loan(
+    dvd_out, clock
+):
+    [loan] = dvd_out.open_loans("ann")
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(THU_5_MAR)
+    returned = dvd_out.return_copy("D1")
+    assert returned.loan_id == loan.loan_id
+    assert returned.returned_on == THU_5_MAR
+    assert dvd_out.open_loans("ann") == []
+
+
+def test_a_late_return_that_is_set_aside_is_still_fined(dvd_out, clock):
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(date(2026, 3, 12))  # due Mon 9 Mar: 3 open days late
+    dvd_out.return_copy("D1")
+    assert dvd_out.balance("ann") == Decimal("3.00")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_a_return_readies_only_the_first_hold_in_the_queue(dvd_out, clock):
+    dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.place_hold("carol", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    queue = dvd_out.holds_for("dvd-1")
+    assert [(h.member_id, h.status) for h in queue] == [
+        ("bob", HoldStatus.READY),
+        ("carol", HoldStatus.WAITING),
+    ]
+    assert queue[1].copy_id is None
+    assert queue[1].pickup_by is None
+
+
+def test_a_return_with_nobody_waiting_goes_back_on_the_shelf(dvd_out, clock):
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert [c.copy_id for c in dvd_out.available_copies("dvd-1")] == ["D1"]
+
+
+def test_a_cancelled_hold_does_not_have_a_copy_set_aside(dvd_out, clock):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.cancel_hold(hold.hold_id)
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert hold.status is HoldStatus.CANCELLED
+
+
+def test_holds_on_another_title_do_not_have_a_returned_copy_set_aside(dvd_out, clock):
+    dvd_out.checkout("bob", "B1")
+    dvd_out.checkout("bob", "B2")
+    dvd_out.place_hold("carol", "978-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert dvd_out.holds_for("978-1")[0].status is HoldStatus.WAITING
+
+
+def test_a_set_aside_copy_cannot_be_withdrawn(dvd_out, clock):
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    with pytest.raises(CopyNotAvailable):
+        dvd_out.withdraw_copy("D1")
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+# collecting ----------------------------------------------------------
+
+
+@pytest.fixture
+def d1_set_aside_for_bob(dvd_out, clock):
+    """``bob``'s hold on ``dvd-1`` is ready: D1 came back on Thu 5 Mar."""
+    dvd_out.place_hold("bob", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    return dvd_out
+
+
+def test_member_collects_a_ready_hold_by_borrowing_the_set_aside_copy(
+    d1_set_aside_for_bob,
+):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    loan = service.checkout("bob", "D1")
+    assert loan.member_id == "bob"
+    assert loan.copy_id == "D1"
+    assert loan.borrowed_on == THU_5_MAR
+    assert service.get_copy("D1").status is CopyStatus.ON_LOAN
+    assert hold.status is HoldStatus.FULFILLED
+    assert hold.copy_id == "D1"
+    assert service.holds_for("dvd-1") == []
+
+
+def test_nobody_else_can_borrow_a_copy_set_aside_for_a_hold(d1_set_aside_for_bob):
+    service = d1_set_aside_for_bob
+    with pytest.raises(CopyNotAvailable):
+        service.checkout("carol", "D1")
+    assert service.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert service.holds_for("dvd-1")[0].status is HoldStatus.READY
+
+
+def test_a_blocked_member_cannot_collect_and_the_hold_stays_ready(
+    d1_set_aside_for_bob,
+):
+    service = d1_set_aside_for_bob
+    service.add_charge("bob", Decimal("10.00"), "lost DVD case")
+    with pytest.raises(AccountBlocked) as refused:
+        service.checkout("bob", "D1")
+    assert refused.value.threshold == Decimal("10.00")
+    [hold] = service.holds_for("dvd-1")
+    assert hold.status is HoldStatus.READY
+    assert hold.copy_id == "D1"
+    assert service.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_a_member_at_the_loan_limit_cannot_collect_and_the_hold_stays_ready(
+    d1_set_aside_for_bob,
+):
+    service = d1_set_aside_for_bob
+    for n in range(8):
+        service.add_copy(f"X{n}", "978-1")
+        service.checkout("bob", f"X{n}")
+    with pytest.raises(LoanLimitReached):
+        service.checkout("bob", "D1")
+    assert service.holds_for("dvd-1")[0].status is HoldStatus.READY
+    assert service.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_a_member_can_collect_after_the_pickup_by_date_until_the_hold_expires(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    clock.set(date(2026, 3, 14))  # pickup-by was Thu 12 Mar; no job has run
+    service.checkout("bob", "D1")
+    assert hold.status is HoldStatus.FULFILLED
+    assert service.balance("bob") == Decimal("0")
+
+
+# cancelling a ready hold ---------------------------------------------
+
+
+def test_cancelling_a_ready_hold_sets_its_copy_aside_for_the_next_in_the_queue(
+    dvd_out, clock
+):
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    carol = dvd_out.place_hold("carol", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    clock.set(date(2026, 3, 10))
+    cancelled = dvd_out.cancel_hold(bob.hold_id)
+    assert cancelled.status is HoldStatus.CANCELLED
+    assert dvd_out.balance("bob") == Decimal("0")
+    assert dvd_out.holds_for("dvd-1") == [carol]
+    assert carol.status is HoldStatus.READY
+    assert carol.copy_id == "D1"
+    assert carol.pickup_by == date(2026, 3, 17)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    dvd_out.checkout("carol", "D1")
+    assert carol.status is HoldStatus.FULFILLED
+
+
+def test_cancelling_a_ready_hold_with_nobody_waiting_shelves_its_copy(
+    d1_set_aside_for_bob,
+):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    service.cancel_hold(hold.hold_id)
+    assert hold.status is HoldStatus.CANCELLED
+    assert service.balance("bob") == Decimal("0")
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert [c.copy_id for c in service.available_copies("dvd-1")] == ["D1"]
+
+
+def test_a_member_whose_ready_hold_was_cancelled_cannot_take_its_copy_from_the_next(
+    dvd_out, clock
+):
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    dvd_out.place_hold("carol", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    dvd_out.cancel_hold(bob.hold_id)
+    with pytest.raises(CopyNotAvailable):
+        dvd_out.checkout("bob", "D1")
+
+
+# expiry --------------------------------------------------------------
+
+THU_12_MAR = date(2026, 3, 12)
+FRI_13_MAR = date(2026, 3, 13)
+
+
+def test_a_ready_hold_does_not_expire_on_its_pickup_by_date(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    clock.set(THU_12_MAR)
+    assert service.expire_holds() == []
+    assert hold.status is HoldStatus.READY
+    assert service.balance("bob") == Decimal("0")
+
+
+def test_a_ready_hold_expires_the_day_after_its_pickup_by_date_with_a_no_show_fee(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    [hold] = service.holds_for("dvd-1")
+    clock.set(FRI_13_MAR)
+    assert service.expire_holds() == [hold]
+    assert hold.status is HoldStatus.EXPIRED
+    assert service.holds_for("dvd-1") == []
+    assert service.balance("bob") == Decimal("1.00")
+
+
+def test_an_expired_holds_copy_is_set_aside_for_the_next_waiting_hold(dvd_out, clock):
+    dvd_out.place_hold("bob", "dvd-1")
+    carol = dvd_out.place_hold("carol", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    clock.set(FRI_13_MAR)
+    dvd_out.expire_holds()
+    assert dvd_out.holds_for("dvd-1") == [carol]
+    assert carol.status is HoldStatus.READY
+    assert carol.copy_id == "D1"
+    assert carol.pickup_by == date(2026, 3, 20)
+    assert dvd_out.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+    assert dvd_out.balance("carol") == Decimal("0")
+
+
+def test_an_expired_holds_copy_goes_back_on_the_shelf_with_nobody_waiting(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    clock.set(FRI_13_MAR)
+    service.expire_holds()
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+    assert [c.copy_id for c in service.available_copies("dvd-1")] == ["D1"]
+
+
+def test_running_the_job_twice_on_the_same_day_expires_and_charges_nothing_more(
+    d1_set_aside_for_bob, clock
+):
+    service = d1_set_aside_for_bob
+    clock.set(FRI_13_MAR)
+    service.expire_holds()
+    assert service.expire_holds() == []
+    assert service.balance("bob") == Decimal("1.00")
+    assert service.get_copy("D1").status is CopyStatus.AVAILABLE
+
+
+def test_a_job_run_days_late_catches_up_and_counts_the_next_pickup_from_the_run_day(
+    dvd_out, clock
+):
+    bob = dvd_out.place_hold("bob", "dvd-1")
+    carol = dvd_out.place_hold("carol", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    clock.set(date(2026, 3, 18))  # Wednesday; the job has not run since the 12th
+    assert dvd_out.expire_holds() == [bob]
+    assert bob.status is HoldStatus.EXPIRED
+    assert dvd_out.balance("bob") == Decimal("1.00")
+    assert carol.status is HoldStatus.READY
+    assert carol.pickup_by == date(2026, 3, 25)
+
+
+def test_a_childs_expired_hold_charges_no_no_show_fee(dvd_out, clock):
+    hold = dvd_out.place_hold("kid", "dvd-1")
+    clock.set(THU_5_MAR)
+    dvd_out.return_copy("D1")
+    clock.set(FRI_13_MAR)
+    assert dvd_out.expire_holds() == [hold]
+    assert hold.status is HoldStatus.EXPIRED
+    assert dvd_out.balance("kid") == Decimal("0")
+
+
+def test_a_waiting_hold_never_expires(dvd_out, clock):
+    hold = dvd_out.place_hold("bob", "dvd-1")
+    clock.set(date(2026, 9, 1))  # ann still has D1, six months on

 """Domain errors. Every failure the service reports is a ``LendingError``."""
 
+from decimal import Decimal
+
 
 class LendingError(Exception):
     """Base class for all lending domain errors."""
@@ -57,12 +59,61 @@ class LoanLimitReached(LendingError):
         self.limit = limit
 
 
+class AccountBlocked(LendingError):
+    """The member's balance is at or above the blocking threshold for an action.
+
+    Carries the threshold that was applied, so the same error serves every
+    blocked action (borrowing now, holds later) whatever its threshold.
+    """
+
+    def __init__(self, member_id: str, balance: Decimal, threshold: Decimal) -> None:
+        super().__init__(
+            f"member {member_id!r} owes {balance}, at or above the blocking "
+            f"threshold of {threshold}"
+        )
+        self.member_id = member_id
+        self.balance = balance
+        self.threshold = threshold
+
+
 class LoanNotFound(LendingError):
     def __init__(self, loan_id: str) -> None:
         super().__init__(f"no loan {loan_id!r}")
         self.loan_id = loan_id
 
 
+class HoldNotFound(LendingError):
+    def __init__(self, hold_id: str) -> None:
+        super().__init__(f"no hold {hold_id!r}")
+        self.hold_id = hold_id
+
+
+class HoldNotAllowed(LendingError):
+    """A hold can't be placed, or a hold no longer active can't be cancelled."""
+
+    def __init__(self, reason: str) -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+class InvalidAmount(LendingError):
+    """An amount that cannot be money (not positive, a fraction of a penny, or a
+    float), or a payment of more than the member owes."""
+
+    def __init__(self, amount: object) -> None:
+        super().__init__(f"{amount!r} is not a valid amount")
+        self.amount = amount
+
+
+class RenewalRefused(LendingError):
+    """A loan that can't be renewed, with a short reason saying why."""
+
+    def __init__(self, loan_id: str, reason: str) -> None:
+        super().__init__(reason)
+        self.loan_id = loan_id
+        self.reason = reason
+
+
 class NoOpenLoan(LendingError):
     """A copy was handed back that is not out on loan."""
 

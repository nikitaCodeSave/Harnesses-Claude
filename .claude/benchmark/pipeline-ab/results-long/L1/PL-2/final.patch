+    assert hold.copy_id == "D1"
+    assert service.get_copy("D1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_borrowing_a_copy_of_another_title_leaves_a_hold_alone(dvd_out):
+    hold = dvd_out.place_hold("bob", "dvd-1")

+from decimal import Decimal
+
+import pytest
+
+from lending.errors import InvalidAmount, LendingError, MemberNotFound
+
+
+def test_newly_registered_member_owes_nothing(service):
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_manual_charges_add_up_and_each_returns_the_new_balance(service):
+    assert service.add_charge("ann", Decimal("3.00"), "torn page") == Decimal("3.00")
+    assert service.add_charge("ann", Decimal("2.50"), "lost insert") == Decimal("5.50")
+    assert service.balance("ann") == Decimal("5.50")
+
+
+def test_manual_charge_on_a_child_counts_towards_their_balance(service):
+    assert service.add_charge("kid", Decimal("4.00"), "chewed cover") == Decimal("4.00")
+    assert service.balance("kid") == Decimal("4.00")
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_whole_number_amount_is_accepted_as_money(service):
+    balance = service.add_charge("ann", 5, "lost insert")
+    assert balance == Decimal("5.00")
+    assert isinstance(balance, Decimal)
+
+
+@pytest.mark.parametrize("reason", ["", "   ", "Damaged case — £ cracked\nsee note"])
+def test_any_reason_is_accepted(service, reason):
+    assert service.add_charge("ann", Decimal("1.00"), reason) == Decimal("1.00")
+
+
+@pytest.mark.parametrize(
+    "amount",
+    [
+        Decimal("0"),
+        Decimal("-1.00"),
+        Decimal("0.005"),
+        Decimal("NaN"),
+        Decimal("Infinity"),
+        2.5,
+        True,
+    ],
+    ids=["zero", "negative", "fraction-of-a-penny", "nan", "infinity", "float", "bool"],
+)
+def test_charge_that_is_not_money_is_refused_and_changes_nothing(service, amount):
+    service.add_charge("ann", Decimal("3.00"), "torn page")
+    with pytest.raises(InvalidAmount) as refused:
+        service.add_charge("ann", amount, "bad amount")
+    assert isinstance(refused.value, LendingError)
+    assert refused.value.amount is amount
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_unknown_member_has_no_balance(service):
+    with pytest.raises(MemberNotFound):
+        service.balance("nobody")
+
+
+def test_unknown_member_cannot_be_charged(service):
+    with pytest.raises(MemberNotFound):
+        service.add_charge("nobody", Decimal("3.00"), "torn page")
+
+
+def test_unknown_member_is_reported_before_a_bad_amount(service):
+    with pytest.raises(MemberNotFound):
+        service.add_charge("nobody", Decimal("-1.00"), "torn page")

+++ b/tests/test_reservations.py
@@ -0,0 +1,243 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+from inventory.reports import StockRow, stock_report
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+# -- reserve -------------------------------------------------------------
+def test_reserve_holds_stock_until_expiry(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.items == {"MUG": 4}
+    assert res.expires_at == clock.now() + TTL
+    assert res.order_id is None
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_reserve_is_partial_per_line(stocked):
+    stocked.place_order("WH1", {"TEE": 5})
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 1, "CAP": 1}, "k1")
+    assert res.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_reserve_with_nothing_available_creates_nothing(stocked, repo):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert repo.reservations() == []
+    stocked.receive("CAP", "WH1", 1)
+    assert stocked.reserve("WH1", {"CAP": 1}, "k1").items == {"CAP": 1}
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": -1}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_invalid_reserve_holds_nothing(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_reserve_does_not_touch_ledger(stocked, ledger):
+    before = len(ledger)
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    res2 = stocked.reserve("WH1", {"MUG": 2}, "k2")
+    stocked.confirm_reservation(res2.reservation_id)
+    stocked.reserve("WH1", {"MUG": 2}, "k3")
+    assert len(ledger) == before
+
+
+def test_place_order_cannot_take_held_stock(stocked, repo):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3})
+    assert repo.orders() == []
+
+
+def test_holds_are_per_warehouse(stocked):
+    stocked.receive("MUG", "WH2", 3)
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert stocked.available("MUG", "WH2") == 3
+
+
+# -- idempotency ---------------------------------------------------------
+def test_same_key_same_request_returns_existing(stocked, clock, repo):
+    first = stocked.reserve("WH1", {"MUG": 4, "TEE": 1}, "k1")
+    clock.advance(minutes=5)
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 4}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.expires_at == first.expires_at
+    assert len(repo.reservations()) == 1
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_repeat_compares_requested_not_held_items(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert first.items == {"MUG": 10}
+    assert stocked.reserve("WH1", {"MUG": 15}, "k1").reservation_id == first.reservation_id
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_repeat_returns_current_state(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(TTL)
+    assert stocked.reserve("WH1", {"MUG": 1}, "k1").status is ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+    assert res.reservation_id == stocked.reserve("WH1", {"MUG": 1}, "k1").reservation_id
+
+
+@pytest.mark.parametrize(
+    "warehouse, items", [("WH2", {"MUG": 1}), ("WH1", {"MUG": 2}), ("WH1", {"MUG": 1, "TEE": 1})]

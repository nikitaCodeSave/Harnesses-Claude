+    # -- reservations ----------------------------------------------------
+    def reserve(
+        self, warehouse: str, items: Mapping[str, int], idempotency_key: str
+    ) -> Reservation:
+        """Hold stock for a cart until it is confirmed, released or expires.
+
+        Each line holds as much as is available right now, up to what was
+        asked; lines with nothing available are left out. Fails with
+        InsufficientStock only if no line can hold anything.
+
+        Repeating a call with the same key and the same request returns the
+        original reservation in its current state; a different request under
+        a used key raises IdempotencyConflict.
+        """
+        wanted = self._validate_items(warehouse, items)
+        seen = self._repo.reservation_for_key(idempotency_key)
+        if seen is not None:
+            seen_warehouse, seen_items, reservation_id = seen
+            if (seen_warehouse, seen_items) != (warehouse, wanted):
+                raise IdempotencyConflict(idempotency_key)
+            return self.get_reservation(reservation_id)
+
+        held: dict[str, int] = {}
+        for sku, quantity in wanted.items():
+            take = min(quantity, self.available(sku, warehouse))
+            if take > 0:
+                held[sku] = take
+        if not held:
+            sku, quantity = next(iter(wanted.items()))
+            raise InsufficientStock(sku, warehouse, quantity, 0)
+
+        reservation = Reservation(
+            reservation_id=self._repo.next_reservation_id(),
+            warehouse=warehouse,
+            items=held,
+            status=ReservationStatus.ACTIVE,
+            expires_at=self._clock.now() + self._reservation_ttl,
+        )
+        self._repo.save_reservation(reservation)
+        self._repo.remember_reservation_key(
+            idempotency_key, warehouse, wanted, reservation.reservation_id
+        )
+        return reservation
+
+    def get_reservation(self, reservation_id: str) -> Reservation:
+        return self._refresh(self._repo.get_reservation(reservation_id))
+
+    def confirm_reservation(self, reservation_id: str) -> Order:
+        """Turn an active hold into a PLACED order for exactly the units held.
+
+        Confirming an already confirmed reservation returns its order again.
+        """
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            return self._repo.get_order(reservation.order_id)
+        if reservation.status is ReservationStatus.EXPIRED:
+            raise ReservationExpired(reservation_id, reservation.expires_at)
+        if reservation.status is not ReservationStatus.ACTIVE:
+            raise InvalidReservationState(reservation_id, reservation.status, "confirm")
+
+        # A write-off since the hold was taken may have left too little
+        # physical stock to back every promise; then the hold stays ACTIVE.
+        warehouse = reservation.warehouse
+        for sku, quantity in reservation.items.items():
+            promised_elsewhere = (
+                self.allocated(sku, warehouse) + self.held(sku, warehouse) - quantity
+            )
+            free = max(0, self.on_hand(sku, warehouse) - promised_elsewhere)
+            if quantity > free:
+                raise InsufficientStock(sku, warehouse, quantity, free)
+
+        order = Order(
+            order_id=self._repo.next_order_id(),
+            warehouse=warehouse,
+            lines=tuple(OrderLine(sku, qty) for sku, qty in reservation.items.items()),
+            status=OrderStatus.PLACED,
+            placed_at=self._clock.now(),
+        )
+        self._repo.save_order(order)
+        reservation.status = ReservationStatus.CONFIRMED
+        reservation.order_id = order.order_id
+        self._repo.save_reservation(reservation)
+        return order
+
+    def release_reservation(self, reservation_id: str) -> Reservation:
+        """Give held stock back. Releasing a released or expired hold is a no-op."""
+        reservation = self.get_reservation(reservation_id)
+        if reservation.status is ReservationStatus.CONFIRMED:
+            raise InvalidReservationState(reservation_id, reservation.status, "release")
+        if reservation.status is ReservationStatus.ACTIVE:
+            reservation.status = ReservationStatus.RELEASED
+            self._repo.save_reservation(reservation)
+        return reservation
+

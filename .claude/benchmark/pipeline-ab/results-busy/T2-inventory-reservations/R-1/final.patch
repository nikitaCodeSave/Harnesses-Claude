+++ b/tests/acceptance/test_confirm_reservation.py
@@ -0,0 +1,190 @@
+"""SPEC.md acceptance criteria 22-28: confirm_reservation."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+
+
+def _lines(order):
+    return {line.sku: line.quantity for line in order.lines}
+
+
+# -- 22. confirm creates a PLACED order for the held units -------------------
+def test_c22_confirm_creates_placed_order_for_held_items(stocked, repo, clock):
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert _lines(order) == {"MUG": 3, "TEE": 2}
+    assert len(order.lines) == 2
+    assert order.placed_at == clock.now()
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+
+
+def test_c22_partial_hold_orders_only_held_units(stocked):
+    r = stocked.reserve("WH1", {"MUG": 15, "TEE": 2, "CAP": 4}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert _lines(order) == {"MUG": 10, "TEE": 2}
+    assert len(order.lines) == 2
+
+
+def test_c22_confirm_works_just_before_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(r.expires_at - timedelta(microseconds=1))
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.placed_at == clock.now()
+
+
+# -- 23. reservation becomes CONFIRMED; units move without a gap -------------
+def test_c23_reservation_is_confirmed_with_order_id(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.status is models.ReservationStatus.CONFIRMED
+    assert got.order_id == order.order_id
+
+
+def test_c23_available_unchanged_across_confirm(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    before = (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1"))
+    stocked.confirm_reservation(r.reservation_id)
+    after = (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1"))
+    assert before == after == (7, 3)
+
+
+def test_c23_units_move_from_held_to_allocated(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 0
+    stocked.confirm_reservation(r.reservation_id)
+    assert stocked.allocated("MUG", "WH1") == 3
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c23_confirmed_hold_does_not_lapse_at_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(r.reservation_id)
+    clock.set(r.expires_at + timedelta(minutes=1))
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.CONFIRMED
+    assert stocked.allocated("MUG", "WH1") == 3
+    assert stocked.available("MUG", "WH1") == 7
+
+
+# -- 24. resulting order behaves like any other ------------------------------
+def test_c24_confirmed_order_can_be_shipped(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    shipped = stocked.ship_order(order.order_id)
+    assert shipped.status is OrderStatus.SHIPPED
+    assert stocked.on_hand("MUG", "WH1") == 7
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c24_confirmed_order_can_be_cancelled(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    cancelled = stocked.cancel_order(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 10
+    # Non-goal: reservation is not revived
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.CONFIRMED
+
+
+# -- 25. confirm is idempotent -----------------------------------------------
+def test_c25_second_confirm_returns_same_order(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(r.reservation_id)
+    again = stocked.confirm_reservation(r.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+def test_c25_second_confirm_after_expires_at_returns_same_order(stocked, repo, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(r.reservation_id)
+    clock.set(r.expires_at + timedelta(hours=2))
+    again = stocked.confirm_reservation(r.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_c25_second_confirm_after_ship_returns_same_order(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(r.reservation_id)
+    stocked.ship_order(first.order_id)
+    again = stocked.confirm_reservation(r.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert repo.get_order(first.order_id).status is OrderStatus.SHIPPED
+
+
+def test_c25_second_confirm_after_cancel_returns_same_order(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(r.reservation_id)
+    stocked.cancel_order(first.order_id)
+    again = stocked.confirm_reservation(r.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert repo.get_order(first.order_id).status is OrderStatus.CANCELLED
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+# -- 26. confirming an expired reservation -----------------------------------
+def test_c26_confirm_at_expires_at_raises_expired(stocked, repo, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(r.expires_at)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c26_confirm_after_expires_at_raises_expired(stocked, repo, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(days=1)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+# -- 27. confirming a released reservation -----------------------------------
+def test_c27_confirm_released_raises_invalid_state(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.RELEASED
+
+
+# -- 28. on-hand dropped below held: all or nothing --------------------------
+def test_c28_confirm_after_stock_drop_is_all_or_nothing(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 10, "TEE": 5}, "k1")
+    stocked.adjust("TEE", "WH1", -3, "damaged")
+    try:
+        order = stocked.confirm_reservation(r.reservation_id)
+    except errors.InsufficientStock:
+        assert repo.orders() == []
+        got = stocked.get_reservation(r.reservation_id)
+        assert got.status is models.ReservationStatus.ACTIVE
+        assert got.order_id is None
+        assert got.items == {"MUG": 10, "TEE": 5}
+        assert got.expires_at == r.expires_at
+        assert stocked.allocated("MUG", "WH1") == 0
+        assert stocked.allocated("TEE", "WH1") == 0
+    else:
+        assert [o.order_id for o in repo.orders()] == [order.order_id]
+        assert order.status is OrderStatus.PLACED
+        got = stocked.get_reservation(r.reservation_id)
+        assert got.status is models.ReservationStatus.CONFIRMED
+        assert got.order_id == order.order_id

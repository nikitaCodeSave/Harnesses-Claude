@@ -0,0 +1,149 @@
+"""SPEC.md acceptance criteria 15-18: idempotency keys."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+
+
+# -- 15. keys are global across warehouses -----------------------------------
+def test_c15_key_used_in_one_warehouse_conflicts_in_another(stocked):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 1}, "k1")
+    assert stocked.available("MUG", "WH2") == 10
+
+
+def test_c15_key_is_remembered_long_after_expiry(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(days=400)
+    replay = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2}, "k1")
+
+
+# -- 16. replay returns the original in its current state --------------------
+def test_c16_replay_returns_original_and_holds_nothing_more(stocked):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    replay = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    assert replay.items == {"MUG": 3}
+    assert replay.status is models.ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c16_replay_matches_regardless_of_key_order(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1, "TEE": 2}, "k1")
+    replay = stocked.reserve("WH1", {"TEE": 2, "MUG": 1}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    assert stocked.available("MUG", "WH1") == 9
+    assert stocked.available("TEE", "WH1") == 3
+
+
+def test_c16_replay_does_not_change_expires_at(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(minutes=10)
+    replay = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert replay.expires_at == first.expires_at
+    assert stocked.get_reservation(first.reservation_id).expires_at == first.expires_at
+    clock.set(first.expires_at)
+    assert stocked.get_reservation(first.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_c16_replay_after_confirm_returns_confirmed_and_no_new_order(stocked, repo):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(first.reservation_id)
+    replay = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    assert replay.status is models.ReservationStatus.CONFIRMED
+    assert replay.order_id == order.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c16_replay_after_release_returns_released_and_holds_nothing(stocked):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(first.reservation_id)
+    replay = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    assert replay.status is models.ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c16_replay_after_expiry_returns_expired_and_holds_nothing(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(first.expires_at)
+    replay = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    assert replay.status is models.ReservationStatus.EXPIRED
+    assert replay.expires_at == first.expires_at
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 17. comparison is against requested items, not held ---------------------
+def test_c17_replay_of_partial_hold_uses_requested_items(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15, "CAP": 2}, "k1")
+    assert first.items == {"MUG": 10}
+    replay = stocked.reserve("WH1", {"MUG": 15, "CAP": 2}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    assert replay.items == {"MUG": 10}
+
+
+def test_c17_held_items_are_not_the_same_request(stocked):
+    stocked.reserve("WH1", {"MUG": 15, "CAP": 2}, "k1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_c17_replay_does_not_top_up_partial_hold_when_stock_arrives(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    stocked.receive("MUG", "WH1", 10)
+    replay = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert replay.reservation_id == first.reservation_id
+    assert replay.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 18. different request with same key -> IdempotencyConflict --------------
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [
+        pytest.param("WH2", {"MUG": 3}, id="other-warehouse"),
+        pytest.param("WH1", {"MUG": 4}, id="other-quantity"),
+        pytest.param("WH1", {"TEE": 3}, id="other-sku"),
+        pytest.param("WH1", {"MUG": 3, "TEE": 1}, id="extra-line"),
+    ],
+)
+def test_c18_conflicting_request_raises(stocked, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH2") == 10
+
+
+def test_c18_conflict_after_confirm(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(r.reservation_id)
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4}, "k1")
+
+
+def test_c18_conflict_after_release(stocked):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4}, "k1")
+
+
+def test_c18_conflict_after_expiry(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(r.expires_at + timedelta(hours=1))
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 10

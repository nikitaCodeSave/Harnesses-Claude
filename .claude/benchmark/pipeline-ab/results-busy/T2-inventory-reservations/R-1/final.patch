+"""Shared setup for the stock-reservation acceptance tests (SPEC.md).
+
+The base fixtures (``clock``, ``repo``, ``ledger``, ``service``) come from
+``tests/conftest.py``. Clock starts at 2024-03-01 09:00 UTC; warehouses WH1
+and WH2; products MUG, TEE, CAP.
+"""
+
+import pytest
+
+
+@pytest.fixture
+def stocked(service):
+    """WH1: MUG 10, TEE 5, CAP 0.  WH2: MUG 10, TEE 0, CAP 0."""
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 10)
+    return service

+        holding = {}
+        for sku, quantity in requested.items():
+            take = min(quantity, self.available(sku, warehouse))
+            if take > 0:
+                holding[sku] = take
+        if not holding:
+            sku, quantity = next(iter(requested.items()))
+            raise InsufficientStock(sku, warehouse, quantity, 0)

+    # -- reservations ----------------------------------------------------
+    def reserve(
+        self, warehouse: str, items: Mapping[str, int], idempotency_key: str
+    ) -> Reservation:
+        """Hold stock for a cart. Each line holds what is available, up to the request.
+
+        Replaying a key with the same request returns the original reservation
+        as it stands now; replaying it with a different request is a conflict.
+        """
+        if not isinstance(idempotency_key, str) or not idempotency_key:
+            raise InvalidOrder("a reservation needs a non-empty idempotency key")
+        if not items:
+            raise InvalidOrder("a reservation needs at least one line")
+        requested = self._validate_items(warehouse, items)
+
+        previous = self._repo.find_idempotency_key(idempotency_key)
+        if previous is not None:
+            if previous.warehouse != warehouse or previous.requested != requested:
+                raise IdempotencyConflict(idempotency_key)
+            return self.get_reservation(previous.reservation_id)

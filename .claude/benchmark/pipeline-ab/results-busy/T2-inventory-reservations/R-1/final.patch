@@ -0,0 +1,74 @@
+"""SPEC.md acceptance criteria 29-32: release_reservation."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+
+
+# -- 29. release an active hold ----------------------------------------------
+def test_c29_release_sets_released_and_frees_units(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4, "TEE": 5}, "k1")
+    released = stocked.release_reservation(r.reservation_id)
+    assert released.reservation_id == r.reservation_id
+    assert released.status is models.ReservationStatus.RELEASED
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_c29_released_hold_stays_released_after_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    clock.set(r.expires_at + timedelta(minutes=1))
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.RELEASED
+
+
+# -- 30. releasing twice -----------------------------------------------------
+def test_c30_release_twice_returns_released_without_raising(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.release_reservation(r.reservation_id)
+    again = stocked.release_reservation(r.reservation_id)
+    assert again.reservation_id == first.reservation_id
+    assert again.status is models.ReservationStatus.RELEASED
+    assert again.items == first.items
+    assert again.expires_at == first.expires_at
+    assert again.order_id is None
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 31. releasing an expired hold is a no-op --------------------------------
+def test_c31_release_at_expires_at_returns_expired(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(r.expires_at)
+    got = stocked.release_reservation(r.reservation_id)
+    assert got.status is models.ReservationStatus.EXPIRED
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c31_release_long_after_expiry_returns_expired(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(days=2)
+    got = stocked.release_reservation(r.reservation_id)
+    assert got.reservation_id == r.reservation_id
+    assert got.status is models.ReservationStatus.EXPIRED
+    assert got.expires_at == r.expires_at
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+# -- 32. releasing a confirmed reservation -----------------------------------
+def test_c32_release_confirmed_raises_and_order_is_unaffected(stocked, repo):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.release_reservation(r.reservation_id)
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+    assert stocked.allocated("MUG", "WH1") == 4
+    assert stocked.available("MUG", "WH1") == 6
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.status is models.ReservationStatus.CONFIRMED
+    assert got.order_id == order.order_id

@@ -0,0 +1,163 @@
+"""SPEC.md acceptance criteria 6-14: reserve."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+DEFAULT_TTL = timedelta(minutes=20)
+
+
+# -- 6. new reservation shape ------------------------------------------------
+def test_c6_new_reservation_is_active_without_order(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert r.status is models.ReservationStatus.ACTIVE
+    assert r.order_id is None
+    assert r.warehouse == "WH1"
+
+
+def test_c6_expires_twenty_minutes_after_now_by_default(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert r.expires_at == clock.now() + DEFAULT_TTL
+
+
+def test_c6_expiry_is_measured_from_the_clock_at_reserve_time(stocked, clock):
+    clock.advance(minutes=37)
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert r.expires_at == clock.now() + DEFAULT_TTL
+
+
+# -- 7. partial holds --------------------------------------------------------
+def test_c7_line_holds_what_is_available_when_short(stocked):
+    r = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert r.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_c7_each_line_is_capped_independently(stocked):
+    r = stocked.reserve("WH1", {"MUG": 4, "TEE": 9}, "k1")
+    assert r.items == {"MUG": 4, "TEE": 5}
+
+
+def test_c7_availability_accounts_for_orders_and_other_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    r = stocked.reserve("WH1", {"MUG": 6}, "k2")
+    assert r.items == {"MUG": 3}
+
+
+# -- 8. lines with nothing available are omitted -----------------------------
+def test_c8_unavailable_line_is_left_out_not_zero(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2, "CAP": 3}, "k1")
+    assert r.items == {"MUG": 2}
+    assert "CAP" not in r.items
+
+
+def test_c8_fully_held_line_is_left_out(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    r = stocked.reserve("WH1", {"MUG": 1, "TEE": 1}, "k2")
+    assert r.items == {"MUG": 1}
+
+
+# -- 9. nothing holdable -> InsufficientStock, nothing created ---------------
+def test_c9_raises_insufficient_stock_when_no_line_can_hold(stocked):
+    # WH2 has neither CAP nor TEE
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH2", {"CAP": 1, "TEE": 1}, "k1")
+
+
+def test_c9_key_is_not_recorded_after_insufficient_stock(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    # same key, different request: must not be an IdempotencyConflict
+    r = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert r.items == {"MUG": 1}
+    assert r.status is models.ReservationStatus.ACTIVE
+
+
+def test_c9_same_request_can_succeed_later_with_same_key(stocked):
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    stocked.receive("CAP", "WH1", 5)
+    r = stocked.reserve("WH1", {"CAP": 2}, "k1")
+    assert r.items == {"CAP": 2}
+    assert stocked.available("CAP", "WH1") == 3
+
+
+# -- 10. full availability ---------------------------------------------------
+def test_c10_items_equal_requested_when_everything_is_available(stocked):
+    requested = {"MUG": 3, "TEE": 5}
+    r = stocked.reserve("WH1", requested, "k1")
+    assert r.items == requested
+
+
+# -- 11. validation matches place_order --------------------------------------
+def test_c11_unknown_warehouse(stocked):
+    with pytest.raises(errors.UnknownWarehouse):
+        stocked.reserve("NOPE", {"MUG": 1}, "k1")
+
+
+def test_c11_unknown_sku(stocked):
+    with pytest.raises(errors.UnknownSku):
+        stocked.reserve("WH1", {"MUG": 1, "GHOST": 1}, "k1")
+
+
+@pytest.mark.parametrize("quantity", [0, -1, True, False, 1.5, 2.0, "2", None])
+def test_c11_quantity_must_be_positive_int(stocked, quantity):
+    with pytest.raises(errors.InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": 1, "TEE": quantity}, "k1")
+
+
+# -- 12. empty items / empty key ---------------------------------------------
+def test_c12_empty_items_rejected(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {}, "k1")
+
+
+def test_c12_empty_idempotency_key_rejected(stocked):
+    with pytest.raises(errors.InventoryError):
+        stocked.reserve("WH1", {"MUG": 1}, "")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 13. rejected requests leave no trace -------------------------------------
+REJECTED = [
+    pytest.param("WH1", {"MUG": 2, "GHOST": 1}, errors.UnknownSku, id="unknown-sku"),
+    pytest.param("NOPE", {"MUG": 2}, errors.UnknownWarehouse, id="unknown-warehouse"),
+    pytest.param("WH1", {"MUG": 2, "TEE": 0}, errors.InvalidQuantity, id="zero-qty"),
+    pytest.param("WH1", {"MUG": 2, "TEE": True}, errors.InvalidQuantity, id="bool-qty"),
+    pytest.param("WH1", {}, errors.InventoryError, id="empty-items"),
+    pytest.param("WH1", {"CAP": 2}, errors.InsufficientStock, id="nothing-available"),
+]
+
+
+@pytest.mark.parametrize("warehouse, items, error", REJECTED)
+def test_c13_rejected_request_holds_nothing(stocked, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH2") == 10
+
+
+@pytest.mark.parametrize("warehouse, items, error", REJECTED)
+def test_c13_rejected_request_key_can_be_reused(stocked, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    r = stocked.reserve("WH2", {"MUG": 1}, "k1")
+    assert r.warehouse == "WH2"
+    assert r.items == {"MUG": 1}
+    assert r.status is models.ReservationStatus.ACTIVE
+
+
+# -- 14. unique ids ----------------------------------------------------------
+def test_c14_each_reservation_gets_a_unique_id(stocked):
+    ids = [
+        stocked.reserve("WH1", {"MUG": 1}, "a").reservation_id,
+        stocked.reserve("WH1", {"MUG": 1}, "b").reservation_id,
+        stocked.reserve("WH2", {"MUG": 1}, "c").reservation_id,
+        stocked.reserve("WH1", {"TEE": 1}, "d").reservation_id,
+    ]
+    assert len(set(ids)) == 4

@@ -0,0 +1,45 @@
+"""Interface section of SPEC.md: models, errors and service methods exist as named."""
+
+import dataclasses
+from datetime import datetime
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import InventoryService
+
+
+def test_reservation_status_has_exactly_the_four_members():
+    names = {m.name for m in models.ReservationStatus}
+    assert names == {"ACTIVE", "CONFIRMED", "RELEASED", "EXPIRED"}
+
+
+def test_reservation_is_a_dataclass_with_the_named_fields():
+    assert dataclasses.is_dataclass(models.Reservation)
+    fields = {f.name for f in dataclasses.fields(models.Reservation)}
+    assert {"reservation_id", "warehouse", "items", "status", "expires_at", "order_id"} <= fields
+
+
+def test_new_errors_subclass_inventory_error():
+    for name in (
+        "ReservationNotFound",
+        "ReservationExpired",
+        "InvalidReservationState",
+        "IdempotencyConflict",
+    ):
+        cls = getattr(errors, name)
+        assert issubclass(cls, errors.InventoryError), name
+
+
+def test_service_exposes_reservation_methods():
+    for name in ("reserve", "confirm_reservation", "release_reservation", "get_reservation"):
+        assert callable(getattr(InventoryService, name, None)), name
+
+
+def test_reserve_returns_reservation_with_field_types(stocked):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert isinstance(r, models.Reservation)
+    assert isinstance(r.reservation_id, str)
+    assert r.warehouse == "WH1"
+    assert isinstance(r.items, dict)
+    assert isinstance(r.status, models.ReservationStatus)
+    assert isinstance(r.expires_at, datetime)

+"""SPEC.md acceptance criterion 33: compatibility when no reservations exist."""
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from inventory import FixedClock, InventoryService, Ledger, OrderStatus
+from inventory.errors import InsufficientStock
+from inventory.reports import stock_report
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def test_c33_existing_suite_passes_unchanged():
+    result = subprocess.run(
+        [
+            sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider",
+            "tests", "--ignore=tests/acceptance",
+        ],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+def test_c33_three_argument_constructor_still_works(repo):
+    service = InventoryService(repo, Ledger(), FixedClock())
+    service.receive("MUG", "WH1", 5)
+    assert service.available("MUG", "WH1") == 5
+
+
+def test_c33_order_flow_without_reservations(stocked, repo, ledger):
+    order = stocked.place_order("WH1", {"MUG": 4})
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.allocated("MUG", "WH1") == 4
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 7})
+    stocked.ship_order(order.order_id)
+    assert stocked.on_hand("MUG", "WH1") == 6
+    assert stocked.available("MUG", "WH1") == 6
+    assert repo.get_order(order.order_id).status is OrderStatus.SHIPPED
+
+
+def test_c33_stock_report_without_reservations(stocked, repo):
+    stocked.place_order("WH1", {"TEE": 2})
+    rows = stock_report(repo, stocked, "WH1")
+    by_sku = {row.sku: row for row in rows}
+    assert [row.sku for row in rows] == ["CAP", "MUG", "TEE"]
+    assert (by_sku["MUG"].on_hand, by_sku["MUG"].allocated, by_sku["MUG"].available) == (10, 0, 10)
+    assert (by_sku["TEE"].on_hand, by_sku["TEE"].allocated, by_sku["TEE"].available) == (5, 2, 3)
+    assert (by_sku["CAP"].on_hand, by_sku["CAP"].allocated, by_sku["CAP"].available) == (0, 0, 0)

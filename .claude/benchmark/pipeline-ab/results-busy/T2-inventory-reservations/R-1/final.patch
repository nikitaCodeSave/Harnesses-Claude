@@ -69,3 +69,39 @@ class Adjustment:
     at: datetime
     ref: str | None = None
     note: str | None = None
+
+
+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A temporary hold on stock in one warehouse, pending confirm or release.
+
+    ``items`` are the units actually held per SKU, which can be fewer than
+    requested. An ACTIVE hold stops counting once the clock reaches
+    ``expires_at``; nothing needs to run for that to happen.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+
+    def is_held_at(self, now: datetime) -> bool:
+        return self.status is ReservationStatus.ACTIVE and now < self.expires_at
+
+
+@dataclass(frozen=True)
+class IdempotentRequest:
+    """What a successful ``reserve`` call asked for, remembered under its key."""
+
+    warehouse: str
+    requested: dict[str, int]
+    reservation_id: str

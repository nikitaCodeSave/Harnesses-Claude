@@ -0,0 +1,78 @@
+"""SPEC.md acceptance criteria 19-21: get_reservation and unknown ids."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+
+
+# -- 19. returns the reservation with its current status ---------------------
+def test_c19_returns_the_reservation(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.reservation_id == r.reservation_id
+    assert got.warehouse == "WH1"
+    assert got.items == {"MUG": 2, "TEE": 1}
+    assert got.status is models.ReservationStatus.ACTIVE
+    assert got.expires_at == clock.now() + timedelta(minutes=20)
+    assert got.order_id is None
+
+
+def test_c19_still_active_just_before_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.set(r.expires_at - timedelta(microseconds=1))
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.ACTIVE
+
+
+def test_c19_reported_expired_at_expires_at_without_a_sweep(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.set(r.expires_at)
+    assert stocked.get_reservation(r.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_c19_reported_expired_after_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.advance(hours=3)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.status is models.ReservationStatus.EXPIRED
+    assert got.order_id is None
+
+
+# -- 20. terminal reservations stay retrievable ------------------------------
+def test_c20_expired_is_retrievable(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    clock.advance(days=30)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.reservation_id == r.reservation_id
+    assert got.status is models.ReservationStatus.EXPIRED
+
+
+def test_c20_released_is_retrievable(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    clock.advance(days=30)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.reservation_id == r.reservation_id
+    assert got.status is models.ReservationStatus.RELEASED
+
+
+def test_c20_confirmed_is_retrievable(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    clock.advance(days=30)
+    got = stocked.get_reservation(r.reservation_id)
+    assert got.reservation_id == r.reservation_id
+    assert got.status is models.ReservationStatus.CONFIRMED
+    assert got.order_id == order.order_id
+
+
+# -- 21. unknown id -> ReservationNotFound -----------------------------------
+@pytest.mark.parametrize(
+    "method", ["get_reservation", "confirm_reservation", "release_reservation"]
+)
+def test_c21_unknown_id_raises_reservation_not_found(stocked, method):
+    stocked.reserve("WH1", {"MUG": 2}, "k1")
+    with pytest.raises(errors.ReservationNotFound):
+        getattr(stocked, method)("no-such-reservation")

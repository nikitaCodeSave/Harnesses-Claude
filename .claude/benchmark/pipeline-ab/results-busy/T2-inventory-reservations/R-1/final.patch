@@ -0,0 +1,131 @@
+"""SPEC.md acceptance criteria 1-5: availability with holds."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+
+DEFAULT_TTL = timedelta(minutes=20)
+
+
+# -- 1. available == max(0, on_hand - allocated - held) ----------------------
+def test_c1_available_subtracts_allocated_and_held(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    # on_hand 10, allocated 3, held 4
+    assert stocked.available("MUG", "WH1") == 3
+
+
+def test_c1_held_sums_over_all_active_reservations(stocked):
+    stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k2")
+    assert stocked.available("MUG", "WH1") == 5
+    assert stocked.available("TEE", "WH1") == 4
+
+
+def test_c1_holds_are_per_warehouse(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.available("MUG", "WH2") == 10
+
+
+def test_c1_available_is_floored_at_zero(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.adjust("MUG", "WH1", -5, "count")
+    # on_hand 5, held 10 -> max(0, -5)
+    assert stocked.available("MUG", "WH1") == 0
+
+
+# -- 2. allocated counts only PLACED orders ----------------------------------
+def test_c2_holds_never_appear_in_allocated(stocked):
+    stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.allocated("TEE", "WH1") == 0
+
+
+def test_c2_allocated_still_counts_placed_orders_alongside_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+# -- 3. on_hand untouched; no ledger writes ----------------------------------
+def test_c3_reserve_does_not_touch_on_hand_or_ledger(stocked, ledger):
+    before = len(ledger)
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert len(ledger) == before
+
+
+def test_c3_release_does_not_touch_on_hand_or_ledger(stocked, ledger):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    before = len(ledger)
+    stocked.release_reservation(r.reservation_id)
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert len(ledger) == before
+
+
+def test_c3_expiry_does_not_touch_on_hand_or_ledger(stocked, ledger, clock):
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    before = len(ledger)
+    clock.advance(DEFAULT_TTL + timedelta(minutes=1))
+    stocked.get_reservation(r.reservation_id)
+    stocked.release_reservation(r.reservation_id)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert len(ledger) == before
+
+
+# -- 4. held units can't be taken by place_order or another reserve ----------
+def test_c4_place_order_cannot_take_held_units(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3})
+    assert stocked.place_order("WH1", {"MUG": 2}).quantity_of("MUG") == 2
+
+
+def test_c4_second_reserve_only_gets_what_is_left(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 5}, "k2")
+    assert second.items == {"MUG": 2}
+
+
+def test_c4_second_reserve_fails_when_everything_is_held(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    with pytest.raises(errors.InsufficientStock):
+        stocked.reserve("WH1", {"MUG": 1}, "k2")
+
+
+# -- 5. released / expired holds stop counting immediately -------------------
+def test_c5_release_frees_units_immediately(stocked):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    assert stocked.available("MUG", "WH1") == 10
+    stocked.place_order("WH1", {"MUG": 10})
+
+
+def test_c5_hold_still_counts_just_before_expires_at(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(r.expires_at - timedelta(microseconds=1))
+    assert stocked.available("MUG", "WH1") == 4
+
+
+def test_c5_expiry_frees_units_at_expires_at_without_any_other_call(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(r.expires_at)
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c5_expired_units_can_be_ordered_without_any_other_call(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    clock.set(r.expires_at)
+    order = stocked.place_order("WH1", {"MUG": 10})
+    assert order.quantity_of("MUG") == 10
+
+
+def test_c5_expired_units_can_be_reserved_again_without_any_other_call(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.set(r.expires_at)
+    again = stocked.reserve("WH1", {"MUG": 10}, "k2")
+    assert again.items == {"MUG": 10}

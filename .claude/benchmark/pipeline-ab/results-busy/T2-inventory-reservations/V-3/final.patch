+def test_retry_returns_reservation_in_current_state(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    clock.advance(TTL)
+    again = stocked.reserve("WH1", {"MUG": 2}, "cart-1")
+    assert (again.reservation_id, again.status) == (res.reservation_id, ReservationStatus.EXPIRED)
+    assert stocked.available("MUG", "WH1") == 10

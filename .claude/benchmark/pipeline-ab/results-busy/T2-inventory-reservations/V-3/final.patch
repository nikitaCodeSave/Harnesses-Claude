+def test_confirmed_order_ships_and_cancels_like_any_order(stocked):
+    order = stocked.confirm_reservation(stocked.reserve("WH1", {"MUG": 3}, "a").reservation_id)
+    stocked.ship_order(order.order_id)
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (7, 7)
+    other = stocked.confirm_reservation(stocked.reserve("WH1", {"TEE": 2}, "b").reservation_id)
+    stocked.cancel_order(other.order_id)
+    assert stocked.available("TEE", "WH1") == 5

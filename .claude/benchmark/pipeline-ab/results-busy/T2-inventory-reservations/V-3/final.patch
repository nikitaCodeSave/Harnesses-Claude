+++ b/tests/test_reservations.py
@@ -0,0 +1,224 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderLine, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+)
+from inventory.reports import StockRow, stock_report
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+# -- reserve -------------------------------------------------------------
+def test_reserve_holds_stock_and_reduces_available(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    assert (res.status, res.items, res.order_id) == (ReservationStatus.ACTIVE, {"MUG": 4}, None)
+    assert res.expires_at == clock.now() + TTL
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (10, 6)
+    assert stocked.held("MUG", "WH1") == 4
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+def test_hold_blocks_orders(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "cart-1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 1})
+
+
+def test_reserve_holds_partial_lines_and_drops_empty_ones(stocked):
+    stocked.reserve("WH1", {"TEE": 3}, "cart-1")
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 4, "CAP": 1}, "cart-2")
+    assert res.items == {"MUG": 2, "TEE": 2}
+    assert stocked.available("TEE", "WH1") == 0
+
+
+def test_reserve_with_nothing_available_creates_nothing(stocked, repo):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "cart-1")
+    assert repo.reservations() == []
+    # The key was not consumed: a retry once stock arrives succeeds.
+    stocked.receive("CAP", "WH1", 1)
+    assert stocked.reserve("WH1", {"CAP": 2}, "cart-1").items == {"CAP": 1}
+
+
+def test_reservation_ids_are_sequential(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1}, "a")
+    second = stocked.reserve("WH1", {"MUG": 1}, "b")
+    assert (first.reservation_id, second.reservation_id) == ("RES-0001", "RES-0002")
+
+
+@pytest.mark.parametrize(
+    "items, error",
+    [({}, InvalidOrder), ({"MUG": 0}, InvalidQuantity), ({"NOPE": 1}, UnknownSku)],
+)
+def test_reserve_validates_request(stocked, items, error):

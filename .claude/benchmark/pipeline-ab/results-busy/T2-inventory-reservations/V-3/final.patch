+def test_release_is_a_no_op_on_released_and_expired_holds(stocked, clock):
+    released = stocked.reserve("WH1", {"MUG": 1}, "a")
+    stocked.release_reservation(released.reservation_id)
+    assert stocked.release_reservation(released.reservation_id).status is ReservationStatus.RELEASED
+    expired = stocked.reserve("WH1", {"MUG": 1}, "b")
+    clock.advance(TTL)
+    assert stocked.release_reservation(expired.reservation_id).status is ReservationStatus.EXPIRED
+

+def test_expired_hold_cannot_be_confirmed(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)

+def test_retry_with_same_key_returns_same_reservation(stocked):
+    first = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "cart-1")
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "cart-1")

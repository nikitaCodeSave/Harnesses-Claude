+# -- confirm -------------------------------------------------------------
+def test_confirm_places_order_for_held_units_without_changing_available(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 8}, "cart-1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert (order.warehouse, order.placed_at) == ("WH1", clock.now())
+    assert set(order.lines) == {OrderLine("MUG", 3), OrderLine("TEE", 5)}
+    assert (stocked.available("MUG", "WH1"), stocked.available("TEE", "WH1")) == (7, 0)
+    assert (stocked.held("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (0, 3)
+    assert stocked.on_hand("MUG", "WH1") == 10
+    res = stocked.get_reservation(res.reservation_id)
+    assert (res.status, res.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+
+
+def test_confirmed_order_survives_the_hold_expiry(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    stocked.confirm_reservation(res.reservation_id)
+    clock.advance(TTL * 2)
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.CONFIRMED
+

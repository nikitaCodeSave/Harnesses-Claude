+)
+def test_reserve_validates_input_like_place_order(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+
+
+def test_active_hold_lowers_available(stocked):

+            return reservation
+        if reservation.status is not ReservationStatus.ACTIVE:
+            raise InvalidReservationState(reservation_id, reservation.status, "release")
+        reservation.status = ReservationStatus.RELEASED
+        self._repo.save_reservation(reservation)
+        return reservation
+
     # -- helpers ---------------------------------------------------------
+    def _held(self, sku: str, warehouse: str) -> int:
+        now = self._clock.now()
+        return sum(
+            reservation.items.get(sku, 0)
+            for reservation in self._repo.reservations(
+                warehouse=warehouse, status=ReservationStatus.ACTIVE
+            )
+            if now < reservation.expires_at
+        )
+
+    def _settle_expiry(self, reservation: Reservation, now: datetime) -> None:
+        """Record EXPIRED on an ACTIVE reservation whose time is up. EXPIRED is final."""
+        if reservation.status is ReservationStatus.ACTIVE and now >= reservation.expires_at:
+            reservation.status = ReservationStatus.EXPIRED
+            self._repo.save_reservation(reservation)
+
     def _check_location(self, sku: str, warehouse: str) -> None:
         self._repo.get_warehouse(warehouse)
         self._repo.get_product(sku)

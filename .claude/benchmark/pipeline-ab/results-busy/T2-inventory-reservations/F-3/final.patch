+        expected = ReservationStatus.EXPIRED
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert (again.reservation_id, again.status) == ("RSV-0001", expected)
+    assert again.expires_at == r.expires_at

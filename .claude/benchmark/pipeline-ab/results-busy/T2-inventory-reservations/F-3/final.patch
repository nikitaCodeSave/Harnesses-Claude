+from datetime import timedelta
+
+import pytest
+
+from inventory import (
+    InventoryService,
+    OrderStatus,
+    Reservation,
+    ReservationStatus,
+)
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+from inventory.reports import StockRow, stock_report
+
+HOLD = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 7)
+    return service
+
+
+def avail(service, sku="MUG", warehouse="WH1"):
+    return service.available(sku, warehouse)
+
+
+# -- reserve -------------------------------------------------------------
+
+
+def test_reserve_returns_active_hold_expiring_after_default_duration(stocked, clock):
+    r = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert isinstance(r, Reservation)
+    assert r.status is ReservationStatus.ACTIVE
+    assert r.order_id is None
+    assert r.warehouse == "WH1"
+    assert r.items == {"MUG": 3}
+    assert r.expires_at == clock.now() + HOLD
+
+
+def test_hold_duration_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, hold_duration=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    r = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert r.expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_reservation_ids_are_sequential_and_separate_from_orders(stocked):
+    stocked.place_order("WH1", {"MUG": 1})
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    order = stocked.place_order("WH1", {"MUG": 1})
+    assert (first.reservation_id, second.reservation_id) == ("RSV-0001", "RSV-0002")
+    assert order.order_id == "ORD-0002"
+
+
+def test_each_line_holds_what_is_available(stocked):
+    stocked.place_order("WH1", {"TEE": 3})
+    r = stocked.reserve("WH1", {"MUG": 4, "TEE": 5}, "k1")
+    assert r.items == {"MUG": 4, "TEE": 2}
+
+
+def test_line_with_nothing_available_is_left_out(stocked):
+    r = stocked.reserve("WH1", {"CAP": 2, "MUG": 1}, "k1")
+    assert r.items == {"MUG": 1}
+
+
+def test_lost_holds_are_excluded_from_available_when_reserving(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    r = stocked.reserve("WH1", {"MUG": 5}, "k2")
+    assert r.items == {"MUG": 2}
+
+
+def test_reserve_with_nothing_available_raises_and_creates_nothing(stocked, repo):
+    with pytest.raises(InsufficientStock) as exc:
+        stocked.reserve("WH2", {"TEE": 3, "CAP": 2}, "k1")
+    assert (exc.value.sku, exc.value.warehouse, exc.value.requested, exc.value.available) == (
+        "TEE", "WH2", 3, 0,
+    )
+    assert repo.reservations() == []
+    assert stocked.reserve("WH1", {"MUG": 1}, "k2").reservation_id == "RSV-0001"
+
+
+def test_partial_hold_is_not_an_error(stocked):
+    r = stocked.reserve("WH1", {"MUG": 50}, "k1")
+    assert r.items == {"MUG": 10}
+    assert r.status is ReservationStatus.ACTIVE
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",

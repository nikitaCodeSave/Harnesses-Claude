@@ -0,0 +1,106 @@
+"""SPEC criteria 33-35 plus the fixed interface."""
+
+import dataclasses
+import re
+import subprocess
+import sys
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+
+from inventory import FixedClock, InventoryService, models
+from inventory.errors import InventoryError
+
+from acc_helpers import error, status
+
+ROOT = Path(__file__).resolve().parents[2]
+PACKAGE = ROOT / "src" / "inventory"
+
+
+# -- interface: models ------------------------------------------------------
+
+def test_reservation_is_dataclass_with_spec_fields():
+    assert dataclasses.is_dataclass(models.Reservation)
+    names = {f.name for f in dataclasses.fields(models.Reservation)}
+    assert {"reservation_id", "warehouse", "items", "status", "expires_at", "order_id"} <= names
+
+
+def test_reservation_status_members():
+    names = {m.name for m in models.ReservationStatus}
+    assert names == {"ACTIVE", "CONFIRMED", "RELEASED", "EXPIRED"}
+
+
+def test_default_hold_lifetime_is_20_minutes(repo, ledger, clock, t0):
+    service = InventoryService(repo, ledger, clock)
+    service.receive("MUG", "WH1", 1)
+    assert service.reserve("WH1", {"MUG": 1}, "k1").expires_at == t0 + timedelta(minutes=20)
+
+
+# -- 33. new errors subclass InventoryError --------------------------------
+
+@pytest.mark.parametrize(
+    "name",
+    ["ReservationNotFound", "ReservationExpired", "InvalidReservationState", "IdempotencyConflict"],
+)
+def test_c33_new_errors_subclass_inventory_error(name):
+    assert issubclass(error(name), InventoryError)
+
+
+# -- 34. only the injected clock is used -----------------------------------
+
+@pytest.mark.parametrize(
+    "start",
+    [
+        datetime(2000, 1, 1, tzinfo=timezone.utc),
+        datetime(2100, 1, 1, tzinfo=timezone.utc),
+    ],
+)
+def test_c34_expiry_follows_injected_clock_not_wall_clock(repo, ledger, start):
+    clock = FixedClock(start)
+    service = InventoryService(repo, ledger, clock)
+    service.receive("MUG", "WH1", 5)
+    res = service.reserve("WH1", {"MUG": 2}, "k1")
+    assert res.expires_at == start + timedelta(minutes=20)
+    assert service.get_reservation(res.reservation_id).status is status("ACTIVE")
+    assert service.available("MUG", "WH1") == 3
+    clock.advance(minutes=19)
+    order = service.confirm_reservation(res.reservation_id)
+    assert order.placed_at == start + timedelta(minutes=19)
+
+
+def test_c34_expiry_happens_on_injected_clock_far_in_past(repo, ledger):
+    start = datetime(2000, 1, 1, tzinfo=timezone.utc)
+    clock = FixedClock(start)
+    service = InventoryService(repo, ledger, clock)
+    service.receive("MUG", "WH1", 5)
+    res = service.reserve("WH1", {"MUG": 2}, "k1")
+    clock.advance(minutes=20)
+    assert service.get_reservation(res.reservation_id).status is status("EXPIRED")
+    assert service.available("MUG", "WH1") == 5
+
+
+WALL_CLOCK = re.compile(
+    r"\b(datetime\.now|datetime\.utcnow|datetime\.today|date\.today|"
+    r"time\.time|time\.monotonic|time\.perf_counter|time\.time_ns|time\.localtime|time\.gmtime)\s*\("
+)
+
+
+def test_c34_no_package_code_reads_wall_clock():
+    offenders = []
+    for path in sorted(PACKAGE.rglob("*.py")):
+        for lineno, line in enumerate(path.read_text().splitlines(), 1):
+            if WALL_CLOCK.search(line.split("#", 1)[0]):
+                offenders.append(f"{path.relative_to(ROOT)}:{lineno}: {line.strip()}")
+    assert offenders == []
+
+
+# -- 35. existing suite keeps passing --------------------------------------
+
+def test_c35_existing_suite_still_passes():
+    result = subprocess.run(
+        [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider",
+         "--ignore=tests/acceptance", "tests"],
+        cwd=ROOT, capture_output=True, text=True,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
diff --git a/tests/acceptance/test_acc_idempotency.py b/tests/acceptance/test_acc_idempotency.py
new file mode 100644
index 0000000..19ccbb7
--- /dev/null
+++ b/tests/acceptance/test_acc_idempotency.py
@@ -0,0 +1,196 @@
+"""SPEC criteria 14-18: idempotency keys."""
+
+import pytest
+
+from inventory.errors import (
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+from acc_helpers import HOLD, error, status
+
+
+# -- 14. keys are unique across the whole service --------------------------
+
+def test_c14_key_reused_in_other_warehouse_conflicts(stocked):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(error("IdempotencyConflict")):
+        stocked.reserve("WH2", {"MUG": 1}, "k1")
+    assert stocked.available("MUG", "WH2") == 10
+
+
+# -- 15. replay with same request returns the existing reservation ---------
+
+def test_c15_replay_returns_same_reservation(stocked):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.status is status("ACTIVE")
+    assert again.items == {"MUG": 3}
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c15_replay_creates_no_new_reservation(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    nxt = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert nxt.reservation_id == "RES-0002"
+    with pytest.raises(error("ReservationNotFound")):
+        stocked.get_reservation("RES-0003")
+
+
+def test_c15_replay_does_not_refill_after_new_stock(stocked):
+    first = stocked.reserve("WH1", {"MUG": 12}, "k1")
+    assert first.items == {"MUG": 10}
+    stocked.receive("MUG", "WH1", 5)
+    again = stocked.reserve("WH1", {"MUG": 12}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 5
+
+
+def test_c15_replay_does_not_change_expires_at(stocked, clock, t0):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(minutes=5)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert again.expires_at == t0 + HOLD
+
+
+def test_c15_items_compared_regardless_of_key_order(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1, "TEE": 2}, "k1")
+    again = stocked.reserve("WH1", {"TEE": 2, "MUG": 1}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert stocked.available("MUG", "WH1") == 9
+    assert stocked.available("TEE", "WH1") == 3
+
+
+def test_c15_items_compared_against_original_request_not_held(stocked):
+    first = stocked.reserve("WH1", {"MUG": 12, "CAP": 2}, "k1")
+    assert first.items == {"MUG": 10}
+    again = stocked.reserve("WH1", {"MUG": 12, "CAP": 2}, "k1")
+    assert again.reservation_id == first.reservation_id
+    with pytest.raises(error("IdempotencyConflict")):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_c15_replay_returns_confirmed_reservation(stocked):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(first.reservation_id)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.status is status("CONFIRMED")
+    assert again.order_id == order.order_id
+    assert stocked.allocated("MUG", "WH1") == 3
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c15_replay_returns_released_reservation_without_holding(stocked):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(first.reservation_id)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.status is status("RELEASED")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c15_replay_returns_expired_reservation_without_holding(stocked, clock, t0):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(HOLD)
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert again.status is status("EXPIRED")
+    assert again.expires_at == t0 + HOLD
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 16. reuse with different request -> IdempotencyConflict, no change ----
+
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [
+        ("WH2", {"MUG": 3}),
+        ("WH1", {"MUG": 4}),
+        ("WH1", {"MUG": 3, "TEE": 1}),
+        ("WH1", {"TEE": 3}),
+    ],
+)
+def test_c16_conflicting_reuse_raises_and_changes_nothing(stocked, t0, warehouse, items):
+    first = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    with pytest.raises(error("IdempotencyConflict")):
+        stocked.reserve(warehouse, items, "k1")
+    current = stocked.get_reservation(first.reservation_id)
+    assert current.status is status("ACTIVE")
+    assert current.items == {"MUG": 3}
+    assert current.expires_at == t0 + HOLD
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH2") == 10
+    with pytest.raises(error("ReservationNotFound")):
+        stocked.get_reservation("RES-0002")
+
+
+def test_c16_conflict_when_subset_of_original_lines(stocked):
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 1}, "k1")
+    with pytest.raises(error("IdempotencyConflict")):
+        stocked.reserve("WH1", {"MUG": 3}, "k1")
+
+
+# -- 17. validation runs before the key check ------------------------------
+
+@pytest.mark.parametrize(
+    "warehouse, items, exc",
+    [
+        ("NOPE", {"MUG": 3}, UnknownWarehouse),
+        ("WH1", {"NOPE": 3}, UnknownSku),
+        ("WH1", {"MUG": 0}, InvalidQuantity),
+        ("WH1", {"MUG": True}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_c17_invalid_request_with_recorded_key_raises_validation_error(
+    stocked, warehouse, items, exc
+):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    with pytest.raises(exc):
+        stocked.reserve(warehouse, items, "k1")
+    assert stocked.available("MUG", "WH1") == 7
+
+
+# -- 18. failed calls do not record their key ------------------------------
+
+@pytest.mark.parametrize(
+    "warehouse, items, exc",
+    [
+        ("NOPE", {"MUG": 3}, UnknownWarehouse),
+        ("WH1", {"NOPE": 3}, UnknownSku),
+        ("WH1", {"MUG": -1}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_c18_validation_failure_does_not_record_key(stocked, warehouse, items, exc):
+    with pytest.raises(exc):
+        stocked.reserve(warehouse, items, "k1")
+    res = stocked.reserve("WH1", {"TEE": 2}, "k1")
+    assert res.reservation_id == "RES-0001"
+    assert res.items == {"TEE": 2}
+    assert res.status is status("ACTIVE")
+
+
+def test_c18_insufficient_stock_does_not_record_key(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    stocked.receive("CAP", "WH1", 3)
+    res = stocked.reserve("WH1", {"CAP": 2}, "k1")
+    assert res.reservation_id == "RES-0001"
+    assert res.items == {"CAP": 2}
+    assert stocked.available("CAP", "WH1") == 1
+
+
+def test_c18_after_insufficient_stock_key_accepts_different_request(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    res = stocked.reserve("WH2", {"MUG": 1}, "k1")
+    assert (res.warehouse, res.items) == ("WH2", {"MUG": 1})
diff --git a/tests/acceptance/test_acc_lookup.py b/tests/acceptance/test_acc_lookup.py

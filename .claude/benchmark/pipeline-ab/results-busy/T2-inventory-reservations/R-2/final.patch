+"""SPEC criteria 1-6: availability with holds."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory.errors import InsufficientStock
+from inventory.reports import StockRow, stock_report
+
+from acc_helpers import HOLD
+
+
+# -- 1. available = on_hand - allocated - held, floored at 0 ---------------
+
+def test_c1_available_subtracts_held_units(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c1_available_subtracts_allocated_and_held(stocked):
+    stocked.place_order("WH1", {"MUG": 4})
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert stocked.available("MUG", "WH1") == 10 - 4 - 3
+
+
+def test_c1_holds_only_affect_their_own_sku_and_warehouse(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH2") == 10
+
+
+def test_c1_available_is_floored_at_zero(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.adjust("MUG", "WH1", -4, note="write-off")
+    assert stocked.on_hand("MUG", "WH1") == 6
+    assert stocked.available("MUG", "WH1") == 0
+
+
+# -- 2. allocated counts only PLACED orders --------------------------------
+
+def test_c2_allocated_excludes_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+def test_c2_allocated_counts_placed_orders_alongside_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 4})
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 4
+
+
+# -- 3. held units are unavailable to other reservations and place_order ---
+
+def test_c3_held_units_unavailable_to_other_reservations(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 5}, "k2")
+    assert second.items == {"MUG": 2}
+
+
+def test_c3_held_units_unavailable_to_place_order(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3})
+    order = stocked.place_order("WH1", {"MUG": 2})
+    assert order.quantity_of("MUG") == 2
+
+
+# -- 4. expiry frees units at expires_at with no further call ---------------
+
+def test_c4_units_still_held_just_before_expiry(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(HOLD - timedelta(seconds=1))
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_c4_units_freed_exactly_at_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at)
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c4_units_freed_after_expires_at(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(minutes=45)
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c4_expired_units_can_be_taken_by_place_order(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.advance(HOLD)
+    order = stocked.place_order("WH1", {"MUG": 10})
+    assert order.quantity_of("MUG") == 10
+
+
+def test_c4_expired_units_can_be_taken_by_new_reservation(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.advance(HOLD)
+    second = stocked.reserve("WH1", {"MUG": 10}, "k2")
+    assert second.items == {"MUG": 10}
+
+
+# -- 5. release frees units immediately ------------------------------------
+
+def test_c5_release_frees_units_immediately(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 5}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+
+
+# -- 6. stock_report keeps its shape; available follows criterion 1 --------
+
+def test_c6_stock_report_shape_and_available(stocked, repo):
+    stocked.place_order("WH1", {"TEE": 1})
+    stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    assert stock_report(repo, stocked, "WH1") == [
+        StockRow("CAP", 0, 0, 0),
+        StockRow("MUG", 10, 0, 7),
+        StockRow("TEE", 5, 1, 2),
+    ]
+
+
+def test_c6_stock_report_available_floored_at_zero(stocked, repo):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    stocked.adjust("TEE", "WH1", -2, note="write-off")
+    rows = {row.sku: row for row in stock_report(repo, stocked, "WH1")}
+    assert rows["TEE"] == StockRow("TEE", 3, 0, 0)

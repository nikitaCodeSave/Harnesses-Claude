 from __future__ import annotations
 
-from dataclasses import dataclass
+from dataclasses import dataclass, field
 from datetime import datetime
 from enum import Enum
 
@@ -69,3 +69,35 @@ class Adjustment:
     at: datetime
     ref: str | None = None
     note: str | None = None
+
+
+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A time-limited hold on stock in a single warehouse.
+
+    While ACTIVE and before ``expires_at`` its units are unavailable to other
+    reservations and orders. ``items`` records what was actually held, which
+    may be less than was requested.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+    requested: dict[str, int] = field(default_factory=dict, repr=False)
+    idempotency_key: str | None = None
+
+    def is_expired(self, now: datetime) -> bool:
+        return self.status is ReservationStatus.ACTIVE and now >= self.expires_at
+
+    def holds(self, now: datetime) -> bool:
+        return self.status is ReservationStatus.ACTIVE and now < self.expires_at

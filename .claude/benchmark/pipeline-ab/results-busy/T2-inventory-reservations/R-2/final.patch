@@ -0,0 +1,72 @@
+"""SPEC criteria 26-29: release_reservation."""
+
+import pytest
+
+from inventory import OrderStatus
+
+from acc_helpers import HOLD, error, status
+
+
+# -- 26. releasing an ACTIVE reservation -----------------------------------
+
+def test_c26_release_active_returns_released(stocked, t0):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.reservation_id == res.reservation_id
+    assert released.status is status("RELEASED")
+    assert released.order_id is None
+    assert released.expires_at == t0 + HOLD
+    assert stocked.get_reservation(res.reservation_id).status is status("RELEASED")
+
+
+# -- 27. releasing a RELEASED reservation is a no-op -----------------------
+
+def test_c27_release_twice_is_noop(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    again = stocked.release_reservation(res.reservation_id)
+    assert again.reservation_id == res.reservation_id
+    assert again.status is status("RELEASED")
+    assert again.items == {"MUG": 3}
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c27_released_stays_released_after_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    clock.advance(HOLD)
+    again = stocked.release_reservation(res.reservation_id)
+    assert again.status is status("RELEASED")
+    assert stocked.get_reservation(res.reservation_id).status is status("RELEASED")
+
+
+# -- 28. releasing an expired reservation ----------------------------------
+
+def test_c28_release_expired_returns_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(minutes=25)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.reservation_id == res.reservation_id
+    assert released.status is status("EXPIRED")
+    assert stocked.get_reservation(res.reservation_id).status is status("EXPIRED")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c28_release_exactly_at_expires_at_returns_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(res.expires_at)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is status("EXPIRED")
+
+
+# -- 29. releasing a CONFIRMED reservation ---------------------------------
+
+def test_c29_release_confirmed_raises(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(error("InvalidReservationState")):
+        stocked.release_reservation(res.reservation_id)
+    assert stocked.get_reservation(res.reservation_id).status is status("CONFIRMED")
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+    assert stocked.allocated("MUG", "WH1") == 3
+    assert stocked.available("MUG", "WH1") == 7

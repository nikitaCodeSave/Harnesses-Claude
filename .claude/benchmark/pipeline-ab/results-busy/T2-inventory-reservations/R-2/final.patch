@@ -0,0 +1,75 @@
+"""SPEC criteria 30-32: get_reservation and status reporting."""
+
+from datetime import timedelta
+
+import pytest
+
+from acc_helpers import HOLD, error, status
+
+
+# -- 30. get_reservation reports current status ----------------------------
+
+def test_c30_get_reservation_returns_reservation(stocked, t0):
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 1}, "k1")
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.reservation_id == res.reservation_id
+    assert got.warehouse == "WH1"
+    assert got.items == {"MUG": 10, "TEE": 1}
+    assert got.status is status("ACTIVE")
+    assert got.expires_at == t0 + HOLD
+    assert got.order_id is None
+
+
+def test_c30_active_just_before_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(HOLD - timedelta(seconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is status("ACTIVE")
+
+
+def test_c30_expired_at_expires_at_without_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.set(res.expires_at)
+    assert stocked.get_reservation(res.reservation_id).status is status("EXPIRED")
+
+
+def test_c30_expired_long_after_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(days=3)
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.status is status("EXPIRED")
+    assert got.order_id is None
+
+
+# -- 31. reserve / release / get report expiry as of current clock ---------
+
+def test_c31_reserve_replay_reports_expired(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(HOLD)
+    assert stocked.reserve("WH1", {"MUG": 1}, "k1").status is status("EXPIRED")
+
+
+def test_c31_release_reports_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(HOLD)
+    assert stocked.release_reservation(res.reservation_id).status is status("EXPIRED")
+
+
+def test_c31_only_unexpired_holds_reported_expired_independently(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(minutes=10)
+    second = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    clock.advance(minutes=10)  # first is at its expires_at, second has 10 min left
+    assert stocked.get_reservation(first.reservation_id).status is status("EXPIRED")
+    assert stocked.get_reservation(second.reservation_id).status is status("ACTIVE")
+    assert stocked.available("MUG", "WH1") == 9
+
+
+# -- 32. unknown reservation id --------------------------------------------
+
+@pytest.mark.parametrize(
+    "method", ["get_reservation", "confirm_reservation", "release_reservation"]
+)
+def test_c32_unknown_reservation_id(stocked, method):
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(error("ReservationNotFound")):
+        getattr(stocked, method)("RES-9999")

@@ -0,0 +1,147 @@
+"""SPEC criteria 7-13: reserve."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import models
+from inventory.errors import (
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+from acc_helpers import HOLD, error, status
+
+
+def assert_nothing_held(service):
+    assert service.available("MUG", "WH1") == 10
+    assert service.available("TEE", "WH1") == 5
+    assert service.available("MUG", "WH2") == 10
+    with pytest.raises(error("ReservationNotFound")):
+        service.get_reservation("RES-0001")
+
+
+# -- 7. validation matches place_order, whole request rejected --------------
+
+def test_c7_unknown_warehouse(stocked):
+    with pytest.raises(UnknownWarehouse):
+        stocked.reserve("NOPE", {"MUG": 1}, "k1")
+    assert_nothing_held(stocked)
+
+
+def test_c7_unknown_sku_rejects_whole_request(stocked):
+    with pytest.raises(UnknownSku):
+        stocked.reserve("WH1", {"MUG": 1, "NOPE": 1}, "k1")
+    assert_nothing_held(stocked)
+
+
+@pytest.mark.parametrize("bad", [0, -1, 1.5, "2", None, True, False])
+def test_c7_invalid_quantity_rejects_whole_request(stocked, bad):
+    with pytest.raises(InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": 1, "TEE": bad}, "k1")
+    assert_nothing_held(stocked)
+
+
+def test_c7_empty_items(stocked):
+    with pytest.raises(InvalidOrder):
+        stocked.reserve("WH1", {}, "k1")
+    assert_nothing_held(stocked)
+
+
+def test_c7_validation_runs_even_when_valid_lines_could_be_held(stocked):
+    with pytest.raises(UnknownSku):
+        stocked.reserve("WH1", {"MUG": 2, "TEE": 2, "NOPE": 1}, "k1")
+    assert_nothing_held(stocked)
+
+
+# -- 8. partial fill, line by line -----------------------------------------
+
+def test_c8_each_line_holds_min_of_requested_and_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 12, "TEE": 3}, "k1")
+    assert res.items == {"MUG": 10, "TEE": 3}
+    assert stocked.available("MUG", "WH1") == 0
+    assert stocked.available("TEE", "WH1") == 2
+
+
+def test_c8_partial_fill_accounts_for_existing_orders_and_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    res = stocked.reserve("WH1", {"MUG": 5, "TEE": 1}, "k2")
+    assert res.items == {"MUG": 3, "TEE": 1}
+
+
+# -- 9. lines that hold nothing are omitted --------------------------------
+
+def test_c9_line_with_nothing_available_is_omitted(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2, "CAP": 3}, "k1")
+    assert res.items == {"MUG": 2}
+    assert "CAP" not in res.items
+
+
+def test_c9_line_fully_taken_by_other_hold_is_omitted(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    res = stocked.reserve("WH1", {"MUG": 1, "TEE": 1}, "k2")
+    assert res.items == {"MUG": 1}
+
+
+# -- 10. nothing holdable -> InsufficientStock, nothing created ------------
+
+def test_c10_nothing_holdable_raises_and_creates_nothing(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert_nothing_held(stocked)
+
+
+def test_c10_nothing_holdable_because_of_other_holds(stocked):
+    first = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"TEE": 1, "CAP": 1}, "k2")
+    with pytest.raises(error("ReservationNotFound")):
+        stocked.get_reservation("RES-0002")
+    assert stocked.get_reservation(first.reservation_id).items == {"TEE": 5}
+
+
+# -- 11. new reservation fields --------------------------------------------
+
+def test_c11_new_reservation_fields(stocked, t0):
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    assert isinstance(res, models.Reservation)
+    assert res.status is status("ACTIVE")
+    assert res.order_id is None
+    assert res.warehouse == "WH1"
+    assert res.items == {"MUG": 2, "TEE": 1}
+    assert res.expires_at == t0 + timedelta(minutes=20)
+
+
+def test_c11_expires_at_uses_clock_time_of_reserve(stocked, clock):
+    clock.advance(minutes=7)
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + HOLD
+
+
+def test_c11_reserve_in_second_warehouse(stocked):
+    res = stocked.reserve("WH2", {"MUG": 4}, "k1")
+    assert (res.warehouse, res.items) == ("WH2", {"MUG": 4})
+    assert stocked.available("MUG", "WH2") == 6
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- 12. sequential IDs ----------------------------------------------------
+
+def test_c12_reservation_ids_are_sequential(stocked):
+    ids = [stocked.reserve("WH1", {"MUG": 1}, f"k{i}").reservation_id for i in range(3)]
+    assert ids == ["RES-0001", "RES-0002", "RES-0003"]
+
+
+# -- 13. place_order stays all or nothing ----------------------------------
+
+def test_c13_place_order_is_still_all_or_nothing_with_holds(stocked, repo):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2, "MUG": 3})
+    assert repo.orders() == []
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH1") == 2

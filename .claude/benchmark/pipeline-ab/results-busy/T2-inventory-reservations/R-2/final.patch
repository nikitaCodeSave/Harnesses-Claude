+"""SPEC criteria 19-25: confirm_reservation."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import Order, OrderStatus
+
+from acc_helpers import HOLD, error, status
+
+
+def lines_of(order):
+    return {line.sku: line.quantity for line in order.lines}
+
+
+# -- 19. confirm creates a PLACED order with exactly the held items --------
+
+def test_c19_confirm_creates_placed_order(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert isinstance(order, Order)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert lines_of(order) == {"MUG": 3, "TEE": 2}
+    assert len(order.lines) == 2
+    assert order.placed_at == clock.now()
+
+
+def test_c19_order_uses_held_items_not_requested(stocked):
+    res = stocked.reserve("WH1", {"MUG": 12, "CAP": 1}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert lines_of(order) == {"MUG": 10}
+    assert len(order.lines) == 1
+
+
+def test_c19_order_id_from_normal_sequence(stocked):
+    stocked.place_order("WH1", {"TEE": 1})
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.order_id == "ORD-0002"
+    assert stocked.place_order("WH1", {"TEE": 1}).order_id == "ORD-0003"
+
+
+def test_c19_first_order_id(stocked):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert stocked.confirm_reservation(res.reservation_id).order_id == "ORD-0001"
+
+
+def test_c19_reservation_becomes_confirmed_with_order_id(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    current = stocked.get_reservation(res.reservation_id)
+    assert current.status is status("CONFIRMED")
+    assert current.order_id == order.order_id
+
+
+def test_c19_confirm_in_second_warehouse(stocked):
+    res = stocked.reserve("WH2", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.warehouse == "WH2"
+    assert stocked.allocated("MUG", "WH2") == 4
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+# -- 20. held units become allocated; available unchanged ------------------
+
+def test_c20_confirm_moves_units_from_held_to_allocated(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert (stocked.allocated("MUG", "WH1"), stocked.available("MUG", "WH1")) == (0, 7)
+    stocked.confirm_reservation(res.reservation_id)
+    assert (stocked.allocated("MUG", "WH1"), stocked.available("MUG", "WH1")) == (3, 7)
+
+
+def test_c20_confirmed_units_not_freed_when_expires_at_passes(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    clock.advance(minutes=60)
+    assert stocked.allocated("MUG", "WH1") == 3
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.get_reservation(res.reservation_id).status is status("CONFIRMED")
+
+
+# -- 21. confirm succeeds even after a write-off ---------------------------
+
+def test_c21_confirm_succeeds_after_writeoff(stocked):
+    res = stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.adjust("MUG", "WH1", -6, note="write-off")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert lines_of(order) == {"MUG": 10}
+    assert stocked.allocated("MUG", "WH1") == 10
+    assert stocked.available("MUG", "WH1") == 0
+
+
+# -- 22. confirming a CONFIRMED reservation is idempotent ------------------
+
+def test_c22_confirm_twice_returns_same_order(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    second = stocked.confirm_reservation(res.reservation_id)
+    assert second.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+def test_c22_confirm_again_after_expires_at_returns_same_order(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(minutes=30)
+    second = stocked.confirm_reservation(res.reservation_id)
+    assert second.order_id == first.order_id
+    assert stocked.place_order("WH1", {"TEE": 1}).order_id == "ORD-0002"
+
+
+# -- 23. confirming an expired reservation ---------------------------------
+
+def test_c23_confirm_exactly_at_expires_at_raises(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.set(res.expires_at)
+    with pytest.raises(error("ReservationExpired")):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is status("EXPIRED")
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_c23_confirm_after_expires_at_raises(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(HOLD + timedelta(minutes=5))
+    with pytest.raises(error("ReservationExpired")):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+
+
+def test_c23_confirm_just_before_expires_at_succeeds(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(HOLD - timedelta(seconds=1))
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+
+
+# -- 24. confirming a RELEASED reservation ---------------------------------
+
+def test_c24_confirm_released_raises(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(error("InvalidReservationState")):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is status("RELEASED")
+
+
+# -- 25. the resulting order is an ordinary order --------------------------
+
+def test_c25_confirmed_order_can_be_shipped(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    shipped = stocked.ship_order(order.order_id)
+    assert shipped.status is OrderStatus.SHIPPED
+    assert shipped.closed_at == clock.now()
+    assert stocked.on_hand("MUG", "WH1") == 7
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_c25_confirmed_order_can_be_cancelled(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    cancelled = stocked.cancel_order(order.order_id)
+    assert cancelled.status is OrderStatus.CANCELLED
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 10

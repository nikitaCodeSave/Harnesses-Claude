+++ b/tests/acceptance/acc_helpers.py
@@ -0,0 +1,20 @@
+"""Helpers for the stock-reservation acceptance tests (SPEC.md).
+
+New names from the spec (``ReservationStatus``, the new errors) are looked up
+on their modules at test time rather than imported at module level, so a
+missing name fails each test on its own instead of breaking collection.
+"""
+
+from datetime import timedelta
+
+from inventory import errors, models
+
+HOLD = timedelta(minutes=20)
+
+
+def status(name: str):
+    return getattr(models.ReservationStatus, name)
+
+
+def error(name: str):
+    return getattr(errors, name)

index 0000000..d2d831a
--- /dev/null
+++ b/tests/acceptance/test_lookup_errors.py
@@ -0,0 +1,79 @@
+"""R35-R37: lookup, error hierarchy and clock discipline."""
+
+import re
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+
+import inventory
+import inventory.errors as errors
+import inventory.models as models
+from inventory import FixedClock, InventoryService, Ledger
+from inventory.errors import InventoryError
+
+HOLD = timedelta(minutes=20)
+
+
+@pytest.mark.parametrize(
+    "method", ["get_reservation", "confirm_reservation", "release_reservation"]
+)
+def test_r35_unknown_reservation_id(stocked, method):
+    with pytest.raises(errors.ReservationNotFound):
+        getattr(stocked, method)("RES-9999")
+
+
+def test_r35_unknown_id_even_when_others_exist(stocked):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(errors.ReservationNotFound):
+        stocked.get_reservation(res.reservation_id + "-unknown")
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["ReservationNotFound", "ReservationExpired", "InvalidReservationState", "IdempotencyConflict"],
+)
+def test_r36_new_errors_subclass_inventory_error(name):
+    cls = getattr(errors, name)
+    assert isinstance(cls, type)
+    assert issubclass(cls, InventoryError)
+
+
+WALL_CLOCK_CALLS = [
+    re.compile(r"\b(datetime|date)\s*\.\s*(now|utcnow|today)\s*\("),
+    re.compile(r"\btime\s*\.\s*(time|time_ns|localtime|gmtime|ctime)\s*\("),
+    re.compile(r"\bfrom\s+time\s+import\b"),
+]
+
+
+def test_r37_no_package_code_reads_the_wall_clock():
+    package_dir = Path(inventory.__file__).parent
+    offenders = [
+        f"{path.name}:{lineno}: {line.strip()}"
+        for path in sorted(package_dir.rglob("*.py"))
+        for lineno, line in enumerate(path.read_text().splitlines(), 1)
+        if any(p.search(line) for p in WALL_CLOCK_CALLS)
+    ]
+    assert offenders == []
+
+
+@pytest.mark.parametrize(
+    "start",
+    [
+        datetime(2001, 6, 1, 12, 0, tzinfo=timezone.utc),  # long before the wall clock
+        datetime(2150, 6, 1, 12, 0, tzinfo=timezone.utc),  # long after the wall clock
+    ],
+)
+def test_r37_expiry_follows_the_injected_clock(repo, start):
+    clock = FixedClock(start)
+    service = InventoryService(repo, Ledger(), clock)
+    service.receive("MUG", "WH1", 10)
+
+    res = service.reserve("WH1", {"MUG": 4}, "k1")
+    assert res.expires_at == start + HOLD
+    assert service.get_reservation(res.reservation_id).status is models.ReservationStatus.ACTIVE
+    assert service.available("MUG", "WH1") == 6
+
+    clock.advance(HOLD)
+    assert service.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+    assert service.available("MUG", "WH1") == 10

@@ -0,0 +1,59 @@
+"""R31-R34: releasing a reservation."""
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+
+
+def test_r31_release_active_hold(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 2}, "k1")
+    assert stocked.available("MUG", "WH1") == 6
+
+    released = stocked.release_reservation(res.reservation_id)
+
+    assert released.reservation_id == res.reservation_id
+    assert released.status is models.ReservationStatus.RELEASED
+    assert released.items == {"MUG": 4, "TEE": 2}
+    assert released.order_id is None
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.RELEASED
+
+
+def test_r32_release_twice_is_a_no_op(stocked, snapshot):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = snapshot(stocked.release_reservation(res.reservation_id))
+    second = stocked.release_reservation(res.reservation_id)
+    assert snapshot(second) == first
+    assert second.status is models.ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_r33_release_expired_returns_it_still_expired(stocked, clock, snapshot):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(minutes=20)
+    before = snapshot(stocked.get_reservation(res.reservation_id))
+
+    released = stocked.release_reservation(res.reservation_id)
+
+    assert released.status is models.ReservationStatus.EXPIRED
+    assert snapshot(released) == before
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_r34_release_confirmed_raises(stocked, repo, snapshot):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    before = snapshot(stocked.get_reservation(res.reservation_id))
+
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+
+    assert snapshot(stocked.get_reservation(res.reservation_id)) == before
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+    assert len(repo.orders()) == 1
+    assert stocked.allocated("MUG", "WH1") == 4
+    assert stocked.available("MUG", "WH1") == 6
diff --git a/tests/acceptance/test_reserve_idempotency.py b/tests/acceptance/test_reserve_idempotency.py
new file mode 100644
index 0000000..41c0087
--- /dev/null
+++ b/tests/acceptance/test_reserve_idempotency.py
@@ -0,0 +1,165 @@
+"""R13-R16: idempotent reserve."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory.errors import InsufficientStock, InvalidQuantity
+
+HOLD = timedelta(minutes=20)
+
+
+def test_r13_retry_returns_same_reservation_without_new_hold(stocked, clock, snapshot):
+    first = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    before = snapshot(first)
+    clock.advance(minutes=5)
+
+    again = stocked.reserve("WH1", {"TEE": 2, "MUG": 3}, "k1")  # key order differs
+
+    assert snapshot(again) == before
+    assert again.expires_at == clock.now() - timedelta(minutes=5) + HOLD
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.available("TEE", "WH1") == 3
+
+
+def test_r13_retry_compares_against_requested_not_held(stocked):
+    first = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert first.items == {"MUG": 10}
+    stocked.receive("MUG", "WH1", 20)  # more stock now, still nothing new held
+
+    again = stocked.reserve("WH1", {"MUG": 15}, "k1")
+
+    assert again.reservation_id == first.reservation_id
+    assert again.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 20
+
+
+def test_r13_retry_after_confirm_returns_confirmed(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+
+    assert again.reservation_id == res.reservation_id
+    assert again.status is models.ReservationStatus.CONFIRMED
+    assert again.order_id == order.order_id
+    assert again.items == {"MUG": 3}
+    assert len(repo.orders()) == 1
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_r13_retry_after_release_returns_released(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+
+    assert again.reservation_id == res.reservation_id
+    assert again.status is models.ReservationStatus.RELEASED
+    assert again.items == {"MUG": 3}
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_r13_retry_after_expiry_returns_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    expires_at = res.expires_at
+    clock.advance(minutes=30)
+
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+
+    assert again.reservation_id == res.reservation_id
+    assert again.status is models.ReservationStatus.EXPIRED
+    assert again.expires_at == expires_at
+    assert again.items == {"MUG": 3}
+    assert stocked.available("MUG", "WH1") == 10
+
+
+@pytest.mark.parametrize(
+    "warehouse, items",
+    [
+        ("WH2", {"MUG": 15}),  # different warehouse
+        ("WH1", {"MUG": 14}),  # different quantity
+        ("WH1", {"MUG": 15, "TEE": 1}),  # extra line
+        ("WH1", {"TEE": 15}),  # different SKU
+        ("WH1", {"MUG": 10}),  # equals what was held, not what was requested
+    ],
+)
+def test_r14_used_key_with_different_request_conflicts(
+    stocked, warehouse, items, snapshot
+):
+    stocked.receive("MUG", "WH2", 10)
+    res = stocked.reserve("WH1", {"MUG": 15}, "k1")  # holds MUG 10
+    res_before = snapshot(res)
+
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+
+    assert snapshot(stocked.get_reservation(res.reservation_id)) == res_before
+    assert stocked.available("MUG", "WH1") == 0
+    assert stocked.available("TEE", "WH1") == 5
+    assert stocked.available("MUG", "WH2") == 10
+    # The key still points at the original reservation.
+    assert snapshot(stocked.reserve("WH1", {"MUG": 15}, "k1")) == res_before
+
+
+@pytest.mark.parametrize("finish", ["confirm", "release", "expire"])
+def test_r14_conflict_applies_after_reservation_is_finished(
+    stocked, repo, clock, finish, snapshot
+):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    if finish == "confirm":
+        stocked.confirm_reservation(res.reservation_id)
+    elif finish == "release":
+        stocked.release_reservation(res.reservation_id)
+    else:
+        clock.advance(HOLD)
+    before = snapshot(stocked.get_reservation(res.reservation_id))
+    available_before = stocked.available("MUG", "WH1")
+    orders_before = len(repo.orders())
+
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2}, "k1")
+
+    assert snapshot(stocked.get_reservation(res.reservation_id)) == before
+    assert stocked.available("MUG", "WH1") == available_before
+    assert len(repo.orders()) == orders_before
+
+
+def test_r15_keys_are_global_across_warehouses(stocked):
+    stocked.receive("MUG", "WH2", 10)
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 3}, "k1")
+    assert stocked.available("MUG", "WH2") == 10
+
+
+def test_r15_keys_never_expire(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(days=400)
+
+    again = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert again.reservation_id == res.reservation_id
+    assert again.status is models.ReservationStatus.EXPIRED
+    assert stocked.available("MUG", "WH1") == 10
+    with pytest.raises(errors.IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 1}, "k1")
+
+
+def test_r16_raised_call_leaves_no_trace_insufficient_stock(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert res.items == {"MUG": 2}
+    assert res.status is models.ReservationStatus.ACTIVE
+
+
+def test_r16_raised_call_leaves_no_trace_validation(stocked):
+    with pytest.raises(InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": 0}, "k1")
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert res.items == {"MUG": 2}
+    # The same request again is now an idempotent retry of that new hold.
+    assert stocked.reserve("WH1", {"MUG": 2}, "k1").reservation_id == res.reservation_id
+    assert stocked.available("MUG", "WH1") == 8

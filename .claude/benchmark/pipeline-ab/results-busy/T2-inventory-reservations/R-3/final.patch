+"""R38-R39: backwards compatibility.
+
+The keyword for a custom hold duration is not fixed by the spec; these tests
+use the proposed name ``hold_duration``.
+"""
+
+import subprocess
+import sys
+from datetime import timedelta
+from pathlib import Path
+
+import inventory.models as models
+from inventory import InventoryService, Ledger
+
+TESTS_DIR = Path(__file__).resolve().parent.parent
+
+
+def test_r38_three_positional_args_default_to_20_minute_hold(repo, clock):
+    service = InventoryService(repo, Ledger(), clock)
+    service.receive("MUG", "WH1", 5)
+
+    res = service.reserve("WH1", {"MUG": 2}, "k1")
+
+    assert res.expires_at == clock.now() + timedelta(minutes=20)
+    clock.advance(minutes=19, seconds=59)
+    assert service.get_reservation(res.reservation_id).status is models.ReservationStatus.ACTIVE
+    clock.advance(seconds=1)
+    assert service.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_r38_hold_duration_is_configurable_by_keyword(repo, clock):
+    service = InventoryService(repo, Ledger(), clock, hold_duration=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 5)
+
+    res = service.reserve("WH1", {"MUG": 2}, "k1")
+
+    assert res.expires_at == clock.now() + timedelta(minutes=5)
+    clock.advance(minutes=5)
+    assert service.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_r39_existing_suite_passes_unchanged():
+    result = subprocess.run(
+        [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider",
+         str(TESTS_DIR), "--ignore", str(TESTS_DIR / "acceptance")],
+        cwd=TESTS_DIR.parent,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr

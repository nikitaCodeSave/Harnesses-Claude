@@ -0,0 +1,71 @@
+"""R17-R19: lazy expiry driven only by the injected clock."""
+
+from datetime import timedelta
+
+import inventory.models as models
+
+HOLD = timedelta(minutes=20)
+
+
+def test_r17_active_just_before_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(HOLD - timedelta(microseconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_r17_expired_at_exactly_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at)
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_r18_get_reservation_reports_expired_without_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(hours=1)
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.status is models.ReservationStatus.EXPIRED
+    assert got.items == {"MUG": 4}
+    assert got.order_id is None
+
+
+def test_r18_idempotent_retry_returns_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(HOLD)
+    again = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert again.reservation_id == res.reservation_id
+    assert again.status is models.ReservationStatus.EXPIRED
+
+
+def test_r18_available_stops_counting_expired_units(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 4, "TEE": 5}, "k1")
+    assert stocked.available("MUG", "WH1") == 6
+    clock.advance(HOLD)
+    # First call after the clock moved is available() itself.
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_r18_expired_units_can_be_reserved_and_ordered_again(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.advance(HOLD)
+    res = stocked.reserve("WH1", {"MUG": 6}, "k2")
+    assert res.items == {"MUG": 6}
+    order = stocked.place_order("WH1", {"MUG": 4})
+    assert order.quantity_of("MUG") == 4
+
+
+def test_r19_confirmed_never_expires(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(days=30)
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.status is models.ReservationStatus.CONFIRMED
+    assert got.order_id == order.order_id
+
+
+def test_r19_released_never_expires(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    clock.advance(days=30)
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.RELEASED

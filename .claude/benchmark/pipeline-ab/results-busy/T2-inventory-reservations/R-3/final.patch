diff --git a/src/inventory/errors.py b/src/inventory/errors.py
index acdaf96..b92354c 100644
--- a/src/inventory/errors.py
+++ b/src/inventory/errors.py
@@ -59,3 +59,31 @@ class InvalidOrderState(InventoryError):
         self.order_id = order_id
         self.status = status
         self.action = action
+
+
+class ReservationNotFound(InventoryError):
+    def __init__(self, reservation_id: str) -> None:
+        super().__init__(f"reservation {reservation_id!r} not found")
+        self.reservation_id = reservation_id
+
+
+class ReservationExpired(InventoryError):
+    def __init__(self, reservation_id: str) -> None:
+        super().__init__(f"reservation {reservation_id!r} has expired")
+        self.reservation_id = reservation_id
+
+
+class InvalidReservationState(InventoryError):
+    def __init__(self, reservation_id: str, status: object, action: str) -> None:
+        super().__init__(f"cannot {action} reservation {reservation_id!r} in status {status}")
+        self.reservation_id = reservation_id
+        self.status = status
+        self.action = action
+
+
+class IdempotencyConflict(InventoryError):
+    """An idempotency key was reused for a different request."""
+
+    def __init__(self, key: str) -> None:
+        super().__init__(f"idempotency key {key!r} was already used for a different request")
+        self.key = key
diff --git a/src/inventory/models.py b/src/inventory/models.py
index bd885d5..498730d 100644
--- a/src/inventory/models.py
+++ b/src/inventory/models.py
@@ -57,6 +57,30 @@ class AdjustmentReason(Enum):
     SHIPMENT = "shipment"
 
 
+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A temporary hold on stock for one cart, fulfilled from a single warehouse.
+
+    ``items`` are the units actually held, which may be fewer than requested.
+    An ACTIVE hold counts against availability until it is confirmed into an
+    order, released, or lapses at ``expires_at``.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+
+
 @dataclass(frozen=True)
 class Adjustment:
     """One physical stock movement. Positive delta = stock in."""

+"""R20-R24: availability, allocation and reports in the presence of holds."""
+
+from dataclasses import fields
+
+import pytest
+
+from inventory.errors import InsufficientStock
+from inventory.reports import StockRow, stock_report
+
+
+def test_r20_available_is_on_hand_minus_allocated_minus_held(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 10 - 3 - 4
+
+
+def test_r20_holds_are_per_sku_and_warehouse(stocked):
+    stocked.receive("MUG", "WH2", 7)
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH2") == 7
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_r20_available_is_floored_at_zero(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")  # on-hand 5 < held 8
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_r21_allocated_excludes_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 2
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_r22_held_units_cannot_be_taken_by_place_order(stocked, repo):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3})
+    assert repo.orders() == []
+    order = stocked.place_order("WH1", {"MUG": 2})
+    assert order.quantity_of("MUG") == 2
+
+
+def test_r22_held_units_cannot_be_taken_by_another_reserve(stocked):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    other = stocked.reserve("WH1", {"MUG": 5}, "k2")
+    assert other.items == {"MUG": 2}
+
+
+def test_r23_receive_is_not_restricted_by_holds(stocked):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.receive("MUG", "WH1", 5)
+    assert stocked.on_hand("MUG", "WH1") == 15
+    assert stocked.available("MUG", "WH1") == 5
+
+
+def test_r23_writeoff_below_held_is_allowed_and_leaves_hold_unchanged(stocked, snapshot):
+    res = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    before = snapshot(res)
+    stocked.adjust("MUG", "WH1", -10, note="flood")
+    assert stocked.on_hand("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 0
+    assert snapshot(stocked.get_reservation(res.reservation_id)) == before
+
+
+def test_r24_stock_report_available_reflects_holds(repo, service):
+    service.receive("TEE", "WH1", 8)
+    service.place_order("WH1", {"TEE": 3})
+    service.reserve("WH1", {"TEE": 2}, "k1")
+    assert stock_report(repo, service, "WH1") == [
+        StockRow("CAP", 0, 0, 0),
+        StockRow("MUG", 0, 0, 0),
+        StockRow("TEE", 8, 3, 3),
+    ]
+    assert [f.name for f in fields(StockRow)] == ["sku", "on_hand", "allocated", "available"]

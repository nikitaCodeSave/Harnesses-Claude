+++ b/tests/acceptance/test_confirm.py
@@ -0,0 +1,132 @@
+"""R25-R30: confirming a reservation into an order."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.errors as errors
+import inventory.models as models
+from inventory import OrderStatus
+from inventory.errors import InsufficientStock
+
+HOLD = timedelta(minutes=20)
+
+
+def lines_of(order):
+    return {line.sku: line.quantity for line in order.lines}
+
+
+def test_r25_confirm_creates_placed_order_from_held_items(stocked, repo, clock):
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 2, "CAP": 1}, "k1")
+    assert res.items == {"MUG": 10, "TEE": 2}
+    clock.advance(minutes=5)
+
+    order = stocked.confirm_reservation(res.reservation_id)
+
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert lines_of(order) == {"MUG": 10, "TEE": 2}
+    assert len(order.lines) == 2
+    assert order.placed_at == clock.now()
+    assert order.order_id == "ORD-0001"
+    assert repo.orders() == [order]
+
+
+def test_r25_reservation_becomes_confirmed_with_order_id(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.status is models.ReservationStatus.CONFIRMED
+    assert got.order_id == order.order_id
+    assert got.items == {"MUG": 3}
+
+
+def test_r25_order_id_uses_normal_ord_sequence(stocked):
+    stocked.place_order("WH1", {"TEE": 1})  # ORD-0001
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.order_id == "ORD-0002"
+    assert stocked.place_order("WH1", {"TEE": 1}).order_id == "ORD-0003"
+
+
+def test_r25_confirm_just_before_expiry_succeeds(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(HOLD - timedelta(microseconds=1))
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+
+
+def test_r26_confirm_moves_units_from_held_to_allocated(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert (stocked.available("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (6, 0)
+    stocked.confirm_reservation(res.reservation_id)
+    assert (stocked.available("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (6, 4)
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_r27_confirm_twice_returns_same_order(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    second = stocked.confirm_reservation(res.reservation_id)
+    assert second.order_id == first.order_id
+    assert len(repo.orders()) == 1
+    assert stocked.allocated("MUG", "WH1") == 4
+
+
+def test_r27_confirm_again_after_expires_at_returns_same_order(stocked, repo, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(days=2)
+    second = stocked.confirm_reservation(res.reservation_id)
+    assert second.order_id == first.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_r28_confirm_at_exactly_expires_at_raises(stocked, repo, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(res.expires_at)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.allocated("MUG", "WH1") == 0
+
+
+def test_r28_confirm_after_expiry_raises(stocked, repo, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(hours=1)
+    with pytest.raises(errors.ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.EXPIRED
+
+
+def test_r29_confirm_released_raises(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(errors.InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is models.ReservationStatus.RELEASED
+
+
+def test_r30_confirm_after_writeoff_below_held(stocked, repo, clock):
+    res = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")  # on-hand 5 < held 8
+
+    try:
+        order = stocked.confirm_reservation(res.reservation_id)
+    except InsufficientStock:
+        # Outcome (b): no order, reservation still ACTIVE.
+        assert repo.orders() == []
+        got = stocked.get_reservation(res.reservation_id)
+        assert got.status is models.ReservationStatus.ACTIVE
+        assert got.items == {"MUG": 8}
+    else:
+        # Outcome (a): behaves as R25.
+        assert order.status is OrderStatus.PLACED
+        assert order.warehouse == "WH1"
+        assert lines_of(order) == {"MUG": 8}
+        assert order.placed_at == clock.now()
+        got = stocked.get_reservation(res.reservation_id)
+        assert got.status is models.ReservationStatus.CONFIRMED
+        assert got.order_id == order.order_id

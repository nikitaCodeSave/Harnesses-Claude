+"""R7-R12: partial holds and the shape of a new reservation."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.models as models
+from inventory.errors import InsufficientStock
+
+HOLD = timedelta(minutes=20)
+
+
+def test_r7_each_line_holds_min_of_requested_and_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 9}, "k1")
+    assert res.items == {"MUG": 4, "TEE": 5}
+
+
+def test_r7_availability_excludes_allocations_and_other_active_holds(stocked):
+    stocked.place_order("WH1", {"MUG": 2})  # MUG available 8
+    stocked.reserve("WH1", {"MUG": 3}, "other")  # MUG available 5
+    res = stocked.reserve("WH1", {"MUG": 7}, "k1")
+    assert res.items == {"MUG": 5}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_r8_line_with_nothing_available_is_omitted(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2, "CAP": 3}, "k1")
+    assert res.items == {"MUG": 2}
+    assert "CAP" not in res.items
+
+
+def test_r8_line_fully_held_elsewhere_is_omitted(stocked):
+    stocked.reserve("WH1", {"TEE": 5}, "other")
+    res = stocked.reserve("WH1", {"MUG": 1, "TEE": 1}, "k1")
+    assert res.items == {"MUG": 1}
+    assert 0 not in res.items.values()
+
+
+def test_r9_nothing_holdable_raises_and_creates_nothing(stocked, clock):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    # Nothing was bound to the key: once stock arrives, the same request with
+    # the same key is a brand-new hold, not a retry of an earlier record.
+    clock.advance(minutes=1)
+    stocked.receive("CAP", "WH1", 2)
+    res = stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert res.items == {"CAP": 1}
+    assert res.status is models.ReservationStatus.ACTIVE
+    assert res.expires_at == clock.now() + HOLD
+    assert stocked.available("CAP", "WH1") == 1
+
+
+def test_r9_everything_already_held_raises(stocked):
+    stocked.reserve("WH1", {"MUG": 10, "TEE": 5}, "other")
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"MUG": 1, "TEE": 1, "CAP": 1}, "k1")
+    assert stocked.available("MUG", "WH1") == 0
+    assert stocked.available("TEE", "WH1") == 0
+
+
+def test_r10_new_reservation_fields(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert isinstance(res, models.Reservation)
+    assert res.status is models.ReservationStatus.ACTIVE
+    assert res.order_id is None
+    assert res.warehouse == "WH1"
+    assert res.expires_at == clock.now() + HOLD
+
+
+def test_r10_expires_at_follows_the_clock(stocked, clock):
+    clock.advance(hours=3, minutes=7)
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert res.expires_at == clock.now() + HOLD
+
+
+def test_r11_two_reservations_get_different_ids(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert first.reservation_id != second.reservation_id
+
+
+def test_r11_reservation_ids_are_unique(stocked):
+    ids = [stocked.reserve("WH1", {"MUG": 1}, f"k{i}").reservation_id for i in range(6)]
+    assert len(set(ids)) == 6
+
+
+def test_r12_place_order_stays_all_or_nothing(stocked, repo):
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 2, "TEE": 6})
+    assert repo.orders() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_r12_place_order_does_not_partially_fill_around_holds(stocked, repo):
+    stocked.reserve("WH1", {"TEE": 3}, "k1")  # TEE available 2
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 2, "TEE": 3})
+    assert repo.orders() == []
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 2

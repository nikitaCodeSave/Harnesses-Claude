+++ b/tests/acceptance/conftest.py
@@ -0,0 +1,33 @@
+"""Shared fixtures for the stock-reservation acceptance tests (SPEC.md).
+
+New names from the spec (``Reservation``, ``ReservationStatus`` and the new
+errors) are looked up through their modules inside each test, so a missing
+name fails that test instead of breaking collection of the whole file.
+"""
+
+import pytest
+
+
+@pytest.fixture
+def stocked(service):
+    """WH1: MUG 10, TEE 5, CAP 0. WH2: nothing."""
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+@pytest.fixture
+def snapshot():
+    """Freeze the observable state of a reservation for later comparison."""
+
+    def take(reservation):
+        return (
+            reservation.reservation_id,
+            reservation.warehouse,
+            dict(reservation.items),
+            reservation.status,
+            reservation.expires_at,
+            reservation.order_id,
+        )
+
+    return take

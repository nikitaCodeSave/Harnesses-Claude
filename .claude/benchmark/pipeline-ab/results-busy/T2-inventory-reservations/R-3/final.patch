@@ -0,0 +1,79 @@
+"""R1-R6: reserve input validation."""
+
+from datetime import timedelta
+
+import pytest
+
+import inventory.models as models
+from inventory.errors import (
+    InvalidOrder,
+    InvalidQuantity,
+    InventoryError,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+HOLD = timedelta(minutes=20)
+
+
+def test_r1_unknown_warehouse(stocked):
+    with pytest.raises(UnknownWarehouse):
+        stocked.reserve("NOPE", {"MUG": 1}, "k1")
+
+
+def test_r2_unknown_sku(stocked):
+    with pytest.raises(UnknownSku):
+        stocked.reserve("WH1", {"MUG": 1, "NOPE": 1}, "k1")
+
+
+@pytest.mark.parametrize("quantity", [0, -1, 1.5, 2.0, "1", None, True, False])
+def test_r3_non_positive_or_non_int_quantity(stocked, quantity):
+    with pytest.raises(InvalidQuantity):
+        stocked.reserve("WH1", {"MUG": quantity}, "k1")
+
+
+def test_r4_empty_items(stocked):
+    with pytest.raises(InvalidOrder):
+        stocked.reserve("WH1", {}, "k1")
+
+
+def test_r5_empty_idempotency_key(stocked):
+    with pytest.raises(InventoryError):
+        stocked.reserve("WH1", {"MUG": 1}, "")
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("WH1", {"MUG": 3, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 3, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 3, "TEE": True}, InvalidQuantity),
+        ("WH1", {"MUG": 3, "NOPE": 1}, UnknownSku),
+        ("NOPE", {"MUG": 3}, UnknownWarehouse),
+    ],
+)
+def test_r6_failed_validation_holds_nothing_and_keeps_key_free(
+    stocked, clock, warehouse, items, error
+):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+
+    # Nothing held, not even for the valid MUG line.
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.available("TEE", "WH1") == 5
+    # No reservation is bound to the key: a later, different request with it
+    # is a brand-new hold rather than an IdempotencyConflict or a retry.
+    clock.advance(minutes=1)
+    res = stocked.reserve("WH1", {"TEE": 2}, "k1")
+    assert res.items == {"TEE": 2}
+    assert res.status is models.ReservationStatus.ACTIVE
+    assert res.expires_at == clock.now() + HOLD
+    assert stocked.available("TEE", "WH1") == 3
+
+
+def test_r6_empty_items_holds_nothing_and_keeps_key_free(stocked):
+    with pytest.raises(InvalidOrder):
+        stocked.reserve("WH1", {}, "k1")
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.items == {"MUG": 1}
+    assert stocked.available("MUG", "WH1") == 9

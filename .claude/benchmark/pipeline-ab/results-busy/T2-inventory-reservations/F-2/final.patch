+        reservation = Reservation(
+            reservation_id=self._repo.next_reservation_id(),
+            warehouse=warehouse,
+            items=held,
+            status=ReservationStatus.ACTIVE,
+            expires_at=now + self._hold_lifetime,
+            idempotency_key=idempotency_key,
+            requested=wanted,
+            created_at=now,
+        )

+from datetime import timedelta
+
+import pytest
+
+from inventory import (
+    InventoryService,
+    OrderStatus,
+    Reservation,
+    ReservationStatus,
+)
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+HOLD = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 7)
+    return service
+
+
+def snapshot(service):
+    return {
+        (sku, wh): (service.on_hand(sku, wh), service.available(sku, wh))
+        for sku in ("MUG", "TEE", "CAP")
+        for wh in ("WH1", "WH2")
+    }
+
+
+# -- constructor and configuration ----------------------------------------
+
+
+def test_default_hold_lifetime_is_20_minutes(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + HOLD
+
+
+def test_hold_lifetime_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, hold_lifetime=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 3)
+    res = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + timedelta(minutes=5)
+    clock.advance(minutes=5)
+    assert service.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+# -- reserve --------------------------------------------------------------
+
+
+def test_reserve_returns_active_reservation(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    assert isinstance(res, Reservation)
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.order_id is None
+    assert res.warehouse == "WH1"
+    assert res.items == {"MUG": 3, "TEE": 2}
+    assert res.expires_at == clock.now() + HOLD
+
+
+def test_partial_hold_takes_what_is_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 2}, "k1")
+    assert res.items == {"MUG": 10, "TEE": 2}
+
+
+def test_line_with_nothing_available_is_left_out(stocked):
+    res = stocked.reserve("WH1", {"MUG": 2, "CAP": 4}, "k1")
+    assert res.items == {"MUG": 2}
+    assert 0 not in res.items.values()
+
+
+def test_reserve_with_nothing_available_creates_nothing(stocked, repo):
+    before = snapshot(stocked)
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert repo.reservations() == []
+    assert snapshot(stocked) == before
+    # The key stays unused.
+    stocked.receive("CAP", "WH1", 2)
+    res = stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert res.items == {"CAP": 1}
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": 1.5}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": "2"}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": True}, InvalidQuantity),
+    ],
+)
+def test_invalid_request_holds_nothing_and_leaves_key_unused(
+    stocked, repo, warehouse, items, error
+):
+    before = snapshot(stocked)
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert snapshot(stocked) == before
+    res = stocked.reserve("WH2", {"MUG": 1}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+
+
+@pytest.mark.parametrize(
+    "items, key",
+    [({}, "k1"), ({"MUG": 1}, ""), ({"MUG": 1}, "   "), ({"MUG": 1}, None)],
+)
+def test_empty_items_or_blank_key_is_rejected(stocked, repo, items, key):
+    before = snapshot(stocked)
+    with pytest.raises(InventoryError):
+        stocked.reserve("WH1", items, key)
+    assert repo.reservations() == []
+    assert snapshot(stocked) == before
+
+
+def test_reservation_ids_are_unique(stocked):
+    ids = {stocked.reserve("WH1", {"MUG": 1}, f"k{i}").reservation_id for i in range(5)}
+    assert len(ids) == 5
+
+
+def test_reserve_never_touches_ledger(stocked, ledger):
+    entries = len(ledger)
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert len(ledger) == entries
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+# -- availability ---------------------------------------------------------
+
+
+def test_active_hold_reduces_availability(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_hold_affects_only_its_warehouse(stocked):
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH2") == 7
+
+
+def test_place_order_respects_holds(stocked, repo):
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 1, "MUG": 3})
+    assert repo.orders() == []
+    order = stocked.place_order("WH1", {"MUG": 2})
+    assert order.status is OrderStatus.PLACED
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_second_reserve_gets_only_what_is_left(stocked):
+    stocked.reserve("WH1", {"MUG": 7}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 7}, "k2")
+    assert second.items == {"MUG": 3}
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"MUG": 1}, "k3")
+
+
+def test_holds_and_orders_combine(stocked):
+    stocked.place_order("WH1", {"MUG": 3})
+    res = stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert res.items == {"MUG": 7}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_receive_and_adjust_are_not_blocked_by_holds(stocked):
+    res = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.receive("MUG", "WH1", 2)
+    assert stocked.available("MUG", "WH1") == 4
+    stocked.adjust("MUG", "WH1", -9, "water damage")
+    assert stocked.on_hand("MUG", "WH1") == 3
+    assert stocked.available("MUG", "WH1") == 0
+    same = stocked.get_reservation(res.reservation_id)
+    assert same.status is ReservationStatus.ACTIVE
+    assert same.items == {"MUG": 8}
+
+
+def test_on_hand_never_moves_through_reservation_lifecycle(stocked, clock, ledger):
+    entries = len(ledger)
+    a = stocked.reserve("WH1", {"MUG": 2}, "a")
+    b = stocked.reserve("WH1", {"MUG": 2}, "b")
+    c = stocked.reserve("WH1", {"MUG": 2}, "c")
+    stocked.release_reservation(a.reservation_id)
+    stocked.confirm_reservation(b.reservation_id)
+    clock.advance(HOLD)
+    stocked.get_reservation(c.reservation_id)
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert len(ledger) == entries
+
+
+# -- expiry ---------------------------------------------------------------
+
+
+def test_hold_expires_exactly_at_expires_at(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(HOLD - timedelta(microseconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+    clock.advance(microseconds=1)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+@pytest.mark.parametrize("operation", ["available", "place_order", "reserve"])
+def test_expired_units_are_available_to_every_operation(stocked, clock, operation):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.advance(HOLD)
+    if operation == "available":
+        assert stocked.available("MUG", "WH1") == 10
+    elif operation == "place_order":
+        assert stocked.place_order("WH1", {"MUG": 10}).status is OrderStatus.PLACED
+    else:
+        assert stocked.reserve("WH1", {"MUG": 10}, "k2").items == {"MUG": 10}
+
+
+def test_expired_reservation_stays_retrievable(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    clock.advance(days=365)
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.reservation_id == res.reservation_id
+    assert got.status is ReservationStatus.EXPIRED
+
+
+def test_confirmed_and_released_never_expire(stocked, clock):
+    a = stocked.reserve("WH1", {"MUG": 1}, "a")
+    b = stocked.reserve("WH1", {"MUG": 1}, "b")
+    stocked.confirm_reservation(a.reservation_id)
+    stocked.release_reservation(b.reservation_id)
+    clock.advance(days=30)
+    assert stocked.get_reservation(a.reservation_id).status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation(b.reservation_id).status is ReservationStatus.RELEASED
+
+
+def test_retry_does_not_extend_hold(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    original = res.expires_at
+    clock.advance(minutes=10)
+    again = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    assert again.expires_at == original
+    clock.advance(minutes=10)
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+# -- confirm --------------------------------------------------------------
+
+
+def test_confirm_creates_placed_order_for_held_units(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 2, "CAP": 1}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 10, "TEE": 2}
+    assert order.placed_at == clock.now()
+    got = stocked.get_reservation(res.reservation_id)
+    assert got.status is ReservationStatus.CONFIRMED
+    assert got.order_id == order.order_id
+    assert repo.get_order(order.order_id) is order
+
+
+def test_confirm_does_not_change_availability(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4, "TEE": 5}, "k1")
+    before = snapshot(stocked)
+    stocked.confirm_reservation(res.reservation_id)
+    assert snapshot(stocked) == before
+
+
+def test_confirmed_order_ships_and_cancels_normally(stocked):
+    a = stocked.confirm_reservation(stocked.reserve("WH1", {"MUG": 4}, "a").reservation_id)
+    b = stocked.confirm_reservation(stocked.reserve("WH1", {"MUG": 3}, "b").reservation_id)
+    stocked.ship_order(a.order_id)
+    assert stocked.on_hand("MUG", "WH1") == 6
+    stocked.cancel_order(b.order_id)
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.get_reservation("RES-0001").status is ReservationStatus.CONFIRMED
+
+
+def test_confirm_is_idempotent_even_after_lifetime(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=2)
+    again = stocked.confirm_reservation(res.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_confirm_expired_raises(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(HOLD)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_confirm_released_raises(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+
+
+# -- release --------------------------------------------------------------
+
+
+def test_release_frees_units_immediately(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_release_twice_is_a_noop(stocked):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    again = stocked.release_reservation(res.reservation_id)
+    assert again.status is ReservationStatus.RELEASED
+    assert again.items == {"MUG": 4}
+
+
+def test_release_expired_stays_expired(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(HOLD)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.EXPIRED
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_release_confirmed_raises_and_changes_nothing(stocked, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    got = stocked.get_reservation(res.reservation_id)
+    assert (got.status, got.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert repo.get_order(order.order_id).status is OrderStatus.PLACED
+    assert stocked.available("MUG", "WH1") == 6
+
+
+# -- lookup ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "method", ["get_reservation", "confirm_reservation", "release_reservation"]
+)
+def test_unknown_reservation_raises(stocked, method):
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, method)("RES-9999")
+
+
+# -- idempotency ----------------------------------------------------------
+
+
+def test_same_request_ignores_line_order_and_compares_requested(stocked, repo):
+    first = stocked.reserve("WH1", {"MUG": 15, "TEE": 2}, "k1")
+    assert first.items == {"MUG": 10, "TEE": 2}
+    again = stocked.reserve("WH1", {"TEE": 2, "MUG": 15}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert len(repo.reservations()) == 1
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10, "TEE": 2}, "k1")
+
+
+@pytest.mark.parametrize("state", ["active", "confirmed", "released", "expired"])
+def test_retry_returns_existing_in_current_state(stocked, clock, repo, state):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    expires_at = res.expires_at
+    expected = {
+        "active": ReservationStatus.ACTIVE,
+        "confirmed": ReservationStatus.CONFIRMED,
+        "released": ReservationStatus.RELEASED,
+        "expired": ReservationStatus.EXPIRED,
+    }[state]
+    if state == "confirmed":
+        stocked.confirm_reservation(res.reservation_id)
+    elif state == "released":
+        stocked.release_reservation(res.reservation_id)
+    elif state == "expired":
+        clock.advance(HOLD)
+    before = snapshot(stocked)
+    again = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert again.reservation_id == res.reservation_id
+    assert again.status is expected
+    assert again.expires_at == expires_at
+    assert snapshot(stocked) == before
+    assert len(repo.reservations()) == 1
+
+
+@pytest.mark.parametrize(
+    "warehouse, items", [("WH2", {"MUG": 4}), ("WH1", {"MUG": 5}), ("WH1", {"MUG": 4, "TEE": 1})]
+)
+@pytest.mark.parametrize("released", [False, True])
+def test_reusing_key_for_different_request_conflicts(
+    stocked, repo, warehouse, items, released

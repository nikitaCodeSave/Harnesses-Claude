@@ -69,3 +69,37 @@ class Adjustment:
     at: datetime
     ref: str | None = None
     note: str | None = None
+
+
+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A time-limited hold on stock in one warehouse, made for a checkout.
+
+    ``items`` records the units actually held per SKU, which can be fewer than
+    were requested. An ACTIVE reservation lapses to EXPIRED once the clock
+    reaches ``expires_at``; nothing ever moves ``expires_at``.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None
+
+
+@dataclass(frozen=True)
+class ReservationRequest:
+    """What a successful ``reserve`` call asked for, keyed by its idempotency key."""
+
+    idempotency_key: str
+    warehouse: str
+    items: dict[str, int]
+    reservation_id: str

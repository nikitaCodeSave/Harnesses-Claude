+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+HOLD = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 7)
+    return service
+
+
+def avail(service, warehouse="WH1"):
+    return {sku: service.available(sku, warehouse) for sku in ("MUG", "TEE", "CAP")}
+
+
+# -- holding time ----------------------------------------------------------
+
+
+def test_new_reservation_expires_twenty_minutes_after_reserve(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    assert res.expires_at == clock.now() + HOLD
+
+
+def test_hold_duration_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, hold_duration=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    assert service.reserve("WH1", {"MUG": 1}, "k").expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_reservation_is_active_just_before_expiry(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(HOLD - timedelta(microseconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_expiry_takes_effect_at_exactly_expires_at_without_a_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert stocked.available("MUG", "WH1") == 0
+    clock.set(res.expires_at)
+    # Stock is free before anyone looks at the reservation itself.
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_lapsed_units_can_be_ordered_without_looking_at_the_reservation(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 1})
+    clock.advance(HOLD)
+    assert stocked.place_order("WH1", {"MUG": 10}).status is OrderStatus.PLACED
+
+
+def test_lapsed_units_can_be_reserved_again(stocked, clock):
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    clock.advance(HOLD)
+    assert stocked.reserve("WH1", {"TEE": 5}, "k2").items == {"TEE": 5}
+
+
+def test_finished_reservations_never_change_status_with_time(stocked, clock):
+    confirmed = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    released = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    stocked.confirm_reservation(confirmed.reservation_id)
+    stocked.release_reservation(released.reservation_id)
+    clock.advance(days=3)
+    assert stocked.get_reservation(confirmed.reservation_id).status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation(released.reservation_id).status is ReservationStatus.RELEASED
+
+
+# -- reserve: validation ---------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": 1.0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": "1"}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": True}, InvalidQuantity),
+        ("WH1", {}, InventoryError),
+    ],
+)
+def test_invalid_request_creates_and_holds_nothing(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert avail(stocked) == {"MUG": 10, "TEE": 5, "CAP": 0}
+
+
+@pytest.mark.parametrize("key", ["", "   ", None])
+def test_blank_idempotency_key_is_rejected(stocked, repo, key):
+    with pytest.raises(InventoryError):
+        stocked.reserve("WH1", {"MUG": 1}, key)
+    assert repo.reservations() == []
+
+
+# -- reserve: partial holds ------------------------------------------------
+
+
+def test_holds_are_partial_line_by_line(stocked):

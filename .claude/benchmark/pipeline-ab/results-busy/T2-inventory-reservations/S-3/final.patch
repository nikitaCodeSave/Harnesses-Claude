+"""Reservation behaviour; numbers in comments refer to SPEC.md acceptance criteria."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, Reservation, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+from inventory.reports import StockRow, stock_report
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    service.receive("MUG", "WH2", 3)
+    return service
+
+
+# -- reserving -------------------------------------------------------------
+def test_reserve_creates_active_hold_expiring_in_20_minutes(stocked, clock):  # 1
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    assert isinstance(res, Reservation)
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.order_id is None
+    assert res.warehouse == "WH1"
+    assert res.items == {"MUG": 2, "TEE": 1}
+    assert res.expires_at == clock.now() + TTL
+
+
+def test_reservation_ttl_can_be_configured(repo, ledger, clock):  # 1
+    service = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    res = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert res.expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_reservation_ids_are_distinct(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert first.reservation_id != second.reservation_id
+
+
+def test_partial_hold_takes_what_is_available(stocked):  # 2
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 2}, "k1")
+    assert res.items == {"MUG": 10, "TEE": 2}
+
+
+def test_line_with_nothing_available_is_omitted(stocked):  # 2
+    res = stocked.reserve("WH1", {"MUG": 1, "CAP": 4}, "k1")
+    assert res.items == {"MUG": 1}
+
+
+def test_nothing_available_at_all_raises_and_creates_nothing(stocked, repo):  # 3
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    assert repo.reservations() == []
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": 1.5}, InvalidQuantity),
+        ("WH1", {}, InventoryError),
+    ],
+)
+def test_invalid_request_holds_nothing(stocked, repo, warehouse, items, error):  # 4
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_empty_idempotency_key_is_rejected(stocked):  # 4
+    with pytest.raises(InventoryError):
+        stocked.reserve("WH1", {"MUG": 1}, "")
+
+
+def test_hold_reduces_available_but_not_on_hand_or_allocated(stocked):  # 5
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.held("MUG", "WH1") == 4
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_hold_only_affects_its_warehouse(stocked):  # 5
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    assert stocked.available("MUG", "WH2") == 3
+
+
+def test_later_reserve_sees_earlier_holds(stocked):  # 5
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 5}, "k2")
+    assert second.items == {"MUG": 2}
+
+
+def test_place_order_is_all_or_nothing_against_holds(stocked, repo):  # 5, 6
+    stocked.reserve("WH1", {"MUG": 8}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"MUG": 3})
+    assert repo.orders() == []
+    stocked.place_order("WH1", {"MUG": 2})
+    assert stocked.available("MUG", "WH1") == 0
+
+
+# -- idempotency -----------------------------------------------------------
+def test_replay_returns_same_reservation_without_new_hold(stocked, clock, repo):  # 7
+    first = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    clock.advance(minutes=5)
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "k1")
+    assert again == first
+    assert len(repo.reservations()) == 1
+    assert stocked.held("MUG", "WH1") == 2
+
+
+def test_replay_compares_requested_not_held(stocked):  # 7
+    first = stocked.reserve("WH1", {"MUG": 15}, "k1")
+    assert first.items == {"MUG": 10}
+    assert stocked.reserve("WH1", {"MUG": 15}, "k1").reservation_id == first.reservation_id
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 10}, "k1")
+
+
+def test_replay_returns_current_status(stocked, clock):  # 7
+    released = stocked.reserve("WH1", {"MUG": 1}, "rel")
+    stocked.release_reservation(released.reservation_id)
+    confirmed = stocked.reserve("WH1", {"MUG": 1}, "conf")
+    order = stocked.confirm_reservation(confirmed.reservation_id)
+    expired = stocked.reserve("WH1", {"MUG": 1}, "exp")
+    clock.advance(TTL)
+
+    assert stocked.reserve("WH1", {"MUG": 1}, "rel").status is ReservationStatus.RELEASED
+    replay = stocked.reserve("WH1", {"MUG": 1}, "conf")
+    assert (replay.status, replay.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    replay = stocked.reserve("WH1", {"MUG": 1}, "exp")
+    assert replay.status is ReservationStatus.EXPIRED
+    assert replay.expires_at == expired.expires_at
+    assert stocked.held("MUG", "WH1") == 0
+
+
+def test_same_key_different_items_conflicts(stocked):  # 8
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 1, "TEE": 1}, "k1")
+
+
+def test_same_key_different_warehouse_conflicts(stocked):  # 8
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 1}, "k1")
+
+
+def test_conflict_even_after_reservation_is_finished(stocked, clock):  # 8
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2}, "k1")
+    stocked.reserve("WH1", {"MUG": 1}, "k2")
+    clock.advance(TTL)
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 2}, "k2")
+
+
+def test_failed_reserve_leaves_key_reusable(stocked):  # 9
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "k1")
+    with pytest.raises(UnknownSku):
+        stocked.reserve("WH1", {"NOPE": 1}, "k1")
+    res = stocked.reserve("WH1", {"TEE": 2}, "k1")
+    assert res.items == {"TEE": 2}
+
+
+# -- expiry ----------------------------------------------------------------
+def test_hold_is_active_just_before_expiry(stocked, clock):  # 10
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_hold_expires_at_expires_at_instant_without_sweep(stocked, clock):  # 10
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.held("MUG", "WH1") == 0
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_expired_stock_can_be_reserved_again(stocked, clock):  # 10
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    clock.advance(minutes=25)
+    assert stocked.reserve("WH1", {"MUG": 10}, "k2").items == {"MUG": 10}
+
+
+def test_confirmed_and_released_never_expire(stocked, clock):  # 11
+    a = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    b = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    stocked.confirm_reservation(a.reservation_id)
+    stocked.release_reservation(b.reservation_id)
+    clock.advance(hours=5)
+    assert stocked.get_reservation(a.reservation_id).status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation(b.reservation_id).status is ReservationStatus.RELEASED
+
+
+# -- confirming ------------------------------------------------------------
+def test_confirm_creates_placed_order_and_moves_hold_to_allocation(stocked, repo):  # 12
+    res = stocked.reserve("WH1", {"MUG": 3, "TEE": 2}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert (order.quantity_of("MUG"), order.quantity_of("TEE")) == (3, 2)
+    assert repo.get_order(order.order_id) is order
+    got = stocked.get_reservation(res.reservation_id)
+    assert (got.status, got.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert stocked.held("MUG", "WH1") == 0
+    assert stocked.allocated("MUG", "WH1") == 3
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_confirm_after_partial_hold_orders_only_held_units(stocked):  # 12
+    res = stocked.reserve("WH1", {"MUG": 20, "CAP": 1}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 10}
+
+
+def test_confirm_twice_returns_same_order_even_after_expiry(stocked, clock, repo):  # 13
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    order = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(hours=1)
+    again = stocked.confirm_reservation(res.reservation_id)
+    assert again.order_id == order.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_confirm_expired_raises(stocked, clock, repo):  # 14
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+
+
+def test_confirm_released_raises(stocked):  # 15
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+
+
+def test_confirm_does_not_recheck_stock(stocked):  # 16
+    res = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    stocked.adjust("TEE", "WH1", -3, note="damaged")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.quantity_of("TEE") == 5
+
+
+# -- releasing -------------------------------------------------------------
+def test_release_frees_held_stock(stocked):  # 17
+    res = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_release_released_is_noop(stocked):  # 18
+    res = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    first = stocked.release_reservation(res.reservation_id)
+    assert stocked.release_reservation(res.reservation_id) == first
+
+
+def test_release_expired_is_noop(stocked, clock):  # 18
+    res = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    clock.advance(TTL)
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.EXPIRED
+    assert released.expires_at == res.expires_at
+
+
+def test_release_confirmed_raises(stocked):  # 19
+    res = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    assert stocked.allocated("TEE", "WH1") == 5
+
+
+# -- lookup ----------------------------------------------------------------
+@pytest.mark.parametrize("method", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_is_reported(stocked, method):  # 20
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, method)("RES-9999")
+
+
+def test_mutating_returned_reservation_does_not_change_state(stocked):  # 21
+    res = stocked.reserve("WH1", {"MUG": 2}, "k1")
+    res.items["MUG"] = 9
+    res.status = ReservationStatus.RELEASED
+    assert stocked.held("MUG", "WH1") == 2
+    assert stocked.get_reservation(res.reservation_id).items == {"MUG": 2}
+
+
+# -- compatibility ---------------------------------------------------------
+def test_stock_report_shows_held_column(stocked, repo):  # 22
+    stocked.reserve("WH1", {"TEE": 2}, "k1")
+    stocked.place_order("WH1", {"TEE": 1})
+    row = next(r for r in stock_report(repo, stocked, "WH1") if r.sku == "TEE")
+    assert row == StockRow("TEE", 5, 1, 2, held=2)
+    assert StockRow("CAP", 0, 0, 0).held == 0

+class ReservationStatus(Enum):
+    ACTIVE = "active"
+    CONFIRMED = "confirmed"
+    RELEASED = "released"
+    EXPIRED = "expired"
+
+
+@dataclass
+class Reservation:
+    """A temporary hold on stock for a cart, fulfilled from a single warehouse.
+
+    While ACTIVE and before ``expires_at`` the held units are not available to
+    anyone else. ``items`` holds what was actually granted, which may be less
+    than what was requested.
+    """
+
+    reservation_id: str
+    warehouse: str
+    items: dict[str, int]
+    status: ReservationStatus
+    expires_at: datetime
+    order_id: str | None = None

+# -- confirm -------------------------------------------------------------
+def test_confirm_places_order_for_held_units(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 2}, "cart-1")
+    clock.advance(minutes=3)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert (order.quantity_of("MUG"), order.quantity_of("TEE")) == (10, 2)
+    assert order.placed_at == clock.now()
+    got = stocked.get_reservation(res.reservation_id)
+    assert (got.status, got.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+    assert (stocked.allocated("MUG", "WH1"), stocked.held("MUG", "WH1")) == (10, 0)
+    assert stocked.available("TEE", "WH1") == 3
+
+
+def test_confirm_is_idempotent_even_after_ttl(stocked, clock, repo):

diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..3edc142
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,204 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InventoryError,
+    InvalidReservationState,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+# -- reserve -------------------------------------------------------------
+def test_reserve_holds_stock_and_reduces_available(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "cart-1")
+    assert (res.status, res.items, res.order_id) == (ReservationStatus.ACTIVE, {"MUG": 4}, None)
+    assert res.expires_at == clock.now() + TTL
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (10, 6)
+
+
+def test_reserve_holds_partially_and_skips_empty_lines(stocked):
+    stocked.place_order("WH1", {"TEE": 5})
+    res = stocked.reserve("WH1", {"MUG": 15, "TEE": 1}, "cart-1")
+    assert res.items == {"MUG": 10}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_reserve_fails_when_nothing_can_be_held(stocked, repo):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "cart-1")
+    assert repo.reservations() == []
+
+
+def test_failed_reserve_leaves_key_free(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 1}, "cart-1")
+    stocked.receive("CAP", "WH1", 1)
+    assert stocked.reserve("WH1", {"CAP": 1}, "cart-1").items == {"CAP": 1}
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {}, InventoryError),
+    ],
+)
+def test_invalid_request_holds_nothing(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "cart-1")
+    assert repo.reservations() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_place_order_cannot_take_held_stock(stocked):
+    stocked.reserve("WH1", {"TEE": 4}, "cart-1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2})
+
+
+# -- idempotency ---------------------------------------------------------
+def test_same_key_same_request_returns_existing(stocked, clock):
+    first = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    clock.advance(minutes=5)
+    again = stocked.reserve("WH1", {"MUG": 3}, "cart-1")
+    assert again.reservation_id == first.reservation_id
+    assert again.expires_at == first.expires_at
+    assert stocked.available("MUG", "WH1") == 7
+
+
+def test_retry_compares_requested_not_held_items(stocked):

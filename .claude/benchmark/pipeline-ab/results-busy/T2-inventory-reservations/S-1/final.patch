+"""Stock reservations. Criterion IDs refer to SPEC.md."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+from inventory.reports import StockRow, stock_report
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+def test_new_errors_are_inventory_errors():
+    for error in (ReservationNotFound, ReservationExpired, InvalidReservationState, IdempotencyConflict):
+        assert issubclass(error, InventoryError)
+
+
+# -- availability -------------------------------------------------------------
+def test_hold_reduces_available_but_not_on_hand_or_allocated(stocked):  # A1, A2, A4
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.on_hand("MUG", "WH1") == 10
+    assert stocked.allocated("MUG", "WH1") == 0
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_holds_are_per_warehouse_and_sku(stocked):  # A1
+    stocked.receive("MUG", "WH2", 3)
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert stocked.available("MUG", "WH2") == 3
+    assert stocked.available("TEE", "WH1") == 5
+
+
+def test_stock_report_has_no_hold_column(stocked, repo):  # A2
+    stocked.reserve("WH1", {"TEE": 2}, "k1")
+    row = next(r for r in stock_report(repo, stocked, "WH1") if r.sku == "TEE")
+    assert row == StockRow("TEE", 5, 0, 3)
+
+
+def test_place_order_cannot_take_held_units(stocked):  # A3
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2})
+
+
+def test_reservation_lifecycle_never_writes_ledger(stocked, ledger, clock):  # A4
+    before = len(ledger)
+    a = stocked.reserve("WH1", {"MUG": 1}, "a")
+    b = stocked.reserve("WH1", {"MUG": 1}, "b")
+    c = stocked.reserve("WH1", {"MUG": 1}, "c")
+    stocked.confirm_reservation(a.reservation_id)
+    stocked.release_reservation(b.reservation_id)
+    clock.advance(TTL)
+    stocked.get_reservation(c.reservation_id)
+    assert len(ledger) == before
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_writeoff_is_not_blocked_by_holds(stocked):  # A5
+    held = stocked.reserve("WH1", {"MUG": 8}, "k1")
+    stocked.adjust("MUG", "WH1", -5, note="broken")
+    assert stocked.on_hand("MUG", "WH1") == 5
+    assert stocked.available("MUG", "WH1") == 0
+    again = stocked.get_reservation(held.reservation_id)
+    assert (again.status, again.items) == (ReservationStatus.ACTIVE, {"MUG": 8})
+
+
+def test_receive_is_not_blocked_by_holds(stocked):  # A5
+    stocked.reserve("WH1", {"MUG": 10}, "k1")
+    stocked.receive("MUG", "WH1", 2)
+    assert stocked.available("MUG", "WH1") == 2
+
+
+# -- reserve ------------------------------------------------------------------
+def test_reserve_creates_active_hold_expiring_after_20_minutes(stocked, clock):  # R1
+    r = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    assert r.warehouse == "WH1"
+    assert r.items == {"MUG": 2, "TEE": 1}
+    assert r.status is ReservationStatus.ACTIVE
+    assert r.expires_at == clock.now() + timedelta(minutes=20)
+    assert r.order_id is None
+
+
+def test_reservation_ids_are_unique(stocked):  # R1
+    a = stocked.reserve("WH1", {"MUG": 1}, "a")
+    b = stocked.reserve("WH1", {"MUG": 1}, "b")
+    assert a.reservation_id != b.reservation_id
+
+
+def test_hold_ttl_is_configurable(repo, ledger, clock):  # R1
+    service = InventoryService(repo, ledger, clock, hold_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    r = service.reserve("WH1", {"MUG": 1}, "k1")
+    assert r.expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_reserve_holds_what_is_available_per_line(stocked):  # R2
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 8}, "k1")
+    assert r.items == {"MUG": 3, "TEE": 5}
+    assert stocked.available("TEE", "WH1") == 0
+
+
+def test_line_with_nothing_available_is_left_out(stocked):  # R2
+    r = stocked.reserve("WH1", {"MUG": 3, "CAP": 2}, "k1")
+    assert r.items == {"MUG": 3}
+
+
+def test_reserve_with_nothing_available_creates_nothing(stocked, repo):  # R3
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    assert repo.reservations() == []
+
+
+@pytest.mark.parametrize(
+    ("warehouse", "items", "error"),
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "NOPE": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -2}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": 1.5}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": True}, InvalidQuantity),
+        ("WH1", {}, InventoryError),
+    ],
+)
+def test_invalid_request_holds_nothing(stocked, repo, warehouse, items, error):  # R4
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_empty_idempotency_key_is_rejected(stocked, repo):  # R4
+    with pytest.raises(InventoryError):
+        stocked.reserve("WH1", {"MUG": 1}, "")
+    assert repo.reservations() == []
+
+
+def test_held_units_are_not_available_to_other_reservations(stocked):  # R5
+    stocked.reserve("WH1", {"TEE": 4}, "a")
+    second = stocked.reserve("WH1", {"TEE": 4}, "b")
+    assert second.items == {"TEE": 1}
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"TEE": 1}, "c")
+
+
+# -- idempotency --------------------------------------------------------------
+def test_retry_returns_same_reservation_and_holds_nothing_more(stocked, repo):  # I1
+    first = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    again = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert len(repo.reservations()) == 1
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_retry_compares_requested_not_held_items(stocked):  # I1
+    first = stocked.reserve("WH1", {"TEE": 8}, "k1")
+    assert first.items == {"TEE": 5}
+    again = stocked.reserve("WH1", {"TEE": 8}, "k1")
+    assert again.reservation_id == first.reservation_id
+
+
+def test_retry_after_partial_hold_with_skipped_line_matches(stocked):  # I1
+    first = stocked.reserve("WH1", {"MUG": 1, "CAP": 1}, "k1")
+    assert stocked.reserve("WH1", {"CAP": 1, "MUG": 1}, "k1").reservation_id == first.reservation_id
+
+
+def test_retry_returns_current_state_of_finished_reservation(stocked, clock):  # I1
+    confirmed = stocked.reserve("WH1", {"MUG": 1}, "c")
+    stocked.confirm_reservation(confirmed.reservation_id)
+    released = stocked.reserve("WH1", {"MUG": 1}, "r")
+    stocked.release_reservation(released.reservation_id)
+    expired = stocked.reserve("WH1", {"MUG": 1}, "e")
+    clock.advance(TTL)
+    assert stocked.reserve("WH1", {"MUG": 1}, "c").status is ReservationStatus.CONFIRMED
+    assert stocked.reserve("WH1", {"MUG": 1}, "r").status is ReservationStatus.RELEASED
+    again = stocked.reserve("WH1", {"MUG": 1}, "e")
+    assert (again.reservation_id, again.status) == (expired.reservation_id, ReservationStatus.EXPIRED)
+    assert stocked.available("MUG", "WH1") == 9  # only the confirmed order
+
+
+def test_same_key_different_items_conflicts(stocked):  # I2
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 5}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 4, "TEE": 1}, "k1")
+
+
+def test_same_key_different_warehouse_conflicts(stocked):  # I2, I4
+    stocked.receive("MUG", "WH2", 5)
+    stocked.reserve("WH1", {"MUG": 4}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 4}, "k1")
+
+
+def test_conflict_applies_after_reservation_finished(stocked):  # I2
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH1", {"MUG": 3}, "k1")
+
+
+def test_failed_reserve_does_not_consume_key(stocked):  # I3
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    with pytest.raises(UnknownSku):
+        stocked.reserve("WH1", {"NOPE": 1}, "k2")
+    stocked.receive("CAP", "WH1", 3)
+    assert stocked.reserve("WH1", {"CAP": 2}, "k1").items == {"CAP": 2}
+    assert stocked.reserve("WH1", {"MUG": 1}, "k2").items == {"MUG": 1}
+
+
+# -- expiry -------------------------------------------------------------------
+def test_hold_lapses_without_a_sweep(stocked, clock):  # E1
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_hold_still_counts_just_before_expiry(stocked, clock):  # E2
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(microseconds=1))
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.ACTIVE
+
+
+def test_hold_is_expired_exactly_at_expires_at(stocked, clock):  # E2
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.set(r.expires_at)
+    assert stocked.available("MUG", "WH1") == 10
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+
+
+def test_expired_stock_can_be_reserved_again(stocked, clock):  # E1
+    stocked.reserve("WH1", {"TEE": 5}, "k1")
+    clock.advance(TTL)
+    assert stocked.reserve("WH1", {"TEE": 5}, "k2").items == {"TEE": 5}
+
+
+# -- confirm ------------------------------------------------------------------
+def test_confirm_places_order_for_held_units(stocked, clock, repo):  # C1
+    r = stocked.reserve("WH1", {"MUG": 3, "TEE": 9, "CAP": 1}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(r.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert {line.sku: line.quantity for line in order.lines} == {"MUG": 3, "TEE": 5}
+    assert order.placed_at == clock.now()
+    assert repo.get_order(order.order_id) is order
+    after = stocked.get_reservation(r.reservation_id)
+    assert (after.status, after.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+
+
+def test_confirm_does_not_change_available(stocked):  # C2
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(r.reservation_id)
+    assert (stocked.on_hand("MUG", "WH1"), stocked.allocated("MUG", "WH1")) == (10, 4)
+    assert stocked.available("MUG", "WH1") == 6
+
+
+def test_confirmed_hold_does_not_lapse(stocked, clock):  # C2
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(r.reservation_id)
+    clock.advance(TTL * 3)
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.CONFIRMED
+
+
+def test_confirmed_order_ships_normally(stocked):  # C2
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    order = stocked.confirm_reservation(r.reservation_id)
+    stocked.ship_order(order.order_id)
+    assert (stocked.on_hand("MUG", "WH1"), stocked.available("MUG", "WH1")) == (6, 6)
+
+
+def test_repeated_confirm_returns_same_order(stocked, clock, repo):  # C3
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    first = stocked.confirm_reservation(r.reservation_id)
+    clock.advance(TTL * 2)
+    again = stocked.confirm_reservation(r.reservation_id)
+    assert again.order_id == first.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_confirm_expired_raises_and_creates_no_order(stocked, clock, repo):  # C4
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL + timedelta(minutes=1))
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+    assert stocked.get_reservation(r.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_confirm_released_is_invalid(stocked, repo):  # C5
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(r.reservation_id)
+    assert repo.orders() == []
+
+
+# -- release ------------------------------------------------------------------
+def test_release_frees_units_immediately(stocked):  # L1
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    released = stocked.release_reservation(r.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_release_twice_returns_it_unchanged(stocked):  # L2
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.release_reservation(r.reservation_id)
+    again = stocked.release_reservation(r.reservation_id)
+    assert again.status is ReservationStatus.RELEASED
+
+
+def test_release_expired_returns_it_as_expired(stocked, clock):  # L3
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    released = stocked.release_reservation(r.reservation_id)
+    assert released.status is ReservationStatus.EXPIRED
+
+
+def test_release_confirmed_is_invalid(stocked):  # L4
+    r = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    stocked.confirm_reservation(r.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(r.reservation_id)
+    assert stocked.allocated("MUG", "WH1") == 4
+
+
+# -- lookup -------------------------------------------------------------------
+@pytest.mark.parametrize("action", ["get_reservation", "confirm_reservation", "release_reservation"])
+def test_unknown_reservation_is_reported(stocked, action):  # G1
+    with pytest.raises(ReservationNotFound):
+        getattr(stocked, action)("RES-9999")

+    # -- reservations ----------------------------------------------------
+    def reserve(self, warehouse: str, items: Mapping[str, int], idempotency_key: str) -> Reservation:
+        """Hold stock for a cart until it is confirmed, released or expires.
+
+        Partial: each line holds what is available now, up to what was asked;
+        lines with nothing available are left out. Fails with InsufficientStock
+        only if no line can hold anything. Repeating a call with the same key
+        and request returns the original reservation.
+        """
+        wanted = self._validate_items(warehouse, items)
+        known = self._repo.lookup_key(idempotency_key)
+        if known is not None:
+            reservation_id, known_warehouse, known_items = known
+            if (known_warehouse, known_items) != (warehouse, wanted):
+                raise IdempotencyConflict(idempotency_key)
+            return self.get_reservation(reservation_id)
+
+        held: dict[str, int] = {}
+        for sku, quantity in wanted.items():
+            take = min(quantity, self.available(sku, warehouse))
+            if take > 0:
+                held[sku] = take
+        if not held:
+            sku, quantity = next(iter(wanted.items()))
+            raise InsufficientStock(sku, warehouse, quantity, 0)
+
+        reservation = Reservation(
+            reservation_id=self._repo.next_reservation_id(),
+            warehouse=warehouse,
+            items=held,
+            status=ReservationStatus.ACTIVE,
+            expires_at=self._clock.now() + self._reservation_ttl,
+        )
+        self._repo.save_reservation(reservation)
+        self._repo.remember_key(idempotency_key, (reservation.reservation_id, warehouse, wanted))
+        return reservation
+
+    def get_reservation(self, reservation_id: str) -> Reservation:
+        reservation = self._repo.get_reservation(reservation_id)
+        self._apply_expiry(reservation)
+        return reservation

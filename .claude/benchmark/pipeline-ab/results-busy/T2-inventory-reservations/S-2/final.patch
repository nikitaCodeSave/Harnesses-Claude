+            )
+            if not self._apply_expiry(reservation)
+        )
+
+    def _apply_expiry(self, reservation: Reservation) -> bool:
+        """Mark an ACTIVE reservation EXPIRED once its time is up. True if expired."""
+        if reservation.status is ReservationStatus.ACTIVE and (
+            self._clock.now() >= reservation.expires_at
+        ):
+            reservation.status = ReservationStatus.EXPIRED
+            self._repo.save_reservation(reservation)
+        return reservation.status is ReservationStatus.EXPIRED

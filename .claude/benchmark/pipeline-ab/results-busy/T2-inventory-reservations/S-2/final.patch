+"""Stock reservations. Numbers in test names refer to SPEC.md acceptance criteria."""
+
+from datetime import timedelta
+
+import pytest
+
+from inventory import InventoryService, OrderStatus, ReservationStatus
+from inventory.errors import (
+    IdempotencyConflict,
+    InsufficientStock,
+    InvalidOrder,
+    InvalidQuantity,
+    InvalidReservationState,
+    InventoryError,
+    ReservationExpired,
+    ReservationNotFound,
+    UnknownSku,
+    UnknownWarehouse,
+)
+
+TTL = timedelta(minutes=20)
+
+
+@pytest.fixture
+def stocked(service):
+    service.receive("MUG", "WH1", 10)
+    service.receive("TEE", "WH1", 5)
+    return service
+
+
+# -- reserve -------------------------------------------------------------
+def test_01_reserve_creates_active_hold_expiring_in_20_minutes(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert res.status is ReservationStatus.ACTIVE
+    assert res.warehouse == "WH1"
+    assert res.items == {"MUG": 3}
+    assert res.expires_at == clock.now() + TTL
+    assert res.order_id is None
+
+
+def test_01_hold_duration_is_configurable(repo, ledger, clock):
+    service = InventoryService(repo, ledger, clock, reservation_ttl=timedelta(minutes=5))
+    service.receive("MUG", "WH1", 1)
+    assert service.reserve("WH1", {"MUG": 1}, "k").expires_at == clock.now() + timedelta(minutes=5)
+
+
+def test_02_reservation_ids_are_sequential(stocked):
+    first = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    second = stocked.reserve("WH1", {"MUG": 1}, "k2")
+    assert (first.reservation_id, second.reservation_id) == ("RES-0001", "RES-0002")
+
+
+def test_03_reserve_is_partial_and_omits_empty_lines(stocked):
+    stocked.place_order("WH1", {"MUG": 8})
+    res = stocked.reserve("WH1", {"MUG": 5, "TEE": 2, "CAP": 4}, "k1")
+    assert res.items == {"MUG": 2, "TEE": 2}
+    assert stocked.available("MUG", "WH1") == 0
+
+
+def test_04_reserve_with_nothing_available_fails_and_creates_nothing(stocked, repo):
+    with pytest.raises(InsufficientStock) as err:
+        stocked.reserve("WH2", {"CAP": 2, "MUG": 1}, "k1")
+    assert (err.value.sku, err.value.requested, err.value.available) == ("CAP", 2, 0)
+    assert repo.reservations() == []
+
+
+@pytest.mark.parametrize(
+    "warehouse, items, error",
+    [
+        ("NOPE", {"MUG": 1}, UnknownWarehouse),
+        ("WH1", {"MUG": 1, "GHOST": 1}, UnknownSku),
+        ("WH1", {"MUG": 1, "TEE": 0}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": -1}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": True}, InvalidQuantity),
+        ("WH1", {"MUG": 1, "TEE": 1.5}, InvalidQuantity),
+        ("WH1", {}, InvalidOrder),
+    ],
+)
+def test_05_rejected_request_holds_nothing(stocked, repo, warehouse, items, error):
+    with pytest.raises(error):
+        stocked.reserve(warehouse, items, "k1")
+    assert repo.reservations() == []
+    assert stocked.available("MUG", "WH1") == 10
+
+
+# -- idempotency ---------------------------------------------------------
+def test_06_retry_with_same_key_returns_original(stocked):
+    first = stocked.reserve("WH1", {"MUG": 2, "TEE": 1}, "k1")
+    again = stocked.reserve("WH1", {"TEE": 1, "MUG": 2}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert stocked.available("MUG", "WH1") == 8
+
+
+def test_06_retry_compares_request_not_held_units(stocked, clock):
+    first = stocked.reserve("WH1", {"TEE": 9}, "k1")
+    stocked.receive("TEE", "WH1", 10)
+    clock.advance(minutes=1)
+    again = stocked.reserve("WH1", {"TEE": 9}, "k1")
+    assert again.reservation_id == first.reservation_id
+    assert (again.items, again.expires_at) == ({"TEE": 5}, first.expires_at)
+
+
+def test_06_retry_returns_current_status(stocked, clock):
+    stocked.reserve("WH1", {"MUG": 1}, "expired")
+    released = stocked.reserve("WH1", {"MUG": 1}, "released")
+    confirmed = stocked.reserve("WH1", {"MUG": 1}, "confirmed")
+    stocked.release_reservation(released.reservation_id)
+    stocked.confirm_reservation(confirmed.reservation_id)
+    clock.advance(TTL)
+    statuses = [
+        stocked.reserve("WH1", {"MUG": 1}, key).status
+        for key in ("expired", "released", "confirmed")
+    ]
+    assert statuses == [
+        ReservationStatus.EXPIRED,
+        ReservationStatus.RELEASED,
+        ReservationStatus.CONFIRMED,
+    ]
+    assert stocked.available("MUG", "WH1") == 9
+
+
+@pytest.mark.parametrize(
+    "warehouse, items", [("WH2", {"MUG": 2}), ("WH1", {"MUG": 3}), ("WH1", {"MUG": 2, "TEE": 1})]
+)
+def test_07_same_key_different_request_conflicts(stocked, repo, warehouse, items):
+    stocked.reserve("WH1", {"MUG": 2}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve(warehouse, items, "k1")
+    assert len(repo.reservations()) == 1
+    assert stocked.available("MUG", "WH1") == 8
+
+
+def test_08_failed_reserve_does_not_use_up_key(stocked):
+    with pytest.raises(InsufficientStock):
+        stocked.reserve("WH1", {"CAP": 2}, "k1")
+    stocked.receive("CAP", "WH1", 2)
+    assert stocked.reserve("WH1", {"CAP": 2}, "k1").items == {"CAP": 2}
+
+
+def test_09_keys_are_global_across_warehouses(stocked):
+    stocked.receive("MUG", "WH2", 5)
+    stocked.reserve("WH1", {"MUG": 1}, "k1")
+    with pytest.raises(IdempotencyConflict):
+        stocked.reserve("WH2", {"MUG": 1}, "k1")
+
+
+# -- availability --------------------------------------------------------
+def test_10_holds_reduce_available_but_not_allocated(stocked):
+    stocked.place_order("WH1", {"MUG": 2})
+    stocked.reserve("WH1", {"MUG": 3}, "k1")
+    assert stocked.allocated("MUG", "WH1") == 2
+    assert stocked.available("MUG", "WH1") == 5
+
+
+def test_11_place_order_cannot_take_held_stock(stocked):
+    stocked.reserve("WH1", {"TEE": 4}, "k1")
+    with pytest.raises(InsufficientStock):
+        stocked.place_order("WH1", {"TEE": 2})
+
+
+def test_12_reservations_never_touch_the_ledger(stocked, ledger, clock):
+    before = len(ledger)
+    a = stocked.reserve("WH1", {"MUG": 1}, "a")
+    b = stocked.reserve("WH1", {"MUG": 1}, "b")
+    stocked.reserve("WH1", {"MUG": 1}, "c")
+    stocked.confirm_reservation(a.reservation_id)
+    stocked.release_reservation(b.reservation_id)
+    clock.advance(TTL)
+    stocked.available("MUG", "WH1")
+    assert len(ledger) == before
+    assert stocked.on_hand("MUG", "WH1") == 10
+
+
+def test_13_write_off_below_holds_is_allowed(stocked):
+    res = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    stocked.adjust("TEE", "WH1", -3, "damaged")
+    stocked.receive("TEE", "WH1", 1)
+    assert stocked.on_hand("TEE", "WH1") == 3
+    assert stocked.available("TEE", "WH1") == 0
+    assert stocked.get_reservation(res.reservation_id).items == {"TEE": 5}
+
+
+# -- expiry --------------------------------------------------------------
+def test_14_hold_lapses_at_expiry_without_a_sweep(stocked, clock):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL - timedelta(seconds=1))
+    assert stocked.available("MUG", "WH1") == 6
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.ACTIVE
+    clock.advance(seconds=1)
+    assert stocked.available("MUG", "WH1") == 10
+    assert stocked.get_reservation(res.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_14_expired_hold_cannot_be_confirmed(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 4}, "k1")
+    clock.advance(TTL)
+    with pytest.raises(ReservationExpired):
+        stocked.confirm_reservation(res.reservation_id)
+    assert repo.orders() == []
+
+
+def test_15_final_states_never_expire(stocked, clock):
+    confirmed = stocked.reserve("WH1", {"MUG": 1}, "a")
+    released = stocked.reserve("WH1", {"MUG": 1}, "b")
+    stocked.confirm_reservation(confirmed.reservation_id)
+    stocked.release_reservation(released.reservation_id)
+    clock.advance(hours=1)
+    assert stocked.get_reservation(confirmed.reservation_id).status is ReservationStatus.CONFIRMED
+    assert stocked.get_reservation(released.reservation_id).status is ReservationStatus.RELEASED
+
+
+# -- confirm -------------------------------------------------------------
+def test_16_confirm_places_order_for_held_units(stocked, clock):
+    stocked.place_order("WH1", {"TEE": 3})
+    res = stocked.reserve("WH1", {"MUG": 2, "TEE": 4}, "k1")
+    clock.advance(minutes=5)
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.status is OrderStatus.PLACED
+    assert order.warehouse == "WH1"
+    assert (order.quantity_of("MUG"), order.quantity_of("TEE")) == (2, 2)
+    assert order.placed_at == clock.now()
+    after = stocked.get_reservation(res.reservation_id)
+    assert (after.status, after.order_id) == (ReservationStatus.CONFIRMED, order.order_id)
+
+
+def test_17_confirm_does_not_change_available(stocked):
+    res = stocked.reserve("WH1", {"MUG": 3}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    assert stocked.available("MUG", "WH1") == 7
+    assert stocked.allocated("MUG", "WH1") == 3
+
+
+def test_18_confirm_does_not_recheck_stock(stocked):
+    res = stocked.reserve("WH1", {"TEE": 5}, "k1")
+    stocked.adjust("TEE", "WH1", -4, "write-off")
+    order = stocked.confirm_reservation(res.reservation_id)
+    assert order.quantity_of("TEE") == 5
+    with pytest.raises(InsufficientStock):
+        stocked.ship_order(order.order_id)
+
+
+def test_19_confirm_twice_returns_same_order_even_after_expiry(stocked, clock, repo):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    first = stocked.confirm_reservation(res.reservation_id)
+    clock.advance(TTL * 2)
+    assert stocked.confirm_reservation(res.reservation_id).order_id == first.order_id
+    assert len(repo.orders()) == 1
+
+
+def test_20_cannot_confirm_released(stocked):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    stocked.release_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.confirm_reservation(res.reservation_id)
+
+
+# -- release -------------------------------------------------------------
+def test_21_release_frees_held_units(stocked):
+    res = stocked.reserve("WH1", {"MUG": 6}, "k1")
+    released = stocked.release_reservation(res.reservation_id)
+    assert released.status is ReservationStatus.RELEASED
+    assert stocked.available("MUG", "WH1") == 10
+
+
+def test_22_release_is_safe_to_repeat_and_ignores_expired(stocked, clock):
+    a = stocked.reserve("WH1", {"MUG": 1}, "a")
+    b = stocked.reserve("WH1", {"MUG": 1}, "b")
+    stocked.release_reservation(a.reservation_id)
+    assert stocked.release_reservation(a.reservation_id).status is ReservationStatus.RELEASED
+    clock.advance(TTL)
+    assert stocked.release_reservation(b.reservation_id).status is ReservationStatus.EXPIRED
+
+
+def test_23_cannot_release_confirmed(stocked):
+    res = stocked.reserve("WH1", {"MUG": 1}, "k1")
+    stocked.confirm_reservation(res.reservation_id)
+    with pytest.raises(InvalidReservationState):
+        stocked.release_reservation(res.reservation_id)
+    assert stocked.allocated("MUG", "WH1") == 1
+

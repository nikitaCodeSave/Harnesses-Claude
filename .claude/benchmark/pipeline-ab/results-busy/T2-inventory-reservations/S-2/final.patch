+def test_25_stock_report_available_reflects_holds(stocked, repo):
+    from inventory.reports import StockRow, stock_report
+
+    stocked.place_order("WH1", {"TEE": 1})
+    stocked.reserve("WH1", {"TEE": 2}, "k1")
+    assert [r for r in stock_report(repo, stocked, "WH1") if r.sku == "TEE"] == [

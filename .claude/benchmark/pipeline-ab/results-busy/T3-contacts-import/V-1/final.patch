+"""CSV import of contacts.
+
+Reads files in the format written by ``export.export_csv``: a header row with
+the columns name, email, phone and tags (tags joined with TAG_SEPARATOR in one
+cell). Header names are matched case-insensitively and may come in any order;
+name and email are required, phone and tags are optional.
+
+Each row is checked on its own: valid rows are stored, invalid rows are skipped
+and reported, so one typo doesn't block the rest of the file. Problems with the
+file as a whole raise ImportFileError before anything is stored.
+
+A row whose email is already in the repository updates that contact. Non-blank
+cells overwrite the stored value (a tags cell replaces the whole tag set);
+blank cells keep it, so a spreadsheet with gaps never erases data we have.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from typing import TypeVar
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+REQUIRED_COLUMNS = ("name", "email")
+HEADER_ROW = 1
+
+T = TypeVar("T")
+
+
+@dataclass
+class RowIssue:
+    """A problem found in the file.
+
+    ``row`` is the spreadsheet row number (the header is row 1, the first
+    contact row 2); ``column`` is the header name the issue is about, or None
+    when it concerns the whole row.
+    """
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did.
+
+    ``created`` and ``updated`` hold normalised emails in file order; a row that
+    matches an existing contact without changing it appears in neither. Rows
+    listed in ``errors`` were skipped; ``warnings`` did not stop anything.
+    """
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _RowValues:
+    """Normalised values of one row; None means the cell was blank."""
+
+    name: str | None
+    email: str
+    phone: str | None
+    tags: frozenset[str] | None
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV ``data``.
+
+    ``data`` is the file content, either raw bytes (UTF-8, with or without a
+    BOM) or already-decoded text. Raises ImportFileError if the file can't be
+    read as a whole; in that case ``repo`` is left untouched.
+    """
+    columns, rows = _parse(_decode(data))
+    report = ImportReport()
+    for column in columns:
+        if column and column not in EXPORT_COLUMNS:
+            report.warnings.append(
+                RowIssue(HEADER_ROW, column, "unknown column, its values are ignored")
+            )
+
+    first_row_for_email: dict[str, int] = {}
+    for row_number, cells in enumerate(rows, start=HEADER_ROW + 1):
+        if not any(cell.strip() for cell in cells):
+            continue
+        values = _read_row(row_number, columns, cells, report)
+        if values is None:
+            continue
+        if values.email in first_row_for_email:
+            report.errors.append(
+                RowIssue(
+                    row_number,
+                    "email",
+                    f"{values.email} already appears in row "
+                    f"{first_row_for_email[values.email]}; row skipped",
+                )
+            )
+            continue
+        first_row_for_email[values.email] = row_number
+        _apply(repo, row_number, values, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                "file is not UTF-8 text; save it from the spreadsheet as "
+                "'CSV UTF-8' and try again"
+            ) from None
+    elif isinstance(data, str):
+        text = data.removeprefix("\ufeff")
+    else:
+        raise TypeError(f"data must be str or bytes, not {type(data).__name__}")
+    if "\x00" in text:
+        raise ImportFileError("file is not a CSV text file")
+    return text
+
+
+def _parse(text: str) -> tuple[list[str], list[list[str]]]:
+    """Split the text into header columns and data rows, checking the header."""
+    # strict: an unbalanced quote would otherwise swallow the rest of the file
+    # into one cell without any error.
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    try:
+        records = list(reader)
+    except csv.Error as exc:
+        raise ImportFileError(
+            f"file is not valid CSV (line {reader.line_num}): {exc}"
+        ) from None
+    if not records or not any(cell.strip() for cell in records[0]):
+        raise ImportFileError("file is empty or has no header row")
+
+    columns = [cell.strip().lower() for cell in records[0]]
+    duplicates = sorted({c for c in columns if c and columns.count(c) > 1})
+    if duplicates:
+        raise ImportFileError(f"header repeats column(s): {', '.join(duplicates)}")
+    missing = [column for column in REQUIRED_COLUMNS if column not in columns]
+    if missing:
+        message = (
+            f"header is missing column(s): {', '.join(missing)} "
+            f"(expected {','.join(EXPORT_COLUMNS)})"
+        )
+        if len(columns) == 1 and ";" in columns[0]:
+            message += "; the file looks semicolon-separated, columns must be separated by commas"
+        raise ImportFileError(message)
+    return columns, records[1:]
+
+
+def _read_row(
+    row_number: int, columns: list[str], cells: list[str], report: ImportReport
+) -> _RowValues | None:
+    """Validate one row; report its errors and return None if it can't be used."""
+    if any(cell.strip() for cell in cells[len(columns) :]):
+        report.errors.append(
+            RowIssue(
+                row_number,
+                None,
+                f"row has {len(cells)} cells but the header has {len(columns)} columns; "
+                "row skipped",
+            )
+        )
+        return None
+
+    raw = {column: cells[i].strip() if i < len(cells) else "" for i, column in enumerate(columns)}
+    issues: list[RowIssue] = []
+
+    def check(column: str, normalise: Callable[[str], T]) -> T | None:
+        try:
+            return normalise(raw[column]) if raw.get(column) else None
+        except ValidationError as exc:
+            issues.append(RowIssue(row_number, column, exc.message))
+            return None
+
+    if not raw["email"]:
+        issues.append(RowIssue(row_number, "email", "is required"))
+    email = check("email", normalize_email)
+    name = check("name", validate_name)
+    phone = check("phone", normalize_phone)
+    tags = check("tags", _split_tags)
+
+    report.errors.extend(issues)
+    if issues or email is None:
+        return None
+    return _RowValues(name=name, email=email, phone=phone, tags=tags)
+
+
+def _split_tags(cell: str) -> frozenset[str] | None:
+    """Tags from one cell; None if it holds only separators."""
+    tags = normalize_tags(tag for tag in cell.split(TAG_SEPARATOR) if tag.strip())
+    return tags or None
+
+
+def _apply(
+    repo: InMemoryContactRepository, row_number: int, values: _RowValues, report: ImportReport
+) -> None:
+    existing = repo.find(values.email)
+    if existing is None:
+        if values.name is None:
+            report.errors.append(
+                RowIssue(row_number, "name", "is required for a new contact")
+            )
+            return
+        repo.add(
+            Contact(
+                name=values.name,
+                email=values.email,
+                phone=values.phone,
+                tags=values.tags or frozenset(),
+            )
+        )
+        report.created.append(values.email)
+        return
+
+    updated = Contact(
+        name=values.name if values.name is not None else existing.name,
+        email=existing.email,
+        phone=values.phone if values.phone is not None else existing.phone,
+        tags=values.tags if values.tags is not None else existing.tags,
+    )
+    if updated != existing:
+        repo.update(updated)
+        report.updated.append(values.email)

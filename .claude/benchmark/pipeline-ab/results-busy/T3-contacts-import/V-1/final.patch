@@ -0,0 +1,186 @@
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def test_import_creates_contacts_with_normalised_values():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        HEADER
+        + "  Ann   Lee ,Ann@Example.COM,+1 (555) 123-4567,VIP; Key Account\n"
+        + "Bob Stone,bob@example.com,,\n",
+    )
+    assert report == ImportReport(created=["ann@example.com", "bob@example.com"])
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"vip", "key-account"}),
+    )
+    assert repo.get("bob@example.com") == Contact(name="Bob Stone", email="bob@example.com")
+
+
+def test_export_then_import_round_trips():
+    contacts = [
+        Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip", "lead"]),
+        Contact.create('Bob "Bobby" Stone, Jr.', "bob@example.com"),
+    ]
+    repo = InMemoryContactRepository()
+    import_contacts(repo, export_csv(contacts).encode())
+    assert repo.all() == contacts
+
+
+def test_bytes_with_excel_bom_and_crlf_are_accepted():
+    data = "\ufeffName,Email\r\nZoë Ångström,zoe@example.com\r\n".encode("utf-8")
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["zoe@example.com"]
+    assert repo.get("zoe@example.com").name == "Zoë Ångström"
+
+
+def test_text_with_bom_is_accepted():
+    report = import_contacts(InMemoryContactRepository(), "\ufeff" + HEADER + "Ann,ann@example.com,,\n")
+    assert report.created == ["ann@example.com"]
+
+
+def test_columns_may_be_reordered_and_optional_ones_omitted():
+    repo = InMemoryContactRepository()
+    import_contacts(repo, "EMAIL , name\nann@example.com,Ann Lee\n")
+    assert repo.get("ann@example.com") == Contact(name="Ann Lee", email="ann@example.com")
+
+
+def test_invalid_rows_are_reported_and_skipped_the_rest_is_imported():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        HEADER
+        + "Ann Lee,not-an-email,abc,\n"
+        + "Bob Stone,bob@example.com,,\n"
+        + ",,,vip\n"
+        + "Cid,cid@example.com,,bad!tag\n",
+    )
+    assert report.created == ["bob@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [
+        (2, "email"),
+        (2, "phone"),
+        (4, "email"),
+        (5, "tags"),
+    ]
+    assert report.errors[2].message == "is required"
+    assert [c.email for c in repo.all()] == ["bob@example.com"]
+
+
+def test_existing_contact_is_updated_and_blank_cells_keep_stored_values():
+    repo = InMemoryContactRepository(
+        [Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip"])]
+    )
+    report = import_contacts(repo, HEADER + "Ann Lee-Smith,ANN@example.com,,\n")
+    assert report == ImportReport(updated=["ann@example.com"])
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee-Smith",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"vip"}),
+    )
+
+
+def test_update_with_blank_name_keeps_name_and_tags_cell_replaces_tags():
+    repo = InMemoryContactRepository([Contact.create("Ann Lee", "ann@example.com", tags=["vip"])])
+    import_contacts(repo, HEADER + ",ann@example.com,555-123-4567,lead\n")
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=frozenset({"lead"})
+    )
+
+
+def test_unchanged_existing_contact_is_not_reported_as_updated():
+    repo = InMemoryContactRepository([Contact.create("Ann Lee", "ann@example.com")])
+    report = import_contacts(repo, HEADER + "Ann Lee,ann@example.com,,\n")
+    assert report == ImportReport()
+
+
+def test_new_contact_without_name_is_an_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + ",ann@example.com,,\n")
+    assert report.errors == [RowIssue(2, "name", "is required for a new contact")]
+    assert len(repo) == 0
+
+
+def test_repeated_email_in_file_keeps_first_row_and_reports_the_rest():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + "Ann Lee,ann@example.com,,\nAnn Other,Ann@Example.com,,\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [
+        RowIssue(3, "email", "ann@example.com already appears in row 2; row skipped")
+    ]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_row_numbers_match_spreadsheet_rows_with_blank_and_multiline_rows():
+    report = import_contacts(
+        InMemoryContactRepository(),
+        HEADER + '"Ann\nLee",ann@example.com,,\n\n,,,\nBob,bad,,\n',
+    )
+    assert report.created == ["ann@example.com"]
+    assert [e.row for e in report.errors] == [5]
+
+
+def test_row_with_extra_cells_is_rejected_but_trailing_empty_cells_are_fine():
+    report = import_contacts(
+        InMemoryContactRepository(),
+        HEADER + "Ann,ann@example.com,,,,\nBob,bob@example.com,,,surprise\n",
+    )
+    assert report.created == ["ann@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [(3, None)]
+
+
+def test_short_rows_treat_missing_cells_as_blank():
+    report = import_contacts(InMemoryContactRepository(), HEADER + "Ann,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+
+
+def test_unknown_columns_are_ignored_with_a_warning():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "name,email,company\nAnn,ann@example.com,Acme\n")
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == [RowIssue(1, "company", "unknown column, its values are ignored")]
+
+
+@pytest.mark.parametrize(
+    ("data", "fragment"),
+    [
+        ("", "empty"),
+        (b"", "empty"),
+        ("\n\n", "empty"),
+        ("name,phone\nAnn,555\n", "missing column(s): email"),
+        ("name;email;phone;tags\nAnn;ann@example.com;;\n", "semicolon"),
+        ("name,email,Email\n", "repeats column(s): email"),
+        ("name,email\nAnn,ann@example.com\n".encode("cp1252") + b"Zo\xeb,zoe@example.com\n", "UTF-8"),
+        ('name,email\n"Ann,ann@example.com\nBob,bob@example.com\n', "not valid CSV"),
+    ],
+)
+def test_file_level_problems_raise_and_store_nothing(data, fragment):
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError) as excinfo:
+        import_contacts(repo, data)
+    assert fragment in str(excinfo.value)
+    assert isinstance(excinfo.value, ContactError)
+    assert len(repo) == 0
+
+
+def test_non_text_data_is_a_type_error():
+    with pytest.raises(TypeError):
+        import_contacts(InMemoryContactRepository(), None)  # type: ignore[arg-type]
+
+
+def test_blank_header_cells_are_ignored_silently():
+    report = import_contacts(InMemoryContactRepository(), "name,email,,\nAnn,ann@example.com,,\n")
+    assert report == ImportReport(created=["ann@example.com"])

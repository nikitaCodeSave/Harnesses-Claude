index 0000000..221e388
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,461 @@
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError, ValidationError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+from contactbook.validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+
+def message_of(validator, raw):
+    with pytest.raises(ValidationError) as excinfo:
+        validator(raw)
+    return excinfo.value.message
+
+
+def contacts(repo):
+    return {contact.email: contact for contact in repo.all()}
+
+
+def run(text, repo=None):
+    repo = repo if repo is not None else InMemoryContactRepository()
+    return repo, import_contacts(repo, text)
+
+
+# Input and encoding
+
+
+def test_bytes_and_str_give_the_same_result():
+    text = "name,email,tags\nAnn Lee,Ann@Example.com,VIP\nBad,nope,\n"
+    repo_s, report_s = run(text)
+    repo_b, report_b = run(text.encode("utf-8"))
+    assert report_s == report_b
+    assert repo_s.all() == repo_b.all()
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "name,email\nZoë,zoe@example.com\n".encode("utf-8"),
+        b"\xef\xbb\xbf" + "name,email\nZoë,zoe@example.com\n".encode("utf-8"),
+        "\ufeffname,email\nZoë,zoe@example.com\n",
+    ],
+)
+def test_utf8_with_or_without_bom(data):
+    repo, report = run(data)

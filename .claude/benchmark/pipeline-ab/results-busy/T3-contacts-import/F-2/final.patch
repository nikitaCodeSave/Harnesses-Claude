+def rows(count, blank_every=0):
+    lines = ["name,email"]
+    for i in range(count):
+        if blank_every and i % blank_every == 0:
+            lines.append(",")
+            lines.append("")
+        lines.append(f"Person {i},p{i}@example.com")
+    return "\n".join(lines) + "\n"

@@ -0,0 +1,250 @@
+"""CSV import of contacts.
+
+Reads the format written by :func:`contactbook.export.export_csv` (and the
+variations spreadsheets produce), creates or updates contacts row by row and
+reports what happened. Rows are numbered the way a spreadsheet numbers lines:
+the header is row 1, and every physical line counts.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_CONTACT_ROWS = 1000
+
+_BOM = "\ufeff"
+_FIELD_ORDER = ("name", "email", "phone", "tags")
+
+
+@dataclass
+class RowIssue:
+    """A problem found on one row; ``column`` is None when it concerns the whole row."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _Columns:
+    """Positions of the recognised columns in the header."""
+
+    email: int
+    name: int | None
+    first_name: int | None
+    last_name: int | None
+    phone: int | None
+    tags: int | None
+    width: int
+
+
+@dataclass(frozen=True)
+class _Row:
+    number: int
+    cells: list[str]
+
+    def cell(self, index: int | None) -> str:
+        if index is None or index >= len(self.cells):
+            return ""
+        return self.cells[index]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts from CSV file content.
+
+    Valid rows are applied and invalid ones are reported and skipped. Raises
+    ImportFileError, leaving ``repo`` untouched, if the file as a whole can't
+    be imported.
+    """
+    rows = _parse(_decode(data))
+    if not rows or all(_is_blank(row.cells) for row in rows):
+        raise ImportFileError("the file is empty")
+
+    report = ImportReport()
+    header, *data_rows = rows
+    columns = _read_header(header.cells, report)
+
+    contact_rows = [row for row in data_rows if not _is_blank(row.cells)]
+    if len(contact_rows) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(contact_rows)} contacts; "
+            f"at most {MAX_CONTACT_ROWS} can be imported at once"
+        )
+
+    first_row_by_email: dict[str, int] = {}
+    for row in contact_rows:
+        if any(cell.strip() for cell in row.cells[columns.width :]):
+            report.warnings.append(
+                RowIssue(row.number, None, "cells beyond the last column were ignored")
+            )
+        contact, issues = _read_contact(row, columns, first_row_by_email)
+        report.errors.extend(issues)
+        if contact is not None:
+            _apply(repo, contact, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, (bytes, bytearray)):
+        try:
+            return bytes(data).decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and try again'
+            ) from None
+    if isinstance(data, str):
+        return data.removeprefix(_BOM)
+    raise TypeError(f"expected str or bytes, got {type(data).__name__}")
+
+
+def _parse(text: str) -> list[_Row]:
+    """Split the text into records, each numbered by the line it starts on."""
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    rows = []
+    last_line = 0
+    try:
+        for cells in reader:
+            rows.append(_Row(last_line + 1, cells))
+            last_line = reader.line_num
+    except csv.Error as exc:
+        raise ImportFileError(
+            f"the file is not valid CSV (line {reader.line_num}): {exc}"
+        ) from None
+    return rows
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _read_header(cells: list[str], report: ImportReport) -> _Columns:
+    if len(cells) == 1 and ";" in cells[0]:
+        raise ImportFileError(
+            "the file looks semicolon-separated; save it as comma-separated CSV"
+        )
+
+    positions: dict[str, int] = {}
+    for index, cell in enumerate(cells):
+        key = cell.strip().lower()
+        if not key:
+            continue
+        if key in positions:
+            raise ImportFileError(f"the header has the column {cell.strip()!r} twice")
+        positions[key] = index
+
+    if "name" in positions:
+        name_keys = {"name"}
+    elif "first_name" in positions and "last_name" in positions:
+        name_keys = {"first_name", "last_name"}
+    else:
+        name_keys = set()
+
+    missing = []
+    if "email" not in positions:
+        missing.append("email")
+    if not name_keys:
+        missing.append("name (or first_name and last_name)")
+    if missing:
+        raise ImportFileError(f"the header is missing required columns: {', '.join(missing)}")
+
+    known = {"email", "phone", "tags"} | name_keys
+    unknown = [
+        cell.strip() or f"(unnamed column {index + 1})"
+        for index, cell in enumerate(cells)
+        if cell.strip().lower() not in known
+    ]
+    if unknown:
+        report.warnings.append(
+            RowIssue(1, None, f"unknown columns were ignored: {', '.join(unknown)}")
+        )
+
+    def position(key: str) -> int | None:
+        return positions.get(key) if key in known else None
+
+    return _Columns(
+        email=positions["email"],
+        name=position("name"),
+        first_name=position("first_name"),
+        last_name=position("last_name"),
+        phone=position("phone"),
+        tags=position("tags"),
+        width=len(cells),
+    )
+
+
+def _read_contact(
+    row: _Row, columns: _Columns, first_row_by_email: dict[str, int]
+) -> tuple[Contact | None, list[RowIssue]]:
+    """Validate one contact row; return the contact, or None and the row's errors."""
+    errors: dict[str, str] = {}
+
+    def check(column: str, validate, raw):
+        try:
+            return validate(raw)
+        except ValidationError as exc:
+            errors[column] = exc.message
+            return None
+
+    if columns.name is not None:
+        raw_name = row.cell(columns.name)
+    else:
+        parts = (row.cell(columns.first_name), row.cell(columns.last_name))
+        raw_name = " ".join(part for part in parts if part.strip())
+    name = check("name", validate_name, raw_name)
+
+    email = check("email", normalize_email, row.cell(columns.email))
+    if email is not None:
+        first_row = first_row_by_email.setdefault(email, row.number)
+        if first_row != row.number:
+            errors["email"] = f"duplicate of row {first_row}"
+
+    raw_phone = row.cell(columns.phone)
+    phone = check("phone", normalize_phone, raw_phone) if raw_phone.strip() else None
+
+    raw_tags = [item for item in row.cell(columns.tags).split(TAG_SEPARATOR) if item.strip()]
+    tags = set()
+    for raw_tag in raw_tags:
+        tag = check("tags", normalize_tag, raw_tag)
+        if "tags" in errors:
+            break
+        tags.add(tag)
+
+    if errors:
+        issues = [RowIssue(row.number, col, errors[col]) for col in _FIELD_ORDER if col in errors]
+        return None, issues
+    contact = Contact(name=name, email=email, phone=phone, tags=frozenset(tags))
+    return contact, []
+
+
+def _apply(repo: InMemoryContactRepository, contact: Contact, report: ImportReport) -> None:
+    """Create the contact, or merge it into the stored one without losing data."""
+    existing = repo.find(contact.email)
+    if existing is None:
+        repo.add(contact)
+        report.created.append(contact.email)
+        return
+    merged = replace(
+        existing,
+        name=contact.name,
+        phone=contact.phone or existing.phone,
+        tags=existing.tags | contact.tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(contact.email)

@@ -0,0 +1,118 @@
+"""SPEC.md acceptance criteria 15-16: size limit and whole-file failures."""
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+
+
+def existing_ann():
+    return Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="+15550000000", tags=["vip"]
+    )
+
+
+def valid_rows(count):
+    return [f"Person {i},person{i}@example.com,,lead" for i in range(count)]
+
+
+def csv_text(*lines):
+    return "\n".join(lines) + "\n"
+
+
+# AC15 -----------------------------------------------------------------------
+
+
+def test_ac15_exactly_1000_contact_rows_is_accepted(import_contacts):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, *valid_rows(1000)))
+
+    assert len(report.created) == 1000
+    assert report.errors == []
+    assert len(repo) == 1000
+
+
+def test_ac15_more_than_1000_contact_rows_raises_and_imports_nothing(
+    import_contacts, import_file_error
+):
+    repo = InMemoryContactRepository([existing_ann()])
+    rows = ["Ann Changed,ann@example.com,+15559999999,new-tag", *valid_rows(1000)]
+
+    with pytest.raises(import_file_error):
+        import_contacts(repo, csv_text(HEADER, *rows))
+
+    assert repo.all() == [existing_ann()]
+
+
+def test_ac15_blank_rows_do_not_count_toward_the_limit(import_contacts):
+    repo = InMemoryContactRepository()
+    rows = valid_rows(1000)
+    with_blanks = []
+    for i, row in enumerate(rows):
+        with_blanks.append(row)
+        if i % 10 == 0:
+            with_blanks.append("" if i % 20 == 0 else ",,,")
+
+    report = import_contacts(repo, csv_text(HEADER, *with_blanks, ",,,", ",,,"))
+
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_ac15_error_rows_count_toward_the_limit(import_contacts, import_file_error):
+    repo = InMemoryContactRepository()
+    rows = [*valid_rows(999), "Bad One,not-an-email,,", "Bad Two,,,"]
+
+    with pytest.raises(import_file_error):
+        import_contacts(repo, csv_text(HEADER, *rows))
+
+    assert len(repo) == 0
+
+
+def test_ac15_1000_contact_rows_including_error_rows_is_accepted(import_contacts):
+    repo = InMemoryContactRepository()
+    rows = [*valid_rows(998), "Bad One,not-an-email,,", "Bad Two,,,"]
+
+    report = import_contacts(repo, csv_text(HEADER, *rows))
+
+    assert len(report.created) == 998
+    assert sorted({e.row for e in report.errors}) == [1000, 1001]
+
+
+# AC16 -----------------------------------------------------------------------
+
+# Every file below also contains a row that, if it were applied, would change
+# the existing contact ann@example.com or add bob@example.com.
+WHOLE_FILE_FAILURES = {
+    "not-utf8": csv_text(HEADER, "Анна Ли,ann@example.com,+15559999999,new-tag").encode(
+        "cp1251"
+    ),
+    "missing-email-column": csv_text("name,phone,tags", "Ann Changed,+15559999999,new-tag"),
+    "missing-name-source": csv_text("email,phone,tags", "ann@example.com,+15559999999,new"),
+    "only-first-name": csv_text("first_name,email", "Ann,ann@example.com"),
+    "duplicate-used-column": csv_text(
+        "name,email,Email,tags", "Ann Changed,ann@example.com,ann@example.com,new-tag"
+    ),
+    "too-many-rows": csv_text(
+        HEADER,
+        "Ann Changed,ann@example.com,+15559999999,new-tag",
+        "Bob Stone,bob@example.com,,",
+        *valid_rows(999),
+    ),
+}
+
+
+@pytest.mark.parametrize("data", WHOLE_FILE_FAILURES.values(), ids=WHOLE_FILE_FAILURES.keys())
+def test_ac16_import_file_error_leaves_repository_unchanged(
+    import_contacts, import_file_error, data
+):
+    other = Contact.create(name="Carol King", email="carol@example.com", tags=["lead"])
+    repo = InMemoryContactRepository([existing_ann(), other])
+
+    with pytest.raises(import_file_error):
+        import_contacts(repo, data)
+
+    assert repo.all() == [existing_ann(), other]

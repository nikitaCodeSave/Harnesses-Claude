+"""SPEC.md acceptance criteria 17-24: per-row validation and error rows."""
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+
+
+def csv_text(*lines):
+    return "\n".join(lines) + "\n"
+
+
+def existing_ann():
+    return Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="+15550000000", tags=["vip"]
+    )
+
+
+def issues(items):
+    return [(issue.row, issue.column) for issue in items]
+
+
+def has_issue(items, row, column):
+    return (row, column) in issues(items)
+
+
+# AC17 -----------------------------------------------------------------------
+
+
+def test_ac17_email_is_trimmed_and_lower_cased(import_contacts):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,  Ann.Lee@Example.COM ,,"))
+
+    assert report.created == ["ann.lee@example.com"]
+    assert repo.all()[0].email == "ann.lee@example.com"
+
+
+@pytest.mark.parametrize(
+    "email", ["", "   ", "not-an-email", "ann@", "ann@@example.com", "ann lee@example.com"]
+)
+def test_ac17_missing_or_invalid_email_is_an_email_error(import_contacts, email):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, f'Ann Lee,"{email}",,'))
+
+    assert has_issue(report.errors, 2, "email")
+    assert report.created == [] and report.updated == []
+    assert len(repo) == 0
+
+
+# AC18 -----------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("name", ["", "   ", "x" * 101], ids=["empty", "spaces", "too-long"])
+def test_ac18_blank_or_invalid_name_is_a_name_error(import_contacts, name):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, f"{name},ann@example.com,,"))
+
+    assert has_issue(report.errors, 2, "name")
+    assert report.created == []
+    assert len(repo) == 0
+
+
+def test_ac18_name_is_required_even_when_updating(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    report = import_contacts(repo, csv_text(HEADER, ",ann@example.com,+15551234567,lead"))
+
+    assert has_issue(report.errors, 2, "name")
+    assert report.updated == []
+    assert repo.all() == [existing_ann()]
+
+
+def test_ac18_both_first_and_last_blank_is_a_name_error(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text("first_name,last_name,email", " , ,ann@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert has_issue(report.errors, 2, "name")
+    assert len(repo) == 0
+
+
+def test_ac18_name_is_normalised_by_the_name_helper(import_contacts):
+    repo = InMemoryContactRepository()
+
+    import_contacts(repo, csv_text(HEADER, "  Ann    Lee  ,ann@example.com,,"))
+
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# AC19 -----------------------------------------------------------------------
+
+
+def test_ac19_tags_are_split_on_semicolon_normalised_and_deduplicated(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,,VIP; Key Account;;vip;key account;")
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == []
+    assert repo.get("ann@example.com").tags == frozenset({"vip", "key-account"})
+
+
+def test_ac19_blank_tags_cell_means_no_tags(import_contacts):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,   "))
+
+    assert report.errors == []
+    assert repo.get("ann@example.com").tags == frozenset()
+
+
+@pytest.mark.parametrize("tags", ["vip;bad_tag!", "a" * 33, "vip;--"])
+def test_ac19_invalid_tag_is_a_tags_error(import_contacts, tags):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, f"Ann Lee,ann@example.com,,{tags}"))
+
+    assert has_issue(report.errors, 2, "tags")
+    assert len(repo) == 0
+
+
+# AC20 -----------------------------------------------------------------------
+
+
+def test_ac20_valid_phone_is_normalised(import_contacts):
+    repo = InMemoryContactRepository()
+
+    import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,+1 (555) 123-4567,"))
+
+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+def test_ac20_blank_phone_means_no_phone_and_no_warning(import_contacts):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,   ,"))
+
+    assert report.warnings == []
+    assert repo.get("ann@example.com").phone is None
+
+
+@pytest.mark.parametrize("phone", ["call me", "123", "+1 555 abc 4567"])
+def test_ac20_invalid_phone_on_new_contact_is_a_warning_and_row_is_applied(
+    import_contacts, phone
+):
+    repo = InMemoryContactRepository()
+    data = csv_text(HEADER, f"Ann Lee,ann@example.com,{phone},lead")
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == []
+    assert issues(report.warnings) == [(2, "phone")]
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", tags=["lead"]
+    )
+
+
+def test_ac20_invalid_phone_on_update_keeps_existing_phone_with_one_warning(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+    data = csv_text(HEADER, "Ann Smith,ann@example.com,call me,lead")
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == []
+    assert issues(report.warnings) == [(2, "phone")]
+    assert report.updated == ["ann@example.com"]

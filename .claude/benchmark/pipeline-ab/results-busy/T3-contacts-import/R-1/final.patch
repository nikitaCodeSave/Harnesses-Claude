+"""Shared fixtures for the CSV import acceptance tests (see SPEC.md).
+
+The importer and ImportFileError are looked up lazily rather than at module
+level, so that while the feature is missing each test fails on its own (in the
+test body, with the real ImportError) instead of the whole directory failing at
+collection time or every test erroring in fixture setup.
+"""
+
+import importlib
+
+import pytest
+
+
+def load_importer():
+    return importlib.import_module("contactbook.importer")
+
+
+@pytest.fixture
+def import_contacts():
+    def call(repo, data):
+        return load_importer().import_contacts(repo, data)
+
+    return call
+
+
+@pytest.fixture
+def import_file_error():
+    errors = importlib.import_module("contactbook.errors")
+    missing = type("ImportFileErrorMissing", (Exception,), {})
+    return getattr(errors, "ImportFileError", missing)

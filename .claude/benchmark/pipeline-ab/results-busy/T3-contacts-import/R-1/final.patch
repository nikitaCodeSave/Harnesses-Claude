+"""SPEC.md acceptance criteria 1-5: input and encoding."""
+
+import io
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def csv_text(*lines):
+    return "\n".join(lines) + "\n"
+
+
+# AC1 ------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "data",
+    [None, 42, ["name,email\n", "Ann Lee,ann@example.com\n"], io.StringIO("name,email\n")],
+    ids=["none", "int", "list-of-lines", "file-object"],
+)
+def test_ac01_other_input_types_raise_type_error(import_contacts, import_file_error, data):
+    with pytest.raises(TypeError) as excinfo:
+        import_contacts(InMemoryContactRepository(), data)
+    assert not isinstance(excinfo.value, import_file_error)
+
+
+@pytest.mark.parametrize("as_bytes", [True, False], ids=["bytes", "str"])
+def test_ac01_bytes_and_str_are_accepted(import_contacts, as_bytes):
+    text = csv_text("name,email", "Ann Lee,ann@example.com")
+    data = text.encode("utf-8") if as_bytes else text
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# AC2 ------------------------------------------------------------------------
+
+
+def test_ac02_bytes_are_decoded_as_utf8(import_contacts):
+    data = csv_text("name,email", "Zoë Ångström,zoe@example.com").encode("utf-8")
+    repo = InMemoryContactRepository()
+
+    import_contacts(repo, data)
+
+    assert repo.get("zoe@example.com").name == "Zoë Ångström"
+
+
+@pytest.mark.parametrize(
+    "header,row",
+    [("email,name", "ann@example.com,Ann Lee"), ("name,email", "Ann Lee,ann@example.com")],
+    ids=["email-first", "name-first"],
+)
+def test_ac02_leading_utf8_bom_in_bytes_is_not_part_of_first_column(
+    import_contacts, header, row
+):
+    data = b"\xef\xbb\xbf" + csv_text(header, row).encode("utf-8")
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# AC3 ------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header,row",
+    [("email,name", "ann@example.com,Ann Lee"), ("name,email", "Ann Lee,ann@example.com")],
+    ids=["email-first", "name-first"],
+)
+def test_ac03_leading_bom_character_in_str_is_not_part_of_first_column(
+    import_contacts, header, row
+):
+    data = "\ufeff" + csv_text(header, row)
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# AC4 ------------------------------------------------------------------------
+
+
+def test_ac04_non_utf8_bytes_raise_import_file_error_mentioning_csv_utf8(
+    import_contacts, import_file_error
+):
+    data = csv_text("name,email", "Иван Петров,ivan@example.com").encode("cp1251")
+    with pytest.raises(UnicodeDecodeError):
+        data.decode("utf-8")  # precondition: really not UTF-8
+    existing = Contact.create(name="Ann Lee", email="ann@example.com")
+    repo = InMemoryContactRepository([existing])
+
+    with pytest.raises(import_file_error) as excinfo:
+        import_contacts(repo, data)
+
+    assert "CSV UTF-8" in str(excinfo.value)
+    assert repo.all() == [existing]
+
+
+# AC5 ------------------------------------------------------------------------
+
+
+def test_ac05_quoted_cell_with_embedded_comma(import_contacts):
+    repo = InMemoryContactRepository()
+    import_contacts(repo, csv_text("name,email", '"Lee, Ann",ann@example.com'))
+    assert repo.get("ann@example.com").name == "Lee, Ann"
+
+
+def test_ac05_doubled_quotes_inside_quoted_cell(import_contacts):
+    repo = InMemoryContactRepository()
+    import_contacts(repo, csv_text("name,email", '"Ann ""Ace"" Lee",ann@example.com'))
+    assert repo.get("ann@example.com").name == 'Ann "Ace" Lee'
+
+
+def test_ac05_embedded_line_break_inside_quoted_cell(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        "name,email,phone,tags",
+        '"Ann',
+        'Lee",ann@example.com,,"vip;',
+        'lead"',
+        "Bob Stone,bob@example.com,,",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == []
+    ann = repo.get("ann@example.com")
+    # Stored the way Contact.create would store it (AC29).
+    assert ann == Contact.create(name="Ann\nLee", email="ann@example.com", tags=["vip", "lead"])
+
+
+def test_ac05_crlf_line_endings_are_understood(import_contacts):
+    repo = InMemoryContactRepository()
+    data = "name,email,phone,tags\r\nAnn Lee,ann@example.com,+15551234567,vip\r\n"
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"]
+    )
+
+
+def test_ac05_semicolon_delimited_file_is_not_supported(import_contacts, import_file_error):
+    # With ',' as the only delimiter the header is one column "name;email",
+    # so there is no email column (AC7).
+    repo = InMemoryContactRepository()
+    with pytest.raises(import_file_error):
+        import_contacts(repo, csv_text("name;email", "Ann Lee;ann@example.com"))
+    assert len(repo) == 0

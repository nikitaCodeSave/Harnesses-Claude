+"""SPEC.md acceptance criteria 6-14: header and columns."""
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def csv_text(*lines):
+    return "\n".join(lines) + "\n"
+
+
+def existing_ann():
+    return Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="+15550000000", tags=["vip"]
+    )
+
+
+# AC6 ------------------------------------------------------------------------
+
+
+def test_ac06_column_names_match_case_insensitively_ignoring_whitespace_any_order(
+    import_contacts,
+):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        " TAGS , Phone ,  EMAIL,Name  ",
+        "lead,+15551234567,ann@example.com,Ann Lee",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["lead"]
+    )
+
+
+# AC7 ------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header,row",
+    [("name,phone", "Ann Lee,+15551234567"), ("name,e-mail", "Ann Lee,ann@example.com")],
+    ids=["no-email", "e-mail"],
+)
+def test_ac07_missing_email_column_raises(import_contacts, import_file_error, header, row):
+    repo = InMemoryContactRepository()
+    with pytest.raises(import_file_error):
+        import_contacts(repo, csv_text(header, row))
+    assert len(repo) == 0
+
+
+# AC8 ------------------------------------------------------------------------
+
+
+def test_ac08_name_column_is_used_and_first_last_are_ignored(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text("first_name,name,last_name,email", "Bob,Ann Lee,Stone,ann@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_ac08_with_name_column_a_blank_name_is_not_filled_from_first_last(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text("first_name,name,last_name,email", "Ann,,Lee,ann@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name")]
+    assert len(repo) == 0
+
+
+@pytest.mark.parametrize(
+    "first,last,expected",
+    [("Ann", "Lee", "Ann Lee"), ("Ann", "", "Ann"), ("", "Lee", "Lee"), ("Ann", "   ", "Ann")],
+)
+def test_ac08_first_and_last_name_are_joined_by_one_space(
+    import_contacts, first, last, expected
+):
+    repo = InMemoryContactRepository()
+    data = csv_text("first_name,last_name,email", f"{first},{last},ann@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == expected
+
+
+def test_ac08_first_last_column_names_are_matched_case_insensitively(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(" Last_Name ,EMAIL, FIRST_NAME", "Lee,ann@example.com,Ann")
+
+    import_contacts(repo, data)
+
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+@pytest.mark.parametrize(
+    "header,row",
+    [
+        ("first_name,email", "Ann,ann@example.com"),
+        ("last_name,email", "Lee,ann@example.com"),
+        ("email", "ann@example.com"),
+        ("email,phone,tags", "ann@example.com,,"),
+    ],
+    ids=["only-first", "only-last", "email-only", "no-name-source"],
+)
+def test_ac08_missing_name_source_raises(import_contacts, import_file_error, header, row):
+    repo = InMemoryContactRepository()
+    with pytest.raises(import_file_error):
+        import_contacts(repo, csv_text(header, row))
+    assert len(repo) == 0
+
+
+# AC9 ------------------------------------------------------------------------
+
+
+def test_ac09_missing_phone_and_tags_columns_on_create(import_contacts):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text("name,email", "Ann Lee,ann@example.com"))
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(name="Ann Lee", email="ann@example.com")
+
+
+def test_ac09_missing_phone_and_tags_columns_on_update_keep_existing_values(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    report = import_contacts(repo, csv_text("name,email", "Ann Smith,ann@example.com"))
+
+    assert report.updated == ["ann@example.com"]
+    contact = repo.get("ann@example.com")
+    assert contact.name == "Ann Smith"
+    assert contact.phone == "+15550000000"
+    assert contact.tags == frozenset({"vip"})
+
+
+# AC10 -----------------------------------------------------------------------
+
+
+def test_ac10_unknown_columns_are_ignored(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        "Company,name,email,Notes",
+        'ACME,Ann Lee,ann@example.com,"anything, even ""junk"" @@@"',
+        ",Bob Stone,bob@example.com,",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(name="Ann Lee", email="ann@example.com")
+
+
+# AC11 -----------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "name,Email, email",
+        "name,email,phone,Phone",
+        "name,email,tags,TAGS",
+        "Name,email,name ",
+        "first_name,last_name,email,First_Name",
+        "first_name,last_name,email, LAST_NAME",
+    ],
+)
+def test_ac11_repeated_used_column_raises(import_contacts, import_file_error, header):
+    width = len(header.split(","))
+    row = ",".join(["x"] * width)
+    repo = InMemoryContactRepository([existing_ann()])
+    with pytest.raises(import_file_error):
+        import_contacts(repo, csv_text(header, row))
+    assert repo.all() == [existing_ann()]
+
+
+def test_ac11_repeated_unknown_columns_are_fine(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text("Notes,name,notes,email, NOTES ", "a,Ann Lee,b,ann@example.com,c")
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [] and report.warnings == []
+
+
+def test_ac11_repeated_first_name_is_fine_when_name_column_makes_it_unknown(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text("name,first_name,FIRST_NAME,email", "Ann Lee,A,B,ann@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# AC12 -----------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "data",
+    [b"", "", b"\xef\xbb\xbf", "\ufeff", "   ", b" \n\n\t\n", "\r\n\r\n", b"\xef\xbb\xbf  \n"],
+    ids=[
+        "zero-bytes",
+        "empty-str",
+        "bom-bytes",
+        "bom-str",
+        "spaces",
+        "whitespace-lines",
+        "crlf-only",
+        "bom-and-whitespace",
+    ],
+)
+def test_ac12_empty_file_raises(import_contacts, import_file_error, data):
+    repo = InMemoryContactRepository([existing_ann()])
+    with pytest.raises(import_file_error):
+        import_contacts(repo, data)
+    assert repo.all() == [existing_ann()]
+
+
+# AC13 -----------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "name,email,phone,tags",
+        "name,email,phone,tags\n",
+        "name,email,phone,tags\n\n\n",
+        "name,email,phone,tags\n,,,\n , ,\t,  \n,,,\n",
+    ],
+    ids=["header-no-newline", "header", "header-empty-lines", "header-excel-blank-rows"],
+)
+def test_ac13_header_only_or_blank_rows_imports_nothing(import_contacts, data):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    report = import_contacts(repo, data)
+
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == [existing_ann()]
+
+
+# AC14 -----------------------------------------------------------------------
+
+
+def test_ac14_short_row_missing_cells_are_blank(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text("name,email,phone,tags", "Ann Lee,ann@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(name="Ann Lee", email="ann@example.com")
+
+
+def test_ac14_short_row_missing_required_cell_is_a_row_error_not_a_file_error(
+    import_contacts,
+):
+    repo = InMemoryContactRepository()
+    data = csv_text("name,email,phone,tags", "Ann Lee", "Bob Stone,bob@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "email")]
+    assert report.created == ["bob@example.com"]
+
+
+def test_ac14_cells_beyond_the_header_are_ignored(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        "name,email,phone,tags",
+        "Ann Lee,ann@example.com,+15551234567,vip,extra,not-an-email,!!!",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"]
+    )

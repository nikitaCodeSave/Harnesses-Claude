+"""SPEC.md interface section and acceptance criteria 30-35: report, errors, round trip."""
+
+import dataclasses
+import importlib
+
+import pytest
+
+from contactbook.errors import ContactError
+from contactbook.export import export_csv
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+LOGICAL_COLUMNS = {"name", "email", "phone", "tags", None}
+
+
+def csv_text(*lines):
+    return "\n".join(lines) + "\n"
+
+
+# Interface ------------------------------------------------------------------
+
+
+def test_interface_report_and_row_issue_are_dataclasses_with_spec_fields(import_contacts):
+    importer = importlib.import_module("contactbook.importer")
+    assert dataclasses.is_dataclass(importer.ImportReport)
+    assert dataclasses.is_dataclass(importer.RowIssue)
+    assert [f.name for f in dataclasses.fields(importer.ImportReport)] == [
+        "created",
+        "updated",
+        "errors",
+        "warnings",
+    ]
+    assert [f.name for f in dataclasses.fields(importer.RowIssue)] == ["row", "column", "message"]
+
+    report = import_contacts(
+        InMemoryContactRepository(), csv_text(HEADER, "Ann Lee,nope,,", "Bob,bob@example.com,x,")
+    )
+    assert isinstance(report, importer.ImportReport)
+    assert all(isinstance(i, importer.RowIssue) for i in report.errors + report.warnings)
+
+
+# AC30 -----------------------------------------------------------------------
+
+
+def test_ac30_created_and_updated_are_normalised_emails_in_file_order(import_contacts):
+    repo = InMemoryContactRepository(
+        [
+            Contact.create(name="Bob Stone", email="bob@example.com"),
+            Contact.create(name="Dan Ray", email="dan@example.com"),
+        ]
+    )
+    data = csv_text(
+        HEADER,
+        "Eve Moss,EVE@example.com,,",
+        "Dan Ray, Dan@Example.com,,",
+        "Carol King,carol@example.com,,",
+        "Bob Stone,BOB@EXAMPLE.COM,,",
+        "Ann Lee,ann@example.com,,",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.created == ["eve@example.com", "carol@example.com", "ann@example.com"]
+    assert report.updated == ["dan@example.com", "bob@example.com"]
+
+
+def test_ac30_an_email_appears_at_most_once_across_both_lists(import_contacts):
+    repo = InMemoryContactRepository([Contact.create(name="Bob Stone", email="bob@example.com")])
+    data = csv_text(
+        HEADER,
+        "Ann Lee,ann@example.com,,",
+        "Bob Stone,bob@example.com,,",
+        "Ann Lee,ANN@example.com,,",
+        "Bob Stone,bob@example.com,,",
+    )
+
+    report = import_contacts(repo, data)
+
+    combined = report.created + report.updated
+    assert sorted(combined) == ["ann@example.com", "bob@example.com"]
+    assert len(combined) == len(set(combined))
+
+
+# AC31 -----------------------------------------------------------------------
+
+
+def test_ac31_row_numbers_count_header_and_blank_rows_and_multiline_records(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        HEADER,  # row 1
+        "Ann Lee,ann@example.com,,",  # row 2
+        "",  # row 3 (blank)
+        ",,,",  # row 4 (blank)
+        "Bad Email,nope,,",  # row 5 error
+        '"Bob',  # row 6 starts: quoted name spanning three lines
+        "",
+        'Stone",bob@example.com,call me,',  # row 6 ends; phone warning
+        "  ,  ,  ,  ",  # row 7 (blank)
+        ",carol@example.com,,",  # row 8 error
+        "Dan Ray,dan@example.com,12,",  # row 9 phone warning
+    )
+
+    report = import_contacts(repo, data)
+
+    assert [e.row for e in report.errors] == [5, 8]
+    assert [(w.row, w.column) for w in report.warnings] == [(6, "phone"), (9, "phone")]
+    assert report.created == ["ann@example.com", "bob@example.com", "dan@example.com"]
+
+
+def test_ac31_issues_are_in_row_order(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        HEADER,
+        "A One,a@example.com,bad,",  # 2 warning
+        ",b@example.com,,",  # 3 error
+        "C Three,c@example.com,,bad_tag!",  # 4 error
+        "D Four,d@example.com,bad,",  # 5 warning
+        "E Five,nope,,",  # 6 error
+        "F Six,f@example.com,bad,",  # 7 warning
+    )
+
+    report = import_contacts(repo, data)
+
+    error_rows = [e.row for e in report.errors]
+    warning_rows = [w.row for w in report.warnings]
+    assert error_rows == sorted(error_rows)
+    assert sorted(set(error_rows)) == [3, 4, 6]
+    assert warning_rows == [2, 5, 7]
+
+
+# AC32 -----------------------------------------------------------------------
+
+
+def test_ac32_column_is_lower_case_logical_name_even_for_upper_case_header(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        " NAME , EMAIL , PHONE , TAGS ",
+        ",a@example.com,,",
+        "B Two,nope,,",
+        "C Three,c@example.com,,bad_tag!",
+        "D Four,d@example.com,bad,",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert ("name" in {e.column for e in report.errors if e.row == 2})
+    assert ("email" in {e.column for e in report.errors if e.row == 3})
+    assert ("tags" in {e.column for e in report.errors if e.row == 4})
+    assert [(w.row, w.column) for w in report.warnings] == [(5, "phone")]
+    assert {i.column for i in report.errors + report.warnings} <= LOGICAL_COLUMNS
+
+
+def test_ac32_name_problems_in_first_last_file_use_name_column(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text("First_Name,Last_Name,Email", ",,a@example.com", f"{'x' * 60},{'y' * 60},b@example.com")
+
+    report = import_contacts(repo, data)
+
+    assert [(e.row, e.column) for e in report.errors] == [(2, "name"), (3, "name")]
+
+
+# AC33 -----------------------------------------------------------------------
+
+
+def test_ac33_messages_are_short_human_readable_strings(import_contacts):
+    repo = InMemoryContactRepository()
+    data = csv_text(
+        HEADER,
+        ",a@example.com,,",
+        "B Two,nope,,",
+        "C Three,c@example.com,,bad_tag!",
+        "D Four,d@example.com,bad,",
+        "E Five,a@example.com,,",
+    )
+
+    report = import_contacts(repo, data)
+
+    assert report.errors and report.warnings
+    for issue in report.errors + report.warnings:
+        assert isinstance(issue.message, str)
+        assert issue.message.strip()
+        assert "\n" not in issue.message
+        assert len(issue.message) <= 200
+
+
+# AC34 -----------------------------------------------------------------------
+
+
+def test_ac34_import_file_error_derives_from_contact_error(import_file_error):
+    assert issubclass(import_file_error, ContactError)
+
+
+@pytest.mark.parametrize(
+    "data",
+    [b"", "name,phone\nAnn,123\n", "name,email,EMAIL\nAnn,a@example.com,a@example.com\n", "email\nann@example.com\n"],
+    ids=["empty", "no-email", "duplicate-column", "no-name"],
+)
+def test_ac34_import_file_error_carries_a_human_readable_message(
+    import_contacts, import_file_error, data
+):
+    with pytest.raises(import_file_error) as excinfo:
+        import_contacts(InMemoryContactRepository(), data)
+
+    assert str(excinfo.value).strip()
+    assert isinstance(excinfo.value, ContactError)
+
+
+# AC35 -----------------------------------------------------------------------
+
+
+def round_trip_contacts():
+    return [
+        Contact.create(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip", "lead"]),
+        Contact.create(name="Lee, Bob", email="bob@example.com"),
+        Contact.create(name='Carol "CK" King', email="carol@example.com", tags=["key-account"]),
+        Contact.create(name="Zoë Ångström", email="zoe@example.com", phone="5550001111"),
+    ]
+
+
+@pytest.mark.parametrize("as_bytes", [False, True], ids=["str", "bytes"])
+def test_ac35_export_imported_into_empty_repo_recreates_equal_contacts(import_contacts, as_bytes):
+    originals = round_trip_contacts()
+    exported = export_csv(originals)
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, exported.encode("utf-8") if as_bytes else exported)
+
+    assert report.errors == [] and report.warnings == []
+    assert report.created == [c.email for c in originals]
+    assert {c.email: c for c in repo.all()} == {c.email: c for c in originals}
+
+
+def test_ac35_export_imported_into_its_source_repo_changes_nothing(import_contacts):
+    originals = round_trip_contacts()
+    repo = InMemoryContactRepository(originals)
+
+    report = import_contacts(repo, export_csv(repo.all()))
+
+    assert report.updated == [c.email for c in originals]
+    assert report.created == []
+    assert report.errors == [] and report.warnings == []
+    assert repo.all() == originals

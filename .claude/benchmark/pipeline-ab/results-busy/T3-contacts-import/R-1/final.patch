@@ -0,0 +1,164 @@
+"""SPEC.md acceptance criteria 25-29: creating and updating."""
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+
+
+def csv_text(*lines):
+    return "\n".join(lines) + "\n"
+
+
+def existing_ann():
+    return Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="+15550000000", tags=["vip", "lead"]
+    )
+
+
+# AC25 -----------------------------------------------------------------------
+
+
+def test_ac25_new_email_creates_contact_with_name_phone_and_tags(import_contacts):
+    repo = InMemoryContactRepository()
+
+    report = import_contacts(repo, csv_text(HEADER, "Bob Stone,bob@example.com,5551234567,vip"))
+
+    assert report.created == ["bob@example.com"]
+    assert report.updated == []
+    assert repo.all() == [
+        Contact.create(name="Bob Stone", email="bob@example.com", phone="5551234567", tags=["vip"])
+    ]
+
+
+# AC26 -----------------------------------------------------------------------
+
+
+def test_ac26_matching_email_updates_and_never_creates_a_second_contact(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Smith, ANN@EXAMPLE.COM ,,"))
+
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert len(repo) == 1
+    assert repo.get("ann@example.com").name == "Ann Smith"
+
+
+def test_ac26_update_is_reported_even_if_nothing_changed(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,+15550000000,vip"))
+
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert repo.all() == [existing_ann()]
+
+
+# AC27 -----------------------------------------------------------------------
+
+
+def test_ac27_update_replaces_name_and_valid_phone_and_adds_tags(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+    data = csv_text(HEADER, "Ann Smith,ann@example.com,+44 20 7946 0958,customer;VIP")
+
+    report = import_contacts(repo, data)
+
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="+442079460958",
+        tags=frozenset({"vip", "lead", "customer"}),
+    )
+
+
+@pytest.mark.parametrize(
+    "header,row",
+    [
+        (HEADER, "Ann Smith,ann@example.com,,"),
+        (HEADER, "Ann Smith,ann@example.com,   ,"),
+        ("name,email,tags", "Ann Smith,ann@example.com,"),
+        (HEADER, "Ann Smith,ann@example.com,not a phone,"),
+    ],
+    ids=["blank-cell", "whitespace-cell", "missing-column", "invalid-phone"],
+)
+def test_ac27_phone_is_kept_unless_cell_holds_a_valid_phone(import_contacts, header, row):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    report = import_contacts(repo, csv_text(header, row))
+
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").phone == "+15550000000"
+
+
+def test_ac27_existing_tags_are_never_removed(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,customer"))
+
+    assert repo.get("ann@example.com").tags == frozenset({"vip", "lead", "customer"})
+
+
+def test_ac27_blank_tags_cell_keeps_existing_tags(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,"))
+
+    assert repo.get("ann@example.com").tags == frozenset({"vip", "lead"})
+
+
+def test_ac27_email_identity_stays_the_same_normalised_value(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+
+    import_contacts(repo, csv_text(HEADER, "Ann Smith,  ANN@Example.COM  ,,"))
+
+    assert [c.email for c in repo.all()] == ["ann@example.com"]
+
+
+# AC28 -----------------------------------------------------------------------
+
+
+def test_ac28_contacts_not_in_file_are_untouched(import_contacts):
+    bob = Contact.create(name="Bob Stone", email="bob@example.com", phone="5551112222", tags=["x"])
+    carol = Contact.create(name="Carol King", email="carol@example.com")
+    repo = InMemoryContactRepository([bob, existing_ann(), carol])
+
+    import_contacts(repo, csv_text(HEADER, "Ann Smith,ann@example.com,,", "Dan Ray,dan@example.com,,"))
+
+    assert repo.get("bob@example.com") == bob
+    assert repo.get("carol@example.com") == carol
+    assert len(repo) == 4
+
+
+# AC29 -----------------------------------------------------------------------
+
+
+def test_ac29_created_values_are_normalised_like_contact_create(import_contacts):
+    raw_name, raw_email, raw_phone = "  Ann    Lee ", " Ann.Lee@Example.COM ", " +1 (555) 123-4567 "
+    raw_tags = ["Key  Account", "VIP"]
+    repo = InMemoryContactRepository()
+    data = csv_text(HEADER, f'"{raw_name}","{raw_email}","{raw_phone}","{";".join(raw_tags)}"')
+
+    import_contacts(repo, data)
+
+    assert repo.all() == [
+        Contact.create(name=raw_name, email=raw_email, phone=raw_phone, tags=raw_tags)
+    ]
+
+
+def test_ac29_updated_values_are_normalised_like_contact_create(import_contacts):
+    repo = InMemoryContactRepository([existing_ann()])
+    data = csv_text(HEADER, '"  Ann   Smith ",ann@example.com,"(555) 987-6543","Key  Account"')
+
+    import_contacts(repo, data)
+
+    expected = Contact.create(
+        name="  Ann   Smith ",
+        email="ann@example.com",
+        phone="(555) 987-6543",
+        tags=["vip", "lead", "Key  Account"],
+    )
+    assert repo.get("ann@example.com") == expected

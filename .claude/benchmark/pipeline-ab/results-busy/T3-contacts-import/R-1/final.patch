+"""CSV import of contacts (the counterpart of export.py).
+
+The file is parsed and checked as a whole before anything is stored, so an
+ImportFileError never leaves a half-imported repository behind. After that each
+row is validated on its own: a bad row is reported and skipped, the rest still
+go in. Import only ever merges: it never deletes contacts, removes tags or
+clears phones.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_CONTACT_ROWS = 1000
+MAX_MESSAGE_LENGTH = 120
+_BOM = "\ufeff"
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row. ``row`` is the spreadsheet row number (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _Columns:
+    """Cell indexes of the logical columns; ``None`` means the column is absent."""
+
+    email: int
+    name: int | None
+    first_name: int | None
+    last_name: int | None
+    phone: int | None
+    tags: int | None
+
+
+@dataclass
+class _Row:
+    """A contact row that passed validation and is ready to be applied."""
+
+    name: str
+    email: str
+    phone: str | None
+    tags: frozenset[str]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Merge the contacts in a CSV file into ``repo`` and report what happened.
+
+    Raises ImportFileError (and changes nothing) if the file as a whole can't be
+    imported; problems with single rows are reported in the returned report.
+    """
+    text = _decode(data)
+    if not text.strip():
+        raise ImportFileError("the file is empty")
+    records = _parse(text)
+    columns = _read_header(records[0])
+
+    # Row 1 is the header, so record i is spreadsheet row i + 1. Cells beyond
+    # the header are ignored, so they don't stop a row from being blank either.
+    width = len(records[0])
+    contact_rows = [
+        (number, cells)
+        for number, cells in enumerate(records[1:], start=2)
+        if any(cell.strip() for cell in cells[:width])
+    ]
+    if len(contact_rows) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(contact_rows)} contacts; "
+            f"at most {MAX_CONTACT_ROWS} can be imported at once"
+        )
+
+    report = ImportReport()
+    first_seen: dict[str, int] = {}
+    for number, cells in contact_rows:
+        row_errors: list[RowIssue] = []
+        row_warnings: list[RowIssue] = []
+        row = _validate(number, cells, columns, first_seen, row_errors, row_warnings)
+        if row is None:
+            report.errors.extend(row_errors)
+            continue
+        report.warnings.extend(row_warnings)
+        _apply(repo, row, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and try again'
+            ) from None
+    if isinstance(data, str):
+        return data.removeprefix(_BOM)
+    raise TypeError(f"data must be str or bytes, not {type(data).__name__}")
+
+
+def _parse(text: str) -> list[list[str]]:
+    # csv refuses cells over 128 KiB by default, but only the row count is
+    # limited; no cell can be longer than the text itself.
+    previous_limit = csv.field_size_limit()
+    csv.field_size_limit(max(previous_limit, len(text)))
+    try:
+        return list(csv.reader(io.StringIO(text, newline=""), delimiter=","))
+    except csv.Error as exc:
+        raise ImportFileError(f"the file is not valid CSV: {exc}") from None
+    finally:
+        csv.field_size_limit(previous_limit)
+
+
+def _read_header(header: list[str]) -> _Columns:
+    positions: dict[str, list[int]] = {}
+    for index, raw in enumerate(header):
+        positions.setdefault(raw.strip().lower(), []).append(index)
+
+    used = ["email", "phone", "tags"]
+    if "name" in positions:
+        used.append("name")
+    else:
+        used += ["first_name", "last_name"]
+
+    for column in used:
+        if len(positions.get(column, [])) > 1:
+            raise ImportFileError(f'the header has more than one "{column}" column')
+    if "email" not in positions:
+        raise ImportFileError('the header has no "email" column')
+    if "name" not in positions and not ("first_name" in positions and "last_name" in positions):
+        raise ImportFileError(
+            'the header needs a "name" column, or both "first_name" and "last_name"'
+        )
+
+    def find(column: str) -> int | None:
+        return positions[column][0] if column in used and column in positions else None
+
+    return _Columns(
+        email=positions["email"][0],
+        name=find("name"),
+        first_name=find("first_name"),
+        last_name=find("last_name"),
+        phone=find("phone"),
+        tags=find("tags"),
+    )
+
+
+def _validate(
+    number: int,
+    cells: list[str],
+    columns: _Columns,
+    first_seen: dict[str, int],
+    errors: list[RowIssue],
+    warnings: list[RowIssue],
+) -> _Row | None:
+    """Return the row's normalised values, or None after adding to ``errors``."""
+
+    def cell(index: int | None) -> str:
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    def issue(column: str, message: str) -> RowIssue:
+        return RowIssue(row=number, column=column, message=_short(f"{column}: {message}"))
+
+    email = None
+    try:
+        email = normalize_email(cell(columns.email))
+    except ValidationError as exc:
+        errors.append(issue("email", exc.message))
+    if email is not None:
+        if email in first_seen:
+            errors.append(issue("email", f"already used on row {first_seen[email]}"))
+        else:
+            first_seen[email] = number
+
+    if columns.name is not None:
+        raw_name = cell(columns.name)
+    else:
+        parts = (cell(columns.first_name).strip(), cell(columns.last_name).strip())
+        raw_name = " ".join(part for part in parts if part)
+    name = None
+    try:
+        name = validate_name(raw_name)
+    except ValidationError as exc:
+        errors.append(issue("name", exc.message))
+
+    tags: set[str] = set()
+    for piece in cell(columns.tags).split(TAG_SEPARATOR):
+        if not piece.strip():
+            continue
+        try:
+            tags.add(normalize_tag(piece))
+        except ValidationError as exc:
+            errors.append(issue("tags", exc.message))
+            break
+
+    phone = None
+    raw_phone = cell(columns.phone)
+    if raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            warnings.append(issue("phone", f"{exc.message}; phone not imported"))
+
+    if errors or email is None or name is None:
+        return None
+    return _Row(name=name, email=email, phone=phone, tags=frozenset(tags))
+
+
+def _apply(repo: InMemoryContactRepository, row: _Row, report: ImportReport) -> None:
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(Contact.create(name=row.name, email=row.email, phone=row.phone, tags=row.tags))
+        report.created.append(row.email)
+        return
+    contact = existing.rename(row.name).with_tags(*row.tags)
+    if row.phone is not None:
+        contact = contact.with_phone(row.phone)
+    repo.update(contact)
+    report.updated.append(row.email)
+
+
+def _short(message: str) -> str:
+    message = " ".join(message.split())
+    if len(message) <= MAX_MESSAGE_LENGTH:
+        return message
+    return message[: MAX_MESSAGE_LENGTH - 3] + "..."

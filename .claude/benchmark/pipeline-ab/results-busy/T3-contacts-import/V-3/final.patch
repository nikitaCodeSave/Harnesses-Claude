+"""CSV import of contacts.
+
+Reads the format written by ``export.export_csv``: a header row naming the
+columns, then one contact per row with tags joined by TAG_SEPARATOR in a single
+cell. Files come from spreadsheets, so header names are matched ignoring case
+and surrounding spaces, the columns may be in any order, and ``phone`` / ``tags``
+may be left out entirely.
+
+Each row is validated on its own: a bad row is reported in ``ImportReport.errors``
+and skipped, the rest are still imported. Only a file that can't be read as a
+whole (wrong encoding, broken CSV quoting, no usable header) raises
+ImportFileError, and in that case the repository is left untouched.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+REQUIRED_COLUMNS = ("name", "email")
+
+
+@dataclass
+class RowIssue:
+    """A problem found in the file.
+
+    ``row`` is the 1-based record number as a spreadsheet shows it (the header
+    is usually row 1); ``column`` is the column the problem is in, or None if it
+    concerns the whole row.
+    """
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did.
+
+    ``created`` and ``updated`` hold normalised emails in file order. A row that
+    matches an existing contact without changing anything appears in neither.
+    ``errors`` are rows that were skipped; ``warnings`` are things that were
+    imported or ignored but deserve a look.
+    """
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV ``data``.
+
+    ``data`` is the file content, either raw bytes (UTF-8, with or without a
+    BOM) or already-decoded text. Rows are matched to existing contacts by
+    email. A matched contact gets the row's name; its phone is replaced only
+    if the phone cell is filled in, and the row's tags are added to the ones it
+    already has, so a sparse spreadsheet never wipes data. If the same email
+    appears on several rows, the first valid one wins and the others are
+    reported as errors.
+
+    Raises ImportFileError if the file can't be imported at all.
+    """
+    records = _read_records(_decode(data))
+    if not records:
+        raise ImportFileError("the file is empty")
+
+    report = ImportReport()
+    header_row, header = records[0]
+    data_rows = records[1:]
+    columns = _map_columns(header_row, header, data_rows, report)
+
+    first_row_for: dict[str, int] = {}
+    for row, cells in data_rows:
+        parsed = _parse_row(row, cells, len(header), columns, report)
+        if parsed is None:
+            continue
+        name, email, phone, tags = parsed
+        if email in first_row_for:
+            report.errors.append(
+                RowIssue(row, "email", f"duplicate of row {first_row_for[email]}; row skipped")
+            )
+            continue
+        first_row_for[email] = row
+
+        existing = repo.find(email)
+        if existing is None:
+            repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+            report.created.append(email)
+            continue
+        merged = replace(
+            existing,
+            name=name,
+            phone=phone if phone is not None else existing.phone,
+            tags=existing.tags | tags,
+        )
+        if merged != existing:
+            repo.update(merged)
+            report.updated.append(email)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, str):
+        return data.removeprefix("\ufeff")
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError as exc:
+            raise ImportFileError(
+                f"the file is not UTF-8 text (bad byte at position {exc.start}); "
+                "save it as 'CSV UTF-8' and try again"
+            ) from None
+    raise TypeError(f"expected str or bytes, got {type(data).__name__}")
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """Parse the whole file up front so syntax errors abort before any change.
+
+    Returns ``(row number, cells)`` pairs, skipping blank rows (which still
+    count towards the numbering, as in a spreadsheet).
+    """
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    records = []
+    try:
+        for row, cells in enumerate(reader, start=1):
+            if any(cell.strip() for cell in cells):
+                records.append((row, cells))
+    except csv.Error as exc:
+        raise ImportFileError(f"line {reader.line_num}: broken CSV: {exc}") from None
+    return records
+
+
+def _map_columns(
+    header_row: int,
+    header: list[str],
+    data_rows: list[tuple[int, list[str]]],
+    report: ImportReport,
+) -> dict[str, int]:
+    """Return the cell index of each known column, warning about the others."""
+    columns: dict[str, int] = {}
+    for index, raw in enumerate(header):
+        name = raw.strip().lower()
+        if name in EXPORT_COLUMNS:
+            if name in columns:
+                raise ImportFileError(f"column {name!r} appears more than once in the header")
+            columns[name] = index
+        elif name:
+            report.warnings.append(
+                RowIssue(header_row, raw.strip(), "unknown column; its values are ignored")
+            )
+        elif any(index < len(cells) and cells[index].strip() for _, cells in data_rows):
+            report.warnings.append(
+                RowIssue(
+                    header_row,
+                    None,
+                    f"column {index + 1} has no name in the header; its values are ignored",
+                )
+            )
+
+    missing = [name for name in REQUIRED_COLUMNS if name not in columns]
+    if missing:
+        message = f"the header has no {' or '.join(repr(name) for name in missing)} column"
+        if len(header) == 1 and (";" in header[0] or "\t" in header[0]):
+            message += (
+                "; the file seems to use ';' or tabs between columns,"
+                " save it as comma-separated CSV"
+            )
+        raise ImportFileError(message)
+    return columns
+
+
+def _parse_row(
+    row: int,
+    cells: list[str],
+    width: int,
+    columns: dict[str, int],
+    report: ImportReport,
+) -> tuple[str, str, str | None, frozenset[str]] | None:
+    """Validate one data row; on failure record every problem and return None."""
+    if any(cell.strip() for cell in cells[width:]):
+        report.errors.append(
+            RowIssue(
+                row,
+                None,
+                f"row has {len(cells)} values but the header has {width} columns "
+                "(a comma inside a value must be quoted); row skipped",
+            )
+        )
+        return None
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    errors_before = len(report.errors)
+
+    def check(column, normalise, raw):
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            report.errors.append(RowIssue(row, column, exc.message))
+            return None
+
+    name = check("name", validate_name, cell("name"))
+    email = check("email", normalize_email, cell("email"))
+    phone = check("phone", normalize_phone, cell("phone")) if cell("phone").strip() else None
+    tags = set()
+    for raw_tag in cell("tags").split(TAG_SEPARATOR):
+        if raw_tag.strip():
+            tags.add(check("tags", normalize_tag, raw_tag))
+
+    if len(report.errors) > errors_before:
+        return None
+    return name, email, phone, frozenset(tags)

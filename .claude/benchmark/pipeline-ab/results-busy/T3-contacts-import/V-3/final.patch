@@ -0,0 +1,160 @@
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def test_import_creates_normalised_contacts():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + " Ann  Lee ,Ann@Example.COM,+1 (555) 123-4567,VIP;Key Account\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.updated == report.errors == report.warnings == []
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"vip", "key-account"}),
+    )
+
+
+def test_export_round_trips_into_empty_repository():
+    contacts = [
+        Contact.create(name="Lee, Ann", email="ann@example.com", phone="5551234567", tags=["vip"]),
+        Contact.create(name='Bob "B" Stone', email="bob@example.com"),
+    ]
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, export_csv(contacts).encode())
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert repo.all() == contacts
+
+
+def test_reimporting_same_file_changes_nothing():
+    repo = InMemoryContactRepository()
+    data = HEADER + "Ann Lee,ann@example.com,5551234567,vip\n"
+    import_contacts(repo, data)
+    report = import_contacts(repo, data)
+    assert report.created == report.updated == report.errors == []
+
+
+def test_update_replaces_name_merges_tags_and_keeps_phone_when_blank():
+    repo = InMemoryContactRepository(
+        [Contact.create(name="Ann", email="ann@example.com", phone="5551234567", tags=["lead"])]
+    )
+    report = import_contacts(repo, HEADER + "Ann Lee,ANN@example.com,,vip\n")
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=frozenset({"lead", "vip"})
+    )
+
+
+def test_update_replaces_phone_when_given():
+    repo = InMemoryContactRepository([Contact.create(name="Ann", email="ann@example.com", phone="5551234567")])
+    import_contacts(repo, HEADER + "Ann,ann@example.com,555 765 4321,\n")
+    assert repo.get("ann@example.com").phone == "5557654321"
+
+
+def test_bad_rows_are_reported_and_skipped_others_imported():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        HEADER
+        + "Ann Lee,ann@example.com,,\n"
+        + ",not-an-email,12,\n"
+        + "Bob,bob@example.com,,ok;bad_tag\n"
+        + "Cy,cy@example.com,,\n",
+    )
+    assert report.created == ["ann@example.com", "cy@example.com"]
+    assert [(i.row, i.column) for i in report.errors] == [
+        (3, "name"),
+        (3, "email"),
+        (3, "phone"),
+        (4, "tags"),
+    ]
+    assert "bob@example.com" not in repo
+
+
+def test_duplicate_email_in_file_keeps_first_row():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "Ann,ann@example.com,,\nAnnie,ANN@example.com,,\n")
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [RowIssue(3, "email", "duplicate of row 2; row skipped")]
+    assert repo.get("ann@example.com").name == "Ann"
+
+
+def test_row_numbers_count_blank_lines_and_multiline_cells():
+    repo = InMemoryContactRepository()
+    data = HEADER + '"Ann\nLee",ann@example.com,,\n\n,bob@example.com,,\n'
+    report = import_contacts(repo, data)
+    assert report.errors == [RowIssue(4, "name", "is required")]
+
+
+def test_unquoted_comma_shifting_columns_is_an_error():
+    report = import_contacts(InMemoryContactRepository(), HEADER + "Lee, Ann,ann@example.com,,vip\n")
+    assert report.created == []
+    assert report.errors[0].row == 2 and report.errors[0].column is None
+
+
+def test_short_rows_treat_missing_cells_as_blank():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "Ann,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+
+
+def test_header_is_flexible_and_unknown_columns_warn():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, " Email ,NAME,Company\nann@example.com,Ann,Acme\n")
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == [RowIssue(1, "Company", "unknown column; its values are ignored")]
+
+
+def test_unnamed_column_warns_only_when_it_holds_values():
+    quiet = import_contacts(InMemoryContactRepository(), "name,email,\nAnn,ann@example.com,\n")
+    assert quiet.warnings == []
+    noisy = import_contacts(InMemoryContactRepository(), "name,email,\nAnn,ann@example.com,x\n")
+    assert noisy.warnings[0].column is None
+
+
+def test_utf8_bom_is_stripped_from_bytes_and_text():
+    for data in ("\ufeffname,email\nZoë,zoe@example.com\n".encode(), "\ufeffname,email\nZoë,zoe@example.com\n"):
+        repo = InMemoryContactRepository()
+        assert import_contacts(repo, data).created == ["zoe@example.com"]
+        assert repo.get("zoe@example.com").name == "Zoë"
+
+
+def test_crlf_line_endings():
+    report = import_contacts(InMemoryContactRepository(), b"name,email\r\nAnn,ann@example.com\r\n")
+    assert report.created == ["ann@example.com"]
+
+
+@pytest.mark.parametrize(
+    "data, fragment",
+    [
+        (b"", "empty"),
+        ("\n\n", "empty"),
+        ("name,phone\nAnn,5551234567\n", "'email'"),
+        ("name;email\nAnn;ann@example.com\n", "';'"),
+        ("name,email,Email\n", "more than once"),
+        ('name,email\n"Ann,ann@example.com\nBob,bob@example.com\n', "broken CSV"),
+        ("name,email\nZo\xeb,zoe@example.com\n".encode("latin-1"), "UTF-8"),
+    ],
+)
+def test_file_level_problems_raise_and_leave_repository_untouched(data, fragment):
+    repo = InMemoryContactRepository([Contact.create(name="Old", email="old@example.com")])
+    with pytest.raises(ImportFileError, match=fragment) as excinfo:
+        import_contacts(repo, data)
+    assert isinstance(excinfo.value, ContactError)
+    assert [c.email for c in repo] == ["old@example.com"]
+
+
+def test_broken_quoting_late_in_file_imports_nothing():
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, 'name,email\nAnn,ann@example.com\n"Bob" x,bob@example.com\n')
+    assert len(repo) == 0

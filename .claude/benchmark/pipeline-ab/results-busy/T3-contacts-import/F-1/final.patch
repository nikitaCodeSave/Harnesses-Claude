@@ -0,0 +1,261 @@
+"""CSV import of contacts.
+
+Reads files in the export format (``name,email,phone,tags``, tags joined with
+``;``) or the address-book format (``first_name`` and ``last_name`` instead of
+``name``). Contacts are created or updated by email; the report says what
+happened to every row, using the row numbers a spreadsheet shows.
+
+The whole file is parsed and checked before the repository is touched, so an
+ImportFileError leaves the repository exactly as it was.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_IMPORT_ROWS = 1000
+
+_BOM = "\ufeff"
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row; ``column`` is None when it concerns the whole row."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _Columns:
+    """Cell indexes of the known columns in the header."""
+
+    width: int
+    email: int
+    name: int | None
+    first_name: int | None
+    last_name: int | None
+    phone: int | None
+    tags: int | None
+
+
+@dataclass
+class _ParsedRow:
+    row: int
+    email: str | None = None
+    name: str | None = None
+    phone: str | None = None
+    tags: frozenset[str] = frozenset()
+    errors: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV file content.
+
+    Raises ImportFileError, without changing ``repo``, if the file can't be
+    imported as a whole: empty, not UTF-8, malformed CSV, a required column
+    missing from the header, or more than MAX_IMPORT_ROWS contact rows.
+    """
+    records = _read_records(_decode(data))
+    if not records:
+        raise ImportFileError("the file is empty")
+    _, header = records[0]
+    columns = _parse_header(header)
+
+    contact_rows = [(row, cells) for row, cells in records[1:] if not _is_blank(cells)]
+    if len(contact_rows) > MAX_IMPORT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(contact_rows)} contacts; "
+            f"at most {MAX_IMPORT_ROWS} can be imported at once"
+        )
+
+    report = ImportReport()
+    first_row_by_email: dict[str, int] = {}
+    to_apply: list[_ParsedRow] = []
+    for row, cells in contact_rows:
+        parsed = _parse_row(row, cells, columns, report)
+        if parsed.email is not None:
+            first_row = first_row_by_email.setdefault(parsed.email, row)
+            if first_row != row:
+                parsed.errors.insert(
+                    0,
+                    RowIssue(
+                        row,
+                        "email",
+                        f"{parsed.email} already appears in row {first_row}",
+                    ),
+                )
+        if parsed.errors:
+            report.errors.extend(parsed.errors)
+        else:
+            to_apply.append(parsed)
+
+    for parsed in to_apply:
+        _apply(repo, parsed, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, str):
+        text = data
+    else:
+        try:
+            text = bytes(data).decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise ImportFileError(
+                f"the file is not valid UTF-8 (byte {exc.start}); "
+                "re-save it as CSV UTF-8 and import it again"
+            ) from None
+    return text.removeprefix(_BOM)
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """Parse CSV text into (row number, cells) pairs.
+
+    The row number is the line a record starts on, counting every line of the
+    file, so it matches what a spreadsheet shows even with blank lines or
+    quoted cells spanning several lines.
+    """
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    records: list[tuple[int, list[str]]] = []
+    lines_read = 0
+    try:
+        for cells in reader:
+            records.append((lines_read + 1, cells))
+            lines_read = reader.line_num
+    except csv.Error as exc:
+        raise ImportFileError(f"row {lines_read + 1} is not valid CSV: {exc}") from None
+    return records
+
+
+def _parse_header(header: list[str]) -> _Columns:
+    positions: dict[str, int] = {}
+    for index, title in enumerate(header):
+        # On a repeated column name the first occurrence is used.
+        positions.setdefault(title.strip().lower(), index)
+
+    missing = []
+    if "email" not in positions:
+        missing.append("email")
+    has_name_pair = "first_name" in positions and "last_name" in positions
+    if "name" not in positions and not has_name_pair:
+        missing.append("name (or first_name and last_name)")
+    if missing:
+        raise ImportFileError(
+            "the first line must be a header with the columns name, email, phone, tags; "
+            f"missing: {', '.join(missing)}"
+        )
+
+    use_name = "name" in positions
+    return _Columns(
+        width=len(header),
+        email=positions["email"],
+        name=positions["name"] if use_name else None,
+        first_name=None if use_name else positions["first_name"],
+        last_name=None if use_name else positions["last_name"],
+        phone=positions.get("phone"),
+        tags=positions.get("tags"),
+    )
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _parse_row(
+    row: int, cells: list[str], columns: _Columns, report: ImportReport
+) -> _ParsedRow:
+    """Validate every field of a row; phone problems go straight to the report."""
+    parsed = _ParsedRow(row)
+
+    def cell(index: int | None) -> str:
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    if len(cells) > columns.width:
+        parsed.errors.append(
+            RowIssue(
+                row,
+                None,
+                f"has {len(cells)} cells but the header has {columns.width} columns",
+            )
+        )
+
+    try:
+        parsed.email = normalize_email(cell(columns.email))
+    except ValidationError as exc:
+        parsed.errors.append(RowIssue(row, "email", exc.message))
+
+    if columns.name is not None:
+        raw_name = cell(columns.name)
+    else:
+        parts = (cell(columns.first_name).strip(), cell(columns.last_name).strip())
+        raw_name = " ".join(part for part in parts if part)
+    try:
+        parsed.name = validate_name(raw_name)
+    except ValidationError as exc:
+        parsed.errors.append(RowIssue(row, "name", exc.message))
+
+    raw_phone = cell(columns.phone)
+    if raw_phone.strip():
+        try:
+            parsed.phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(row, "phone", f"{exc.message}; imported without a phone")
+            )
+
+    tags: set[str] = set()
+    invalid_tags: list[str] = []
+    for piece in cell(columns.tags).split(TAG_SEPARATOR):
+        if not piece.strip():
+            continue
+        try:
+            tags.add(normalize_tag(piece))
+        except ValidationError:
+            invalid_tags.append(piece.strip())
+    if invalid_tags:
+        listed = ", ".join(repr(tag) for tag in invalid_tags)
+        parsed.errors.append(RowIssue(row, "tags", f"invalid tag: {listed}"))
+    parsed.tags = frozenset(tags)
+
+    return parsed
+
+
+def _apply(repo: InMemoryContactRepository, parsed: _ParsedRow, report: ImportReport) -> None:
+    assert parsed.email is not None and parsed.name is not None
+    existing = repo.find(parsed.email)
+    if existing is None:
+        repo.add(
+            Contact(
+                name=parsed.name, email=parsed.email, phone=parsed.phone, tags=parsed.tags
+            )
+        )
+        report.created.append(parsed.email)
+        return
+
+    merged = replace(
+        existing,
+        name=parsed.name,
+        phone=parsed.phone or existing.phone,
+        tags=existing.tags | parsed.tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(parsed.email)

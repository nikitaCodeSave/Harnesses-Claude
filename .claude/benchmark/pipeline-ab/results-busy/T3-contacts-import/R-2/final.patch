@@ -0,0 +1,213 @@
+"""CSV import of contacts.
+
+Reads the format written by ``export_csv`` (and by Excel's "CSV UTF-8"), creates
+new contacts and merges rows into existing ones. Problems with the file as a
+whole raise ImportFileError before the repository is touched; problems with a
+single row are reported in the ImportReport and only skip that row.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_CONTACT_ROWS = 1000
+
+_BOM = "\ufeff"
+_KNOWN_COLUMNS = ("name", "email", "phone", "tags", "first_name", "last_name")
+
+
+@dataclass
+class RowIssue:
+    """A problem found in one row. ``row`` is the spreadsheet row number (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _Header:
+    width: int
+    columns: dict[str, int]  # known column -> cell index
+    use_first_last: bool
+
+
+@dataclass(frozen=True)
+class _RowValues:
+    name: str
+    email: str
+    phone: str | None
+    tags: frozenset[str]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import CSV ``data`` into ``repo`` and report what happened row by row.
+
+    Raises ImportFileError (leaving ``repo`` untouched) if the file can't be
+    imported at all; row-level problems end up in the returned report.
+    """
+    rows = _read_rows(_decode(data))
+    report = ImportReport()
+    if not rows or _is_blank(rows[0][1]):
+        raise ImportFileError("the file is empty or its first row (the header) is blank")
+    header = _parse_header(rows[0][1], report)
+
+    contact_rows = [(number, cells) for number, cells in rows[1:] if not _is_blank(cells)]
+    if len(contact_rows) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(contact_rows)} contact rows; at most {MAX_CONTACT_ROWS} are allowed"
+        )
+
+    accepted: set[str] = set()
+    for number, cells in contact_rows:
+        values = _read_row(number, cells, header, report)
+        if values is None:
+            continue
+        if values.email in accepted:
+            report.errors.append(
+                RowIssue(number, "email", f"duplicate email {values.email} (already imported above)")
+            )
+            continue
+        accepted.add(values.email)
+        _apply(repo, values, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not valid UTF-8; re-save it as "CSV UTF-8" and import it again'
+            ) from None
+    if isinstance(data, str):
+        return data.removeprefix(_BOM)
+    raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+
+
+def _read_rows(text: str) -> list[tuple[int, list[str]]]:
+    """Parse CSV text into (row number, cells) pairs; row 1 is the header."""
+    try:
+        return list(enumerate(csv.reader(io.StringIO(text, newline="")), start=1))
+    except csv.Error as exc:
+        raise ImportFileError(f"the file is not valid CSV: {exc}") from None
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _parse_header(cells: list[str], report: ImportReport) -> _Header:
+    positions: dict[str, list[int]] = {}
+    for index, cell in enumerate(cells):
+        positions.setdefault(cell.strip().lower(), []).append(index)
+
+    repeated = [name for name in _KNOWN_COLUMNS if len(positions.get(name, ())) > 1]
+    if repeated:
+        raise ImportFileError(f"column {repeated[0]!r} appears more than once in the header")
+    if "email" not in positions:
+        raise ImportFileError("the header has no 'email' column")
+
+    if "name" in positions:
+        use_first_last = False
+        used = ("name", "email", "phone", "tags")
+    elif "first_name" in positions and "last_name" in positions:
+        use_first_last = True
+        used = ("first_name", "last_name", "email", "phone", "tags")
+    else:
+        raise ImportFileError(
+            "the header needs a 'name' column, or both 'first_name' and 'last_name' columns"
+        )
+
+    columns = {name: positions[name][0] for name in used if name in positions}
+    known_indexes = set(columns.values())
+    for index, cell in enumerate(cells):
+        if index not in known_indexes:
+            report.warnings.append(
+                RowIssue(1, None, f"unknown column {cell.strip()!r} is ignored")
+            )
+    return _Header(width=len(cells), columns=columns, use_first_last=use_first_last)
+
+
+def _read_row(
+    number: int, cells: list[str], header: _Header, report: ImportReport
+) -> _RowValues | None:
+    """Validate one contact row; return its normalised values, or None if it is an error."""
+    if len(cells) > header.width:
+        report.errors.append(
+            RowIssue(number, None, f"row has {len(cells)} cells but the header has {header.width}")
+        )
+        return None
+
+    def cell(column: str) -> str:
+        index = header.columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    errors: list[RowIssue] = []
+
+    def check(column: str, normalise, raw: str):
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(number, column, f"{column} {exc.message}"))
+            return None
+
+    if header.use_first_last:
+        raw_name = " ".join(
+            part for part in (cell("first_name").strip(), cell("last_name").strip()) if part
+        )
+    else:
+        raw_name = cell("name")
+    name = check("name", validate_name, raw_name)
+    email = check("email", normalize_email, cell("email"))
+    pieces = [piece for piece in cell("tags").split(TAG_SEPARATOR) if piece.strip()]
+    tags = [check("tags", normalize_tag, piece) for piece in pieces]
+
+    phone = None
+    raw_phone = cell("phone")
+    if raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(number, "phone", f"phone {exc.message}; the phone was not imported")
+            )
+
+    if errors:
+        report.errors.extend(errors)
+        return None
+    return _RowValues(name=name, email=email, phone=phone, tags=frozenset(tags))
+
+
+def _apply(repo: InMemoryContactRepository, values: _RowValues, report: ImportReport) -> None:
+    existing = repo.find(values.email)
+    if existing is None:
+        repo.add(Contact(name=values.name, email=values.email, phone=values.phone, tags=values.tags))
+        report.created.append(values.email)
+        return
+    merged = replace(
+        existing,
+        name=values.name,
+        phone=values.phone if values.phone is not None else existing.phone,
+        tags=existing.tags | values.tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(values.email)

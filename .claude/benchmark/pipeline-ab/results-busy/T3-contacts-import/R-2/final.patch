+"""SPEC.md, File size and File-level failure (AC 15-18)."""
+
+import pytest
+from _support import (
+    HEADER,
+    ann,
+    assert_file_error,
+    csv_text,
+    import_contacts,
+    importer,
+    repo_with,
+)
+
+from contactbook.errors import ContactError
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def person_rows(count):
+    return [f"Person {i},person{i}@example.com,," for i in range(count)]
+
+
+# AC 15
+
+
+def test_more_than_1000_contact_rows_is_a_file_error():
+    assert_file_error(InMemoryContactRepository(), csv_text(HEADER, *person_rows(1001)))
+
+
+def test_invalid_rows_count_towards_the_limit():
+    rows = person_rows(1000) + ["Bad Row,not-an-email,,"]
+    assert_file_error(InMemoryContactRepository(), csv_text(HEADER, *rows))
+
+
+# AC 16
+
+
+def test_exactly_1000_contact_rows_are_accepted():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, csv_text(HEADER, *person_rows(1000)))
+    assert report.errors == []
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_blank_rows_do_not_count_towards_the_limit():
+    rows = []
+    for i, row in enumerate(person_rows(1000)):
+        rows.append(row)
+        rows.append(["", ",,,", "  , ,\t,"][i % 3])
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, csv_text(HEADER, *rows))
+    assert report.errors == []
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+# AC 17
+
+
+def test_file_error_after_valid_rows_leaves_repository_untouched():
+    existing = [ann(phone="+1 555 123 4567", tags=["vip"]), Contact.create(name="Bob", email="bob@example.com")]
+    repo = repo_with(*existing)
+    rows = ["Ann Smith,ann@example.com,+44 20 7946 0000,lead", "Bob Stone,bob@example.com,,new"]
+    rows += person_rows(999)
+    assert_file_error(repo, csv_text(HEADER, *rows))
+    assert repo.all() == existing
+
+
+def test_header_file_error_leaves_repository_untouched():
+    existing = ann(tags=["vip"])
+    repo = repo_with(existing)
+    assert_file_error(repo, csv_text("name,email,email", "Ann Smith,ann@example.com,ann@example.com"))
+    assert repo.all() == [existing]
+
+
+# AC 18
+
+
+def test_row_problems_are_reported_not_raised():
+    data = csv_text(
+        HEADER,
+        ",,,",
+        "Ann Lee,,,",
+        ",ann@example.com,,",
+        "Ann Lee,not-an-email,,",
+        "Ann Lee,ann@example.com,not a phone,bad!tag",
+        "Ann Lee,ann@example.com,,,extra",
+        "Bob Stone,bob@example.com,,",
+        "Bob Stone,bob@example.com,,",
+    )
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert report.created == ["bob@example.com"]
+    assert {issue.row for issue in report.errors} == {3, 4, 5, 6, 7, 9}
+
+
+@pytest.mark.parametrize("data", [123, None, ["name,email", "Ann Lee,ann@example.com"]])
+def test_data_that_is_neither_str_nor_bytes_is_a_programming_error(data):
+    import_contacts_function = importer().import_contacts
+    repo = repo_with(ann())
+    with pytest.raises(Exception) as info:
+        import_contacts_function(repo, data)
+    assert not isinstance(info.value, ContactError)
+    assert repo.all() == [ann()]

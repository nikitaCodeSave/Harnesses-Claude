+    HEADER,
+    ann,
+    csv_text,
+    error_rows,
+    import_contacts,
+    issue_set,
+    repo_with,
+)
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+# AC 26
+
+
+@pytest.mark.parametrize(
+    "row, column",
+    [
+        ("Ann Lee,,,", "email"),
+        ("Ann Lee,   ,,", "email"),
+        ("Ann Lee,not-an-email,,", "email"),
+        ("Ann Lee,ann@@example.com,,", "email"),
+        (",ann@example.com,,", "name"),
+        ("   ,ann@example.com,,", "name"),
+        (f"{'A' * 101},ann@example.com,,", "name"),
+        ("Ann Lee,ann@example.com,,bad!tag", "tags"),
+        ("Ann Lee,ann@example.com,,vip;bad!tag;lead", "tags"),
+        (f"Ann Lee,ann@example.com,,{'x' * 33}", "tags"),
+        ("Ann Lee,ann@example.com,,,extra", None),
+    ],
+)
+def test_row_problem_is_an_error_on_its_column(row, column):
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, csv_text(HEADER, row))
+    assert issue_set(report.errors) == {(2, column)}
+    assert report.created == [] and report.updated == []
+    assert len(repo) == 0
+
+
+def test_duplicate_email_is_an_email_error():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,,", "Ann Smith,ann@example.com,,"))
+    assert issue_set(report.errors) == {(3, "email")}
+
+
+# AC 27
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        "Ann Smith,ann@example.com,+44 20 7946 0000,lead;bad!tag",
+        f"{'A' * 101},ann@example.com,+44 20 7946 0000,lead",
+        ",ann@example.com,+44 20 7946 0000,lead",
+        "Ann Smith,ann@example.com,+44 20 7946 0000,lead,extra",
+    ],
+    ids=["bad-tag", "name-too-long", "name-missing", "too-many-cells"],
+)
+def test_error_row_does_not_change_existing_contact_at_all(row):
+    existing = ann(phone="+1 555 123 4567", tags=["vip"])
+    repo = repo_with(existing)
+    report = import_contacts(repo, csv_text(HEADER, row))
+    assert error_rows(report) == {2}
+    assert report.created == [] and report.updated == []
+    assert repo.all() == [existing]
+
+
+# AC 28
+
+

@@ -0,0 +1,245 @@
+"""SPEC.md, Header (AC 6-14)."""
+
+import pytest
+from _support import (
+    ann,
+    assert_empty_report,
+    assert_file_error,
+    csv_text,
+    import_contacts,
+    issue_set,
+    issues,
+    repo_with,
+)
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+# AC 6
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "",
+        b"",
+        b"\xef\xbb\xbf",
+        "\ufeff",
+        "\nname,email\nAnn Lee,ann@example.com\n",
+        b"\r\nname,email\r\nAnn Lee,ann@example.com\r\n",
+        ",\nname,email\nAnn Lee,ann@example.com\n",
+        "  , \t\nname,email\nAnn Lee,ann@example.com\n",
+        "   \n",
+    ],
+    ids=[
+        "empty-text",
+        "empty-bytes",
+        "bom-only-bytes",

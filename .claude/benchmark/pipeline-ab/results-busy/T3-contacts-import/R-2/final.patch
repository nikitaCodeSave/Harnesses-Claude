+++ b/tests/acceptance/test_import_decoding.py
@@ -0,0 +1,167 @@
+"""SPEC.md, Decoding (AC 1-5)."""
+
+import pytest
+from _support import (
+    HEADER,
+    ann,
+    assert_file_error,
+    csv_text,
+    import_contacts,
+    issue_set,
+    repo_with,
+)
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+BOM = b"\xef\xbb\xbf"
+
+
+# AC 1
+
+
+def test_bytes_are_decoded_as_utf8():
+    repo = InMemoryContactRepository()
+    data = csv_text("name,email", "José Zoë Ünal,jose@example.com").encode("utf-8")
+    report = import_contacts(repo, data)
+    assert report.errors == []
+    assert report.created == ["jose@example.com"]
+    assert repo.get("jose@example.com").name == "José Zoë Ünal"
+
+
+@pytest.mark.parametrize("encoding", ["cp1252", "latin-1", "utf-16"])
+def test_no_other_encoding_is_attempted(encoding):
+    data = csv_text("name,email", "José Lee,jose@example.com").encode(encoding)
+    assert_file_error(InMemoryContactRepository(), data)
+
+
+# AC 2
+
+
+def test_invalid_utf8_tells_the_user_to_resave_as_csv_utf8():
+    data = csv_text("name,email", "José Lee,jose@example.com").encode("cp1252")
+    error = assert_file_error(InMemoryContactRepository(), data)
+    assert "CSV UTF-8" in str(error)
+
+
+def test_invalid_utf8_late_in_the_file_imports_nothing():
+    existing = ann()
+    repo = repo_with(existing)
+    data = (
+        csv_text(HEADER, "Ann Smith,ann@example.com,,lead", "Bob Stone,bob@example.com,,")
+        .encode("utf-8")
+        + b"Jos\xe9 Lee,jose@example.com,,\n"
+    )
+    error = assert_file_error(repo, data)
+    assert "CSV UTF-8" in str(error)
+    assert repo.all() == [existing]
+
+
+# AC 3
+
+
+@pytest.mark.parametrize("first_column", ["email", "name"])
+@pytest.mark.parametrize("as_bytes", [True, False], ids=["bytes", "text"])
+def test_leading_bom_is_ignored(first_column, as_bytes):
+    other = "name" if first_column == "email" else "email"
+    cells = {"email": "ann@example.com", "name": "Ann Lee"}
+    bad = {"email": "not-an-email", "name": "Bob Stone"}
+    plain = csv_text(
+        f"{first_column},{other},phone,tags",
+        f"{cells[first_column]},{cells[other]},+1 555 123 4567,vip",
+        f"{bad[first_column]},{bad[other]},,",
+    )
+    if as_bytes:
+        without_bom, with_bom = plain.encode("utf-8"), BOM + plain.encode("utf-8")
+    else:
+        without_bom, with_bom = plain, "\ufeff" + plain
+
+    plain_repo = InMemoryContactRepository()
+    plain_report = import_contacts(plain_repo, without_bom)
+    bom_repo = InMemoryContactRepository()
+    bom_report = import_contacts(bom_repo, with_bom)
+
+    assert bom_report.created == ["ann@example.com"]
+    assert bom_report.warnings == []
+    assert issue_set(bom_report.errors) == {(3, "email")}
+    assert bom_repo.all() == [
+        Contact.create(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"])
+    ]
+
+    assert bom_report.created == plain_report.created
+    assert bom_report.updated == plain_report.updated
+    assert [(i.row, i.column, i.message) for i in bom_report.errors] == [
+        (i.row, i.column, i.message) for i in plain_report.errors
+    ]
+    assert [(i.row, i.column, i.message) for i in bom_report.warnings] == [
+        (i.row, i.column, i.message) for i in plain_report.warnings
+    ]
+    assert bom_repo.all() == plain_repo.all()
+
+
+def test_excel_csv_utf8_file_with_bom_and_crlf_is_imported():
+    data = BOM + csv_text(HEADER, "Ann Lee,ann@example.com,,vip", newline="\r\n").encode("utf-8")
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.all() == [Contact.create(name="Ann Lee", email="ann@example.com", tags=["vip"])]
+
+
+# AC 4
+
+
+def test_text_input_is_used_as_is():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, csv_text("name,email", "JosÃ© Zoë,jose@example.com"))
+    assert report.created == ["jose@example.com"]
+    assert repo.get("jose@example.com").name == "JosÃ© Zoë"
+
+
+# AC 5
+
+
+def test_quoted_cells_may_contain_commas_and_quotes():
+    repo = InMemoryContactRepository()
+    data = csv_text(HEADER, '"Lee, Ann ""The Ace""",ann@example.com,,"vip;lead"')
+    report = import_contacts(repo, data)
+    assert report.errors == []
+    assert repo.all() == [
+        Contact(
+            name='Lee, Ann "The Ace"',
+            email="ann@example.com",
+            tags=frozenset({"vip", "lead"}),
+        )
+    ]
+
+
+def test_quoted_cell_may_contain_a_line_break():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, csv_text(HEADER, '"Ann\nLee",ann@example.com,,'))
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n"], ids=["LF", "CRLF"])
+@pytest.mark.parametrize("as_bytes", [True, False], ids=["bytes", "text"])
+def test_lf_and_crlf_line_endings_are_accepted(newline, as_bytes):
+    text = csv_text(
+        HEADER,
+        "Ann Lee,ann@example.com,555 123 4567,vip",
+        "Bob Stone,bob@example.com,,",
+        newline=newline,
+    )
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, text.encode("utf-8") if as_bytes else text)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == [] and report.warnings == []
+    assert repo.all() == [
+        Contact(name="Ann Lee", email="ann@example.com", phone="5551234567", tags=frozenset({"vip"})),
+        Contact(name="Bob Stone", email="bob@example.com"),
+    ]
+
+
+def test_semicolon_is_not_a_delimiter():
+    data = csv_text("name;email", "Ann Lee;ann@example.com")
+    assert_file_error(InMemoryContactRepository(), data)

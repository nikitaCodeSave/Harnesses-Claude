+
+# AC 32
+
+
+def test_error_row_does_not_claim_its_email_for_a_new_contact():
+    repo = InMemoryContactRepository()
+    data = csv_text(HEADER, "Ann Lee,ann@example.com,,bad!tag", "Ann Smith,ann@example.com,,lead")

+"""SPEC.md, Interface."""
+
+import dataclasses
+import inspect
+
+from _support import (
+    csv_text,
+    import_contacts,
+    import_file_error_class,
+    importer,
+)
+
+from contactbook.errors import ContactError
+from contactbook.repository import InMemoryContactRepository
+
+
+def test_import_contacts_takes_repo_and_data():
+    parameters = list(inspect.signature(importer().import_contacts).parameters)
+    assert parameters == ["repo", "data"]
+
+
+def test_import_report_is_a_dataclass_with_four_lists():
+    report_class = importer().ImportReport
+    assert dataclasses.is_dataclass(report_class)
+    names = {field.name for field in dataclasses.fields(report_class)}
+    assert {"created", "updated", "errors", "warnings"} <= names
+
+
+def test_row_issue_is_a_dataclass_with_row_column_message():
+    row_issue = importer().RowIssue
+    assert dataclasses.is_dataclass(row_issue)
+    names = {field.name for field in dataclasses.fields(row_issue)}
+    assert {"row", "column", "message"} <= names
+    issue = row_issue(row=2, column="email", message="is required")
+    assert (issue.row, issue.column, issue.message) == (2, "email", "is required")
+    assert row_issue(row=1, column=None, message="unknown column").column is None
+
+
+def test_import_returns_an_import_report_of_row_issues():
+    module = importer()
+    data = csv_text(
+        "name,email,phone,Company",
+        "Ann Lee,ann@example.com,not a phone,Acme",
+        "Bob Stone,not-an-email,,Acme",
+    )
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert isinstance(report, module.ImportReport)
+    assert report.created == ["ann@example.com"]
+    assert report.updated == []
+    assert report.errors and report.warnings
+    assert all(isinstance(issue, module.RowIssue) for issue in report.errors)
+    assert all(isinstance(issue, module.RowIssue) for issue in report.warnings)
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(import_file_error_class(), ContactError)

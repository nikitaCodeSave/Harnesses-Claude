+"""SPEC.md, New contacts and Existing contacts (AC 35-39)."""
+
+import pytest
+from _support import (
+    HEADER,
+    ann,
+    csv_text,
+    import_contacts,
+    issues,
+    repo_with,
+)
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+# AC 35-36
+
+
+def test_new_contact_gets_name_email_phone_and_tags():
+    repo = repo_with(ann())
+    report = import_contacts(repo, csv_text(HEADER, "Bob Stone,Bob@Example.com,+44 20 7946 0000,Lead;Key Account"))
+    assert report.errors == [] and report.warnings == []
+    assert report.created == ["bob@example.com"]
+    assert report.updated == []
+    assert repo.get("bob@example.com") == Contact(
+        name="Bob Stone",
+        email="bob@example.com",
+        phone="+442079460000",
+        tags=frozenset({"lead", "key-account"}),
+    )
+    assert repo.get("ann@example.com") == ann()
+
+
+def test_new_contact_without_phone_or_tags():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, csv_text(HEADER, "Bob Stone,bob@example.com,,"))
+    assert report.created == ["bob@example.com"]
+    assert repo.all() == [Contact(name="Bob Stone", email="bob@example.com")]
+
+
+def test_created_emails_are_appended_in_file_order():
+    repo = InMemoryContactRepository()
+    data = csv_text(HEADER, "Cat Moss,Cat@Example.com,,", "Ann Lee, ann@example.com,,", "Bob Stone,BOB@EXAMPLE.COM,,")
+    report = import_contacts(repo, data)
+    assert report.created == ["cat@example.com", "ann@example.com", "bob@example.com"]
+    assert [contact.email for contact in repo.all()] == report.created
+
+
+# AC 37-38
+
+
+def test_existing_contact_gets_new_name_phone_and_added_tags():
+    bob = Contact.create(name="Bob Stone", email="bob@example.com", phone="555 000 1111", tags=["partner"])
+    repo = repo_with(ann(phone="+1 555 123 4567", tags=["vip"]), bob)
+    report = import_contacts(repo, csv_text(HEADER, "Ann Smith,ANN@Example.com,+44 20 7946 0000,lead"))
+    assert report.errors == [] and report.warnings == []
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="+442079460000",
+        tags=frozenset({"vip", "lead"}),
+    )
+    assert repo.get("bob@example.com") == bob
+    assert len(repo) == 2
+
+
+@pytest.mark.parametrize(
+    "row, expected",
+    [
+        ("Ann Smith,ann@example.com,,", Contact(name="Ann Smith", email="ann@example.com", phone="+15551234567", tags=frozenset({"vip", "partner"}))),
+        ("Ann Lee,ann@example.com,020 7946 0000,", Contact(name="Ann Lee", email="ann@example.com", phone="02079460000", tags=frozenset({"vip", "partner"}))),
+        ("Ann Lee,ann@example.com,,lead", Contact(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=frozenset({"vip", "partner", "lead"}))),
+        ("Ann Lee,ann@example.com,,vip;lead", Contact(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=frozenset({"vip", "partner", "lead"}))),
+    ],
+    ids=["name-only", "phone-only", "new-tag", "old-and-new-tag"],
+)
+def test_existing_contact_changes_only_what_the_row_changes(row, expected):
+    repo = repo_with(ann(phone="+1 555 123 4567", tags=["vip", "partner"]))
+    report = import_contacts(repo, csv_text(HEADER, row))
+    assert report.errors == [] and report.warnings == []
+    assert report.updated == ["ann@example.com"]
+    assert repo.all() == [expected]
+
+
+def test_import_never_removes_a_tag():
+    repo = repo_with(ann(tags=["vip", "partner"]))
+    report = import_contacts(repo, csv_text(HEADER, "Ann Smith,ann@example.com,,lead"))
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").tags == {"vip", "partner", "lead"}
+
+
+def test_updated_emails_are_appended_in_file_order():
+    repo = repo_with(
+        ann(),
+        Contact.create(name="Bob Stone", email="bob@example.com"),
+        Contact.create(name="Cat Moss", email="cat@example.com"),
+    )
+    data = csv_text(HEADER, "Cat Moss,cat@example.com,,new", "Bob Stone,bob@example.com,,", "Ann Smith,Ann@Example.com,,")
+    report = import_contacts(repo, data)
+    assert report.created == []
+    assert report.updated == ["cat@example.com", "ann@example.com"]
+
+
+# AC 39
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        "Ann Lee,ann@example.com,+15551234567,vip",
+        "  Ann   Lee ,ANN@example.com,+1 (555) 123-4567, VIP ",
+        "Ann Lee,ann@example.com,,",
+        "Ann Lee,ann@example.com,,partner",
+        "Ann Lee,ann@example.com,,vip;partner;VIP",
+    ],
+    ids=["same-values", "same-after-normalising", "nothing-new", "subset-of-tags", "same-tags-repeated"],
+)
+def test_row_that_changes_nothing_is_in_neither_list(row):
+    existing = ann(phone="+1 555 123 4567", tags=["vip", "partner"])
+    repo = repo_with(existing)
+    report = import_contacts(repo, csv_text(HEADER, row))
+    assert report.errors == [] and report.warnings == []
+    assert report.created == [] and report.updated == []
+    assert repo.all() == [existing]
+
+
+def test_row_that_changes_nothing_still_reports_its_phone_warning():
+    existing = ann(phone="+1 555 123 4567", tags=["vip"])
+    repo = repo_with(existing)
+    report = import_contacts(repo, csv_text(HEADER, "Ann Lee,ann@example.com,not a phone,vip"))
+    assert report.errors == []
+    assert issues(report.warnings) == [(2, "phone")]
+    assert report.created == [] and report.updated == []
+    assert repo.all() == [existing]

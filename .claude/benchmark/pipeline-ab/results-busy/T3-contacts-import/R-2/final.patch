@@ -0,0 +1,75 @@
+"""Helpers shared by the CSV import acceptance tests (SPEC.md).
+
+The importer's names are looked up when a test runs, not when the module is
+collected, so that each test reports its own failure while the feature is
+missing instead of the whole suite stopping at collection.
+"""
+
+from __future__ import annotations
+
+import importlib
+
+import pytest
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags"
+
+
+def importer():
+    return importlib.import_module("contactbook.importer")
+
+
+def import_file_error_class():
+    return importlib.import_module("contactbook.errors").ImportFileError
+
+
+def import_contacts(repo, data):
+    return importer().import_contacts(repo, data)
+
+
+def raises_import_file_error():
+    return pytest.raises(import_file_error_class())
+
+
+def assert_file_error(repo, data):
+    """Import must raise ImportFileError and leave ``repo`` exactly as it was (AC 17)."""
+    before = repo.all()
+    with raises_import_file_error() as info:
+        import_contacts(repo, data)
+    assert repo.all() == before
+    return info.value
+
+
+def csv_text(*lines: str, newline: str = "\n") -> str:
+    return "".join(line + newline for line in lines)
+
+
+def repo_with(*contacts: Contact) -> InMemoryContactRepository:
+    return InMemoryContactRepository(contacts)
+
+
+def ann(**overrides) -> Contact:
+    fields = {"name": "Ann Lee", "email": "ann@example.com"}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def issues(items) -> list[tuple[int, str | None]]:
+    return [(issue.row, issue.column) for issue in items]
+
+
+def issue_set(items) -> set[tuple[int, str | None]]:
+    return {(issue.row, issue.column) for issue in items}
+
+
+def error_rows(report) -> set[int]:
+    return {issue.row for issue in report.errors}
+
+
+def assert_empty_report(report) -> None:
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []

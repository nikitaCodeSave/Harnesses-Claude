@@ -0,0 +1,355 @@
+import pytest
+
+import contactbook
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import MAX_IMPORT_ROWS, ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def ann(**changes):
+    values = dict(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"])
+    values.update(changes)
+    return Contact.create(**values)
+
+
+# Interface
+
+
+def test_public_interface():
+    assert issubclass(ImportFileError, ContactError)
+    assert contactbook.import_contacts is import_contacts
+    assert contactbook.ImportReport is ImportReport
+    assert contactbook.RowIssue is RowIssue
+    assert contactbook.ImportFileError is ImportFileError
+    issue = RowIssue(row=2, column=None, message="x")
+    assert (issue.row, issue.column, issue.message) == (2, None, "x")
+
+
+def test_round_trips_an_export():
+    contacts = [ann(), Contact.create(name="Bob Stone", email="bob@example.com")]
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, export_csv(contacts))
+    assert report == ImportReport(created=["ann@example.com", "bob@example.com"])
+    assert repo.all() == contacts
+
+
+# Decoding (1-4)
+
+
+def test_bytes_are_utf8_and_bom_is_ignored():
+    data = "\ufeffName,Email\nZoë Müller,zoe@example.com\n".encode("utf-8")
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["zoe@example.com"]
+    assert report.warnings == []
+    assert repo.get("zoe@example.com").name == "Zoë Müller"
+
+
+def test_str_bom_is_ignored():
+    report = import_contacts(InMemoryContactRepository(), "\ufeffname,email\nAnn,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == []
+
+
+def test_invalid_utf8_asks_to_resave_as_csv_utf8():
+    data = "name,email\nZoë,zoe@example.com\n".encode("cp1252")
+    with pytest.raises(ImportFileError, match='"CSV UTF-8"'):
+        import_contacts(InMemoryContactRepository(), data)
+
+
+def test_quoted_fields_and_crlf_line_endings():
+    data = 'name,email,tags\r\n"Lee, Ann",ann@example.com,"vip;lead"\r\n'
+    repo = InMemoryContactRepository()
+    import_contacts(repo, data)
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Lee, Ann", email="ann@example.com", tags=["vip", "lead"]
+    )
+
+
+def test_rejects_non_text_input():

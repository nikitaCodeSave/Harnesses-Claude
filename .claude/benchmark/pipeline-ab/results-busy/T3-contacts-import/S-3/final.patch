+"""CSV import of contacts.
+
+Reads the format written by export.py (``name,email,phone,tags``), plus files
+from the address-book export that split the name into ``first_name`` and
+``last_name``. Rows are merged into the repository; see SPEC.md for the rules.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_IMPORT_ROWS = 1000
+OPTIONAL_COLUMNS = ("phone", "tags")
+NAME_PARTS = ("first_name", "last_name")
+
+
+@dataclass
+class RowIssue:
+    """A problem in one row. ``row`` is the spreadsheet row number (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    """What an import did. Emails are normalised; all lists are in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class _ValidRow:
+    name: str
+    email: str
+    phone: str | None
+    tags: frozenset[str]
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import CSV ``data`` into ``repo`` and report what happened.
+
+    Rows with invalid values are skipped and reported in ``errors``; the rest
+    are applied. Raises ImportFileError, leaving ``repo`` untouched, when the
+    file as a whole can't be imported.
+    """
+    rows = _read_rows(_decode(data))
+    if all(_is_blank(cells) for cells in rows):
+        raise ImportFileError("the file is empty")
+    if _is_blank(rows[0]):
+        raise ImportFileError("row 1 must be the header (name, email, phone, tags)")
+
+    header = rows[0]
+    report = ImportReport()
+    columns = _parse_header(header, report)
+
+    contact_rows = [
+        (number, cells)
+        for number, cells in enumerate(rows[1:], start=2)
+        if not _is_blank(cells)
+    ]
+    if len(contact_rows) > MAX_IMPORT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(contact_rows)} contacts; "
+            f"at most {MAX_IMPORT_ROWS} can be imported at once"
+        )
+
+    valid: list[_ValidRow] = []
+    first_row_for_email: dict[str, int] = {}
+    for number, cells in contact_rows:
+        row = _validate_row(number, cells, len(header), columns, first_row_for_email, report)
+        if row is not None:
+            valid.append(row)
+
+    for row in valid:
+        _apply(repo, row, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and try again'
+            ) from None
+    if isinstance(data, str):
+        return data.removeprefix("\ufeff")
+    raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+
+
+def _read_rows(text: str) -> list[list[str]]:
+    """Parse CSV text into rows; blank lines stay in as empty rows to keep numbering."""
+    try:
+        return list(csv.reader(io.StringIO(text, newline="")))
+    except csv.Error as exc:
+        raise ImportFileError(f"the file is not valid CSV: {exc}") from None
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _parse_header(header: list[str], report: ImportReport) -> dict[str, int]:
+    """Map known column names to cell positions; warn about the rest."""
+    positions: dict[str, int] = {}
+    for index, raw in enumerate(header):
+        name = raw.strip().lower()
+        if not name:
+            continue
+        if name in positions:
+            raise ImportFileError(f"the header has column {name!r} more than once")
+        positions[name] = index
+
+    if "name" in positions:
+        known = {"name"}
+    elif all(part in positions for part in NAME_PARTS):
+        known = set(NAME_PARTS)
+    else:
+        known = set()
+    known |= {"email", *OPTIONAL_COLUMNS} & positions.keys()
+
+    missing = []
+    if not known & {"name", *NAME_PARTS}:
+        missing.append("name (or first_name and last_name)")
+    if "email" not in positions:
+        missing.append("email")
+    if missing:
+        raise ImportFileError(f"missing column: {', '.join(missing)}")
+
+    for name, index in positions.items():
+        if name not in known:
+            report.warnings.append(
+                RowIssue(1, header[index].strip(), "unknown column, its values are ignored")
+            )
+    return {name: index for name, index in positions.items() if name in known}
+
+
+def _validate_row(
+    number: int,
+    cells: list[str],
+    header_width: int,
+    columns: dict[str, int],
+    first_row_for_email: dict[str, int],
+    report: ImportReport,
+) -> _ValidRow | None:
+    """Validate one row; record its errors and return None if it can't be applied."""
+    errors: list[RowIssue] = []
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    def check(column: str, normalise, raw):
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(number, column, exc.message))
+            return None
+
+    if "name" in columns:
+        raw_name = cell("name")
+    else:
+        raw_name = " ".join(cell(part) for part in NAME_PARTS)
+    name = check("name", validate_name, raw_name)
+
+    email = check("email", normalize_email, cell("email"))
+    if email is not None:
+        if email in first_row_for_email:
+            errors.append(
+                RowIssue(number, "email", f"duplicate of row {first_row_for_email[email]}")
+            )
+        else:
+            first_row_for_email[email] = number
+
+    raw_phone = cell("phone")
+    phone = check("phone", normalize_phone, raw_phone) if raw_phone.strip() else None
+    tags = check("tags", _parse_tags, cell("tags"))
+
+    if any(extra.strip() for extra in cells[header_width:]):
+        errors.append(
+            RowIssue(number, None, f"row has {len(cells)} cells but the header has {header_width}")
+        )
+
+    if errors:
+        report.errors.extend(errors)
+        return None
+    return _ValidRow(name=name, email=email, phone=phone, tags=tags)
+
+
+def _parse_tags(raw: str) -> frozenset[str]:
+    return frozenset(
+        normalize_tag(piece) for piece in raw.split(TAG_SEPARATOR) if piece.strip()
+    )
+
+
+def _apply(repo: InMemoryContactRepository, row: _ValidRow, report: ImportReport) -> None:
+    existing = repo.find(row.email)
+    if existing is None:
+        repo.add(Contact(name=row.name, email=row.email, phone=row.phone, tags=row.tags))
+        report.created.append(row.email)
+        return
+    merged = replace(
+        existing,
+        name=row.name,
+        phone=row.phone or existing.phone,
+        tags=existing.tags | row.tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(row.email)

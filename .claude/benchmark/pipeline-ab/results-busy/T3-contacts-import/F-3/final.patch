+"""CSV import of contacts.
+
+Reads the format written by ``export.py`` (columns ``name``, ``email``,
+``phone``, ``tags``; tags joined with TAG_SEPARATOR). The whole file is parsed
+and checked before anything is written, so a file rejected with
+ImportFileError leaves the repository untouched; otherwise every valid row is
+applied and the report says what happened to each of the others.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_CONTACT_ROWS = 1000
+REQUIRED_COLUMNS = ("name", "email")
+KNOWN_COLUMNS = ("name", "email", "phone", "tags")
+
+_BOM = "\ufeff"
+_HEADER_ROW = 1
+
+
+@dataclass(frozen=True, slots=True)
+class RowIssue:
+    """A problem found at ``row`` (Excel row number; the header is row 1).
+
+    ``column`` is the field the problem belongs to, or None if it concerns the
+    row as a whole.
+    """
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+@dataclass(frozen=True, slots=True)
+class _Header:
+    width: int
+    positions: dict[str, int]  # known column name -> cell index
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV ``data``.
+
+    Raises ImportFileError, without touching ``repo``, if the file can't be
+    imported at all.
+    """
+    rows = _read_rows(_decode(data))
+    if not rows or _is_blank(rows[0]):
+        raise ImportFileError(
+            "The file is empty or has no header line. The first line must list "
+            "the column names, e.g. name,email,phone,tags."
+        )
+
+    report = ImportReport()
+    header = _parse_header(rows[0], report)
+
+    numbered = [
+        (number, cells)
+        for number, cells in enumerate(rows[1:], start=_HEADER_ROW + 1)
+        if not _is_blank(cells)
+    ]
+    if len(numbered) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"The file has {len(numbered)} contacts; at most {MAX_CONTACT_ROWS} "
+            "can be imported at once. Split it into smaller files."
+        )
+
+    # Everything below only works on rows; the repository is first written to here.
+    claimed: dict[str, int] = {}  # email -> row number of the row that won
+    for number, cells in numbered:
+        _import_row(repo, header, number, cells, claimed, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, str):
+        text = data
+    elif isinstance(data, (bytes, bytearray, memoryview)):
+        try:
+            text = bytes(data).decode("utf-8")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'The file is not UTF-8 encoded. In Excel, use "Save As" and choose '
+                'the "CSV UTF-8" format, then import it again.'
+            ) from None
+    else:
+        raise TypeError(f"data must be str or bytes, not {type(data).__name__}")
+    return text.removeprefix(_BOM)
+
+
+def _read_rows(text: str) -> list[list[str]]:
+    try:
+        return list(csv.reader(io.StringIO(text, newline="")))
+    except csv.Error as exc:
+        raise ImportFileError(f"The file is not valid CSV: {exc}") from None
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _parse_header(cells: list[str], report: ImportReport) -> _Header:
+    # Trailing empty header cells (a common spreadsheet artefact) are not columns;
+    # data below them is treated like any other cell beyond the header.
+    while cells and not cells[-1].strip():
+        cells = cells[:-1]
+
+    positions: dict[str, int] = {}
+    seen: set[str] = set()
+    duplicates: list[str] = []
+    for index, raw in enumerate(cells):
+        name = raw.strip().lower()
+        if name in seen and name not in duplicates:
+            duplicates.append(name)
+        if name:
+            seen.add(name)
+        if name in KNOWN_COLUMNS:
+            positions.setdefault(name, index)
+        else:
+            report.warnings.append(
+                RowIssue(_HEADER_ROW, raw, f"unknown column {raw!r} is ignored")
+            )
+
+    if duplicates:
+        listed = ", ".join(repr(name) for name in duplicates)
+        raise ImportFileError(
+            f"The header lists the same column more than once: {listed}. "
+            "Each column may appear only once."
+        )
+
+    missing = [name for name in REQUIRED_COLUMNS if name not in positions]
+    if missing:
+        message = "The header has no " + " and no ".join(
+            repr(name) for name in missing
+        ) + " column; both name and email columns are required."
+        if any(";" in cell for cell in cells):
+            message += (
+                " The file looks semicolon-separated; save it as comma-separated "
+                "CSV (columns separated by ',') and import it again."
+            )
+        raise ImportFileError(message)
+
+    return _Header(width=len(cells), positions=positions)
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    header: _Header,
+    number: int,
+    cells: list[str],
+    claimed: dict[str, int],
+    report: ImportReport,
+) -> None:
+    errors: list[RowIssue] = []
+
+    def cell(column: str) -> str:
+        index = header.positions.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    def check(column: str, normalise, raw: str):
+        try:
+            return normalise(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(number, column, str(exc)))
+            return None
+
+    extra = cells[header.width :]
+    if any(value.strip() for value in extra):
+        errors.append(
+            RowIssue(
+                number,
+                None,
+                f"row has {len(cells)} cells but the header has only {header.width} "
+                "columns",
+            )
+        )
+
+    name = check("name", validate_name, cell("name"))
+    email = check("email", normalize_email, cell("email"))
+    phone = check("phone", _optional_phone, cell("phone"))
+    tags = check("tags", _split_tags, cell("tags"))
+
+    if email is not None and email in claimed:
+        errors.append(
+            RowIssue(
+                number,
+                "email",
+                f"email: {email} already appears in row {claimed[email]}; "
+                "only that row was imported",
+            )
+        )
+
+    if errors:
+        report.errors.extend(errors)
+        return
+
+    claimed[email] = number
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+        return
+
+    merged = Contact(
+        name=name,
+        email=existing.email,
+        phone=phone if phone is not None else existing.phone,
+        tags=existing.tags | tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(email)
+
+
+def _optional_phone(raw: str) -> str | None:
+    return normalize_phone(raw) if raw.strip() else None
+
+
+def _split_tags(raw: str) -> frozenset[str]:
+    return frozenset(
+        normalize_tag(piece) for piece in raw.split(TAG_SEPARATOR) if piece.strip()
+    )

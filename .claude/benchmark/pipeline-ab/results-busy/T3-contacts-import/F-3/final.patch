@@ -0,0 +1,469 @@
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def ann(**overrides):
+    fields = {"name": "Ann Lee", "email": "ann@example.com"}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def snapshot(repo):
+    return list(repo.all())
+
+
+def error_cells(report):
+    return [(issue.row, issue.column) for issue in report.errors]
+
+
+# Whole-file outcome (1-5)
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "",
+        b"",
+        "\ufeff",
+        b"\xef\xbb\xbf",
+        "\n\n",
+        " ,  ,\n",
+        "\nname,email\nAnn,ann@example.com\n",
+    ],
+)
+def test_empty_file_or_missing_header_line_is_rejected(data):
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), data)
+
+
+@pytest.mark.parametrize(
+    "header", ["name,phone\n", "email,phone\n", "phone,tags\n", "Full name,E-mail\n"]
+)
+def test_header_without_name_or_email_is_rejected(header):
+    with pytest.raises(ImportFileError, match="name|email"):
+        import_contacts(InMemoryContactRepository(), header + "Ann,ann@example.com\n")
+
+

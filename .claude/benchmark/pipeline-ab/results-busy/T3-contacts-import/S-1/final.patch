+++ b/tests/test_importer.py
@@ -0,0 +1,403 @@
+"""Tests for CSV import; comments reference the acceptance criteria in SPEC.md."""
+
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def repo_with(*contacts):
+    return InMemoryContactRepository(contacts)
+
+
+def ann(**overrides):
+    values = dict(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"])
+    values.update(overrides)
+    return Contact.create(**values)
+
+
+def snapshot(repo):
+    return list(repo.all())
+
+
+# --- Input and encoding ---------------------------------------------------
+
+
+def test_bytes_utf8_with_and_without_bom():  # 1
+    for prefix in (b"", b"\xef\xbb\xbf"):
+        repo = repo_with()
+        data = prefix + "name,email\nZoë Brontë,zoe@example.com\n".encode("utf-8")
+        report = import_contacts(repo, data)
+        assert report.created == ["zoe@example.com"]
+        assert repo.get("zoe@example.com").name == "Zoë Brontë"
+
+
+def test_text_with_leading_bom_character():  # 2
+    repo = repo_with()
+    report = import_contacts(repo, "\ufeffname,email\nAnn Lee,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == []
+
+
+def test_invalid_utf8_bytes_ask_for_csv_utf8():  # 3
+    repo = repo_with()
+    data = "name,email\nZoë,zoe@example.com\n".encode("cp1252")
+    with pytest.raises(ImportFileError, match='"CSV UTF-8"'):
+        import_contacts(repo, data)
+    assert len(repo) == 0
+
+
+@pytest.mark.parametrize("data", ["", "   \n\n", b"", b"\xef\xbb\xbf", b" \r\n"])
+def test_empty_input_is_a_file_error(data):  # 4
+    with pytest.raises(ImportFileError):
+        import_contacts(repo_with(), data)
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n", "\r"])
+def test_line_endings(newline):  # 5
+    data = newline.join(["name,email", "Ann Lee,ann@example.com", "Bob Stone,bob@example.com", ""])
+    report = import_contacts(repo_with(), data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+
+

+"""CSV import of contacts.
+
+Reads the format written by export.py (plus the ``first_name`` / ``last_name``
+variant of the address-book export) and merges it into a repository. Row
+problems are collected in an ImportReport; problems with the file as a whole
+raise ImportFileError before anything is stored.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_IMPORT_ROWS = 1000
+
+_BOM = "\ufeff"
+_KNOWN_COLUMNS = ("name", "first_name", "last_name", "email", "phone", "tags")
+
+
+@dataclass(slots=True)
+class RowIssue:
+    """A problem with one row; ``row`` is the spreadsheet row number (header = 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or merge-update contacts from CSV content.
+
+    New emails create contacts; known emails take the file's name, its phone
+    when the cell is filled, and gain its tags. A row with a bad name, email or
+    tag is rejected whole; a bad phone is dropped with a warning. See SPEC.md.
+    """
+    records = _read_records(_decode(data))
+
+    header_index = next((i for i, cells in enumerate(records) if not _is_blank(cells)), None)
+    if header_index is None:
+        raise ImportFileError("the file is empty")
+    header = _Header(records[header_index], row=header_index + 1)
+
+    rows = [
+        (number, cells)
+        for number, cells in enumerate(records[header_index + 1 :], start=header_index + 2)
+        if not _is_blank(cells)
+    ]
+    if len(rows) > MAX_IMPORT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(rows)} contact rows; at most {MAX_IMPORT_ROWS} can be "
+            "imported at once, split it into smaller files"
+        )
+
+    report = ImportReport(warnings=list(header.warnings))
+    accepted: dict[str, int] = {}
+    for number, cells in rows:
+        _import_row(repo, header, number, cells, accepted, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            text = data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; in your spreadsheet use "Save As" and '
+                'choose "CSV UTF-8", then import that file'
+            ) from None
+    elif isinstance(data, str):
+        text = data.removeprefix(_BOM)
+    else:
+        raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+    if not text.strip():
+        raise ImportFileError("the file is empty")
+    return text
+
+
+def _read_records(text: str) -> list[list[str]]:
+    # newline="" lets the csv module see \r, \n and \r\n line endings as written,
+    # so quoted cells keep their line breaks and every record is one spreadsheet row.
+    try:
+        return list(csv.reader(io.StringIO(text, newline="")))
+    except csv.Error as exc:
+        raise ImportFileError(f"the file is not valid CSV: {exc}") from None
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+class _Header:
+    """Column positions resolved from the header row."""
+
+    def __init__(self, cells: list[str], row: int) -> None:
+        self.width = len(cells)
+        self.warnings: list[RowIssue] = []
+        positions: dict[str, int] = {}
+        for index, cell in enumerate(cells):
+            column = cell.strip().lower()
+            if not column:
+                continue
+            if column in positions:
+                raise ImportFileError(f"column {column!r} appears more than once in the header")
+            positions[column] = index
+
+        missing = []
+        if "name" not in positions and not {"first_name", "last_name"} <= positions.keys():
+            missing.append("name (or first_name and last_name)")
+        if "email" not in positions:
+            missing.append("email")
+        if missing:
+            raise ImportFileError(
+                f"missing column: {', '.join(missing)}; the first row must be a header "
+                "with comma-separated column names, as in our CSV export"
+            )
+
+        self.name = positions.get("name")
+        self.first_name = None if self.name is not None else positions["first_name"]
+        self.last_name = None if self.name is not None else positions["last_name"]
+        self.email = positions["email"]
+        self.phone = positions.get("phone")
+        self.tags = positions.get("tags")
+
+        used = {self.name, self.first_name, self.last_name, self.email, self.phone, self.tags}
+        for column, index in positions.items():
+            if index not in used:
+                reason = "not used" if column in _KNOWN_COLUMNS else "unknown"
+                self.warnings.append(
+                    RowIssue(row, column, f"column {column!r} is {reason} and was ignored")
+                )
+
+    def name_position(self) -> int:
+        if self.name is not None:
+            return self.name
+        return min(self.first_name, self.last_name)
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    header: _Header,
+    row: int,
+    cells: list[str],
+    accepted: dict[str, int],
+    report: ImportReport,
+) -> None:
+    if any(cell.strip() for cell in cells[header.width :]):
+        report.errors.append(
+            RowIssue(row, None, f"row has more cells than the header's {header.width} columns")
+        )
+        return
+
+    def cell(index: int | None) -> str:
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    errors: list[tuple[int, RowIssue]] = []
+
+    if header.name is not None:
+        raw_name = cell(header.name)
+    else:
+        raw_name = f"{cell(header.first_name).strip()} {cell(header.last_name).strip()}"
+    try:
+        name = validate_name(raw_name)
+    except ValidationError as exc:
+        errors.append((header.name_position(), RowIssue(row, "name", exc.message)))
+
+    try:
+        email = normalize_email(cell(header.email))
+    except ValidationError as exc:
+        email = None
+        errors.append((header.email, RowIssue(row, "email", exc.message)))
+    if email is not None and email in accepted:
+        errors.append(
+            (header.email, RowIssue(row, "email", f"duplicate of row {accepted[email]}"))
+        )
+
+    tags: frozenset[str] = frozenset()
+    if header.tags is not None:
+        pieces = [piece for piece in cell(header.tags).split(TAG_SEPARATOR) if piece.strip()]
+        try:
+            tags = normalize_tags(pieces)
+        except ValidationError as exc:
+            errors.append((header.tags, RowIssue(row, "tags", exc.message)))
+
+    if errors:
+        report.errors.extend(issue for _, issue in sorted(errors, key=lambda item: item[0]))
+        return
+
+    phone = None
+    raw_phone = cell(header.phone)
+    if raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(row, "phone", f"{exc.message}; phone was not imported")
+            )
+
+    accepted[email] = row
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+        return
+    merged = replace(
+        existing,
+        name=name,
+        phone=phone if phone is not None else existing.phone,
+        tags=existing.tags | tags,
+    )
+    if merged != existing:
+        repo.update(merged)
+        report.updated.append(email)

+        "Bad,nope,,,\n"  # row 4: error
+        "Dee New,dee@example.com,,,\n"  # row 5: created
+        "Ann Lee,ann@example.com,,new,\n"  # row 6: updated
+        "Eve,eve@example.com,1,bad!,\n"  # row 7: error
+        "Fay,fay@example.com,x,,\n"  # row 8: created, phone warning
+    )
+    report = import_contacts(repo, data)
+    assert report.created == ["cy@example.com", "dee@example.com", "fay@example.com"]
+    assert report.updated == ["bob@example.com", "ann@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [(4, "email"), (7, "tags")]
+    assert [(w.row, w.column) for w in report.warnings] == [(1, "notes"), (2, "phone"), (8, "phone")]
+    assert not set(report.created) & set(report.updated)

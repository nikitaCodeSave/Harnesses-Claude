+"""SPEC.md, acceptance criteria 17-26: rows, line numbers and row issues."""
+
+import pytest
+
+from contactbook.models import Contact
+
+from .support import (
+    ann,
+    columns_at,
+    csv_lines,
+    import_contacts,
+    issues_at,
+    repo_with,
+    rows_of,
+)
+
+HEADER = "name,email,phone,tags"
+
+# --- 17. blank rows are skipped silently -----------------------------------------
+
+
+def test_blank_rows_are_skipped_without_errors_or_warnings():
+    content = csv_lines(
+        HEADER,  # 1
+        "",  # 2
+        "Ann Lee,ann@example.com,,",  # 3
+        ",,,",  # 4
+        "  ,\t, , ",  # 5
+        "   ",  # 6
+        "Bob Stone,bob@example.com,,",  # 7
+        "",  # 8
+    )
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert sorted(report.created) == ["ann@example.com", "bob@example.com"]
+    assert rows_of(report.warnings).isdisjoint({2, 4, 5, 6, 8})
+    assert len(repo) == 2
+
+
+# --- 18. RowIssue.row is the spreadsheet line number --------------------------------
+
+
+@pytest.mark.parametrize("eol", ["\n", "\r\n"], ids=["lf", "crlf"])
+@pytest.mark.parametrize("as_bytes", [False, True], ids=["text", "bytes"])
+def test_issue_rows_are_line_numbers_counting_header_and_blank_lines(eol, as_bytes):
+    content = csv_lines(
+        HEADER,  # 1
+        "Ann Lee,ann@example.com,,",  # 2
+        "",  # 3
+        "Bad Email,not-an-email,,",  # 4
+        ",,,",  # 5
+        "Cid Moss,cid@example.com,123,",  # 6: invalid phone -> warning
+        "",  # 7
+        "",  # 8
+        ",dan@example.com,,",  # 9: no name
+        eol=eol,
+    )
+    report = import_contacts(repo_with(), content.encode("utf-8") if as_bytes else content)
+    assert rows_of(report.errors) == {4, 9}
+    assert [w.row for w in report.warnings if w.column == "phone"] == [6]
+
+
+# --- 19. column is the lower-case field name ----------------------------------------
+
+
+def test_issue_columns_are_lower_case_field_names_whatever_the_header_case():
+    content = csv_lines(
+        " NAME ,Email,PHONE,Tags",  # 1
+        "Ann Lee,not-an-email,,",  # 2
+        ",bob@example.com,,",  # 3
+        "Cid Moss,cid@example.com,,bad!tag",  # 4
+        "Dan Ray,dan@example.com,12,",  # 5
+    )
+    report = import_contacts(repo_with(), content)
+    assert "email" in columns_at(report.errors, 2)
+    assert "name" in columns_at(report.errors, 3)
+    assert "tags" in columns_at(report.errors, 4)
+    assert "phone" in columns_at(report.warnings, 5)
+    assert issues_at(report.errors, 5) == []
+
+
+def test_split_name_issues_use_the_name_column():
+    content = csv_lines("FIRST_NAME,Last_Name,EMAIL", " , ,ann@example.com")
+    report = import_contacts(repo_with(), content)
+    assert "name" in columns_at(report.errors, 2)
+
+
+# --- 20. a row is applied in full or not at all ---------------------------------------
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        "Ann Changed,ann@example.com,555 999 0000,lead;bad!tag",
+        ",ann@example.com,555 999 0000,lead",
+        "Ann Changed,ann@example.com,12,bad!tag",
+    ],
+    ids=["bad-tag", "no-name", "bad-tag-and-bad-phone"],
+)
+def test_row_with_an_error_does_not_change_an_existing_contact(row):
+    repo = repo_with(ann())
+    report = import_contacts(repo, csv_lines(HEADER, row))
+    assert issues_at(report.errors, 2) != []
+    assert repo.all() == [ann()]
+    assert report.updated == []
+    assert report.created == []
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        "Bob Stone,bob@example.com,555 123 4567,bad!tag",
+        ",bob@example.com,555 123 4567,vip",
+        "Bob Stone,bob@example.com,12,bad!tag",
+    ],
+    ids=["bad-tag", "no-name", "bad-tag-and-bad-phone"],
+)
+def test_row_with_an_error_does_not_create_a_contact(row):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, row))
+    assert issues_at(report.errors, 2) != []
+    assert "bob@example.com" not in repo
+    assert len(repo) == 0
+    assert report.created == []
+
+
+# --- 21. partial import ------------------------------------------------------------------
+
+
+def test_good_rows_are_imported_even_when_other_rows_have_errors():
+    content = csv_lines(
+        HEADER,
+        "Ann Smith,ann@example.com,,lead",  # 2: update
+        "Bad,not-an-email,,",  # 3: error
+        "Bob Stone,bob@example.com,,",  # 4: create
+        "Cid Moss,cid@example.com,,bad!tag",  # 5: error
+        "Dan Ray,dan@example.com,555 123 4567,vip",  # 6: create
+    )
+    repo = repo_with(ann())
+    report = import_contacts(repo, content)
+    assert rows_of(report.errors) == {3, 5}
+    assert sorted(report.created) == ["bob@example.com", "dan@example.com"]
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Smith"
+    assert repo.get("dan@example.com") == Contact.create(
+        "Dan Ray", "dan@example.com", phone="5551234567", tags=["vip"]
+    )
+    assert "cid@example.com" not in repo
+    assert len(repo) == 3
+
+
+# --- 22. missing or invalid email ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "email", ["", "   ", "not-an-email", "ann@", "ann@example", "ann lee@example.com", "a@b@c.com"]
+)
+def test_missing_or_invalid_email_is_an_error_on_the_email_column(email):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, f"Ann Lee,{email},,"))
+    assert "email" in columns_at(report.errors, 2)
+    assert report.created == []
+    assert len(repo) == 0
+
+
+# --- 23. missing or invalid name ------------------------------------------------------------
+
+
+@pytest.mark.parametrize("name", ["", "   ", "x" * 101], ids=["empty", "whitespace", "too-long"])
+def test_missing_or_invalid_name_is_an_error_on_the_name_column(name):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, f"{name},ann@example.com,,"))
+    assert "name" in columns_at(report.errors, 2)
+    assert report.created == []
+    assert len(repo) == 0
+
+
+def test_name_is_validated_and_normalised_like_contact_create():
+    repo = repo_with()
+    import_contacts(repo, csv_lines(HEADER, "  Ann   Lee ,ann@example.com,,"))
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# --- 24. first_name / last_name ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "first, last, expected",
+    [
+        ("Ann", "Lee", "Ann Lee"),
+        ("Mary Ann", "van Dyke", "Mary Ann van Dyke"),
+        ("Ann", "", "Ann"),
+        ("", "Lee", "Lee"),
+        ("Ann", "   ", "Ann"),
+        ("  ", "Lee", "Lee"),
+    ],
+)
+def test_first_and_last_name_are_joined_by_one_space(first, last, expected):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines("first_name,last_name,email", f"{first},{last},ann@example.com"))
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == expected
+
+
+@pytest.mark.parametrize("first, last", [("", ""), ("  ", "\t"), (" ", "")])
+def test_both_name_parts_blank_is_an_error_on_the_name_column(first, last):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines("first_name,last_name,email", f"{first},{last},ann@example.com"))
+    assert "name" in columns_at(report.errors, 2)
+    assert len(repo) == 0
+
+
+def test_split_name_replaces_the_name_of_an_existing_contact():
+    repo = repo_with(ann())
+    report = import_contacts(repo, csv_lines("first_name,last_name,email", "Ann,Smith,ann@example.com"))
+    assert report.errors == []
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Smith"
+
+
+# --- 25. tags ------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "cell, expected",
+    [
+        ("vip", {"vip"}),
+        ("vip;lead", {"vip", "lead"}),
+        ("vip;;lead", {"vip", "lead"}),
+        ("vip;lead;", {"vip", "lead"}),
+        (";vip", {"vip"}),
+        (";;", set()),
+        ("", set()),
+        ("vip;VIP;lead;vip", {"vip", "lead"}),
+        ("Key Account;vip", {"key-account", "vip"}),
+    ],
+)
+def test_tags_are_split_on_semicolons_ignoring_empty_pieces_and_repeats(cell, expected):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, f"Ann Lee,ann@example.com,,{cell}"))
+    assert report.errors == []
+    assert repo.get("ann@example.com").tags == expected
+
+
+@pytest.mark.parametrize(
+    "cell", ["bad!tag", "vip;bad!tag", "vip;;lead;-x-", "vip;" + "x" * 33], ids=str
+)
+def test_any_invalid_tag_is_an_error_on_the_tags_column(cell):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, f"Ann Lee,ann@example.com,,{cell}"))
+    assert "tags" in columns_at(report.errors, 2)
+    assert len(repo) == 0
+
+
+# --- 26. several errors on one row ----------------------------------------------------------------
+
+
+# One error entry per bad field, or a single entry for the row: either is fine.
+@pytest.mark.parametrize(
+    "row",
+    [
+        ",not-an-email,,bad!tag",
+        ",bob@example.com,555 123 4567,bad!tag",
+        ",ann@example.com,555 999 0000,bad!tag",
+        "x" * 101 + ",ann@example.com,12,lead;bad!tag",
+    ],
+    ids=["all-bad", "new-contact", "existing-contact", "existing-contact-bad-phone-too"],
+)
+def test_row_with_several_bad_fields_is_reported_and_not_applied(row):
+    content = csv_lines(HEADER, "Cid Moss,cid@example.com,,", row)
+    repo = repo_with(ann())
+    report = import_contacts(repo, content)
+    assert issues_at(report.errors, 3) != []
+    assert issues_at(report.errors, 2) == []
+    assert report.created == ["cid@example.com"]
+    assert report.updated == []
+    assert repo.get("ann@example.com") == ann()
+    assert "bob@example.com" not in repo
+    assert len(repo) == 2

+++ b/tests/acceptance/test_import_decoding.py
@@ -0,0 +1,150 @@
+"""SPEC.md, acceptance criteria 1-5: input and decoding."""
+
+import pytest
+
+from contactbook.export import export_csv
+from contactbook.models import Contact
+
+from .support import (
+    ann,
+    comparable,
+    csv_lines,
+    import_contacts,
+    import_file_error,
+    repo_with,
+)
+
+UTF8_BOM = b"\xef\xbb\xbf"
+
+# Non-ASCII text, a create, an update, a row error (row 3) and a phone warning (row 4).
+MIXED_CONTENT = csv_lines(
+    "name,email,phone,tags",
+    "Zoë Müller,zoe@example.com,555 123 4567,VIP;lead",
+    "Bad Row,not-an-email,,",
+    "Ann Lee-Smith,ann@example.com,12,partner",
+)
+
+
+# --- 1. bytes or str, same result ------------------------------------------
+
+
+def test_bytes_and_text_give_the_same_result():
+    repo_from_text = repo_with(ann())
+    repo_from_bytes = repo_with(ann())
+
+    from_text = import_contacts(repo_from_text, MIXED_CONTENT)
+    from_bytes = import_contacts(repo_from_bytes, MIXED_CONTENT.encode("utf-8"))
+
+    assert sorted(from_bytes.created) == sorted(from_text.created) == ["zoe@example.com"]
+    assert sorted(from_bytes.updated) == sorted(from_text.updated) == ["ann@example.com"]
+    assert comparable(from_bytes.errors) == comparable(from_text.errors)
+    assert comparable(from_bytes.warnings) == comparable(from_text.warnings)
+    assert repo_from_bytes.all() == repo_from_text.all()
+    assert repo_from_bytes.get("zoe@example.com").name == "Zoë Müller"
+
+
+# --- 2. bytes are UTF-8, with or without BOM ----------------------------------
+
+
+@pytest.mark.parametrize("bom", [b"", UTF8_BOM], ids=["no-bom", "bom"])
+@pytest.mark.parametrize(
+    "content",
+    [
+        csv_lines("name,email", "Zoë Müller,zoe@example.com"),
+        csv_lines("email,name", "zoe@example.com,Zoë Müller"),
+    ],
+    ids=["name-first", "email-first"],
+)
+def test_utf8_bytes_are_decoded_with_or_without_bom(bom, content):
+    repo = repo_with()
+    report = import_contacts(repo, bom + content.encode("utf-8"))
+    assert report.created == ["zoe@example.com"]
+    assert report.errors == []
+    assert repo.get("zoe@example.com").name == "Zoë Müller"
+
+
+# --- 3. text starting with U+FEFF ---------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        csv_lines("name,email", "José Díaz,jose@example.com"),
+        csv_lines("email,name", "jose@example.com,José Díaz"),
+    ],
+    ids=["name-first", "email-first"],
+)
+def test_text_with_leading_bom_character_is_accepted(content):
+    repo = repo_with()
+    report = import_contacts(repo, "\ufeff" + content)
+    assert report.created == ["jose@example.com"]
+    assert report.errors == []
+    assert repo.get("jose@example.com").name == "José Díaz"
+
+
+# --- 4. invalid UTF-8 -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "name,email\nZoë,zoe@example.com\n".encode("latin-1"),
+        "name,email\nZoë,zoe@example.com\n".encode("utf-16"),
+        b"name,email\nAnn Lee,ann@example.com\nBad,\xff\xfe@example.com\n",
+    ],
+    ids=["latin-1", "utf-16", "stray-bytes"],
+)
+def test_bytes_that_are_not_utf8_raise_import_file_error_asking_for_csv_utf8(data):
+    with pytest.raises(import_file_error()) as excinfo:
+        import_contacts(repo_with(), data)
+    assert "CSV UTF-8" in str(excinfo.value)
+
+
+# --- 5. comma delimiter, standard CSV quoting ---------------------------------
+
+
+def test_quoted_cells_with_commas_and_quotes_are_read_as_standard_csv():
+    content = csv_lines(
+        "name,email,phone,tags",
+        '"Lee, Ann",ann@example.com,,',
+        '"Bob ""The Builder"" Stone",bob@example.com,"555 123 4567","vip;lead"',
+    )
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert sorted(report.created) == ["ann@example.com", "bob@example.com"]
+    assert repo.get("ann@example.com").name == "Lee, Ann"
+    bob = repo.get("bob@example.com")
+    assert bob.name == 'Bob "The Builder" Stone'
+    assert bob.phone == "5551234567"
+    assert bob.tags == {"vip", "lead"}
+
+
+def test_output_of_export_csv_imports_back_to_the_same_contacts():
+    contacts = [
+        Contact.create(
+            name="Lee, Ann", email="ann@example.com", phone="+15551234567", tags=["vip", "lead"]
+        ),
+        Contact.create(name='Bob "B" Stone', email="bob@example.com"),
+        Contact.create(name="Zoë Müller", email="zoe@example.com", tags=["partner"]),
+    ]
+    repo = repo_with()
+    report = import_contacts(repo, export_csv(contacts))
+    assert report.errors == []
+    assert sorted(report.created) == ["ann@example.com", "bob@example.com", "zoe@example.com"]
+    assert {c.email: c for c in repo.all()} == {c.email: c for c in contacts}
+
+
+def test_crlf_line_endings_are_accepted():
+    content = csv_lines(
+        "name,email,phone,tags",
+        "Ann Lee,ann@example.com,555 123 4567,vip",
+        eol="\r\n",
+    )
+    repo = repo_with()
+    report = import_contacts(repo, content.encode("utf-8"))
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=["vip"]
+    )

+++ b/src/contactbook/importer.py
@@ -0,0 +1,232 @@
+"""CSV import of contacts.
+
+Reads the columns written by ``export_csv`` (``name,email,phone,tags``), or
+``first_name``/``last_name`` instead of ``name``. Rows for new emails create
+contacts; rows for emails already in the book are merged into them (name
+replaced, phone replaced only by a valid one, tags added). Each row is applied
+in full or not at all; problems are reported per row in an ImportReport.
+Problems with the file as a whole raise ImportFileError before anything is
+changed.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tag, validate_name
+
+MAX_CONTACT_ROWS = 1000
+
+_KNOWN_COLUMNS = ("name", "first_name", "last_name", "email", "phone", "tags")
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row; ``row`` is the spreadsheet line number (header is 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import CSV content (UTF-8 bytes or text) into ``repo`` and report what happened.
+
+    Raises ImportFileError, leaving ``repo`` untouched, if the file can't be
+    decoded, is empty, lacks the email or name columns, or has more than
+    MAX_CONTACT_ROWS contact rows.
+    """
+    records = _read_records(_decode(data))
+    if not records:
+        raise ImportFileError("the file is empty")
+
+    _, header = records[0]
+    columns = _header_columns(header)
+    rows = [(line, cells) for line, cells in records[1:] if not _is_blank(cells)]
+    if len(rows) > MAX_CONTACT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(rows)} contacts, more than {MAX_CONTACT_ROWS} at a time; "
+            "please split it into smaller files"
+        )
+
+    report = ImportReport()
+    ignored = [name for name in header if name.strip() and _column_key(name) not in _KNOWN_COLUMNS]
+    if ignored and rows:  # a header-only file gets an empty report
+        report.warnings.append(
+            RowIssue(1, None, "ignored unknown columns: " + ", ".join(ignored))
+        )
+
+    seen_emails: dict[str, int] = {}
+    for line, cells in rows:
+        _import_row(repo, report, seen_emails, line, columns.cells(cells))
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                "the file is not valid UTF-8; re-save it as \"CSV UTF-8\" and import it again"
+            ) from None
+    return data.removeprefix("\ufeff")
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """Parse CSV text into (line number of the record's first line, cells) pairs.
+
+    Trailing blank lines are dropped, so a file of only blank lines reads as
+    empty; line numbers count every line, blank ones included.
+    """
+    reader = csv.reader(io.StringIO(text, newline=""))
+    records: list[tuple[int, list[str]]] = []
+    first_line = 1
+    try:
+        for cells in reader:
+            records.append((first_line, cells))
+            first_line = reader.line_num + 1
+    except csv.Error as exc:
+        raise ImportFileError(f"line {first_line}: the file is not valid CSV ({exc})") from None
+    while records and _is_blank(records[-1][1]):
+        records.pop()
+    return records
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _column_key(header_name: str) -> str:
+    return header_name.strip().lower()
+
+
+@dataclass(frozen=True)
+class _Columns:
+    """Positions of the known columns in the header; None for a missing optional one."""
+
+    email: int
+    name: int | None
+    first_name: int | None
+    last_name: int | None
+    phone: int | None
+    tags: int | None
+
+    def cells(self, row: list[str]) -> _RowCells:
+        def cell(index: int | None) -> str:
+            return row[index] if index is not None and index < len(row) else ""
+
+        if self.name is not None:
+            name = cell(self.name)
+        else:
+            parts = (cell(self.first_name).strip(), cell(self.last_name).strip())
+            name = " ".join(part for part in parts if part)
+        return _RowCells(name=name, email=cell(self.email), phone=cell(self.phone), tags=cell(self.tags))
+
+
+@dataclass(frozen=True)
+class _RowCells:
+    name: str
+    email: str
+    phone: str
+    tags: str
+
+
+def _header_columns(header: list[str]) -> _Columns:
+    positions: dict[str, int] = {}
+    for index, name in enumerate(header):
+        positions.setdefault(_column_key(name), index)
+
+    if "email" not in positions:
+        raise ImportFileError("the header has no 'email' column")
+    has_split_name = "first_name" in positions and "last_name" in positions
+    if "name" not in positions and not has_split_name:
+        raise ImportFileError(
+            "the header needs a 'name' column, or both 'first_name' and 'last_name'"
+        )
+    return _Columns(
+        email=positions["email"],
+        name=positions.get("name"),
+        first_name=positions.get("first_name"),
+        last_name=positions.get("last_name"),
+        phone=positions.get("phone"),
+        tags=positions.get("tags"),
+    )
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    report: ImportReport,
+    seen_emails: dict[str, int],
+    line: int,
+    cells: _RowCells,
+) -> None:
+    errors: list[RowIssue] = []
+
+    def check(validate, raw):
+        try:
+            return validate(raw)
+        except ValidationError as exc:
+            errors.append(RowIssue(line, exc.field, exc.message))
+            return None
+
+    name = check(validate_name, cells.name)
+    email = check(normalize_email, cells.email)
+    tags = check(_parse_tags, cells.tags)
+
+    phone = None
+    if cells.phone.strip():
+        try:
+            phone = normalize_phone(cells.phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(line, "phone", f"{exc.message}; the phone was not changed")
+            )
+
+    if email is not None:
+        if email in seen_emails:
+            errors.append(
+                RowIssue(line, "email", f"{email} already appears on row {seen_emails[email]}")
+            )
+        else:
+            seen_emails[email] = line
+
+    if errors:
+        report.errors.extend(errors)
+        return
+
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+    else:
+        repo.update(
+            Contact(
+                name=name,
+                email=existing.email,
+                phone=phone if phone is not None else existing.phone,
+                tags=existing.tags | tags,
+            )
+        )
+        report.updated.append(email)
+
+
+def _parse_tags(cell: str) -> frozenset[str]:
+    """Split a tags cell on TAG_SEPARATOR, skipping empty pieces; duplicates collapse."""
+    return frozenset(
+        normalize_tag(piece) for piece in cell.split(TAG_SEPARATOR) if piece.strip()
+    )

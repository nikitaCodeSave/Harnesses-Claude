+"""SPEC.md, "Interface": the names and shapes other code relies on."""
+
+import dataclasses
+
+from .support import import_contacts, importer_module, repo_with
+
+
+def test_import_report_is_a_dataclass_with_the_four_lists():
+    report_cls = importer_module().ImportReport
+    assert dataclasses.is_dataclass(report_cls)
+    assert {"created", "updated", "errors", "warnings"} <= {
+        f.name for f in dataclasses.fields(report_cls)
+    }
+
+
+def test_row_issue_is_a_dataclass_with_row_column_message():
+    row_issue_cls = importer_module().RowIssue
+    assert dataclasses.is_dataclass(row_issue_cls)
+    issue = row_issue_cls(row=2, column="email", message="is required")
+    assert (issue.row, issue.column, issue.message) == (2, "email", "is required")
+    assert row_issue_cls(row=3, column=None, message="x").column is None
+
+
+def test_import_contacts_returns_an_import_report():
+    report = import_contacts(repo_with(), "name,email\nAnn Lee,ann@example.com\n")
+    assert isinstance(report, importer_module().ImportReport)
+    assert report.created == ["ann@example.com"]
+    assert report.updated == []
+    assert report.errors == []
+    assert isinstance(report.warnings, list)

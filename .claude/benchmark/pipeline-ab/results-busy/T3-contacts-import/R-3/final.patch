+        name="Ann Smith",
+        email="ann@example.com",
+        phone="5551234567",
+        tags=frozenset({"vip", "partner"}),
+    )
+
+
+def test_update_that_changes_nothing_is_not_an_error_and_creates_nothing():
+    repo = repo_with(ann())
+    report = import_contacts(repo, csv_lines(HEADER, "Ann Lee,ann@example.com,555 123 4567,vip"))
+    assert report.errors == []
+    assert report.created == []
+    assert repo.all() == [ann()]
+
+
+# --- 30. invalid phone is a warning, not an error ------------------------------------------
+
+
+@pytest.mark.parametrize("phone", ["12", "call me", "+1 555 CALL NOW"])
+def test_invalid_phone_on_new_contact_creates_it_without_phone_and_warns(phone):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, f"Bob Stone,bob@example.com,{phone},vip"))
+    assert report.errors == []
+    assert report.created == ["bob@example.com"]
+    assert repo.get("bob@example.com") == Contact(
+        name="Bob Stone", email="bob@example.com", phone=None, tags=frozenset({"vip"})
+    )
+    assert columns_at(report.warnings, 2) >= {"phone"}
+
+
+def test_invalid_phone_on_existing_contact_keeps_phone_applies_rest_and_warns():
+    content = csv_lines(HEADER, "Bob Stone,bob@example.com,,", "Ann Smith,ann@example.com,12,lead")
+    repo = repo_with(ann())
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="5551234567",
+        tags=frozenset({"vip", "lead"}),
+    )
+    assert [w.row for w in report.warnings if w.column == "phone"] == [3]
+
+
+# --- 31. duplicate emails within the file ----------------------------------------------------
+
+
+def test_later_rows_with_the_same_email_are_errors_and_not_applied():
+    content = csv_lines(
+        HEADER,  # 1
+        "Ann Lee,ann@example.com,,",  # 2
+        "Bob Stone,bob@example.com,,",  # 3
+        "Ann Two,ANN@example.com,555 123 4567,vip",  # 4
+        "",  # 5
+        "Ann Three, ann@Example.com ,,lead",  # 6
+    )
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert rows_of(report.errors) == {4, 6}
+    assert sorted(report.created) == ["ann@example.com", "bob@example.com"]
+    assert report.updated == []
+    assert repo.get("ann@example.com") == Contact.create("Ann Lee", "ann@example.com")
+    assert len(repo) == 2
+
+
+def test_later_rows_with_the_email_of_an_updated_contact_are_errors_and_not_applied():
+    content = csv_lines(
+        HEADER,
+        "Ann Smith,ann@example.com,,lead",  # 2
+        "Ann Jones,Ann@Example.com,555 999 0000,partner",  # 3
+    )
+    repo = repo_with(ann())
+    report = import_contacts(repo, content)
+    assert rows_of(report.errors) == {3}
+    assert issues_at(report.errors, 2) == []
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="5551234567",
+        tags=frozenset({"vip", "lead"}),
+    )
+
+
+# --- 32. created / updated hold normalised emails, each once ----------------------------------
+
+
+def test_created_and_updated_hold_each_normalised_email_once():
+    content = csv_lines(
+        HEADER,
+        "Ann Smith, ANN@Example.com ,,",
+        "Bob Stone,Bob@EXAMPLE.com,,",
+        "Ann Again,ann@example.com,,",
+        "Bob Again,  bob@example.com,,",
+        "Cid Moss,CID@example.COM,,",
+    )
+    repo = repo_with(ann())
+    report = import_contacts(repo, content)
+    listed = report.created + report.updated
+    assert len(listed) == len(set(listed))
+    assert sorted(report.created) == ["bob@example.com", "cid@example.com"]
+    assert report.updated == ["ann@example.com"]
+
+
+# --- 33. warnings don't stop a row; rows not applied are not listed ------------------------------
+
+
+def test_rows_not_applied_are_not_listed_and_rows_with_warnings_are():
+    content = csv_lines(
+        HEADER,
+        "Ann Smith,ann@example.com,,bad!tag",  # 2: error, existing
+        "Bob Stone,bob@example.com,,bad!tag",  # 3: error, new
+        "Cid Moss,cid@example.com,12,",  # 4: warning, new
+        "Dan Ray,dan@example.com,12,",  # 5: warning, existing
+    )
+    repo = repo_with(ann(), Contact.create("Dan R", "dan@example.com"))
+    report = import_contacts(repo, content)
+    assert rows_of(report.errors) == {2, 3}
+    assert report.created == ["cid@example.com"]
+    assert report.updated == ["dan@example.com"]
+    assert "bob@example.com" not in repo
+    assert repo.get("ann@example.com") == ann()
+    assert repo.get("cid@example.com").name == "Cid Moss"
+    assert repo.get("dan@example.com").name == "Dan Ray"

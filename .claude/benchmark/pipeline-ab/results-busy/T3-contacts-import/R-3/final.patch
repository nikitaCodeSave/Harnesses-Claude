+"""SPEC.md, acceptance criteria 27-33: new vs existing contacts."""
+
+import pytest
+
+from contactbook.models import Contact
+
+from .support import (
+    ann,
+    columns_at,
+    csv_lines,
+    import_contacts,
+    issues_at,
+    repo_with,
+    rows_of,
+)
+
+HEADER = "name,email,phone,tags"
+
+# --- 27. emails are matched after normalisation -------------------------------------
+
+
+@pytest.mark.parametrize("email", ["Ann@Example.COM", "  ANN@example.com ", "ann@example.com"])
+def test_file_email_matches_existing_contact_after_normalisation(email):
+    repo = repo_with(ann())
+    report = import_contacts(repo, csv_lines(HEADER, f"Ann Smith,{email},,"))
+    assert report.errors == []
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert len(repo) == 1
+    assert repo.get("ann@example.com").name == "Ann Smith"
+
+
+# --- 28. new email creates a contact ------------------------------------------------
+
+
+def test_new_email_creates_a_normalised_contact_listed_in_created():
+    repo = repo_with(ann())
+    report = import_contacts(
+        repo, csv_lines(HEADER, "  Bob   Stone , Bob@Example.COM ,+1 (555) 123-4567,Key Account;VIP")
+    )
+    assert report.errors == []
+    assert report.created == ["bob@example.com"]
+    assert report.updated == []
+    assert repo.get("bob@example.com") == Contact.create(
+        name="Bob Stone", email="bob@example.com", phone="+15551234567", tags=["key-account", "vip"]
+    )
+    assert repo.get("ann@example.com") == ann()
+    assert len(repo) == 2
+
+
+# --- 29. existing email is merged -----------------------------------------------------
+
+
+def test_existing_email_is_updated_not_duplicated_and_not_an_error():
+    repo = repo_with(ann())
+    report = import_contacts(repo, csv_lines(HEADER, "Ann Smith,ann@example.com,,"))
+    assert report.errors == []
+    assert report.created == []
+    assert report.updated == ["ann@example.com"]
+    assert len(repo) == 1
+
+
+def test_merge_replaces_name_and_phone_and_adds_tags():
+    repo = repo_with(ann())
+    report = import_contacts(
+        repo, csv_lines(HEADER, "Ann Smith,ann@example.com,+1 (555) 987-6543,Lead;VIP")
+    )
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="+15559876543",
+        tags=frozenset({"vip", "lead"}),
+    )
+
+
+@pytest.mark.parametrize("phone", ["", "   "], ids=["empty", "whitespace"])
+def test_blank_phone_cell_keeps_the_existing_phone(phone):
+    repo = repo_with(ann())

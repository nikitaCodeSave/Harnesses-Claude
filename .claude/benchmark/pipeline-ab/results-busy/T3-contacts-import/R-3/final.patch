+"""SPEC.md, acceptance criteria 14-16: whole-file limits and ImportFileError."""
+
+import pytest
+
+from contactbook.errors import ContactError
+from contactbook.models import Contact
+
+from .support import ann, csv_lines, import_contacts, import_file_error, repo_with
+
+HEADER = "name,email"
+
+
+def person_rows(count, start=0):
+    return [f"Person {i},person{i}@example.com" for i in range(start, start + count)]
+
+
+# --- 14. at most 1000 contact rows -------------------------------------------------
+
+
+def test_exactly_1000_contact_rows_are_accepted():
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, *person_rows(1000)))
+    assert report.errors == []
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_1001_contact_rows_raise_import_file_error_asking_to_split_the_file():
+    with pytest.raises(import_file_error()) as excinfo:
+        import_contacts(repo_with(), csv_lines(HEADER, *person_rows(1001)))
+    assert "split" in str(excinfo.value).lower()
+
+
+def test_invalid_rows_count_toward_the_limit():
+    rows = person_rows(999) + ["Bad One,not-an-email", ",person-x@example.com"]
+    with pytest.raises(import_file_error()):
+        import_contacts(repo_with(), csv_lines(HEADER, *rows))
+
+
+def test_blank_rows_do_not_count_toward_the_limit():
+    rows = person_rows(500) + ["", " , ", ""] * 10 + person_rows(500, start=500) + ["", ","]
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(HEADER, *rows))
+    assert report.errors == []
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_rows_that_update_existing_contacts_count_toward_the_limit():
+    existing = [Contact.create(f"Person {i}", f"person{i}@example.com") for i in range(10)]
+    with pytest.raises(import_file_error()):
+        import_contacts(repo_with(*existing), csv_lines(HEADER, *person_rows(1001)))
+
+
+# --- 15. ImportFileError leaves the repository untouched ----------------------------
+
+# Each file has rows that would update the existing contact and create a new one,
+# were it imported.
+_UPDATE_AND_CREATE = ["Ann Changed,ann@example.com,555 999 0000,lead", "Bob Stone,bob@example.com,,"]
+
+FILES_REJECTED_AS_A_WHOLE = {
+    "invalid-utf8": (
+        csv_lines("name,email,phone,tags", *_UPDATE_AND_CREATE).encode("utf-8")
+        + b"Zo\xeb,zoe@example.com,,\n"
+    ),
+    "too-many-rows": csv_lines(
+        "name,email,phone,tags",
+        *_UPDATE_AND_CREATE,
+        *[f"Person {i},person{i}@example.com,," for i in range(999)],
+    ),
+    "no-email-column": csv_lines("name,phone,tags", "Ann Changed,555 999 0000,lead"),
+    "no-name-column": csv_lines(
+        "email,phone,tags", "ann@example.com,555 999 0000,lead", "bob@example.com,,"
+    ),
+    "empty": "",
+}
+
+
+@pytest.mark.parametrize(
+    "data", FILES_REJECTED_AS_A_WHOLE.values(), ids=FILES_REJECTED_AS_A_WHOLE.keys()
+)
+def test_import_file_error_leaves_the_repository_unchanged(data):
+    carol = Contact.create("Carol King", "carol@example.com", tags=["partner"])
+    repo = repo_with(ann(), carol)
+    before = repo.all()
+
+    with pytest.raises(import_file_error()):
+        import_contacts(repo, data)
+
+    assert repo.all() == before
+    assert repo.get("ann@example.com") == ann()
+    assert "bob@example.com" not in repo
+
+
+# --- 16. ImportFileError is a ContactError ------------------------------------------
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(import_file_error(), ContactError)

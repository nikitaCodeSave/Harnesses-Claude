+"""SPEC.md, acceptance criteria 6-13: the header row and empty files."""
+
+import pytest
+
+from contactbook.models import Contact
+
+from .support import ann, csv_lines, import_contacts, import_file_error, repo_with
+
+# --- 6. first line is the header; column order is free --------------------------
+
+
+def test_columns_may_come_in_any_order():
+    content = csv_lines("tags,phone,email,name", "vip;lead,555 123 4567,ann@example.com,Ann Lee")
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=["vip", "lead"]
+    )
+
+
+def test_first_and_last_name_columns_may_come_in_any_order():
+    content = csv_lines("email,last_name,first_name", "ann@example.com,Lee,Ann")
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_the_first_line_is_not_imported_as_a_contact():
+    content = csv_lines("name,email", "Ann Lee,ann@example.com")
+    repo = repo_with()
+    import_contacts(repo, content)
+    assert [c.email for c in repo.all()] == ["ann@example.com"]
+
+
+# --- 7. header names: case-insensitive, surrounding whitespace ignored ----------
+
+
+def test_header_names_ignore_case_and_surrounding_whitespace():
+    content = csv_lines(" Name ,EMAIL, Phone,TaGs ", "Ann Lee,ann@example.com,555 123 4567,vip")
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=["vip"]
+    )
+
+
+def test_first_and_last_name_headers_ignore_case_and_whitespace():
+    content = csv_lines(" First_Name ,LAST_NAME, Email ", "Ann,Lee,ann@example.com")
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# --- 8. email column is required ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        csv_lines("name,phone,tags", "Ann Lee,555 123 4567,vip"),
+        csv_lines("name,e-mail", "Ann Lee,ann@example.com"),
+        csv_lines("name,phone"),
+    ],
+    ids=["no-email-column", "misspelt-email-column", "header-only"],
+)
+def test_missing_email_column_raises_import_file_error(content):
+    with pytest.raises(import_file_error()):
+        import_contacts(repo_with(), content)
+
+
+# --- 9. a name column is required ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        csv_lines("email,phone,tags", "ann@example.com,555 123 4567,vip"),
+        csv_lines("email,full_name", "ann@example.com,Ann Lee"),
+        csv_lines("email"),
+    ],
+    ids=["no-name-column", "unknown-name-column", "header-only"],
+)
+def test_missing_name_columns_raise_import_file_error(content):
+    with pytest.raises(import_file_error()):
+        import_contacts(repo_with(), content)
+
+
+# --- 10. phone and tags are optional -------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header, row, expected",
+    [
+        ("name,email", "Ann Lee,ann@example.com", Contact.create("Ann Lee", "ann@example.com")),
+        (
+            "name,email,phone",
+            "Ann Lee,ann@example.com,555 123 4567",
+            Contact.create("Ann Lee", "ann@example.com", phone="5551234567"),
+        ),
+        (
+            "name,email,tags",
+            "Ann Lee,ann@example.com,vip",
+            Contact.create("Ann Lee", "ann@example.com", tags=["vip"]),
+        ),
+        (
+            "first_name,last_name,email",
+            "Ann,Lee,ann@example.com",
+            Contact.create("Ann Lee", "ann@example.com"),
+        ),
+    ],
+    ids=["no-phone-no-tags", "no-tags", "no-phone", "split-name-only"],
+)
+def test_phone_and_tags_columns_are_optional(header, row, expected):
+    repo = repo_with()
+    report = import_contacts(repo, csv_lines(header, row))
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == expected
+
+
+# --- 11. unknown extra columns are ignored ---------------------------------------
+
+
+def test_unknown_columns_are_ignored_when_creating():
+    content = csv_lines(
+        "name,company,email,notes,phone,tags",
+        'Ann Lee,Acme,ann@example.com,"anything; at all, really!",555 123 4567,vip',
+        "Bob Stone,,bob@example.com,,,",
+    )
+    repo = repo_with()
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert sorted(report.created) == ["ann@example.com", "bob@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        name="Ann Lee", email="ann@example.com", phone="5551234567", tags=["vip"]
+    )
+
+
+def test_unknown_columns_are_ignored_when_updating():
+    content = csv_lines("name,email,Company", "Ann Smith,ann@example.com,!!not a tag!!")
+    repo = repo_with(ann())
+    report = import_contacts(repo, content)
+    assert report.errors == []
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Smith"
+
+
+# --- 12. empty file ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "data",
+    ["", b"", "   ", "\n", "\n\n\n", " \n\t\n  \n", "\r\n\r\n", b"\n \n", b"\xef\xbb\xbf", "\ufeff"],
+    ids=[
+        "empty-text",
+        "empty-bytes",
+        "spaces",
+        "one-blank-line",
+        "blank-lines",
+        "whitespace-lines",
+        "crlf-blank-lines",
+        "blank-lines-bytes",
+        "bom-only-bytes",
+        "bom-only-text",
+    ],
+)
+def test_empty_file_raises_import_file_error(data):
+    with pytest.raises(import_file_error()):
+        import_contacts(repo_with(), data)
+
+
+# --- 13. header only ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        "name,email,phone,tags\n",
+        "name,email,phone,tags",
+        b"name,email,phone,tags\r\n",
+        "name,email,phone,tags\n\n\n",
+    ],
+    ids=["text", "no-trailing-newline", "bytes-crlf", "followed-by-blank-lines"],
+)
+def test_header_only_returns_an_empty_report(data):
+    repo = repo_with(ann())
+    report = import_contacts(repo, data)
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.all() == [ann()]

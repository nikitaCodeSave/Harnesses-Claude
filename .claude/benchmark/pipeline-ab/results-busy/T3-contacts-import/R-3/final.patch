--- /dev/null
+++ b/tests/acceptance/support.py
@@ -0,0 +1,65 @@
+"""Helpers for the CSV import acceptance tests (SPEC.md).
+
+The importer and ImportFileError are looked up lazily, inside each test, so that
+until the feature exists every test fails on its own instead of the whole module
+failing to collect.
+"""
+
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+
+def importer_module():
+    import contactbook.importer
+
+    return contactbook.importer
+
+
+def import_contacts(repo, data):
+    from contactbook.importer import import_contacts as impl
+
+    return impl(repo, data)
+
+
+def import_file_error():
+    from contactbook.errors import ImportFileError
+
+    return ImportFileError
+
+
+def csv_lines(*lines, eol="\n"):
+    """Join lines into file content; each line, the last included, ends with eol."""
+    return eol.join(lines) + eol
+
+
+def repo_with(*contacts):
+    return InMemoryContactRepository(contacts)
+
+
+def ann(**overrides):
+    """The contact already in the book in most merge tests."""
+    fields = {
+        "name": "Ann Lee",
+        "email": "ann@example.com",
+        "phone": "5551234567",
+        "tags": ["vip"],
+    }
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+def issues_at(issues, row):
+    return [issue for issue in issues if issue.row == row]
+
+
+def columns_at(issues, row):
+    return {issue.column for issue in issues if issue.row == row}
+
+
+def rows_of(issues):
+    return {issue.row for issue in issues}
+
+
+def comparable(issues):
+    """Issues as a sorted list, since the order of report lists is left open."""
+    return sorted((issue.row, issue.column or "", issue.message) for issue in issues)

+"""CSV import of contacts.
+
+Reads the columns written by export.py (``name,email,phone,tags``) or the
+address-book variant with ``first_name`` + ``last_name`` instead of ``name``.
+Rows for new emails create contacts; rows for known emails update them without
+ever clearing a phone or removing a tag. Problems are reported per row; only
+problems with the file as a whole raise ImportFileError. See SPEC.md.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_ROWS = 1000
+
+_KNOWN_COLUMNS = ("name", "email", "phone", "tags", "first_name", "last_name")
+_BOM = "\ufeff"
+
+
+@dataclass
+class RowIssue:
+    """A problem with one row; ``row`` is the spreadsheet row (header is 1)."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass
+class ImportReport:
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV ``data``.
+
+    Rows with errors are skipped entirely; the other rows are applied. Raises
+    ImportFileError, before touching ``repo``, if the file can't be imported.
+    """
+    text = _decode(data)
+    if not text.strip():
+        raise ImportFileError("the file is empty")
+
+    report = ImportReport()
+    header, rows = _read_rows(text)
+    columns = _parse_header(header, report)
+
+    first_row_for_email: dict[str, int] = {}
+    for row_number, cells in rows:
+        _import_row(repo, columns, row_number, cells, first_row_for_email, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ImportFileError(
+                'the file is not UTF-8 text; re-save it as "CSV UTF-8" and try again'
+            ) from None
+    if isinstance(data, str):
+        return data.removeprefix(_BOM)
+    raise TypeError(f"import_contacts expects str or bytes, not {type(data).__name__}")
+
+
+def _read_rows(text: str) -> tuple[list[str], list[tuple[int, list[str]]]]:
+    """Return the header and the non-blank data rows with their row numbers.
+
+    Reads the whole file before anything is imported so that file-level
+    problems (malformed CSV, too many rows) leave the repository untouched.
+    """
+    # strict: an unclosed quote would otherwise swallow the rest of the file.
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    rows: list[tuple[int, list[str]]] = []
+    header: list[str] | None = None
+    try:
+        while True:
+            # A record starts on the line after the previous one ended; blank
+            # lines come through as empty records, so every line is counted.
+            row_number = reader.line_num + 1
+            try:
+                cells = next(reader)
+            except StopIteration:
+                break
+            if header is None:
+                header = cells
+            elif any(cell.strip() for cell in cells):
+                rows.append((row_number, cells))
+                if len(rows) > MAX_ROWS:
+                    raise ImportFileError(
+                        f"the file has more than {MAX_ROWS} contact rows; split it up"
+                    )
+    except csv.Error as exc:
+        raise ImportFileError(f"cannot read the file as CSV: {exc}") from None
+    return header or [], rows
+
+
+def _parse_header(header: list[str], report: ImportReport) -> dict[str, int]:
+    """Map recognised column names to cell positions; warn about the rest."""
+    positions: dict[str, int] = {}
+    for index, raw in enumerate(header):
+        column = raw.strip().lower()
+        if column in _KNOWN_COLUMNS:
+            if column in positions:
+                raise ImportFileError(f"column {column!r} appears more than once")
+            positions[column] = index
+
+    if "email" not in positions:
+        raise ImportFileError("the file has no 'email' column")
+    if "name" in positions:
+        positions.pop("first_name", None)
+        positions.pop("last_name", None)
+    elif not ("first_name" in positions and "last_name" in positions):
+        raise ImportFileError(
+            "the file has no 'name' column (or 'first_name' and 'last_name' columns)"
+        )
+
+    used = set(positions.values())
+    for index, raw in enumerate(header):
+        if index not in used and raw.strip():
+            report.warnings.append(RowIssue(1, None, f"unknown column {raw.strip()!r} ignored"))
+    return positions
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    columns: dict[str, int],
+    row: int,
+    cells: list[str],
+    first_row_for_email: dict[str, int],
+    report: ImportReport,
+) -> None:
+    def cell(column: str) -> str:
+        index = columns[column]
+        return cells[index] if index < len(cells) else ""
+
+    errors: list[RowIssue] = []
+
+    if "name" in columns:
+        raw_name = cell("name")
+    else:
+        raw_name = f"{cell('first_name')} {cell('last_name')}"
+    try:
+        name = validate_name(raw_name)
+    except ValidationError as exc:
+        errors.append(RowIssue(row, "name", exc.message))
+
+    try:
+        email = normalize_email(cell("email"))
+    except ValidationError as exc:
+        errors.append(RowIssue(row, "email", exc.message))
+    else:
+        first_row = first_row_for_email.setdefault(email, row)
+        if first_row != row:
+            errors.append(RowIssue(row, "email", f"duplicate of row {first_row}"))
+
+    tags: frozenset[str] = frozenset()
+    if "tags" in columns:
+        pieces = [piece for piece in cell("tags").split(TAG_SEPARATOR) if piece.strip()]
+        try:
+            tags = normalize_tags(pieces)
+        except ValidationError as exc:
+            errors.append(RowIssue(row, "tags", exc.message))
+
+    phone: str | None = None
+    phone_warning: RowIssue | None = None
+    if "phone" in columns and cell("phone").strip():
+        try:
+            phone = normalize_phone(cell("phone"))
+        except ValidationError as exc:
+            phone_warning = RowIssue(row, "phone", f"{exc.message}; phone left unchanged")
+
+    if errors:
+        report.errors.extend(errors)
+        return
+
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+    else:
+        changed = replace(
+            existing,
+            name=name,
+            phone=phone or existing.phone,
+            tags=existing.tags | tags,
+        )
+        if changed != existing:
+            repo.update(changed)
+            report.updated.append(email)
+    if phone_warning is not None:
+        report.warnings.append(phone_warning)

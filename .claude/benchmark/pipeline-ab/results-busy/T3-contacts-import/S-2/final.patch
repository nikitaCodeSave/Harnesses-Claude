@@ -0,0 +1,387 @@
+"""Tests for CSV import; numbers in comments refer to SPEC.md criteria."""
+
+import pytest
+
+from contactbook import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def repo_with(*contacts: Contact) -> InMemoryContactRepository:
+    return InMemoryContactRepository(contacts)
+
+
+def ann(**overrides) -> Contact:
+    fields = {"name": "Ann Lee", "email": "ann@example.com", "phone": "5551234567", "tags": ["vip"]}
+    fields.update(overrides)
+    return Contact.create(**fields)
+
+
+# --- whole-file outcomes (1-9) ---------------------------------------------
+
+
+def test_import_file_error_is_a_contact_error():
+    assert issubclass(ImportFileError, ContactError)
+
+
+@pytest.mark.parametrize("data", ["", b"", "   \n\n", "\ufeff", b"\xef\xbb\xbf"])
+def test_empty_file_is_rejected(data):  # 2
+    with pytest.raises(ImportFileError):
+        import_contacts(InMemoryContactRepository(), data)
+
+
+@pytest.mark.parametrize("data", [HEADER, HEADER + "\n,,,\n  ,\n"])
+def test_header_only_gives_empty_report(data):  # 3
+    repo = repo_with(ann())
+    assert import_contacts(repo, data) == ImportReport()
+    assert repo.all() == [ann()]
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "name,phone\n",  # 4 no email
+        "email,phone\n",  # 5 no name
+        "first_name,email\n",  # 5 half a name pair
+        "last_name,email\n",
+        "name,email,Email\n",  # 6 duplicate column
+        "first_name,first_name,last_name,email\n",
+        "\nname,email\n",  # header must be row 1
+    ],
+)
+def test_bad_header_is_rejected_and_nothing_imported(header):  # 1, 4, 5, 6
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, header + "Ann Lee,ann@example.com\n")
+    assert len(repo) == 0
+
+
+def test_size_limit_counts_contact_rows_only():  # 7
+    rows = "".join(f"P{i},p{i}@example.com,,\n" for i in range(1000))
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, HEADER + "\n,,,\n" + rows + "\n\n")
+    assert len(report.created) == 1000
+
+
+def test_size_limit_counts_rows_with_errors_and_rejects_whole_file():  # 1, 7
+    rows = "".join(f"P{i},p{i}@example.com,,\n" for i in range(1000))
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError, match="1000"):
+        import_contacts(repo, HEADER + rows + "Bad,not-an-email,,\n")
+    assert len(repo) == 0
+
+
+def test_non_utf8_bytes_are_rejected_with_resave_hint():  # 8
+    data = (HEADER + "José Ruiz,jose@example.com,,\n").encode("cp1252")
+    repo = InMemoryContactRepository()
+    with pytest.raises(ImportFileError, match='"CSV UTF-8"'):

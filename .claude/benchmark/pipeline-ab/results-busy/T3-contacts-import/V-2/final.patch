@@ -0,0 +1,195 @@
+import pytest
+
+from contactbook.errors import ContactError, ImportFileError
+from contactbook.export import export_csv
+from contactbook.importer import RowIssue, import_contacts
+from contactbook.models import Contact
+from contactbook.repository import InMemoryContactRepository
+
+HEADER = "name,email,phone,tags\n"
+
+
+def test_import_creates_contacts_with_normalised_values():
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, HEADER + " Ann  Lee ,Ann@Example.COM,+1 (555) 123-4567,VIP;Key Account\n"
+    )
+    assert report.created == ["ann@example.com"]
+    assert report.updated == report.errors == report.warnings == []
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"vip", "key-account"}),
+    )
+
+
+def test_export_then_import_round_trips():
+    contacts = [
+        Contact.create("Ann Lee", "ann@example.com", "+15551234567", ["vip", "lead"]),
+        Contact.create("Bob, Jr.", "bob@example.com"),
+    ]
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, export_csv(contacts))
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert repo.all() == contacts
+
+
+def test_reimporting_the_same_file_changes_nothing():
+    data = HEADER + "Ann Lee,ann@example.com,,vip\n"
+    repo = InMemoryContactRepository()
+    import_contacts(repo, data)
+    report = import_contacts(repo, data)
+    assert report.created == report.updated == report.errors == []
+
+
+def test_existing_contact_is_updated_from_the_row():
+    repo = InMemoryContactRepository([Contact.create("Ann", "ann@example.com", "5551234", ["old"])])
+    report = import_contacts(repo, HEADER + "Ann Lee,ANN@example.com,5559999,new\n")
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact.create(
+        "Ann Lee", "ann@example.com", "5559999", ["new"]
+    )
+
+
+def test_empty_cells_clear_stored_values_with_a_warning():
+    repo = InMemoryContactRepository([Contact.create("Ann", "ann@example.com", "5551234", ["vip"])])
+    report = import_contacts(repo, HEADER + "Ann,ann@example.com,,\n")
+    assert report.updated == ["ann@example.com"]
+    assert [(w.row, w.column) for w in report.warnings] == [(2, "phone"), (2, "tags")]
+    assert repo.get("ann@example.com") == Contact.create("Ann", "ann@example.com")
+
+
+def test_columns_missing_from_the_file_keep_stored_values():
+    repo = InMemoryContactRepository([Contact.create("Ann", "ann@example.com", "5551234", ["vip"])])
+    report = import_contacts(repo, "email,name\nann@example.com,Ann Lee\n")
+    assert report.updated == ["ann@example.com"]
+    assert report.warnings == []
+    assert repo.get("ann@example.com") == Contact.create(
+        "Ann Lee", "ann@example.com", "5551234", ["vip"]
+    )
+
+
+def test_invalid_rows_are_reported_and_skipped_others_imported():
+    data = (
+        HEADER
+        + "Ann Lee,ann@example.com,,\n"
+        + ",not-an-email,12,bad!tag\n"
+        + "Bob,bob@example.com,,\n"
+    )
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert [(e.row, e.column) for e in report.errors] == [
+        (3, "name"),
+        (3, "email"),
+        (3, "phone"),
+        (3, "tags"),
+    ]
+    assert len(repo) == 2
+
+
+def test_duplicate_email_in_file_keeps_first_row():
+    data = HEADER + "Ann,ann@example.com,,\nAnnie,ANN@example.com,,\n"
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com"]
+    assert report.errors == [RowIssue(3, "email", "duplicate of row 2; row skipped")]
+    assert repo.get("ann@example.com").name == "Ann"
+
+
+def test_row_with_error_still_claims_its_email():
+    data = HEADER + "Ann,ann@example.com,abc,\nAnnie,ann@example.com,,\n"
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert report.created == []
+    assert [(e.row, e.column) for e in report.errors] == [(2, "phone"), (3, "email")]
+
+
+def test_extra_non_empty_cells_are_an_error():
+    data = HEADER + "Lee, Ann,ann@example.com,5551234,vip\n"
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert report.created == []
+    assert report.errors[0].row == 2 and report.errors[0].column is None
+
+
+def test_short_rows_and_trailing_empty_cells_are_fine():
+    data = HEADER + "Ann,ann@example.com\nBob,bob@example.com,,,,\n"
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert report.errors == []
+
+
+def test_blank_rows_are_skipped_and_row_numbers_follow_the_spreadsheet():
+    data = "\n" + HEADER + ",,,\n\nAnn,bad,,\n"
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert report.errors == [RowIssue(5, "email", "is not a valid address: 'bad'")]
+
+
+def test_quoted_cells_with_newlines_count_as_one_row():
+    data = HEADER + '"Ann\nLee",ann@example.com,,\nBob,bad,,\n'
+    report = import_contacts(InMemoryContactRepository(), data)
+    assert report.created == ["ann@example.com"]
+    assert [e.row for e in report.errors] == [3]
+
+
+def test_header_is_case_insensitive_reorderable_and_unknown_columns_warn():
+    data = " Email ,Company,NAME,\nann@example.com,Acme,Ann,\n"
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com"]
+    assert report.warnings == [
+        RowIssue(1, "Company", "unknown column; ignored"),
+        RowIssue(1, None, "column 4 has no header; ignored"),
+    ]
+
+
+def test_bytes_with_utf8_bom_from_excel():
+    data = ("\ufeff" + HEADER + "Zoë Ångström,zoe@example.com,,\n").encode("utf-8")
+    repo = InMemoryContactRepository()
+    import_contacts(repo, data)
+    assert repo.get("zoe@example.com").name == "Zoë Ångström"
+
+
+def test_text_with_bom_and_crlf():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "\ufeffname,email\r\nAnn,ann@example.com\r\n")
+    assert report.created == ["ann@example.com"]
+
+
+def test_utf16_with_bom():
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, (HEADER + "Ann,ann@example.com,,\n").encode("utf-16"))
+    assert report.created == ["ann@example.com"]
+
+
+def test_semicolon_delimited_file_from_european_excel():
+    data = 'name;email;phone;tags\nAnn;ann@example.com;;"vip;lead"\n'
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").tags == {"vip", "lead"}
+
+
+def test_header_only_file_imports_nothing():
+    report = import_contacts(InMemoryContactRepository(), HEADER)

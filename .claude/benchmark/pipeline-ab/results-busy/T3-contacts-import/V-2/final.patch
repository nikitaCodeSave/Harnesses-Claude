+@pytest.mark.parametrize(
+    ("data", "message"),
+    [
+        (b"", "empty"),
+        ("\n , \n", "empty"),
+        ("name,phone\nAnn,5551234\n", "email"),
+        ("first,last\n", "name, email"),
+        ("name,email,Email\n", "more than once"),
+        ((HEADER + "Zoë,zoe@example.com,,\n").encode("cp1252"), "UTF-8"),
+        (HEADER + '"Ann,ann@example.com,,\nBob,bob@example.com,,\n', "malformed"),
+    ],
+)
+def test_file_level_problems_raise_and_leave_repo_untouched(data, message):
+    repo = InMemoryContactRepository([Contact.create("Old", "old@example.com")])
+    with pytest.raises(ImportFileError, match=message) as excinfo:
+        import_contacts(repo, data)
+    assert isinstance(excinfo.value, ContactError)
+    assert [c.email for c in repo] == ["old@example.com"]

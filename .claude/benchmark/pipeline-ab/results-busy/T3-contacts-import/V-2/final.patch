+"""CSV import of contacts.
+
+Reads the format written by :func:`contactbook.export.export_csv` (columns
+``name``, ``email``, ``phone``, ``tags``; tags joined with ``;`` in one cell)
+and adds or updates contacts in a repository, keyed by email.
+
+Problems with the file as a whole raise ImportFileError before the repository
+is touched. Problems with single rows are collected in the ImportReport; the
+offending rows are skipped and every other row is imported.
+
+Row numbers in the report are spreadsheet row numbers: the header is usually
+row 1 and the first contact row 2.
+"""
+
+from __future__ import annotations
+
+import codecs
+import csv
+import io
+from collections.abc import Callable
+from dataclasses import dataclass, field, replace
+
+from .errors import ImportFileError, ValidationError
+from .export import EXPORT_COLUMNS, TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+REQUIRED_COLUMNS = ("name", "email")
+
+# Excel writes ";" instead of "," in locales that use a decimal comma.
+_DELIMITERS = (",", ";", "\t")
+
+
+@dataclass(frozen=True, slots=True)
+class RowIssue:
+    """A problem found in one row. ``column`` is None when it concerns the whole row."""
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    """Outcome of an import.
+
+    ``created`` and ``updated`` hold normalised emails in file order. A row that
+    matches the stored contact exactly is in neither list. Rows with errors are
+    skipped; warnings describe rows that were imported but deserve a look.
+    """
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Import contacts from CSV ``data`` into ``repo``.
+
+    ``data`` is either the raw file content (UTF-8, with or without BOM, or
+    UTF-16 with BOM) or already-decoded text. A row whose email is not in the
+    repository creates a contact; otherwise the stored contact is replaced with
+    the row's values for the columns the file has. ``phone`` and ``tags`` are
+    optional columns: when the file lacks one, stored values are kept; when it
+    has one, an empty cell clears the stored value (reported as a warning).
+    Blank rows are skipped. A repeated email is an error on every row after
+    the first.
+
+    Raises ImportFileError if the file can't be decoded or parsed as CSV, or
+    lacks a ``name`` or ``email`` column.
+    """
+    text = _decode(data)
+    records = _parse(text, _sniff_delimiter(text))
+
+    report = ImportReport()
+    header_row = _first_non_blank(records)
+    if header_row is None:
+        raise ImportFileError("file is empty")
+    header = records[header_row - 1]
+    columns = _read_header(header_row, header, report)
+
+    # Rows with errors still claim their email, so fixing row 2 and importing
+    # again doesn't suddenly turn row 5 into a duplicate.
+    first_row_by_email: dict[str, int] = {}
+    for row_number in range(header_row + 1, len(records) + 1):
+        cells = records[row_number - 1]
+        if _is_blank(cells):
+            continue
+        email, contact = _parse_row(row_number, cells, columns, len(header), report)
+        if email is None:
+            continue
+        if email in first_row_by_email:
+            report.errors.append(
+                RowIssue(
+                    row_number,
+                    "email",
+                    f"duplicate of row {first_row_by_email[email]}; row skipped",
+                )
+            )
+            continue
+        first_row_by_email[email] = row_number
+        if contact is not None:
+            _save(repo, row_number, contact, columns, report)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, str):
+        return data.removeprefix("\ufeff")
+    if not isinstance(data, (bytes, bytearray)):
+        raise TypeError(f"expected str or bytes, got {type(data).__name__}")
+    raw = bytes(data)
+    if raw.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
+        encoding = "utf-16"
+    else:
+        encoding = "utf-8-sig"
+    try:
+        return raw.decode(encoding)
+    except UnicodeDecodeError as exc:
+        raise ImportFileError(
+            f"file is not valid {encoding.removesuffix('-sig').upper()} text "
+            f"(bad byte at offset {exc.start}); save it as CSV UTF-8 and try again"
+        ) from None
+
+
+def _sniff_delimiter(text: str) -> str:
+    """Pick the delimiter that makes the first non-blank line a valid header."""
+    for delimiter in _DELIMITERS:
+        reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+        try:
+            header = next((cells for cells in reader if not _is_blank(cells)), [])
+        except csv.Error:
+            continue
+        names = {cell.strip().lower() for cell in header}
+        if all(column in names for column in REQUIRED_COLUMNS):
+            return delimiter
+    return ","
+
+
+def _parse(text: str, delimiter: str) -> list[list[str]]:
+    """All records, one per spreadsheet row (blank lines included as [])."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter, strict=True)
+    try:
+        return list(reader)
+    except csv.Error as exc:
+        raise ImportFileError(f"malformed CSV near line {reader.line_num}: {exc}") from None
+
+
+def _first_non_blank(records: list[list[str]]) -> int | None:
+    for row_number, cells in enumerate(records, start=1):
+        if not _is_blank(cells):
+            return row_number
+    return None
+
+
+def _read_header(row: int, cells: list[str], report: ImportReport) -> dict[str, int]:
+    """Map known column names to cell indexes; warn about the columns ignored."""
+    columns: dict[str, int] = {}
+    for index, cell in enumerate(cells):
+        name = cell.strip().lower()
+        if name in columns:
+            raise ImportFileError(f"column {name!r} appears more than once in the header")
+        if name in EXPORT_COLUMNS:
+            columns[name] = index
+        elif name:
+            report.warnings.append(RowIssue(row, cell.strip(), "unknown column; ignored"))
+        else:
+            report.warnings.append(
+                RowIssue(row, None, f"column {index + 1} has no header; ignored")
+            )
+    missing = [name for name in REQUIRED_COLUMNS if name not in columns]
+    if missing:
+        raise ImportFileError(
+            f"missing required column(s): {', '.join(missing)}; "
+            f"expected a header row with {', '.join(EXPORT_COLUMNS)}"
+        )
+    return columns
+
+
+def _parse_row(
+    row: int, cells: list[str], columns: dict[str, int], width: int, report: ImportReport
+) -> tuple[str | None, Contact | None]:
+    """Validate one row, recording every problem found.
+
+    Returns the normalised email (None if invalid) and the contact (None if the
+    row has any error).
+    """
+    if any(cell.strip() for cell in cells[width:]):
+        report.errors.append(
+            RowIssue(
+                row,
+                None,
+                f"row has {len(cells)} cells but the header has {width}; "
+                "check for an unquoted comma",
+            )
+        )
+        return None, None
+
+    def cell(column: str) -> str:
+        index = columns.get(column)
+        return cells[index] if index is not None and index < len(cells) else ""
+
+    errors_before = len(report.errors)
+    name = _check(row, report, validate_name, cell("name"))
+    email = _check(row, report, normalize_email, cell("email"))
+    raw_phone = cell("phone")
+    phone = _check(row, report, normalize_phone, raw_phone) if raw_phone.strip() else None
+    raw_tags = [tag for tag in cell("tags").split(TAG_SEPARATOR) if tag.strip()]
+    tags = _check(row, report, normalize_tags, raw_tags)
+    if len(report.errors) > errors_before:
+        return email, None
+    return email, Contact(name=name, email=email, phone=phone, tags=tags)
+
+
+def _check[R, T](
+    row: int, report: ImportReport, normalize: Callable[[R], T], raw: R
+) -> T | None:
+    """Return ``normalize(raw)``, or record its ValidationError and return None."""
+    try:
+        return normalize(raw)
+    except ValidationError as exc:
+        report.errors.append(RowIssue(row, exc.field, exc.message))
+        return None
+
+
+def _save(
+    repo: InMemoryContactRepository,
+    row: int,
+    contact: Contact,
+    columns: dict[str, int],
+    report: ImportReport,
+) -> None:
+    existing = repo.find(contact.email)
+    if existing is None:
+        repo.add(contact)
+        report.created.append(contact.email)
+        return
+
+    if "phone" not in columns:
+        contact = replace(contact, phone=existing.phone)
+    elif existing.phone and contact.phone is None:
+        report.warnings.append(
+            RowIssue(row, "phone", f"empty cell cleared the stored phone {existing.phone}")
+        )
+    if "tags" not in columns:
+        contact = replace(contact, tags=existing.tags)
+    elif existing.tags and not contact.tags:
+        stored = TAG_SEPARATOR.join(sorted(existing.tags))
+        report.warnings.append(
+            RowIssue(row, "tags", f"empty cell cleared the stored tags {stored}")
+        )
+
+    if contact != existing:
+        repo.update(contact)
+        report.updated.append(contact.email)
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return not any(cell.strip() for cell in cells)

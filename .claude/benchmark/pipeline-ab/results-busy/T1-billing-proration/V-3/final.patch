+    def change_plan(
+        self,
+        subscription_id: str,
+        new_plan_code: str,
+        new_interval: Interval | None = None,
+    ) -> Invoice | None:
+        """Move a subscription to another plan and/or interval, effective today.
+
+        ``new_interval=None`` keeps the current interval.
+
+        While trialing nothing has been paid, so the plan is swapped without
+        billing and the first paid period (on the new plan and interval)
+        still starts when the trial ends; returns ``None``.
+
+        Otherwise the unused days of the current period are credited at the
+        current plan's price, and:
+
+        - same interval: the new plan is charged for those same days and the
+          period (and so the renewal date) is unchanged;
+        - interval switch: a new period of the new interval starts today and
+          is charged in full.
+
+        Both lines go on one invoice issued today. A downgrade can make its
+        total negative: that invoice is a credit owed to the customer.
+        Returns ``None`` if every line is zero (e.g. between free plans).
+        """
+        subscription = self._store.get_subscription(subscription_id)
+        if subscription.is_canceled:
+            raise SubscriptionNotActive(subscription_id)
+        new_plan = self._store.get_plan(new_plan_code)
+        interval = subscription.interval if new_interval is None else new_interval
+        if new_plan.code == subscription.plan_code and interval is subscription.interval:
+            raise InvalidPlanChange(f"{subscription_id} is already on {new_plan.code} ({interval.value})")
+        if not new_plan.active:
+            raise PlanNotAvailable(new_plan.code)
+
+        today = self._clock.today()
+        if subscription.period_end <= today:
+            # The current period is over but not yet renewed: there are no
+            # unused days to credit, and the renewal itself is still owed.
+            raise InvalidPlanChange(
+                f"{subscription_id} has a renewal due on {subscription.period_end.isoformat()}; "
+                "run renew_due before changing plan"
+            )
+
+        if subscription.status is SubscriptionStatus.TRIALING:
+            self._store.save_subscription(replace(subscription, plan_code=new_plan.code, interval=interval))
+            return None
+
+        old_plan = self._store.get_plan(subscription.plan_code)
+        remaining = (subscription.period_end - today).days
+        total = (subscription.period_end - subscription.period_start).days
+        credit = LineItem(
+            description=(
+                f"Unused time on {old_plan.name} ({subscription.interval.value}) "
+                f"{today.isoformat()} to {subscription.period_end.isoformat()}"
+            ),
+            amount=-to_money(old_plan.price_for(subscription.interval) * remaining / total),
+        )
+
+        if interval is subscription.interval:
+            changed = replace(subscription, plan_code=new_plan.code)
+            charge = LineItem(
+                description=(
+                    f"Remaining time on {new_plan.name} ({interval.value}) "
+                    f"{today.isoformat()} to {subscription.period_end.isoformat()}"
+                ),
+                amount=to_money(new_plan.price_for(interval) * remaining / total),
+            )
+        else:
+            changed = replace(
+                subscription,
+                plan_code=new_plan.code,
+                interval=interval,
+                period_start=today,
+                period_end=period_end(today, interval),
+            )
+            charge = self._period_line(new_plan, changed)
+
+        self._store.save_subscription(changed)
+        lines = [line for line in (credit, charge) if line.amount != ZERO]
+        if not lines:
+            return None
+        return self._issue_invoice(changed, lines, today)
+
     def cancel(self, subscription_id: str) -> Subscription:
         """Cancel immediately. No refund; the subscription is never renewed."""
         subscription = self._store.get_subscription(subscription_id)
diff --git a/tests/test_change_plan.py b/tests/test_change_plan.py

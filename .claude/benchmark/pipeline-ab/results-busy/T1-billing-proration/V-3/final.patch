+++ b/tests/test_change_plan.py
@@ -0,0 +1,191 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+# The conftest clock starts on 2026-01-15, so a monthly subscription runs
+# [2026-01-15, 2026-02-15): 31 days. Changing on 2026-01-25 leaves 21 days.
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def test_upgrade_charges_difference_for_remaining_days(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro")
+    # basic 10.00 * 21/31 = 6.77 credited, pro 30.00 * 21/31 = 20.32 charged
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    assert invoice.total == Decimal("13.55")
+    assert invoice.issued_on == date(2026, 1, 25)
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_same_interval_change_keeps_period_and_renews_on_new_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.period_start, changed.period_end) == (
+        "pro",
+        date(2026, 1, 15),
+        date(2026, 2, 15),
+    )
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_downgrade_issues_credit(service, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "basic")
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("6.77")]
+    assert invoice.total == Decimal("-13.55")
+
+
+def test_change_on_first_day_swaps_full_prices(service):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_monthly_to_annual_starts_new_annual_period(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("300.00")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.interval, changed.period_start, changed.period_end) == (
+        Interval.ANNUAL,
+        date(2026, 1, 25),
+        date(2027, 1, 25),
+    )
+
+
+def test_annual_to_monthly_credits_unused_year(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)  # [2026-01-15, 2027-01-15): 365 days
+    clock.move_to(date(2026, 7, 15))  # 184 days left
+    invoice = service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    # 300.00 * 184/365 = 151.23
+    assert amounts(invoice) == [Decimal("-151.23"), Decimal("30.00")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.period_start, changed.period_end) == (date(2026, 7, 15), date(2026, 8, 15))
+
+
+def test_interval_defaults_to_current(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+
+def test_consecutive_changes_do_not_double_charge(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    service.change_plan(sub.id, "basic")
+    # Back on basic on the same day: net effect of both changes is zero.
+    assert sum(inv.total for inv in store.invoices_for(sub.id)) == Decimal("10.00")
+
+
+def test_trial_change_bills_nothing_and_keeps_trial_end(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert store.invoices_for(sub.id) == []
+    changed = store.get_subscription(sub.id)
+    assert (changed.status, changed.plan_code, changed.period_end) == (
+        SubscriptionStatus.TRIALING,
+        "pro",
+        date(2026, 1, 29),
+    )
+    clock.move_to(date(2026, 1, 29))
+    [first] = service.renew_due()
+    assert first.total == Decimal("300.00")
+
+
+def test_change_between_free_plans_bills_nothing(service, store, clock):
+    store.add_plan(Plan("free", "Free", Decimal("0"), Decimal("0")))
+    store.add_plan(Plan("hobby", "Hobby", Decimal("0"), Decimal("0")))
+    sub = service.subscribe("cus_1", "free")
+    clock.move_to(date(2026, 1, 25))
+    before = len(store.invoices_for(sub.id))
+    assert service.change_plan(sub.id, "hobby") is None
+    assert len(store.invoices_for(sub.id)) == before
+    assert store.get_subscription(sub.id).plan_code == "hobby"
+
+
+def test_from_free_plan_omits_zero_credit_line(service, store, clock):
+    store.add_plan(Plan("free", "Free", Decimal("0"), Decimal("0")))
+    sub = service.subscribe("cus_1", "free")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("20.32")]
+
+
+def test_can_leave_a_retired_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "pro").total == Decimal("13.55")
+
+
+def test_cannot_move_to_retired_plan(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "pro")
+
+
+def test_cannot_switch_interval_on_retired_plan(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+
+def test_no_op_change_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic", Interval.MONTHLY)
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_change_with_renewal_due_is_rejected(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 15))
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_change_canceled_subscription(service):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "pro")
+
+
+def test_change_unknown_subscription(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_9999", "pro")
+
+
+def test_change_to_unknown_plan(service):
+    sub = service.subscribe("cus_1", "basic")
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")

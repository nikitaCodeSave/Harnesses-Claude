+# downgrades and interval switches
+
+
+def test_downgrade_waits_for_period_end(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "basic") is None
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.period_end) == ("pro", date(2026, 2, 15))
+
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("10.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+
+
+def test_downgrade_with_annual_switch_waits(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("100.00")
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))

+    assert service.change_plan(sub.id, "basic", Interval.MONTHLY) is None
+    assert renew_on(service, clock, date(2027, 1, 14)) == []
+    [renewal] = renew_on(service, clock, date(2027, 1, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("10.00")
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 1, 15), date(2027, 2, 15))
+

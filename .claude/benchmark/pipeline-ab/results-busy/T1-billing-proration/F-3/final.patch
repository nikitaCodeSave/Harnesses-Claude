+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+import billing
+from billing.errors import (
+    BillingError,
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.service import BillingService
+from billing.subscriptions import ScheduledChange, SubscriptionStatus
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def renew_on(service, clock, day):
+    clock.move_to(day)
+    return service.renew_due()
+
+
+# return value and recording
+
+
+def test_returned_invoice_is_recorded_last_and_dated_today(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro")
+    assert store.invoices_for(sub.id)[-1] == invoice
+    assert invoice.issued_on == date(2026, 1, 25)
+
+
+@pytest.mark.parametrize(
+    "plan_code, interval",
+    [("basic", None), ("pro", Interval.ANNUAL), ("pro", None)],
+)
+def test_none_result_records_no_invoice(service, store, clock, plan_code, interval):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")  # something scheduled, so ("pro", None) cancels it
+    before = store.invoices_for(sub.id)
+    assert service.change_plan(sub.id, plan_code, interval) is None
+    assert store.invoices_for(sub.id) == before
+
+
+def test_trial_change_records_no_invoice(service, store):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    assert service.change_plan(sub.id, "pro") is None
+    assert store.invoices_for(sub.id) == []
+
+
+@pytest.mark.parametrize(
+    "plan_code, interval, error",
+    [
+        ("gold", None, PlanNotFound),
+        ("team", None, PlanNotAvailable),
+        ("pro", None, InvalidPlanChange),
+    ],
+)
+def test_failed_request_leaves_store_unchanged(service, store, clock, plan_code, interval, error):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    store.retire_plan("team")
+    if error is InvalidPlanChange:
+        clock.move_to(date(2026, 2, 15))  # renewal outstanding
+    before = (store.get_subscription(sub.id), store.get_scheduled_change(sub.id), store.invoices_for(sub.id))
+    with pytest.raises(error):
+        service.change_plan(sub.id, plan_code, interval)
+    after = (store.get_subscription(sub.id), store.get_scheduled_change(sub.id), store.invoices_for(sub.id))
+    assert after == before
+
+
+def test_failed_upgrade_on_canceled_sub_leaves_store_unchanged(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    before = (store.get_subscription(sub.id), store.invoices_for(sub.id))
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "pro")
+    assert (store.get_subscription(sub.id), store.invoices_for(sub.id)) == before
+
+
+# upgrades
+
+
+def test_upgrade_mid_month(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    assert invoice.total == Decimal("13.55")
+    for line in invoice.lines:
+        assert "(monthly) 2026-01-25 to 2026-02-15" in line.description
+    assert "Basic" in invoice.lines[0].description and "Pro" in invoice.lines[1].description
+
+    upgraded = store.get_subscription(sub.id)
+    assert (upgraded.plan_code, upgraded.interval) == ("pro", Interval.MONTHLY)
+    assert (upgraded.period_start, upgraded.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    assert renewal.total == Decimal("30.00")
+
+
+def test_upgrade_on_period_start_is_full_swap(service):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_upgrade_annual(service, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-50.41"), Decimal("151.23")]
+
+
+def test_upgrade_with_negative_total(store, clock):
+    store.add_plan(Plan("a", "A", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("b", "B", Decimal("12.00"), Decimal("90.00")))
+    service = BillingService(store, clock)
+    sub = service.subscribe("cus_1", "a", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))
+    invoice = service.change_plan(sub.id, "b")
+    assert amounts(invoice) == [Decimal("-50.41"), Decimal("45.37")]
+    assert invoice.total == Decimal("-5.04")
+    assert store.get_subscription(sub.id).plan_code == "b"
+
+
+def test_upgrade_with_interval_switch_prorates_at_current_interval(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    assert invoice.total == Decimal("13.55")
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval, now.period_end) == ("pro", Interval.MONTHLY, date(2026, 2, 15))
+
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("300.00")
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+
+
+def test_two_upgrades_in_one_period(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 2, 1))
+    invoice = service.change_plan(sub.id, "team")
+    assert amounts(invoice) == [Decimal("-13.55"), Decimal("22.58")]
+    assert "Pro" in invoice.lines[0].description and "Team" in invoice.lines[1].description
+
+
+def test_upgrade_discards_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 2, 1))
+    invoice = service.change_plan(sub.id, "team")
+    assert amounts(invoice) == [Decimal("-13.55"), Decimal("22.58")]
+    assert store.get_scheduled_change(sub.id) is None
+
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    assert renewal.total == Decimal("50.00")
+    assert store.get_subscription(sub.id).plan_code == "team"
+
+
+def test_upgrade_with_switch_replaces_earlier_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    service.change_plan(sub.id, "team", Interval.ANNUAL)
+    assert store.get_scheduled_change(sub.id) == ScheduledChange("team", Interval.ANNUAL)
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    assert renewal.total == Decimal("500.00")
+
+
+def test_upgrade_away_from_retired_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro")
+    assert invoice.total == Decimal("13.55")

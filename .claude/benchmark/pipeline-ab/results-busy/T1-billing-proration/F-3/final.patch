+def test_change_between_equal_monthly_prices_is_a_downgrade(store, clock):
+    store.add_plan(Plan("pro2", "Pro Two", Decimal("30.00"), Decimal("250.00")))
+    service = BillingService(store, clock)
+    sub = service.subscribe("cus_1", "pro")
+    assert service.change_plan(sub.id, "pro2") is None
+    assert store.get_subscription(sub.id).plan_code == "pro"
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).plan_code == "pro2"

@@ -0,0 +1,332 @@
+"""BillingService.change_plan; numbers refer to the criteria in SPEC.md."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import ScheduledChange, SubscriptionStatus
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+
+def subscribe_on(service, clock, day, plan_code, interval=MONTHLY, **kwargs):
+    clock.move_to(day)
+    return service.subscribe("cus_1", plan_code, interval, **kwargs)
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+@pytest.fixture
+def pro_in_march(service, clock):
+    """Pro monthly, period 2026-03-01 to 2026-04-01 (31 days), clock on Mar 11."""
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+    return sub
+
+
+# upgrades (1-7)
+
+
+def test_upgrade_is_billed_now_with_credit_and_charge(service, store, pro_in_march):  # 1, 2, 3
+    invoice = service.change_plan(pro_in_march.id, "premium")
+
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("50.81")]
+    assert invoice.total == Decimal("30.49")
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert store.invoices_for(pro_in_march.id)[-1] == invoice
+    upgraded = store.get_subscription(pro_in_march.id)
+    assert (upgraded.plan_code, upgraded.interval) == ("premium", MONTHLY)
+    assert (upgraded.period_start, upgraded.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+    assert upgraded.scheduled_change is None
+
+
+def test_upgrade_rounds_each_line_not_the_difference(service, pro_in_march):  # 3
+    # The exact difference 45 * 21 / 31 = 30.4839 would round to 30.48.
+    assert service.change_plan(pro_in_march.id, "premium").total == Decimal("30.49")
+
+
+def test_upgrade_uses_real_days_of_a_short_month(service, clock):  # 3
+    sub = subscribe_on(service, clock, date(2026, 2, 1), "basic")
+    clock.move_to(date(2026, 2, 15))  # 14 of 28 days left
+    assert amounts(service.change_plan(sub.id, "pro")) == [Decimal("-5.00"), Decimal("15.00")]
+
+
+def test_upgrade_on_first_day_credits_the_whole_period(service, clock):  # 2
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    assert amounts(service.change_plan(sub.id, "premium")) == [Decimal("-30.00"), Decimal("75.00")]
+
+
+def test_annual_upgrade_is_prorated_at_annual_prices(service, clock):  # 2, 3
+    sub = subscribe_on(service, clock, date(2028, 1, 1), "basic", ANNUAL)  # 366-day leap year
+    clock.move_to(date(2028, 7, 1))  # 184 days left
+    invoice = service.change_plan(sub.id, "pro")
+    # 100 * 184 / 366 = 50.2732; 300 * 184 / 366 = 150.8197
+    assert amounts(invoice) == [Decimal("-50.27"), Decimal("150.82")]
+
+
+def test_upgrade_rounding_to_zero_still_issues_invoice(service, store, clock):  # 4
+    store.add_plan(Plan("p1000", "P1000", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("p1001", "P1001", Decimal("10.01"), Decimal("100.10")))
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "p1000")
+    clock.move_to(date(2026, 3, 31))  # 1 of 31 days left
+    invoice = service.change_plan(sub.id, "p1001")
+    assert amounts(invoice) == [Decimal("-0.32"), Decimal("0.32")]
+    assert invoice.total == Decimal("0.00")
+    assert store.get_subscription(sub.id).plan_code == "p1001"
+
+
+def test_upgrade_with_negative_prorated_total_is_rejected(service, store, clock):  # 5, 22
+    store.add_plan(Plan("a", "A", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("b", "B", Decimal("12.00"), Decimal("90.00")))
+    sub = subscribe_on(service, clock, date(2026, 1, 15), "a", ANNUAL)
+    clock.move_to(date(2026, 6, 1))
+    with pytest.raises(InvalidPlanChange):

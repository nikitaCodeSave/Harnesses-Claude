diff --git a/tests/test_plan_change.py b/tests/test_plan_change.py
new file mode 100644
index 0000000..db4dfc5
--- /dev/null
+++ b/tests/test_plan_change.py
@@ -0,0 +1,217 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+# The fixture clock starts on 2026-01-15, so a monthly period is
+# [2026-01-15, 2026-02-15): 31 days. On 2026-01-30, 16 of them are unused.
+MID_PERIOD = date(2026, 1, 30)
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def test_upgrade_charges_only_the_difference_for_remaining_days(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(MID_PERIOD)
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    # basic 10 * 16/31 = 5.16 credited, pro 30 * 16/31 = 15.48 charged
+    assert amounts(invoice) == [Decimal("-5.16"), Decimal("15.48")]
+    assert (invoice.issued_on, invoice.total) == (MID_PERIOD, Decimal("10.32"))
+    assert store.invoices_for(sub.id)[-1] == invoice
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "pro"
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+    assert changed.credit_balance == Decimal("0.00")
+
+
+def test_upgrade_renews_at_new_plan_price(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(MID_PERIOD)
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_downgrade_bills_nothing_and_credits_the_difference(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(MID_PERIOD)
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert len(store.invoices_for(sub.id)) == 1
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "basic"
+    assert changed.credit_balance == Decimal("10.32")  # 15.48 unused pro - 5.16 basic
+
+
+def test_credit_balance_is_used_up_by_renewals(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(MID_PERIOD)
+    service.change_plan(sub.id, "basic")
+
+    clock.move_to(date(2026, 3, 15))
+    first, second = service.renew_due()
+
+    assert amounts(first) == [Decimal("10.00"), Decimal("-10.00")]
+    assert first.total == Decimal("0.00")
+    assert amounts(second) == [Decimal("10.00"), Decimal("-0.32")]
+    assert second.total == Decimal("9.68")
+    assert store.get_subscription(sub.id).credit_balance == Decimal("0.00")
+
+
+def test_credit_balance_is_taken_off_a_later_upgrade(service, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(MID_PERIOD)
+    service.change_plan(sub.id, "basic")  # 10.32 credit
+
+    invoice = service.change_plan(sub.id, "pro")  # same day: 5.16 back to basic, 15.48 for pro
+
+    assert amounts(invoice) == [Decimal("-5.16"), Decimal("15.48"), Decimal("-10.32")]
+    assert invoice.total == Decimal("0.00")
+
+
+def test_round_trip_never_bills_the_same_days_twice(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(MID_PERIOD)
+    service.change_plan(sub.id, "pro")
+    service.change_plan(sub.id, "basic")
+    paid = sum(inv.total for inv in store.invoices_for(sub.id))
+    owed_back = store.get_subscription(sub.id).credit_balance
+    assert paid - owed_back == Decimal("10.00")
+
+
+def test_equal_price_change_bills_nothing(service, store, clock):
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("300.00")))
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(MID_PERIOD)
+    assert service.change_plan(sub.id, "team") is None
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.credit_balance) == ("team", Decimal("0.00"))
+
+
+def test_change_on_first_day_credits_the_whole_period(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_monthly_to_annual_starts_a_new_annual_period_today(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(MID_PERIOD)
+
+    invoice = service.change_plan(sub.id, "basic", Interval.ANNUAL)
+
+    assert amounts(invoice) == [Decimal("-5.16"), Decimal("100.00")]
+    changed = store.get_subscription(sub.id)
+    assert changed.interval is Interval.ANNUAL
+    assert (changed.period_start, changed.period_end) == (MID_PERIOD, date(2027, 1, 30))
+
+
+def test_annual_to_monthly_credits_unused_year(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 7, 15))  # 184 of 365 days unused
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+
+    changed = store.get_subscription(sub.id)
+    assert changed.interval is Interval.MONTHLY
+    assert (changed.period_start, changed.period_end) == (date(2026, 7, 15), date(2026, 8, 15))
+    # 300 * 184/365 = 151.23 unused, less the first month at 30.00
+    assert changed.credit_balance == Decimal("121.23")
+
+
+def test_plan_and_interval_change_together(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(MID_PERIOD)
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-5.16"), Decimal("300.00")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.ANNUAL)
+
+
+def test_interval_none_keeps_current_interval(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)
+    clock.move_to(MID_PERIOD)
+    service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).interval is Interval.ANNUAL
+
+
+def test_change_during_trial_bills_nothing_and_keeps_trial_end(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+
+    changed = store.get_subscription(sub.id)
+    assert changed.status is SubscriptionStatus.TRIALING
+    assert (changed.plan_code, changed.interval, changed.period_end) == ("pro", Interval.ANNUAL, date(2026, 1, 29))
+    assert store.invoices_for(sub.id) == []
+
+    clock.move_to(date(2026, 1, 29))
+    [first] = service.renew_due()
+    assert first.total == Decimal("300.00")
+
+
+def test_change_to_same_plan_and_interval_is_rejected(service):
+    sub = service.subscribe("cus_1", "basic")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic", Interval.MONTHLY)
+
+
+def test_change_when_renewal_is_due_is_rejected(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 15))
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "pro")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_change_canceled_subscription_is_rejected(service):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "pro")
+
+
+def test_change_unknown_subscription(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_9999", "pro")
+
+
+def test_change_to_unknown_plan(service):
+    sub = service.subscribe("cus_1", "basic")
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")
+
+
+def test_change_to_retired_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "pro")

@@ -7,7 +7,9 @@ surfaces months later as a one-cent discrepancy on someone's invoice.
 
 from __future__ import annotations
 
+import math
 from decimal import ROUND_HALF_UP, Decimal
+from fractions import Fraction
 
 CENT = Decimal("0.01")
 ZERO = Decimal("0.00")
@@ -20,6 +22,18 @@ def to_money(value: Decimal | int | str) -> Decimal:
     return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)
 
 
+def prorate(amount: Decimal, part: int, whole: int) -> Decimal:
+    """``amount * part / whole`` computed exactly, then rounded to cents (half up).
+
+    Only the final result is rounded, so no precision is lost to a repeating
+    decimal such as 10 * 17 / 31.
+    """
+    if amount < 0 or part < 0 or whole <= 0:
+        raise ValueError("prorate needs a non-negative amount and part, and a positive whole")
+    cents = Fraction(amount) * part * 100 / whole
+    return to_money(Decimal(math.floor(cents + Fraction(1, 2))) / 100)
+
+
 def is_whole_cents(value: Decimal) -> bool:
     """True when ``value`` carries no precision below one cent."""
     return value == value.quantize(CENT, rounding=ROUND_HALF_UP)

+@pytest.mark.parametrize(
+    ("amount", "part", "whole", "expected"),
+    [
+        ("10.00", 26, 31, "8.39"),
+        ("10.00", 31, 31, "10.00"),
+        ("0.00", 5, 31, "0.00"),
+        ("0.10", 1, 4, "0.03"),  # exactly 0.025 rounds half up
+        ("100.00", 2, 365, "0.55"),
+    ],
+)
+def test_prorate(amount, part, whole, expected):
+    assert prorate(Decimal(amount), part, whole) == Decimal(expected)

@@ -0,0 +1,355 @@
+"""BillingService.change_plan — see SPEC.md (criterion numbers in brackets)."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    BillingError,
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.money import prorate
+from billing.plans import Interval, Plan
+from billing.subscriptions import ScheduledChange, SubscriptionStatus
+
+# conftest: clock starts 2026-01-15; basic 10/100, pro 30/300.
+# A monthly subscription started then runs 2026-01-15 .. 2026-02-15 (31 days).
+
+
+@pytest.fixture(autouse=True)
+def team_plan(store):
+    store.add_plan(Plan("team", "Team", Decimal("50.00"), Decimal("500.00")))
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def assert_untouched(store, sub, invoice_count, call):
+    with pytest.raises(BillingError) as raised:
+        call()
+    assert store.get_subscription(sub.id) == sub
+    assert len(store.invoices_for(sub.id)) == invoice_count
+    return raised.value
+
+
+# upgrades
+
+
+def test_upgrade_applies_now_and_keeps_period(service, store, clock):  # [1]
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "pro")
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "pro"
+    assert (changed.period_start, changed.period_end) == (sub.period_start, sub.period_end)
+    assert changed.scheduled_change is None
+
+
+def test_upgrade_invoice_credits_and_charges_remaining_days(service, store, clock):  # [2]
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))  # 26 of 31 days left
+    invoice = service.change_plan(sub.id, "pro")
+    assert invoice.issued_on == date(2026, 1, 20)
+    assert amounts(invoice) == [Decimal("-8.39"), Decimal("25.16")]  # 10*26/31, 30*26/31
+    assert invoice.total == Decimal("16.77")
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_upgrade_total_is_sum_of_rounded_lines(service, clock):  # [2]
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 12))  # 3 of 31 days left
+    invoice = service.change_plan(sub.id, "pro")
+    # 0.9677.. -> 0.97 and 2.9032.. -> 2.90; rounding the net 1.9354.. would give 1.94.
+    assert amounts(invoice) == [Decimal("-0.97"), Decimal("2.90")]
+    assert invoice.total == Decimal("1.93")
+
+
+def test_upgrade_on_annual_uses_annual_prices_and_calendar_days(service, clock):  # [2]
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)  # 365 days to 2027-01-15
+    clock.move_to(date(2027, 1, 13))  # 2 days left
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-0.55"), Decimal("1.64")]  # 100*2/365, 300*2/365
+    assert invoice.total == Decimal("1.09")  # the rounded net would be 1.10
+
+
+def test_upgrade_on_period_start_bills_whole_period(service):  # [3]
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_upgrade_counts_change_day_on_new_plan(service, clock):  # [3]
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 14))  # last day of the period: 1 day left
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-0.32"), Decimal("0.97")]  # 10/31, 30/31
+
+
+def test_next_renewal_after_upgrade_bills_full_new_price(service, store, clock):  # [4]
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+
+def test_upgrade_with_interval_switch_is_split(service, store, clock):  # [5]
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 20))
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-8.39"), Decimal("25.16")]  # monthly prices
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", Interval.MONTHLY)
+    assert changed.scheduled_change == ScheduledChange("pro", Interval.ANNUAL)
+
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()

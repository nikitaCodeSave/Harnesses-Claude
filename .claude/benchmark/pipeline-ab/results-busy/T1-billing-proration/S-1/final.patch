@@ -0,0 +1,378 @@
+"""BillingService.change_plan. Numbers in comments refer to SPEC.md criteria."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+import billing
+from billing.errors import (
+    BillingError,
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+# Fixture plans: basic 10.00 / 100.00, pro 30.00 / 300.00. Clock starts 2026-01-15, so a
+# monthly subscription's first period is 2026-01-15 to 2026-02-15 (31 days).
+
+
+@pytest.fixture
+def more_plans(store):
+    store.add_plan(Plan("max", "Max", Decimal("50.00"), Decimal("500.00")))
+    store.add_plan(Plan("team", "Team", Decimal("30.00"), Decimal("280.00")))  # same monthly as pro
+    store.add_plan(Plan("lite", "Lite", Decimal("35.00"), Decimal("290.00")))  # pricier monthly, cheaper annual than pro
+    return store
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def renew_on(service, clock, day):
+    clock.move_to(day)
+    return service.renew_due()
+
+
+# upgrades
+
+
+def test_upgrade_applies_now_and_keeps_period(service, store, clock):  # 1
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))
+    service.change_plan(sub.id, "pro")
+    changed = store.get_subscription(sub.id)
+    assert changed.plan_code == "pro"
+    assert changed.interval is Interval.MONTHLY
+    assert (changed.period_start, changed.period_end) == (date(2026, 1, 15), date(2026, 2, 15))
+    assert not changed.has_scheduled_change
+
+
+def test_upgrade_invoice_prorates_remaining_days(service, store, clock):  # 2, 3
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))  # 14 of 31 days remain
+    invoice = service.change_plan(sub.id, "pro")
+    assert invoice.issued_on == date(2026, 2, 1)
+    assert amounts(invoice) == [Decimal("-4.52"), Decimal("13.55")]
+    assert invoice.total == Decimal("9.03")
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_upgrade_total_is_sum_of_separately_rounded_lines(service, clock):  # 2
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 12))  # 3 of 31 days; rounding the net would give 1.94
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-0.97"), Decimal("2.90")]
+    assert invoice.total == Decimal("1.93")
+
+
+def test_upgrade_on_annual_prorates_over_real_calendar_days(service, clock):  # 2
+    sub = service.subscribe("cus_1", "basic", Interval.ANNUAL)  # 2026-01-15 to 2027-01-15, 365 days
+    clock.move_to(date(2027, 1, 13))  # 2 days remain
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-0.55"), Decimal("1.64")]
+    assert invoice.total == Decimal("1.09")
+
+
+def test_upgrade_on_period_start_swaps_full_prices(service):  # 4
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_renewal_after_upgrade_bills_new_plan_in_full(service, store, clock):  # 5
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))
+    service.change_plan(sub.id, "pro")
+    [invoice] = renew_on(service, clock, date(2026, 2, 15))
+    assert invoice.total == Decimal("30.00")
+    assert store.get_subscription(sub.id).period_end == date(2026, 3, 15)
+
+
+def test_upgrade_with_interval_switch_is_split(service, store, clock):  # 6
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 1))
+    invoice = service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-4.52"), Decimal("13.55")]  # monthly prices
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval) == ("pro", Interval.MONTHLY)
+
+    [renewal] = renew_on(service, clock, date(2026, 2, 15))
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("300.00")
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 2, 15), date(2027, 2, 15))
+    assert not renewed.has_scheduled_change
+
+
+def test_upgrade_netting_negative_is_still_issued(service, store, more_plans, clock):  # 7
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    invoice = service.change_plan(sub.id, "lite")  # 35 > 30 monthly, but 290 < 300 annual

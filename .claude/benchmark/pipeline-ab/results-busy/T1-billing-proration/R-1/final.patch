@@ -0,0 +1,134 @@
+"""SPEC criteria 17-20: interaction with an existing scheduled change."""
+
+from datetime import date
+
+import pytest
+
+from billing.plans import Interval
+
+from spec_support import assert_nothing_scheduled, assert_scheduled, invalid_plan_change, money
+
+MAR_1, MAR_5, MAR_11, APR_1, MAY_1 = (
+    date(2026, 3, 1), date(2026, 3, 5), date(2026, 3, 11), date(2026, 4, 1), date(2026, 5, 1),
+)
+
+
+def pro_monthly_with_scheduled(make_world, plan_code, interval=None):
+    """Monthly Pro from 2026-03-01 with a change scheduled on 2026-03-05."""
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(MAR_5)
+    assert world.service.change_plan(sub.id, plan_code, interval) is None
+    return world, sub
+
+
+# Criterion 17
+
+
+def test_c17_new_request_replaces_scheduled_change(make_world):
+    world, sub = pro_monthly_with_scheduled(make_world, "basic")
+    world.on(MAR_11)
+    assert world.service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert_scheduled(world.sub(sub.id), "pro", Interval.ANNUAL)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="pro", interval=Interval.ANNUAL, amount="300.00", period_end=date(2027, 4, 1),
+    )
+
+
+def test_c17_omitted_interval_means_current_interval_not_scheduled_one(make_world):
+    world, sub = pro_monthly_with_scheduled(make_world, "pro", Interval.ANNUAL)
+    world.on(MAR_11)
+    assert world.service.change_plan(sub.id, "basic") is None
+    assert_scheduled(world.sub(sub.id), "basic", Interval.MONTHLY)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.MONTHLY, amount="10.00", period_end=MAY_1,
+    )
+
+
+# Criterion 18
+
+
+def test_c18_upgrade_discards_scheduled_change(make_world):
+    world, sub = pro_monthly_with_scheduled(make_world, "basic", Interval.ANNUAL)
+    world.on(MAR_11)
+    world.service.change_plan(sub.id, "premium")
+    assert_nothing_scheduled(world.sub(sub.id))
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="premium", interval=Interval.MONTHLY, amount="75.00", period_end=MAY_1,
+    )
+
+
+def test_c18_upgrade_with_interval_switch_replaces_scheduled_change(make_world):
+    world, sub = pro_monthly_with_scheduled(make_world, "basic")
+    world.on(MAR_11)
+    invoice = world.service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    assert invoice.total == money("30.49")
+    assert_scheduled(world.sub(sub.id), "premium", Interval.ANNUAL)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="premium", interval=Interval.ANNUAL, amount="750.00",
+        period_end=date(2027, 4, 1),
+    )
+
+
+# Criterion 19
+
+
+def test_c19_proration_ignores_scheduled_change(make_world):
+    world, sub = pro_monthly_with_scheduled(make_world, "basic")
+    world.on(MAR_11)
+    invoice = world.service.change_plan(sub.id, "premium")
+    assert [line.amount for line in invoice.lines] == [money("-20.32"), money("50.81")]
+    assert invoice.total == money("30.49")
+    assert_nothing_scheduled(world.sub(sub.id))
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="premium", interval=Interval.MONTHLY, amount="75.00", period_end=MAY_1,
+    )
+
+
+def test_c19_upgrade_classification_ignores_scheduled_plan(make_world):
+    # Basic is scheduled; Studio has the same monthly price as the current plan
+    # Pro, so it is a downgrade (scheduled), even though it is above Basic.
+    world, sub = pro_monthly_with_scheduled(make_world, "basic")
+    world.on(MAR_11)
+    assert world.service.change_plan(sub.id, "studio") is None
+    assert world.sub(sub.id).plan_code == "pro"
+    assert_scheduled(world.sub(sub.id), "studio", Interval.MONTHLY)
+
+
+# Criterion 20
+
+
+@pytest.mark.parametrize(
+    "scheduled_plan, scheduled_interval",
+    [("basic", None), ("pro", Interval.ANNUAL), ("basic", Interval.ANNUAL)],
+    ids=["downgrade", "interval-only", "downgrade+interval"],
+)
+def test_c20_same_plan_same_interval_cancels_scheduled_change(make_world, scheduled_plan, scheduled_interval):
+    world, sub = pro_monthly_with_scheduled(make_world, scheduled_plan, scheduled_interval)
+    invoices_before = list(world.invoices(sub.id))
+    world.on(MAR_11)
+    assert world.service.change_plan(sub.id, "pro") is None
+    assert world.invoices(sub.id) == invoices_before
+    after = world.sub(sub.id)
+    assert (after.plan_code, after.interval) == ("pro", Interval.MONTHLY)
+    assert_nothing_scheduled(after)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="pro", interval=Interval.MONTHLY, amount="30.00", period_end=MAY_1,
+    )
+
+
+def test_c20_same_plan_same_interval_explicit_interval_also_cancels(make_world):
+    world, sub = pro_monthly_with_scheduled(make_world, "basic")
+    world.on(MAR_11)
+    assert world.service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert_nothing_scheduled(world.sub(sub.id))
+
+
+def test_c20_same_plan_same_interval_with_nothing_scheduled_raises(make_world):
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(MAR_11)
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, "pro")
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, "pro", Interval.MONTHLY)

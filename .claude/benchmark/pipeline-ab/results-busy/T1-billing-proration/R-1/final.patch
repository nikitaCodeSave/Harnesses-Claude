@@ -0,0 +1,295 @@
+"""SPEC criteria 24-30: rejected change requests."""
+
+from datetime import date
+
+import pytest
+
+from billing.errors import PlanNotAvailable, PlanNotFound, SubscriptionNotActive, SubscriptionNotFound
+from billing.plans import Interval
+
+from spec_support import assert_nothing_scheduled, assert_scheduled, invalid_plan_change, money
+
+MAR_1, MAR_5, MAR_11, APR_1, MAY_1 = (
+    date(2026, 3, 1), date(2026, 3, 5), date(2026, 3, 11), date(2026, 4, 1), date(2026, 5, 1),
+)
+
+
+def pro_monthly(make_world):
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(MAR_11)
+    return world, sub
+
+
+# Criterion 24
+
+
+def test_c24_unknown_subscription(make_world):
+    world = make_world(MAR_1)
+    with pytest.raises(SubscriptionNotFound):
+        world.service.change_plan("sub_missing", "premium")
+
+
+# Criterion 25
+
+
+@pytest.mark.parametrize("plan, interval", [("premium", None), ("basic", None), ("pro", Interval.ANNUAL)])
+def test_c25_canceled_subscription(make_world, plan, interval):
+    world, sub = pro_monthly(make_world)
+    world.service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        world.service.change_plan(sub.id, plan, interval)
+
+
+# Criterion 26
+
+
+@pytest.mark.parametrize("interval", [None, Interval.ANNUAL])
+def test_c26_unknown_target_plan(make_world, interval):
+    world, sub = pro_monthly(make_world)
+    with pytest.raises(PlanNotFound):
+        world.service.change_plan(sub.id, "gold", interval)
+
+
+# Criterion 27
+
+
+@pytest.mark.parametrize(
+    "retired, plan, interval",
+    [
+        ("premium", "premium", None),
+        ("premium", "premium", Interval.ANNUAL),
+        ("basic", "basic", None),
+        ("basic", "basic", Interval.ANNUAL),
+        ("studio", "studio", None),
+    ],
+    ids=["upgrade", "upgrade+interval", "downgrade", "downgrade+interval", "same-monthly-price"],
+)
+def test_c27_retired_target_plan(make_world, retired, plan, interval):
+    world, sub = pro_monthly(make_world)
+    world.store.retire_plan(retired)
+    with pytest.raises(PlanNotAvailable):
+        world.service.change_plan(sub.id, plan, interval)
+
+
+def test_c27_interval_only_switch_on_retired_current_plan(make_world):
+    world, sub = pro_monthly(make_world)
+    world.store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        world.service.change_plan(sub.id, "pro", Interval.ANNUAL)
+
+
+def test_c27_retired_target_plan_during_trial(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("basic", trial_days=14)
+    world.on(date(2026, 1, 20))
+    world.store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        world.service.change_plan(sub.id, "pro")
+
+
+# Criterion 28
+
+
+def test_c28_retired_plan_customer_can_upgrade_to_active_plan(make_world):
+    world, sub = pro_monthly(make_world)
+    world.store.retire_plan("pro")
+    invoice = world.service.change_plan(sub.id, "premium")
+    assert [line.amount for line in invoice.lines] == [money("-20.32"), money("50.81")]
+    assert invoice.total == money("30.49")
+    assert world.sub(sub.id).plan_code == "premium"
+
+
+def test_c28_retired_plan_customer_can_downgrade_to_active_plan(make_world):
+    world, sub = pro_monthly(make_world)
+    world.store.retire_plan("pro")
+    assert world.service.change_plan(sub.id, "basic") is None
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.MONTHLY, amount="10.00", period_end=MAY_1,
+    )
+
+
+def test_c28_retired_plan_customer_can_cancel_scheduled_change(make_world):
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(MAR_5)
+    world.service.change_plan(sub.id, "basic")
+    world.store.retire_plan("pro")
+    world.on(MAR_11)
+    assert world.service.change_plan(sub.id, "pro") is None
+    assert_nothing_scheduled(world.sub(sub.id))
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="pro", interval=Interval.MONTHLY, amount="30.00", period_end=MAY_1,
+    )
+
+
+def test_c28_retired_plan_same_plan_with_nothing_scheduled_raises_invalid_plan_change(make_world):
+    world, sub = pro_monthly(make_world)
+    world.store.retire_plan("pro")
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, "pro")
+
+
+# Criterion 29
+
+
+@pytest.mark.parametrize("day", [APR_1, date(2026, 4, 10)], ids=["on-period-end", "after-period-end"])
+@pytest.mark.parametrize(
+    "plan, interval",
+    [("premium", None), ("basic", None), ("pro", Interval.ANNUAL), ("premium", Interval.ANNUAL)],
+    ids=["upgrade", "downgrade", "interval-only", "upgrade+interval"],
+)
+def test_c29_active_request_on_or_after_period_end_before_renewal(make_world, day, plan, interval):
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(day)
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, plan, interval)
+
+
+def test_c29_request_after_renewal_is_accepted_again(make_world):
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(APR_1)
+    world.service.renew_due()
+    # New period 2026-04-01 -> 2026-05-01 (30 days), change on the first day: 30/30.
+    invoice = world.service.change_plan(sub.id, "premium")
+    assert [line.amount for line in invoice.lines] == [money("-30.00"), money("75.00")]
+
+
+@pytest.mark.parametrize("day", [date(2026, 1, 29), date(2026, 2, 3)], ids=["on-trial-end", "after-trial-end"])
+@pytest.mark.parametrize(
+    "plan, interval",
+    [("pro", None), ("basic", Interval.ANNUAL)],
+    ids=["upgrade", "interval-only"],
+)
+def test_c29_trialing_request_on_or_after_trial_end_before_renewal(make_world, day, plan, interval):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("basic", trial_days=14)
+    world.on(day)
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, plan, interval)
+
+
+# Criterion 30
+
+
+def _scheduled_basic(make_world):
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(MAR_5)
+    world.service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    return world, sub
+
+
+def reject_unknown_plan(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.on(MAR_11)
+    return world, sub, lambda: world.service.change_plan(sub.id, "gold"), PlanNotFound
+
+
+def reject_retired_upgrade(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.store.retire_plan("premium")
+    world.on(MAR_11)
+    return world, sub, lambda: world.service.change_plan(sub.id, "premium"), PlanNotAvailable
+
+
+def reject_retired_interval_switch(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.store.retire_plan("pro")
+    world.on(MAR_11)
+    return world, sub, lambda: world.service.change_plan(sub.id, "pro", Interval.ANNUAL), PlanNotAvailable
+
+
+def reject_overdue_upgrade(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.on(APR_1)
+    return world, sub, lambda: world.service.change_plan(sub.id, "premium"), invalid_plan_change()
+
+
+def reject_overdue_downgrade(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.on(APR_1)
+    return world, sub, lambda: world.service.change_plan(sub.id, "studio"), invalid_plan_change()
+
+
+def reject_canceled(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.service.cancel(sub.id)
+    world.on(MAR_11)
+    return world, sub, lambda: world.service.change_plan(sub.id, "premium"), SubscriptionNotActive
+
+
+def reject_same_plan_nothing_scheduled(make_world):
+    world, sub = pro_monthly(make_world)
+    return world, sub, lambda: world.service.change_plan(sub.id, "pro"), invalid_plan_change()
+
+
+def reject_trial_same_plan(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("basic", trial_days=14)
+    world.on(date(2026, 1, 20))
+    return world, sub, lambda: world.service.change_plan(sub.id, "basic"), invalid_plan_change()
+
+
+def reject_trial_overdue(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("basic", trial_days=14)
+    world.on(date(2026, 1, 29))
+    return world, sub, lambda: world.service.change_plan(sub.id, "pro", Interval.ANNUAL), invalid_plan_change()
+
+
+def reject_trial_retired_target(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("basic", trial_days=14)
+    world.store.retire_plan("pro")
+    world.on(date(2026, 1, 20))
+    return world, sub, lambda: world.service.change_plan(sub.id, "pro"), PlanNotAvailable
+
+
+REJECTIONS = [
+    reject_unknown_plan,
+    reject_retired_upgrade,
+    reject_retired_interval_switch,
+    reject_overdue_upgrade,
+    reject_overdue_downgrade,
+    reject_canceled,
+    reject_same_plan_nothing_scheduled,
+    reject_trial_same_plan,
+    reject_trial_overdue,
+    reject_trial_retired_target,
+]
+
+
+@pytest.mark.parametrize("scenario", REJECTIONS, ids=[s.__name__.removeprefix("reject_") for s in REJECTIONS])
+def test_c30_rejected_request_changes_nothing(make_world, scenario):
+    world, sub, request, error = scenario(make_world)
+    subscription_before = world.sub(sub.id)
+    invoices_before = list(world.invoices(sub.id))
+    with pytest.raises(error):
+        request()
+    assert world.sub(sub.id) == subscription_before
+    assert world.invoices(sub.id) == invoices_before
+
+
+def test_c30_scheduled_change_survives_rejected_request_and_still_applies(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.store.retire_plan("premium")
+    world.on(MAR_11)
+    with pytest.raises(PlanNotAvailable):
+        world.service.change_plan(sub.id, "premium")
+    assert_scheduled(world.sub(sub.id), "basic", Interval.ANNUAL)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.ANNUAL, amount="100.00", period_end=date(2027, 4, 1),
+    )
+
+
+def test_c30_overdue_rejection_leaves_scheduled_change_for_the_renewal(make_world):
+    world, sub = _scheduled_basic(make_world)
+    world.on(APR_1)
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, "premium")
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.ANNUAL, amount="100.00", period_end=date(2027, 4, 1),
+    )

--- /dev/null
+++ b/tests/acceptance/spec_support.py
@@ -0,0 +1,160 @@
+"""Shared setup for the SPEC.md "Mid-cycle plan changes" acceptance tests.
+
+Everything here goes through the public interface only: ``BillingService``
+(``subscribe``, ``renew_due``, ``cancel``, ``change_plan``), ``InMemoryStore``
+and the domain objects. Expected values come from SPEC.md.
+
+``InvalidPlanChange`` is looked up when a test runs rather than imported at
+module level, so that a missing class fails the tests that need it instead of
+breaking collection of the whole suite.
+"""
+
+from dataclasses import fields, is_dataclass
+from datetime import date
+from decimal import Decimal
+
+import billing.errors
+from billing.clock import FixedClock
+from billing.invoices import Invoice
+from billing.plans import Interval, Plan
+from billing.service import BillingService
+from billing.store import InMemoryStore
+from billing.subscriptions import Subscription, SubscriptionStatus
+
+# The fixture plans from tests/conftest.py plus the plans SPEC.md adds.
+SPEC_PLANS = (
+    Plan("basic", "Basic", Decimal("10.00"), Decimal("100.00")),
+    Plan("pro", "Pro", Decimal("30.00"), Decimal("300.00")),
+    Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")),
+    Plan("team", "Team", Decimal("35.00"), Decimal("280.00")),
+    Plan("studio", "Studio", Decimal("30.00"), Decimal("280.00")),
+)
+
+# The fields Subscription had before the feature. Anything else on a saved
+# Subscription is how the implementation records the scheduled change (SPEC 15).
+ORIGINAL_SUBSCRIPTION_FIELDS = frozenset(
+    {"id", "customer_id", "plan_code", "interval", "status", "period_start", "period_end", "canceled_on"}
+)
+
+
+def invalid_plan_change() -> type[Exception]:
+    return billing.errors.InvalidPlanChange
+
+
+def money(value: str) -> Decimal:
+    return Decimal(value)
+
+
+class World:
+    """One store, one clock, one service, starting on ``today``."""
+
+    def __init__(self, today: date) -> None:
+        self.clock = FixedClock(today)
+        self.store = InMemoryStore()
+        for plan in SPEC_PLANS:
+            self.store.add_plan(plan)
+        self.service = BillingService(self.store, self.clock)
+
+    # setup
+
+    def add_plan(self, code: str, monthly: str, annual: str) -> None:
+        self.store.add_plan(Plan(code, code.title(), Decimal(monthly), Decimal(annual)))
+
+    def subscribe(
+        self,
+        plan_code: str,
+        interval: Interval = Interval.MONTHLY,
+        *,
+        trial_days: int = 0,
+        customer_id: str = "cus_1",
+    ) -> Subscription:
+        return self.service.subscribe(customer_id, plan_code, interval, trial_days=trial_days)
+
+    def on(self, day: date) -> None:
+        self.clock.move_to(day)
+
+    # reading state
+
+    def sub(self, subscription_id: str) -> Subscription:
+        return self.store.get_subscription(subscription_id)
+
+    def invoices(self, subscription_id: str) -> list[Invoice]:
+        return self.store.invoices_for(subscription_id)
+
+    # assertions
+
+    def assert_renewal(
+        self,
+        subscription_id: str,
+        *,
+        on: date,
+        plan_code: str,
+        interval: Interval,
+        amount: str,
+        period_end: date,
+    ) -> Invoice:
+        """Move to ``on``, run ``renew_due`` and check exactly one renewal of
+        ``subscription_id`` that bills ``amount`` for ``[on, period_end)``."""
+        self.on(on)
+        issued = [inv for inv in self.service.renew_due() if inv.subscription_id == subscription_id]
+        assert len(issued) == 1, f"expected one renewal invoice on {on}, got {issued}"
+        [invoice] = issued
+        assert invoice.issued_on == on
+        assert invoice.total == Decimal(amount)
+        renewed = self.sub(subscription_id)
+        assert renewed.status is SubscriptionStatus.ACTIVE
+        assert (renewed.plan_code, renewed.interval) == (plan_code, interval)
+        assert (renewed.period_start, renewed.period_end) == (on, period_end)
+        return invoice
+
+
+def schedule_state(subscription: Subscription) -> dict[str, object]:
+    """Whatever the saved Subscription carries beyond its original fields."""
+    return {
+        f.name: getattr(subscription, f.name)
+        for f in fields(subscription)
+        if f.name not in ORIGINAL_SUBSCRIPTION_FIELDS
+    }
+
+
+def _atoms(value: object):
+    if is_dataclass(value) and not isinstance(value, type):
+        for f in fields(value):
+            yield from _atoms(getattr(value, f.name))
+    elif isinstance(value, dict):
+        for k, v in value.items():
+            yield from _atoms(k)
+            yield from _atoms(v)
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        for item in value:
+            yield from _atoms(item)
+    else:
+        yield value
+
+
+def assert_scheduled(subscription: Subscription, plan_code: str, interval: Interval) -> None:
+    """SPEC 15: the scheduled target can be read from the saved Subscription."""
+    atoms = list(_atoms(schedule_state(subscription)))
+    assert plan_code in atoms, f"scheduled plan {plan_code!r} not found on {subscription}"
+    assert interval in atoms or interval.value in atoms, (
+        f"scheduled interval {interval} not found on {subscription}"
+    )
+
+
+def assert_nothing_scheduled(subscription: Subscription) -> None:
+    """SPEC 15: the subscription shows that nothing is scheduled.
+
+    "Nothing scheduled" must look the same as on a subscription built with only
+    its original fields, i.e. one that never had a change requested.
+    """
+    pristine = Subscription(
+        id=subscription.id,
+        customer_id=subscription.customer_id,
+        plan_code=subscription.plan_code,
+        interval=subscription.interval,
+        status=subscription.status,
+        period_start=subscription.period_start,
+        period_end=subscription.period_end,
+        canceled_on=subscription.canceled_on,
+    )
+    assert schedule_state(subscription) == schedule_state(pristine)

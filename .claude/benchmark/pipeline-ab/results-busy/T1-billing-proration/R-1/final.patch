+"""SPEC criteria 21-23: plan changes during a trial."""
+
+from datetime import date
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+from spec_support import assert_nothing_scheduled, invalid_plan_change
+
+TRIAL_START, CHANGE_DAY, TRIAL_END = date(2026, 1, 15), date(2026, 1, 20), date(2026, 1, 29)
+
+
+def trial(make_world, plan_code="basic", interval=Interval.MONTHLY):
+    """A 14-day trial from 2026-01-15 to 2026-01-29, observed on 2026-01-20."""
+    world = make_world(TRIAL_START)
+    sub = world.subscribe(plan_code, interval, trial_days=14)
+    world.on(CHANGE_DAY)
+    return world, sub
+
+
+# Criterion 21
+
+TRIAL_CHANGES = [
+    # id, from plan, from interval, request plan, request interval, expected plan, expected interval
+    ("upgrade", "basic", Interval.MONTHLY, "pro", None, "pro", Interval.MONTHLY),
+    ("downgrade", "pro", Interval.MONTHLY, "basic", None, "basic", Interval.MONTHLY),
+    ("same-monthly-price", "pro", Interval.MONTHLY, "studio", None, "studio", Interval.MONTHLY),
+    ("interval-to-annual", "basic", Interval.MONTHLY, "basic", Interval.ANNUAL, "basic", Interval.ANNUAL),
+    ("interval-to-monthly", "pro", Interval.ANNUAL, "pro", Interval.MONTHLY, "pro", Interval.MONTHLY),
+    ("upgrade+interval", "basic", Interval.MONTHLY, "pro", Interval.ANNUAL, "pro", Interval.ANNUAL),
+    ("downgrade+interval", "pro", Interval.ANNUAL, "basic", Interval.MONTHLY, "basic", Interval.MONTHLY),
+    ("keep-annual-on-upgrade", "basic", Interval.ANNUAL, "premium", None, "premium", Interval.ANNUAL),
+]
+
+
+@pytest.mark.parametrize(
+    "from_plan, from_interval, plan, interval, expected_plan, expected_interval",
+    [c[1:] for c in TRIAL_CHANGES],
+    ids=[c[0] for c in TRIAL_CHANGES],
+)
+def test_c21_trial_change_applies_immediately_without_billing(
+    make_world, from_plan, from_interval, plan, interval, expected_plan, expected_interval
+):
+    world, sub = trial(make_world, from_plan, from_interval)
+    result = world.service.change_plan(sub.id, plan, interval)
+    assert result is None
+    assert world.invoices(sub.id) == []
+    after = world.sub(sub.id)
+    assert (after.plan_code, after.interval) == (expected_plan, expected_interval)
+    assert after.status is SubscriptionStatus.TRIALING
+    assert (after.period_start, after.period_end) == (TRIAL_START, TRIAL_END)
+    assert_nothing_scheduled(after)
+
+
+# Criterion 22
+
+
+def test_c22_first_paid_period_bills_plan_chosen_during_trial(make_world):
+    world, sub = trial(make_world, "basic", Interval.MONTHLY)
+    world.service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    world.assert_renewal(
+        sub.id, on=TRIAL_END, plan_code="pro", interval=Interval.ANNUAL, amount="300.00",
+        period_end=date(2027, 1, 29),
+    )
+
+
+def test_c22_first_paid_period_after_trial_downgrade(make_world):
+    world, sub = trial(make_world, "pro", Interval.MONTHLY)
+    world.service.change_plan(sub.id, "basic")
+    world.assert_renewal(
+        sub.id, on=TRIAL_END, plan_code="basic", interval=Interval.MONTHLY, amount="10.00",
+        period_end=date(2026, 2, 28),
+    )
+
+
+# Criterion 23
+
+
+def test_c23_trial_same_plan_same_interval_raises(make_world):
+    world, sub = trial(make_world, "basic", Interval.MONTHLY)
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, "basic")
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, "basic", Interval.MONTHLY)
+
+
+def test_c23_trial_back_to_original_plan_after_a_change_raises_when_already_on_it(make_world):
+    # After a trial change the "current plan" is the new one; asking for it again is invalid.
+    world, sub = trial(make_world, "basic", Interval.MONTHLY)
+    world.service.change_plan(sub.id, "pro")
+    with pytest.raises(invalid_plan_change()):
+        world.service.change_plan(sub.id, "pro")

+        During a trial the change applies in full immediately, unbilled.
+        Otherwise an upgrade (higher monthly price) applies now on the current
+        interval and is prorated on one invoice, which is returned; any
+        interval switch that comes with it is scheduled. Every other change
+        is scheduled for the next renewal and returns ``None``. A request for
+        the current plan and interval cancels the scheduled change.
+        """
+        subscription = self._store.get_subscription(subscription_id)
+        if subscription.is_canceled:
+            raise SubscriptionNotActive(subscription_id)
+        target = self._store.get_plan(new_plan_code)
+        target_interval = new_interval or subscription.interval
+        today = self._clock.today()
+        if today >= subscription.period_end:
+            raise InvalidPlanChange(f"{subscription_id}: period ended on {subscription.period_end}, renewal pending")

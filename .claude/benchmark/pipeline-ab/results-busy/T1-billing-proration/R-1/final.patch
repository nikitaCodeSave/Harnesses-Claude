+"""SPEC criteria 8-16: changes that wait for the period end (ACTIVE subscriptions)."""
+
+from datetime import date
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+from spec_support import assert_nothing_scheduled, assert_scheduled, money
+
+MAR_1, MAR_11, APR_1, MAY_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1), date(2026, 5, 1)
+
+
+def assert_unchanged_and_unbilled(world, sub, result):
+    assert result is None
+    after = world.sub(sub.id)
+    assert after.plan_code == sub.plan_code
+    assert after.interval is sub.interval
+    assert (after.period_start, after.period_end) == (sub.period_start, sub.period_end)
+    assert after.status is SubscriptionStatus.ACTIVE
+    assert world.invoices(sub.id) == world.invoices_before
+
+
+def pro_monthly(make_world):
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    world.on(MAR_11)
+    world.invoices_before = list(world.invoices(sub.id))
+    return world, sub
+
+
+def pro_annual(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("pro", Interval.ANNUAL)
+    world.on(date(2026, 7, 15))
+    world.invoices_before = list(world.invoices(sub.id))
+    return world, sub
+
+
+# Criterion 8
+
+
+@pytest.mark.parametrize("target", ["basic", "studio"], ids=["lower-price", "same-monthly-price"])
+def test_c08_downgrade_is_scheduled_without_changing_or_billing(make_world, target):
+    world, sub = pro_monthly(make_world)
+    result = world.service.change_plan(sub.id, target)
+    assert_unchanged_and_unbilled(world, sub, result)
+
+
+def test_c08_downgrade_to_equal_monthly_price_takes_effect_at_renewal(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "studio")
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="studio", interval=Interval.MONTHLY, amount="30.00", period_end=MAY_1,
+    )
+
+
+def test_c08_downgrade_on_annual_is_scheduled(make_world):
+    world, sub = pro_annual(make_world)
+    result = world.service.change_plan(sub.id, "basic")
+    assert_unchanged_and_unbilled(world, sub, result)
+
+
+# Criterion 9
+
+
+def test_c09_monthly_to_annual_switch_is_scheduled(make_world):
+    world, sub = pro_monthly(make_world)
+    result = world.service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    assert_unchanged_and_unbilled(world, sub, result)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="pro", interval=Interval.ANNUAL, amount="300.00", period_end=date(2027, 4, 1),
+    )
+
+
+def test_c09_annual_to_monthly_switch_is_scheduled(make_world):
+    world, sub = pro_annual(make_world)
+    result = world.service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    assert_unchanged_and_unbilled(world, sub, result)
+
+
+# Criterion 10
+
+
+def test_c10_downgrade_with_interval_switch_is_scheduled_as_a_whole(make_world):
+    world, sub = pro_monthly(make_world)
+    result = world.service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    assert_unchanged_and_unbilled(world, sub, result)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.ANNUAL, amount="100.00", period_end=date(2027, 4, 1),
+    )
+
+
+# Criterion 11
+
+
+def test_c11_upgrade_with_interval_switch_prorates_now_at_current_interval(make_world):
+    world, sub = pro_monthly(make_world)
+    invoice = world.service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    assert [line.amount for line in invoice.lines] == [money("-20.32"), money("50.81")]
+    assert invoice.total == money("30.49")
+    assert invoice.issued_on == MAR_11
+    assert world.invoices(sub.id) == world.invoices_before + [invoice]
+
+
+def test_c11_upgrade_with_interval_switch_leaves_target_plan_on_current_interval(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    after = world.sub(sub.id)
+    assert (after.plan_code, after.interval) == ("premium", Interval.MONTHLY)
+    assert (after.period_start, after.period_end) == (MAR_1, APR_1)
+    assert after.status is SubscriptionStatus.ACTIVE
+
+
+def test_c11_upgrade_with_interval_switch_schedules_the_interval(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "premium", Interval.ANNUAL)
+    assert_scheduled(world.sub(sub.id), "premium", Interval.ANNUAL)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="premium", interval=Interval.ANNUAL, amount="750.00",
+        period_end=date(2027, 4, 1),
+    )
+
+
+# Criterion 12
+
+
+def test_c12_scheduled_change_takes_effect_at_renewal(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "basic")
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.MONTHLY, amount="10.00", period_end=MAY_1,
+    )
+
+
+def test_c12_nothing_is_scheduled_after_the_renewal(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.ANNUAL, amount="100.00", period_end=date(2027, 4, 1),
+    )
+    assert_nothing_scheduled(world.sub(sub.id))
+    # The following renewal is an ordinary one on the changed plan.
+    world.assert_renewal(
+        sub.id, on=date(2027, 4, 1), plan_code="basic", interval=Interval.ANNUAL, amount="100.00",
+        period_end=date(2028, 4, 1),
+    )
+
+
+def test_c12_annual_scheduled_switch_new_period_length_follows_scheduled_interval(make_world):
+    world, sub = pro_annual(make_world)
+    world.service.change_plan(sub.id, "basic", Interval.MONTHLY)
+    world.assert_renewal(
+        sub.id, on=date(2027, 1, 15), plan_code="basic", interval=Interval.MONTHLY, amount="10.00",
+        period_end=date(2027, 2, 15),
+    )
+
+
+# Criterion 13
+
+
+def test_c13_catch_up_applies_scheduled_change_from_first_missed_period(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "basic")
+    world.on(date(2026, 6, 15))
+    issued = [inv for inv in world.service.renew_due() if inv.subscription_id == sub.id]
+    assert [(inv.issued_on, inv.total) for inv in issued] == [
+        (date(2026, 4, 1), money("10.00")),
+        (date(2026, 5, 1), money("10.00")),
+        (date(2026, 6, 1), money("10.00")),
+    ]
+    after = world.sub(sub.id)
+    assert (after.plan_code, after.interval) == ("basic", Interval.MONTHLY)
+    assert (after.period_start, after.period_end) == (date(2026, 6, 1), date(2026, 7, 1))
+    assert_nothing_scheduled(after)
+
+
+def test_c13_catch_up_continues_on_changed_interval(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    world.on(date(2027, 5, 1))
+    issued = [inv for inv in world.service.renew_due() if inv.subscription_id == sub.id]
+    assert [(inv.issued_on, inv.total) for inv in issued] == [
+        (date(2026, 4, 1), money("100.00")),
+        (date(2027, 4, 1), money("100.00")),
+    ]
+    after = world.sub(sub.id)
+    assert (after.plan_code, after.interval) == ("basic", Interval.ANNUAL)
+    assert (after.period_start, after.period_end) == (date(2027, 4, 1), date(2028, 4, 1))
+
+
+# Criterion 14
+
+
+def test_c14_scheduled_change_survives_target_plan_retirement(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "basic")
+    world.store.retire_plan("basic")
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="basic", interval=Interval.MONTHLY, amount="10.00", period_end=MAY_1,
+    )
+
+
+# Criterion 15
+
+
+@pytest.mark.parametrize(
+    "target, interval",
+    [("basic", None), ("basic", Interval.ANNUAL), ("pro", Interval.ANNUAL), ("studio", None)],
+    ids=["downgrade", "downgrade+interval", "interval-only", "same-monthly-price"],
+)
+def test_c15_scheduled_target_is_readable_from_saved_subscription(make_world, target, interval):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, target, interval)
+    assert_scheduled(world.sub(sub.id), target, interval or Interval.MONTHLY)
+
+
+def test_c15_never_changed_subscription_shows_nothing_scheduled(make_world):
+    world, sub = pro_monthly(make_world)
+    assert_nothing_scheduled(world.sub(sub.id))
+
+
+def test_c15_scheduled_state_differs_from_nothing_scheduled(make_world):
+    world, sub = pro_monthly(make_world)
+    world.service.change_plan(sub.id, "basic")
+    with pytest.raises(AssertionError):
+        assert_nothing_scheduled(world.sub(sub.id))
+
+
+# Criterion 16
+
+
+def test_c16_annual_to_monthly_waits_for_end_of_annual_period_without_refund(make_world):
+    world, sub = pro_annual(make_world)
+    result = world.service.change_plan(sub.id, "pro", Interval.MONTHLY)
+    assert_unchanged_and_unbilled(world, sub, result)
+    # Nothing happens before the annual period ends.
+    world.on(date(2027, 1, 14))
+    assert [inv for inv in world.service.renew_due() if inv.subscription_id == sub.id] == []
+    world.assert_renewal(
+        sub.id, on=date(2027, 1, 15), plan_code="pro", interval=Interval.MONTHLY, amount="30.00",
+        period_end=date(2027, 2, 15),
+    )
+    assert all(inv.total >= 0 for inv in world.invoices(sub.id))

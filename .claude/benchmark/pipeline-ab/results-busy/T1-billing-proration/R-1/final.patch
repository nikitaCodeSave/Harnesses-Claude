+"""SPEC criteria 1-7: upgrades on a paid (ACTIVE) subscription."""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+
+from spec_support import assert_nothing_scheduled, money
+
+MAR_1, MAR_11, APR_1 = date(2026, 3, 1), date(2026, 3, 11), date(2026, 4, 1)
+
+
+@pytest.fixture
+def pro_monthly(make_world):
+    """Monthly Pro, period 2026-03-01 -> 2026-04-01 (31 days)."""
+    world = make_world(MAR_1)
+    sub = world.subscribe("pro")
+    return world, sub
+
+
+# Criterion 1
+
+
+def test_c01_upgrade_switches_plan_immediately(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    world.service.change_plan(sub.id, "premium")
+    after = world.sub(sub.id)
+    assert after.plan_code == "premium"
+
+
+def test_c01_upgrade_keeps_period_interval_and_status(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    world.service.change_plan(sub.id, "premium")
+    after = world.sub(sub.id)
+    assert after.period_start == MAR_1
+    assert after.period_end == APR_1
+    assert after.interval is Interval.MONTHLY
+    assert after.status is SubscriptionStatus.ACTIVE
+
+
+# Criterion 2
+
+
+def test_c02_upgrade_issues_and_returns_exactly_one_recorded_invoice(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    before = list(world.invoices(sub.id))
+    invoice = world.service.change_plan(sub.id, "premium")
+    after = world.invoices(sub.id)
+    assert invoice is not None
+    assert len(after) == len(before) + 1
+    assert after[-1] == invoice
+    assert invoice in after
+
+
+def test_c02_upgrade_invoice_header_fields(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    invoice = world.service.change_plan(sub.id, "premium")
+    assert invoice.issued_on == MAR_11
+    assert invoice.subscription_id == sub.id
+    assert invoice.customer_id == sub.customer_id
+
+
+def test_c02_upgrade_invoice_has_credit_line_then_charge_line(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    invoice = world.service.change_plan(sub.id, "premium")
+    assert len(invoice.lines) == 2
+    credit, charge = invoice.lines
+    assert credit.amount < 0
+    assert charge.amount > 0
+
+
+def test_c02_accepts_keyword_arguments_from_the_fixed_interface(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    invoice = world.service.change_plan(subscription_id=sub.id, new_plan_code="premium", new_interval=None)
+    assert invoice.total == money("30.49")
+
+
+# Criteria 3 and 4: worked examples
+
+
+WORKED_EXAMPLES = [
+    # id, current plan, interval, subscribe on (period start), target, change on, credit, charge, total
+    ("pro-premium-mid-month", "pro", Interval.MONTHLY, date(2026, 3, 1), "premium", date(2026, 3, 11),
+     "-20.32", "50.81", "30.49"),
+    ("pro-premium-on-period-start", "pro", Interval.MONTHLY, date(2026, 3, 1), "premium", date(2026, 3, 1),
+     "-30.00", "75.00", "45.00"),
+    ("pro-premium-last-day", "pro", Interval.MONTHLY, date(2026, 3, 1), "premium", date(2026, 3, 31),
+     "-0.97", "2.42", "1.45"),
+    ("basic-pro-february", "basic", Interval.MONTHLY, date(2026, 2, 1), "pro", date(2026, 2, 15),
+     "-5.00", "15.00", "10.00"),
+    ("pro-premium-annual", "pro", Interval.ANNUAL, date(2026, 1, 15), "premium", date(2026, 7, 15),
+     "-151.23", "378.08", "226.85"),
+    ("pro-premium-annual-leap", "pro", Interval.ANNUAL, date(2028, 1, 15), "premium", date(2028, 7, 15),
+     "-150.82", "377.05", "226.23"),
+    ("pro-team-annual", "pro", Interval.ANNUAL, date(2026, 1, 15), "team", date(2026, 7, 15),
+     "-151.23", "141.15", "-10.08"),
+]
+
+
+@pytest.mark.parametrize(
+    "current, interval, start, target, change_on, credit, charge, total",
+    [example[1:] for example in WORKED_EXAMPLES],
+    ids=[example[0] for example in WORKED_EXAMPLES],
+)
+def test_c04_worked_examples(make_world, current, interval, start, target, change_on, credit, charge, total):
+    world = make_world(start)
+    sub = world.subscribe(current, interval)
+    world.on(change_on)
+    invoice = world.service.change_plan(sub.id, target)
+    assert [line.amount for line in invoice.lines] == [money(credit), money(charge)]
+    assert invoice.total == money(total)
+
+
+def test_c03_no_rounded_daily_rate(pro_monthly):
+    # Rounding Pro to 0.97 a day would give a credit of -20.37 (SPEC 4).
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    credit, _ = world.service.change_plan(sub.id, "premium").lines
+    assert credit.amount == money("-20.32")
+    assert credit.amount != money("-20.37")
+
+
+def test_c03_total_is_sum_of_rounded_lines(pro_monthly):
+    # Unrounded: 50.80645... - 20.32258... = 30.48387... -> 30.48 if the total
+    # were rounded once; the spec's total is the sum of rounded lines, 30.49.
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    invoice = world.service.change_plan(sub.id, "premium")
+    assert invoice.total == sum((line.amount for line in invoice.lines), Decimal("0.00"))
+    assert invoice.total == money("30.49")
+
+
+def test_c03_each_line_rounds_half_up(make_world):
+    # Period 2026-02-01 -> 2026-03-01 (28 days), change on 2026-02-15: 14/28.
+    # Charge 0.25 x 14/28 = 0.125 exactly -> 0.13 half up (half-even would give 0.12).
+    # Credit 0.10 x 14/28 = 0.05.
+    world = make_world(date(2026, 2, 1))
+    world.add_plan("dime", "0.10", "1.00")
+    world.add_plan("quarter", "0.25", "2.50")
+    sub = world.subscribe("dime")
+    world.on(date(2026, 2, 15))
+    invoice = world.service.change_plan(sub.id, "quarter")
+    assert [line.amount for line in invoice.lines] == [money("-0.05"), money("0.13")]
+    assert invoice.total == money("0.08")
+
+
+def test_c03_line_amounts_are_decimal_whole_cents(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    invoice = world.service.change_plan(sub.id, "premium")
+    for line in invoice.lines:
+        assert isinstance(line.amount, Decimal)
+        assert line.amount.as_tuple().exponent == -2
+
+
+# Criterion 5
+
+
+def test_c05_upgrade_classified_by_monthly_price_even_if_annual_price_is_lower(make_world):
+    # Team is 35.00 monthly (> Pro 30.00) but 280.00 annual (< Pro 300.00).
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("pro", Interval.ANNUAL)
+    world.on(date(2026, 7, 15))
+    invoice = world.service.change_plan(sub.id, "team")
+    after = world.sub(sub.id)
+    assert invoice is not None
+    assert after.plan_code == "team"
+    assert after.interval is Interval.ANNUAL
+    assert (after.period_start, after.period_end) == (date(2026, 1, 15), date(2027, 1, 15))
+
+
+def test_c05_negative_total_upgrade_invoice_is_issued_and_recorded(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("pro", Interval.ANNUAL)
+    world.on(date(2026, 7, 15))
+    invoice = world.service.change_plan(sub.id, "team")
+    assert invoice.total == money("-10.08")
+    assert world.invoices(sub.id)[-1] == invoice
+
+
+def test_c05_zero_total_upgrade_invoice_is_issued_and_recorded(make_world):
+    # Same annual price as Pro, higher monthly price: an upgrade whose lines cancel out.
+    world = make_world(date(2026, 1, 15))
+    world.add_plan("proplus", "31.00", "300.00")
+    sub = world.subscribe("pro", Interval.ANNUAL)
+    world.on(date(2026, 7, 15))
+    invoice = world.service.change_plan(sub.id, "proplus")
+    assert invoice is not None
+    assert [line.amount for line in invoice.lines] == [money("-151.23"), money("151.23")]
+    assert invoice.total == money("0.00")
+    assert world.invoices(sub.id)[-1] == invoice
+    assert world.sub(sub.id).plan_code == "proplus"
+
+
+# Criterion 6
+
+
+def test_c06_upgrade_from_free_plan_has_zero_credit_line(make_world):
+    world = make_world(MAR_1)
+    world.add_plan("free", "0.00", "0.00")
+    sub = world.subscribe("free")
+    world.on(MAR_11)
+    invoice = world.service.change_plan(sub.id, "basic")
+    assert len(invoice.lines) == 2
+    credit, charge = invoice.lines
+    assert credit.amount == money("0.00")
+    # 10.00 x 21/31 = 6.774... -> 6.77
+    assert charge.amount == money("6.77")
+    assert invoice.total == money("6.77")
+
+
+# Criterion 7
+
+
+def test_c07_next_renewal_bills_new_plan_full_price_monthly(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    world.service.change_plan(sub.id, "premium")
+    world.assert_renewal(
+        sub.id, on=APR_1, plan_code="premium", interval=Interval.MONTHLY, amount="75.00",
+        period_end=date(2026, 5, 1),
+    )
+
+
+def test_c07_next_renewal_bills_new_plan_full_price_annual(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("pro", Interval.ANNUAL)
+    world.on(date(2026, 7, 15))
+    world.service.change_plan(sub.id, "premium")
+    world.assert_renewal(
+        sub.id, on=date(2027, 1, 15), plan_code="premium", interval=Interval.ANNUAL, amount="750.00",
+        period_end=date(2028, 1, 15),
+    )
+
+
+def test_c07_plain_upgrade_leaves_nothing_scheduled(pro_monthly):
+    world, sub = pro_monthly
+    world.on(MAR_11)
+    world.service.change_plan(sub.id, "premium")
+    assert_nothing_scheduled(world.sub(sub.id))

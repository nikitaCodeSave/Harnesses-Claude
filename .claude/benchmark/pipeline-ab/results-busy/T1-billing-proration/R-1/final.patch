@@ -0,0 +1,166 @@
+"""SPEC criteria 31-33: package hygiene."""
+
+import dataclasses
+import re
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+import billing
+import billing.errors
+from billing.invoices import Invoice
+from billing.plans import Interval
+from billing.subscriptions import Subscription, SubscriptionStatus
+
+from spec_support import money
+
+SRC = Path(billing.__file__).resolve().parent
+
+
+# Criterion 31
+
+
+def test_c31_invalid_plan_change_lives_in_errors_module():
+    cls = billing.errors.InvalidPlanChange
+    assert cls.__module__ == "billing.errors"
+
+
+def test_c31_invalid_plan_change_subclasses_billing_error():
+    assert issubclass(billing.errors.InvalidPlanChange, billing.errors.BillingError)
+
+
+def test_c31_invalid_plan_change_exported_from_package():
+    assert billing.InvalidPlanChange is billing.errors.InvalidPlanChange
+    assert "InvalidPlanChange" in billing.__all__
+
+
+# Criterion 32
+
+
+def test_c32_change_amounts_are_decimal_whole_cents(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("pro", Interval.ANNUAL)
+    world.on(date(2026, 7, 15))
+    invoice = world.service.change_plan(sub.id, "premium")
+    for amount in [line.amount for line in invoice.lines] + [invoice.total]:
+        assert isinstance(amount, Decimal)
+        assert amount.as_tuple().exponent == -2
+
+
+SYSTEM_CLOCK_CALLS = re.compile(
+    r"\b(?:date|datetime)\.(?:today|now|utcnow)\s*\(|\btime\.(?:time|localtime|gmtime)\s*\("
+)
+
+
+def test_c32_no_code_reads_the_system_clock():
+    offenders = [
+        f"{path.relative_to(SRC)}:{lineno}: {line.strip()}"
+        for path in sorted(SRC.rglob("*.py"))
+        for lineno, line in enumerate(path.read_text().splitlines(), 1)
+        if SYSTEM_CLOCK_CALLS.search(line)
+    ]
+    assert offenders == []
+
+
+def test_c32_change_follows_the_injected_clock_far_from_real_time(make_world):
+    # A date far from the real one: results only match if the service uses its Clock.
+    world = make_world(date(2031, 3, 1))
+    sub = world.subscribe("pro")
+    world.on(date(2031, 3, 11))
+    invoice = world.service.change_plan(sub.id, "premium")
+    assert invoice.issued_on == date(2031, 3, 11)
+    assert invoice.total == money("30.49")
+
+
+def test_c32_domain_objects_stay_frozen():
+    assert Subscription.__dataclass_params__.frozen
+    assert Invoice.__dataclass_params__.frozen
+
+
+def test_c32_change_does_not_mutate_previously_read_subscription(make_world):
+    world = make_world(date(2026, 3, 1))
+    sub = world.subscribe("pro")
+    world.on(date(2026, 3, 11))
+    held = world.sub(sub.id)
+    snapshot = dataclasses.asdict(held)
+    world.service.change_plan(sub.id, "premium")
+    assert dataclasses.asdict(held) == snapshot
+    assert world.sub(sub.id) is not held
+    assert world.sub(sub.id).plan_code == "premium"
+
+
+def test_c32_scheduling_does_not_mutate_previously_read_subscription(make_world):
+    world = make_world(date(2026, 3, 1))
+    sub = world.subscribe("pro")
+    world.on(date(2026, 3, 11))
+    held = world.sub(sub.id)
+    snapshot = dataclasses.asdict(held)
+    world.service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    assert dataclasses.asdict(held) == snapshot
+    assert world.sub(sub.id) != held
+
+
+# Criterion 33
+
+
+def test_c33_subscription_still_constructible_from_original_fields():
+    sub = Subscription(
+        id="sub_x",
+        customer_id="cus_x",
+        plan_code="pro",
+        interval=Interval.MONTHLY,
+        status=SubscriptionStatus.ACTIVE,
+        period_start=date(2026, 3, 1),
+        period_end=date(2026, 4, 1),
+    )
+    assert sub.canceled_on is None
+
+
+def test_c33_unchanged_subscription_lifecycle(make_world):
+    world = make_world(date(2026, 1, 31))
+    sub = world.subscribe("pro")
+    [first] = world.invoices(sub.id)
+    assert (first.issued_on, first.total) == (date(2026, 1, 31), money("30.00"))
+    assert (sub.period_start, sub.period_end) == (date(2026, 1, 31), date(2026, 2, 28))
+
+    world.on(date(2026, 4, 1))
+    issued = world.service.renew_due()
+    assert [(inv.issued_on, inv.total) for inv in issued] == [
+        (date(2026, 2, 28), money("30.00")),
+        (date(2026, 3, 28), money("30.00")),
+    ]
+    renewed = world.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.status) == ("pro", Interval.MONTHLY, SubscriptionStatus.ACTIVE)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 3, 28), date(2026, 4, 28))
+
+    canceled = world.service.cancel(sub.id)
+    assert (canceled.status, canceled.canceled_on) == (SubscriptionStatus.CANCELED, date(2026, 4, 1))
+    world.on(date(2026, 6, 1))
+    assert world.service.renew_due() == []
+
+
+def test_c33_unchanged_trial_lifecycle(make_world):
+    world = make_world(date(2026, 1, 15))
+    sub = world.subscribe("basic", Interval.ANNUAL, trial_days=14)
+    assert world.invoices(sub.id) == []
+    world.assert_renewal(
+        sub.id, on=date(2026, 1, 29), plan_code="basic", interval=Interval.ANNUAL, amount="100.00",
+        period_end=date(2027, 1, 29),
+    )
+
+
+def test_c33_other_subscriptions_unaffected_by_a_change(make_world):
+    world = make_world(date(2026, 3, 1))
+    changed = world.subscribe("pro", customer_id="cus_a")
+    untouched = world.subscribe("pro", customer_id="cus_b")
+    untouched_before = world.sub(untouched.id)
+    world.on(date(2026, 3, 11))
+    world.service.change_plan(changed.id, "basic")
+    world.service.change_plan(changed.id, "premium", Interval.ANNUAL)
+    assert world.sub(untouched.id) == untouched_before
+    world.assert_renewal(
+        untouched.id, on=date(2026, 4, 1), plan_code="pro", interval=Interval.MONTHLY, amount="30.00",
+        period_end=date(2026, 5, 1),
+    )

+            self._store.save_subscription(self._with_schedule(subscription, target.code, target_interval))
+            return None
+
+        upgraded = replace(subscription, plan_code=target.code)
+        if target_interval is subscription.interval:
+            upgraded = self._with_schedule(upgraded, None, None)
+        else:
+            upgraded = self._with_schedule(upgraded, target.code, target_interval)
+        self._store.save_subscription(upgraded)

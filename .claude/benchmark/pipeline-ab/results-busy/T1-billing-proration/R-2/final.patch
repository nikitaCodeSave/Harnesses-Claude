+            self._schedule(subscription, target)
+            return None
+
+        lines = self._proration_lines(current_plan, target_plan, subscription, today)
+        total = sum((line.amount for line in lines), ZERO)
+        if total < 0:
+            # Plans that price their intervals inconsistently: treat as a downgrade.
+            self._schedule(subscription, target)
+            return None
+
+        interval_switch = target if target.interval is not subscription.interval else None
+        changed = replace(subscription, plan_code=target_plan.code, scheduled_change=interval_switch)
+        self._store.save_subscription(changed)
+        if total == 0:
+            return None
+        return self._issue_invoice(changed, lines, today)
+
     # internals
 

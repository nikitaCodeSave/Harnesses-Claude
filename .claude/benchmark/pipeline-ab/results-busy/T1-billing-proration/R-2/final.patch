+def test_ac33_subscribe_renew_cancel_unchanged_without_scheduled_change(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    [first] = store.invoices_for(sub.id)
+    assert (first.issued_on, first.total) == (date(2026, 1, 15), money("10.00"))
+
+    clock.move_to(date(2026, 3, 15))
+    renewals = service.renew_due()
+    assert [(inv.issued_on, inv.total) for inv in renewals] == [
+        (date(2026, 2, 15), money("10.00")),
+        (date(2026, 3, 15), money("10.00")),
+    ]
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("basic", MONTHLY)
+    assert period(renewed) == (date(2026, 3, 15), date(2026, 4, 15))
+
+    canceled = service.cancel(sub.id)
+    assert canceled.status is SubscriptionStatus.CANCELED
+    clock.move_to(date(2026, 5, 15))
+    assert service.renew_due() == []

+def test_ac32_returned_invoice_is_recorded_after_earlier_invoices(service, store, clock):
+    store.add_plan(Plan("premium", "Premium", Decimal("50.00"), Decimal("500.00")))
+    sub = service.subscribe("cus_1", "basic")
+    [first] = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 1, 20))
+    second = service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 1, 25))
+    third = service.change_plan(sub.id, "premium")
+
+    recorded = store.invoices_for(sub.id)
+
+    assert recorded == [first, second, third]
+    assert recorded[1] is second
+    assert recorded[2] is third
+    assert len({inv.id for inv in recorded}) == 3

+"""Acceptance tests for mid-cycle plan changes (SPEC.md, AC1-AC33).
+
+Only the public interface named by the spec is used: ``BillingService``
+(``subscribe``, ``renew_due``, ``cancel``, ``change_plan``), the store's
+public methods, and the exported errors. Expected values come from the spec.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.clock import FixedClock
+from billing.errors import (
+    BillingError,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.invoices import Invoice
+from billing.plans import Interval, Plan
+from billing.service import BillingService
+from billing.store import InMemoryStore
+from billing.subscriptions import SubscriptionStatus
+
+MONTHLY = Interval.MONTHLY
+ANNUAL = Interval.ANNUAL
+
+
+@pytest.fixture
+def clock() -> FixedClock:
+    return FixedClock(date(2026, 1, 15))
+
+
+@pytest.fixture
+def store() -> InMemoryStore:
+    store = InMemoryStore()
+    store.add_plan(Plan("basic", "Basic", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("pro", "Pro", Decimal("30.00"), Decimal("300.00")))
+    return store
+
+
+@pytest.fixture
+def service(store: InMemoryStore, clock: FixedClock) -> BillingService:
+    return BillingService(store, clock)
+
+
+def money(value: str) -> Decimal:
+    return Decimal(value)
+
+
+def amounts(invoice: Invoice) -> list[Decimal]:
+    return sorted(line.amount for line in invoice.lines)
+
+
+def period(sub) -> tuple[date, date]:
+    return (sub.period_start, sub.period_end)
+
+
+def invalid_plan_change():
+    from billing.errors import InvalidPlanChange
+
+    return InvalidPlanChange
+
+
+# Upgrades
+
+
+def test_ac1_upgrade_is_prorated_and_applies_now(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert isinstance(invoice, Invoice)
+    assert invoice.issued_on == date(2026, 1, 25)
+    assert len(invoice.lines) == 2
+    assert amounts(invoice) == [money("-6.77"), money("20.32")]
+    assert invoice.total == money("13.55")
+    assert invoice in store.invoices_for(sub.id)
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", MONTHLY)
+    assert period(changed) == (date(2026, 1, 15), date(2026, 2, 15))
+
+
+def test_ac2_lines_are_rounded_separately_without_daily_rate(service, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 12))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [money("-0.97"), money("2.90")]
+    assert invoice.total == money("1.93")
+
+
+def test_ac3_upgrade_on_period_start_credits_and_charges_full_prices(service, store):
+    sub = service.subscribe("cus_1", "basic")
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert invoice.issued_on == date(2026, 1, 15)
+    assert amounts(invoice) == [money("-10.00"), money("30.00")]
+    assert invoice.total == money("20.00")
+
+
+def test_ac4_annual_upgrade_prorated_over_365_days(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", ANNUAL)
+    clock.move_to(date(2026, 7, 15))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [money("-50.41"), money("151.23")]
+    assert invoice.total == money("100.82")
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.interval) == ("pro", ANNUAL)
+    assert period(changed) == (date(2026, 1, 15), date(2027, 1, 15))
+
+
+def test_ac5_renewal_after_upgrade_bills_new_plan_in_full(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 2, 15))
+
+    [renewal] = service.renew_due()
+
+    assert renewal.issued_on == date(2026, 2, 15)
+    assert renewal.total == money("30.00")
+    renewed = store.get_subscription(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", MONTHLY)
+    assert period(renewed) == (date(2026, 2, 15), date(2026, 3, 15))
+

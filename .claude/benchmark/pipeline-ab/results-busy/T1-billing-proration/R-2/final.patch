+
+    assert store.get_subscription(sub.id) == before
+    assert store.invoices_for(sub.id) == invoices_before
+    assert store.invoices_for("sub_missing") == []
+    _assert_scheduled_downgrade_still_applies(service, store, clock, sub.id)

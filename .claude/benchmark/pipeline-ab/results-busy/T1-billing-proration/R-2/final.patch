+def _pro_with_downgrade_scheduled(service, clock):
+    """A `pro` monthly subscription with a downgrade to `basic` scheduled on 2026-01-25."""
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "basic") is None
+    return sub
+
+
+def _assert_scheduled_downgrade_still_applies(service, store, clock, sub_id):
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == money("10.00")
+    assert store.get_subscription(sub_id).plan_code == "basic"
+
+
+def test_ac24_unknown_subscription(service, store, clock):

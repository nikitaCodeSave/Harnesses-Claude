+    ) -> Invoice | None:
+        """Move a subscription to another plan and/or billing interval.
+
+        During a trial the change applies at once and nothing is billed.
+        Otherwise an upgrade (or a move to a plan with the same monthly price)
+        applies now and is invoiced prorated for the rest of the period, at
+        the current interval's prices. Downgrades and interval switches are
+        scheduled for the next renewal and bill nothing now. A request whose
+        target is the current plan and interval cancels a scheduled change.
+
+        Returns the invoice issued for the change, or ``None`` when nothing
+        is billed now.
+        """
+        subscription = self._store.get_subscription(subscription_id)
+        if subscription.is_canceled:
+            raise SubscriptionNotActive(subscription_id)
+        target_plan = self._store.get_plan(new_plan_code)
+        if not target_plan.active:
+            raise PlanNotAvailable(new_plan_code)
+        today = self._clock.today()
+        if today >= subscription.period_end:
+            raise InvalidPlanChange(
+                f"{subscription_id}: period ended on {subscription.period_end.isoformat()}, "
+                "renewal is due before the plan can change"
+            )
+
+        target = ScheduledChange(target_plan.code, new_interval or subscription.interval)
+        if (target.plan_code, target.interval) == (subscription.plan_code, subscription.interval):
+            if subscription.scheduled_change is None:
+                raise InvalidPlanChange(
+                    f"{subscription_id} is already on {target.plan_code} ({target.interval.value})"
+                )
+            self._store.save_subscription(replace(subscription, scheduled_change=None))
+            return None
+
+        if subscription.status is SubscriptionStatus.TRIALING:
+            self._store.save_subscription(
+                replace(
+                    subscription,
+                    plan_code=target.plan_code,
+                    interval=target.interval,
+                    scheduled_change=None,
+                )
+            )
+            return None
+
+        current_plan = self._store.get_plan(subscription.plan_code)

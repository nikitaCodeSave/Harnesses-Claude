-            period_end=period_end(start, subscription.interval),
+            period_end=period_end(start, interval),
+            scheduled_change=None,
         )
         self._store.save_subscription(renewed)
         invoice = self._issue_invoice(renewed, [self._period_line(plan, renewed)], start)
         return renewed, invoice
 
+    def _schedule(self, subscription: Subscription, change: ScheduledChange) -> None:
+        self._store.save_subscription(replace(subscription, scheduled_change=change))
+
+    @staticmethod
+    def _proration_lines(
+        current_plan: Plan, target_plan: Plan, subscription: Subscription, today: date
+    ) -> list[LineItem]:
+        """Credit for the current plan and charge for the target plan over ``[today, period_end)``.
+
+        Both are priced at the subscription's current interval and computed
+        exactly, then rounded to cents line by line.
+        """
+        interval = subscription.interval
+        remaining = Decimal((subscription.period_end - today).days)
+        period_days = Decimal((subscription.period_end - subscription.period_start).days)
+        dates = f"{today.isoformat()} to {subscription.period_end.isoformat()}"
+        return [
+            LineItem(
+                description=f"Credit: unused {current_plan.name} ({interval.value}) {dates}",
+                amount=to_money(-(current_plan.price_for(interval) * remaining / period_days)),
+            ),
+            LineItem(
+                description=f"Charge: {target_plan.name} ({interval.value}) {dates}",
+                amount=to_money(target_plan.price_for(interval) * remaining / period_days),
+            ),
+        ]
+
     @staticmethod
     def _period_line(plan: Plan, subscription: Subscription) -> LineItem:

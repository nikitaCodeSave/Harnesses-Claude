diff --git a/tests/test_change_plan.py b/tests/test_change_plan.py
new file mode 100644
index 0000000..3e321ae
--- /dev/null
+++ b/tests/test_change_plan.py
@@ -0,0 +1,194 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.errors import (
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import ScheduledChange, SubscriptionStatus
+
+# The clock starts on 2026-01-15, so a monthly period is [Jan 15, Feb 15): 31 days.
+# On Jan 25, 21 of them are left.
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def test_upgrade_credits_unused_days_and_charges_new_plan_for_the_rest(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "pro")
+    # 10 * 21/31 = 6.77 back, 30 * 21/31 = 20.32 charged
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("20.32")]
+    assert (invoice.issued_on, invoice.total) == (date(2026, 1, 25), Decimal("13.55"))
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_upgrade_keeps_period_and_next_renewal_bills_new_plan(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    service.change_plan(sub.id, "pro")
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.period_start, changed.period_end) == (
+        "pro",
+        date(2026, 1, 15),
+        date(2026, 2, 15),
+    )
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_upgrade_on_first_day_charges_exact_price_difference(service):
+    sub = service.subscribe("cus_1", "basic")
+    invoice = service.change_plan(sub.id, "pro")
+    assert amounts(invoice) == [Decimal("-10.00"), Decimal("30.00")]
+
+
+def test_downgrade_is_scheduled_for_period_end_and_bills_nothing_now(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "basic") is None
+    pending = store.get_subscription(sub.id)
+    assert pending.plan_code == "pro"
+    assert pending.scheduled_change == ScheduledChange("basic", Interval.MONTHLY)
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_scheduled_downgrade_applies_at_renewal(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("10.00")
+    assert (renewed.plan_code, renewed.scheduled_change) == ("basic", None)
+
+
+def test_asking_for_current_plan_drops_scheduled_downgrade(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    assert service.change_plan(sub.id, "pro") is None
+    assert store.get_subscription(sub.id).scheduled_change is None
+    clock.move_to(date(2026, 2, 15))
+    [renewal] = service.renew_due()
+    assert renewal.total == Decimal("30.00")
+
+
+def test_upgrade_replaces_scheduled_downgrade(service, store, clock):
+    store.add_plan(Plan("max", "Max", Decimal("50.00"), Decimal("500.00")))
+    sub = service.subscribe("cus_1", "pro")
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "max")
+    # 30 * 21/31 = 20.32 back, 50 * 21/31 = 33.87 charged
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("33.87")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.plan_code, changed.scheduled_change) == ("max", None)
+
+
+def test_monthly_to_annual_starts_annual_period_today(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-6.77"), Decimal("100.00")]
+    changed = store.get_subscription(sub.id)
+    assert (changed.interval, changed.period_start, changed.period_end) == (
+        Interval.ANNUAL,
+        date(2026, 1, 25),
+        date(2027, 1, 25),
+    )
+
+
+def test_annual_to_monthly_waits_for_end_of_paid_year(service, store, clock):
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 1, 25))
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    clock.move_to(date(2027, 1, 15))
+    [renewal] = service.renew_due()
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == Decimal("30.00")
+    assert (renewed.interval, renewed.period_end) == (Interval.MONTHLY, date(2027, 2, 15))
+
+
+def test_plan_and_interval_change_together(service, store, clock):
+    sub = service.subscribe("cus_1", "pro")
+    clock.move_to(date(2026, 1, 25))
+    invoice = service.change_plan(sub.id, "basic", Interval.ANNUAL)
+    assert amounts(invoice) == [Decimal("-20.32"), Decimal("100.00")]
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+def test_equal_price_switch_applies_now_without_invoice(service, store):
+    store.add_plan(Plan("team", "Team", Decimal("10.00"), Decimal("100.00")))
+    sub = service.subscribe("cus_1", "basic")
+    assert service.change_plan(sub.id, "team") is None
+    assert store.get_subscription(sub.id).plan_code == "team"
+    assert len(store.invoices_for(sub.id)) == 1
+
+
+def test_trial_switches_plan_without_billing(service, store, clock):
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    trialing = store.get_subscription(sub.id)
+    assert (trialing.status, trialing.plan_code, trialing.period_end) == (
+        SubscriptionStatus.TRIALING,
+        "pro",
+        date(2026, 1, 29),
+    )
+    clock.move_to(date(2026, 1, 29))
+    [first] = service.renew_due()
+    assert first.total == Decimal("300.00")
+
+
+def test_overdue_renewal_is_billed_before_the_change(service, store, clock):
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 2, 15))
+    invoice = service.change_plan(sub.id, "pro")
+    assert [inv.total for inv in store.invoices_for(sub.id)] == [
+        Decimal("10.00"),
+        Decimal("10.00"),
+        Decimal("20.00"),
+    ]
+    assert invoice.total == Decimal("20.00")
+
+
+def test_change_to_same_plan_and_interval_is_rejected(service):
+    sub = service.subscribe("cus_1", "basic")
+    with pytest.raises(InvalidPlanChange):
+        service.change_plan(sub.id, "basic")
+
+
+def test_change_on_canceled_subscription_is_rejected(service):
+    sub = service.subscribe("cus_1", "basic")
+    service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "pro")
+
+
+def test_change_to_retired_plan_is_rejected(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("pro")
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "pro")
+
+
+def test_customer_on_retired_plan_can_move_off_it(service, store):
+    sub = service.subscribe("cus_1", "basic")
+    store.retire_plan("basic")
+    assert service.change_plan(sub.id, "pro").total == Decimal("20.00")
+

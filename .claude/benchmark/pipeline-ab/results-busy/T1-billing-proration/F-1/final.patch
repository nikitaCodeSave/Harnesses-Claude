+def assert_renewal(world: World, sub_id: str, day: date, total: str, start: date, end: date, plan: str, interval):
+    [invoice] = world.renew_on(day)
+    sub = world.sub(sub_id)
+    assert invoice.total == Decimal(total)
+    assert invoice.issued_on == start
+    assert (sub.plan_code, sub.interval) == (plan, interval)
+    assert period(sub) == (start, end)

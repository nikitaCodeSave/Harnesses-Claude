+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+import billing
+from billing.clock import FixedClock
+from billing.errors import (
+    BillingError,
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.money import prorate
+from billing.plans import Interval, Plan
+from billing.service import BillingService
+from billing.store import InMemoryStore
+from billing.subscriptions import SubscriptionStatus
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+CATALOG = [
+    ("basic", "Basic", "10.00", "100.00"),
+    ("pro", "Pro", "30.00", "300.00"),
+    ("premium", "Premium", "75.00", "750.00"),
+    ("free", "Free", "0.00", "0.00"),
+    ("odd", "Odd", "10.01", "100.00"),
+    ("a", "A", "10.00", "120.00"),
+    ("b", "B", "12.00", "100.00"),
+]
+
+
+class World:
+    """A catalog store plus a service whose clock starts on a chosen day."""
+
+    def __init__(self, start: date) -> None:
+        self.store = InMemoryStore()
+        for code, name, monthly, annual in CATALOG:
+            self.store.add_plan(Plan(code, name, Decimal(monthly), Decimal(annual)))
+        self.clock = FixedClock(start)
+        self.service = BillingService(self.store, self.clock)
+
+    def subscribe(self, plan: str, interval: Interval = MONTHLY, **kwargs) -> str:
+        return self.service.subscribe("cus_1", plan, interval, **kwargs).id
+
+    def on(self, day: date) -> "World":
+        self.clock.move_to(day)
+        return self
+
+    def sub(self, sub_id: str):
+        return self.store.get_subscription(sub_id)
+
+    def invoices(self, sub_id: str):
+        return self.store.invoices_for(sub_id)
+
+    def renew_on(self, day: date):
+        self.clock.move_to(day)
+        return self.service.renew_due()
+
+
+def amounts(invoice) -> list[Decimal]:
+    return [line.amount for line in invoice.lines]
+
+
+def d(*values: str) -> list[Decimal]:
+    return [Decimal(v) for v in values]
+
+
+def period(invoice_sub) -> tuple[date, date]:
+    return invoice_sub.period_start, invoice_sub.period_end
+
+
+@pytest.fixture
+def pro_march() -> tuple[World, str]:
+    """Pro monthly, period 2026-03-01 to 2026-04-01."""

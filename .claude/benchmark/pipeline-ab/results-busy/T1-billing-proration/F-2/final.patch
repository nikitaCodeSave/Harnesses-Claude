@@ -0,0 +1,467 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+import billing
+from billing.errors import (
+    BillingError,
+    InvalidPlanChange,
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+D = Decimal
+
+
+@pytest.fixture
+def store(store):
+    store.add_plan(Plan("premium", "Premium", D("75.00"), D("750.00")))
+    store.add_plan(Plan("free", "Free", D("0.00"), D("0.00")))
+    store.add_plan(Plan("team", "Team", D("30.00"), D("280.00")))  # same monthly price as Pro
+    return store
+
+
+def amounts(invoice):
+    return [line.amount for line in invoice.lines]
+
+
+def subscribe_on(service, clock, day, plan, interval=Interval.MONTHLY, **kw):
+    clock.move_to(day)
+    return service.subscribe("cus_1", plan, interval, **kw)
+
+
+def snapshot(store, sub_id):
+    return store.get_subscription(sub_id), list(store.invoices_for(sub_id))
+
+
+# Upgrades (1-9) and worked examples
+
+
+def test_upgrade_issues_recorded_invoice_dated_on_change_date(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 11))
+    invoice = service.change_plan(sub.id, "premium")
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert (invoice.subscription_id, invoice.customer_id) == (sub.id, "cus_1")
+    assert store.invoices_for(sub.id)[-1] == invoice
+    assert len(store.invoices_for(sub.id)) == 2
+
+
+def test_worked_example_scheduled_downgrade_then_upgrade(service, store, clock):
+    sub = subscribe_on(service, clock, date(2026, 3, 1), "pro")
+    clock.move_to(date(2026, 3, 5))
+    assert service.change_plan(sub.id, "basic") is None
+    clock.move_to(date(2026, 3, 11))
+    invoice = service.change_plan(sub.id, "premium")
+    assert amounts(invoice) == [D("-20.32"), D("50.81")]
+    assert invoice.total == D("30.49")  # not the rounded net difference 30.48

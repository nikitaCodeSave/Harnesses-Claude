+"""Fixtures for the mid-cycle plan change acceptance tests (SPEC.md).
+
+The spec's examples use Basic (10.00 / 100.00), Pro (30.00 / 300.00) and
+Premium (75.00 / 750.00), and default to a Pro monthly subscription for the
+period 2026-03-01 to 2026-04-01.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from billing.clock import FixedClock
+from billing.plans import Plan
+from billing.store import InMemoryStore
+
+
+@pytest.fixture
+def clock() -> FixedClock:
+    # Earliest date any example starts on; FixedClock only moves forward.
+    return FixedClock(date(2026, 1, 15))
+
+
+@pytest.fixture
+def store() -> InMemoryStore:
+    store = InMemoryStore()
+    store.add_plan(Plan("basic", "Basic", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("pro", "Pro", Decimal("30.00"), Decimal("300.00")))
+    store.add_plan(Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")))
+    return store

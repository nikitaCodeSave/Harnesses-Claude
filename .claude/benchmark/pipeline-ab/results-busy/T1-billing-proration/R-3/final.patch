@@ -0,0 +1,565 @@
+"""Acceptance tests for mid-cycle plan changes (SPEC.md, "Acceptance criteria").
+
+Each test names the criterion it covers. Expected amounts and dates come
+from the spec. Only the public interface is used: BillingService
+(subscribe / renew_due / cancel / change_plan), InMemoryStore, FixedClock,
+Interval and the billing errors.
+"""
+
+import subprocess
+import sys
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+from billing.errors import (
+    PlanNotAvailable,
+    PlanNotFound,
+    SubscriptionNotActive,
+    SubscriptionNotFound,
+)
+from billing.plans import Interval, Plan
+from billing.subscriptions import SubscriptionStatus
+
+D = Decimal
+
+
+def invalid_plan_change():
+    # Imported lazily so that each test fails on its own while the class
+    # doesn't exist yet, instead of the whole module failing to collect.
+    from billing.errors import InvalidPlanChange
+
+    return InvalidPlanChange
+
+
+def pro_monthly(service, clock):
+    """The spec's default: Pro monthly, 2026-03-01 to 2026-04-01 (31 days)."""
+    clock.move_to(date(2026, 3, 1))
+    return service.subscribe("cus_1", "pro")
+
+
+def renew_on(service, clock, day, subscription_id):
+    """Run renew_due on ``day`` and return the single invoice for the subscription."""
+    clock.move_to(day)
+    issued = [inv for inv in service.renew_due() if inv.subscription_id == subscription_id]
+    assert len(issued) == 1, issued
+    return issued[0]
+
+
+def amounts(invoice):
+    return sorted(line.amount for line in invoice.lines)
+
+
+def assert_proration(invoice, credit, charge, total):
+    assert len(invoice.lines) == 2
+    assert amounts(invoice) == sorted([D(credit), D(charge)])
+    assert invoice.total == D(total)
+
+
+# Upgrades
+
+
+def test_ac01_upgrade_invoice_is_returned_and_recorded(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert invoice is not None
+    assert_proration(invoice, "-20.32", "50.81", "30.49")
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert invoice.subscription_id == sub.id
+    assert store.invoices_for(sub.id)[-1] == invoice
+
+
+def test_ac02_upgrade_applies_now_and_renews_at_full_price(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 11))
+    service.change_plan(sub.id, "premium")
+
+    upgraded = store.get_subscription(sub.id)
+    assert upgraded.plan_code == "premium"
+    assert upgraded.interval is Interval.MONTHLY
+    assert (upgraded.period_start, upgraded.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+
+    invoice = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert invoice.total == D("75.00")
+    assert renewed.plan_code == "premium"
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2026, 5, 1))
+
+
+def test_ac03_upgrade_on_period_start(service, clock):
+    sub = pro_monthly(service, clock)
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert_proration(invoice, "-30.00", "75.00", "45.00")
+
+
+def test_ac04_upgrade_late_in_period(service, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 21))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert_proration(invoice, "-10.65", "26.61", "15.96")
+
+
+def test_ac05_second_upgrade_credits_the_first_upgrades_plan(service, clock):
+    clock.move_to(date(2026, 3, 1))
+    sub = service.subscribe("cus_1", "basic")
+    clock.move_to(date(2026, 3, 11))
+    service.change_plan(sub.id, "pro")
+    clock.move_to(date(2026, 3, 21))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert_proration(invoice, "-10.65", "26.61", "15.96")
+
+
+def test_ac06_annual_upgrade_uses_actual_period_days(service, clock):
+    clock.move_to(date(2026, 1, 15))
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    assert sub.period_end == date(2027, 1, 15)
+    clock.move_to(date(2026, 7, 15))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert_proration(invoice, "-151.23", "378.08", "226.85")
+
+
+def test_ac07_annual_upgrade_in_leap_year(service, clock):
+    clock.move_to(date(2028, 1, 15))
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    assert sub.period_end == date(2029, 1, 15)
+    clock.move_to(date(2028, 7, 15))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert_proration(invoice, "-150.82", "377.05", "226.23")
+
+
+def test_ac08_each_line_rounds_ties_away_from_zero(service, store, clock):
+    store.add_plan(Plan("odd", "Odd", D("10.01"), D("100.10")))
+    clock.move_to(date(2026, 4, 1))
+    sub = service.subscribe("cus_1", "odd")
+    assert sub.period_end == date(2026, 5, 1)
+    clock.move_to(date(2026, 4, 16))
+
+    invoice = service.change_plan(sub.id, "pro")
+
+    assert_proration(invoice, "-5.01", "15.00", "9.99")
+
+
+def test_ac09_upgrade_with_interval_switch_bills_monthly_now_annual_at_renewal(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium", Interval.ANNUAL)
+
+    assert_proration(invoice, "-20.32", "50.81", "30.49")
+    now = store.get_subscription(sub.id)
+    assert now.plan_code == "premium"
+    assert now.interval is Interval.MONTHLY
+    assert now.period_end == date(2026, 4, 1)
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("750.00")
+    assert (renewed.plan_code, renewed.interval) == ("premium", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2027, 4, 1))
+
+
+# Scheduled changes
+
+
+def test_ac10_downgrade_is_scheduled_for_period_end(service, store, clock):
+    sub = pro_monthly(service, clock)
+    invoices_before = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "basic") is None
+
+    assert store.invoices_for(sub.id) == invoices_before
+    now = store.get_subscription(sub.id)
+    assert (now.plan_code, now.interval) == ("pro", Interval.MONTHLY)
+    assert (now.period_start, now.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("10.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2026, 5, 1))
+
+
+def test_ac11_downgrade_to_annual_is_scheduled(service, store, clock):
+    sub = pro_monthly(service, clock)
+    invoices_before = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+    assert store.invoices_for(sub.id) == invoices_before
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("100.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2027, 4, 1))
+
+
+def test_ac12_monthly_to_annual_on_same_plan_is_scheduled(service, store, clock):
+    sub = pro_monthly(service, clock)
+    invoices_before = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+    assert store.invoices_for(sub.id) == invoices_before
+    assert store.get_subscription(sub.id).interval is Interval.MONTHLY
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("300.00")
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2027, 4, 1))
+
+
+def test_ac13_annual_to_monthly_refunds_nothing(service, store, clock):
+    clock.move_to(date(2026, 1, 15))
+    sub = service.subscribe("cus_1", "pro", Interval.ANNUAL)
+    invoices_before = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 7, 15))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert store.invoices_for(sub.id) == invoices_before
+    now = store.get_subscription(sub.id)
+    assert now.interval is Interval.ANNUAL
+    assert (now.period_start, now.period_end) == (date(2026, 1, 15), date(2027, 1, 15))
+
+    renewal = renew_on(service, clock, date(2027, 1, 15), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("30.00")
+    assert renewed.interval is Interval.MONTHLY
+    assert (renewed.period_start, renewed.period_end) == (date(2027, 1, 15), date(2027, 2, 15))
+
+
+def test_ac14_same_monthly_price_is_not_an_upgrade(service, store, clock):
+    store.add_plan(Plan("team", "Team", D("30.00"), D("280.00")))
+    sub = pro_monthly(service, clock)
+    invoices_before = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "team") is None
+    assert store.invoices_for(sub.id) == invoices_before
+    assert store.get_subscription(sub.id).plan_code == "pro"
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    assert renewal.total == D("30.00")
+    assert store.get_subscription(sub.id).plan_code == "team"
+
+
+def test_ac15_none_interval_targets_current_not_pending_interval(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 5))
+    service.change_plan(sub.id, "pro", Interval.ANNUAL)
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "basic", None) is None
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("10.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+    assert renewed.period_end == date(2026, 5, 1)
+
+
+# Replacing and undoing
+
+
+def test_ac16_upgrade_replaces_scheduled_downgrade(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 5))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 3, 11))
+
+    invoice = service.change_plan(sub.id, "premium")
+
+    assert_proration(invoice, "-20.32", "50.81", "30.49")
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    assert store.get_subscription(sub.id).plan_code == "premium"
+    assert renewal.total == D("75.00")
+
+
+def test_ac17_requesting_current_plan_undoes_scheduled_change(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 5))
+    service.change_plan(sub.id, "basic")
+    invoices_before = store.invoices_for(sub.id)
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "pro", Interval.MONTHLY) is None
+    assert store.invoices_for(sub.id) == invoices_before
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("30.00")
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+
+
+def test_ac18_later_scheduled_change_replaces_earlier_one(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 5))
+    service.change_plan(sub.id, "basic")
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("100.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2027, 4, 1))
+
+
+@pytest.mark.parametrize("interval", [Interval.MONTHLY, None])
+def test_ac19_same_plan_and_interval_with_nothing_pending_is_rejected(service, store, clock, interval):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 11))
+
+    with pytest.raises(invalid_plan_change()):
+        service.change_plan(sub.id, "pro", interval)
+
+
+# Trials
+
+
+def test_ac20_trial_change_applies_immediately_and_bills_at_trial_end(service, store, clock):
+    clock.move_to(date(2026, 1, 15))
+    sub = service.subscribe("cus_1", "pro", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "basic", Interval.ANNUAL) is None
+
+    assert store.invoices_for(sub.id) == []
+    now = store.get_subscription(sub.id)
+    assert now.status is SubscriptionStatus.TRIALING
+    assert (now.plan_code, now.interval) == ("basic", Interval.ANNUAL)
+    assert now.period_end == date(2026, 1, 29)
+
+    renewal = renew_on(service, clock, date(2026, 1, 29), sub.id)
+    paid = store.get_subscription(sub.id)
+    assert renewal.total == D("100.00")
+    assert (paid.period_start, paid.period_end) == (date(2026, 1, 29), date(2027, 1, 29))
+
+
+def test_ac21_trial_upgrade_bills_nothing(service, store, clock):
+    clock.move_to(date(2026, 1, 15))
+    sub = service.subscribe("cus_1", "basic", trial_days=14)
+    clock.move_to(date(2026, 1, 20))
+
+    assert service.change_plan(sub.id, "premium") is None
+
+    assert store.invoices_for(sub.id) == []
+    now = store.get_subscription(sub.id)
+    assert now.status is SubscriptionStatus.TRIALING
+    assert now.plan_code == "premium"
+    assert now.period_end == date(2026, 1, 29)
+
+
+# Errors
+
+
+def test_ac22_unknown_subscription(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_missing", "premium")
+
+
+def test_ac22_canceled_subscription(service, clock):
+    sub = pro_monthly(service, clock)
+    service.cancel(sub.id)
+
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "premium")
+
+
+def test_ac22_unknown_plan(service, clock):
+    sub = pro_monthly(service, clock)
+
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")
+
+
+def test_ac23_retired_target_plan_is_rejected(service, store, clock):
+    sub = pro_monthly(service, clock)
+    store.retire_plan("premium")
+    clock.move_to(date(2026, 3, 11))
+
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "premium")
+
+
+def test_ac23_customer_on_retired_plan_can_switch_interval(service, store, clock):
+    sub = pro_monthly(service, clock)
+    store.retire_plan("pro")
+    clock.move_to(date(2026, 3, 11))
+
+    assert service.change_plan(sub.id, "pro", Interval.ANNUAL) is None
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("300.00")
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2027, 4, 1))
+
+
+def test_ac24_scheduled_change_onto_plan_retired_later_still_applies(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 11))
+    service.change_plan(sub.id, "basic")
+    store.retire_plan("basic")
+
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    assert renewal.total == D("10.00")
+    assert store.get_subscription(sub.id).plan_code == "basic"
+
+
+@pytest.mark.parametrize("today", [date(2026, 4, 1), date(2026, 4, 20)])
+def test_ac25_overdue_renewal_is_rejected(service, clock, today):
+    sub = pro_monthly(service, clock)
+    clock.move_to(today)
+
+    with pytest.raises(invalid_plan_change()):
+        service.change_plan(sub.id, "premium")
+
+
+@pytest.mark.parametrize(
+    ("plan_code", "error", "move_to"),
+    [
+        ("gold", lambda: PlanNotFound, date(2026, 3, 11)),
+        ("retired", lambda: PlanNotAvailable, date(2026, 3, 11)),
+        ("premium", invalid_plan_change, date(2026, 4, 1)),
+    ],
+    ids=["plan-not-found", "plan-not-available", "overdue"],
+)
+def test_ac26_rejected_request_changes_nothing(service, store, clock, plan_code, error, move_to):
+    store.add_plan(Plan("retired", "Retired", D("99.00"), D("990.00")))
+    store.retire_plan("retired")
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 5))
+    service.change_plan(sub.id, "basic")
+    invoices_before = store.invoices_for(sub.id)
+    sub_before = store.get_subscription(sub.id)
+    clock.move_to(move_to)
+
+    with pytest.raises(error()):
+        service.change_plan(sub.id, plan_code)
+
+    assert store.invoices_for(sub.id) == invoices_before
+    assert store.get_subscription(sub.id) == sub_before
+    renewal = renew_on(service, clock, date(2026, 4, 1), sub.id)
+    renewed = store.get_subscription(sub.id)
+    assert renewal.total == D("10.00")
+    assert (renewed.plan_code, renewed.interval) == ("basic", Interval.MONTHLY)
+
+
+def test_ac26_rejected_same_plan_request_changes_nothing(service, store, clock):
+    sub = pro_monthly(service, clock)
+    invoices_before = store.invoices_for(sub.id)
+    sub_before = store.get_subscription(sub.id)
+    clock.move_to(date(2026, 3, 11))
+
+    with pytest.raises(invalid_plan_change()):
+        service.change_plan(sub.id, "pro")
+
+    assert store.invoices_for(sub.id) == invoices_before
+    assert store.get_subscription(sub.id) == sub_before
+
+
+# Check order from the "Rejected requests" table: the first failing check decides.
+
+
+def test_check_order_missing_subscription_before_unknown_plan(service):
+    with pytest.raises(SubscriptionNotFound):
+        service.change_plan("sub_missing", "gold")
+
+
+def test_check_order_canceled_before_unknown_plan(service, clock):
+    sub = pro_monthly(service, clock)
+    service.cancel(sub.id)
+
+    with pytest.raises(SubscriptionNotActive):
+        service.change_plan(sub.id, "gold")
+
+
+def test_check_order_unknown_plan_before_overdue(service, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 4, 1))
+
+    with pytest.raises(PlanNotFound):
+        service.change_plan(sub.id, "gold")
+
+
+def test_check_order_retired_plan_before_overdue(service, store, clock):
+    sub = pro_monthly(service, clock)
+    store.retire_plan("premium")
+    clock.move_to(date(2026, 4, 1))
+
+    with pytest.raises(PlanNotAvailable):
+        service.change_plan(sub.id, "premium")
+
+
+# Unchanged behaviour
+
+
+def test_ac27_subscriptions_without_pending_change_renew_as_before(service, store, clock):
+    plain = pro_monthly(service, clock)
+    changed = service.subscribe("cus_2", "pro")
+    clock.move_to(date(2026, 3, 11))
+    service.change_plan(changed.id, "basic")
+
+    # Missing two renewals: caught up one period at a time, as before.
+    clock.move_to(date(2026, 5, 1))
+    issued = [inv for inv in service.renew_due() if inv.subscription_id == plain.id]
+
+    assert [(inv.issued_on, inv.total) for inv in issued] == [
+        (date(2026, 4, 1), D("30.00")),
+        (date(2026, 5, 1), D("30.00")),
+    ]
+    renewed = store.get_subscription(plain.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", Interval.MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 5, 1), date(2026, 6, 1))
+
+
+def test_ac27_existing_suite_passes_unchanged():
+    tests_dir = Path(__file__).resolve().parents[1]
+    existing = sorted(str(p) for p in tests_dir.glob("test_*.py"))
+    assert existing, "existing test suite not found"
+
+    result = subprocess.run(
+        [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider", *existing],
+        cwd=tests_dir.parent,
+        capture_output=True,
+        text=True,
+    )
+
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+def test_ac28_cancel_with_pending_change_drops_the_change(service, store, clock):
+    sub = pro_monthly(service, clock)
+    clock.move_to(date(2026, 3, 11))
+    service.change_plan(sub.id, "basic")
+    invoices_before = store.invoices_for(sub.id)
+
+    canceled = service.cancel(sub.id)
+
+    assert canceled.status is SubscriptionStatus.CANCELED
+    assert canceled.canceled_on == date(2026, 3, 11)
+    clock.move_to(date(2026, 5, 1))
+    assert [inv for inv in service.renew_due() if inv.subscription_id == sub.id] == []
+    assert store.invoices_for(sub.id) == invoices_before
+    after = store.get_subscription(sub.id)
+    assert after.status is SubscriptionStatus.CANCELED
+    assert (after.plan_code, after.interval) == ("pro", Interval.MONTHLY)

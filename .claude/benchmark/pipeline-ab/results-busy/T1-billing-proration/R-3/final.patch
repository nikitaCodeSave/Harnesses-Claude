diff --git a/src/billing/money.py b/src/billing/money.py
index f560010..759160f 100644
--- a/src/billing/money.py
+++ b/src/billing/money.py
@@ -20,6 +20,23 @@ def to_money(value: Decimal | int | str) -> Decimal:
     return Decimal(value).quantize(CENT, rounding=ROUND_HALF_UP)
 
 
+def prorate(amount: Decimal, numerator: int, denominator: int) -> Decimal:
+    """Return ``amount * numerator / denominator`` rounded to cents (half up).
+
+    Computed in exact integer cents, so no intermediate rounding can turn a
+    value just below a tie into a tie. Negative amounts round away from zero.
+    """
+    if numerator < 0 or denominator <= 0:
+        raise ValueError("prorate needs a non-negative numerator and a positive denominator")
+    amount = to_money(amount)
+    cents = abs(int(amount / CENT)) * numerator
+    whole, rest = divmod(cents, denominator)
+    if 2 * rest >= denominator:
+        whole += 1
+    result = Decimal(whole) * CENT
+    return -result if amount < 0 else result
+
+
 def is_whole_cents(value: Decimal) -> bool:
     """True when ``value`` carries no precision below one cent."""
     return value == value.quantize(CENT, rounding=ROUND_HALF_UP)

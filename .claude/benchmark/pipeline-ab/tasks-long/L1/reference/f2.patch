+    # holds -------------------------------------------------------------
+
+    def place_hold(self, member_id: str, isbn: str) -> Hold:
+        member = self._repo.get_member(member_id)
+        self._repo.get_title(isbn)
+        copies = self._repo.copies_of(isbn)
+        if any(c.status is CopyStatus.AVAILABLE for c in copies):
+            raise HoldNotAllowed(f"a copy of {isbn} is on the shelf")
+        if all(c.status is CopyStatus.WITHDRAWN for c in copies):
+            raise HoldNotAllowed(f"{isbn} has no copies in circulation")
+        if any(h.member_id == member_id and h.is_active for h in self._repo.holds_on(isbn)):
+            raise HoldNotAllowed(f"{member_id} already holds {isbn}")
+        if any(self._repo.get_copy(l.copy_id).isbn == isbn for l in self.open_loans(member_id)):
+            raise HoldNotAllowed(f"{member_id} has {isbn} on loan")
+        owed = self.balance(member.member_id)
+        if owed >= policy.HOLD_BLOCK:
+            raise AccountBlocked(member_id, owed)
+        hold = Hold(self._repo.next_id("H"), member_id, isbn, self._clock.today())
+        self._repo.add_hold(hold)
+        return hold
+
+    def cancel_hold(self, hold_id: str) -> Hold:
+        hold = self._repo.get_hold(hold_id)
+        if not hold.is_active:
+            raise HoldNotAllowed(f"hold {hold_id} is {hold.status.value}")
+        was_ready = hold.status is HoldStatus.READY
+        hold.status = HoldStatus.CANCELLED
+        if was_ready:
+            self._shelve_or_set_aside(self._repo.get_copy(hold.copy_id))
+        return hold
+
+    def expire_holds(self) -> list[Hold]:
+        """Daily job: expire ready holds not collected by their pickup day."""
+        today = self._clock.today()
+        expired = [
+            h
+            for h in self._repo.all_holds()
+            if h.status is HoldStatus.READY and h.pickup_by < today
+        ]
+        for hold in expired:
+            hold.status = HoldStatus.EXPIRED
+            member = self._repo.get_member(hold.member_id)
+            if member.category is not MemberCategory.CHILD:
+                self._charge(member.member_id, policy.NO_SHOW_FEE, "hold not collected")
+            self._shelve_or_set_aside(self._repo.get_copy(hold.copy_id))
+        return expired
+
+    def holds_for(self, isbn: str) -> list[Hold]:
+        """Active holds on the title, first in line first."""
+        self._repo.get_title(isbn)
+        return [h for h in self._repo.holds_on(isbn) if h.is_active]
+
+    def _ready_hold_for(self, copy: Copy) -> Hold | None:
+        if copy.status is not CopyStatus.ON_HOLD_SHELF:
+            return None
+        for hold in self._repo.holds_on(copy.isbn):
+            if hold.status is HoldStatus.READY and hold.copy_id == copy.copy_id:
+                return hold
+        return None
+
+    def _shelve_or_set_aside(self, copy: Copy) -> None:
+        """A copy is free again: give it to the first waiting hold, else shelve it."""
+        waiting = [h for h in self._repo.holds_on(copy.isbn) if h.status is HoldStatus.WAITING]
+        if not waiting:
+            copy.status = CopyStatus.AVAILABLE
+            return
+        hold = waiting[0]
+        hold.status = HoldStatus.READY
+        hold.copy_id = copy.copy_id
+        hold.pickup_by = policy.pickup_deadline(self._clock.today())
+        copy.status = CopyStatus.ON_HOLD_SHELF
+

diff -ruN f1/tests/test_holds.py f2/tests/test_holds.py
--- f1/tests/test_holds.py	1970-01-01 03:00:00.000000000 +0300
+++ f2/tests/test_holds.py	2026-10-28 11:19:58.156679103 +0300
@@ -0,0 +1,48 @@
+from datetime import date
+
+import pytest
+
+from lending import CopyStatus
+from lending.errors import CopyNotAvailable, HoldNotAllowed
+from lending.models import HoldStatus
+
+
+@pytest.fixture
+def all_out(service):
+    service.checkout("ann", "B1")
+    service.register_member("bob", "Bob")
+    service.checkout("bob", "B2")
+    return service
+
+
+def test_hold_needs_every_copy_out(service):
+    with pytest.raises(HoldNotAllowed):
+        service.place_hold("kid", "978-1")
+
+
+def test_returned_copy_is_set_aside_for_first_in_line(all_out, clock):
+    hold = all_out.place_hold("kid", "978-1")
+    clock.set(date(2026, 3, 10))
+    all_out.return_copy("B1")
+    assert hold.status is HoldStatus.READY
+    assert hold.copy_id == "B1"
+    assert hold.pickup_by == date(2026, 3, 17)
+    assert all_out.get_copy("B1").status is CopyStatus.ON_HOLD_SHELF
+
+
+def test_set_aside_copy_is_only_for_the_holder(all_out):
+    all_out.place_hold("kid", "978-1")
+    all_out.return_copy("B1")
+    with pytest.raises(CopyNotAvailable):
+        all_out.checkout("ann", "B1")
+    all_out.checkout("kid", "B1")
+    assert all_out.holds_for("978-1") == []
+
+
+def test_uncollected_hold_expires_and_copy_is_shelved(all_out, clock):
+    hold = all_out.place_hold("kid", "978-1")
+    all_out.return_copy("B1")
+    clock.set(date(2026, 3, 10))
+    assert all_out.expire_holds() == [hold]
+    assert hold.status is HoldStatus.EXPIRED
+    assert all_out.get_copy("B1").status is CopyStatus.AVAILABLE

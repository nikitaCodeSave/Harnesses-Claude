 # A member owing this much or more can't borrow.
 BORROWING_BLOCK = Decimal("10.00")
 
+# Days a member has to collect a copy set aside for their hold.
+PICKUP_DAYS = 7
+
+# Product decision (fines feature, F1-L1): a member owing this much or more
+# can't place a hold. Deliberately lower than BORROWING_BLOCK.
+HOLD_BLOCK = Decimal("5.00")
+
+# Product decision (fines feature, F1-L2): charged when a ready hold is not
+# collected in time. Children are exempt, as with fines.
+NO_SHOW_FEE = Decimal("1.00")
+
 # date.weekday(): Monday is 0, Sunday is 6. The library is closed on Sundays.

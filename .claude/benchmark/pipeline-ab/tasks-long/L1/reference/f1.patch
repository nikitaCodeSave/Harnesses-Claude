@@ -0,0 +1,47 @@
+"""Overdue fines and money helpers."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+from decimal import Decimal
+
+from . import policy
+from .errors import InvalidAmount
+from .models import Member, MemberCategory, Title
+
+CENT = Decimal("0.01")
+ZERO = Decimal("0.00")
+
+
+def late_days(due_on: date, on: date) -> int:
+    """Open days after ``due_on`` up to and including ``on``.
+
+    Closed days (Sundays) are not counted: nobody could have returned the copy.
+    """
+    days = 0
+    day = due_on + timedelta(days=1)
+    while day <= on:
+        if policy.is_open_day(day):
+            days += 1
+        day += timedelta(days=1)
+    return days
+
+
+def overdue_fine(title: Title, member: Member, due_on: date, on: date) -> Decimal:
+    """Fine for a copy of ``title`` due on ``due_on`` and handed back on ``on``."""
+    if member.category is MemberCategory.CHILD:
+        return ZERO
+    fine = policy.DAILY_FINE[title.material] * late_days(due_on, on)
+    return min(fine, title.replacement_cost).quantize(CENT)
+
+
+def money(amount: object) -> Decimal:
+    """Validate an amount handed in by staff: positive, whole cents."""
+    if isinstance(amount, bool) or not isinstance(amount, (Decimal, int)):
+        raise InvalidAmount(amount, "must be a Decimal")
+    value = Decimal(amount)
+    if not value.is_finite() or value <= 0:
+        raise InvalidAmount(amount, "must be positive")
+    if value != value.quantize(CENT):
+        raise InvalidAmount(amount, "must be in whole cents")
+    return value.quantize(CENT)

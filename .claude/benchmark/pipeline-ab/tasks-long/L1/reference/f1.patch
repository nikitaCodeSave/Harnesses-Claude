+    # accounts ----------------------------------------------------------
+
+    def balance(self, member_id: str) -> Decimal:
+        """What the member owes right now: charges minus payments."""
+        self._repo.get_member(member_id)
+        charged = sum((c.amount for c in self._repo.charges_of(member_id)), ZERO)
+        paid = sum((p.amount for p in self._repo.payments_of(member_id)), ZERO)
+        return charged - paid
+
+    def add_charge(self, member_id: str, amount: Decimal, reason: str) -> Decimal:
+        self._repo.get_member(member_id)
+        self._charge(member_id, money(amount), reason)

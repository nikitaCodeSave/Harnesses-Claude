+    ) -> None:
+        self._repo.add_charge(
+            Charge(
+                charge_id=self._repo.next_id("C"),
+                member_id=member_id,
+                amount=amount,
+                reason=reason,
+                charged_on=self._clock.today(),
+                loan_id=loan_id,
+            )
+        )
diff -ruN base/tests/test_fines.py f1/tests/test_fines.py
--- base/tests/test_fines.py	1970-01-01 03:00:00.000000000 +0300
+++ f1/tests/test_fines.py	2026-10-28 11:19:26.041983763 +0300
@@ -0,0 +1,52 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending.errors import AccountBlocked, InvalidAmount
+
+
+def test_late_book_is_fined_per_open_day(service, clock):
+    service.checkout("ann", "B1")  # due Mon 23 March
+    clock.set(date(2026, 3, 30))  # 6 open days late, Sunday 29th not counted
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("1.50")
+
+
+def test_on_time_return_costs_nothing(service, clock):
+    service.checkout("ann", "B1")
+    clock.set(date(2026, 3, 23))
+    service.return_copy("B1")
+    assert service.balance("ann") == Decimal("0")
+
+
+def test_fine_is_capped_at_replacement_cost(service, clock):
+    service.checkout("ann", "D1")  # due 9 March, replacement 12.00
+    clock.set(date(2026, 4, 30))
+    service.return_copy("D1")
+    assert service.balance("ann") == Decimal("12.00")
+
+
+def test_children_are_not_fined(service, clock):
+    service.checkout("kid", "D1")
+    clock.set(date(2026, 3, 20))
+    service.return_copy("D1")
+    assert service.balance("kid") == Decimal("0")
+
+
+def test_member_owing_ten_cannot_borrow(service):
+    service.add_charge("ann", Decimal("10.00"), "damaged case")
+    with pytest.raises(AccountBlocked):
+        service.checkout("ann", "B1")
+
+
+def test_partial_payment_lowers_balance(service):
+    service.add_charge("ann", Decimal("4.00"), "lost card")
+    assert service.pay("ann", Decimal("1.50")) == Decimal("2.50")
+
+
+def test_overpayment_is_refused(service):
+    service.add_charge("ann", Decimal("1.00"), "lost card")
+    with pytest.raises(InvalidAmount):
+        service.pay("ann", Decimal("1.01"))
+    assert service.balance("ann") == Decimal("1.00")

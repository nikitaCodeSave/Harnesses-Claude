+        value = money(amount)
+        if value > owed:
+            raise InvalidAmount(amount, f"more than the {owed} owed")
+        self._repo.add_payment(
+            Payment(self._repo.next_id("P"), member_id, value, self._clock.today())
+        )
+        return self.balance(member_id)
+
+    def _charge(

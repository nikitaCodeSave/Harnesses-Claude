 # less (product decision, membership feature F5-L1, which made them holdable).
 PICKUP_DAYS = 7
-PICKUP_DAYS_BY_MATERIAL: dict[Material, int] = {
-    Material.MAGAZINE: 3,
-}
+PICKUP_DAYS_BY_MATERIAL: dict[Material, int] = {}
 
 # Product decision (fines feature, F1-L1): a member owing this much or more
 # can't place a hold. Deliberately lower than BORROWING_BLOCK.
@@ -61,7 +59,7 @@ LOST_MAGAZINE_FEE = Decimal("2.00")
 
 # Product decision (holds feature F2-L3, changed in the renewals feature F3-L1):
 # a lost copy costs its replacement cost plus this fee. Children pay nothing at all.
-LOST_PROCESSING_FEE = Decimal("3.00")
+LOST_PROCESSING_FEE = Decimal("5.00")
 

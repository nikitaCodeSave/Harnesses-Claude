@@ -79,7 +82,29 @@ class LendingService:
         member.expires_on = policy.membership_expiry(start)
         return member
 
+    def close_account(self, member_id: str) -> Member:
+        member = self._repo.get_member(member_id)
+        self._require_open_account(member)
+        if self.open_loans(member_id):
+            raise CannotClose(member_id, "copies are still on loan")
+        # F5-L3: holds are cancelled with the member first, never silently.
+        if any(h.member_id == member_id and h.is_active for h in self._repo.all_holds()):
+            raise CannotClose(member_id, "holds are still active")
+        # F5-L2: a small debt is written off; a larger one must be paid first.
+        owed = self.balance(member_id)
+        if owed >= policy.CLOSING_WRITE_OFF_BELOW:
+            raise CannotClose(member_id, f"owes {owed}")
+        if owed > ZERO:
+            self._charge(member_id, -owed, "written off at closing")
+        member.closed_on = self._clock.today()
+        return member
+
+    def _require_open_account(self, member: Member) -> None:
+        if member.closed_on is not None:
+            raise AccountClosed(member.member_id)
+
     def _require_active(self, member: Member) -> None:
+        self._require_open_account(member)
         if not member.is_active(self._clock.today()):
             raise MembershipExpired(member.member_id, member.expires_on)
 
diff --git a/tests/test_closing.py b/tests/test_closing.py
new file mode 100644
index 0000000..b5fe24a
--- /dev/null
+++ b/tests/test_closing.py
@@ -0,0 +1,36 @@
+from decimal import Decimal
+
+import pytest
+
+from lending.errors import AccountClosed, CannotClose
+
+
+def test_closed_account_cannot_borrow(service):
+    service.close_account("ann")
+    with pytest.raises(AccountClosed):
+        service.checkout("ann", "B1")
+
+
+def test_cannot_close_with_a_copy_out(service):
+    service.checkout("ann", "B1")
+    with pytest.raises(CannotClose):
+        service.close_account("ann")
+
+
+def test_small_debt_is_written_off(service):
+    service.add_charge("ann", Decimal("4.99"), "damage")
+    service.close_account("ann")
+    assert service.balance("ann") == 0
+
+
+def test_larger_debt_blocks_closing(service):
+    service.add_charge("ann", Decimal("5.00"), "damage")
+    with pytest.raises(CannotClose):
+        service.close_account("ann")
+
+
+def test_active_hold_blocks_closing(service):
+    service.checkout("kid", "D1")
+    service.place_hold("ann", "dvd-1")
+    with pytest.raises(CannotClose):
+        service.close_account("ann")

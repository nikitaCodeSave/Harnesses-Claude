diff --git a/tests/test_membership.py b/tests/test_membership.py
new file mode 100644
index 0000000..32b3ab0
--- /dev/null
+++ b/tests/test_membership.py
@@ -0,0 +1,38 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending.errors import MembershipExpired, MembershipRenewalRefused
+
+
+def test_membership_runs_a_year(service):
+    assert service.get_member("ann").expires_on == date(2027, 3, 2)
+
+
+def test_child_membership_never_expires(service):
+    assert service.get_member("kid").expires_on is None
+
+
+def test_expired_member_cannot_borrow(service, clock):
+    clock.set(date(2027, 3, 3))
+    with pytest.raises(MembershipExpired):
+        service.checkout("ann", "B1")
+
+
+def test_renewal_on_time_adds_a_year(service, clock):
+    clock.set(date(2027, 2, 15))
+    assert service.renew_membership("ann").expires_on == date(2028, 3, 2)
+
+
+def test_renewal_too_early_is_refused(service, clock):
+    clock.set(date(2027, 1, 30))
+    with pytest.raises(MembershipRenewalRefused):
+        service.renew_membership("ann")
+
+
+def test_renewal_with_debt_at_the_borrowing_bar_is_refused(service, clock):
+    service.add_charge("ann", Decimal("10.00"), "damage")
+    clock.set(date(2027, 2, 15))
+    with pytest.raises(MembershipRenewalRefused):
+        service.renew_membership("ann")

@@ -49,6 +49,13 @@ RENEWABLE: frozenset[Material] = frozenset({Material.BOOK})
 MAX_RENEWALS = 2
 RENEWAL_OPENS_DAYS_BEFORE_DUE = 5
 
+# Memberships run a year and can be renewed from this many days before they expire.
+MEMBERSHIP_RENEWAL_OPENS_DAYS_BEFORE = 30
+
+# Product decision (renewals feature, F3-L2): a membership renewal only needs the
+# member under the borrowing bar, unlike a loan renewal.
+MEMBERSHIP_RENEWAL_BLOCK = BORROWING_BLOCK
+
 # date.weekday(): Monday is 0, Sunday is 6. The library is closed on Sundays.
 CLOSED_WEEKDAYS: frozenset[int] = frozenset({6})
 
@@ -75,3 +82,11 @@ def loan_limit(category: MemberCategory) -> int:
 
 def pickup_deadline(set_aside_on: date) -> date:
     return next_open_day(set_aside_on + timedelta(days=PICKUP_DAYS))
+
+
+def membership_expiry(start: date) -> date:
+    """Valid up to and including the same date a year on (28 Feb for 29 Feb)."""
+    try:
+        return start.replace(year=start.year + 1)
+    except ValueError:
+        return start.replace(year=start.year + 1, day=28)

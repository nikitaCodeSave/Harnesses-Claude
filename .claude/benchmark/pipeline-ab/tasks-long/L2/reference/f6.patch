diff --git a/tests/test_magazines.py b/tests/test_magazines.py
new file mode 100644
index 0000000..82caf20
--- /dev/null
+++ b/tests/test_magazines.py
@@ -0,0 +1,46 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending.errors import LoanLimitReached, RenewalRefused
+from lending.models import Material
+
+
+@pytest.fixture
+def mags(service):
+    service.add_title("mag-1", "Monthly", Material.MAGAZINE, Decimal("6.00"))
+    for i in range(1, 5):
+        service.add_copy(f"M{i}", "mag-1")
+    return service
+
+
+def test_magazine_goes_out_for_two_weeks(mags):
+    assert mags.checkout("ann", "M1").due_on == date(2026, 3, 16)
+
+
+def test_fourth_magazine_is_refused(mags):
+    for i in range(1, 4):
+        mags.checkout("ann", f"M{i}")
+    with pytest.raises(LoanLimitReached):
+        mags.checkout("ann", "M4")
+
+
+def test_magazine_fine_is_capped_at_two(mags, clock):
+    mags.checkout("ann", "M1")
+    clock.set(date(2026, 4, 30))
+    mags.return_copy("M1")
+    assert mags.balance("ann") == Decimal("2.00")
+
+
+def test_magazines_cannot_be_renewed(mags, clock):
+    loan = mags.checkout("ann", "M1")
+    clock.set(date(2026, 3, 14))
+    with pytest.raises(RenewalRefused):
+        mags.renew(loan.loan_id)
+
+
+def test_lost_magazine_costs_a_flat_two(mags):
+    loan = mags.checkout("ann", "M1")
+    mags.declare_lost(loan.loan_id)
+    assert mags.balance("ann") == Decimal("2.00")

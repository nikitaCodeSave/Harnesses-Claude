diff --git a/tests/test_lost.py b/tests/test_lost.py
new file mode 100644
index 0000000..39d45fe
--- /dev/null
+++ b/tests/test_lost.py
@@ -0,0 +1,61 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from lending.errors import CopyNotAvailable, NoOpenLoan, NotLost
+from lending.models import CopyStatus
+
+
+def test_lost_loan_is_over(service):
+    loan = service.checkout("ann", "B1")
+    service.declare_lost(loan.loan_id)
+    assert service.open_loans("ann") == []
+    assert service.get_copy("B1").status is CopyStatus.LOST
+
+
+def test_adult_pays_replacement_and_fee(service):
+    loan = service.checkout("ann", "B1")
+    service.declare_lost(loan.loan_id)
+    assert service.balance("ann") == Decimal("21.00")
+
+
+def test_child_pays_nothing(service):
+    loan = service.checkout("kid", "B1")
+    service.declare_lost(loan.loan_id)
+    assert service.balance("kid") == 0
+
+
+def test_lost_loan_cannot_be_declared_again(service):
+    loan = service.checkout("ann", "B1")
+    service.declare_lost(loan.loan_id)
+    with pytest.raises(NoOpenLoan):
+        service.declare_lost(loan.loan_id)
+
+
+def test_lost_copy_cannot_be_borrowed(service):
+    loan = service.checkout("ann", "B1")
+    service.declare_lost(loan.loan_id)
+    with pytest.raises(CopyNotAvailable):
+        service.checkout("ann", "B1")
+
+
+def test_found_copy_goes_back_on_the_shelf_and_refunds_replacement(service):
+    loan = service.checkout("ann", "B1")
+    service.declare_lost(loan.loan_id)
+    service.found_copy("B1")
+    assert service.get_copy("B1").status is CopyStatus.AVAILABLE
+    assert service.balance("ann") == Decimal("3.00")
+
+
+def test_found_never_leaves_credit(service):
+    loan = service.checkout("ann", "B1")
+    service.declare_lost(loan.loan_id)
+    service.pay("ann", Decimal("21.00"))
+    service.found_copy("B1")
+    assert service.balance("ann") == 0
+
+
+def test_found_on_a_copy_that_is_not_lost(service):
+    with pytest.raises(NotLost):
+        service.found_copy("B1")

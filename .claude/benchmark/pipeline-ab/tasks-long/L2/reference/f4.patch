+    def declare_lost(self, loan_id: str) -> Loan:
+        """Staff write off a copy that is not coming back; the loan is over."""
+        loan = self._repo.get_loan(loan_id)
+        if not loan.is_open:
+            raise NoOpenLoan(loan.copy_id)
+        copy = self._repo.get_copy(loan.copy_id)
+        title = self._repo.get_title(copy.isbn)
+        member = self._repo.get_member(loan.member_id)
+        today = self._clock.today()
+        fine = overdue_fine(title, member, loan.due_on, today)
+        if fine > ZERO:
+            self._charge(member.member_id, fine, "overdue fine at loss", loan.loan_id)
+        if member.category is not MemberCategory.CHILD:
+            self._charge(member.member_id, title.replacement_cost, LOST_REPLACEMENT, loan.loan_id)
+            self._charge(member.member_id, policy.LOST_PROCESSING_FEE, "lost copy processing fee", loan.loan_id)
+        loan.lost_on = today
+        copy.status = CopyStatus.LOST
+        return loan
+
+    def found_copy(self, copy_id: str) -> Copy:
+        """A lost copy turned up: back into circulation, the loan stays lost."""
+        copy = self._repo.get_copy(copy_id)
+        if copy.status is not CopyStatus.LOST:
+            raise NotLost(copy_id)
+        loan = self._repo.last_lost_loan_for_copy(copy_id)
+        if loan is not None:
+            # F1-L4: the replacement cost comes off again, but no account goes into
+            # credit; fines and fees charged with the loss stay.
+            replacement = sum(
+                (c.amount for c in self._repo.charges_of(loan.member_id)
+                 if c.loan_id == loan.loan_id and c.reason == LOST_REPLACEMENT),
+                ZERO,
+            )
+            refund = min(replacement, self.balance(loan.member_id))
+            if refund > ZERO:
+                self._charge(loan.member_id, -refund, "lost copy found", loan.loan_id)
+        self._shelve_or_set_aside(copy)
+        return copy
+
     def renew(self, loan_id: str) -> Loan:
         """Extend an open loan in place: a fresh loan period from today."""
         loan = self._repo.get_loan(loan_id)

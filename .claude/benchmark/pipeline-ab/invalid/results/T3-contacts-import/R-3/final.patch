+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+def test_phone_and_tags_columns_are_optional(as_input):
+    # A13
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input("name,email\nAnn Lee,ann@example.com\n"))
+    assert report.created == ["ann@example.com"]
+    assert report.errors == []
+    assert repo.get("ann@example.com") == Contact(name="Ann Lee", email="ann@example.com")
+
+
+def test_first_and_last_name_columns_join_into_name(as_input):
+    # A13: first_name + last_name counts as the name column, joined with one space.
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input("first_name,last_name,email\nAnn,Lee,ann@example.com\n"))
+    assert report.errors == []
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_unknown_columns_are_ignored_without_errors(as_input):
+    # A14: ignored, never an error (a warning is allowed).
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, as_input("name,company,email,notes\nAnn Lee,Acme,ann@example.com,met at expo\n")
+    )
+    assert report.errors == []
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com")]
+
+
+def test_header_only_file_gives_empty_report(as_input):
+    # A17
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input("name,email,phone,tags\n"))
+    assert isinstance(report, ImportReport)
+    assert report.created == []
+    assert report.updated == []
+    assert report.errors == []
+    assert report.warnings == []
+    assert len(repo) == 0
+
+
+def test_utf8_bom_in_bytes_is_accepted():
+    # A20
+    repo = InMemoryContactRepository()
+    data = "name,email\nАнна Ли,ann@example.com\n".encode("utf-8-sig")
+    report = import_contacts(repo, data)
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Анна Ли"
+
+
+def test_bom_character_at_start_of_text_is_accepted():
+    # A20
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, "\ufeffname,email\nAnn Lee,ann@example.com\n")
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_1000_contact_rows_are_accepted(as_input):
+    # A21: the limit is inclusive.
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input("name,email,phone,tags\n" + contact_rows(1000)))
+    assert len(report.created) == 1000
+    assert len(repo) == 1000
+
+
+def test_blank_lines_do_not_count_towards_the_row_limit(as_input):
+    # A21
+    repo = InMemoryContactRepository()
+    rows = contact_rows(1000).replace("\n", "\n\n")
+    report = import_contacts(repo, as_input("name,email,phone,tags\n" + rows))
+    assert len(report.created) == 1000
+
+
+def test_row_issue_carries_row_column_and_message(as_input):
+    # A4: RowIssue(row: int, column: str | None, message: str).
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input("name,email\nAnn Lee,ann@example.com\nAnn Smith,ann@example.com\n"),

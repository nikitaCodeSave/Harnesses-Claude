@@ -0,0 +1,78 @@
+"""Acceptance: files rejected as a whole with ImportFileError (A5, A13, A16, A18, A20-A22)."""
+
+import pytest
+
+from contactbook import Contact, ContactError, InMemoryContactRepository
+from contactbook.errors import ImportFileError
+from contactbook.importer import import_contacts
+
+
+def seeded_repo():
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"])]
+    )
+
+
+def assert_rejected_without_changes(data):
+    """(A22) On any ImportFileError the repo is left completely untouched."""
+    repo = seeded_repo()
+    before = repo.all()
+    with pytest.raises(ImportFileError):
+        import_contacts(repo, data)
+    assert repo.all() == before
+
+
+def contact_rows(count):
+    return "".join(f"Person {i},person{i}@example.com,,\n" for i in range(count))
+
+
+def test_import_file_error_is_a_contact_error():
+    # A5
+    assert issubclass(ImportFileError, ContactError)
+
+
+# A16: a completely empty file is rejected.
+
+
+def test_empty_file_is_rejected(as_input):
+    assert_rejected_without_changes(as_input(""))
+
+
+# A13: a missing email or name column rejects the whole file.
+
+
+def test_missing_email_column_is_rejected(as_input):
+    assert_rejected_without_changes(as_input("name,phone,tags\nAnn Smith,+15550000000,partner\n"))
+
+
+def test_missing_name_column_is_rejected(as_input):
+    assert_rejected_without_changes(
+        as_input("email,phone,tags\nann@example.com,+15550000000,partner\n")
+    )
+
+
+# A20: bytes that are not valid UTF-8 are rejected.
+
+
+def test_non_utf8_bytes_are_rejected():
+    data = "name,email,phone,tags\nАнна Ли,ann@example.com,,\n".encode("cp1251")
+    assert_rejected_without_changes(data)
+
+
+# A21: at most 1000 contact rows; 1001 rejects the file and imports nothing.
+
+
+def test_1001_contact_rows_are_rejected(as_input):
+    assert_rejected_without_changes(
+        as_input("name,email,phone,tags\nAnn Smith,ann@example.com,,\n" + contact_rows(1000))
+    )
+
+
+# A18 was left to us. Recommendation: a CSV that cannot be parsed (here an
+# unterminated quote swallowing the rest of the file) is a file-level error.
+
+
+def test_unterminated_quote_is_rejected(as_input):
+    assert_rejected_without_changes(
+        as_input('name,email,phone,tags\n"Ann Smith,ann@example.com,,\nBob Stone,bob@example.com,,\n')
+    )

@@ -0,0 +1,139 @@
+"""Acceptance: file shapes that must be accepted, and the report (A2-A4, A12-A15, A17, A20, A21)."""
+
+from contactbook import Contact, InMemoryContactRepository
+from contactbook.export import export_csv
+from contactbook.importer import ImportReport, RowIssue, import_contacts  # A1
+
+
+def contact_rows(count):
+    return "".join(f"Person {i},person{i}@example.com,,\n" for i in range(count))
+
+
+def test_export_output_imports_back_into_the_same_contacts(as_input):
+    # The file has the same columns as our export.
+    contacts = [

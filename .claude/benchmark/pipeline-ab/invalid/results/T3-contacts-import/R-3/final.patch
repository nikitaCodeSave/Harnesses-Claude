+"""Shared fixtures for the contacts-import acceptance tests.
+
+The criteria were agreed in Q&A with the product owner (SPEC.md was unavailable);
+each test cites the answer number it comes from, e.g. "(A6)". "R2" marks the
+second round (field cleanup and row-level rules).
+"""
+
+import pytest
+
+
+@pytest.fixture(params=["str", "bytes"])
+def as_input(request):
+    """Turn CSV text into the form import_contacts receives.
+
+    (A2) data is either already-decoded str or raw bytes as read from disk;
+    both must work, so tests that use this fixture run once per form.
+    """
+    if request.param == "str":
+        return lambda text: text
+    return lambda text: text.encode("utf-8")

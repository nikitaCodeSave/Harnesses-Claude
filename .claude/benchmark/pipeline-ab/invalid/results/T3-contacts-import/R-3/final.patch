@@ -0,0 +1,214 @@
+"""CSV import of contacts.
+
+Reads the format written by :func:`contactbook.export.export_csv` (and some looser
+variants) into a repository. Problems with the file as a whole raise
+ImportFileError before anything is stored; problems with a single row are
+reported in the ImportReport and only that row is skipped.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from .errors import ImportFileError, ValidationError
+from .export import TAG_SEPARATOR
+from .models import Contact
+from .repository import InMemoryContactRepository
+from .validation import normalize_email, normalize_phone, normalize_tags, validate_name
+
+MAX_IMPORT_ROWS = 1000
+
+_KNOWN_COLUMNS = ("name", "first_name", "last_name", "email", "phone", "tags")
+_BOM = "\ufeff"
+
+
+@dataclass(frozen=True, slots=True)
+class RowIssue:
+    """A problem found on one line of the file.
+
+    ``row`` is the line number (header = 1, blank lines counted); ``column`` is the
+    Contact field concerned (``name``, ``email``, ``phone`` or ``tags``), or None
+    when the problem is not about one field.
+    """
+
+    row: int
+    column: str | None
+    message: str
+
+
+@dataclass(slots=True)
+class ImportReport:
+    """Outcome of an import. ``created`` and ``updated`` hold normalised emails in file order."""
+
+    created: list[str] = field(default_factory=list)
+    updated: list[str] = field(default_factory=list)
+    errors: list[RowIssue] = field(default_factory=list)
+    warnings: list[RowIssue] = field(default_factory=list)
+
+
+def import_contacts(repo: InMemoryContactRepository, data: str | bytes) -> ImportReport:
+    """Create or update contacts in ``repo`` from CSV ``data`` (text or UTF-8 bytes).
+
+    A row whose email is already stored updates that contact: the name is replaced,
+    a valid non-empty phone replaces the stored one, and tags are added to the
+    stored tags. Rows with an invalid email, name or tag, and repeats of an email
+    seen earlier in the file, are errors and are not applied at all. An invalid
+    phone is only a warning: the row is applied without it.
+
+    Raises ImportFileError, leaving ``repo`` untouched, if the file is empty, is not
+    UTF-8, cannot be parsed as CSV, lacks an email or name column, or has more than
+    MAX_IMPORT_ROWS contact rows.
+    """
+    records = _read_records(_decode(data))
+    if not records:
+        raise ImportFileError("the file is empty")
+    _, header = records[0]
+    report = ImportReport()
+    columns = _map_columns(header, report)
+    rows = [(number, cells) for number, cells in records[1:] if not _is_blank(cells)]
+    if len(rows) > MAX_IMPORT_ROWS:
+        raise ImportFileError(
+            f"the file has {len(rows)} contact rows; at most {MAX_IMPORT_ROWS} are allowed"
+        )
+
+    first_row_for_email: dict[str, int] = {}
+    for number, cells in rows:
+        _import_row(repo, report, columns, number, cells, len(header), first_row_for_email)
+    return report
+
+
+def _decode(data: str | bytes) -> str:
+    if isinstance(data, bytes):
+        try:
+            return data.decode("utf-8-sig")
+        except UnicodeDecodeError as exc:
+            raise ImportFileError(f"the file is not valid UTF-8 (byte {exc.start})") from None
+    if isinstance(data, str):
+        return data.removeprefix(_BOM)
+    raise TypeError(f"import data must be str or bytes, not {type(data).__name__}")
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """Parse the whole file up front, pairing each record with the line it starts on."""
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    records = []
+    line = 0
+    try:
+        for cells in reader:
+            records.append((line + 1, cells))
+            line = reader.line_num
+    except csv.Error as exc:
+        raise ImportFileError(f"the file is not valid CSV (line {reader.line_num}): {exc}") from None
+    return records
+
+
+def _map_columns(header: list[str], report: ImportReport) -> dict[str, int]:
+    """Return the index of each known column, warning about the columns ignored."""
+    columns: dict[str, int] = {}
+    for index, raw in enumerate(header):
+        name = raw.strip().lower()
+        if name not in _KNOWN_COLUMNS:
+            report.warnings.append(RowIssue(1, None, f"unknown column {raw!r} ignored"))
+            continue
+        if name in columns:
+            raise ImportFileError(f"column {name!r} appears more than once")
+        columns[name] = index
+
+    if "name" in columns:
+        for name in ("first_name", "last_name"):
+            if name in columns:
+                del columns[name]
+                report.warnings.append(
+                    RowIssue(1, None, f"column {name!r} ignored because there is a 'name' column")
+                )
+    elif "first_name" not in columns or "last_name" not in columns:
+        raise ImportFileError("the file has no 'name' column (nor 'first_name' and 'last_name')")
+    if "email" not in columns:
+        raise ImportFileError("the file has no 'email' column")
+    return columns
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not cell.strip() for cell in cells)
+
+
+def _import_row(
+    repo: InMemoryContactRepository,
+    report: ImportReport,
+    columns: dict[str, int],
+    number: int,
+    cells: list[str],
+    header_width: int,
+    first_row_for_email: dict[str, int],
+) -> None:
+    def cell(column: str) -> str | None:
+        """The raw cell, or None if the file has no such column."""
+        if column not in columns:
+            return None
+        index = columns[column]
+        return cells[index] if index < len(cells) else ""
+
+    if any(extra.strip() for extra in cells[header_width:]):
+        report.warnings.append(
+            RowIssue(number, None, "row has more cells than the header; extra cells ignored")
+        )
+
+    errors: list[RowIssue] = []
+
+    def check(validate, *args):
+        try:
+            return validate(*args)
+        except ValidationError as exc:
+            errors.append(RowIssue(number, exc.field, exc.message))
+            return None
+
+    email = check(normalize_email, cell("email"))
+    if "name" in columns:
+        name = check(validate_name, cell("name"))
+    else:
+        name = check(validate_name, f"{cell('first_name')} {cell('last_name')}")
+    raw_tags = cell("tags") or ""
+    tags = check(normalize_tags, [tag for tag in raw_tags.split(TAG_SEPARATOR) if tag.strip()])
+
+    if email is not None:
+        if email in first_row_for_email:
+            errors.append(
+                RowIssue(
+                    number,
+                    "email",
+                    f"{email} already appears on row {first_row_for_email[email]}; row skipped",
+                )
+            )
+        else:
+            first_row_for_email[email] = number
+
+    if errors:
+        report.errors.extend(errors)
+        return
+
+    phone = None
+    raw_phone = cell("phone")
+    if raw_phone is not None and raw_phone.strip():
+        try:
+            phone = normalize_phone(raw_phone)
+        except ValidationError as exc:
+            report.warnings.append(
+                RowIssue(number, "phone", f"{exc.message}; phone not imported")
+            )
+
+    existing = repo.find(email)
+    if existing is None:
+        repo.add(Contact(name=name, email=email, phone=phone, tags=tags))
+        report.created.append(email)
+    else:
+        repo.update(
+            Contact(
+                name=name,
+                email=email,
+                phone=phone if phone is not None else existing.phone,
+                tags=existing.tags | tags,
+            )
+        )
+        report.updated.append(email)

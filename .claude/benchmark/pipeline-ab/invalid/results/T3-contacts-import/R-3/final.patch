index 0000000..6b4d024
--- /dev/null
+++ b/tests/acceptance/test_import_existing_contacts.py
@@ -0,0 +1,179 @@
+"""Acceptance: how an import treats contacts that already exist (A6-A9, A11, A23)."""
+
+from contactbook import Contact, InMemoryContactRepository
+from contactbook.importer import import_contacts
+
+
+def repo_with_ann(**overrides):
+    fields = {
+        "name": "Ann Lee",
+        "email": "ann@example.com",
+        "phone": "+15551234567",
+        "tags": ["vip"],
+    }
+    fields.update(overrides)
+    return InMemoryContactRepository([Contact.create(**fields)])
+
+
+def error_rows(report):
+    return [issue.row for issue in report.errors]
+
+
+# A6: a matching email updates the stored contact, matched on trim + lower-case.
+
+
+def test_matching_email_updates_instead_of_adding(as_input):
+    repo = repo_with_ann()
+    report = import_contacts(
+        repo, as_input("name,email,phone,tags\nAnn Smith,  ANN@Example.COM ,,\n")
+    )
+    assert report.updated == ["ann@example.com"]
+    assert report.created == []
+    assert report.errors == []
+    assert len(repo) == 1
+
+
+# A7: the file's name replaces the stored one.
+
+
+def test_update_replaces_name(as_input):
+    repo = repo_with_ann()
+    import_contacts(repo, as_input("name,email,phone,tags\nAnn Smith,ann@example.com,,\n"))
+    assert repo.get("ann@example.com").name == "Ann Smith"
+
+
+# A8: a non-empty phone replaces; an empty cell or a missing column never clears.
+
+
+def test_update_with_phone_replaces_phone(as_input):
+    repo = repo_with_ann()
+    import_contacts(
+        repo, as_input("name,email,phone,tags\nAnn Lee,ann@example.com,+442079460958,\n")
+    )
+    assert repo.get("ann@example.com").phone == "+442079460958"
+
+
+def test_empty_phone_cell_keeps_stored_phone(as_input):
+    repo = repo_with_ann()
+    import_contacts(repo, as_input("name,email,phone,tags\nAnn Smith,ann@example.com,,\n"))
+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+def test_missing_phone_column_keeps_stored_phone(as_input):
+    repo = repo_with_ann()
+    import_contacts(repo, as_input("name,email,tags\nAnn Smith,ann@example.com,\n"))
+    assert repo.get("ann@example.com").phone == "+15551234567"
+
+
+# A9: tags are merged; an import never removes tags.
+
+
+def test_update_adds_file_tags_to_existing_tags(as_input):
+    repo = repo_with_ann()
+    import_contacts(
+        repo, as_input("name,email,phone,tags\nAnn Lee,ann@example.com,,vip;partner;lead\n")
+    )
+    assert repo.get("ann@example.com").tags == {"vip", "partner", "lead"}
+
+
+def test_empty_tags_cell_keeps_stored_tags(as_input):
+    repo = repo_with_ann()
+    import_contacts(repo, as_input("name,email,phone,tags\nAnn Smith,ann@example.com,,\n"))
+    assert repo.get("ann@example.com").tags == {"vip"}
+
+
+def test_missing_tags_column_keeps_stored_tags(as_input):
+    repo = repo_with_ann()
+    import_contacts(repo, as_input("name,email,phone\nAnn Smith,ann@example.com,\n"))
+    assert repo.get("ann@example.com").tags == {"vip"}
+
+
+# A11: the first row with an email wins; later rows with it are errors, not applied.
+
+
+def test_first_row_wins_for_email_repeated_in_file(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input(
+            "name,email,phone,tags\n"
+            "Ann Lee,ann@example.com,,vip\n"
+            "Ann Smith,ANN@example.com,+15550000000,partner\n"
+        ),
+    )
+    assert report.created == ["ann@example.com"]
+    assert error_rows(report) == [3]
+    assert repo.all() == [Contact(name="Ann Lee", email="ann@example.com", tags=frozenset({"vip"}))]
+
+
+def test_every_later_repeat_is_an_error_on_its_own_row(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input(
+            "name,email,phone,tags\n"
+            "Ann Lee,ann@example.com,,\n"
+            "Ann Smith,ann@example.com,,\n"
+            "Ann Jones,ann@example.com,,\n"
+        ),
+    )
+    assert error_rows(report) == [3, 4]
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+def test_repeat_of_existing_contact_applies_only_first_row(as_input):
+    repo = repo_with_ann()
+    report = import_contacts(
+        repo,
+        as_input(
+            "name,email,phone,tags\n"
+            "Ann Smith,ann@example.com,,\n"
+            "Ann Jones,ann@example.com,+15550000000,partner\n"
+        ),
+    )
+    assert report.updated == ["ann@example.com"]
+    assert error_rows(report) == [3]
+    assert len(repo) == 1
+    # A23: the rejected row is not applied even partly.
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"vip"}),
+    )
+
+
+# A4: rows are numbered by line, header = 1, blank lines included.
+
+
+def test_row_numbers_count_header_and_blank_lines(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input(
+            "name,email,phone,tags\n"   # row 1
+            "Ann Lee,ann@example.com,,\n"   # row 2
+            "\n"   # row 3
+            "Ann Smith,ann@example.com,,\n"   # row 4
+        ),
+    )
+    assert error_rows(report) == [4]
+
+
+# A23: partial import - good rows go in, bad rows are reported and skipped.
+
+
+def test_rows_after_a_bad_row_are_still_imported(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input(
+            "name,email,phone,tags\n"
+            "Ann Lee,ann@example.com,,\n"
+            "Ann Smith,ann@example.com,,\n"
+            "Bob Stone,bob@example.com,,\n"
+        ),
+    )
+    assert report.created == ["ann@example.com", "bob@example.com"]
+    assert error_rows(report) == [3]
+    assert [c.email for c in repo.all()] == ["ann@example.com", "bob@example.com"]
diff --git a/tests/acceptance/test_import_file_format.py b/tests/acceptance/test_import_file_format.py

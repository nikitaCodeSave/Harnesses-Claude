@@ -0,0 +1,225 @@
+"""Acceptance: field cleanup and row-level errors and warnings (R2)."""
+
+import pytest
+
+from contactbook import Contact, InMemoryContactRepository
+from contactbook.importer import import_contacts
+
+HEADER = "name,email,phone,tags\n"
+
+
+def repo_with_ann():
+    return InMemoryContactRepository(
+        [Contact.create(name="Ann Lee", email="ann@example.com", phone="+15551234567", tags=["vip"])]
+    )
+
+
+def locations(issues):
+    return [(issue.row, issue.column) for issue in issues]
+
+
+# Field cleanup: every field goes through the existing validation helpers.
+
+
+def test_new_contact_fields_are_normalised(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input(HEADER + '  Ann   Lee , Ann@Example.COM ,+1 (555) 123-4567,"Key Account; VIP;;vip;"\n'),
+    )
+    assert report.errors == []
+    assert report.created == ["ann@example.com"]
+    assert repo.all() == [
+        Contact(
+            name="Ann Lee",
+            email="ann@example.com",
+            phone="+15551234567",
+            tags=frozenset({"key-account", "vip"}),
+        )
+    ]
+
+
+def test_updated_contact_fields_are_normalised(as_input):
+    repo = repo_with_ann()
+    report = import_contacts(
+        repo, as_input(HEADER + " Ann   Smith ,ANN@example.com,+44 20 7946 0958,VIP;Key Account\n")
+    )
+    assert report.errors == []
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="+442079460958",
+        tags=frozenset({"vip", "key-account"}),
+    )
+
+
+def test_first_and_last_name_are_validated_as_a_name(as_input):
+    repo = InMemoryContactRepository()
+    import_contacts(repo, as_input("first_name,last_name,email\n Ann , Lee ,ann@example.com\n"))
+    assert repo.get("ann@example.com").name == "Ann Lee"
+
+
+# Email: missing or invalid is an error on that row, column "email".
+
+
+@pytest.mark.parametrize("email", ["", "   ", "not-an-email", "ann@example"])
+def test_missing_or_invalid_email_is_an_error(as_input, email):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo, as_input(HEADER + "Bob Stone,bob@example.com,,\n" + f"Ann Lee,{email},,\n")
+    )
+    assert locations(report.errors) == [(3, "email")]
+    assert report.created == ["bob@example.com"]
+    assert [c.email for c in repo.all()] == ["bob@example.com"]
+
+
+# Name: required on every row, also on updates; error column "name".
+
+
+@pytest.mark.parametrize("name", ["", "   ", "x" * 101])
+def test_missing_or_invalid_name_on_new_contact_is_an_error(as_input, name):
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input(HEADER + f"{name},ann@example.com,,\n"))
+    assert locations(report.errors) == [(2, "name")]
+    assert report.created == []
+    assert len(repo) == 0
+
+
+def test_missing_name_on_update_is_an_error_and_changes_nothing(as_input):
+    repo = repo_with_ann()
+    before = repo.all()
+    report = import_contacts(repo, as_input(HEADER + ",ann@example.com,+442079460958,partner\n"))
+    assert locations(report.errors) == [(2, "name")]
+    assert report.updated == []
+    assert repo.all() == before
+
+
+def test_name_problem_in_first_last_name_file_is_reported_on_name(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input("first_name,last_name,email\n , ,ann@example.com\n"))
+    assert locations(report.errors) == [(2, "name")]
+    assert len(repo) == 0
+
+
+# Tags: an invalid tag makes the row an error, column "tags".
+
+
+@pytest.mark.parametrize("tags", ["c++", "vip;c++", "x" * 33])
+def test_invalid_tag_on_new_contact_is_an_error(as_input, tags):
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input(HEADER + f"Ann Lee,ann@example.com,,{tags}\n"))
+    assert locations(report.errors) == [(2, "tags")]
+    assert report.created == []
+    assert len(repo) == 0
+
+
+def test_invalid_tag_on_update_leaves_stored_contact_unchanged(as_input):
+    # A bad row is not applied even partly: the valid name and phone are dropped too.
+    repo = repo_with_ann()
+    before = repo.all()
+    report = import_contacts(
+        repo, as_input(HEADER + "Ann Smith,ann@example.com,+442079460958,partner;c++\n")
+    )
+    assert locations(report.errors) == [(2, "tags")]
+    assert report.updated == []
+    assert repo.all() == before
+
+
+# Phone: an invalid phone is a warning (column "phone"); the rest of the row applies
+# and the phone stays as it was.
+
+
+@pytest.mark.parametrize("phone", ["12345", "+1 555 CALL NOW"])
+def test_invalid_phone_on_new_contact_is_a_warning_and_contact_has_no_phone(as_input, phone):
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input(HEADER + f"Ann Lee,ann@example.com,{phone},vip\n"))
+    assert report.errors == []
+    assert (2, "phone") in locations(report.warnings)
+    assert report.created == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Lee", email="ann@example.com", phone=None, tags=frozenset({"vip"})
+    )
+
+
+def test_invalid_phone_on_update_is_a_warning_and_keeps_stored_phone(as_input):
+    repo = repo_with_ann()
+    report = import_contacts(repo, as_input(HEADER + "Ann Smith,ann@example.com,12345,partner\n"))
+    assert report.errors == []
+    assert (2, "phone") in locations(report.warnings)
+    assert report.updated == ["ann@example.com"]
+    assert repo.get("ann@example.com") == Contact(
+        name="Ann Smith",
+        email="ann@example.com",
+        phone="+15551234567",
+        tags=frozenset({"vip", "partner"}),
+    )
+
+
+def test_empty_phone_cell_is_neither_error_nor_warning(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(repo, as_input(HEADER + "Ann Lee,ann@example.com,   ,vip\n"))
+    assert report.errors == []
+    assert report.warnings == []
+    assert repo.get("ann@example.com").phone is None
+
+
+# Blank rows (empty lines, or every cell empty or spaces) are skipped silently.
+
+
+def test_blank_rows_are_skipped_silently(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input(
+            HEADER   # row 1
+            + "\n"   # row 2
+            + ",,,\n"   # row 3
+            + " ,  , , \n"   # row 4
+            + "Ann Lee,ann@example.com,,\n"   # row 5
+            + "\n"   # row 6
+        ),
+    )
+    assert report.errors == []
+    assert report.warnings == []
+    assert report.created == ["ann@example.com"]
+    assert len(repo) == 1
+
+
+def test_blank_rows_still_count_for_row_numbers(as_input):
+    repo = InMemoryContactRepository()
+    report = import_contacts(
+        repo,
+        as_input(HEADER + " , , , \n" + "\n" + "Ann Lee,not-an-email,,\n"),
+    )
+    assert locations(report.errors) == [(4, "email")]
+
+
+# Partial import: good rows go in, bad rows are reported and skipped.
+
+
+def test_mixed_file_imports_good_rows_and_reports_bad_ones(as_input):
+    repo = repo_with_ann()
+    report = import_contacts(
+        repo,
+        as_input(
+            HEADER
+            + "Bob Stone,bob@example.com,,\n"   # row 2: created
+            + "Carl,not-an-email,,\n"   # row 3: error, email
+            + "Ann Smith,ann@example.com,12345,\n"   # row 4: updated, phone warning
+            + ",dan@example.com,,\n"   # row 5: error, name
+            + "Eve Hart,eve@example.com,,bad tag!\n"   # row 6: error, tags
+            + "Fay Wu,fay@example.com,+15557654321,lead\n"   # row 7: created
+        ),
+    )
+    assert report.created == ["bob@example.com", "fay@example.com"]
+    assert report.updated == ["ann@example.com"]
+    assert locations(report.errors) == [(3, "email"), (5, "name"), (6, "tags")]
+    assert (4, "phone") in locations(report.warnings)
+    assert sorted(c.email for c in repo.all()) == [
+        "ann@example.com",
+        "bob@example.com",
+        "fay@example.com",
+    ]
+    assert repo.get("ann@example.com").phone == "+15551234567"
+    assert repo.get("ann@example.com").name == "Ann Smith"

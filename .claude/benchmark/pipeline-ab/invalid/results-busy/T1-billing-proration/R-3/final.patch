+"""SPEC.md acceptance criteria 14-20: upgrades of active subscriptions."""
+
+from datetime import date
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+from plan_change_support import D, amounts
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+
+# 14-15: worked example "Monthly upgrade"
+
+
+def test_14_upgrade_applies_now_without_restarting_the_period(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+
+    env.service.change_plan(sub.id, "premium")
+
+    upgraded = env.sub(sub.id)
+    assert upgraded.plan_code == "premium"
+    assert upgraded.interval is MONTHLY
+    assert (upgraded.period_start, upgraded.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+    assert upgraded.status is SubscriptionStatus.ACTIVE
+
+
+def test_15_upgrade_records_and_returns_one_two_line_invoice(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1), customer_id="cus_42")
+    env.at(date(2026, 3, 11))
+    invoices_before = env.invoices(sub.id)
+
+    invoice = env.service.change_plan(sub.id, "premium")
+
+    assert env.invoices(sub.id) == invoices_before + [invoice]
+    assert invoice.issued_on == date(2026, 3, 11)
+    assert (invoice.subscription_id, invoice.customer_id) == (sub.id, "cus_42")
+    assert len(invoice.lines) == 2
+    assert amounts(invoice) == [D("-20.32"), D("50.81")]
+    assert invoice.total == D("30.49")
+
+
+def test_15_monthly_upgrade_then_renewal_bills_new_plan(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "premium")
+
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert (renewal.issued_on, renewal.total) == (date(2026, 4, 1), D("75.00"))
+    assert env.sub(sub.id).period_end == date(2026, 5, 1)
+
+
+def test_15_worked_example_annual_upgrade(make_env):
+    env = make_env()
+    sub = env.subscribe("basic", ANNUAL, on=date(2026, 1, 15))
+    env.at(date(2026, 7, 15))
+
+    invoice = env.service.change_plan(sub.id, "pro")
+
+    assert amounts(invoice) == [D("-50.41"), D("151.23")]
+    assert invoice.total == D("100.82")
+    upgraded = env.sub(sub.id)
+    assert (upgraded.plan_code, upgraded.interval) == ("pro", ANNUAL)
+    assert (upgraded.period_start, upgraded.period_end) == (date(2026, 1, 15), date(2027, 1, 15))
+
+    env.at(date(2027, 1, 15))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("300.00")
+
+
+def test_15_annual_upgrade_over_a_366_day_period(make_env):
+    env = make_env(date(2027, 1, 1))
+    sub = env.subscribe("basic", ANNUAL, on=date(2027, 3, 1))  # period ends 2028-03-01: 366 days
+    env.at(date(2027, 9, 1))  # 182 remaining days
+
+    invoice = env.service.change_plan(sub.id, "pro")
+
+    # -(100 * 182/366) = -49.726..., +(300 * 182/366) = 149.180...
+    assert amounts(invoice) == [D("-49.73"), D("149.18")]
+    assert invoice.total == D("99.45")
+
+
+# 16
+
+
+def test_16_lines_are_rounded_separately_not_the_net(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+
+    invoice = env.service.change_plan(sub.id, "premium")
+
+    # Rounding the net (45 * 21/31 = 30.48) is wrong; rounding a daily rate
+    # (0.97 * 21 = 20.37, 2.42 * 21 = 50.82) is wrong too.
+    assert amounts(invoice) == [D("-20.32"), D("50.81")]
+    assert invoice.total == D("30.49")
+
+
+def test_16_each_line_is_rounded_half_up(make_env):
+    env = make_env()
+    env.add_plan("plus", "20.01", "200.10")
+    sub = env.subscribe("basic", on=date(2026, 2, 1))  # 28-day period
+    env.at(date(2026, 2, 15))  # 14 remaining days
+
+    invoice = env.service.change_plan(sub.id, "plus")
+
+    # 20.01 * 14/28 = 10.005 exactly -> 10.01 half up (half-even would give 10.00).
+    assert amounts(invoice) == [D("-5.00"), D("10.01")]
+    assert invoice.total == D("5.01")
+
+
+# 17
+
+
+def test_17_change_on_first_day_credits_whole_period(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+
+    invoice = env.service.change_plan(sub.id, "premium")

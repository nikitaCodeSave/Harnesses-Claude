+"""Shared setup for the mid-cycle plan change acceptance tests (SPEC.md).
+
+Plans follow the spec's worked examples: Basic 10.00/100.00, Pro 30.00/300.00,
+Premium 75.00/750.00 (monthly/annual).
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+
+from billing.clock import FixedClock
+from billing.invoices import Invoice
+from billing.plans import Interval, Plan
+from billing.service import BillingService
+from billing.store import InMemoryStore
+from billing.subscriptions import Subscription
+
+
+@dataclass
+class Env:
+    store: InMemoryStore
+    clock: FixedClock
+    service: BillingService
+
+    def at(self, day: date) -> "Env":
+        self.clock.move_to(day)
+        return self
+
+    def subscribe(
+        self,
+        plan_code: str,
+        interval: Interval = Interval.MONTHLY,
+        *,
+        on: date,
+        trial_days: int = 0,
+        customer_id: str = "cus_1",
+    ) -> Subscription:
+        self.at(on)
+        return self.service.subscribe(customer_id, plan_code, interval, trial_days=trial_days)
+
+    def sub(self, subscription_id: str) -> Subscription:
+        return self.store.get_subscription(subscription_id)
+
+    def invoices(self, subscription_id: str) -> list[Invoice]:
+        return self.store.invoices_for(subscription_id)
+
+    def add_plan(self, code: str, monthly: str, annual: str) -> None:
+        self.store.add_plan(Plan(code, code.title(), Decimal(monthly), Decimal(annual)))
+
+
+def build_env(start: date = date(2026, 1, 1)) -> Env:
+    store = InMemoryStore()
+    store.add_plan(Plan("basic", "Basic", Decimal("10.00"), Decimal("100.00")))
+    store.add_plan(Plan("pro", "Pro", Decimal("30.00"), Decimal("300.00")))
+    store.add_plan(Plan("premium", "Premium", Decimal("75.00"), Decimal("750.00")))
+    clock = FixedClock(start)
+    return Env(store, clock, BillingService(store, clock))
+
+
+def amounts(invoice: Invoice) -> list[Decimal]:
+    """Line amounts, smallest first (credit before charge)."""
+    return sorted(line.amount for line in invoice.lines)
+
+
+def D(value: str) -> Decimal:
+    return Decimal(value)

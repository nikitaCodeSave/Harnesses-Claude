@@ -0,0 +1,160 @@
+"""SPEC.md acceptance criteria 25-28: renewal with a pending change."""
+
+from datetime import date
+
+import pytest
+
+import billing.errors as errors
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+from plan_change_support import D
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+
+# 25
+
+
+def test_25_renewal_moves_to_pending_plan_and_interval(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "basic", ANNUAL)
+
+    env.at(date(2026, 4, 1))
+    issued = env.service.renew_due()
+
+    [renewal] = issued
+    assert env.invoices(sub.id)[-1] == renewal
+    assert (renewal.issued_on, renewal.total) == (date(2026, 4, 1), D("100.00"))
+    renewed = env.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.status) == ("basic", ANNUAL, SubscriptionStatus.ACTIVE)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2027, 4, 1))
+
+

+"""SPEC.md acceptance criteria 21-24: downgrades and interval switches."""
+
+from datetime import date
+
+import pytest
+
+from billing.plans import Interval
+from plan_change_support import D, amounts
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+
+def _unchanged_terms(sub):
+    return (sub.plan_code, sub.interval, sub.status, sub.period_start, sub.period_end)
+
+
+# 21-22
+#
+# (base interval, base subscribe date, request date, target, new_interval,
+#  renewal date, expected plan, expected interval, price, new period end)
+DEFERRED = [
+    pytest.param(
+        MONTHLY, date(2026, 3, 1), date(2026, 3, 11), "basic", None,
+        date(2026, 4, 1), "basic", MONTHLY, "10.00", date(2026, 5, 1), id="downgrade",
+    ),
+    pytest.param(
+        MONTHLY, date(2026, 3, 1), date(2026, 3, 11), "pro", ANNUAL,
+        date(2026, 4, 1), "pro", ANNUAL, "300.00", date(2027, 4, 1), id="monthly-to-annual",
+    ),
+    pytest.param(
+        MONTHLY, date(2026, 3, 1), date(2026, 3, 11), "basic", ANNUAL,
+        date(2026, 4, 1), "basic", ANNUAL, "100.00", date(2027, 4, 1), id="downgrade-to-annual",
+    ),
+    pytest.param(
+        ANNUAL, date(2026, 1, 15), date(2026, 7, 15), "pro", MONTHLY,
+        date(2027, 1, 15), "pro", MONTHLY, "30.00", date(2027, 2, 15), id="annual-to-monthly",
+    ),
+    pytest.param(
+        ANNUAL, date(2026, 1, 15), date(2026, 7, 15), "basic", MONTHLY,
+        date(2027, 1, 15), "basic", MONTHLY, "10.00", date(2027, 2, 15), id="downgrade-to-monthly",
+    ),
+    pytest.param(
+        ANNUAL, date(2026, 1, 15), date(2026, 7, 15), "basic", None,
+        date(2027, 1, 15), "basic", ANNUAL, "100.00", date(2028, 1, 15), id="annual-downgrade",
+    ),
+]
+
+DEFERRED_ARGS = "base, start, today, target, new_interval, renew_on, plan, interval, price, new_end"
+
+
+@pytest.mark.parametrize(DEFERRED_ARGS, DEFERRED)
+def test_21_22_deferred_change_bills_nothing_and_keeps_current_terms(
+    make_env, base, start, today, target, new_interval, renew_on, plan, interval, price, new_end
+):
+    env = make_env()
+    sub = env.subscribe("pro", base, on=start)
+    env.at(today)
+    before = env.sub(sub.id)
+    invoices_before = env.invoices(sub.id)
+
+    assert env.service.change_plan(sub.id, target, new_interval) is None
+
+    assert env.invoices(sub.id) == invoices_before
+    assert _unchanged_terms(env.sub(sub.id)) == _unchanged_terms(before)
+
+
+@pytest.mark.parametrize(DEFERRED_ARGS, DEFERRED)
+def test_21_22_deferred_change_is_recorded_as_pending(
+    make_env, base, start, today, target, new_interval, renew_on, plan, interval, price, new_end
+):
+    env = make_env()
+    sub = env.subscribe("pro", base, on=start)
+    env.at(today)
+    env.service.change_plan(sub.id, target, new_interval)
+
+    env.at(renew_on)
+    [renewal] = env.service.renew_due()
+
+    assert renewal.total == D(price)
+    assert all(line.amount >= 0 for line in renewal.lines)  # unused time is never refunded
+    renewed = env.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval) == (plan, interval)
+    assert (renewed.period_start, renewed.period_end) == (renew_on, new_end)
+
+
+def test_21_different_plan_with_equal_monthly_price_is_a_deferred_downgrade(make_env):
+    env = make_env()
+    env.add_plan("twin", "30.00", "290.00")
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    invoices_before = env.invoices(sub.id)
+
+    assert env.service.change_plan(sub.id, "twin") is None
+    assert env.invoices(sub.id) == invoices_before
+    assert env.sub(sub.id).plan_code == "pro"
+
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("30.00")
+    assert env.sub(sub.id).plan_code == "twin"
+
+
+# 23
+
+
+def test_23_worked_example_upgrade_with_interval_switch(make_env):
+    env = make_env()
+    sub = env.subscribe("basic", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+
+    invoice = env.service.change_plan(sub.id, "pro", ANNUAL)
+
+    assert amounts(invoice) == [D("-6.77"), D("20.32")]
+    assert invoice.total == D("13.55")
+    now = env.sub(sub.id)
+    assert (now.plan_code, now.interval) == ("pro", MONTHLY)
+    assert (now.period_start, now.period_end) == (date(2026, 3, 1), date(2026, 4, 1))
+
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert (renewal.issued_on, renewal.total) == (date(2026, 4, 1), D("300.00"))
+    renewed = env.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", ANNUAL)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2027, 4, 1))
+
+
+def test_23_annual_upgrade_switching_to_monthly_prorates_at_annual_prices(make_env):
+    env = make_env()
+    sub = env.subscribe("basic", ANNUAL, on=date(2026, 1, 15))
+    env.at(date(2026, 7, 15))
+
+    invoice = env.service.change_plan(sub.id, "pro", MONTHLY)
+
+    assert amounts(invoice) == [D("-50.41"), D("151.23")]
+    assert invoice.total == D("100.82")
+    now = env.sub(sub.id)
+    assert (now.plan_code, now.interval, now.period_end) == ("pro", ANNUAL, date(2027, 1, 15))
+
+    env.at(date(2027, 1, 15))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("30.00")
+    renewed = env.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.period_end) == ("pro", MONTHLY, date(2027, 2, 15))
+
+
+# 24
+
+
+def _renew_april(env, sub_id):
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    renewed = env.sub(sub_id)
+    return renewal.total, renewed.plan_code, renewed.interval, renewed.period_end
+
+
+def test_24_interval_switch_replaces_pending_downgrade(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "basic")
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "pro", ANNUAL)
+
+    assert _renew_april(env, sub.id) == (D("300.00"), "pro", ANNUAL, date(2027, 4, 1))
+
+
+def test_24_each_request_states_the_full_target(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "basic", ANNUAL)
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "basic")  # target: Basic + current (monthly) interval
+
+    assert _renew_april(env, sub.id) == (D("10.00"), "basic", MONTHLY, date(2026, 5, 1))
+
+
+def test_24_downgrade_replaces_pending_switch_left_by_an_upgrade(make_env):
+    env = make_env()
+    sub = env.subscribe("basic", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "premium", ANNUAL)  # now Premium monthly, Premium annual pending
+    env.at(date(2026, 3, 11))
+    assert env.service.change_plan(sub.id, "pro") is None  # downgrade from Premium, Pro monthly
+
+    assert _renew_april(env, sub.id) == (D("30.00"), "pro", MONTHLY, date(2026, 5, 1))

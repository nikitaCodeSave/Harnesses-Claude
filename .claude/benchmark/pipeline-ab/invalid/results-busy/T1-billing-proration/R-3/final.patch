+"""SPEC.md acceptance criteria 9-10: target equals the current plan and interval."""
+
+from datetime import date
+
+import pytest
+
+import billing.errors as errors
+from billing.plans import Interval
+from plan_change_support import D
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+
+# 9
+
+
+def test_9_worked_example_cancelling_a_pending_downgrade(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    assert env.service.change_plan(sub.id, "basic") is None
+    invoices_before = env.invoices(sub.id)
+
+    assert env.service.change_plan(sub.id, "pro", MONTHLY) is None
+    assert env.invoices(sub.id) == invoices_before
+
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("30.00")
+    renewed = env.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval) == ("pro", MONTHLY)
+    assert (renewed.period_start, renewed.period_end) == (date(2026, 4, 1), date(2026, 5, 1))
+
+
+def test_9_none_interval_means_current_interval_not_the_pending_one(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    assert env.service.change_plan(sub.id, "pro", ANNUAL) is None  # pending interval switch
+
+    # Target is Pro + current interval (monthly) == current: cancels the pending switch.
+    assert env.service.change_plan(sub.id, "pro") is None
+
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("30.00")
+    renewed = env.sub(sub.id)
+    assert renewed.interval is MONTHLY
+    assert renewed.period_end == date(2026, 5, 1)
+
+
+def test_9_cancels_pending_downgrade_with_interval_switch(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", ANNUAL, on=date(2026, 1, 15))
+    env.at(date(2026, 7, 15))
+    assert env.service.change_plan(sub.id, "basic", MONTHLY) is None
+    assert env.service.change_plan(sub.id, "pro", ANNUAL) is None
+
+    env.at(date(2027, 1, 15))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("300.00")
+    renewed = env.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.period_end) == ("pro", ANNUAL, date(2028, 1, 15))
+
+
+# 10
+
+
+@pytest.mark.parametrize("interval", [MONTHLY, ANNUAL])
+@pytest.mark.parametrize("pass_interval", [False, True])
+def test_10_same_target_with_nothing_pending_raises_invalid_plan_change(make_env, interval, pass_interval):
+    env = make_env()
+    sub = env.subscribe("pro", interval, on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, "pro", interval if pass_interval else None)
+
+
+def test_10_worked_example_repeating_the_cancellation_raises(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "basic")
+    assert env.service.change_plan(sub.id, "pro", MONTHLY) is None
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, "pro", MONTHLY)

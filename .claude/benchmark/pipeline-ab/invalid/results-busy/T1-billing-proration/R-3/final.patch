+
+
+def test_18_upgrade_without_switch_discards_pending_interval_switch(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "pro", ANNUAL)
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "premium")
+
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("75.00")
+    renewed = env.sub(sub.id)
+    assert (renewed.plan_code, renewed.interval, renewed.period_end) == ("premium", MONTHLY, date(2026, 5, 1))
+
+
+def test_18_upgrade_with_switch_replaces_pending_change(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "basic")
+    env.at(date(2026, 3, 11))

+"""SPEC.md acceptance criteria 1-8: rejected change requests."""
+
+from datetime import date
+
+import pytest
+
+import billing.errors as errors
+from billing.errors import PlanNotAvailable, PlanNotFound, SubscriptionNotActive, SubscriptionNotFound
+from billing.plans import Interval
+from plan_change_support import D, amounts
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+
+# 1-3
+
+
+def test_1_unknown_subscription_raises_subscription_not_found(make_env):
+    env = make_env()
+    with pytest.raises(SubscriptionNotFound):
+        env.service.change_plan("sub_missing", "premium")
+
+
+def test_2_canceled_subscription_raises_subscription_not_active(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.service.cancel(sub.id)
+    env.at(date(2026, 3, 11))
+    with pytest.raises(SubscriptionNotActive):
+        env.service.change_plan(sub.id, "premium")
+
+
+def test_3_unknown_plan_raises_plan_not_found(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    with pytest.raises(PlanNotFound):
+        env.service.change_plan(sub.id, "gold")
+
+
+# 4
+
+
+@pytest.mark.parametrize(
+    "target, new_interval",
+    [
+        ("premium", None),  # upgrade
+        ("premium", ANNUAL),  # upgrade with interval switch
+        ("basic", None),  # downgrade
+        ("basic", ANNUAL),  # downgrade with interval switch
+    ],
+)
+def test_4_retired_target_plan_raises_plan_not_available(make_env, target, new_interval):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.store.retire_plan(target)
+    env.at(date(2026, 3, 11))
+    with pytest.raises(PlanNotAvailable):
+        env.service.change_plan(sub.id, target, new_interval)
+
+
+def test_4_retired_target_plan_is_rejected_during_trial(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1), trial_days=14)
+    env.store.retire_plan("premium")
+    env.at(date(2026, 3, 5))
+    with pytest.raises(PlanNotAvailable):
+        env.service.change_plan(sub.id, "premium")
+
+
+def test_4_upgrading_off_a_retired_plan_is_allowed(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.store.retire_plan("pro")
+    env.at(date(2026, 3, 11))
+    invoice = env.service.change_plan(sub.id, "premium")
+    assert amounts(invoice) == [D("-20.32"), D("50.81")]
+    assert env.sub(sub.id).plan_code == "premium"
+
+
+def test_4_downgrading_off_a_retired_plan_is_allowed(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.store.retire_plan("pro")
+    env.at(date(2026, 3, 11))
+    assert env.service.change_plan(sub.id, "basic") is None
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("10.00")
+    assert env.sub(sub.id).plan_code == "basic"
+
+
+def test_4_interval_switch_while_staying_on_retired_plan_raises_plan_not_available(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.store.retire_plan("pro")
+    env.at(date(2026, 3, 11))
+    with pytest.raises(PlanNotAvailable):
+        env.service.change_plan(sub.id, "pro", ANNUAL)
+
+
+def test_4_returning_to_retired_current_plan_cancels_pending_change(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "basic")
+    env.store.retire_plan("pro")
+    env.at(date(2026, 3, 11))
+    assert env.service.change_plan(sub.id, "pro") is None
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("30.00")
+    assert env.sub(sub.id).plan_code == "pro"
+
+
+def test_4_retired_current_plan_as_target_with_nothing_pending_raises_invalid_plan_change(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.store.retire_plan("pro")
+    env.at(date(2026, 3, 11))
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, "pro")
+
+
+# 5
+
+
+@pytest.mark.parametrize("target, new_interval", [("premium", None), ("basic", None), ("pro", ANNUAL)])
+@pytest.mark.parametrize("today", [date(2026, 4, 1), date(2026, 4, 20)])
+def test_5_overdue_active_renewal_raises_invalid_plan_change(make_env, today, target, new_interval):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(today)
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, target, new_interval)
+
+
+@pytest.mark.parametrize("target, new_interval", [("premium", None), ("basic", None), ("pro", ANNUAL)])
+def test_5_overdue_trial_end_raises_invalid_plan_change(make_env, target, new_interval):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1), trial_days=14)
+    env.at(date(2026, 3, 15))
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, target, new_interval)
+
+
+# 6
+
+
+@pytest.mark.parametrize("new_interval", [None, MONTHLY])
+def test_6_upgrade_with_negative_total_raises_invalid_plan_change(make_env, new_interval):
+    env = make_env()
+    # Higher monthly price than Pro (an upgrade) but a lower annual price.
+    env.add_plan("flex", "40.00", "200.00")
+    sub = env.subscribe("pro", ANNUAL, on=date(2026, 1, 15))
+    env.at(date(2026, 7, 15))
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, "flex", new_interval)
+
+
+# 7
+
+
+def test_7_unknown_subscription_beats_unknown_plan(make_env):
+    env = make_env()
+    with pytest.raises(SubscriptionNotFound):
+        env.service.change_plan("sub_missing", "gold")
+
+
+def test_7_unknown_subscription_beats_retired_plan(make_env):
+    env = make_env()
+    env.store.retire_plan("premium")
+    with pytest.raises(SubscriptionNotFound):
+        env.service.change_plan("sub_missing", "premium")
+
+
+def test_7_canceled_subscription_beats_unknown_plan(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.service.cancel(sub.id)
+    with pytest.raises(SubscriptionNotActive):
+        env.service.change_plan(sub.id, "gold")
+
+
+def test_7_canceled_subscription_beats_retired_plan(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.service.cancel(sub.id)
+    env.store.retire_plan("premium")
+    with pytest.raises(SubscriptionNotActive):
+        env.service.change_plan(sub.id, "premium")
+
+
+def test_7_unknown_plan_beats_overdue_renewal(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 4, 1))
+    with pytest.raises(PlanNotFound):
+        env.service.change_plan(sub.id, "gold")
+
+
+def test_7_retired_plan_beats_overdue_renewal(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.store.retire_plan("premium")
+    env.at(date(2026, 4, 1))
+    with pytest.raises(PlanNotAvailable):
+        env.service.change_plan(sub.id, "premium")
+
+
+def test_7_retired_plan_beats_negative_total(make_env):
+    env = make_env()
+    env.add_plan("flex", "40.00", "200.00")
+    sub = env.subscribe("pro", ANNUAL, on=date(2026, 1, 15))
+    env.store.retire_plan("flex")
+    env.at(date(2026, 7, 15))
+    with pytest.raises(PlanNotAvailable):
+        env.service.change_plan(sub.id, "flex")
+
+
+def test_7_interval_switch_on_retired_plan_beats_overdue_renewal(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.store.retire_plan("pro")
+    env.at(date(2026, 4, 1))
+    with pytest.raises(PlanNotAvailable):
+        env.service.change_plan(sub.id, "pro", ANNUAL)
+
+
+# 8
+#
+# Each case starts from a subscription with a pending downgrade to Basic (same
+# interval), makes a request that must be rejected, then checks that nothing moved:
+# the stored subscription and invoices are identical, and the pending downgrade
+# still takes effect at the next renewal.
+
+
+def _setup_unknown_plan(env):
+    return date(2026, 3, 11), ("gold", None), "PlanNotFound"
+
+
+def _setup_retired_target(env):
+    env.store.retire_plan("premium")
+    return date(2026, 3, 11), ("premium", None), "PlanNotAvailable"
+
+
+def _setup_retired_interval_switch(env):
+    env.store.retire_plan("pro")
+    return date(2026, 3, 11), ("pro", ANNUAL), "PlanNotAvailable"
+
+
+def _setup_overdue(env):
+    return date(2026, 4, 1), ("premium", None), "InvalidPlanChange"
+
+
+def _setup_negative_total(env):
+    env.add_plan("flex", "40.00", "200.00")
+    return date(2026, 7, 15), ("flex", None), "InvalidPlanChange"
+
+
+REJECTIONS = [
+    pytest.param(MONTHLY, _setup_unknown_plan, id="unknown-plan"),
+    pytest.param(MONTHLY, _setup_retired_target, id="retired-target"),
+    pytest.param(MONTHLY, _setup_retired_interval_switch, id="retired-interval-switch"),
+    pytest.param(MONTHLY, _setup_overdue, id="overdue"),
+    pytest.param(ANNUAL, _setup_negative_total, id="negative-total"),
+]
+
+
+@pytest.mark.parametrize("interval, setup", REJECTIONS)
+def test_8_rejected_request_changes_nothing(make_env, interval, setup):
+    env = make_env()
+    sub = env.subscribe("pro", interval, on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    assert env.service.change_plan(sub.id, "basic") is None  # pending downgrade
+
+    today, (target, new_interval), error_name = setup(env)
+    env.at(today)
+    before_sub = env.sub(sub.id)
+    before_invoices = env.invoices(sub.id)
+
+    with pytest.raises(getattr(errors, error_name)):
+        env.service.change_plan(sub.id, target, new_interval)
+
+    assert env.sub(sub.id) == before_sub
+    assert env.invoices(sub.id) == before_invoices
+
+    # The pending downgrade survived the rejected request.
+    end = before_sub.period_end
+    if today < end:
+        env.at(end)
+    [renewal, *_] = env.service.renew_due()
+    assert renewal.issued_on == end
+    assert renewal.total == (D("10.00") if interval is MONTHLY else D("100.00"))
+    assert env.sub(sub.id).plan_code == "basic"
+
+
+def test_8_rejected_request_on_canceled_subscription_changes_nothing(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "basic")
+    env.service.cancel(sub.id)
+    before_sub = env.sub(sub.id)
+    before_invoices = env.invoices(sub.id)
+
+    with pytest.raises(SubscriptionNotActive):
+        env.service.change_plan(sub.id, "premium")
+
+    assert env.sub(sub.id) == before_sub
+    assert env.invoices(sub.id) == before_invoices
+
+
+def test_8_rejected_overdue_trial_changes_nothing(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1), trial_days=14)
+    env.at(date(2026, 3, 15))
+    before_sub = env.sub(sub.id)
+
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, "premium")
+
+    assert env.sub(sub.id) == before_sub
+    assert env.invoices(sub.id) == []
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("30.00")
+
+
+def test_8_rejected_same_target_with_nothing_pending_changes_nothing(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    before_sub = env.sub(sub.id)
+    before_invoices = env.invoices(sub.id)
+
+    with pytest.raises(errors.InvalidPlanChange):
+        env.service.change_plan(sub.id, "pro")
+
+    assert env.sub(sub.id) == before_sub
+    assert env.invoices(sub.id) == before_invoices

+"""SPEC.md acceptance criteria 11-13: changes during a free trial."""
+
+from datetime import date
+
+import pytest
+
+from billing.plans import Interval
+from billing.subscriptions import SubscriptionStatus
+from plan_change_support import D
+
+MONTHLY, ANNUAL = Interval.MONTHLY, Interval.ANNUAL
+
+TRIAL_START = date(2026, 3, 1)
+TRIAL_END = date(2026, 3, 15)  # 14-day trial
+
+# (base interval, target plan, new_interval, expected plan, expected interval, full price, first paid period end)
+TRIAL_CHANGES = [
+    pytest.param(MONTHLY, "premium", None, "premium", MONTHLY, "75.00", date(2026, 4, 15), id="upgrade"),
+    pytest.param(MONTHLY, "basic", None, "basic", MONTHLY, "10.00", date(2026, 4, 15), id="downgrade"),
+    pytest.param(MONTHLY, "pro", ANNUAL, "pro", ANNUAL, "300.00", date(2027, 3, 15), id="switch-to-annual"),
+    pytest.param(ANNUAL, "pro", MONTHLY, "pro", MONTHLY, "30.00", date(2026, 4, 15), id="switch-to-monthly"),
+    pytest.param(MONTHLY, "premium", ANNUAL, "premium", ANNUAL, "750.00", date(2027, 3, 15), id="upgrade-and-switch"),
+    pytest.param(ANNUAL, "basic", MONTHLY, "basic", MONTHLY, "10.00", date(2026, 4, 15), id="downgrade-and-switch"),
+]
+
+
+@pytest.mark.parametrize("base, target, new_interval, plan, interval, price, paid_end", TRIAL_CHANGES)
+def test_11_trial_change_applies_immediately_without_invoice(
+    make_env, base, target, new_interval, plan, interval, price, paid_end
+):
+    env = make_env()
+    sub = env.subscribe("pro", base, on=TRIAL_START, trial_days=14)
+    env.at(date(2026, 3, 5))
+
+    assert env.service.change_plan(sub.id, target, new_interval) is None
+
+    changed = env.sub(sub.id)
+    assert (changed.plan_code, changed.interval) == (plan, interval)
+    assert env.invoices(sub.id) == []
+
+
+@pytest.mark.parametrize("base, target, new_interval, plan, interval, price, paid_end", TRIAL_CHANGES)
+def test_12_trial_end_and_status_are_unchanged(make_env, base, target, new_interval, plan, interval, price, paid_end):
+    env = make_env()
+    sub = env.subscribe("pro", base, on=TRIAL_START, trial_days=14)
+    env.at(date(2026, 3, 5))
+
+    env.service.change_plan(sub.id, target, new_interval)
+
+    changed = env.sub(sub.id)
+    assert changed.period_end == TRIAL_END
+    assert changed.status is SubscriptionStatus.TRIALING
+
+
+@pytest.mark.parametrize("base, target, new_interval, plan, interval, price, paid_end", TRIAL_CHANGES)
+def test_13_trial_end_bills_full_price_of_new_plan_and_interval(
+    make_env, base, target, new_interval, plan, interval, price, paid_end
+):
+    env = make_env()
+    sub = env.subscribe("pro", base, on=TRIAL_START, trial_days=14)
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, target, new_interval)
+
+    env.at(TRIAL_END)
+    [renewal] = env.service.renew_due()
+
+    assert renewal.issued_on == TRIAL_END
+    assert renewal.total == D(price)
+    paid = env.sub(sub.id)
+    assert paid.status is SubscriptionStatus.ACTIVE
+    assert (paid.plan_code, paid.interval) == (plan, interval)
+    assert (paid.period_start, paid.period_end) == (TRIAL_END, paid_end)
+
+
+def test_13_trial_end_bills_the_plan_after_several_trial_changes(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=TRIAL_START, trial_days=14)
+    env.at(date(2026, 3, 5))
+    env.service.change_plan(sub.id, "premium", ANNUAL)
+    env.at(date(2026, 3, 10))
+    env.service.change_plan(sub.id, "basic")  # interval None -> stays annual (now current)
+
+    env.at(TRIAL_END)
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("100.00")
+    paid = env.sub(sub.id)
+    assert (paid.plan_code, paid.interval, paid.period_end) == ("basic", ANNUAL, date(2027, 3, 15))

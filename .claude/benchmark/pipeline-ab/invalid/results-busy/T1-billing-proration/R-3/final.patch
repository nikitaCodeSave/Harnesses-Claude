+"""SPEC.md acceptance criteria 29-31: persistence, exports, existing behaviour."""
+
+from datetime import date
+
+import billing
+import billing.errors as errors
+from billing.clock import FixedClock
+from billing.errors import BillingError
+from billing.service import BillingService
+from plan_change_support import D
+
+# 29
+
+
+def test_29_new_service_over_same_store_applies_pending_change(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "basic")
+
+    other = BillingService(env.store, FixedClock(date(2026, 4, 1)))
+    [renewal] = other.renew_due()
+
+    assert renewal.total == D("10.00")
+    assert env.sub(sub.id).plan_code == "basic"
+
+
+def test_29_new_service_over_same_store_sees_pending_change(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "basic")
+
+    other = BillingService(env.store, FixedClock(date(2026, 3, 20)))
+    # Only possible if the pending change is visible: target == current cancels it (9).
+    assert other.change_plan(sub.id, "pro") is None
+
+    env.at(date(2026, 4, 1))
+    [renewal] = env.service.renew_due()
+    assert renewal.total == D("30.00")
+    assert env.sub(sub.id).plan_code == "pro"
+
+
+# 30
+
+
+def test_30_invalid_plan_change_is_exported_from_billing():
+    assert billing.InvalidPlanChange is errors.InvalidPlanChange
+    assert "InvalidPlanChange" in billing.__all__
+    assert issubclass(billing.InvalidPlanChange, BillingError)
+
+
+# 31 (the existing suite under tests/ must also pass unmodified)
+
+
+def test_31_other_subscriptions_renew_as_before(make_env):
+    env = make_env()
+    changed = env.subscribe("pro", on=date(2026, 3, 1), customer_id="cus_1")
+    untouched = env.subscribe("pro", on=date(2026, 3, 1), customer_id="cus_2")
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(changed.id, "basic")
+
+    env.at(date(2026, 4, 1))
+    env.service.renew_due()
+
+    [first, renewal] = env.invoices(untouched.id)
+    assert (renewal.issued_on, renewal.total) == (date(2026, 4, 1), D("30.00"))
+    renewed = env.sub(untouched.id)
+    assert (renewed.plan_code, renewed.period_start, renewed.period_end) == ("pro", date(2026, 4, 1), date(2026, 5, 1))
+
+
+def test_31_subscription_after_upgrade_renews_like_any_other(make_env):
+    env = make_env()
+    sub = env.subscribe("pro", on=date(2026, 3, 1))
+    env.at(date(2026, 3, 11))
+    env.service.change_plan(sub.id, "premium")
+
+    env.at(date(2026, 6, 1))
+    issued = env.service.renew_due()
+
+    assert [(inv.issued_on, inv.total) for inv in issued] == [
+        (date(2026, 4, 1), D("75.00")),
+        (date(2026, 5, 1), D("75.00")),
+        (date(2026, 6, 1), D("75.00")),
+    ]
